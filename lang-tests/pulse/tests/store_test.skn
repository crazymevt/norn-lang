(ns pulse.store-test
  (:require [skein.test :refer [deftest is testing]]
            [skein.sqlite :as sql]
            [skein.time :as t]
            [pulse.store :as store]))

(deftest targets-and-their-checks
  (let [db (store/open ":memory:")]
    (store/add-target! db "b" "http://b" 30)
    (store/add-target! db "a" "http://a" 60)
    (is (= ["a" "b"] (mapv :name (store/targets db))) "by name")
    (is (= {:name "a" :url "http://a" :every-s 60} (store/target db "a")))
    (is (nil? (store/target db "zzz")))
    (is (thrown? sql/ConstraintError (store/add-target! db "a" "http://elsewhere" 5)) "a name once")
    (store/record-check! db "a" {:status 200 :ms 10 :ok true})
    (store/record-check! db "a" {:status 500 :ms 30 :ok false})
    (store/record-check! db "a" {:ms 2 :ok false :error "refused"})
    (testing "newest first"
      (is (= [false false true] (mapv :ok (store/checks db "a" 0 10))))
      (is (= "refused" (:error (first (store/checks db "a" 0 10)))))
      (is (= 1 (count (store/checks db "a" 0 1)))))
    (let [[a b] (store/summary db 0)]
      (is (= 3 (:checks a)))
      (is (< 0.33 (:uptime a) 0.34))
      (is (= 14 (:avg-ms a)))
      (is (= "refused" (:error (:last a))))
      (is (= {:checks 0 :uptime nil :last nil :avg-ms nil} (select-keys b [:checks :uptime :last :avg-ms]))
          "one not checked yet"))
    (is (= 3 (store/prune! db (* 2 (t/epoch-ms (t/now))))) "everything is older than the future")
    (store/record-check! db "a" {:status 200 :ms 1 :ok true})
    (is (true? (store/remove-target! db "a")))
    (is (= 0 (:n (sql/query-one db "SELECT count(*) AS n FROM checks"))) "its checks go with it")
    (is (false? (store/remove-target! db "a")))
    (sql/close! db)))
