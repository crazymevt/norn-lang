(ns pulse.fake-site
  "A web site for the tests to watch."
  (:require [skein.http :as http]))

(defn start
  "A server answering /ok with 200, /slow with 200 after a second, and
  anything else with 503."
  []
  (http/serve (fn [req]
                (case (:path req)
                  "/ok" {:status 200 :body "fine"}
                  "/slow" (do (sleep 1000) {:status 200})
                  {:status 503 :body "down"}))))

(defn url "The URL of path on site." [site path] (str "http://127.0.0.1:" (:port site) path))

(defn stop "Stop site." [site] (http/stop! site))
