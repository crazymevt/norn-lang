(ns ledger.main
  "ledger's command line: import bank exports, categorize, report."
  (:require [ledger.browse :as browse]
            [ledger.dates :as dates]
            [ledger.import :as imp]
            [ledger.money :as money]
            [ledger.report :as report]
            [ledger.rules :as rules]
            [ledger.store :as store]
            [skein.cli :as cli]
            [skein.html :as html]
            [skein.io :as io]
            [skein.string :as str]
            [skein.terminal :as term]
            [skein.time :as t]
            [skein.toml :as toml]))

(defn- config
  "The config file's contents, its ledger file's path made absolute
  beside it."
  [path]
  (when-not (io/file? path)
    (throw (str "No config file " path " (--config, or LEDGER_CONFIG)")))
  (let [c (toml/read-file path)]
    (assoc c :file (io/path (or (io/parent (io/absolute path)) ".") (or (:file c) "ledger.edn")))))

(defn- import-files [{:keys [options args]}]
  (let [c (config (:config options))
        account (:account args)
        profile (get-in c [:accounts (keyword account)])]
    (if-not profile
      (do (println (str "ledger: no account " account " in " (:config options) " (it has "
                        (str/join ", " (map name (keys (:accounts c)))) ")"))
          1)
      (let [txs (vec (mapcat (fn [f] (imp/read-transactions (io/read-text f) account profile)) (:files args)))
            txs (rules/categorize (rules/compile-rules (:rules c)) txs)
            [ledger added] (store/add-transactions (store/load-ledger (:file c)) txs)]
        (store/save-ledger! (:file c) ledger)
        (println (str "Added " added " of " (count txs) " transactions"
                      (when (< added (count txs)) (str " (" (- (count txs) added) " were there already)"))))
        0))))

(defn- list-transactions [{:keys [options]}]
  (let [c (config (:config options))
        txs (cond->> (:transactions (store/load-ledger (:file c)))
                     (:month options) (filter (fn [tx] (= (:month options) (dates/month-of (:date tx)))))
                     (:uncategorized options) (filter (fn [tx] (nil? (:category tx)))))]
    (doseq [tx txs]
      (println (str (t/format-local (:date tx)) "  " (str/pad-right (str/truncate (:description tx) 32 "…") 32) "  "
                    (str/pad-left (money/format-amount (:amount tx)) 12) "  " (or (:category tx) "-"))))
    0))

(defn- show-report [{:keys [options]}]
  (let [c (config (:config options))
        s (report/summarize (:transactions (store/load-ledger (:file c))))]
    (if-let [out (:html options)]
      (do (io/write-text out (html/write (report/html-page "Spending" s)))
          (println "Wrote" out))
      (println (report/text-table s)))
    0))

(defn- apply-rules [{:keys [options]}]
  (let [c (config (:config options))
        ledger (store/load-ledger (:file c))
        before (count (remove :category (:transactions ledger)))
        ledger (update ledger :transactions (fn [txs] (rules/categorize (rules/compile-rules (:rules c)) txs)))
        after (count (remove :category (:transactions ledger)))]
    (store/save-ledger! (:file c) ledger)
    (println (str "Categorized " (- before after) "; " after " left without a category"))
    0))

(defn- browse-ledger [{:keys [options]}]
  (if-not (term/tty? :in)
    (do (println "ledger browse: needs a terminal") 1)
    (let [c (config (:config options))]
      (browse/run (store/load-ledger (:file c)) (fn [l] (store/save-ledger! (:file c) l)))
      0)))

(def spec
  {:name "ledger"
   :summary "Import bank exports, give the transactions categories, and see where the money went."
   :version "0.1.0"
   :options [{:name :config :value "FILE" :default "ledger.toml" :env "LEDGER_CONFIG"
              :doc "The config: the ledger file, accounts and rules"}]
   :commands [{:name "import" :summary "Add an account's exported transactions"
               :args [{:name :account} {:name :files :value "FILE" :variadic true}]
               :run import-files}
              {:name "list" :summary "The transactions"
               :options [{:name :month :value "YYYY-MM"} {:name :uncategorized :doc "Only those without a category"}]
               :run list-transactions}
              {:name "report" :summary "Spending by month and category"
               :options [{:name :html :value "FILE" :doc "Write it as an HTML page"}]
               :run show-report}
              {:name "rules" :summary "Give the rules' categories to transactions without one" :run apply-rules}
              {:name "browse" :summary "Browse and categorize in the terminal" :run browse-ledger}]})

(defn main
  "ledger's entry point: its command-line arguments in, its exit status out."
  [& args]
  (cli/run spec (vec args)))
