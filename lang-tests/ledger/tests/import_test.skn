(ns ledger.import-test
  (:require [ledger.import :as imp]
            [ledger.money :as m]
            [ledger.report :as report]
            [ledger.rules :as rules]
            [ledger.store :as store]
            [skein.io :as io]
            [skein.string :as str]
            [skein.sys :as sys]
            [skein.test :refer [deftest is testing]]
            [skein.toml :as toml]))

(def here (let [loc (%location)] (io/parent (subs loc 0 (str/last-index-of loc ":")))))
(def config (toml/read-file (io/path here "fixtures" "ledger.toml")))
(defn- fixture [account]
  (imp/read-transactions (io/read-text (io/path here "fixtures" (str account ".csv"))) account
                         (get-in config [:accounts (keyword account)])))

(deftest reading-exports
  (let [checking (fixture "checking") card (fixture "card")]
    (is (= 6 (count checking)))
    (is (= {:description "RENT, NOVEMBER" :amount "-1,450.00" :account "checking"}
           (-> (nth checking 2) (select-keys [:description :amount :account]) (update :amount m/format-amount))))
    (is (= ["-15.99" "-48.20" "10.00" "-12.50"] (mapv (comp m/format-amount :amount) card)) "credit less debit")
    (is (= "Café Été" (:description (last card)))))
  (testing "a row it can't read says where"
    (is (thrown-with-msg? ParseError #"line 3: Not an amount"
                          (imp/read-transactions "Date,Description,Amount\n11/01/2026,A,1.00\n11/02/2026,B,lots\n" "x"
                                                 (get-in config [:accounts :checking])))))
  (testing "a column that isn't there is named"
    (is (thrown-with-msg? ParseError #"No column \"Posted\""
                          (imp/read-transactions "Date,Payee,Debit,Credit\n2026-11-01,A,1.00,\n" "x" (get-in config [:accounts :card]))))))

(deftest categorizing-storing-and-reporting
  (let [rs (rules/compile-rules (:rules config))
        txs (rules/categorize rs (concat (fixture "checking") (fixture "card")))
        [ledger added] (store/add-transactions {:transactions []} txs)
        path (io/path (sys/temp-dir) (str "ledger-test-" (sys/pid) "-" (nano-time) ".edn"))]
    (is (= 10 added))
    (is (= 0 (second (store/add-transactions ledger txs))) "importing again adds nothing")
    (is (= ["Income" "Groceries" "Housing"] (mapv :category (take 3 (filter (fn [tx] (= "checking" (:account tx))) (:transactions ledger))))))
    (store/save-ledger! path ledger)
    (is (= ledger (store/load-ledger path)) "the file reads back as it was")
    (let [s (report/summarize (:transactions ledger))]
      (is (= ["2026-11" "2026-12"] (:months s)))
      (is (= "911.69" (m/format-amount (get-in s [:month-totals "2026-11"]))))
      (is (str/includes? (report/text-table s) "Housing    -1,450.00         -")))
    (io/delete! path)))
