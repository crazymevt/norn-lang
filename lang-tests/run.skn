;;;; The lang-tests as a check on Skein itself: six programs written the way
;;;; Skein's users write them (README.md), run with this checkout's skein.
;;;;
;;;;   skein lang-tests/run.skn                  ; everything
;;;;   skein lang-tests/run.skn --only ledger    ; one project (repeatable)
;;;;   skein lang-tests/run.skn --record         ; record outputs and coverage
;;;;   skein lang-tests/run.skn --skein PATH      ; another skein (default: this one)
;;;;
;;;; Three checks, each project in each of three modes: tier 0, tier 1 (the
;;;; default), and everything compiled from its first call:
;;;;
;;;; - tests: the project's own `skein test`;
;;;; - outputs: the programs on fixed inputs (outputs.edn), whose output and
;;;;   files must agree in every mode and with the recording in expected/,
;;;;   which catches a miscompile no test asserts on;
;;;; - coverage: the standard library's lines the projects' tests reach
;;;;   (at tier 0, SKEIN_COVER_LIB pointing at this checkout's lib), against
;;;;   expected/coverage.edn; a report, not a failure.
;;;;
;;;; Exits 1 when a test fails or an output differs. A project whose Git
;;;; dependency isn't on this machine (skein.lock names a local folder) is
;;;; skipped, and says so.

(require '[skein.crypto :as crypto]
         '[skein.edn :as edn]
         '[skein.fs :as fs]
         '[skein.io :as io]
         '[skein.process :as proc]
         '[skein.string :as str]
         '[skein.sys :as sys]
         '[skein.zip :as zip])

(def root
  "This folder (lang-tests), as an absolute path."
  (let [loc (%location)
        f (subs loc 0 (str/last-index-of loc ":"))]
    (io/parent (if (str/starts-with? f "/") f (io/path (sys/cwd) f)))))

(def checkout (io/parent root))
(def expected (io/path root "expected"))

(def projects ["chat" "ledger" "loglens" "pulse" "quire" "stash"])

(def modes
  [{:name "tier 0" :env {"SKEIN_TIER" "0"}}
   {:name "tier 1" :env {"SKEIN_TIER" "1"}}
   {:name "all compiled" :env {"SKEIN_TIER" "1" "SKEIN_JIT_THRESHOLD" "1" "SKEIN_JIT_SYNC" "1"}}])

(def base-env {"SKEIN_UI_HEADLESS" "1"})

(def ^:dynamic *skein* (:executable (sys/info)))

(def failures (atom []))

(defn- fail! [msg] (swap! failures conj msg) (println (str "  FAIL " msg)))

;; ---- a project, a mode ----

(defn- dir-of [p] (io/path root p))

(defn- missing-deps
  "The local Git dependencies project p's skein.lock names that aren't on
  this machine."
  [p]
  (let [lock (io/path (dir-of p) "skein.lock")]
    (if (io/exists? lock)
      (vec (for [[_ {:keys [git]}] (:git (edn/read-file lock))
                 :when (and (string? git) (str/starts-with? git "/") (not (io/exists? git)))]
             git))
      [])))

(defn- run-skein
  "skein with args in project p's folder, in mode: {:exit :out :err :ms}."
  [p mode args & {:keys [env]}]
  (let [t0 (nano-time)
        r (apply proc/sh *skein* (concat args [:dir (dir-of p) :env (merge base-env (:env mode) env)]))]
    (assoc r :ms (quot (- (nano-time) t0) 1000000))))

(defn- last-line [s] (or (last (remove str/blank? (str/split-lines (or s "")))) ""))

(defn- run-tests
  "Project p's tests in mode: {:ok :summary :ms}."
  [p mode]
  (let [r (run-skein p mode ["test"])]
    {:ok (zero? (:exit r)) :summary (last-line (:out r)) :ms (:ms r) :err (:err r)}))

;; ---- fixed outputs ----

(defn- temp-folder [tag]
  (let [d (io/path (sys/temp-dir) (str "skein-lang-tests-" (sys/pid) "-" tag "-" (nano-time)))]
    (io/mkdirs! d)
    d))

(defn- copy-into!
  "Copy file or folder from (in project p) into folder to."
  [p from to]
  (let [src (io/path (dir-of p) from)
        base (io/parent src)]
    (doseq [f (if (io/directory? src) (fs/walk src) [src])
            :when (io/file? f)]
      (let [dest (io/path to (subs f (inc (count base))))]
        (io/mkdirs! (io/parent dest))
        (io/copy! f dest)))))

(defn- normalised
  "Text s with temporary folder tmp's path written $TMP (macOS's temporary
  folder has a second name, under /private)."
  [s tmp]
  (-> (or s "") (str/replace (str "/private" tmp) "$TMP") (str/replace tmp "$TMP")))

(defn- digest
  "The SHA-256 of b (bytes, from a file named name), with temporary folder
  tmp's path written $TMP wherever it's text: in a text file, and in a zip's
  entries (a page can name a file it was built from)."
  [b name tmp]
  (let [text (bytes->string b true)]
    (crypto/hex
     (crypto/sha256
      (cond (str/ends-with? name ".zip")
            (pr-str (into (sorted-map) (for [[n e] (zip/unzip b)] [n (digest e n tmp)])))
            (= b (bytes text)) (normalised text tmp)
            :else b)))))

(defn- files-of
  "The files globs name in tmp: {relative path, its digest}."
  [tmp globs]
  (into (sorted-map)
        (for [g globs
              f (fs/glob (str tmp "/" g))
              :when (io/file? f)]
          [(subs f (inc (count tmp))) (digest (io/read-bytes f) f tmp)])))

(defn- run-steps
  "Project p's steps in mode, in a fresh folder: {:steps [{:name :exit :out
  :err :files}…] :tmp}; it stops at a step that fails."
  [p mode steps]
  (let [tmp (temp-folder p)]
    (loop [steps (seq steps) out []]
      (if-let [{:keys [name copy args files exit] :or {exit 0}} (first steps)]
        (do (doseq [c copy] (copy-into! p c tmp))
            (let [r (run-skein p mode (cons "run" (map (fn [a] (str/replace a "$TMP" tmp)) args)))
                  step {:name name :exit (:exit r) :out (normalised (:out r) tmp) :err (normalised (:err r) tmp)
                        :files (files-of tmp files)}]
              (if (= exit (:exit r))
                (recur (next steps) (conj out (assoc step :expected-exit exit)))
                {:steps (conj out step) :tmp tmp})))
        {:steps out :tmp tmp}))))

(defn- first-difference
  "Where texts a and b first differ, as text."
  [a b]
  (let [as (str/split-lines a) bs (str/split-lines b)
        i (or (first (filter (fn [i] (not= (get as i) (get bs i))) (range (max (count as) (count bs))))) 0)]
    (str "line " (inc i) ": " (pr-str (get as i)) " against " (pr-str (get bs i)))))

(defn- step-difference
  "How steps a and b differ (b the reference), as text, or nil."
  [a b]
  (cond (and (:exit b) (not= (:exit a) (:exit b))) (str "exit " (:exit a) " against " (:exit b) ": " (last-line (:err a)))
        (not= (:out a) (:out b)) (str "output, " (first-difference (:out a) (:out b)))
        (not= (:files a) (:files b))
        (str "files: " (str/join ", " (for [k (sort (into (set (keys (:files a))) (keys (:files b))))
                                            :when (not= (get (:files a) k) (get (:files b) k))]
                                        k)))))

(defn- recorded
  "Project p's recorded steps (expected/p/), in the order of steps (from
  outputs.edn), or nil; a step not recorded has no :out."
  [p steps]
  (let [d (io/path expected p) files (io/path d "files.edn")]
    (when (io/exists? files)
      (let [fs (edn/read-file files)]
        (vec (for [{:keys [name]} steps
                   :let [out (io/path d (str name ".out"))]]
               {:name name :out (when (io/exists? out) (io/read-text out)) :files (get fs name)}))))))

(defn- record!
  "Write steps as project p's recording: each step's output as name.out,
  and every step's files in files.edn."
  [p steps]
  (let [d (io/path expected p)]
    (when (io/exists? d) (io/delete! d :recursive true))
    (io/mkdirs! d)
    (doseq [{:keys [name out]} steps] (io/write-text (io/path d (str name ".out")) out))
    (io/write-text (io/path d "files.edn")
                   (str "{" (str/join "\n " (for [{:keys [name files]} steps]
                                              (str (pr-str name) " " (if (empty? files) "{}" (str "{" (str/join "\n   " (map (fn [[k v]] (str (pr-str k) " " (pr-str v))) files)) "}")))))
                        "}\n"))))

(defn- check-outputs
  "Run project p's steps in every mode; compare the modes with each other
  and with the recording (or record them)."
  [p steps record?]
  (let [runs (mapv (fn [m] [m (run-steps p m steps)]) modes)
        [m0 r0] (first runs)
        ok (atom true)]
    (doseq [[m r] runs
            s (:steps r)
            :when (not (contains? s :expected-exit))]
      (reset! ok false)
      (fail! (str p " outputs, " (:name m) ": step " (:name s) " exited " (:exit s) ": " (last-line (:err s)))))
    (when @ok
      (doseq [[m r] (rest runs)
              [a b] (map vector (:steps r) (:steps r0))
              :let [d (step-difference a b)]
              :when d]
        (reset! ok false)
        (fail! (str p " outputs, step " (:name a) ": " (:name m) " differs from " (:name m0) ": " d)))
      (if record?
        (do (record! p (:steps r0)) (println (str "  " p ": " (count (:steps r0)) " steps recorded")))
        (if-let [rec (recorded p steps)]
          (doseq [[a b] (map vector (:steps r0) rec)
                  :let [d (if (nil? (:out b)) "not recorded: record again" (step-difference a b))]
                  :when d]
            (reset! ok false)
            (fail! (str p " outputs, step " (:name a) ": differs from the recording: " d)))
          (do (reset! ok false) (fail! (str p " outputs: nothing recorded (--record)"))))))
    (if @ok
      (do (doseq [[_ r] runs] (io/delete! (:tmp r) :recursive true))
          (when-not record? (println (str "  " p ": " (count steps) " steps, the same in every mode and as recorded"))))
      (println (str "    (their folders kept: " (str/join ", " (map (fn [[m r]] (str (:name m) " " (:tmp r))) runs)) ")")))))

;; ---- coverage ----

(defn- lcov-lines
  "An lcov tracefile's lines of the standard library: {\"lib/…\" {line
  runs}}."
  [text lib]
  (loop [ls (str/split-lines text) file nil out {}]
    (if-let [l (first ls)]
      (cond (str/starts-with? l "SF:")
            (let [f (subs l 3)]
              (recur (rest ls) (when (str/starts-with? f (str lib "/")) (str "lib/" (subs f (inc (count lib))))) out))
            (and file (str/starts-with? l "DA:"))
            (let [[line n] (str/split (subs l 3) #",")]
              (recur (rest ls) file (update-in out [file (parse-long line)] (fnil + 0) (parse-long n))))
            :else (recur (rest ls) file out))
      out)))

(defn- coverage-of
  "Project p's tests' coverage of the standard library (tier 0)."
  [p]
  (let [tmp (temp-folder (str p "-cover"))
        info (io/path tmp "cov.info")
        lib (io/path checkout "lib")
        r (run-skein p (first modes) ["test" "--lcov" info] :env {"SKEIN_COVER_LIB" lib})]
    (try
      (if (io/exists? info)
        (lcov-lines (io/read-text info) lib)
        (do (fail! (str p " coverage: no tracefile (" (last-line (:err r)) ")")) {}))
      (finally (io/delete! tmp :recursive true)))))

(defn- merge-lines [a b] (merge-with (fn [x y] (merge-with + x y)) a b))

(defn- totals
  "{file [lines hit]} of merged line counts."
  [cov]
  (into (sorted-map) (for [[f ls] cov] [f [(count ls) (count (filter pos? (vals ls)))]])))

(defn- percent [hit lines] (if (zero? lines) "-" (format "%.1f%%" (* 100.0 (/ hit lines)))))

(defn- sum-of [t] (reduce (fn [[l h] [l2 h2]] [(+ l l2) (+ h h2)]) [0 0] (vals t)))

(defn- write-coverage! [t]
  (io/write-text (io/path expected "coverage.edn")
                 (str ";; The standard library's lines the lang-tests' tests reach: {file [lines hit]}.\n;; Written by run.skn --record.\n{"
                      (str/join "\n " (map (fn [[f v]] (str (pr-str f) " " (pr-str v))) t)) "}\n")))

(defn- report-coverage [t record?]
  (let [[lines hit] (sum-of t)
        libs (set (for [f (fs/glob (str checkout "/lib/skein/**/*.skn"))] (subs f (inc (count checkout)))))
        unreached (sort (remove (set (keys t)) libs))
        file (io/path expected "coverage.edn")
        before (when (and (not record?) (io/exists? file)) (edn/read-file file))]
    (println (str "  " (percent hit lines) " of " lines " lines in the " (count t) " modules counted ("
                  (count unreached) " of the " (count libs) " in lib/skein aren't)"))
    (when before
      (let [[l0 h0] (sum-of before)
            changed (for [f (sort (into (set (keys t)) (keys before)))
                          :let [[_ h] (get t f [0 0]) [_ h0] (get before f [0 0])]
                          :when (not= h h0)]
                      (str f " " h0 " → " h))]
        (println (str "  recorded: " (percent h0 l0) " of " l0
                      (if (seq changed) (str "; lines hit changed in " (str/join ", " changed)) "; no module's changed")))))
    (println (str "  not counted (no test loads it, or skein test loaded it before counting began): " (str/join " " (map (fn [f] (-> f (subs 4) (str/replace #"\.skn$" "") (str/replace "/" "."))) unreached))))
    (when record? (write-coverage! t) (println "  recorded"))))

;; ---- running ----

(defn- parse-args [args]
  (loop [args (seq args) opts {:only []}]
    (if-let [a (first args)]
      (case a
        "--record" (recur (next args) (assoc opts :record true))
        "--only" (recur (nnext args) (update opts :only conj (second args)))
        "--skein" (recur (nnext args) (assoc opts :skein (second args)))
        (do (println (str "lang-tests/run.skn: what's " a "? (--record, --only NAME, --skein PATH)")) (sys/exit 2)))
      opts)))

(defn- pad [s n] (str/pad-right (str s) n))

(defn run [args]
  (let [{:keys [record only skein]} (parse-args args)
        chosen (if (seq only) (filter (set only) projects) projects)
        steps (edn/read-file (io/path root "outputs.edn"))]
    (binding [*skein* (or skein *skein*)]
      (println (str "lang-tests with " *skein*))
      (let [runnable (vec (for [p chosen
                                :let [missing (missing-deps p)]
                                :when (or (empty? missing)
                                          (do (println (str "  " p ": skipped, its dependency isn't here: " (str/join ", " missing))) false))]
                            p))]
        (println "\ntests")
        (println (str "  " (pad "" 9) (str/join "" (map (fn [m] (pad (:name m) 34)) modes))))
        (doseq [p runnable]
          (let [rs (mapv (fn [m] [m (run-tests p m)]) modes)]
            (println (str "  " (pad p 9)
                          (str/join "" (map (fn [[_ r]] (pad (str (if (:ok r) "ok " "FAIL ") (format "%5.1fs " (/ (:ms r) 1000.0))
                                                                  (str/replace (:summary r) #" tests?, (\d+) checks:.*" " tests, $1 checks"))
                                                             34))
                                            rs))))
            (doseq [[m r] rs :when (not (:ok r))]
              (fail! (str p " tests, " (:name m) ": " (:summary r) " " (last-line (:err r)))))))
        (println "\noutputs")
        (doseq [p runnable :when (contains? steps (symbol p))]
          (check-outputs p (get steps (symbol p)) record))
        (println "\ncoverage of the standard library (the tests, tier 0)")
        (report-coverage (totals (reduce merge-lines {} (map coverage-of runnable))) record)
        (println)
        (if (seq @failures)
          (do (println (str (count @failures) " failed:")) (doseq [f @failures] (println (str "  " f))) (sys/exit 1))
          (println "all passed"))))))

(run (sys/program-args))
