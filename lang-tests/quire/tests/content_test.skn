(ns quire.content-test
  (:require [skein.io :as io]
            [skein.string :as str]
            [skein.test :refer [deftest is testing]]
            [skein.time :as t]
            [quire.content :as c]))

(def here (let [loc (%location)] (io/parent (subs loc 0 (str/last-index-of loc ":")))))
(def posts (io/path here "site" "posts"))

(deftest front-matter
  (is (= ["title: x" "body\n"] (c/split-front-matter "---\ntitle: x\n---\nbody\n")))
  (is (= [nil "no front matter"] (c/split-front-matter "no front matter")))
  (is (= [nil "---\nnever closed"] (c/split-front-matter "---\nnever closed"))))

(deftest reading-a-post
  (let [p (c/read-post (io/path posts "rain.md"))]
    (is (= {:slug "rain" :title "Rain" :date (t/local-date 2026 11 12) :tags ["weather"] :draft false}
           (select-keys p [:slug :title :date :tags :draft]))
        "a date written out in words, by pattern")
    (is (= "Nothing but rain. See first light." (:summary p))))
  (is (thrown-with-msg? c/BadPost #"isn't YAML" (c/read-post (io/path posts "broken.md")))))

(deftest a-post-that-cant-be-read
  (testing "skipped"
    (is (= ["rain" "first-light"]
           (mapv :slug (handler-bind [c/BadPost (fn [_] (invoke-restart 'skip-post))] (c/load-posts posts))))
        "newest first, drafts left out"))
  (testing "a placeholder"
    (let [ps (handler-bind [c/BadPost (fn [e] (invoke-restart 'use-placeholder (condition-message e)))] (c/load-posts posts))]
      (is (= ["rain" "first-light" "broken"] (mapv :slug ps)))
      (is (:broken (last ps)))))
  (testing "drafts"
    (is (some (fn [p] (= "unfinished" (:slug p)))
              (handler-bind [c/BadPost (fn [_] (invoke-restart 'skip-post))] (c/load-posts posts :drafts true)))))
  (testing "nobody handling it: the error, with the restarts on offer"
    (let [offered (atom nil)]
      (try (handler-bind [c/BadPost (fn [_] (reset! offered (set (map :name (compute-restarts)))))]
             (c/load-posts posts))
           (catch c/BadPost _ nil))
      (is (every? @offered '[skip-post use-placeholder])))))
