(ns quire.markdown
  "Markdown's data (norn.markdown) as norn-html forms, so pages can change
  it: headings get ids to link to, images their sizes."
  (:require [norn.string :as str]))

(defn anchor
  "Heading text as an id: lower case, words joined by hyphens."
  [text]
  (-> (str/lower-case text) (str/replace #"[^\p{L}\p{N}]+" "-") (str/replace #"^-|-$" "")))

(defn- text-of [x]
  (cond (string? x) x
        (vector? x) (apply str (map text-of (filter (fn [y] (not (map? y))) (rest x))))
        :else ""))

(defn- parts
  "A Markdown element's attributes map (or {}) and its children."
  [[_ & more]]
  (if (map? (first more)) [(first more) (rest more)] [{} more]))

(defn ->hiccup
  "Markdown data (a block or inline) as norn-html forms. image-size, (fn
  [src]), gives an image's {:width :height} if it knows it."
  [x image-size]
  (if-not (vector? x)
    x
    (let [[attrs kids] (parts x)
          kids (map (fn [k] (->hiccup k image-size)) kids)]
      (case (first x)
        :doc (vec kids)
        :heading (into [(keyword (str "h" (:level attrs))) {:id (anchor (text-of x))}] kids)
        :paragraph (into [:p] kids)
        :code-block [:pre [:code {:class (when (:lang attrs) (str "language-" (:lang attrs)))} (last x)]]
        :block-quote (into [:blockquote] kids)
        :list (into [(if (:ordered attrs) :ol :ul) {:start (when (and (:ordered attrs) (not= 1 (:start attrs))) (:start attrs))}] kids)
        :item (if (contains? attrs :checked)
                (into [:li [:input {:type "checkbox" :disabled true :checked (:checked attrs)}] " "] kids)
                (into [:li] kids))
        :plain (seq kids)
        :table (let [align (:align attrs)]
                 (into [:table] (for [row kids]
                                  (into [(first row)] (map-indexed (fn [i cell]
                                                                     (if-let [a (get align i)]
                                                                       (into [(first cell) {:style {:text-align a}}] (rest cell))
                                                                       cell))
                                                                   (rest row))))))
        :row (into [:tr] (map (fn [c] (if (:head attrs) (assoc c 0 :th) c)) kids))
        :cell (into [:td] kids)
        :thematic-break [:hr]
        :em (into [:em] kids)
        :strong (into [:strong] kids)
        :strike (into [:del] kids)
        :code [:code (last x)]
        :link (into [:a {:href (:href attrs) :title (:title attrs)}] kids)
        :image [:img (merge {:src (:src attrs) :alt (:alt attrs) :title (:title attrs)} (image-size (:src attrs)))]
        :break [:br]
        (into [:span] kids)))))
