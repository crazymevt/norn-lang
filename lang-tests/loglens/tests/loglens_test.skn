(ns loglens-test
  (:require [loglens.logs :as logs]
            [loglens.report :as report]
            [skein.bin :as bin]
            [skein.cbor :as cbor]
            [skein.io :as io]
            [skein.ndjson :as ndjson]
            [skein.string :as str]
            [skein.sys :as sys]
            [skein.test :refer [deftest is testing]]
            [skein.walk]))

(def here (let [loc (%location)] (io/parent (subs loc 0 (str/last-index-of loc ":")))))
(defn- fixture [f] (io/path here "fixtures" f))
(def users (set (ndjson/read-file (fixture "users.ndjson"))))

(deftest reading
  (is (= "/api/users/:id" (logs/route "/api/users/42")))
  (is (= "/api/orders/:id" (logs/route "/api/orders/9?full=1")))
  (is (= "/files/:id/raw" (logs/route "/files/cb03b423-0252-4efc-affb-cf606c3fabee/raw")))
  (is (= "/health" (logs/route "/health")))
  (let [[rs skipped] (logs/read-requests (fixture "small.ndjson"))]
    (is (= 4 (count rs)))
    (is (= 1 skipped) "the warning isn't a request")
    (is (= {:method "POST" :route "/api/orders" :status 500 :ms 300 :bytes 80 :user 1}
           (select-keys (nth rs 2) [:method :route :status :ms :bytes :user])))))

(deftest gzipped-logs-read-as-they-stream
  (let [dir (io/path (sys/temp-dir) (str "loglens-" (sys/pid) "-" (nano-time)))
        path (io/path dir "big.ndjson.gz")
        entries (logs/generate 20000 7)]
    (io/mkdirs! dir)
    (logs/write-log! path entries)
    (is (< (:size (io/info path)) (count (ndjson/write-string entries))) "it's smaller")
    (let [[rs skipped] (logs/read-requests path)]
      (is (= 20000 (+ (count rs) skipped)))
      (is (= (count (filter :user entries)) (count rs))))
    (testing "the same entries, gzip'd or not"
      (logs/write-log! (io/path dir "big.ndjson") entries)
      (is (= (logs/read-requests path) (logs/read-requests (io/path dir "big.ndjson")))))
    (testing "the same seed, the same log"
      (is (= entries (logs/generate 20000 7)))
      (is (not= entries (logs/generate 20000 8))))
    (io/delete! dir :recursive true)))

(deftest reporting
  (let [[rs _] (logs/read-requests (fixture "small.ndjson"))
        s (report/summarize rs users)]
    (is (= {:requests 4 :errors 1 :bytes 3240} (select-keys s [:requests :errors :bytes])))
    (is (= {:count 2 :errors 0 :p50-ms 16 :p95-ms 98/5} (get-in s [:routes "/api/users/:id"])))
    (is (= {"free" 2 "pro" 2} (:plans s)) "joined with users on :user = :id")
    (is (str/starts-with? (report/text s) "4 requests, 25.0% failed, 3.2 KB sent"))
    (testing "saved and compared"
      (let [file (io/path (sys/temp-dir) (str "loglens-" (sys/pid) "-" (nano-time) ".bin"))
            later (report/summarize (conj rs {:route "/api/users/:id" :status 200 :ms 400 :bytes 1 :user 1}) users)]
        (bin/write-file file s)
        (is (= s (bin/read-file file)) "a report reads back as it was")
        (is (= ["/api/users/:id: count 2 → 3, p50-ms 16ms → 20ms, p95-ms 20ms → 362ms"] (vec (report/changes s later))))
        (is (nil? (report/changes s s)))
        (io/delete! file)))
    (testing "exported for other programs: CBOR, string keys, the p95 ratio kept"
      (let [back (cbor/decode (cbor/encode (skein.walk/stringify-keys s)))]
        (is (= 98/5 (get-in back ["routes" "/api/users/:id" "p95-ms"])))))))
