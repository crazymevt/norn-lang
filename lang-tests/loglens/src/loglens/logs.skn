(ns loglens.logs
  "Request logs: JSON Lines, gzip'd or not, one entry a line:

    {\"ts\": \"2026-11-13T07:05:00.123Z\", \"level\": \"info\", \"user\": 42,
     \"msg\": \"GET /api/users/42 200 12ms 512b\"}

  read-requests gives each request, its msg read into parts."
  (:require [skein.compress :as gz]
            [skein.io :as io]
            [skein.ndjson :as ndjson]
            [skein.random :as random]
            [skein.regex :as re]
            [skein.string :as str]
            [skein.time :as t]))

(def request-line
  "A request's msg: method, path, status, milliseconds, bytes."
  #"^(?<method>[A-Z]+) (?<path>\S+) (?<status>\d{3}) (?<ms>\d+)ms (?<bytes>\d+)b$")

(def ^:private id-segment
  "A path segment that's an id: a number or a UUID."
  #"^(\d+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$")

(defn route
  "Path as a route: numbers and ids in it as :id (/api/users/42 → /api/users/:id)."
  [path]
  (str/join "/" (map (fn [seg] (if (re/matches? id-segment seg) ":id" seg))
                     (str/split (first (str/split path #"\?" 2)) #"/"))))

(defn parse-request
  "Log entry e as a request {:ts :user :method :path :route :status :ms
  :bytes}, or nil when its msg isn't one."
  [e]
  (when-let [m (re/match request-line (str (:msg e)))]
    (let [{:keys [method path status ms bytes]} (:named m)]
      {:ts (:ts e) :user (:user e) :method method :path path :route (route path)
       :status (parse-long status) :ms (parse-long ms) :bytes (parse-long bytes)})))

(defn read-requests
  "The requests in log file path (JSON Lines, gzip'd when it ends .gz),
  in order, and how many entries weren't requests: [requests skipped].
  The file is read a line at a time, decompressed as it's read."
  [path]
  (io/with-open [f (io/open path :read)]
    (let [r (io/line-reader (if (str/ends-with? path ".gz") (gz/decompress-stream f :close-source false) f))]
      (ndjson/reduce-records (fn [[rs skipped] e]
                               (if-let [q (parse-request e)] [(conj rs q) skipped] [rs (inc skipped)]))
                             [[] 0] r))))

;; ---- sample logs ----

(def ^:private routes
  [["GET" "/api/users/%d" 6] ["GET" "/api/orders/%d" 4] ["POST" "/api/orders" 2] ["GET" "/health" 1] ["DELETE" "/api/users/%d" 1]])

(defn generate
  "n log entries made up with seed: reproducible. Some aren't requests."
  [n seed]
  (let [g (random/generator seed)
        start (t/parse "2026-11-13T00:00:00Z")]
    (vec (for [i (range n)]
           (let [ts (t/format (t/plus start (t/duration :millis (* i 937))))]
             (if (zero? (random/int g 20))
               {:ts ts :level "warn" :msg (random/choice g ["cache miss storm" "slow disk" "retrying upstream"])}
               (let [[method fmt _] (random/weighted g (into {} (map (fn [r] [r (nth r 2)]) routes)))
                     user (random/int g 1 26)
                     status (random/weighted g {200 90 404 5 500 3 429 2})
                     ms (max 1 (long (* (if (= method "POST") 40 12) (+ 1 (abs (random/gaussian g))))))]
                 {:ts ts :level (if (>= status 500) "error" "info") :user user
                  :msg (str method " " (if (str/includes? fmt "%d") (format fmt (random/int g 1 5000)) fmt)
                            " " status " " ms "ms " (random/int g 100 20000) "b")})))))))

(defn write-log!
  "Write entries to path as JSON Lines, gzip'd if path ends .gz."
  [path entries]
  (let [text (ndjson/write-string entries)]
    (if (str/ends-with? path ".gz")
      (io/write-bytes path (gz/gzip text))
      (io/write-text path text))))
