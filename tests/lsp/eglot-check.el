;;; eglot-check.el --- skein lsp through Emacs's LSP client -*- lexical-binding: t -*-
;;
;; Run by crates/skein/tests/lsp.rs (when Emacs 29 or later is installed),
;; or by hand, in a project with src/geo/shapes.skn as that test writes it:
;;   SKEIN=path/to/skein PROJ=path/to/project emacs --batch -Q -l eglot-check.el
;; Each line it prints is one feature's answer, for the test to check.

(require 'eglot)
(require 'xref)
(require 'flymake)
(define-derived-mode skein-mode prog-mode "Skein")
(add-to-list 'auto-mode-alist '("\\.skn\\'" . skein-mode))
(add-to-list 'eglot-server-programs `(skein-mode . (,(getenv "SKEIN") "lsp")))
(setq eglot-sync-connect t eglot-connect-timeout 30 eglot-events-buffer-config '(:size 0))
(defun say (fmt &rest args) (princ (apply #'format (concat fmt "\n") args)))
(defun at (line text) (goto-char (point-min)) (forward-line (1- line)) (search-forward text) (backward-char 2))
(let ((file (expand-file-name "src/geo/shapes.skn" (getenv "PROJ"))))
  (find-file file)
  (skein-mode)
  (apply #'eglot (eglot--guess-contact))
  (let ((server (eglot-current-server)))
    (say "connected: %s" (plist-get (eglot--server-info server) :name))
    (at 11 "(area")
    (let ((h (jsonrpc-request server :textDocument/hover (eglot--TextDocumentPositionParams))))
      (say "hover: %s" (replace-regexp-in-string "\n" " " (plist-get (plist-get h :contents) :value))))
    (say "definition: %s" (mapcar (lambda (x) (xref-location-line (xref-item-location x)))
                                  (xref-backend-definitions 'eglot (xref-backend-identifier-at-point 'eglot))))
    (at 3 "area")
    (say "references: %s" (mapcar (lambda (x) (xref-location-line (xref-item-location x)))
                                  (xref-backend-references 'eglot (xref-backend-identifier-at-point 'eglot))))
    (goto-char (point-max)) (insert "\n(defn oops [x] (nope x))\n")
    (eglot--signal-textDocument/didChange)
    (let ((tries 0))
      (while (and (null (flymake-diagnostics)) (< tries 100))
        (flymake-start) (accept-process-output nil 0.1) (setq tries (1+ tries))))
    (say "diagnostics: %s" (mapcar #'flymake-diagnostic-text (flymake-diagnostics)))
    (goto-char (point-max)) (insert "(redu")
    (say "completion: %s" (seq-take (all-completions "redu" (nth 2 (eglot-completion-at-point))) 2))
    (erase-buffer) (insert "(ns geo.shapes)\n(defn  f [x]\n      (inc x))\n")
    (eglot-format-buffer)
    (say "formatted: %S" (buffer-string))
    (say "outline: %s" (mapcar #'car (eglot-imenu)))
    (set-buffer-modified-p nil)
    (eglot-shutdown server)
    (say "shut down")))
