;;;; Stream and file helpers: exact reads, bounded copies, decoded text,
;;;; exclusive creation, temporary files and atomic replacement.

(ns io-test
  (:require [skein.test :refer [deftest is testing]] [skein.io :as io] [skein.bytes :as b]))

(defn- caught [f] (try (f) nil (catch Error e e)))

(deftest exact-reads-and-copies
  (io/with-temp-directory [d]
    (let [f (io/path d "data.bin")]
      (io/write-bytes f (bytes (range 10)))
      (io/with-open [h (io/open f :read)]
        (is (= [0 1 2 3] (vec (io/read-exactly h 4))))
        (is (= [4 5 6 7 8 9] (vec (io/read-exactly h 6))))
        (is (nil? (io/read-exactly h 3)) "nil at the end, before any byte"))
      (io/with-open [h (io/open f :read)]
        (io/read-exactly h 8)
        (let [e (caught #(io/read-exactly h 5))]
          (is (= "IOError" (name (class-name (class-of e)))))
          (is (= :truncated (:reason (ex-data e))))))
      (let [out (io/path d "copy.bin")]
        (is (= 7 (io/with-open [in (io/open f :read)]
                   (io/with-open [o (io/open out :write)] (io/copy-stream! in o :limit 7)))))
        (is (= [0 1 2 3 4 5 6] (vec (io/read-bytes out))))
        (is (= 10 (io/with-open [in (io/open f :read)]
                    (io/with-open [o (io/open out :write)] (io/copy-stream! in o)))))))))

(deftest decoded-text-from-a-stream
  (io/with-temp-file [t]
    (let [text (apply str (repeat 30000 "é🙂"))]
      (io/write-text t text)
      (is (= text (io/with-open [h (io/open t :read)]
                    (let [r (io/text-reader h)]
                      (loop [pieces []]
                        (if-let [c (io/read-chunk r)] (recur (conj pieces c)) (apply str pieces))))))
          "characters split between reads come whole"))
    (io/write-bytes t (b/unhex "61c3"))
    (is (some? (io/with-open [h (io/open t :read)]
                 (let [r (io/text-reader h)]
                   (try (io/read-chunk r) (io/read-chunk r) nil (catch ParseError e e)))))
        "a stream ending partway through a character")
    (io/write-bytes t (b/unhex "fffe6100"))
    (is (= "﻿a" (io/with-open [h (io/open t :read)] (io/read-chunk (io/text-reader h :encoding :utf-16le)))))))

(deftest exclusive-creation-and-temporary-files
  (io/with-temp-directory [d]
    (let [f (io/path d "only.txt")]
      (io/with-open [h (io/open f :create-new)] (io/write h "first"))
      (is (= "FileExists" (name (class-name (class-of (caught #(io/open f :create-new)))))))
      (is (= "first" (io/read-text f)) "an existing file is left alone"))
    (let [seen (atom nil)]
      (io/with-temp-file [p :dir d :prefix "x-" :suffix ".json"]
        (reset! seen p)
        (is (io/file? p))
        (is (= ".json" (str "." (io/extension p)))))
      (is (not (io/exists? @seen)) "deleted when the body ends")
      (try (io/with-temp-directory [sub :dir d] (reset! seen sub) (io/write-text (io/path sub "a") "") (error "stop"))
           (catch Error _ nil))
      (is (not (io/exists? @seen)) "and with everything in it, even after an error"))
    (is (= 2 (count (set (repeatedly 2 #(io/temp-file :dir d))))) "names differ")))

(deftest atomic-replacement
  (io/with-temp-directory [d]
    (let [target (io/path d "config.txt")]
      (io/write-text target "old")
      (io/write-atomic! target "new contents")
      (is (= "new contents" (io/read-text target)))
      (is (= ["config.txt"] (io/list-dir d)) "no file left beside it")
      (is (some? (caught #(io/with-atomic-file [h target] (io/write h "half") (error "boom")))))
      (is (= "new contents" (io/read-text target)) "a failed write leaves the file as it was")
      (is (= ["config.txt"] (io/list-dir d)))
      (is (= :done (io/with-atomic-file [h (io/path d "fresh.txt")] (io/write h "made") :done)) "the body's value")
      (is (= "made" (io/read-text (io/path d "fresh.txt")))))
    (testing "sync! flushes a handle"
      (io/with-open [h (io/open (io/path d "s") :write)]
        (io/write h "x")
        (is (nil? (io/sync! h)))))))

;; A class that is a stream: stream-read, stream-write and stream-close
;; methods make the stream functions take its instances.
(defclass Letters () ((left :required true) (written :initform nil) (closed :initform nil)))
(defmethod io/stream-read ((s Letters) n)
  (let [left @(:left s)]
    (when (seq left)
      (let [piece (subs left 0 (min n (count left)))]
        (reset! (:left s) (subs left (count piece)))
        (bytes piece)))))
(defmethod io/stream-write ((s Letters) data) (swap! (:written s) conj (bytes->string data)))
(defmethod io/stream-close ((s Letters)) (reset! (:closed s) true))

(deftest instances-as-streams
  (let [s (Letters :left (atom "ab\ncd\nlast") :written (atom []) :closed (atom false))]
    (let [r (io/line-reader s)]
      (is (= ["ab" "cd" "last" nil] [(io/read-line r) (io/read-line r) (io/read-line r) (io/read-line r)])))
    (io/write s "out")
    (is (= ["out"] @(:written s)))
    (io/with-open [_ s] nil)
    (is (true? @(:closed s)) "with-open closes it"))
  (let [s (Letters :left (atom (apply str (repeat 5000 "xy"))) :written (atom []) :closed (atom false))]
    (io/with-temp-file [f]
      (io/with-open [out (io/open f :write)] (is (= 10000 (io/copy-stream! s out))))
      (is (= 10000 (count (io/read-text f)))))))

(defclass Logged () (name log))
(defmethod io/stream-close ((s Logged)) (swap! (:log s) conj (:name s)))

(deftest with-open-several
  (let [log (atom [])]
    (is (= [:a :b :c] (io/with-open [a (Logged :name :a :log log) b (Logged :name :b :log log) c (Logged :name (:name b) :log log)]
                        (swap! log conj :body)
                        [(:name a) (:name b) :c]))
        "a later init sees the earlier names")
    (is (= [:body :b :b :a] @log) "closed last first"))
  (let [log (atom [])]
    (is (= "boom" (try (io/with-open [a (Logged :name :a :log log) b (error "boom") c (Logged :name :c :log log)] :never)
                       (catch Error e (condition-message e)))))
    (is (= [:a] @log) "an init that fails closes what was opened before it"))
  (let [log (atom [])]
    (try (io/with-open [a (Logged :name :a :log log) b (Logged :name :b :log log)] (error "in body")) (catch Error _ nil))
    (is (= [:b :a] @log) "a body that fails closes them all"))
  (is (= :ok (io/with-open [] :ok)))
  (is (try (eval '(skein.io/with-open [a] a)) false (catch Error _ true)) "an odd binding vector"))

(deftest line-readers
  (io/with-temp-file [f]
    (let [long-line (apply str (repeat 200000 "x"))]
      (io/write-text f (str "one\r\ntwo\n" long-line "\nlast"))
      (io/with-open [h (io/open f :read)]
        (let [r (io/line-reader h)]
          (is (io/line-reader? r))
          (is (= "#<line-reader>" (pr-str r)) "opaque")
          (is (= ["one" "two"] [(io/read-line r) (io/read-line r)]) "CRLF or LF")
          (is (= long-line (io/read-line r)) "a line across many reads")
          (is (= "last" (io/read-line r)) "the last line, without a newline")
          (is (nil? (io/read-line r)))))))
  (testing "a line reader is a stream: what it holds comes first"
    (io/with-temp-file [f]
      (io/write-text f "head\nrest of the data")
      (io/with-open [h (io/open f :read)]
        (let [r (io/line-reader h)]
          (is (= "head" (io/read-line r)))
          (is (= "rest of the data" (bytes->string (io/read-all r))))))))
  (testing "many lines in linear time"
    (io/with-temp-file [f]
      (io/write-text f (apply str (repeat 50000 "a line of text\n")))
      (let [t0 (nano-time)
            n (io/with-open [h (io/open f :read)]
                (let [r (io/line-reader h)] (loop [n 0] (if (io/read-line r) (recur (inc n)) n))))]
        (is (= 50000 n))
        ;; (about 0.5 s in a debug build; the limit leaves room for a loaded
        ;; machine, the workspace run's suites in parallel)
        (is (< (quot (- (nano-time) t0) 1000000) 30000) "(quadratic copying took minutes)")))))
