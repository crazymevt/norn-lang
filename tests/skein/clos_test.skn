;;;; Classes and generic functions (design.md §4).
;;;; Run by crates/skein-vm/tests/skein_suites.rs, or `skein tests/skein/clos_test.skn`.

(ns clos-test
  (:require [skein.test :refer [is]] [skein.string :as str]))

(defn error-of [thunk] (:error (settle (spawn-detached (thunk)))))

;;; builtin classes
(is (= Integer (class-of 1)))
(is (= Float (class-of 1.5)))
(is (= Null (class-of nil)))
(is (= List (class-of '(1))))
(is (= List (class-of ())))
(is (= Vector (class-of [1])))
(is (= Map (class-of {})))
(is (= Keyword (class-of :k)))
(is (= Function (class-of inc)))
(is (= Function (class-of (fn [] 1))))
(is (= Class (class-of Integer)))
(is (= [Integer Number Object] (class-precedence-list Integer)))
(is (= true (instance? Number 1)))
(is (= true (instance? Sequential [1])))
(is (= false (instance? Map [1])))
(is (= true (subclass? GenericFunction Function)))

;;; defclass, instances
(defclass shape () ())
(defclass circle (shape)
  ((radius :initform 1 :reader radius :doc "in metres")))
(defclass rect (shape)
  ((w :reader w :required true)
   (h :reader h :initform 1)))
(is (= true (class? circle)))
(is (= [circle shape StandardObject Object] (class-precedence-list circle)))
(is (= 3 (radius (circle :radius 3))))
(is (= 1 (radius (circle))))
(is (= 1 (radius (make circle))))
(is (= 2 (:radius (circle :radius 2))))
(is (= 2 (get (circle :radius 2) :radius)))
(is (= :none (get (circle) :nope :none)))
(is (= '(:radius) (keys (circle))))
(is (= {:w 2 :h 1} (instance->map (rect :w 2))))
(is (= "#clos-test/rect{:w 2, :h 1}" (pr-str (rect :w 2))))
(is (= true (instance? shape (rect :w 1))))
(is (= circle (class-of (circle))))
;; values: structural equality, functional update
(is (= true (= (circle :radius 2) (circle :radius 2))))
(is (= false (= (circle :radius 2) (circle :radius 3))))
(is (= true (= (hash (circle :radius 2)) (hash (circle :radius 2)))))
(let [c (circle :radius 2) d (with c :radius 5)]
  (is (= 2 (radius c)))
  (is (= 5 (radius d)))
  (is (= 7 (radius (assoc c :radius 7)))))
(is (= #{(circle :radius 1)} (conj #{(circle :radius 1)} (circle :radius 1))))
;; errors
(is (= "Missing required slot :w for clos-test/rect" (error-of (fn [] (rect)))))
(is (= "clos-test/circle has no initarg :nope" (error-of (fn [] (circle :nope 1)))))
(is (= "clos-test/circle has no slot :nope" (error-of (fn [] (with (circle) :nope 1)))))
(is (= "Can't make an instance of skein.core/Integer" (error-of (fn [] (make Integer)))))

;;; multiple inheritance (C3)
(defclass a () ((x :initform :a)))
(defclass b (a) ((y :initform :b)))
(defclass c (a) ((x :initform :c)))
(defclass d (b c) ())
(is (= [d b c a StandardObject Object] (class-precedence-list d)))
(is (= {:x :c :y :b} (instance->map (d))))

;;; generic functions: multiple dispatch, eql, builtins
(defgeneric area (s))
(defmethod area ((c circle)) (* 3 (radius c) (radius c)))
(defmethod area ((r rect)) (* (w r) (h r)))
(is (= 12 (area (circle :radius 2))))
(is (= 10 (area (rect :w 2 :h 5))))
(is (= true (generic? area)))
(is (= true (instance? Function area)))

(defgeneric collide (x y))
(defmethod collide ((x circle) (y rect)) :circle-rect)
(defmethod collide ((x shape) (y shape)) :shapes)
(defmethod collide ((x rect) (y circle)) [:flip (collide y x)])
(is (= :circle-rect (collide (circle) (rect :w 1))))
(is (= [:flip :circle-rect] (collide (rect :w 1) (circle))))
(is (= :shapes (collide (circle) (circle))))

(defgeneric describe (x))
(defmethod describe ((x Integer)) [:int x])
(defmethod describe ((x (eql 0))) :zero)
(defmethod describe ((x Object)) :thing)
(defmethod describe ((x String)) [:str (call-next-method)])
(defmethod describe ((x Number)) [:num (next-method?)])
(is (= [:int 5] (describe 5)))
(is (= :zero (describe 0)))
(is (= [:num true] (describe 1.5)))
(is (= [:str :thing] (describe "s")))
(is (= :thing (describe nil)))
(is (= :thing (describe circle)))

;;; standard method combination
(def log (atom []))
(defgeneric greet (x))
(defmethod greet ((x shape)) (swap! log conj :shape) :hello)
(defmethod greet ((x circle)) (swap! log conj :circle) (call-next-method))
(defmethod greet :before ((x shape)) (swap! log conj :before-shape))
(defmethod greet :before ((x circle)) (swap! log conj :before-circle))
(defmethod greet :after ((x shape)) (swap! log conj :after-shape))
(defmethod greet :after ((x circle)) (swap! log conj :after-circle))
(defmethod greet :around ((x shape)) (swap! log conj :around-shape) [:wrapped (call-next-method)])
(defmethod greet :around ((x circle)) (swap! log conj :around-circle) (call-next-method))
(is (= [:wrapped :hello] (greet (circle))))
(is (= [:around-circle :around-shape :before-circle :before-shape :circle :shape :after-shape :after-circle] @log))

;;; simple method combinations
(defgeneric total (x) (:method-combination +))
(defmethod total + ((x Integer)) 1)
(defmethod total + ((x Number)) 10)
(defmethod total + ((x Object)) 100)
(is (= 111 (total 3)))
(is (= 110 (total 2.5)))
(defgeneric valid? (x) (:method-combination and))
(defmethod valid? and ((x Number)) (pos? x))
(defmethod valid? and ((x Integer)) (even? x))
(is (= true (valid? 4)))
(is (= false (valid? 3)))
(defgeneric tags (x) (:method-combination list))
(defmethod tags list ((x circle)) :circle)
(defmethod tags list ((x shape)) :shape)
(is (= '(:circle :shape) (tags (circle))))

;;; rest arguments
(defgeneric join-all (sep & xs))
(defmethod join-all ((sep String) & xs) (apply str (interpose sep xs)))
(defmethod join-all ((sep Keyword) & xs) [sep (call-next-method)])
(defmethod join-all ((sep Object) & xs) (count xs))
(is (= "a-b-c" (join-all "-" "a" "b" "c")))
(is (= [:k 2] (join-all :k 1 2)))

;;; custom dispatch (multimethod style)
(defgeneric render (x) (:dispatch :format))
(defmethod render :html [x] (str "<p>" (:text x) "</p>"))
(defmethod render :default [x] (:text x))
(defmethod render [:md :fancy] [x] "fancy md")
(is (= "<p>hi</p>" (render {:format :html :text "hi"})))
(is (= "plain" (render {:format :txt :text "plain"})))
(is (= "fancy md" (render {:format [:md :fancy]})))
(defgeneric kind-of (x) (:dispatch class-of))
(defmethod kind-of Number [x] :number)
(defmethod kind-of shape [x] :shape)
(defmethod kind-of :default [x] :other)
(is (= :number (kind-of 1)))
(is (= :shape (kind-of (rect :w 1))))
(is (= :other (kind-of "s")))

;;; errors
(is (= "No applicable method for clos-test/area with arguments (5)" (error-of (fn [] (area 5)))))
(is (= "Wrong number of args (2) passed to: #<generic clos-test/area>" (error-of (fn [] (area 1 2)))))
(defgeneric only-around (x))
(defmethod only-around :around ((x Object)) (call-next-method))
(is (= "No applicable method for clos-test/only-around with arguments (1)" (error-of (fn [] (only-around 1)))))

;;; live redefinition
(defgeneric speak (x))
(defmethod speak ((x circle)) :old)
(is (= :old (speak (circle))))
(defmethod speak ((x circle)) :new)
(is (= :new (speak (circle))))
(is (= 1 (count (generic-methods speak))))
(%remove-method speak [circle] nil)
(is (= "No applicable method for clos-test/speak with arguments (#clos-test/circle{:radius 1})"
       (error-of (fn [] (speak (circle))))))

;;; class redefinition: identity kept, old instances follow the new definition
(defclass point () ((x :initform 0) (y :initform 0)))
(def p1 (point :x 1 :y 2))
(defgeneric norm1 (p))
(defmethod norm1 ((p point)) (+ (:x p) (:y p)))
(is (= 3 (norm1 p1)))
(def point-before point)
(defclass point () ((x :initform 0) (y :initform 0) (z :initform 7)))
(is (= true (identical? point-before point)))
(is (= 7 (:z p1)))
(is (= 1 (:x p1)))
(is (= 3 (norm1 p1)))
(is (= "#clos-test/point{:x 1, :y 2, :z 7}" (pr-str p1)))
(is (= {:x 1 :y 2 :z 9} (instance->map (with p1 :z 9))))
(defclass point () ((x :initform 0) (z :initform 7)))
(is (= nil (get p1 :y)))
(is (= 1 (:x p1)))
;; Keys stay findable when a redefinition adds a defaulted slot, even ahead
;; of the others: a slot holding its default adds nothing to the hash.
(defclass keyed () ((x :initform 0) (tag :initform nil)))
(let [a (keyed :x 1) b (keyed :x 2 :tag [:t]) s #{a b} m {a :a b :b} before (hash a)]
  (defclass keyed () ((added :initform 5) (x :initform 0) (tag :initform nil)))
  (is (= [true true :a :b] [(contains? s a) (contains? s b) (get m a) (get m b)]))
  (is (= before (hash a)))
  (is (= true (contains? s (keyed :x 1))) "an equal new instance finds it too")
  (is (= false (contains? s (keyed :x 1 :added 6))) "a different value doesn't"))
;; Redefining a superclass reaches subclasses (and their dispatch caches).
(defclass base () ((v :initform 1)))
(defclass derived (base) ())
(defgeneric who (x))
(defmethod who ((x base)) :base)
(is (= :base (who (derived))))
(defclass mixin () ())
(defmethod who ((x mixin)) :mixin)
(defclass derived (mixin base) ())
(is (= :mixin (who (derived))))
(is (= 1 (:v (derived))))

;; An initform runs when an instance needs it: not when the class is
;; defined or redefined, but for a slot a redefinition adds, once, when
;; instances made before it exist.
(def initforms-run (atom 0))
(defclass counted () ((a :initform (swap! initforms-run inc))))
(defclass counted () ((a :initform (swap! initforms-run inc)) (b :initform 2)))
(is (= 0 @initforms-run) "defining and redefining run none")
(def counted-1 (counted))
(is (= [1 1] [@initforms-run (:a counted-1)]))
(defclass counted () ((a :initform (swap! initforms-run inc)) (b :initform 2) (c :initform (swap! initforms-run inc))))
(is (= [2 2] [@initforms-run (:c counted-1)]) "a new slot's, for the instance made before")
(defclass counted () ((a :initform (swap! initforms-run inc)) (b :initform 2) (c :initform (swap! initforms-run inc)) (d)))
(is (= [2 2] [@initforms-run (:c counted-1)]) "once: a slot the old layout had keeps its value")

;; A slot's :type is checked, as a signature's type is, when an instance is
;; made, copied with changes, or has a slot set.
(defn slot-violation [thunk]
  (try (thunk) nil (catch ContractError e [(:function e) (:position e) (:expected e) (:value e)])))
(defclass typed-node () ((n :type Integer) (label :type (? String)) (xs :type (Vec Integer) :initform [])
                                           (next :type (? typed-node))))
(is (= 2 (:n (:next (typed-node :n 1 :next (typed-node :n 2))))) "a slot may name its own class")
(is (= ["clos-test/typed-node" "its slot :n" "Integer" "1"] (slot-violation (fn [] (typed-node :n "1")))))
(is (= "a vector of Integer" (nth (slot-violation (fn [] (typed-node :n 1 :xs [1 :x]))) 2)))
(is (= "nil or String" (nth (slot-violation (fn [] (with (typed-node :n 1) :label :x))) 2)))
(is (= "Integer" (nth (slot-violation (fn [] (assoc (typed-node :n 1) :n 1.5))) 2)))
(is (= "Integer" (nth (slot-violation (fn [] (make typed-node :n nil))) 2)))
(defclass typed-box () ((v :type Integer :mutable true :initform 0)) (:mutable))
(let [b (typed-box)]
  (is (= ["its slot :v" "Integer" "x"] (subvec (slot-violation (fn [] (set-slot! b :v "x"))) 1 4)))
  (is (= "Integer" (nth (slot-violation (fn [] (update-slot! b :v str))) 2)))
  (set-slot! b :v 5)
  (is (= 6 (update-slot! b :v inc))))
(defclass typed-node () ((n)))
(is (= "any" (:n (typed-node :n "any"))) "a redefinition without types checks nothing")

;;; dispatch is safe and live across fibers on all carriers
(defgeneric work (x))
(defmethod work ((x Integer)) :v1)
(let [seen (atom #{})
      stop (atom false)
      workers (mapv (fn [_] (spawn-detached
                              (loop [n 0]
                                (let [r (work n)]
                                  (swap! seen conj r)
                                  (if (or @stop (> n 1000000)) n (recur (inc n)))))))
                    (range 8))]
  ;; redefine only once a worker has seen the first method (under GC stress
  ;; and parallel suites they can take a while to start)
  (loop [i 0] (when (and (not (contains? @seen :v1)) (< i 500)) (sleep 10) (recur (inc i))))
  (defmethod work ((x Integer)) :v2)
  ;; (and stop only once one has seen the second: 20 ms wasn't always enough)
  (loop [i 0] (when (and (not (contains? @seen :v2)) (< i 2000)) (sleep 10) (recur (inc i))))
  (reset! stop true)
  (doseq [w workers] (await w))
  (is (= #{:v1 :v2} @seen))
  (is (= :v2 (work 1))))

;;; A method on another namespace's generic function extends that function in
;;; place (it doesn't define a new one here).
(defclass gadget () ())
(defmethod on-image-restore ((g gadget)) :gadget)
(is (= :gadget (skein.core/on-image-restore (gadget))))
(is (= nil (on-image-restore 42)))
(is (= false (contains? (ns-publics 'clos-test) 'on-image-restore)))
(defmethod skein.core/reconnect ((g gadget)) :again)
(is (= :again (skein.core/reconnect (gadget))))

;;; ---- equality declarations (design §3.4) ----
(defclass tagged () ((v) (note :compare false)))
(defclass entity () ((id)) (:equality :identity))
(is (= true (= (tagged :v 1 :note "a") (tagged :v 1 :note "b"))))
(is (= true (= (hash (tagged :v 1 :note "a")) (hash (tagged :v 1 :note "b")))))
(is (= false (= (tagged :v 1) (tagged :v 2))))
(is (= false (= (entity :id 1) (entity :id 1))))
(is (= true (let [e (entity :id 1)] (= e e))))
(is (= 2 (count (set [(entity :id 1) (entity :id 1)]))))
(defclass entity-child (entity) ((name)))
(is (= false (= (entity-child :id 1) (entity-child :id 1))))

;;; ---- owned mutable objects (design §4.2) ----
(defclass account () ((holder) (balance :mutable true :initform 0)) (:mutable))
(def acct (account :holder "jo"))
(is (= true (mutable? acct)))
(is (= false (mutable? (tagged :v 1))))
(is (= true (identical? (current-fiber) (owner acct))))
(is (= false (= (account :holder "x") (account :holder "x"))))
(is (= 10 (set-slot! acct :balance 10)))
(is (= 15 (update-slot! acct :balance + 5)))
(is (= 15 (:balance acct)))
(is (= :error (try (set-slot! acct :holder "x") (catch Error e :error))))
(is (= :error (try (set-slot! (tagged :v 1) :v 2) (catch Error e :error))))
(is (= :not-yours (await (spawn-detached (try (:balance acct) (catch OwnershipError e :not-yours))))))
(is (= :not-yours (await (spawn-detached (try (set-slot! acct :balance 0) (catch OwnershipError e :not-yours))))))
(is (= 15 (await (spawn-detached (binding [*inspecting* true] (:balance acct))))))
;; release!: the next fiber to touch it claims it
(release! acct)
(is (= nil (owner acct)))
(def taker (spawn-detached (update-slot! acct :balance inc) (current-fiber)))
(is (= true (identical? (await taker) (owner acct))))
;; its owner has finished, so it is free again
(is (= 16 (:balance acct)))
(is (= true (identical? (current-fiber) (owner acct))))
;; sent on a channel: the receiver claims it
(let [c (account :holder "ch") ch (chan 1)]
  (put! ch c)
  (is (= nil (owner c)))
  (is (= 99 (await (spawn-detached (let [x (take! ch)] (set-slot! x :balance 99) (:balance x)))))))
;; shared: every fiber may use it; changes take its lock
(let [b (share (account :holder "kim"))]
  (is (= :shared (owner b)))
  (mapv await (mapv (fn [_] (spawn-detached (dotimes [_ 100] (update-slot! b :balance inc)))) (range 10)))
  (is (= 1000 (:balance b)))
  (is (= [1000 1000] (locking b [(:balance b) (locking b (:balance b))]))))
(is (= :error (try (locking (account) 1) (catch Error e :error))))
;; with on a mutable object: a copy that the caller owns
(let [copy (with acct :holder "copy")]
  (is (= true (identical? (current-fiber) (owner copy))))
  (is (= [16 "copy"] [(:balance copy) (:holder copy)])))
(is (= :needs-mutable (try (eval '(defclass bad () ((v :mutable true)))) (catch Error e :needs-mutable))))
(defclass savings (account) ((rate)))
(is (= true (mutable? (savings :holder "s"))))

;;; collections a library defines: collection-seq (and optionally
;;; collection-count and collection-nth) make seq, count, nth and everything
;;; built on them take a class's instances
(defclass countdown () ((from :initform 3)))
(defmethod collection-seq ((c countdown)) (range (:from c) 0 -1))
(let [c (countdown :from 4)]
  (is (= [4 [4 3 2 1] 3 :none 10] [(count c) (vec c) (nth c 1) (nth c 9 :none) (reduce + c)]))
  (is (= [5 4 3 2] (into [] (map inc) c)))
  (is (= [4 3] (take 2 c)))
  (is (= [false true] [(empty? c) (empty? (countdown :from 0))])))
(defclass counted () ((n :initform 0)))
(def counted-calls (atom 0))
(defmethod collection-seq ((c counted)) (range (:n c)))
(defmethod collection-count ((c counted)) (swap! counted-calls inc) (:n c))
(defmethod collection-nth ((c counted) i)
  (when-not (< -1 i (:n c)) (error IndexError :message "out of range" :index i))
  (* 10 i))
(is (= [7 30 :none] [(count (counted :n 7)) (nth (counted :n 7) 3) (nth (counted :n 2) 5 :none)]))
(is (pos? @counted-calls) "count used the class's own method")
(defclass plain-thing () ((x)))
(is (= "Don't know how to create a seq from plain-thing"
       (try (seq (plain-thing)) (catch TypeError e (condition-message e)))))
;; a method's error unwinds to the caller's handler like any other
(defclass faulty () ())
(defmethod collection-seq ((f faulty)) (error "broken collection"))
(is (= "broken collection" (try (count (faulty)) (catch Error e (condition-message e)))))
(is (= :index-error (try (nth (counted :n 1) 4) (catch IndexError _ :index-error))))
;; a defclass that isn't one says what one looks like (it was "Wrong number
;; of args (2) passed to: #<fn skein.core/defclass>")
(let [m (fn [form] (try (macroexpand form) nil (catch Error e (condition-message e))))]
  (is (str/starts-with? (m '(defclass shape [x]))
                        "defclass: expected (defclass name (supers…) (slots…) options…), got (defclass shape [x])"))
  (is (str/starts-with? (m '(defclass shape (x y))) "defclass: expected"))
  (is (str/starts-with? (m '(defclass shape)) "defclass: expected"))
  (is (str/starts-with? (m '(defclass "shape" () ())) "defclass: expected"))
  (is (nil? (m '(defclass shape () ()))))
  (is (nil? (m '(defclass shape [] [x] (:doc "vectors do too"))))))
