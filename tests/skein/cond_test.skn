;;;; Conditions, restarts, dynamic bindings, the debugger (design.md §5).
;;;; Run by crates/skein-vm/tests/skein_suites.rs, or `skein tests/skein/cond_test.skn`.

(ns cond-test
  (:require [skein.test :refer [is]]))

(defn wait-until [pred]
  (loop [n 0] (cond (pred) true (> n 10000) false :else (do (sleep 2) (recur (inc n))))))

;;; try / catch / finally
(is (= :caught (try (/ 1 0) (catch RuntimeError e :caught))))
(is (= "Divide by zero" (try (/ 1 0) (catch Error e (condition-message e)))))
(is (= 3 (try (+ 1 2) (catch Error e :no))))
(is (= [:body :finally] (let [log (atom [])]
                          (try (swap! log conj :body) (finally (swap! log conj :finally)))
                          @log)))
(is (= [:catch :finally] (let [log (atom [])]
                           (try (error "x") (catch Error e (swap! log conj :catch)) (finally (swap! log conj :finally)))
                           @log)))
(is (= :outer (try (try (error "x") (catch Warning w :inner)) (catch Error e :outer))))
(is (= "<string>:1: Divide by zero" (try (load-string "(/ 1 0)") (catch Error e (condition-text e)))))

;;; handler-case, custom condition classes
(defclass parse-error (Error) ((line :initform nil)))
(is (= [3 "bad token"] (handler-case (error parse-error :message "bad token" :line 3)
                         (parse-error [e] [(:line e) (condition-message e)]))))
(is (= :second (handler-case (error parse-error)
                 (Warning [] :first)
                 (Error [] :second))))
(is (= "a b 3" (handler-case (error "a" 'b 3) (SimpleError [e] (condition-message e)))))
(is (= true (instance? Error (handler-case (error "x") (Condition [e] e)))))
(is (= nil (ignore-errors (error "x"))))

;;; handler-bind: runs before unwinding, can decline
(is (= [:inner :outer :caught]
       (let [log (atom [])]
         (handler-case
           (handler-bind [Error (fn [c] (swap! log conj :outer))]
             (handler-bind [Error (fn [c] (swap! log conj :inner))]
               (error "x")))
           (Error [] (swap! log conj :caught)))
         @log)))
(is (= nil (signal (make SimpleError :message "nobody listens"))))

;;; restarts on runtime errors: use-value, retry
(is (= 100 (handler-bind [RuntimeError (fn [c] (invoke-restart 'use-value 99))]
             (+ 1 (/ 1 0)))))
(defn tail-divide [x] (/ 10 x))
(is (= 7 (handler-bind [RuntimeError (fn [c] (invoke-restart 'use-value 7))] (tail-divide 0))))
(is (= 42 (handler-bind [RuntimeError (fn [c] (eval '(def late-var 41)) (invoke-restart 'retry))]
            (+ 1 (eval 'late-var)))))
(is (= ['use-value 'retry]
       (handler-bind [RuntimeError (fn [c] (invoke-restart 'use-value (mapv :name (compute-restarts))))]
         (/ 1 0))))

;;; restart-case
(is (= 10 (restart-case (invoke-restart 'again 5) (again [n] (* n 2)))))
(is (= :default (restart-case (+ 1 (invoke-restart 'use-default)) (use-default [] :default))))
(is (= nil (with-simple-restart skip "Skip it" (invoke-restart 'skip))))
(is (= :done (with-simple-restart skip "Skip it" :done)))
(is (= nil (find-restart 'nothing-here)))
(defn parse-entry [s]
  (restart-case (if (= s "bad") (error parse-error :message s) s)
    (skip-entry [] nil)
    (use-default [v] v)))
(is (= ["a" "c"] (handler-bind [parse-error (fn [c] (invoke-restart 'skip-entry))]
                   (vec (keep parse-entry ["a" "bad" "c"])))))
(is (= ["a" "?" "c"] (handler-bind [parse-error (fn [c] (invoke-restart 'use-default "?"))]
                       (mapv parse-entry ["a" "bad" "c"]))))
(is (= "No active restart named nope" (handler-case (invoke-restart 'nope) (Error [e] (condition-message e)))))

;;; unwind-protect and non-local exits
(is (= [:inner-cleanup :outer-cleanup :caught]
       (let [log (atom [])]
         (try
           (unwind-protect
             (unwind-protect (error "x") (swap! log conj :inner-cleanup))
             (swap! log conj :outer-cleanup))
           (catch Error e (swap! log conj :caught)))
         @log)))
(is (= [:result [:cleanup]] (let [log (atom [])] [(unwind-protect :result (swap! log conj :cleanup)) @log])))
(is (= 7 (catch-tag :out (+ 1 (throw-tag :out 7)))))
(is (= :inner (catch-tag :a (catch-tag :b (throw-tag :b :inner)))))

;;; dynamic bindings
(def ^:dynamic *depth* 0)
(defn depth [] *depth*)
(is (= [0 1 2 1 0] [(depth) (binding [*depth* 1] (depth))
                    (binding [*depth* 1] (binding [*depth* 2] (depth)))
                    (binding [*depth* 1] (binding [*depth* 2] :x) (depth))
                    (depth)]))
(is (= 0 (do (try (binding [*depth* 5] (error "x")) (catch Error e nil)) (depth))))
(is (= 7 (binding [*depth* 7] (await (spawn-detached (depth))))))
(is (= 0 (let [f (spawn-detached (do (sleep 5) (depth)))] (binding [*depth* 9] (await f)))))
(is (= [:child-handled] (let [log (atom [])]
                          (handler-bind [Error (fn [c] (swap! log conj :child-handled))]
                            (settle (spawn-detached (error "in child"))))
                          @log)))
;; handler-case can't unwind into another fiber's stack: the child fails on its own.
(is (= {:error "in child"} (handler-case (settle (spawn-detached (error "in child")))
                             (Error [] :parent-caught))))

;;; cancellation and stack overflow run cleanups
(let [log (atom [])
      f (spawn-detached (unwind-protect (take! (chan)) (swap! log conj :cleaned)))]
  (sleep 5)
  (cancel! f)
  (is (= {:error "Cancelled"} (settle f)))
  (is (= [:cleaned] @log)))
(defn forever [n] (inc (forever n)))
(let [log (atom [])
      f (spawn-detached (unwind-protect (forever 1) (swap! log conj :cleaned)))]
  (is (= {:error "Stack overflow"} (settle f)))
  (is (= [:cleaned] @log)))

;;; the debugger
;; (each check looks for its own fiber: other suites running in this
;; process at the same time, as under cargo test, park theirs too)
(defn parked "Fiber id's entry in the debugger, or nil." [id] (first (filter (fn [d] (= id (:fiber d))) (debugging))))
;; (error …) is not in tail position, so half's frame stays on the stack: a tail
;; call would replace it (proper tail calls), leaving nothing to restart.
(defn half [x] (when (odd? x) (error "odd:" x)) (quot x 2))
(defn halve-all [xs] (mapv half xs))
(let [f (binding [*debugger* :park] (spawn-detached (halve-all [2 3 4])))
      id (fiber-id f)]
  (is (= true (wait-until (fn [] (parked id)))))
  (is (= "odd: 3" (:condition (parked id))))
  (let [frames (backtrace id)
        i (some (fn [i] (when (= 'cond-test/half (:fn (nth frames i))) i)) (range (count frames)))]
    (is (= {'x 3} (:locals (nth frames i))))
    (is (= 6 (eval-in-frame id i '(* x 2))))
    (defn half [x] (quot x 2))
    (debug-restart-frame id i))
  (is (= [1 1 2] (await f)))
  (is (nil? (parked id))))
(let [f (binding [*debugger* :park] (spawn-detached (+ 1 (/ 1 0))))
      id (fiber-id f)]
  (wait-until (fn [] (parked id)))
  (debug-restart id 0 41)
  (is (= 42 (await f))))
(let [log (atom [])
      f (binding [*debugger* :park] (spawn-detached (unwind-protect (error "give up") (swap! log conj :cleanup))))
      id (fiber-id f)]
  (wait-until (fn [] (parked id)))
  (debug-abort id)
  (is (= {:error "give up"} (settle f)))
  (is (= [:cleanup] @log)))
;; A fiber cancelled while it waits in the debugger (Ctrl-C at the REPL, or
;; its scope failing) leaves it: it isn't listed, and debug-abort on it is
;; an error, not a wait.
(let [f (binding [*debugger* :park] (spawn-detached (/ 1 0)))
      id (fiber-id f)]
  (wait-until (fn [] (parked id)))
  (cancel! f)
  (is (= {:error "Cancelled"} (settle f)))
  (is (nil? (parked id)))
  (is (thrown? Error (debug-abort id))))
;;; warn and muffle-warning
(is (= "WARNING: careful 1\n" (with-out-str (warn "careful" 1))))
(is (= "" (with-out-str (handler-bind [Warning (fn [_] (muffle-warning))] (warn "careful")))))
(let [seen (atom nil)]
  (is (= "" (with-out-str (handler-bind [Warning (fn [w] (reset! seen (condition-message w)) (muffle-warning w))]
                            (is (nil? (warn "hush")))))))
  (is (= "hush" @seen)))
(is (= "WARNING: declined\n" (with-out-str (handler-bind [Warning (fn [_] nil)] (warn "declined")))))
(is (thrown? Error (muffle-warning)) "no warning is being signalled")
;; Without *debugger* bound, an unhandled error ends the fiber.
(is (= {:error "plain"} (settle (spawn-detached (error "plain")))))

;;; Runs started from Rust (a print-object method, a tag's reader): a
;;; primitive's error is signalled to the handlers inside the run (it went
;;; past them: only the handlers outside saw it), and a throw to a catch
;;; outside the run reaches it (it was "No catch for tag").
(defclass Nested () ((how)))
(def nested-log (atom []))
(defmethod print-object ((n Nested))
  (case (:how n)
    :catch (try (nth [] 5) (catch IndexError e (str "caught " (:index e))))
    :other (try (nth [] 5) (catch ArithmeticError e "wrong"))
    :value (handler-bind [Error (fn [_] (invoke-restart 'use-value "used"))] (nth [] 5))
    :seen (handler-bind [Error (fn [_] (swap! nested-log conj :inside))] (nth [] 5))
    :finally (try (try (nth [] 5) (finally (swap! nested-log conj :cleanup))) (catch ArithmeticError e "wrong"))
    :error (error "boom")
    :throw (throw-tag :out "thrown")
    :plain (nth [] 5)))
(is (= "caught 5" (pr-str (Nested :how :catch))) "a catch inside the run")
(is (= "[caught 5 caught 5]" (pr-str [(Nested :how :catch) (Nested :how :catch)])))
(is (= "used" (pr-str (Nested :how :value))) "use-value, from a handler inside")
(is (= [5 "Index out of bounds: 5"]
       (try (pr-str (Nested :how :other)) (catch IndexError e [(:index e) (condition-message e)])))
    "a catch inside for another class: the one outside, with the error's class and slots")
(is (= :outside (try (pr-str (Nested :how :plain)) (catch IndexError e :outside))) "no handler inside")
(reset! nested-log [])
(is (= :outside (handler-bind [Error (fn [_] (swap! nested-log conj :outside))]
                  (try (pr-str (Nested :how :seen)) (catch Error e :outside)))))
(is (= [:inside] @nested-log) "each handler is offered it once (the catch is inside the outer handler-bind)")
(reset! nested-log [])
(is (= :outside (try (pr-str (Nested :how :finally)) (catch Error e :outside))))
(is (= [:cleanup] @nested-log) "the run's cleanups run as it fails")
(is (= "boom" (try (pr-str (Nested :how :error)) (catch Error e (condition-message e))))
    "error inside, its catch outside the run")
(is (= "thrown" (catch-tag :out (pr-str (Nested :how :throw)))) "a throw-tag out of the run")
(is (= "thrown" (catch-tag :out (pr-str [1 [(Nested :how :throw)]]))))
(is (= "No catch for tag :out" (try (pr-str (Nested :how :throw)) (catch Error e (condition-message e))))
    "with no catch anywhere it's the error it always was")
(is (= {:error "boom"} (settle (spawn-detached (pr-str (Nested :how :error))))) "unhandled: the fiber ends with it")
(is (= {:error "Index out of bounds: 5"} (settle (spawn-detached (pr-str (Nested :how :plain))))))
;; A tag's reader is such a run too. (What leaves it uncaught is a read
;; error with its message: the reader's to raise.)
(is (= [:caught "Index out of bounds: 7"]
       (binding [*tag-readers* (assoc *tag-readers*
                                      'nested/catch (fn [x] (try (nth [] x) (catch IndexError e :caught)))
                                      'nested/plain (fn [x] (nth [] x)))]
         [(read-string "#nested/catch 5")
          (try (read-string "#nested/plain 7") (catch Error e (re-find #"Index out of bounds: \d" (condition-message e))))])))
;; After all that the handlers and catches of this fiber still work.
(is (= :caught (try (/ 1 0) (catch RuntimeError e :caught))))
