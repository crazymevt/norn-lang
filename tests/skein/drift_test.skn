;;;; Source drift: definitions evaluated at the REPL or from an editor that
;;;; their file doesn't hold (unsaved-definitions). An editor's evaluation is
;;;; made here as the :eval op makes it: read from a reader named for the
;;;; file, with *evaluated-from* naming it too.

(ns drift-test
  (:require [skein.io :as io]
            [skein.sys :as sys]
            [skein.test :refer [deftest is testing]]))

(def dir (io/path (sys/temp-dir) (str "skein-drift-test-" (sys/pid) "-" (nano-time))))
(io/mkdirs! dir)
(def file (io/path dir "shapes.skn"))
(io/write-text file "(ns drift-shapes)\n\n(defn area [w h]\n  (* w h))\n\n(defn ^:private helper [x] x)\n")
(load-file file)

(defn- evaluate!
  "Evaluate code as an editor does, as if at line of file f."
  [f line code]
  (binding [*evaluated-from* f]
    (let [cur (current-ns)]
      (try (%eval-reader (%reader (str (apply str (repeat (dec line) "\n")) "(in-ns 'drift-shapes) " code) f))
           (finally (in-ns (symbol (str cur))))))))

(defn- mine [] (filterv (fn [e] (= "drift-shapes" (:ns e))) (unsaved-definitions)))

(deftest drift
  (is (= [] (mine)) "loaded from its file: nothing")
  (evaluate! file 3 "(defn area [w h]\n  (* w h 1))")
  (evaluate! file 9 "(defn volume [w h d] (* (area w h) d))")
  (evaluate! file 6 "(defn ^:private helper\n  [x]\n  x)")
  (is (= [{:name 'area :ns "drift-shapes" :file file :line 3 :from :editor :reason :changed}
          {:name 'volume :ns "drift-shapes" :file file :line 9 :from :editor :reason :not-in-file}]
         (mine))
      "helper reads the same as the file's, laid out differently")
  (testing "saved: what the file holds now counts"
    (io/write-text file "(ns drift-shapes)\n\n(defn area [w h] (* w h 1))\n\n(defn ^:private helper [x] x)\n")
    (is (= ['volume] (mapv :name (mine)))))
  (testing "a file gone"
    (io/write-text file "")
    (io/delete! file)
    (is (= #{:file-missing} (set (map :reason (mine))))))
  (testing "loaded from the file again: noted no more"
    (io/write-text file (str "(ns drift-shapes)\n\n(defn area [w h] (* w h 1))\n\n(defn ^:private helper [x] x)\n"
                             "\n(defn volume [w h d] (* (area w h) d))\n"))
    (load-file file)
    (is (= [] (mine)))))
