;;;; skein.xml: XML 1.0 text, namespace scope and errors.

(ns xml-test
  (:require [skein.test :refer [deftest is]] [skein.xml :as xml] [skein.bytes :as bytes]
            [skein.io :as io] [skein.sys :as sys] [skein.string :as str]))

(def ^:private xml-uri "http://www.w3.org/XML/1998/namespace")

(defn- parse-error [f] (try (f) nil (catch ParseError e e)))

(deftest expanded-names-and-scope
  (let [root (xml/read-string
              (str "<p:root plain='1' p:a='2' q:b='3' xml:lang='en' xmlns='urn:d' xmlns:p='urn:a' xmlns:q='urn:a'>"
                   "<p:x xmlns:p='urn:b'><x xmlns=''><p:y/></x><x/></p:x><q:x/><x/>"
                   "</p:root>"))
        [shadow alias sibling] (:content root)
        [cleared restored-default] (:content shadow)
        still-shadowed (first (:content cleared))]
    (is (= ["urn:a" "root"] (:tag root)))
    (is (= {[nil "plain"] "1" ["urn:a" "a"] "2" ["urn:a" "b"] "3" [xml-uri "lang"] "en"} (:attrs root)))
    (is (= {nil "urn:d" "p" "urn:a" "q" "urn:a" "xml" xml-uri} (:namespaces root)))
    (is (= ["urn:b" "x"] (:tag shadow)))
    (is (= [nil "x"] (:tag cleared)))
    (is (not (contains? (:namespaces cleared) nil)))
    (is (= ["urn:b" "y"] (:tag still-shadowed)))
    (is (= ["urn:d" "x"] (:tag restored-default)))
    (is (= ["urn:a" "x"] (:tag alias)))
    (is (= ["urn:d" "x"] (:tag sibling)))
    (is (= (:namespaces root) (:namespaces sibling))))
  (let [root (xml/read-string "<x xmlns='urn:ns' xmlns:p='urn:ns' xmlns:q='urn:Ns' a='local' p:a='p' q:a='q'/>")]
    (is (= {[nil "a"] "local" ["urn:ns" "a"] "p" ["urn:Ns" "a"] "q"} (:attrs root))))
  (let [root (xml/read-string (str "<xml:node xmlns:xml='" xml-uri "' xml:id='a'/>"))]
    (is (= [xml-uri "node"] (:tag root)))
    (is (= {[xml-uri "id"] "a"} (:attrs root))))
  (let [root (xml/read-string "<p:é𝒙 p:β́='1' xmlns:p='urn:a&amp;b'/>")]
    (is (= ["urn:a&b" "é𝒙"] (:tag root)))
    (is (= {["urn:a&b" "β́"] "1"} (:attrs root)))))

(deftest mixed-content-and-normalization
  (let [root (xml/read-string
              (str (char 0xFEFF) "<?xml\nversion = '1.0' encoding=\"UTF-16\" standalone='yes'?>\r\n"
                   "<?xml-stylesheet href='x.css'?> <!-- before -->"
                   "<r a='x\t\r\ny\rz&#9;&#xD;&#10;&quot;&apos;&lt;&gt;&amp;'>"
                   " \r\nHi&amp;<![CDATA[<raw>&amp;\r]]><!-- ignore --><?pi?>&#x1F642;<empty/><full></full>tail&#13;&amp;lt;]]&gt;"
                   "</r><!--after--><?pi trailing?>"))
        [text empty full tail] (:content root)]
    (is (= {[nil "a"] "x  y z\t\r\n\"'<>&"} (:attrs root)))
    (is (= " \nHi&<raw>&amp;\n🙂" text))
    (is (= [nil "empty"] (:tag empty)))
    (is (= [nil "full"] (:tag full)))
    (is (= [] (:content empty) (:content full)))
    (is (= "tail\r&lt;]]>" tail)))
  (is (= [] (:content (xml/read-string "<r><![CDATA[]]><!-- --><?pi?></r>"))))
  (is (= [nil "r"] (:tag (xml/read-string "<?xml version='1.1'?><r/>")))))

(deftest invalid-documents
  (doseq [[s reason] [["" "expected"]
                      ["<!-- only -->" "expected"]
                      ["text<r/>" "expected"]
                      ["<r/><s/>" "after the root"]
                      ["<r/>&#32;" "after the root"]
                      [" <r/>\u00a0" "after the root"]
                      ["<r>" "unclosed element"]
                      ["<r></s>" "does not match"]
                      ["<p:r xmlns:p='urn:a' xmlns:q='urn:a'></q:r>" "does not match"]
                      ["<r></ r>" "expected an XML name"]
                      ["<r a='1'b='2'/>" "whitespace"]
                      ["<r a='<'/>" "forbidden in an attribute"]
                      ["<r a='" "unclosed attribute"]
                      ["<r a='1' a='2'/>" "duplicate attribute"]
                      ["<r p:a='1' q:a='2' xmlns:p='urn:a' xmlns:q='urn:a'/>" "duplicate expanded"]
                      ["<r xmlns='urn:a' xmlns='urn:b'/>" "duplicate attribute"]
                      ["<r><p:x/></r>" "undeclared namespace prefix"]
                      ["<r p:a='1'/>" "undeclared namespace prefix"]
                      ["<r><a xmlns:p='urn:a'/><p:b/></r>" "undeclared namespace prefix"]
                      ["<:r/>" "expected an XML name"]
                      ["<p:/>" "expected an XML name"]
                      ["<p:0/>" "expected an XML name"]
                      ["<p:a:b/>" "whitespace"]
                      ["<xmlns:r/>" "reserved"]
                      ["<r xmlns:xmlns='urn:a'/>" "reserved"]
                      ["<r xmlns:xml='urn:a'/>" "only the xml prefix"]
                      [(str "<r xmlns='" xml-uri "'/>") "only the xml prefix"]
                      [(str "<r xmlns:p='" xml-uri "'/>") "only the xml prefix"]
                      ["<r xmlns:p='http://www.w3.org/2000/xmlns/'/>" "reserved"]
                      ["<r xmlns:p='urn:a'><x xmlns:p=''/></r>" "nonempty URI"]
                      ["<!DOCTYPE r SYSTEM 'file:///example.dtd'><r/>" "DOCTYPE"]
                      ["<!DOCTYPE r [<!ENTITY greet 'Hi'>]><r>&greet;</r>" "DOCTYPE"]
                      ["<r>&unknown;</r>" "undeclared entity"]
                      ["<r>&amp</r>" "expected"]
                      ["<r>&#x;</r>" "invalid character reference"]
                      ["<r>&#X41;</r>" "invalid character reference"]
                      ["<r>&#١;</r>" "invalid character reference"]
                      ["<r>&#x110000;</r>" "out of range"]
                      ["<r>&#xD800;</r>" "forbidden in XML"]
                      ["<r>&#xFFFE;</r>" "forbidden in XML"]
                      ["<r>&#0;</r>" "forbidden in XML"]
                      [(str "<r><!--" (char 1) "--></r>") "forbidden in XML"]
                      ["<r>]]></r>" "ordinary character data"]
                      ["<r><![CDATA[never closes</r>" "unclosed CDATA"]
                      ["<r><!--broken--comment--></r>" "forbidden in a comment"]
                      ["<r><!--broken---></r>" "forbidden in a comment"]
                      ["<r><?pi:target?></r>" "whitespace"]
                      ["<r><?pi data</r>" "unclosed processing instruction"]
                      ["<?XML version='1.0'?><r/>" "XML declaration"]
                      [" <?xml version='1.0'?><r/>" "XML declaration"]
                      ["<?xml version='2.0'?><r/>" "1.x XML version"]
                      ["<?xml version='1.1'?><r>&#1;</r>" "forbidden in XML"]
                      ["<?xml version='1.0'encoding='UTF-8'?><r/>" "expected"]
                      ["<?xml version='1.0' encoding='8bit'?><r/>" "encoding name"]
                      ["<?xml version='1.0' standalone='maybe'?><r/>" "standalone"]]]
    (let [err (parse-error (fn [] (xml/read-string s)))]
      (is (and err (str/includes? (condition-message err) reason)) (pr-str s))))
  (let [err (parse-error (fn [] (xml/read-string "<r>\r\né]]></r>")))]
    (is (= ["XML" 2 2] [(:source err) (:line err) (:column err)]))))

(deftest large-text-and-deep-nesting
  (let [s (str/repeat-str 70000 "é")]
    (is (= [s] (:content (xml/read-string (str "<x>" s "</x>"))))))
  (let [depth 1200
        root (xml/read-string (str (str/repeat-str depth "<x>") "<leaf/>" (str/repeat-str depth "</x>")))
        leaf (reduce (fn [el _] (first (:content el))) root (range depth))]
    (is (= [nil "leaf"] (:tag leaf)))))

(deftest file-encodings
  (let [path (io/path (sys/temp-dir) (str "skein-xml-test-" (sys/pid) "-" (nano-time) ".xml"))]
    (try
      (io/write-text path (str (char 0xFEFF) "<?xml version='1.0' encoding='utf-8'?><é/>"))
      (is (= [nil "é"] (:tag (xml/read-file path))))
      ;; The same XML declaration and <é>🙂</é> in both UTF-16 byte orders.
      (doseq [hex [(str "fffe3c003f0078006d006c002000760065007200730069006f006e003d00220031002e0030002200"
                        "200065006e0063006f00640069006e0067003d0022005500540046002d003100360022003f003e00"
                        "3c00e9003e003dd842de3c002f00e9003e00")
                   (str "feff003c003f0078006d006c002000760065007200730069006f006e003d00220031002e00300022"
                        "00200065006e0063006f00640069006e0067003d0022005500540046002d003100360022003f003e"
                        "003c00e9003ed83dde42003c002f00e9003e")]]
        (io/write-bytes path (bytes/unhex hex))
        (let [root (xml/read-file path)]
          (is (= [nil "é"] (:tag root)))
          (is (= ["🙂"] (:content root)))))
      (io/write-text path "<?xml version='1.0' encoding='ISO-8859-1'?><r/>")
      (let [err (parse-error (fn [] (xml/read-file path)))]
        (is (= path (:source err)))
        (is (and err (str/includes? (condition-message err) "differs from file encoding UTF-8"))))
      (doseq [[hex why] [["fffe3c" "incomplete UTF-16 code unit"]
                         ["feffd800003e" "unpaired UTF-16 surrogate"]
                         ["fffe00dc" "unpaired UTF-16 surrogate"]
                         ["ff" "not valid UTF-8"]]]
        (io/write-bytes path (bytes/unhex hex))
        (let [err (parse-error (fn [] (xml/read-file path)))]
          (is (= path (:source err)))
          (is (and err (str/includes? (condition-message err) why)))))
      (finally (io/delete! path)))))
