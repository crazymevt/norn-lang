;;;; The bytecode verifier (M8 part 8.11): code assembled with %make-proto
;;;; and %make-template, as the compiler assembles it, is checked when the
;;;; template is made. Each fault here is one a crafted image or a bad
;;;; compiler could make; the interpreter would trust it.

(ns verify-test
  (:require [skein.test :refer [is deftest testing]] [skein.string :as str]))

;; Instructions (crates/skein-vm/src/bytecode.rs).
(defn- abc [op a b c] (+ op (* a 256) (* b 65536) (* c 16777216)))
(defn- abx [op a bx] (+ op (* a 256) (* bx 65536)))
(defn- asbx [op a sbx] (abx op a (+ sbx 32768)))
(def MOVE 0) (def LOADK 1) (def LOADNIL 3) (def GETVAR 6) (def GETUP 8)
(def CLOSURE 10) (def SETUP 11) (def JMP 12) (def CALL 15) (def RETURN 17)

(defn- proto
  ([code] (proto code {}))
  ([code {:keys [nfixed variadic nregs consts] :or {nfixed 0 nregs 2 consts []}}]
   (%make-proto 'f nfixed (boolean variadic) nregs consts code [])))

(defn- template [protos & [caps]] (%make-template 'f protos (or caps [])))

(defn- fault
  "Why making a template of one proto (code, options) fails, or nil."
  [code & [opts caps]]
  (try (template [(proto code (or opts {}))] caps) nil
       (catch Error e (condition-message e))))

(deftest good-code-runs
  (let [identity-fn (%make-closure (template [(proto [(abc RETURN 0 0 0)] {:nfixed 1 :nregs 1})]))]
    (is (= 42 (identity-fn 42)))))

(deftest faults-are-refused-when-the-template-is-made
  (testing "operands out of range"
    (is (= "%make-template: bad code: in f: at 0 (MOVE): register 5 of 2"
           (fault [(abc MOVE 0 5 0) (abc RETURN 0 0 0)])))
    (is (= "%make-template: bad code: in f: at 0 (LOADK): constant 3 of 0"
           (fault [(abx LOADK 0 3) (abc RETURN 0 0 0)])))
    (is (= "%make-template: bad code: in f: at 0 (GETUP): upvalue 2 of 0"
           (fault [(abc GETUP 0 2 0) (abc RETURN 0 0 0)])))
    (is (= "%make-template: bad code: in f: at 0 (CALL): a call of r0 with 3 arguments in 2 registers"
           (fault [(abc CALL 0 3 0) (abc RETURN 0 0 0)]))))
  (testing "a constant of the wrong kind"
    (is (= "%make-template: bad code: in f: at 0 (GETVAR): constant 0 isn't a Var"
           (fault [(abx GETVAR 0 0) (abc RETURN 0 0 0)] {:consts [42]}))))
  (testing "control"
    (is (= "%make-template: bad code: in f: at 0 (JMP): a jump to 101, outside 0..2"
           (fault [(asbx JMP 0 100) (abc RETURN 0 0 0)])))
    (is (= "%make-template: bad code: in f: at 0 (LOADNIL): the code ends without returning"
           (fault [(abc LOADNIL 0 0 0)])))
    (is (= "%make-template: bad code: in f: at 0 (?): unknown opcode 99"
           (fault [(abc 99 0 0 0) (abc RETURN 0 0 0)]))))
  (testing "parameters that don't fit the registers"
    (is (= "%make-template: bad code: in f: 2 parameters and a rest in 2 registers"
           (fault [(abc RETURN 0 0 0)] {:nfixed 2 :variadic true :nregs 2}))))
  (testing "a closure capturing what its creator hasn't got"
    (let [inner (template [(proto [(abc GETUP 0 0 0) (abc RETURN 0 0 0)] {:nregs 1})] [(* 9 4)])] ; register 9
      (is (= "%make-template: bad code: in f: at 0 (CLOSURE): register 9 of 2"
             (fault [(abx CLOSURE 0 0) (abc RETURN 0 0 0)] {:consts [inner]})))))
  (testing "a template whose captures don't match its upvalues is caught too"
    (is (str/includes? (or (fault [(abc RETURN 0 0 0)] {} [:not-a-capture]) "") "a capture isn't one"))))

(deftest setup-is-checked-when-it-runs
  ;; (its closure is only known then)
  (let [f (%make-closure (template [(proto [(abc LOADNIL 0 0 0) (abc SETUP 0 0 0) (abc RETURN 0 0 0)])]))]
    (is (= "SETUP of upvalue 0 of nil" (try (f) nil (catch Error e (condition-message e)))))))

(deftest the-compilers-own-code-passes
  ;; (every function compiled here went through %make-template, so the
  ;; suites passing is the real test; this is one with every kind of
  ;; instruction: closures over locals and upvalues, a loop, letrec)
  (let [f (fn [n]
            (letrec* [ev? (fn* [k] (if (zero? k) true (od? (dec k))))
                      od? (fn* [k] (if (zero? k) false (ev? (dec k))))]
              (loop [i 0 acc []]
                (if (< i n) (recur (inc i) (conj acc (ev? i))) (mapv (fn [x] (and x n)) acc)))))]
    (is (= [3 false 3] (f 3)))))
