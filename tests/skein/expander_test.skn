;;;; skein.expander: hygiene (M8 part 8.2). Hygienic macros here build their
;;;; output from quote-syntax pieces; pattern templates come with 8.3.

(ns expander-test
  (:require [skein.test :refer [is deftest testing]] [skein.syntax :as syn :refer [defsyntax]]
            [skein.expand] [skein.string :as str]))

;; Another namespace, with a macro whose template calls a private helper of
;; its own.
(ns expander-test.lib
  (:require [skein.syntax :as syn :refer [defsyntax]]))

(defn- secret [] :secret)

(defsyntax use-secret
  (fn [_] (syn/datum->syntax (quote-syntax here) (list (quote-syntax secret)))))

(in-ns 'expander-test)

;; (the transformers below call it while expanding: compile-time code)
(begin-for-syntax
 (defn template
   "Data with syntax parts, as syntax with this namespace's context."
   [d]
   (syn/datum->syntax (quote-syntax here) d)))

;; (my-or a b): a's value if it's true, else b's — with a temporary `t`
;; that the user's own `t` mustn't see.
(defsyntax my-or
  (fn [s]
    (let [[_ a b] (syn/syntax->list s)]
      (template (list (quote-syntax let*) (vector (quote-syntax t) a)
                      (list (quote-syntax if) (quote-syntax t) (quote-syntax t) b))))))

(defn helper [] :helper)

(defsyntax call-helper
  (fn [_] (template (list (quote-syntax helper)))))

(defsyntax with-t
  (fn [s]
    (let [[_ body] (syn/syntax->list s)]
      (template (list (quote-syntax let*) (vector (quote-syntax t) 1) body)))))

(defsyntax names-list?
  (fn [s]
    (let [[_ x] (syn/syntax->list s)]
      (if (syn/free-identifier=? x (quote-syntax list)) (quote-syntax :yes) (quote-syntax :no)))))

(defmacro aif [test then else] `(let [~'it ~test] (if ~'it ~then ~else)))

(deftest hygiene
  (testing "a macro's binding doesn't capture the user's name"
    (is (= 5 (let [t 5] (my-or false t))))
    (is (= 1 (my-or 1 (error "not evaluated"))))
    (is (= 7 (let [t 7] (with-t t)))))
  (testing "the user's binding doesn't capture a macro's free name"
    (is (= [:user :helper] (let [helper (fn [] :user)] [(helper) (call-helper)]))))
  (testing "a macro's names mean what they meant where it was defined"
    (is (= :secret (expander-test.lib/use-secret)))
    (is (= [:mine :secret] (let [secret (fn [] :mine)] [(secret) (expander-test.lib/use-secret)]))))
  (testing "hygienic macros inside each other"
    (is (= 3 (let [t 3] (my-or (my-or false false) t))))
    (is (= 9 (let [t 9] (with-t (my-or false t))))))
  (testing "a macro's own binding isn't visible to the user's code"
    (is (thrown? Error (eval '(expander-test/with-t t)))))
  (testing "free-identifier=?: the same binding, not just the same name"
    (is (= :yes (names-list? list)))
    (is (= :no (let [list 1] (names-list? list)))))
  (testing "defmacro is as it was: it may capture on purpose"
    (is (= 3 (aif 3 it 0)))
    (is (= 0 (aif nil it 0)))))

(deftest kernel-forms
  (testing "let* rebinds a name in order, as Clojure's does"
    (is (= 2 (let* [x 1 x (inc x)] x))))
  (testing "a local named like a global shadows it"
    (is (= 3 (let [inc (fn [x] (+ x 2))] (inc 1)))))
  (testing "fn* with a name, and several arities"
    (is (= 120 ((fn* fact ([n] (fact n 1)) ([n acc] (if (zero? n) acc (fact (dec n) (* acc n))))) 5))))
  (testing "letrec*"
    (is (= true (letrec* [ev? (fn* [n] (if (zero? n) true (od? (dec n))))
                          od? (fn* [n] (if (zero? n) false (ev? (dec n))))]
                  (ev? 10)))))
  (testing "quote-syntax gives syntax"
    (is (syn/syntax? (quote-syntax (a b))))
    (is (= '(a b) (syn/syntax->datum (quote-syntax (a b))))))
  (testing "a top-level do: a macro defined in it applies after it"
    (is (= 42 (eval '(do (defmacro forty-two [] 42) (forty-two)))))))

(deftest errors-say-where
  (let [[s] (syn/read-all-syntax "(let* [1 2] 3)" "e.skn")
        msg (try (skein.expander/eval s) nil (catch Error e (condition-message e)))]
    (is (= "e.skn:1:8: Bad binding form in let*: 1" msg))))

(deftest locals-print-as-written
  ;; (each local is an uninterned symbol, so a macro's `t` and the user's
  ;; stay apart, but it shows as the name the user wrote)
  (let [form (skein.expander/expand-all (syn/datum->syntax nil '(fn* [x] x)))
        x (first (second form))]
    (is (= "(fn* [x] x)" (pr-str form)))
    (is (not= 'x x))
    (is (identical? x (nth form 2)))))

(deftest the-bootstrap-is-what-the-expander-makes
  ;; core, the compiler, skein.syntax and the expander are compiled at boot
  ;; before the expander is installed: through it, every form gives the same
  ;; code, so the base image holds exactly what the expander makes (M8 part
  ;; 8.7)
  (is (= [] (skein.expander/compare-expanded (%core-source) "core.skn" 'skein.core)))
  (is (= [] (skein.expander/compare-expanded (%compiler-source) "compiler.skn" 'user)))
  (is (= [] (skein.expander/compare-expanded (first (%find-lib "skein.syntax")) "syntax.skn" 'user)))
  (is (= [] (skein.expander/compare-expanded (%expander-source) "expander.skn" 'user)))
  (testing "and the comparison does notice a difference"
    (is (= 1 (count (skein.expander/compare-expanded "(defn h [] (quote-syntax x))" "d" 'user))))))

(deftest the-macro-stepper
  ;; (M8 part 8.9)
  (let [r (skein.expand/macro-steps '(let [t 5] (expander-test/my-or false t)))
        steps (:steps r)]
    (testing "each macro step, outermost first"
      (is (= '[skein.core/let expander-test/my-or] (mapv :macro steps)))
      (is (= '(expander-test/my-or false t) (:before (second steps))))
      (is (= '(let* [t false] (if t t t)) (:after (second steps)))))
    (testing "what a hygienic step introduced: its scope marks them"
      (is (= [false true] (mapv :hygienic steps)))
      (is (= '[let* t if] (:introduced (second steps))))
      (is (integer? (:scope (second steps)))))
    (testing "a defmacro's: the names its arguments didn't hold"
      (is (= '[let*] (:introduced (first steps)))))
    (testing "the full expansion, its same-named locals numbered apart"
      (is (= '(let* [t#1 5] (let* [t#2 false] (if t#2 t#2 t#1))) (:expanded r)))
      (is (= '[{:local t :as [t#1 t#2]}] (:renames r))))
    (testing "as text"
      (let [text (skein.expand/steps-text r)]
        (is (str/includes? text "2. expander-test/my-or (hygienic)") text)
        (is (str/includes? text "t#1, t#2: different locals, each written t") text))))
  (testing "a form with no macros"
    (is (= [] (:steps (skein.expand/macro-steps '(if 1 2 3))))))
  (testing "a syntax template shows as the quote-syntax it was"
    (is (= '(fn* [] (quote-syntax x)) (:expanded (skein.expand/macro-steps '(fn* [] (quote-syntax x))))))))

;; A hygienic template that hands a defmacro macro (let, when-let) the
;; names it was given: they keep their scopes, in a function as at top level.
(defsyntax bind-it (syn/syntax-rules () [(_ n v body) (let [n v] body)]))
(defsyntax bind-it-when (syn/syntax-rules () [(_ n v body) (when-let [n v] body)]))
(defsyntax bind-first (syn/syntax-rules () [(_ n v body) (let [[n] [v]] body)]))

(defn- bound-in-a-function [] [(bind-it x 5 x) (bind-it x 5 (+ x 1)) (bind-it-when y 7 y) (bind-first z 9 z)])

(deftest a-template-binding-a-given-name
  (is (= [5 6 7 9] (bound-in-a-function)))
  (is (= 5 (bind-it x 5 x)) "at top level")
  (is (= 3 (let [x 1] (bind-it y 2 (+ x y)))) "the body still sees the function's own locals"))

(deftest macroexpand-of-a-hygienic-macro
  (is (= '(let [x 5] x) (macroexpand-1 '(expander-test/bind-it x 5 x))))
  (is (= '(let* [x 5] x) (macroexpand '(expander-test/bind-it x 5 x))))
  (is (= '(let* [x 5] x) (macroexpand '(let [x 5] x))) "a defmacro's, as before")
  (is (= '(f 1) (macroexpand-1 '(f 1))) "not a macro call: unchanged"))

(deftest stacked-metadata-and-private-defs
  ;; (^:dynamic ^:private kept only the first part; core, the compiler,
  ;; skein.syntax and the expander are read as plain data, so their
  ;; ^:private defs are marked when the expander installs)
  (is (= {:dynamic true :private true}
         (skein.syntax/syntax-props (second (skein.syntax/syntax-e (first (skein.syntax/read-all-syntax "(def ^:dynamic ^:private *x* 1)" "t")))))))
  (load-string "(def ^:dynamic ^:private *stacked-private* 1)")
  (is (private? (resolve '*stacked-private*)))
  (is (not-any? (fn [[ns s]] (contains? (ns-publics ns) s))
                '[[skein.syntax scope-ids] [skein.expander fn-macro] [skein.core %core-indexed]])))
