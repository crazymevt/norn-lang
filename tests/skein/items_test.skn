;;;; Per-item primitives at tier 1 (M10): count and nth of an all-ASCII
;;;; string, = of immediates and keywords, seq and next of lists, deref of
;;;; an atom, natively; anything else as the primitive does. And swap!'s
;;;; arities without apply. Run at both tiers and at
;;;; SKEIN_JIT_THRESHOLD=1 (with SKEIN_JIT_SYNC=1, compiled from the first
;;;; call), against fixed answers.

(ns items-test
  (:require [skein.test :refer [is deftest testing]]))

(defn- nth-of [s i] (nth s i))
(defn- count-of [s] (count s))
(defn- eq [a b] (= a b))
(defn- seq-of [x] (seq x))
(defn- next-of [x] (next x))
(defn- deref-of [x] (deref x))
(defn- failed? [f] (try (f) false (catch Error _ true)))

(deftest strings
  (is (= [3 \a \c] [(count-of "abc") (nth-of "abc" 0) (nth-of "abc" 2)]))
  (is (= [0 2 \é \x] [(count-of "") (count-of "éx") (nth-of "éx" 0) (nth-of "éx" 1)]) "not all ASCII")
  (is (failed? #(nth-of "abc" 3)) "past the end")
  (is (failed? #(nth-of "abc" -1)) "a negative index")
  (is (failed? #(nth-of "abc" 1.0)) "not an integer")
  (is (= [3 2 \b] [(count-of [1 2 3]) (count-of {:a 1 :b 2}) (nth-of [\a \b] 1)]) "other collections"))

(deftest equality
  (is (= [true false true false] [(eq \a \a) (eq \a \b) (eq nil nil) (eq nil false)]))
  (is (= [true false true false] [(eq :a :a) (eq :a :b) (eq true true) (eq true false)]))
  (is (= [false false false] [(eq :a "a") (eq 1 \a) (eq \a 1)]) "different kinds")
  (is (= [true true false] [(eq "ab" (str "a" "b")) (eq [1 2] [1 2]) (eq 1 1.0)]) "by value")
  (is (eq ##NaN ##NaN) "NaN equals NaN under =")
  (let [x ##NaN] (is (eq x x)))
  (is (= [true false] [(eq 2.5 2.5) (eq 2.5 3.5)])))

(deftest lists
  (is (= [nil nil] [(seq-of nil) (next-of nil)]))
  (let [l (list 1 2 3)]
    (is (identical? l (seq-of l)))
    (is (= [[2 3] [3] nil] [(vec (next-of l)) (vec (next-of (next-of l))) (next-of (next-of (next-of l)))])))
  (is (= [nil nil] [(seq-of '()) (next-of '(1))]) "the empty list")
  (is (= [1 2] (seq-of [1 2])) "a vector")
  (is (= [2 3] (next-of (cons 1 (lazy-seq (list 2 3))))) "a lazy tail")
  (is (= [2] (next-of (range 1 3)))))

(deftest dereferencing
  (is (= [5 6 7] [(deref-of (atom 5)) (deref-of (volatile! 6)) (deref-of (delay 7))]))
  (is (= 8 (deref-of (doto (promise) (deliver 8))))))

(deftest swapping
  (let [a (atom 0)]
    (is (= [1 3 6 10 15] [(swap! a inc) (swap! a + 2) (swap! a + 1 2) (swap! a + 1 2 1) (swap! a + 1 1 1 1 1)])))
  (let [v (volatile! [])]
    (is (= [[1] [1 2] [1 2 3 4] [1 2 3 4 5 6 7]]
           [(vswap! v conj 1) (vswap! v conj 2) (vswap! v conj 3 4) (vswap! v conj 5 6 7)])))
  (testing "watches see each change"
    (let [a (atom 0) seen (atom [])]
      (add-watch a :w (fn [_ _ old new] (swap! seen conj [old new])))
      (swap! a inc)
      (swap! a + 10)
      (is (= [[0 1] [1 11]] @seen))))
  (testing "contended: no change lost"
    (let [a (atom 0)]
      (with-scope [s] (dotimes [_ 8] (spawn s (dotimes [_ 500] (swap! a inc)))))
      (is (= 4000 @a)))))

;; map, filter, keep, remove and for loop directly (M10): each kind of
;; collection, against fixed answers.
(deftest sequence-functions
  (testing "map keeps the kind"
    (is (= [[2 3] '(2 3) #{2 3} [2 3] [97 98] [] [2 3 4]]
           [(map inc [1 2]) (map inc '(1 2)) (map inc #{1 2}) (map inc (range 1 3)) (map int "ab") (map inc [])
            (map inc (cons 1 (lazy-seq [2 3])))]))
    (is (list? (map inc '(1 2))))
    (is (= [[:a 1]] (map identity {:a 1})) "a map's entries, as a vector"))
  (testing "filter, remove and keep"
    (is (= [[2 4] '(2) #{2} {:b 2} [1 3]]
           [(filter even? [1 2 3 4]) (filter even? '(1 2 3)) (filter even? #{1 2 3}) (filter (fn [[_ v]] (even? v)) {:a 1 :b 2})
            (remove even? (range 1 5))]))
    (is (= [[1 nil false] [3]] [(remove true? [1 true nil false]) (keep (fn [x] (when (> x 2) x)) [1 2 3])]))
    (is (= [false 0] (keep identity [false nil 0])) "false is kept, nil isn't"))
  (testing "complement"
    (is (= [true false true false] [((complement even?) 3) ((complement even?) 2) ((complement =) 1 2) ((complement (constantly true)))])))
  (testing "for"
    (is (= [] (for [x []] x)))
    (is (= [[1 :a] [1 :b] [3 :a] [3 :b]] (for [x [1 2 3] :when (odd? x) y [:a :b]] [x y])))
    (is (= [0 1 2] (for [x (range) :while (< x 3)] x)) "an infinite range, stopped")
    (is (= [[1 3] [2 3]] (for [x [1 2] y [3 4] :while (< y 4)] [x y])) "the inner binding stopped")
    (is (= [[1 3] [1 4]] (for [x [1 2] :while (< x 2) y [3 4]] [x y])) "the outer one")
    (is (= [4 9] (for [x [1 2 3] :let [y (* x x)] :when (> y 1)] y)))
    (is (= [3 7] (for [[a b] [[1 2] [3 4]]] (+ a b))) "destructuring")
    (is (= [nil false] (for [x [nil false]] x)) "nil and false are values")
    (is (= [[0 0] [1 0] [1 1]] (for [x (range 2) y (range 2) :when (<= y x)] [x y])))))
