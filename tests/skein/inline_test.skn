;;;; Inlining (M10 part 4): a call of a small function defined with def
;;;; compiles to its body, behind a guard that the var still holds it. Run at
;;;; both tiers, these check that inlined code behaves as the call would:
;;;; values, redefinition, loops, tail calls, and what backtraces, the
;;;; debugger and xref show (profiles: prof_test).

(ns inline-test
  (:require [skein.test :refer [is deftest testing]] [skein.string :as str] [skein.xref :as x]
            [skein.process :as proc] [skein.sys :as sys]))

(defn- inlined?
  "Does function f's code inline a call (has a guard, opcode 18)?"
  [f]
  (some (fn [p] (some (fn [i] (= 18 (bit-and i 255))) (:code (%proto-parts p))))
        (:arities (%template-parts (%closure-template f)))))

(defn- error-output [src] (:err (proc/sh (:executable (sys/info)) "-e" src)))

(defn- redefine [src] (load-string (str "(in-ns 'inline-test) " src)))

(defn sq [x] (* x x))
(defn use-sq [y] (+ 1 (sq y)))
(defn tail-sq [y] (sq (inc y)))

(deftest calls-of-small-functions-are-inlined
  (is (inlined? use-sq))
  (is (= 26 (use-sq 5)))
  (is (inlined? tail-sq) "in tail position too")
  (is (= 36 (tail-sq 5)))
  (testing "not with the wrong number of arguments: that's the call's error"
    (is (= "ArityError" (handler-case (load-string "(inline-test/sq 1 2)") (Error [e] (name (class-name (class-of e))))))))
  (testing "not when the compiler is told not to"
    (is (not (inlined? (binding [skein.compiler/*inline* false] (eval '(fn [y] (inline-test/sq y)))))))))

(defn scale [x] (* 2 x))
(defn uses-scale [x] (scale x))

(deftest a-redefinition-takes-effect-in-inlined-callers
  (is (inlined? uses-scale))
  (is (= 10 (uses-scale 5)))
  (redefine "(defn scale [x] (* 3 x))")
  (is (= 15 (uses-scale 5)) "the guard fails: the call goes to the new scale")
  (redefine "(def scale (fn [x] (* 4 x)))")
  (is (= 20 (uses-scale 5))))

(defn sum-to [n] (loop [i 0 s 0] (if (> i n) s (recur (inc i) (+ s i)))))
(defn uses-sum [n] (+ 1000 (sum-to n)))
(defn pick [c a b] (if c (let [t (str a "!")] t) b))
(defn uses-pick [c] [(pick c "a" "b") (pick (not c) "x" "y")])
(defn inner [x] (+ x 1))
(defn middle [x] (* 2 (inner x)))
(defn outer [x] (- (middle x) 1))

(deftest bodies
  (is (inlined? uses-sum) "a loop in the body: its recur is its own")
  (is (= 1055 (uses-sum 10)))
  (is (= ["a!" "y"] (uses-pick true)))
  (is (= ["b" "x!"] (uses-pick false)))
  (is (= 11 (outer 5)) "inlined calls in inlined code"))

(defn boom [x] (when (> x 2) (error "boom")) x)
(defn calls-boom [y] (inc (boom y)))
(defn tail-error [] (error "deep"))
(defn calls-tail-error [] (inc (tail-error)))

(deftest backtraces-show-inlined-calls
  (is (inlined? calls-boom))
  (is (inlined? calls-tail-error))
  (testing "a frame for the inlined function, above its caller's"
    (let [err (error-output "(do (defn boom [x] (when (> x 2) (error \"boom\")) x) (defn calls-boom [y] (inc (boom y))) (calls-boom 5))")]
      (is (str/includes? err "boom\n  at user/boom\n  at user/calls-boom") err)))
  (testing "but not where it would have tail-called (its frame would be gone)"
    (let [err (error-output "(do (defn tail-error [] (error \"deep\")) (defn calls-tail-error [] (inc (tail-error))) (calls-tail-error))")]
      (is (str/includes? err "deep\n  at user/calls-tail-error") err))))

(defn parked [id] (first (filter (fn [d] (= id (:fiber d))) (debugging))))
(defn- wait-until [f] (loop [i 0] (or (f) (when (< i 10000) (sleep 2) (recur (inc i))))))
(defn halve [x] (when (odd? x) (error "odd:" x)) (quot x 2))
(defn halve-plus [y] (+ 100 (halve y)))

(deftest the-debugger-shows-inlined-frames
  (is (inlined? halve-plus))
  (let [f (binding [*debugger* :park] (spawn-detached (halve-plus 3)))
        id (fiber-id f)]
    (is (wait-until (fn [] (parked id))))
    (let [frames (backtrace id)
          i (some (fn [i] (when (= 'inline-test/halve (:fn (nth frames i))) i)) (range (count frames)))]
      (is (some? i) "halve has a frame of its own")
      (is (:inlined (nth frames i)))
      (is (= {'x 3} (:locals (nth frames i))) "with its locals")
      (is (= 6 (eval-in-frame id i '(* x 2))))
      (is (= 'inline-test/halve-plus (:fn (nth frames (inc i)))) "above its caller")
      (testing "restarted: the function's newest definition, and its caller goes on"
        (redefine "(defn halve [x] (quot x 2))")
        (debug-restart-frame id i)))
    (is (= 101 (await f)))))

(defn helper [x] (* x 3))
(defn uses-helper [x] (helper x))

(deftest xref-sees-the-source
  (is (inlined? uses-helper))
  (is (= [(var inline-test/helper)] (x/callees (var uses-helper))) "not helper's * (inlined into it)"))

;; A call of another module's function with a contract checks it at the
;; call site: the checking wrapper is plain code (skein.core/%wrapper-source),
;; inlined like any small function. (The modules are made here: lint reads
;; this file, not what it loads.)
(load-string "(ns inline-test.lib)
  (defn label ^String [^String s ^Integer n] (str s n))
  (defn maybe ^(? String) [^(? String) s] s)
  (defn either ^Boolean [^(U String Character) x] true)
  (defn arities (^String [^String s] s) (^String [^String s ^Integer n] (str s n)))
  (defn relabel ^String [^String s] s)")
(load-string "(ns inline-test.callers)
  (defn calls-label [s n] (inline-test.lib/label s n))
  (defn calls-maybe [s] (inline-test.lib/maybe s))
  (defn calls-either [x] (inline-test.lib/either x))
  (defn calls-arities [s] [(inline-test.lib/arities s) (inline-test.lib/arities s 2)])
  (defn calls-relabel [s] (inline-test.lib/relabel s))")

(defn- caller [n] (var-get (resolve (symbol "inline-test.callers" n))))
(defn- message [thunk] (handler-case (do (thunk) nil) (Error [e] (condition-message e))))

(deftest contract-checks-at-the-call-site
  (is (inlined? (caller "calls-label")))
  (is (= "a1" ((caller "calls-label") "a" 1)))
  (is (str/starts-with? (message (fn [] ((caller "calls-label") 5 1)))
                        "inline-test.lib/label: its 1st argument should be String, got 5, blaming inline-test.callers"))
  (is (str/starts-with? (message (fn [] ((caller "calls-label") "a" "b")))
                        "inline-test.lib/label: its 2nd argument should be Integer"))
  (testing "nil or a type, either of two"
    (is (= [nil "x"] [((caller "calls-maybe") nil) ((caller "calls-maybe") "x")]))
    (is (str/includes? (message (fn [] ((caller "calls-maybe") 5))) "should be nil or String"))
    (is (= [true true] [((caller "calls-either") "s") ((caller "calls-either") \c)]))
    (is (str/includes? (message (fn [] ((caller "calls-either") 5))) "should be String or Character")))
  (testing "each arity its own"
    (is (inlined? (caller "calls-arities")))
    (is (= ["a" "a2"] ((caller "calls-arities") "a")))
    (is (str/includes? (message (fn [] ((caller "calls-arities") 5))) "its 1st argument should be String"))))

(load-string "(ns inline-test.lib2)
  (defclass Pt () ((x :initform 0)))
  (defn px ^Integer [^Pt p] (:x p))
  (defn opts ^String [^String s & {:keys [n] :or {n 1}}] (str s n))
  (defn pts ^(U Pt String) [^(? Pt) p] (or p \"none\"))")
(load-string "(ns inline-test.callers2)
  (defn calls-px [p] (inline-test.lib2/px p))
  (defn calls-opts [s] (inline-test.lib2/opts s))
  (defn calls-opts-n [s n] (inline-test.lib2/opts s :n n))
  (defn calls-opts-none [] (apply inline-test.lib2/opts []))
  (defn calls-pts [p] (inline-test.lib2/pts p))")

(defn- caller2 [n] (var-get (resolve (symbol "inline-test.callers2" n))))
(defn- pt [x] ((resolve 'inline-test.lib2/Pt) :x x))

(deftest class-and-keyword-contracts-at-the-call-site
  (testing "a class without a skein.core predicate: an instance? test"
    (is (inlined? (caller2 "calls-px")))
    (is (= 3 ((caller2 "calls-px") (pt 3))))
    (is (str/starts-with? (message (fn [] ((caller2 "calls-px") 5)))
                          "inline-test.lib2/px: its 1st argument should be Pt, got 5, blaming inline-test.callers2")))
  (testing "nil, a class, or a string"
    (is (= ["none" 4] [((caller2 "calls-pts") nil) (:x ((caller2 "calls-pts") (pt 4)))]))
    (is (str/includes? (message (fn [] ((caller2 "calls-pts") 5))) "should be nil or Pt")))
  (testing "keyword arguments: the fixed ones alone inlined, more passed on"
    (is (inlined? (caller2 "calls-opts")))
    (is (= ["a1" "a7"] [((caller2 "calls-opts") "a") ((caller2 "calls-opts-n") "a" 7)]))
    (is (str/starts-with? (message (fn [] ((caller2 "calls-opts") :a))) "inline-test.lib2/opts: its 1st argument should be String"))
    (is (str/starts-with? (message (fn [] ((caller2 "calls-opts-n") :a 7))) "inline-test.lib2/opts: its 1st argument should be String")))
  (testing "too few arguments: as a call without the check says"
    (is (some? (message (caller2 "calls-opts-none"))))))

(deftest call-site-checks-follow-a-redefinition
  (is (= "a" ((caller "calls-relabel") "a")))
  (testing "other types: the new ones are checked"
    (load-string "(in-ns 'inline-test.lib) (defn relabel ^Integer [^Integer s] s) (in-ns 'inline-test)")
    (is (= 5 ((caller "calls-relabel") 5)))
    (is (str/includes? (message (fn [] ((caller "calls-relabel") "a"))) "its 1st argument should be Integer")))
  (testing "no types: nothing is checked"
    (load-string "(in-ns 'inline-test.lib) (defn relabel [s] [s]) (in-ns 'inline-test)")
    (is (= [:x] ((caller "calls-relabel") :x)))))
