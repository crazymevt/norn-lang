;;;; Sealing (M8; design §8.1): the standard library is sealed, redefining a
;;;; sealed var unseals its module with a warning, and skein api-diff tells
;;;; breaking changes to a sealed module's interface from compatible ones.

(ns api-diff-test
  (:require [skein.test :refer [is deftest testing]] [skein.api-diff :as api] [skein.io :as io] [skein.sys :as sys]
            [skein.string :as str]))

(deftest the-standard-library-is-sealed
  (require 'skein.csv)
  ;; (not skein.core or the compiler: compiler_test compiles them again, in
  ;; parallel, sealing them after)
  (is (every? sealed? ['skein.syntax 'skein.csv]))
  (is (not (sealed? 'api-diff-test)) "a module loaded from a file isn't, until a release build seals it"))

(deftest redefining-a-sealed-var-unseals-its-module
  (load-string "(ns sealed-demo) (defn f [] 1)")
  (seal! 'sealed-demo)
  (let [warned (atom [])]
    (handler-bind [Warning (fn [w] (swap! warned conj (condition-message w)) (muffle-warning))]
      (load-string "(in-ns 'sealed-demo) (defn f [] 2) (defn g [] 3) (in-ns 'api-diff-test)"))
    (is (= 1 (count @warned)) "once")
    (is (str/includes? (first @warned) "Redefining sealed-demo/f unseals sealed-demo"))
    (is (not (sealed? 'sealed-demo)))
    (is (= 2 ((resolve 'sealed-demo/f))) "and the redefinition takes effect")))

(def before
  {"f" {:kind :function :arglists ["[a]" "[a b]"] :signature [{:args ["String"] :result "String"}
                                                              {:args ["String" "Any"] :result "String"}]}
   "g" {:kind :function :arglists ["[x & more]"]}
   "m" {:kind :macro :arglists ["[x & body]"]}
   "C" {:kind :class :supers ["skein.core/Error"] :slots ["a" "b"]}
   "*d*" {:kind :var :dynamic true}})

(defn- breaking [after] (vec (for [c (api/changes before after) :when (:breaking c)] [(:name c) (:change c)])))
(defn- compatible [after] (vec (for [c (api/changes before after) :when (not (:breaking c))] [(:name c) (:change c)])))

(deftest what-breaks-and-what-doesnt
  (is (= [] (api/changes before before)))
  (testing "breaking"
    (is (= [["g" "removed (a function)"]] (breaking (dissoc before "g"))))
    (is (= [["f" "no longer takes [a b]"]] (breaking (assoc-in before ["f" :arglists] ["[a]"]))))
    (is (= [["g" "no longer takes [x & more]"]] (breaking (assoc-in before ["g" :arglists] ["[x]" "[x y z & more]"])))
        "a variadic arity split, a count left out")
    (is (= [["m" "was a macro, is a function"]] (breaking (assoc-in before ["m" :kind] :function))))
    (is (= [["C" "slot b removed"]] (breaking (assoc-in before ["C" :slots] ["a"]))))
    (is (= [["C" "no longer a skein.core/Error"]] (breaking (assoc-in before ["C" :supers] ["skein.core/Object"]))))
    (is (= [["*d*" "no longer dynamic"]] (breaking (assoc before "*d*" {:kind :var}))))
    (is (= 1 (count (breaking (assoc-in before ["f" :signature 0 :args] ["Integer"])))) "a signature's types"))
  (testing "compatible"
    (is (= [["h" "added (a function)"]] (compatible (assoc before "h" {:kind :function :arglists ["[]"]}))))
    (is (= [] (breaking (assoc-in before ["f" :arglists] ["[a]" "[a b]" "[a b c]"]))) "a new arity")
    (is (= [] (breaking (assoc-in before ["g" :arglists] ["[& more]"]))) "taking more than before")
    (is (= [] (breaking (assoc-in before ["g" :arglists] ["[x]" "[x y]" "[x y z & more]"])))
        "a variadic arity split into fixed ones and a later variadic one: every count still")
    (is (= [] (breaking (assoc-in before ["C" :slots] ["a" "b" "c"]))) "a new slot")
    (is (= [] (breaking (assoc-in before ["g" :signature] [{:args [] :rest "Any" :result "Any"}]))) "a first signature")))

(deftest a-module-against-its-record
  (let [dir (io/path (sys/temp-dir) (str "skein-api-test-" (sys/pid) "-" (nano-time)))]
    (api/record! dir "skein.csv")
    (is (= {"skein.csv" []} (api/diff dir ["skein.csv"])) "unchanged")
    (io/write-text (io/path dir "skein.csv.edn")
                   (str/replace (io/read-text (io/path dir "skein.csv.edn")) "\"read-maps\"" "\"read-mapz\""))
    (is (= #{["read-mapz" true] ["read-maps" false]}
           (set (map (juxt :name :breaking) (get (api/diff dir ["skein.csv"]) "skein.csv")))))
    (io/delete! dir :recursive true)))

(deftest the-standard-library-leaves-first-party-names-alone
  ;; (a standard module named as a first-party package's would hide it:
  ;; embedded libraries are found first)
  (require 'skein.lint)
  (is (= [] (filterv (resolve 'skein.lint/first-party?) (api/standard-modules)))))

(deftest a-projects-own-modules
  ;; (ledger finding: in a project, skein api-diff compared the standard
  ;; library, not the project)
  (let [dir (io/path (sys/temp-dir) (str "skein-api-project-" (sys/pid) "-" (nano-time)))]
    (io/mkdirs! (io/path dir "src" "shop" "util"))
    (io/write-text (io/path dir "skein.edn") "{:name shop :paths [\"src\"]}")
    (doseq [[f ns] [["src/shop/core.skn" "shop.core"] ["src/shop/util/money-text.skn" "shop.util.money-text"]]]
      (io/write-text (io/path dir f) (str "(ns " ns ")\n(defn f [] 1)\n")))
    (is (= ["shop.core" "shop.util.money-text"] (api/project-modules dir)))
    (io/delete! dir :recursive true)))

;; The standard library against its recorded interfaces (api/ at the root
;; of the checkout), once there are some.
(def root
  (loop [d (io/absolute (sys/cwd))]
    (cond (nil? d) nil
          (io/file? (io/path d "lib" "core" "core.skn")) d
          :else (let [p (io/parent d)] (when (and p (not= p d)) (recur p))))))

(deftest the-standard-library-against-api
  (let [dir (when root (io/path root "api"))]
    (when (and dir (io/directory? dir))
      (is (= [] (vec (for [[m cs] (api/diff dir (api/standard-modules)) c cs :when (:breaking c)] (str m "/" (:name c) ": " (:change c)))))
          "no breaking change since the interfaces were recorded (skein api-diff says more)"))))
