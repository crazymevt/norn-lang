;;;; Values that arrive later, and errors with data (M9 part 9.14):
;;;; promises, delays and futures, which deref (and @) wait for, and ex-info.

(ns later-test
  (:require [skein.test :refer [is deftest testing]] [skein.io :as io] [skein.string :as str]))

(defn- message [f] (try (f) nil (catch Error e (condition-message e))))
(defn- class-name-of [c] (when c (name (class-name (class-of c)))))
;; (waits with a deadline: on a slow machine a fiber may not have started
;; yet, and a lost wake-up should fail a check, not hang the run)
(defn- wait-for "Until (pred), for at most 5 s." [pred]
  (loop [i 0] (when (and (not (pred)) (< i 500)) (sleep 10) (recur (inc i)))))
(defn- parked "f, once it's parked (at most 5 s)." [f] (wait-for (fn [] (%fiber-parked? f))) f)
(defn- awaited "(await f), or :hung after 10 s." [f] (deref (future (await f)) 10000 :hung))

(deftest deref-is-as-it-was
  (is (= 1 @(atom 1)))
  (is (= 2 @(spawn-detached (+ 1 1))) "a fiber"))

(deftest promises
  (let [p (promise)]
    (is (not (realized? p)))
    (is (= :late (deref p 30 :late)) "a timeout")
    (let [waiters (mapv (fn [_] (parked (spawn-detached @p))) (range 20))]
      (is (= p (deliver p 42)))
      (is (= (repeat 20 42) (mapv awaited waiters)) "every fiber waiting wakes"))
    (is (realized? p))
    (is (nil? (deliver p 43)) "once only")
    (is (= 42 @p))
    (is (= 42 (deref p 10 :late)))))

(deftest delays
  (let [n (atom 0)
        d (delay (sleep 20) (swap! n inc) :computed)]
    (is (not (realized? d)))
    (is (= (repeat 10 :computed) (mapv await (mapv (fn [_] (spawn-detached @d)) (range 10)))))
    (is (= 1 @n) "computed once, for ten fibers at once")
    (is (realized? d))
    (is (= :computed (force d)))
    (is (= 5 (force 5)) "force of anything else is itself"))
  (testing "a failure is every deref's"
    (let [runs (atom 0)
          d (delay (swap! runs inc) (/ 1 0))]
      (is (= "ArithmeticError" (class-name-of (try @d nil (catch Error e e)))))
      (is (= "ArithmeticError" (class-name-of (try @d nil (catch Error e e)))))
      (is (= 1 @runs) "not run again")))
  (testing "a delay that needs its own value"
    (let [d (atom nil)]
      (reset! d (delay @@d))
      (is (= "This delay needs its own value to compute it" (message (fn [] @@d))))))
  (testing "left without a value (its fiber cancelled, or a throw-tag out), it's computed again"
    (let [runs (atom 0)
          d (delay (when (= 1 (swap! runs inc)) (sleep 5000)) :computed)
          f (future @d)]
      (wait-for (fn [] (pos? @runs)))
      ;; (cancelled once the waiter waits on it)
      (let [waiter (parked (spawn-detached @d))]
        (future-cancel f)
        (is (= :computed (awaited waiter)) "a fiber waiting on it is woken, and computes it")
        (is (= :computed @d))
        (is (= 2 @runs))
        (is (realized? d))))
    (let [d (delay (throw-tag :out :thrown))]
      (is (= :thrown (catch-tag :out @d)))
      (is (not (realized? d)))
      (is (= :thrown (catch-tag :out @d)) "not stuck: computed again"))))

(deftest futures
  ;; (2 s: still running when looked at, even on a loaded machine)
  (let [f (future (sleep 2000) (+ 1 2))]
    (is (not (future-done? f)))
    (is (= :not-yet (deref f 10 :not-yet)))
    (is (= 3 @f))
    (is (and (future-done? f) (realized? f) (future? f))))
  (testing "its failure is its deref's: the very condition"
    (let [f (future (io/read-text "/no/such/file/at/all"))
          c (try @f nil (catch Error e e))]
      (is (= ["FileNotFound" "/no/such/file/at/all"] [(class-name-of c) (:path c)]))))
  (testing "cancelling"
    (let [f (future (sleep 10000) :never)]
      (future-cancel f)
      ;; (as soon as its fiber has stopped: at most 20 s on a busy machine)
      (loop [n 0] (when (and (not (future-cancelled? f)) (< n 2000)) (sleep 10) (recur (inc n))))
      (is (future-cancelled? f))
      (is (some? (message (fn [] @f)))))))

(defclass Box () ((value :initarg :value)))
(defmethod deref-object ((b Box) _ms _timeout-value) (:value b))

(deftest a-class-of-ones-own
  (is (= 9 @(make Box :value 9)) "a deref-object method")
  (let [c (try @(make SimpleError :message "x") nil (catch Error e e))]
    (is (= "TypeError" (class-name-of c)) "without one: a TypeError")
    (is (str/starts-with? (condition-message c) "deref expects an atom, var, fiber, delay, promise or future, got")))
  (is (some? (message (fn [] (deref (atom 1) 10 :x)))) "a timeout only for promises and futures"))

(deftest errors-with-data
  (let [cause (make SimpleError :message "underneath")
        c (try (throw (ex-info "Bad order" {:id 7} cause)) (catch ExInfo e e))]
    (is (= "Bad order" (ex-message c)))
    (is (= {:id 7} (ex-data c)))
    (is (identical? cause (ex-cause c)))
    (is (instance? Error c)))
  (testing "ex-data of the runtime's errors: what went wrong"
    (is (= {:path "/nope/nope" :reason :not-found} (try (slurp "/nope/nope") (catch IOError e (ex-data e)))))
    (is (nil? (ex-data (make SimpleError :message "x"))) "nothing to say")
    (is (nil? (ex-data :not-a-condition))))
  (is (some? (message (fn [] (ex-info "x" [1 2])))) "the data is a map"))
