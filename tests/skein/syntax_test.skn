;;;; skein.syntax: syntax objects, their scopes, and reading with places
;;;; (M8 part 8.1).

(ns syntax-test
  (:require [skein.test :refer [is deftest testing]] [skein.syntax :as syn] [skein.string :as str]
            [skein.io :as io]))

(def src "(defn f [x]\n  {:a (g 'x) \"s\" #{1 2}})\n^:meta (h #_ignored y)\n`(a ~b)\n#(+ % 1)")

(def forms (syn/read-all-syntax src "t.skn"))

(defn- where [s] (syn/syntax-where s))

(deftest reading-with-places
  (testing "each part knows its line and column"
    (let [[_ name params body] (syn/syntax->list (first forms))]
      (is (= "t.skn:1:1" (where (first forms))))
      (is (= "t.skn:1:7" (where name)))
      (is (= "t.skn:1:9" (where params)))
      (is (= "t.skn:1:10" (where (first (syn/syntax->list params)))))
      (is (= "t.skn:2:3" (where body)))))
  (testing "after a byte-order mark, places are the text's"
    (let [[f] (syn/read-all-syntax (str (char 0xFEFF) "(f x)\n(g y)") "b.skn")
          [_ x] (syn/syntax->list f)]
      (is (= ["b.skn:1:1" "b.skn:1:4"] [(where f) (where x)]))))
  (testing "a map's entries keep their places, though the map reorders them"
    (let [m (into {} (map (fn [[k v]] [(syn/syntax->datum k) [(where k) (where v)]])) (syn/syntax-e (nth (syn/syntax->list (first forms)) 3)))]
      (is (= ["t.skn:2:4" "t.skn:2:7"] (get m :a)))
      (is (= ["t.skn:2:14" "t.skn:2:18"] (get m "s")))))
  (testing "'x is (quote x): quote is the marker's place, x its own"
    (let [m (syn/syntax-e (nth (syn/syntax->list (first forms)) 3))
          call (some (fn [[k v]] (when (= :a (syn/syntax->datum k)) v)) m)
          [_ q] (syn/syntax->list call)
          [qs x] (syn/syntax->list q)]
      (is (= 'quote (syn/syntax-e qs)))
      (is (= ["t.skn:2:10" 1] [(where qs) (syn/syntax-span qs)]))
      (is (= "t.skn:2:11" (where x)))))
  (testing "metadata and #_ are skipped, with their places"
    (let [[_ y] (syn/syntax->list (second forms))]
      (is (= "t.skn:3:8" (where (second forms))))
      (is (= '(h y) (syn/syntax->datum (second forms))))
      (is (= "t.skn:3:21" (where y)))))
  (testing "spans and offsets"
    (let [[_ name] (syn/syntax->list (first forms))]
      (is (= [6 1] [(syn/syntax-position name) (syn/syntax-span name)]))
      (is (= 37 (syn/syntax-span (first forms))))))
  (testing "a form the reader rewrote: its parts get its place"
    (let [sq (nth forms 2)
          fl (nth forms 3)]
      (is (= "t.skn:4:1" (where sq)))
      (is (every? (fn [p] (= "t.skn:4:1" (where p))) (syn/syntax->list sq)))
      (is (= 'fn* (syn/syntax-e (first (syn/syntax->list fl)))))
      (is (= "t.skn:5:1" (where (first (syn/syntax->list fl)))))))
  (testing "lines count characters, not bytes"
    (let [[_ s x] (syn/syntax->list (first (syn/read-all-syntax "(f \"héllo ☃\" x)" "u")))]
      (is (= "u:1:4" (where s)))
      (is (= "u:1:14" (where x)))
      (is (= 13 (syn/syntax-position x)))))
  (testing "#lang isn't Skein"
    (is (thrown? Error (syn/read-all-syntax "#lang skein\n(+ 1 2)" "l")))))

(defn- digits-out
  "Form f with digits taken out of its symbols' names: generated names
  (gensyms, #() parameters) differ from one read to the next."
  [f]
  (cond (symbol? f) (symbol (namespace f) (str/replace (name f) #"[0-9]+" "N"))
        (seq? f) (apply list (map digits-out f))
        (vector? f) (mapv digits-out f)
        (map? f) (into {} (map (fn [[k v]] [(digits-out k) (digits-out v)])) f)
        (set? f) (into #{} (map digits-out) f)
        :else f))

(defn- read-plain [text]
  (let [r (%reader text "x")]
    (loop [out []]
      (let [f (%read r)]
        (if (%eof? f) out (recur (conj out f)))))))

(defn- repo-file
  "Path rel in this repository, from wherever the tests run (the root, or a
  crate's folder under cargo test)."
  [rel]
  (loop [dir (io/absolute ".") n 0]
    (let [p (io/path dir rel)]
      (cond (io/file? p) p
            (or (nil? (io/parent dir)) (> n 4)) (error "Can't find" rel)
            :else (recur (io/parent dir) (inc n))))))

(deftest read-syntax-agrees-with-read
  ;; Every library file, read both ways: the same forms.
  (doseq [file ["lib/core/core.skn" "lib/compiler/compiler.skn" "lib/skein/string.skn" "lib/skein/fmt.skn"
                "lib/skein/markdown.skn" "lib/skein/syntax.skn" "lib/skein/test.skn"]]
    (let [text (io/read-text (repo-file file))
          plain (read-plain text)
          syntax (mapv syn/syntax->datum (syn/read-all-syntax text file))]
      (is (= (count plain) (count syntax)) file)
      (is (= (mapv digits-out plain) (mapv digits-out syntax)) file))))

(deftest datum-and-syntax
  (let [ctx (syn/datum->syntax nil 'here ["c.skn" 3 4 10 4])
        s (syn/datum->syntax ctx '(let [a 1] {:k #{a}}))]
    (is (= '(let [a 1] {:k #{a}}) (syn/syntax->datum s)))
    (is (syn/syntax? s))
    (is (every? syn/syntax? (syn/syntax->list s)) "parts are syntax too")
    (is (= "c.skn:3:4" (where (first (syn/syntax->list s)))) "the context's place")
    (is (syn/identifier? (first (syn/syntax->list s))))
    (is (not (syn/identifier? s)))
    (is (= 'x (syn/syntax->datum 'x)) "a datum passes through")
    (testing "syntax already made stays as it is"
      (let [inner (syn/datum->syntax nil 'y ["i" 1 1 0 1])
            outer (syn/datum->syntax ctx (list 'f inner))]
        (is (identical? inner (second (syn/syntax->list outer))))))
    (testing "syntax objects are equal only to themselves"
      (is (not= (syn/datum->syntax nil 'z) (syn/datum->syntax nil 'z))))))

(deftest scopes
  (let [a (syn/new-scope)
        b (syn/new-scope)
        s (syn/datum->syntax nil '(f x [y]))
        sa (syn/add-scope s a)
        [f x v] (syn/syntax->list sa)]
    (is (not= a b))
    (is (= #{a} (syn/syntax-scopes sa)))
    (is (= #{a} (syn/syntax-scopes (first (syn/syntax->list v)))) "deep")
    (is (= #{} (syn/syntax-scopes (syn/remove-scope sa a))))
    (testing "flipping twice is no change"
      (let [ab (syn/add-scope sa b)
            flipped (syn/flip-scope ab a)]
        (is (= #{b} (syn/syntax-scopes flipped)))
        (is (= #{a b} (syn/syntax-scopes (syn/flip-scope flipped a))))))
    (testing "bound-identifier=?: the same name with the same scopes"
      (is (syn/bound-identifier=? x (syn/datum->syntax sa 'x)))
      (is (not (syn/bound-identifier=? x (syn/datum->syntax nil 'x))))
      (is (not (syn/bound-identifier=? x f))))))
