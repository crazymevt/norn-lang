;;;; skein.cover's reports, from counts made up here (turning coverage on
;;;; would count the rest of the run: crates/skein/tests/coverage.rs runs
;;;; skein test --coverage on a project of its own).

(ns cover-test
  (:require [skein.cover :as cover]
            [skein.string :as str]
            [skein.test :refer [deftest is testing]]))

(def cs (sorted-map "src/a.skn" (sorted-map 1 1 3 4 4 0 5 0 6 0 9 2 12 0)
                    "src/b.skn" (sorted-map 2 7)))

(deftest summaries
  (is (= [{:file "src/a.skn" :lines 7 :hit 3 :missed [4 5 6 12]}
          {:file "src/b.skn" :lines 1 :hit 1 :missed []}]
         (cover/summary cs))))

(deftest reports
  (let [r (cover/report cs)]
    (is (str/starts-with? r "coverage: 4 of 8 lines (50.0%) in 2 files\n"))
    (is (str/includes? r "src/a.skn       3/7      42.9%  missed: 4-6, 12\n"))
    (is (str/includes? r "src/b.skn       1/1     100.0%\n")))
  (testing "a long list of misses is cut"
    (let [many (sorted-map "x.skn" (into (sorted-map) (map (fn [l] [(* 2 l) 0]) (range 1 20))))]
      (is (str/includes? (cover/report many :missed 3) "missed: 2, 4, 6, …")))))

(deftest lcov
  (let [text (cover/lcov cs)]
    (is (= 2 (count (re-seq #"end_of_record" text))))
    (is (str/includes? text "DA:3,4\nDA:4,0\n"))
    (is (str/includes? text "LF:7\nLH:3\nend_of_record\n"))
    (is (re-find #"SF:/.*/src/b\.skn\nDA:2,7\nLF:1\nLH:1\n" text) "paths absolute")))
