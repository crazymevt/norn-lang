(ns quire.build-test
  (:require [norn.fs :as fs]
            [norn.http :as http]
            [norn.io :as io]
            [norn.log :as log]
            [norn.string :as str]
            [norn.sys :as sys]
            [norn.test :refer [deftest is testing use-fixtures]]
            [norn.zip :as zip]
            [quire.build :as build]
            [quire.content :as content]
            [quire.serve :as serve]))

(def here (let [loc (%location)] (io/parent (subs loc 0 (str/last-index-of loc ":")))))

(defn- copy-site!
  "A copy of the sample site in a new temporary folder: its path."
  []
  (let [dir (io/path (sys/temp-dir) (str "quire-" (sys/pid) "-" (nano-time)))]
    (doseq [f (fs/glob (str here "/site/**/*")) :when (io/file? f)]
      (let [to (io/path dir (subs f (inc (count (io/path here "site")))))]
        (io/mkdirs! (io/parent to))
        (io/write-bytes to (io/read-bytes f))))
    dir))

(use-fixtures :each (fn [run] (binding [log/*level* :error] (run))))

(deftest building
  (let [dir (copy-site!) out (io/path dir "_site")]
    (let [r (build/build! dir out :zip true)]
      (is (= {:posts 3 :written 13 :unchanged 0 :removed 0} (dissoc r :broken)) "three posts, one a placeholder")
      (is (= 1 (count (:broken r)))))
    (testing "again: nothing to write"
      (is (= {:written 0 :unchanged 13} (select-keys (build/build! dir out :zip true) [:written :unchanged]))))
    (testing "the zip holds the site"
      (is (= (io/read-text (io/path out "index.html"))
             (bytes->string (zip/read-entry (io/read-bytes (io/path out "site.zip")) "index.html")))))
    (testing "a post gone: its page goes too"
      (io/delete! (io/path dir "posts" "rain.md"))
      (let [r (build/build! dir out)]
        (is (= 3 (:removed r)) "its page, its tag's page, and the zip (not asked for now)")
        (is (not (io/exists? (io/path out "posts" "rain.html"))))))
    (testing "strict: a post that can't be read stops it"
      (is (thrown? content/BadPost (build/build! dir out :on-bad-post :stop))))
    (testing "skipped"
      (is (= 1 (:posts (build/build! dir out :on-bad-post :skip)))))
    (io/delete! dir :recursive true)))

(defn- reader-of
  "An atom of all text stream r has given, kept by one fiber reading it."
  [r]
  (let [seen (atom "")]
    (spawn-detached (loop [] (when-let [c (try (io/read-chunk r) (catch Error _ nil))] (swap! seen str c) (recur))))
    seen))

(defn- shows?
  "Does seen (from reader-of) come to hold text within 10 s?"
  [seen text]
  (loop [n 0]
    (cond (str/includes? @seen text) true
          (> n 200) false
          :else (do (sleep 50) (recur (inc n))))))

(deftest serving
  (let [dir (copy-site!) out (io/path dir "_site")
        s (serve/serve! dir out 0)
        url (fn [p] (str "http://127.0.0.1:" (:port (:server s)) p))]
    (try
      (is (str/includes? (:body (http/get (url "/"))) "First Light"))
      (is (= "image/png" (get-in (http/get (url "/img/moon.png") :as :bytes) [:headers "content-type"])))
      (is (= 404 (:status (http/get (url "/nope.html")))))
      (is (= 404 (:status (http/get (url "/../site.edn")))))
      (testing "a change: rebuilt, and browsers told"
        (http/with-response [resp {:url (url "/__reload") :timeout 5000}]
          (let [seen (reader-of (io/text-reader (:body resp)))]
            (is (shows? seen ": listening"))
            (io/write-text (io/path dir "posts" "rain.md")
                           (str/replace (io/read-text (io/path dir "posts" "rain.md")) "title: Rain" "title: Downpour"))
            (is (shows? seen "data: reload")))))
      (is (str/includes? (:body (http/get (url "/"))) "Downpour") "the new title")
      (finally ((:stop s))
               (io/delete! dir :recursive true)))))
