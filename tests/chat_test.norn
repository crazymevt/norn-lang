(ns chat-test
  (:require [chat.client :as c]
            [chat.server :as server]
            [chat.state :as state]
            [norn.io :as io]
            [norn.log :as log]
            [norn.net :as net]
            [norn.string :as str]
            [norn.sys :as sys]
            [norn.test :refer [deftest is testing use-fixtures]]))

(use-fixtures :each (fn [run] (binding [log/*level* (if (sys/getenv "CHAT_LOG") :info :error)] (run))))

(defmacro with-server
  "(with-server [s options…] body…): body with s a chat server started on a
  free port with options, stopped after."
  [[s & opts] & body]
  `(let [~s (server/start! "127.0.0.1" 0 ~@opts)]
     (try ~@body (finally ((:stop ~s))))))

(defn- join!
  "A client called name, in room: past the server's replies to that."
  [s name room]
  (let [cl (c/connect! "127.0.0.1" (:port s))]
    (c/say! cl (str "/nick " name))
    (c/until cl (fn [l] (= l (str "* you are " name))))
    (when room
      (c/say! cl (str "/join " room))
      (c/until cl (fn [l] (= l (str "* " name " joined " room)))))
    cl))

(deftest talking
  (with-server [s]
    (let [ada (join! s "ada" "#lab") bob (join! s "bob" "#lab")]
      (c/until ada (fn [l] (= l "* bob joined #lab")))
      (c/say! ada "hello")
      (is (= "#lab <ada> hello" (c/next-line bob)))
      (c/say! bob "/msg ada psst")
      (is (= "*bob* psst" (last (c/until ada (fn [l] (str/starts-with? l "*bob*"))))))
      (c/say! bob "/who")
      (is (= "* in #lab: ada, bob" (last (c/until bob (fn [l] (str/starts-with? l "* in"))))))
      (testing "what isn't right"
        (c/say! bob "/nick ada")
        (is (= "! ada is taken" (last (c/until bob (fn [l] (str/starts-with? l "!"))))))
        (c/say! bob "/frobnicate")
        (is (= "! no command /frobnicate" (last (c/until bob (fn [l] (str/starts-with? l "!")))))))
      (testing "someone joining hears what was said"
        (let [cy (join! s "cy" nil)]
          (c/say! cy "/join #lab")
          (is (some #{"#lab <ada> hello"} (c/until cy (fn [l] (= l "* cy joined #lab")))))))
      (testing "going: the others hear, the name is free"
        (c/leave! bob)
        (is (some #{"* bob left #lab"} (c/until ada (fn [l] (= l "* bob left #lab")))))
        (is (nil? (state/user (:state s) "bob"))))
      (c/leave! ada))))

(deftest one-name-one-person
  ;; (fifty at once ask for the same name: the transaction gives it to one)
  (with-server [s]
    (let [cls (vec (repeatedly 50 (fn [] (c/connect! "127.0.0.1" (:port s)))))]
      (doseq [cl cls] (c/next-line cl))
      (doseq [cl cls] (c/say! cl "/nick same"))
      (let [answers (mapv (fn [cl] (c/next-line cl 5000)) cls)]
        (is (= {"* you are same" 1 "! same is taken" 49} (frequencies answers))))
      (doseq [cl cls] (c/leave! cl)))))

(deftest many-people-one-room
  ;; (200 clients, each saying 5 things: everyone hears all 1000, each
  ;; speaker's in the order said. 200,000 lines go out at once: room
  ;; enough in each outbox that nobody's let go as slow for it.)
  (let [n 200 k 5]
    (with-server [s :rate 1000 :burst 1000 :outbox 4000]
      (let [cls (vec (for [i (range n)] (join! s (str "u" i) "#all")))
            heard (fn [cl] (loop [h []]
                             (if (= (count h) (* n k))
                               h
                               (if-let [l (c/next-line cl 10000)]
                                 (recur (if (str/starts-with? l "#all <") (conj h l) h))
                                 h))))]
        ;; (everyone in before anyone speaks)
        (c/until (peek cls) (fn [l] false) 300)
        (with-scope [sc]
          (doseq [[i cl] (map-indexed vector cls)]
            (spawn sc (dotimes [j k] (c/say! cl (str i ":" j))))))
        (let [all (mapv heard cls)]
          (is (every? (fn [h] (= (* n k) (count h))) all) "everyone heard everything")
          (is (every? (fn [h]
                        (every? (fn [i] (= (mapv (fn [j] (str "#all <u" i "> " i ":" j)) (range k))
                                           (filterv (fn [l] (str/starts-with? l (str "#all <u" i "> "))) h)))
                                (range n)))
                      (take 5 all))
              "each speaker heard in order"))
        (doseq [cl cls] (c/leave! cl))))))

(deftest too-fast-and-too-slow
  (testing "a client saying too much is told to slow down"
    (with-server [s :rate 5 :burst 10]
      (let [ada (join! s "ada" "#lab")]
        (dotimes [i 30] (c/say! ada (str "spam " i)))
        (is (some #{"! slow down"} (c/until ada (fn [l] (= l "! slow down")))))
        (c/leave! ada))))
  (testing "a client not reading is let go; the others go on"
    (with-server [s :rate 100000 :burst 100000]
      (let [ada (join! s "ada" "#lab")
            sloth (net/connect "127.0.0.1" (:port s))
            filler (apply str (repeat 400 "x"))]
        (io/write sloth "/nick sloth\n/join #lab\n")
        (c/until ada (fn [l] (= l "* sloth joined #lab")))
        (dotimes [i 5000] (c/say! ada (str i " " filler)))
        (is (some #{"* sloth left #lab"} (c/until ada (fn [l] (= l "* sloth left #lab")) 10000)))
        (c/say! ada "/who")
        (is (= "* in #lab: ada" (last (c/until ada (fn [l] (str/starts-with? l "* in"))))))
        (io/close sloth)
        (c/leave! ada)))))

(deftest a-full-server
  (with-server [s :max-clients 2]
    (let [a (join! s "a" nil) b (join! s "b" nil) third (c/connect! "127.0.0.1" (:port s))]
      (is (= "! the server is full" (c/next-line third)))
      (c/leave! a)
      (sleep 200)
      (let [d (join! s "d" nil)]
        (is (some? (state/user (:state s) "d")) "a place comes free when someone goes")
        (c/leave! d))
      (c/leave! b) (c/leave! third))))

(def here (let [loc (%location)] (io/parent (subs loc 0 (str/last-index-of loc ":")))))

(deftest over-tls
  (let [certs (io/path here "certs")]
    (with-server [s :tls true :cert-file (io/path certs "server.pem") :key-file (io/path certs "server.key")]
      (let [cl (c/connect! "localhost" (:port s) :tls true :ca-file (io/path certs "ca.pem"))]
        (is (= "* welcome: /nick NAME to start" (c/next-line cl)))
        (c/say! cl "/nick secure")
        (is (= "* you are secure" (c/next-line cl)))
        (c/leave! cl)))))

(deftest state-stays-consistent
  ;; (people joining, leaving and renaming at once: every room's members
  ;; are users who say they're in it, and the other way round)
  (with-server [s :rate 10000 :burst 10000]
    (with-scope [sc]
      (dotimes [i 40]
        (spawn sc (let [cl (join! s (str "p" i) "#a")]
                    (dotimes [j 10]
                      (c/say! cl (str "/join " (rand-nth ["#a" "#b" "#c"])))
                      (when (zero? (mod j 3)) (c/say! cl (str "/nick p" i "x" j))))
                    (c/say! cl "/rooms")
                    (c/until cl (fn [l] (str/starts-with? l "* rooms")) 5000)
                    (when (even? i) (c/leave! cl))))))
    (c/until (join! s "watcher" nil) (fn [_] false) 500)
    (let [st (:state s)
          users @(:users st)
          rooms @(:rooms st)]
      (is (= (set (for [[r ms] rooms m ms] [m r]))
             (set (for [[n u] users :when (:room u)] [n (:room u)])))))))

(deftest a-reply-that-cant-be-sent-lets-the-client-go
  ;; (an answer to a client whose outbox is full isn't dropped while its
  ;; connection goes on, leaving it waiting: it's let go, as a broadcast lets
  ;; go of those it can't reach, so it sees its connection end)
  (let [command (var-get (get (ns-interns 'chat.server) 'command))
        st (state/new-state)
        outbox (chan 1)
        kicked (atom 0)
        conn {:name nil :outbox outbox :kick (fn [] (swap! kicked inc) (close! outbox))}]
    (offer! outbox "a line it hasn't taken yet")
    (command st conn "/rooms" nil)
    (is (= 1 @kicked) "let go")
    (command st conn "/rooms" nil)
    (is (= 1 @kicked) "once")))
