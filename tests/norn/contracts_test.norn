;;;; Types and contracts (M9 parts 9.3 and 9.4): a function's signature
;;;; (^Integer x) or defcontract is checked on calls from other modules,
;;;; blaming the side at fault; the module's own calls go direct. The
;;;; modules are written to a temporary folder.

(ns contracts-test
  (:require [norn.test :refer [is deftest testing]] [norn.io :as io] [norn.sys :as sys]
            [norn.string :as str]))

(def dir (io/path (sys/temp-dir) (str "norn-contracts-test-" (sys/pid) "-" (nano-time))))
(io/mkdirs! (io/path dir "ct2"))
(add-lib-path! dir)

(defn- module! [name text] (io/write-text (io/path dir "ct2" (str name ".norn")) text))
(defn- run [form] (eval form))
(defn- caught [form] (try (run form) nil (catch Error e e)))

(module! "lib" (str "(ns ct2.lib)\n"
                    "(defn add ^Integer [^Integer a ^Integer b] (+ a b))\n"
                    "(defn shout ^String [^String s] (if (= s \"lie\") 42 (str s \"!\")))\n"
                    "(defn total ^Number [^(Vec Number) xs & ^Integer more] (reduce + (concat xs more)))\n"
                    "(defn label ^(? String) [^(U Keyword String) k] (when-not (= k :none) (name k)))\n"
                    "(defn twice ^Integer [^(-> Integer Integer) f ^Integer x] (f (f x)))\n"
                    "(defn own [] (add \"not\" \"checked\"))\n"
                    "(defn halve [x] (/ x 2))\n"
                    "(defcontract halve (fn-of [even?] integer?))\n"
                    "(defn plain [x] x)\n"
                    "(defn misuse ^Integer [^(-> Integer Integer) f] (f \"oops\"))\n"
                    "(defn give-adder ^(-> Integer Integer) [] (fn [x] (if (= x 0) :zero (inc x))))\n"
                    "(defn same ^(Vec Integer) [^(Vec Integer) xs] xs)\n"
                    "(defn same-map ^(Map Keyword Integer) [^(Map Keyword Integer) m] m)\n"
                    "(defn fns ^(Vec (-> Integer Integer)) [^(Vec (-> Integer Integer)) fs] fs)\n"))

(module! "user" (str "(ns ct2.user\n  (:require [ct2.lib :as lib]))\n"
                     "(defn good [] (lib/add 1 2))\n"
                     "(defn bad-arg [] (lib/add 1 \"2\"))\n"
                     "(defn bad-result [] (lib/shout \"lie\"))\n"
                     "(defn total [] (lib/total [1 2.5] 3 4))\n"
                     "(defn total-bad [] (lib/total [1 :x]))\n"
                     "(defn labels [] [(lib/label :a) (lib/label \"b\") (lib/label :none)])\n"
                     "(defn label-bad [] (lib/label 7))\n"
                     "(defn twice [] (lib/twice inc 1))\n"
                     "(defn twice-bad [] (lib/twice (fn [x] (str x)) 1))\n"
                     "(defn as-value [] (mapv lib/add [1 2] [3 4]))\n"
                     "(defn own [] (lib/own))\n"
                     "(defn halve [] (lib/halve 4))\n"
                     "(defn halve-bad [] (lib/halve 3))\n"
                     "(defn plain [] (lib/plain :anything))\n"
                     "(defn misuse [] (lib/misuse inc))\n"
                     "(defn adder [x] ((lib/give-adder) x))\n"
                     "(defn same [v] (lib/same v))\n"
                     "(defn same-map [m] (lib/same-map m))\n"
                     "(defn fns [fs] (lib/fns fs))\n"
                     "(defn the-var [] #'lib/add)\n"))

(run '(require 'ct2.user))

(defn- blame [form] (when-let [c (caught form)] [(name (class-name (class-of c))) (:blame c) (:position c)]))

(deftest signatures-are-checked-from-other-modules
  (is (= 3 (run '(ct2.user/good))))
  (testing "a bad argument blames the caller"
    (let [c (caught '(ct2.user/bad-arg))]
      (is (= "ContractError" (name (class-name (class-of c)))))
      (is (= ["ct2.lib/add" "its 2nd argument" "Integer" "2"] [(:function c) (:position c) (:expected c) (:value c)]))
      (is (str/starts-with? (:blame c) "ct2.user ("))
      (is (str/ends-with? (:blame c) "ct2/user.norn)"))
      (is (str/starts-with? (condition-message c) "ct2.lib/add: its 2nd argument should be Integer, got \"2\", blaming ct2.user"))))
  (testing "a bad result blames the function's module"
    (is (= ["ContractError" "ct2.lib" "its result"] (blame '(ct2.user/bad-result)))))
  (is (= "#'ct2.lib/add" (str (run '(ct2.user/the-var))))
      "#'f is f's var, not the wrapper that checks calls to it"))

(deftest the-types
  (testing "(Vec T), and the rest of the arguments"
    (is (= 10.5 (run '(ct2.user/total))))
    (is (= "a vector of Number" (:expected (caught '(ct2.user/total-bad))))))
  (testing "(U A B) and (? T)"
    (is (= ["a" "b" nil] (run '(ct2.user/labels))))
    (is (= "Keyword or String" (:expected (caught '(ct2.user/label-bad))))))
  (testing "(-> A R): a function argument, checked when it's called"
    (is (= 3 (run '(ct2.user/twice))))
    (let [c (caught '(ct2.user/twice-bad))]
      (is (= "its result" (:position c)))
      (is (str/starts-with? (:blame c) "ct2.user (") "the module that gave the function broke its contract"))
    (is (= ["its 1st argument" "ct2.lib"] ((juxt :position :blame) (caught '(ct2.user/misuse))))
        "the module calling the function it was given broke the contract"))
  (testing "(-> A R) as a result: the function given back"
    (is (= 2 (run '(ct2.user/adder 1))))
    (is (= ["its result" "ct2.lib"] ((juxt :position :blame) (caught '(ct2.user/adder 0)))) "a bad result blames its giver")
    (let [c (caught '(ct2.user/adder "a"))]
      (is (= "its 1st argument" (:position c)))
      (is (str/starts-with? (:blame c) "ct2.user (") "a bad argument blames its caller")))
  (testing "a name that isn't a type"
    (module! "badtype" "(ns ct2.badtype)\n(defn f [^even? x] x)\n")
    (is (str/includes? (condition-message (caught '(require 'ct2.badtype))) "^even? isn't a type"))))

(deftest collection-contracts-check-in-place
  (let [v [1 2 3] m {:a 1 :b 2}]
    (is (identical? v ((run 'ct2.user/same) v)) "(Vec T): the vector itself, not a copy")
    (is (identical? m ((run 'ct2.user/same-map) m)) "(Map K V): the map itself")
    (is (= "a map of Keyword to Integer" (:expected (caught (list 'ct2.user/same-map {:a "1"})))))
    (is (= "a vector of Integer" (:expected (caught (list 'ct2.user/same [1 :x]))))))
  (testing "a vector of functions is wrapped, item by item"
    (let [fs (run '(ct2.user/fns [inc dec]))]
      (is (= [2 0] [((first fs) 1) ((second fs) 1)]))
      (is (= "ContractError" (name (class-name (class-of (try ((first fs) "x") nil (catch Error e e))))))))))

(deftest boundaries
  (testing "the module's own calls go direct"
    (is (= "TypeError" (name (class-name (class-of (caught '(ct2.user/own))))))
        "lib calling its own add with strings: + complains, not the contract"))
  (testing "a function passed as a value takes its contract with it"
    (is (= [4 6] (run '(ct2.user/as-value)))))
  (testing "the REPL counts as another module"
    (is (= "ContractError" (name (class-name (class-of (caught '(ct2.lib/add 1 :two))))))))
  (testing "a function without a contract is called as it is"
    (is (= :anything (run '(ct2.user/plain))))))

(deftest defcontract-gives-one-directly
  (is (= 2 (run '(ct2.user/halve))))
  (is (= ["ContractError" "its 1st argument" "even?"] ((juxt (fn [c] (name (class-name (class-of c)))) :position :expected) (caught '(ct2.user/halve-bad))))))

(deftest a-redefinition-takes-effect
  ;; (as text: types are written on the source, and quoted data has none)
  (load-string "(in-ns 'ct2.lib) (defn add [a b] [a b]) (in-ns 'contracts-test)")
  (is (= [1 "2"] (run '(ct2.user/bad-arg))) "no types now: no contract")
  (load-string "(in-ns 'ct2.lib) (defn add ^Integer [^Integer a ^Integer b] (+ a b)) (in-ns 'contracts-test)")
  (is (= "ContractError" (name (class-name (class-of (caught '(ct2.user/bad-arg))))))))

(deftest which-calls-check
  (module! "loose" "(ns ct2.loose\n  (:require [ct2.lib :as lib]))\n(defn f [] (lib/add 1 \"x\"))\n")
  (binding [*check-contracts* :none] (run '(require 'ct2.loose)))
  (is (= "TypeError" (name (class-name (class-of (caught '(ct2.loose/f)))))) ":none: not checked at all"))

(deftest contracts-as-values
  (let [c (fn-of [integer? (any-of string? keyword?)] (nilable vector?))
        f ((:check c) (fn [n k] (when (pos? n) [n k])) (fn [] (error "not a function")))]
    (is (= [1 :a] (f 1 :a)))
    (is (nil? (f 0 "x")))
    (is (= "the function's caller" (:blame (try (f "1" :a) nil (catch ContractError e e)))))
    (is (= "(fn-of [integer? string? or keyword?] nil or vector?)" (contract-name c))))
  (is (= ["a vector of Integer" "a map of Keyword to anything" "integer? and pos?"]
         [(contract-name (vec-of Integer)) (contract-name (map-of Keyword :any)) (contract-name (all-of integer? pos?))])))

(deftest declarations-for-the-optimiser
  (let [before (count @%declarations)
        f (eval '(fn [x] (declare (optimize (speed 3)) (type Integer x)) (* 2 x)))]
    (is (= 4 (f 2)) "doing nothing yet")
    (is (= '[(optimize (speed 3)) (type Integer x)] (second (last @%declarations))))
    (is (= (inc before) (count @%declarations)))))

(def signed-libraries
  "The libraries whose public functions carry checked signatures: all but\n  core, the tools, norn.syntax, and norn.string, math, regex and bytes\n  (hot and thin, their primitives checking types: signed when M10 inlines\n  the checks)."
  '[norn.actor norn.async norn.bin norn.buffer norn.cache norn.cbor norn.cli norn.compress norn.crypto
    norn.csv norn.data norn.decimal norn.edn norn.ffi norn.format norn.fs norn.http norn.io norn.json
    norn.log norn.markdown norn.ndjson norn.net norn.pprint norn.process norn.property norn.random
    norn.rope norn.schedule norn.set norn.signal norn.sqlite norn.stm norn.sync norn.sys norn.terminal
    norn.time norn.toml norn.uri norn.uuid norn.walk norn.xml norn.yaml norn.zip])

(def unsigned
  "The functions there that take nothing a type can say (no arguments,
  only functions, or any values, streams or names), and three on hot
  paths whose primitives check their arguments: ffi/call, which every
  defcfun function calls after checking its own C signature, and
  io/auto-close and io/retry-io, under every stream operation."
  '#{norn.actor/exit! norn.actor/run-in-process norn.actor/send norn.actor/trap-exits!
     norn.ffi/call norn.http/close-idle! norn.io/auto-close norn.io/close norn.io/eprint
     norn.io/eprintln norn.io/retry-io norn.log/set-sink! norn.ndjson/write-record
     norn.stm/after-commit norn.stm/run-transaction norn.terminal/call-with-raw-mode
     norn.terminal/suspend! norn.walk/keywordize-keys norn.walk/macroexpand-all
     norn.walk/postwalk norn.walk/prewalk norn.walk/stringify-keys norn.walk/walk})

(deftest the-libraries-public-functions-are-checked
  (doseq [l signed-libraries] (require l))
  (is (= []
         (vec (for [l signed-libraries
                    [s v] (sort-by (fn [[s _]] (str s)) (ns-publics l))
                    :let [full (symbol (str l) (str s))]
                    :when (and (fn? (var-get v)) (not (macro? v)) (not (str/starts-with? (str s) "%"))
                               (not (contains? unsigned full)) (not (%contracted? v)))]
                full)))
      "every public function has a signature, or is listed as taking nothing typeable")
  (is (= []
         (vec (filter (fn [full] (%contracted? (resolve full))) (sort-by str unsigned))))
      "the list holds only unsigned functions")
  (is (str/starts-with? (:message (caught '(norn.uri/parse 5))) "norn.uri/parse: its 1st argument should be String, got 5")))

(deftest a-module-loaded-mid-form-keeps-its-own-signatures
  ;; (a macro that loads a module while a typed defn expands: that module's
  ;; own defn of the same name mustn't take the place of the signature)
  (module! "loads" "(ns ct2.loads)\n(defmacro loader [x] (require 'ct2.same-name) x)\n")
  (module! "same-name" "(ns ct2.same-name)\n(defn parse [x] x)\n")
  (module! "typed-parse" "(ns ct2.typed-parse (:require [ct2.loads :as l]))\n(defn parse ^String [^String s] (l/loader s))\n")
  (run '(require 'ct2.typed-parse))
  (is (%contracted? (resolve 'ct2.typed-parse/parse)))
  (is (= "ContractError" (some-> (caught '(ct2.typed-parse/parse 5)) class-of class-name name))))
