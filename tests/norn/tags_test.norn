;;;; Tagged literals: #norn/decimal "12.30", #norn/date "2026-11-03", #inst
;;;; and the rest. Decimals and times print as them readably (pr-str, prn,
;;;; EDN) and as their text for people (str, print); the reader and norn.edn
;;;; read them back, and *tag-readers* or :readers read others.

(ns tags-test
  (:require [norn.decimal :as d]
            [norn.edn :as edn]
            [norn.property :as p]
            [norn.test :refer [deftest is testing]]
            [norn.time :as t]))

(def price (d/parse "12.30"))
(def day (t/local-date 2026 11 3))
(def launch (t/parse "2026-11-13T07:05:00Z"))

(deftest printing
  (testing "readably: a tagged literal"
    (is (= "#norn/decimal \"12.30\"" (pr-str price)))
    (is (= "#norn/date \"2026-11-03\"" (pr-str day)))
    (is (= "#norn/time \"09:30:00\"" (pr-str (t/local-time 9 30))))
    (is (= "#norn/date-time \"2026-11-03T09:30:00\"" (pr-str (t/local-date-time day (t/local-time 9 30)))))
    (is (= "#inst \"2026-11-13T07:05:00Z\"" (pr-str launch)))
    (is (= "[#norn/decimal \"12.30\" {:on #norn/date \"2026-11-03\"}]" (pr-str [price {:on day}]))))
  (testing "for people: the text"
    (is (= "12.30 on 2026-11-03" (str price " on " day)))
    (is (= "12.30 [12.30]\n" (with-out-str (println price [price]))))
    (is (= "total 12.30" (format "total %s" price)))))

(deftest reading
  (is (= price (read-string "#norn/decimal \"12.30\"")))
  (is (= [day launch] (read-string "[#norn/date \"2026-11-03\" #inst \"2026-11-13T07:05:00Z\"]")))
  (is (= "cb03b423-0252-4efc-affb-cf606c3fabee" (read-string "#uuid \"CB03B423-0252-4EFC-AFFB-CF606C3FABEE\""))
      "a UUID is its text, in lower case")
  (is (= (d/parse "0.35") (d/add #norn/decimal "0.10" #norn/decimal "0.25")) "in code, as literals")
  (testing "what it can't read is a ParseError"
    (is (thrown-with-msg? ParseError #"No reader for the tag #who/knows" (read-string "#who/knows 1")))
    (is (thrown-with-msg? ParseError #"#norn/date \"2026-02-30\"" (read-string "#norn/date \"2026-02-30\"")))
    (is (thrown? ParseError (read-string "#uuid \"nope\"")))))

(deftest edn
  (let [v {:amount price :on day :at launch :clock (t/local-time 9 30) :zoned (t/in-zone launch 3600)}]
    (is (= "#norn/zoned \"2026-11-13T08:05:00+01:00[+01:00]\"" (pr-str (:zoned v))))
    (is (= v (edn/read-string (edn/write-string v))))
    (is (= v (edn/read-string (edn/write-string v :pretty true)))))
  (testing "other tags, by :readers or :default"
    (is (= {:x 1 :y 2} (edn/read-string "#my/point [1 2]" :readers {'my/point (fn [[x y]] {:x x :y y})})))
    (is (= ['who/knows 5] (edn/read-string "#who/knows 5" :default (fn [tag form] [tag form]))))
    (is (thrown? ParseError (edn/read-string "#who/knows 5"))))
  (is (thrown? TypeError (edn/write-string (atom 1))) "a value with no tagged literal still has no EDN form"))

;; A class of one's own: tagged-form says its literal, print-object prints it,
;; and *tag-readers* reads it back.
(defclass Money () ((amount) (currency)))
(defmethod tagged-form ((m Money)) ['my/money [(d/text (:amount m)) (:currency m)]])
(defmethod print-object ((m Money)) (if *print-readably* (tagged-text m) (str (d/text (:amount m)) " " (:currency m))))

(deftest a-class-of-ones-own
  (let [m (Money :amount price :currency "EUR")]
    (is (= "#my/money [\"12.30\" \"EUR\"]" (pr-str m)))
    (is (= "12.30 EUR" (str m)))
    (is (= m (binding [*tag-readers* (assoc *tag-readers* 'my/money (fn [[a c]] (Money :amount (d/parse a) :currency c)))]
               (read-string (pr-str m)))))
    (is (= "{:due #my/money [\"12.30\" \"EUR\"]}" (edn/write-string {:due m})) "and EDN writes it")))

(def ^:private seen (atom []))
(defclass Spy () ())
(defmethod print-object ((s Spy)) (swap! seen conj *print-readably*) "spy")

(deftest print-readably-says-which-printing
  (do (reset! seen [])
      (pr-str (Spy)) (str (Spy)) (with-out-str (prn (Spy)) (print (Spy)))
      (is (= [true false true false] @seen))))

(p/defproperty decimals-and-dates-read-back {:runs 200}
  [cents (p/integers :min -1000000000 :max 1000000000)
   scale (p/elements [0 1 2 4])
   days (p/integers :min 0 :max 2900000)]
  (let [v [(d/decimal cents scale) (t/from-epoch-day days)]]
    (= v (read-string (pr-str v)) (edn/read-string (edn/write-string v)))))
