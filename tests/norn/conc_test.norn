;;;; Concurrency tests: fibers, scopes, channels, atoms (design.md §6).
;;;; Run by crates/norn-vm/tests/norn_suites.rs, or `norn tests/norn/conc_test.norn`.

(ns conc-test)

(def failures 0)
(def checks 0)

(defmacro is [expected expr]
  `(let [e# ~expected a# ~expr]
     (alter-var-root (var checks) inc)
     (when-not (= e# a#)
       (alter-var-root (var failures) inc)
       (println "FAIL:" '~expr "\n  expected:" (pr-str e#) "\n  actual:  " (pr-str a#)))))

;;; fibers
(is 42 (await (spawn-detached (+ 40 2))))
(is 42 @(spawn-detached (* 6 7)))
(is true (fiber? (current-fiber)))
(let [f (spawn-detached :x)]
  (await f)
  (is true (done? f)))
(is {:value 1} (settle (spawn-detached 1)))
(is {:error "boom"} (settle (spawn-detached (error "boom"))))
(is :ok (do (dotimes [_ 5] (yield)) :ok))

;;; sleeping and timeouts
(let [t0 (nano-time)]
  (sleep 20)
  (is true (>= (- (nano-time) t0) 20000000)))

;;; cancellation
(let [f (spawn-detached (take! (chan)))]
  (sleep 5)
  (cancel! f)
  (is {:error "Cancelled"} (settle f)))
(let [f (spawn-detached (loop [] (recur)))]
  (sleep 5)
  (cancel! f)
  (is {:error "Cancelled"} (settle f)))

;; Regression: a cancel arriving while the target is between starting a
;; blocking operation and parking must still wake it (it used to park forever).
(is :survived (do (dotimes [_ 2000]
                    (let [f (spawn-detached (take! (chan)))]
                      (cancel! f)
                      (settle f)))
                  :survived))
(is :survived (do (dotimes [_ 500]
                    (let [inner (atom nil)
                          f (spawn-detached (with-scope [s]
                                              (reset! inner (spawn s (take! (chan))))
                                              (take! (chan))))]
                      (cancel! f)
                      (settle f)
                      (when @inner (settle @inner))))
                  :survived))

;;; structured concurrency
(is 6 (with-scope [s]
        (let [a (spawn s 1) b (spawn s 2) c (spawn s 3)]
          (+ (await a) (await b) (await c)))))
(is :body (with-scope [s] (spawn s (sleep 10)) :body))
;; A failing child cancels its siblings (including one blocked forever),
;; and the scope re-raises the failure.
(let [never (chan)
      blocked (atom nil)
      f (spawn-detached
          (with-scope [s]
            (reset! blocked (spawn s (take! never)))
            (spawn s (error "child failed"))
            :unreachable))]
  (is {:error "child failed"} (settle f))
  (is {:error "Cancelled"} (settle @blocked)))
;; Cancelling the owner cancels the whole tree.
(let [inner (atom nil)
      f (spawn-detached
          (with-scope [s]
            (reset! inner (spawn s (take! (chan))))
            (take! (chan))))]
  (sleep 10)
  (cancel! f)
  (is {:error "Cancelled"} (settle f))
  (is {:error "Cancelled"} (settle @inner)))

;;; channels
(let [c (chan)]
  (spawn-detached (dotimes [i 5] (put! c i)) (close! c))
  (is [0 1 2 3 4] (loop [acc []] (let [v (take! c)] (if (nil? v) acc (recur (conj acc v)))))))
(let [c (chan 3)]
  (is true (put! c 1))
  (is true (offer! c 2))
  (is 1 (take! c))
  (is 2 (poll! c))
  (is nil (poll! c))
  (is false (offer! (chan) 1)))
(let [c (chan 2)]
  (put! c :a)
  (close! c)
  (is true (closed? c))
  (is :a (take! c))
  (is nil (take! c))
  (is false (put! c :b)))
;; A full buffered channel blocks the putter until a take makes room.
(let [c (chan 1) log (atom [])]
  (put! c 1)
  (let [f (spawn-detached (put! c 2) (swap! log conj :put-done))]
    (sleep 10)
    (is [] @log)
    (is 1 (take! c))
    (await f)
    (is [:put-done] @log)
    (is 2 (take! c))))

;;; alts!
(let [c (chan)]
  (is [:none :default] (alts! [c] :default :none)))
(let [c (chan) t (timeout 10)]
  (is t (second (alts! [c t]))))
(let [a (chan) b (chan)]
  (spawn-detached (put! b :from-b))
  (is [:from-b b] (alts! [a b])))
(let [a (chan) b (chan)]
  (let [f (spawn-detached (alts! [[a :to-a] [b :to-b]]))]
    (is :to-b (take! b))
    (is [true b] (await f))
    (is nil (poll! a))))

;;; atoms under contention across carriers
(let [a (atom 0)]
  (with-scope [s]
    (dotimes [_ 200] (spawn s (dotimes [_ 100] (swap! a inc)))))
  (is 20000 @a))
(let [a (atom 1)]
  (is true (compare-and-set! a 1 2))
  (is false (compare-and-set! a 1 3))
  (is 5 (reset! a 5)))

;;; many fibers and ping-pong across carriers
(let [c (chan)]
  (dotimes [_ 10000] (spawn-detached (put! c 1)))
  (is 10000 (loop [n 0 acc 0] (if (< n 10000) (recur (inc n) (+ acc (take! c))) acc))))
(defn ping-pong [pairs rounds]
  (let [total (atom 0)]
    (with-scope [s]
      (dotimes [_ pairs]
        (let [a (chan) b (chan)]
          (spawn s (dotimes [i rounds] (put! a i) (take! b)))
          (spawn s (dotimes [i rounds] (swap! total + (take! a)) (put! b :ok))))))
    @total))
(is (* 1000 (reduce + (range 100))) (ping-pong 1000 100))

;;; data parallelism
(is (map inc (range 1000)) (pmap inc (range 1000)))
(is 499500 (preduce + 0 (range 1000)))

;;; weak references and cleanups. The objects are made, and the GC run, in
;;; separate top-level forms: a register of a live frame can still hold a value
;;; a finished call left there, which keeps it reachable a little longer.
(defn- weak-to-garbage [] (weak-ref (vec (range 100))))
(defn- cleanup-for-garbage [ch] (add-cleanup! (vec (range 100)) (fn [] (put! ch :cleaned))))
(def kept (vec (range 10)))
(def cleaned (chan 1))
(def not-cleaned (chan 1))
(def w (weak-to-garbage))
(def k (weak-ref kept))
(def c (cleanup-for-garbage cleaned))
;; held until its cleanup is cancelled, so no collection can beat the cancel
(def target (vec (range 100)))
(def cancelled (add-cleanup! target (fn [] (put! not-cleaned :cleaned))))
(is true (cancel-cleanup! cancelled))
(def target nil)
(gc)
(is nil (weak-get w))
(is kept (weak-get k))
(is :cleaned (first (alts! [cleaned (timeout 5000)])))
(is nil (first (alts! [not-cleaned (timeout 100)])))
(is false (cancel-cleanup! c))

;;; the reactor: fibers parked on pipes (many pairs at once, to shake out
;;; lost wake-ups between "would block" and parking)
(defn- io-retry [h dir f]
  (loop [] (let [s (%io-seq h dir) r (f)] (if (= r :again) (do (%io-wait h dir s) (recur)) r))))
(defn- send-all [w b]
  (loop [i 0] (when (< i (count b)) (recur (+ i (io-retry w :write (fn [] (%io-write w b i))))))))
(defn- recv-n [r n]
  (loop [got 0 acc []]
    (if (>= got n) acc
      (let [b (io-retry r :read (fn [] (%io-read r (- n got))))]
        (if b (recur (+ got (count b)) (into acc (seq b))) acc)))))
(defn- pipe-pair-echo [rounds]
  (let [ab (%pipe) ba (%pipe)
        echo (spawn-detached (dotimes [_ rounds] (send-all (nth ba 1) (bytes (recv-n (nth ab 0) 4)))))
        sum (loop [i 0 acc 0]
              (if (< i rounds)
                (do (send-all (nth ab 1) (bytes [1 2 3 (mod i 256)]))
                    (recur (inc i) (+ acc (reduce + (recv-n (nth ba 0) 4)))))
                acc))]
    (await echo)
    (doseq [h (concat ab ba)] (%io-close h))
    sum))
(is (* 50 (+ (* 200 6) (reduce + (map (fn [i] (mod i 256)) (range 200)))))
    (reduce + (mapv await (mapv (fn [_] (spawn-detached (pipe-pair-echo 200))) (range 50)))))
(is 0 (:handles (%io-stats)))

;;; (Timing-sensitive checks of the blocking pool and spare carriers run in
;;; their own process: crates/norn/tests/io.rs.)

(println (str "conc_test: " checks " checks, " failures " failures"))
(when (pos? failures) (error failures "concurrency tests failed"))
