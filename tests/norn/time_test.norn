;;;; norn.time: named zones (the system's TZif files and POSIX TZ rules),
;;;; zoned date-times with policies for skipped and repeated wall-clock
;;;; times, and calendar arithmetic.

(ns time-test
  (:require [norn.test :refer [deftest is testing]] [norn.time :as t] [norn.property :as p]))

(def ^:private have-zones? (some? (seq (t/available-zones))))
(when-not have-zones? (println "time_test: no zone files here (set TZDIR); skipping the named-zone tests"))

(defn- at [s] (t/parse s))
(defn- ldt [s] (t/parse-local-date-time s))
(defn- zt [z] (t/format-zoned z))
(defn- message [f] (try (f) nil (catch Error e (condition-message e))))

(deftest named-zones
  (when have-zones?
    (let [ny (t/zone "America/New_York")]
      (is (identical? ny (t/zone "America/New_York")) "read once")
      (is (= {:offset -14400 :dst? true :abbreviation "EDT"} (t/zone-info ny (at "2026-07-01T12:00:00Z"))))
      (is (= {:offset -18000 :dst? false :abbreviation "EST"} (t/zone-info ny (at "2026-12-01T12:00:00Z"))))
      (testing "past the file's transitions, its rule"
        (is (= -14400 (:offset (t/zone-info ny (at "2090-07-01T12:00:00Z")))))
        (is (= -18000 (:offset (t/zone-info ny (at "2090-03-11T06:59:59Z")))))
        (is (= -14400 (:offset (t/zone-info ny (at "2090-03-12T07:00:00Z"))))))
      (testing "the southern hemisphere's summer spans the new year"
        (is (= 39600 (:offset (t/zone-info "Australia/Sydney" (at "2090-01-15T00:00:00Z")))))
        (is (= 36000 (:offset (t/zone-info "Australia/Sydney" (at "2090-07-15T00:00:00Z"))))))
      (is (= 37800 (:offset (t/zone-info "Australia/Lord_Howe" (at "2026-07-01T00:00:00Z")))) "half-hour offsets")
      (is (= "2026-07-01T17:30:00+05:30" (t/format (at "2026-07-01T12:00:00Z") "Asia/Kolkata")))
      (is (= {:hour 14 :offset 7200} (select-keys (t/fields (at "2026-07-01T12:00:00Z") "Europe/Paris") [:hour :offset])))
      (is (some #{"Europe/Paris"} (t/available-zones)))
      (is (re-find #"unknown time zone \"Mars/Olympus\"" (message #(t/zone "Mars/Olympus"))))
      (is (re-find #"not a zone name" (message #(t/zone "../etc/passwd"))))))
  (testing "fixed offsets need no files"
    (is (= "+05:30" (t/zone-name "+05:30")))
    (is (= "UTC" (t/zone-name :utc)))
    (is (= "2026-07-01T13:00:00+01:00[+01:00]" (zt (t/in-zone (at "2026-07-01T12:00:00Z") 3600))))))

(deftest skipped-and-repeated-times
  (when have-zones?
    (let [ny "America/New_York"
          skipped (ldt "2026-03-08T02:30") repeated (ldt "2026-11-01T01:30")]
      (testing "a time the spring change skips"
        (is (= "2026-03-08T03:30:00-04:00[America/New_York]" (zt (t/zoned skipped ny))))
        (is (= "2026-03-08T01:30:00-05:00[America/New_York]" (zt (t/zoned skipped ny :resolve :earlier))))
        (is (= "2026-03-08T03:30:00-04:00[America/New_York]" (zt (t/zoned skipped ny :resolve :later))))
        (is (re-find #"doesn't exist in America/New_York" (message #(t/zoned skipped ny :resolve :reject)))))
      (testing "a time the autumn change repeats"
        (is (= "2026-11-01T01:30:00-04:00[America/New_York]" (zt (t/zoned repeated ny))))
        (is (= "2026-11-01T01:30:00-04:00[America/New_York]" (zt (t/zoned repeated ny :resolve :earlier))))
        (is (= "2026-11-01T01:30:00-05:00[America/New_York]" (zt (t/zoned repeated ny :resolve :later))))
        (is (= "2026-11-01T01:30:00-05:00[America/New_York]" (zt (t/zoned repeated ny :offset -18000))))
        (is (re-find #"happens twice" (message #(t/zoned repeated ny :resolve :reject)))))
      (is (= "2026-07-04T09:00:00-04:00[America/New_York]" (zt (t/zoned (ldt "2026-07-04T09:00") ny :resolve :reject)))
          "an ordinary time needs no policy")
      (is (= "2018-11-04T01:00:00-02:00[America/Sao_Paulo]" (zt (t/start-of-day (t/local-date 2018 11 4) "America/Sao_Paulo")))
          "a day whose midnight was skipped")
      (is (re-find #":resolve is" (message #(t/zoned skipped ny :resolve :nearest)))))))

(deftest zoned-text
  (when have-zones?
    (let [s "2026-03-08T03:30:00-04:00[America/New_York]"]
      (is (= s (zt (t/parse-zoned s))))
      (is (= (at "2026-03-08T07:30:00Z") (t/to-instant (t/parse-zoned s))))
      (is (re-find #"isn't at offset -05:00" (message #(t/parse-zoned "2026-03-08T03:30:00-05:00[America/New_York]"))))))
  (is (= "2026-03-08T03:30:00+02:00[+02:00]" (zt (t/parse-zoned "2026-03-08T03:30:00+02:00"))))
  (is (= "2026-03-08T03:30:00Z" (t/format (t/parse-zoned "2026-03-08T03:30:00Z")))))

(deftest calendar-arithmetic
  (let [d t/local-date fl t/format-local]
    (is (= "2026-02-28" (fl (t/shift (d 2026 1 31) :months 1))) "the month's last day")
    (is (= "2024-02-29" (fl (t/shift (d 2024 1 31) :months 1))))
    (is (= "2025-02-28" (fl (t/shift (d 2024 2 29) :years 1))))
    (is (= "2025-12-31" (fl (t/shift (d 2026 3 31) :months -3))))
    (is (= "2026-03-10" (fl (t/shift (d 2026 2 28) :weeks 1 :days 3))))
    (is (= "2027-01-01T00:15:00" (fl (t/shift (ldt "2026-12-31T23:30") :minutes 45))) "time carries into days")
    (is (= "2026-12-31T23:30:00" (fl (t/shift (ldt "2027-01-01T00:15") :minutes -45))))
    (is (re-find #"no time of day" (message #(t/shift (d 2026 1 1) :hours 1))))
    (is (re-find #"no calendar" (message #(t/shift (t/now) :days 1))))
    (is (= (at "2026-01-01T01:00:00Z") (t/shift (at "2026-01-01T00:00:00Z") :hours 1)))
    (is (= [7 365 1] [(t/weekday (d 2026 11 15)) (t/day-of-year (d 2026 12 31)) (t/weekday (d 2024 1 1))]))
    (is (= [0 1 -1 12] [(t/months-between (d 2026 1 31) (d 2026 2 28)) (t/months-between (d 2026 1 31) (d 2026 3 1))
                        (t/months-between (d 2026 3 1) (d 2026 1 31)) (t/months-between (d 2025 5 5) (d 2026 5 5))]))
    (is (= [366 -1] [(t/days-between (d 2024 1 1) (d 2025 1 1)) (t/days-between (d 1970 1 1) (d 1969 12 31))]))
    (is (= [29 28 31] [(t/days-in-month 2024 2) (t/days-in-month 2100 2) (t/days-in-month 2026 12)]))
    (is (t/before? (d 2026 1 1) (d 2026 1 2)))
    (is (t/after? (ldt "2026-01-01T00:00:01") (ldt "2026-01-01T00:00")))
    (is (= "09:05:00" (fl (t/parse-local-time "09:05"))) "HH:MM"))
  (when have-zones?
    (let [z (t/zoned (ldt "2026-03-07T02:30") "America/New_York")]
      (is (= "2026-03-08T03:30:00-04:00[America/New_York]" (zt (t/shift z :days 1))) "a day keeps the wall clock")
      (is (= "2026-03-08T03:30:00-04:00[America/New_York]" (zt (t/shift z :hours 24))) "24 hours are 24 hours")
      (is (= "2026-11-01T01:30:00-04:00[America/New_York]" (zt (t/shift (t/zoned (ldt "2026-10-31T01:30") "America/New_York") :days 1))))
      (is (= "2026-11-01T01:30:00-05:00[America/New_York]"
             (zt (t/shift (t/zoned (ldt "2026-11-01T00:30") "America/New_York") :hours 2)))
          "an hour along the time line through the repeated one")
      (is (t/before? z (t/shift z :nanos 1))))))

(deftest error-classes
  ;; (they were SimpleErrors and RuntimeErrors): text that isn't a date,
  ;; time or zone is a ParseError; values that don't make one a TypeError
  (let [kind (fn [f] (try (f) nil (catch Error e [(name (class-name (class-of e))) (:source e)])))]
    (testing "text"
      (is (= ["ParseError" "RFC 3339"] (kind #(t/parse "nope"))))
      (is (= ["ParseError" "RFC 3339"] (kind #(t/parse "2026-02-30T00:00:00Z"))) "well formed, but no such day")
      (is (= ["ParseError" "RFC 3339"] (kind #(t/parse-zoned "nope[UTC]"))))
      (is (= ["ParseError" "local date"] (kind #(t/parse-local-date "2026-02-30"))))
      (is (= ["ParseError" "local date"] (kind #(t/parse-local-date "soon"))))
      (is (= ["ParseError" "local time"] (kind #(t/parse-local-time "25:00"))))
      (is (= ["ParseError" "local date"] (kind #(t/parse-local-date-time "2026-02-30T10:00"))))
      (is (= ["ParseError" "time zone"] (kind #(t/zone "../etc/passwd"))))
      (when have-zones?
        (is (= ["ParseError" "time zone"] (kind #(t/zone "Mars/Olympus"))) "an unknown zone")
        (is (= ["ParseError" "time zone"] (kind #(t/fields (t/now) "Mars/Olympus"))))
        (is (= "ParseError" (first (kind #(t/parse-zoned "2026-03-08T03:30:00-05:00[America/New_York]")))))))
    (testing "values"
      (let [c (try (t/local-date 2026 2 30) (catch Error e e))]
        (is (instance? TypeError c))
        (is (= [2026 2 30] (:value c))))
      (is (= "TypeError" (first (kind #(t/local-time 24 0)))))
      (is (= "TypeError" (first (kind #(t/zone :mars)))))
      (is (= "TypeError" (first (kind #(t/from-fields {:year 2026 :month 2 :day 30})))))
      (is (= "TypeError" (first (kind #(t/shift (t/now) :days 1))))))
    (when have-zones?
      (is (= "TypeError" (first (kind #(t/zoned (ldt "2026-03-08T02:30") "America/New_York" :resolve :reject))))
          "a wall-clock time :reject refuses"))))

(p/defproperty epoch-days-round-trip [n (p/integers :min -719528 :max 2932896)]
  (= n (t/epoch-day (t/from-epoch-day n))))

(p/defproperty months-move-and-come-back
  [y (p/integers :min 100 :max 9000) m (p/integers :min 1 :max 12) day (p/integers :min 1 :max 28) k (p/integers :min -500 :max 500)]
  (let [date (t/local-date y m day)] (= date (t/shift (t/shift date :months k) :months (- k)))))

(p/defproperty zoned-times-name-their-instant {:runs 200}
  [secs (p/integers :min -2000000000 :max 4000000000)
   z (p/elements ["America/New_York" "Europe/London" "Australia/Sydney" "Asia/Kolkata" "Pacific/Chatham" "America/Sao_Paulo"])]
  (or (not have-zones?)
      (let [i (t/instant (* secs 1000000000)) zd (t/in-zone i z)]
        (and (= i (t/to-instant (t/zoned (:local zd) z :offset (:offset zd))))
             (= zd (t/parse-zoned (t/format-zoned zd)))))))
