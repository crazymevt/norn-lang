;;;; Core language tests. Run by crates/norn-vm/tests/norn_suites.rs,
;;;; or directly: `norn test tests/norn/core_test.norn`.

(ns core-test
  (:require [norn.test :refer [is]]))

;;; reader & literals
(is (= 3/1 3))
(is (= [1 2 3] '[1 2 3]))
(is (= {:a 1} (hash-map :a 1)))
(is (= #{1 2} (hash-set 2 1)))
(is (= \newline (first "\n")))
(is (= :user/x (keyword "user" "x")))
(is (= 255 0xff))
(is (= 1.5e3 1500.0))
(is (= '(quote x) ''x))
(is (= 6 (#(+ %1 %2 %3) 1 2 3)))
(is (= [1 [2 3]] (#(vector % %&) 1 2 3)))

;;; truthiness: only nil and false are falsey; () is not nil
(is (= :yes (if () :yes :no)))
(is (= :yes (if 0 :yes :no)))
(is (= :no (if nil :yes :no)))
(is (= false (nil? ())))
(is (= nil (seq ())))

;;; numbers
(is (= 10 (+ 1 2 3 4)))
(is (= -5 (- 5)))
(is (= 2.5 (/ 5.0 2)))
(is (= 3 (quot 7 2)))
(is (= 1 (rem 7 2)))
(is (= 2 (mod -7 3)))
(is (= true (< 1 2 3)))
(is (= false (< 1 3 2)))
(is (= true (== 1 1.0)))
(is (= false (= 1 1.0)))
(is (= 2432902008176640000 (reduce * (range 1 21))))

;;; functions, closures, recursion
(defn adder [n] (fn [x] (+ x n)))
(is (= 15 ((adder 10) 5)))
(defn multi ([] :zero) ([a] [:one a]) ([a b & more] [:many a b more]))
(is (= :zero (multi)))
(is (= [:one 1] (multi 1)))
(is (= [:many 1 2 '(3 4)] (multi 1 2 3 4)))
(is (= [:many 1 2 nil] (multi 1 2)))
(defn count-down [n] (if (zero? n) :done (count-down (dec n))))
(is (= :done (count-down 1000000)))
(defn sum-to [n] (loop [i 0 acc 0] (if (> i n) acc (recur (inc i) (+ acc i)))))
(is (= 5050 (sum-to 100)))
(is (= 120 ((fn fact [n] (if (< n 2) 1 (* n (fact (dec n))))) 5)))
(defn nested [] (let [x 1] (fn [] (let [y 2] (fn [] (+ x y))))))
(is (= 3 (((nested)))))
(is (= 4 (apply + 1 [1 2])))
(is (= 7 ((comp inc inc) 5)))
(is (= 8 ((partial + 3) 5)))
(letfn [(ev? [n] (if (zero? n) true (od? (dec n))))
        (od? [n] (if (zero? n) false (ev? (dec n))))]
  (is (= true (ev? 10000))))

;;; collections
(is (= [1 2 3 4] (conj [1 2 3] 4)))
(is (= '(0 1 2) (conj '(1 2) 0)))
(is (= {:a 1 :b 2} (assoc {:a 1} :b 2)))
(is (= {:a 1} (dissoc {:a 1 :b 2} :b)))
(is (= 1 (get [1 2] 0)))
(is (= nil (get {:a 1} :b)))
(is (= 3 (count #{1 2 3})))
(is (= [2 3 4] (map inc [1 2 3])))
(is (= [5 7 9] (map + [1 2 3] [4 5 6])))
(is (= [2 4] (filter even? (range 1 5))))
(is (= 6 (reduce + [1 2 3])))
(is (= 0 (reduce + [])))
(is (= [1 2 3] (into [] (list 1 2 3))))
(is (= '(3 2 1) (reverse [1 2 3])))
(is (= [0 1] (take 2 (range 10))))
(is (= [8 9] (drop 8 (range 10))))
(is (= 9 (last (range 10))))
(is (= [1 2 3 4] (sort [4 2 3 1])))
(is (= ["c" "bb" "aaa"] (sort-by count ["aaa" "c" "bb"])))
;; sorting is stable, takes predicates as comparators, and reports what it can't compare
(is (= [[1 :b] [1 :d] [2 :a] [2 :c]] (sort-by first [[2 :a] [1 :b] [2 :c] [1 :d]])))
(is (= [3 2 1] (sort > [1 3 2])))
(is (= [true true true true false false false false]
       (mapv sequential? [[1] '(1) (range 3) (seq [1 2]) {:a 1} #{1} "s" nil])))
(is (= [[2 :a] [2 :c] [1 :b] [1 :d]] (sort-by first > [[2 :a] [1 :b] [2 :c] [1 :d]])))
(is (= [[2 :a] [2 :c] [1 :b] [1 :d]] (sort-by first (fn [a b] (compare b a)) [[2 :a] [1 :b] [2 :c] [1 :d]])))
(is (= :error (try (sort [1 "a"]) (catch Error _ :error))))
;; characters of long ASCII and non-ASCII strings
(let [s (apply str (repeat 2000 "abc"))
      u (str "é" s)]
  (is (= [\a \c \c] [(nth s 0) (nth s 5) (nth s 5999)]))
  (is (= "cab" (subs s 2 5)))
  (is (= [6001 \é \a "éa"] [(count u) (nth u 0) (nth u 1) (subs u 0 2)])))
(is (= {1 [1 3] 0 [2 4]} (group-by #(rem % 2) [1 2 3 4])))
(is (= {:a 1 :b 2} (zipmap [:a :b] [1 2])))
(is (= {:a {:b 2}} (assoc-in {} [:a :b] 2)))
(is (= 3 (get-in {:a {:b 3}} [:a :b])))
(is (= {:a 2} (update {:a 1} :a inc)))
(is (= {:a 1 :b 3} (merge {:a 1 :b 2} {:b 3})))
(is (= true (contains? #{:x} :x)))
(is (= [1 2 3] (distinct [1 2 1 3 2])))
(is (= [[1 2] [3 4]] (partition 2 [1 2 3 4 5])))
(is (= true (every? odd? [1 3 5])))
(is (= 2 (some #(when (even? %) %) [1 2 3])))

;;; persistence: old versions are unchanged
(let [v (vec (range 100))
      w (assoc v 50 :x)]
  (is (= 50 (nth v 50)))
  (is (= :x (nth w 50))))
(let [big (reduce conj [] (range 5000))]
  (is (= 4999 (peek big)))
  (is (= 4998 (peek (pop big))))
  (is (= 12497500 (reduce + big))))
(let [m (reduce #(assoc %1 %2 (* %2 %2)) {} (range 2000))]
  (is (= 2000 (count m)))
  (is (= 1521 (get m 39)))
  (is (= 1999 (count (dissoc m 7)))))

;;; structural equality across sequential types
(is (= true (= [1 2 3] '(1 2 3) (range 1 4) (rest [0 1 2 3]))))
(is (= true (= {:a [1 2]} {:a '(1 2)})))
(is (= true (= (hash [1 2]) (hash '(1 2)))))

;;; macros
(is (= 3 (cond false 1 nil 2 :else 3)))
(is (= nil (and 1 nil 2)))
(is (= 2 (or nil false 2)))
(is (= 13 (-> 5 (+ 1) (* 2) inc)))
(is (= [1 3] (->> [1 2 3] (filter odd?) (map inc) (map dec) (take 2))))
(is (= 10 (when-let [x 5] (* 2 x))))
(is (= :else (if-let [x nil] x :else)))
(is (= 3 (when-let [[a b] [1 2]] (+ a b))))
(is (= 5 (when-let [{:keys [x]} {:x 5}] x)))
(is (= :no (if-let [[a] nil] a :no)))
(is (= '(if a (do b)) (macroexpand-1 '(when a b))))

;;; destructuring
(is (= [1 2 '(3 4) [1 2 3 4]] (let [[a b & more :as all] [1 2 3 4]] [a b more all])))
(is (= [1 nil] (let [[a b] [1]] [a b])))
(is (= [1 9 {:x 1}] (let [{:keys [x y] :or {y 9} :as m} {:x 1}] [x y m])))
(is (= [1 3] (let [{a :a {:keys [c]} :b} {:a 1 :b {:c 3}}] [a c])))
(is (= ["v" 'w] (let [{:strs [s] :syms [t]} {"s" "v" 't 'w}] [s t])))
(defn dsum [[x y] {:keys [z]}] (+ x y z))
(is (= 6 (dsum [1 2] {:z 3})))
(defn kw-args [a & {:keys [k] :or {k 5}}] [a k])
(is (= [[1 5] [1 2]] [(kw-args 1) (kw-args 1 :k 2)]))
(is (= 6 (loop [[x & xs] [1 2 3] acc 0] (if x (recur xs (+ acc x)) acc))))
(is (= [2 12] (map (fn [[a b]] (* a b)) [[1 2] [3 4]])))
(is (= [[:a 1]] (let [r (atom [])] (doseq [[k v] {:a 1}] (swap! r conj [k v])) @r)))
(is (= [[1 :a] [1 :b] [3 :a] [3 :b]]
       (let [r (atom [])] (doseq [x [1 2 3] :when (odd? x) y [:a :b]] (swap! r conj [x y])) @r))
    "doseq nests bindings and skips with :when, as for")
(is (= [2 4] (let [r (atom [])] (doseq [x [1 2] :let [y (* 2 x)]] (swap! r conj y)) @r)))
(is (nil? (doseq [x [1]] x)))
(is (= 0 (get-in {:a {:b nil}} [:a :c] 0)) "get-in's default, when a key is missing")
(is (nil? (get-in {:a {:b nil}} [:a :b] 0)) "but not when the value is nil")
(is (= 1 (get-in {:a [5 1]} [:a 1] 0)))
(is (= :x (get-in nil [:a] :x)))
(is (= [[1 [2 [3]] 4] 1 [2 [3]] 2 [3] 3 4] (vec (tree-seq vector? seq [1 [2 [3]] 4]))) "tree-seq: depth first")
(is (= [:a :b :c] (mapv :id (tree-seq :kids :kids {:id :a :kids [{:id :b} {:id :c}]}))))
(defmacro swap-pair [[a b]] (list 'list b a))
(is (= '(2 1) (swap-pair [1 2])))
(is (= [1 [2 3]] ((fn [a & [b c]] [a [b c]]) 1 2 3)))

;;; ---- the numeric tower (design §3.4) ----
(def fix-max 4611686018427387903)
(is (= 4611686018427387904 (+ fix-max 1)))
(is (= 4611686018427387904 (inc fix-max)))
(is (= -4611686018427387905 (- (- fix-max) 2)))
(is (= 9223372036854775806 (* fix-max 2)))
(is (= fix-max (dec (inc fix-max))))
(is (= true (integer? (inc fix-max))))
(is (= Integer (class-of (inc fix-max))))
(is (= 620448401733239439360000 (reduce * (range 1 25))))
;; overflow inside a loop: tier 1 bails to the interpreter, which promotes
(is (= 1180591620717411303424 (loop [i 0 x 1] (if (< i 70) (recur (inc i) (+ x x)) x))))
(is (= 1267650600228229401496703205376 (bit-shift-left 1 100)))
(is (= 33333333333333333333 (quot 100000000000000000000 3)))
(is (= 1 (rem 100000000000000000000 3)))
(is (= 2 (mod -7 3)))
(is (= 123456789012345678901234567890 (read-string "123456789012345678901234567890")))
(is (= 255 (bit-and 340282366920938463463374607431768211455 255)))
(is (= true (= (hash 100000000000000000000) (hash (* 10000000000 10000000000)))))
(is (= 3 (- 100000000000000000003 100000000000000000000)))
(is (= Integer (class-of (- 100000000000000000003 100000000000000000000))))
;; ratios
(is (= 1/2 (/ 1 2)))
(is (= 2 (/ 6 3)))
(is (= 3/2 (/ 6 4)))
(is (= 5/6 (+ 1/2 1/3)))
(is (= 1 (* 2/3 3/2)))
(is (= Ratio (class-of 3/4)))
(is (= [3 4] [(numerator 6/8) (denominator 6/8)]))
(is (= true (= 1/2 2/4)))
(is (= -5/7 (read-string (pr-str -5/7))))
(is (= 3 (int 7/2)))
(is (= true (< 1/3 1/2 1)))
(is (= :error (try (/ 1 0) (catch Error e :error))))
(is (= :error (try (/ 1/2 0) (catch Error e :error))))
;; categories stay apart under =; == compares across them
(is (= false (= 1 1.0)))
(is (= false (= 1/2 0.5)))
(is (= true (== 1/2 0.5)))
(is (= true (== 4611686018427387904 4.611686018427387904e18)))
;; a float against an exact number compares by the float's exact value,
;; so the order stays transitive past 2^53
(let [a 9007199254740992 b 9007199254740993 f 9007199254740992.0]
  (is (= [0 1 -1] [(compare a f) (compare b f) (compare a b)]))
  (is (= false (== b f)))
  (is (= [a b] (filterv integer? (sort [b f a]))) "sorted, whatever the input order")
  (is (= [a b] (filterv integer? (sort [f b a]))))
  (is (= false (contains? (sorted-set a f) b)) "a sorted set doesn't find b through the float"))
(is (= [1 0] [(compare 1/3 0.3333333333333333) (compare 1/2 0.5)]))
(is (= [-1 1] [(compare 10 ##Inf) (compare 10 ##-Inf)]))
(let [big (* 3 (bit-shift-left 1 70))]
  (is (= [0 1] [(compare big (double big)) (compare (inc big) (double big))])))
;; = is an equivalence (NaN = NaN); == is IEEE
(is (= true (= ##NaN ##NaN)))
(is (= false (== ##NaN ##NaN)))
(is (= true (contains? #{##NaN} ##NaN)))
(is (= [-1 1/2 2.5 3 100000000000000000000 ##NaN] (sort [3 ##NaN 1/2 2.5 100000000000000000000 -1])))
(is (= 1000000000000000019884624838656 (int 1e30)))
(is (= 0.5 (float 1/2)))

;;; ---- sequences (design §3.3) ----
;; eager and type-preserving
(is (= [2 3] (map inc [1 2])))
(is (= '(2 3) (map inc '(1 2))))
(is (= true (list? (map inc '(1 2)))))
(is (= #{2 3} (map inc #{1 2})))
(is (= '(1 3) (filter odd? '(1 2 3))))
(is (= {:a 1} (filter (fn [e] (odd? (second e))) {:a 1 :b 2})))
(is (= {:b 2} (remove (fn [e] (odd? (second e))) {:a 1 :b 2})))
(is (= [:a] (map first {:a 1})))
(is (= [2] (keep (fn [e] (when (= :a (first e)) 2)) {:a 1 :b 2})))
(is (= [1 2 3] (map inc (range 3))))
(is (= [98 99] (map inc (map int "ab"))))
(is (= '(1 2) (take 2 '(1 2 3))))
(is (= '(3) (drop 2 '(1 2 3))))
(is (= [1 2] (take-while (fn [x] (< x 3)) [1 2 3 1])))
(is (= '(1 3) (distinct '(1 3 1))))
(is (= [1 2 1] (dedupe [1 1 2 2 1])))
(is (= [1 :x 2 :x 3] (interpose :x [1 2 3])))
(is (= [[1 2] [3 4] [5]] (partition-all 2 [1 2 3 4 5])))
(is (= [[1 2] [3 4]] (partition 2 [1 2 3 4 5])))
(is (= [1 :a 2 :b] (interleave [1 2 3] [:a :b])))
(is (= [5 7 9] (map + [1 2 3] [4 5 6])))
(is (= [1 2 3 4] (concat [1 2] '(3) [4])))
(is (= [3 6] (mapv (fn [x] (* 3 x)) '(1 2))))
(is (= [1 3] (filterv odd? #{1 2 3})))
;; streams
(def forced (atom 0))
(def s1 (lazy-seq (swap! forced inc) [1 2 3]))
(is (= [false 0] [(realized? s1) @forced]))
(is (= 1 (first s1)))
(is (= 1 (first s1)))
(is (= [true 1] [(realized? s1) @forced]))
;; A lazy stream realized inside a run from Rust (here, a macro run by
;; macroexpand-1): realized there, with the primitive called again, not
;; handed to the fiber's interpreter, which would run the whole macro again,
;; a new stream each time, for ever (M9 part 9.2).
(defmacro pairs-with-indexes [& xs] (vec (map vector xs (range))))
(is (= [[:a 0] [:b 1]] (macroexpand-1 '(pairs-with-indexes :a :b))))
(is (= [0 1 2 3 4] (vec (take 5 (range)))))
(is (= 100 (nth (iterate inc 0) 100)))
(is (= [10 11 12] (vec (take 3 (iterate inc 10)))))
(is (= [:a :b :a :b :a] (vec (take 5 (cycle [:a :b])))))
(is (= [:x :x :x] (vec (take 3 (repeat :x)))))
(is (= [:y :y] (repeat 2 :y)))
(is (= 6 (first (filter even? (drop 5 (range))))))
(is (= true (stream? (map inc (lazy [1 2])))))
(is (= [2 3] (vec (map inc (lazy [1 2])))))
(is (= [0 1 2] (vec (take-while (fn [x] (< x 3)) (range)))))
(is (= [1 2 3] (vec (concat [1] (lazy [2]) [3]))))
(is (= [1 2 3] (vec (take 3 (distinct (cycle [1 2 1 3]))))))
(is (= [[0 :a] [1 :b]] (vec (map-indexed vector (lazy [:a :b])))))
(is (= [0 1 0 1 2] (vec (take 5 (mapcat range (iterate inc 2))))))
(is (= true (= (lazy [1 2]) [1 2])))
(is (= true (= (hash (lazy [1 2])) (hash [1 2]))))
(is (= 3 (count (lazy [1 2 3]))))
(is (= "(0 1 2)" (pr-str (take 3 (range)))))
(is (= [1 2] (into [] (lazy [1 2]))))
(is (= 999 (last (take 1000 (range)))))
(is (= [:a 1] (vec (cons :a (lazy [1])))))
;; comp, right to left (three or more functions too)
(is (= 12 ((comp inc inc (fn [x] (* 2 x))) 5)))
(is (= 23 ((comp inc (fn [x] (* 2 x)) inc inc) 9)))
;; transducers
(is (= [2 4 6] (into [] (comp (filter odd?) (map inc) (take 3)) (range 100))))
(is (= 9 (transduce (map inc) + 0 [1 2 3])))
(is (= 6 (transduce (map inc) + [0 1 2])))
(is (= #{2 3} (into #{} (map inc) [1 2])))
(is (= [1 1 2 2] (sequence (mapcat (fn [x] [x x])) [1 2])))
(is (= [[1 2] [3]] (into [] (partition-all 2) [1 2 3])))
(is (= [1 2 3] (into [] cat [[1] [2 3]])))
;; an early end inside one group stops the outer reduction too
(let [visited (atom 0)]
  (is (= [1] (into [] (comp (map (fn [g] (swap! visited inc) g)) cat (take 1)) [[1 2] [3] [4] [5]])))
  (is (= 1 @visited)))
(is (= [0 0] (into [] (comp (mapcat (fn [x] [x x])) (take 2)) (range))) "mapcat stops on an infinite input")
(is (= [1 :s 2] (into [] (interpose :s) [1 2])))
(is (= [3 4] (into [] (drop-while (fn [x] (< x 3))) [1 2 3 4])))
(is (= [[0 :a]] (into [] (map-indexed vector) [:a])))
(is (= 6 (reduce (fn [a x] (if (> x 3) (reduced a) (+ a x))) 0 (range))))
(is (= 3 (reduce (fn [a x] (if (= x 3) (reduced x) a)) 0 [1 2 3 4])))
(is (= [1 2] (into [] (take 2) (iterate inc 1))))

;;; sorted maps and sets, queues, transients
(defmacro errs [expr] `(try ~expr :no-error (~'catch Error e# :error)))
(def sm (sorted-map 3 :c 1 :a 2 :b))
(is (= [[1 :a] [2 :b] [3 :c]] (vec (seq sm))))
(is (= [1 2 3] (vec (keys sm))))
(is (= [:a :b :c] (vec (vals sm))))
(is (= :b (get sm 2)))
(is (= nil (get sm 9)))
(is (= :z (get sm 9 :z)))
(is (= 3 (count sm)))
(is (= true (contains? sm 1)))
(is (= [1 3] (vec (keys (dissoc sm 2)))))
(is (= [0 1 2 3] (vec (keys (assoc sm 0 :zero)))))
(is (= {1 :a, 2 :b, 3 :c} sm))
(is (= (hash {1 :a, 2 :b, 3 :c}) (hash sm)))
(is (= true (map? sm)))
(is (= true (sorted? sm)))
(is (= false (sorted? {1 2})))
(is (= [[2 :b] [3 :c]] (vec (subseq sm >= 2))))
(is (= [[1 :a]] (vec (subseq sm < 2))))
(is (= [[3 :c] [2 :b]] (vec (rsubseq sm > 1))))
(is (= true (sorted? (filter (fn [[k _]] (odd? k)) sm))))
(is (= [1 3] (vec (keys (filter (fn [[k _]] (odd? k)) sm)))))
(def ss (sorted-set "pear" "apple" "fig"))
(is (= ["apple" "fig" "pear"] (vec ss)))
(is (= #{"apple" "fig" "pear"} ss))
(is (= true (set? ss)))
(is (= ["apple" "kiwi"] (vec (disj (conj ss "kiwi") "fig" "pear"))))
(is (= :error (errs (assoc (sorted-map 1 :a) :k 2))))
(is (= (vec (range 100)) (vec (apply sorted-set (concat (range 99 -1 -2) (range 0 100 2))))))
(is (= 50 (count (reduce dissoc (into (sorted-map) (map (fn [i] [i i])) (range 100)) (range 0 100 2)))))
(def q (queue 1 2 3))
(is (= 1 (peek q)))
(is (= [2 3] (vec (pop q))))
(is (= [1 2 3 4] (vec (conj q 4))))
(is (= 3 (count q)))
(is (= true (queue? q)))
(is (= nil (peek (queue))))
(is (= [3 4 5] (vec (-> q pop pop (conj 4) (conj 5)))))
(is (= (queue 1 2 3) q))
(is (= [2 3 4] (into [] (map inc) q)))
(is (= [0 1 2 3 4] (persistent! (reduce conj! (transient []) (range 5)))))
(is (= [0 1 2] (persistent! (pop! (conj! (transient [0 1 2]) 3)))))
(is (= {:a 1, :b 2} (persistent! (assoc! (assoc! (transient {}) :a 1) :b 2))))
(is (= {:b 2} (persistent! (dissoc! (transient {:a 1 :b 2}) :a))))
(is (= #{2} (persistent! (disj! (conj! (conj! (transient #{}) 1) 2) 1))))
(is (= 3 (count (conj! (conj! (transient [1]) 2) 3))))
(is (= :error (errs (let [t (transient [])] (persistent! t) (conj! t 1)))))
(is (= :error (errs (let [t (transient [])] (await (spawn (conj! t 1)))))))
(is (= (vec (range 1000)) (persistent! (reduce conj! (transient []) (range 1000)))))
;; a transient reads as Clojure's does: get, nth, contains? and count agree
(let [tm (assoc! (transient {:a 1}) :b nil) tv (conj! (transient [1 2]) 3) ts (conj! (transient #{}) :x)
      tsm (assoc! (transient (sorted-map)) 2 :two)]
  (is (= [1 nil :none true false 2] [(get tm :a) (get tm :b) (get tm :c :none) (contains? tm :b) (contains? tm :c) (count tm)]))
  (is (= [3 3 :none true false nil] [(nth tv 2) (get tv 2) (nth tv 5 :none) (contains? tv 2) (contains? tv 3) (get tv 3)]))
  (is (= :error (errs (nth tv 3))))
  (is (= [:x nil true] [(get ts :x) (get ts :y) (contains? ts :x)]))
  (is (= [:two true] [(get tsm 2) (contains? tsm 2)])))
(is (= :error (errs (let [t (transient {:a 1})] (persistent! t) (get t :a)))) "not after persistent!")
;; a queue has its own class, and is sequential, as = treats it
(is (= [Queue true true true] [(class-of (queue 1)) (sequential? (queue 1)) (= (queue 1 2) [1 2]) (instance? Sequential (queue))]))
;; a sorted set keeps the first of values compare finds equal, as Clojure's does
(is (= [1 1.0] [(first (sorted-set 1 1.0)) (first (sorted-set 1.0 1))]))
(is (= {1 :b} (assoc (sorted-map 1 :a) 1.0 :b)))
(is (integer? (first (keys (assoc (sorted-map 1 :a) 1.0 :b)))) "the key already there stays")
(is (= 1 (get (sorted-set 1) 1.0)) "get gives the member, not the probe")
;; (- x) negates, so a float zero gets its sign
(is (= "-0.0" (pr-str (- 0.0))))
(is (= ["0.0" -2.5 -3 3] [(pr-str (- -0.0)) (- 2.5) (- 3) (- -3)]))

;;; watches and evaluation hooks
(let [a (atom 0)
      log (atom [])]
  (add-watch a :w (fn [k r o n] (swap! log conj [k (identical? r a) o n])))
  (swap! a inc)
  (reset! a 10)
  (swap-vals! a inc)
  (reset-vals! a 20)
  (add-watch a :w (fn [k r o n] (swap! log conj :replaced)))
  (swap! a inc)
  (remove-watch a :w)
  (swap! a inc)
  (compare-and-set! a 22 23)
  (is (= [[:w true 0 1] [:w true 1 10] [:w true 10 11] [:w true 11 20] :replaced] @log))
  (is (= 23 @a)))
(is (= 5 (reset! (atom 0) 5)))
(let [ran (atom 0)]
  (add-after-eval-hook! ::t (fn [] (swap! ran inc)))
  (%run-after-eval-hooks)
  (remove-after-eval-hook! ::t)
  (%run-after-eval-hooks)
  (is (= 1 @ran)))

;;; for
(is (= [[1 :a] [1 :b] [3 :a] [3 :b]] (for [x [1 2 3] :when (odd? x) y [:a :b]] [x y])))
(is (= [2 4 6] (for [x (range 1 4) :let [y (* 2 x)]] y)))
(is (= [[:a 1] [:b 2]] (for [[k v] (sorted-map :a 1 :b 2)] [k v])))
(is (= [] (for [x []] x)))

;;; structural operations on deep values: printing, equality, hashing and
;;; compare use stacks of their own, so depth past what the reader allows
;;; (values built in code) can't exhaust the native stack
(let [depth 100000
      nest (fn [wrap leaf] (reduce (fn [acc _] (wrap acc)) leaf (range depth)))
      a (nest vector 1) b (nest vector 1) c (nest vector 2)
      l (nest list 1) m (nest (fn [x] {:k x}) 1)]
  (is (= (+ 1 (* 2 depth)) (count (pr-str a))))
  (is (= true (= a b)))
  (is (= false (= a c)))
  (is (= (hash a) (hash b)))
  (is (= [0 -1] [(compare a b) (compare a c)]))
  (is (= true (= l (nest list 1))))
  (is (= (hash m) (hash (nest (fn [x] {:k x}) 1))))
  (is (= (* 5 depth) (dec (count (pr-str m))))))
