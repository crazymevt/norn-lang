;;;; Property-based testing (norn.property), and round trips through the
;;;; data codecs as properties.

(ns property-test
  (:require [norn.test :refer [deftest is]] [norn.property :as p]
            [norn.json :as json] [norn.edn :as edn] [norn.bin :as bin] [norn.cbor :as cbor]
            [norn.ndjson :as ndjson] [norn.yaml :as yaml] [norn.decimal :as d]
            [norn.buffer :as buf] [norn.bytes :as b]))

(deftest checking-and-shrinking
  (is (= {:pass? true :runs 100} (select-keys (p/check (p/for-all [v (p/vectors (p/integers))] (= v (reverse (reverse v)))))
                                              [:pass? :runs])))
  (let [r (p/check (p/for-all [v (p/vectors (p/integers))] (< (reduce + 0 v) 100)) :seed 42)]
    (is (false? (:pass? r)))
    (is (= {:v [100]} (:args r)) "shrunk to the simplest failing case")
    (is (= r (p/check (p/for-all [v (p/vectors (p/integers))] (< (reduce + 0 v) 100)) :seed 42)) "a seed reproduces it"))
  (let [r (p/check (p/for-all [x (p/integers)] (if (> x 10) (/ 1 0) true)) :seed 7)]
    (is (= {:x 11} (:args r)))
    (is (some? (:error (:failure r))) "a condition counts as a failure"))
  (is (:pass? (p/check (p/for-all [n (p/naturals) v (p/vectors (p/integers) :max n)] (<= (count v) n))))
      "a later generator can use an earlier value")
  (is (= {:s "x"} (:args (p/check (p/for-all [s (p/strings)] (not (re-find #"[xyz]" s))) :seed 3)))))

(deftest generators
  (is (every? #(<= 3 % 9) (map #(p/generate (p/integers :min 3 :max 9) 30 %) (range 50))))
  (is (every? #(<= 2 (count %) 4) (map #(p/generate (p/vectors (p/booleans) :min 2 :max 4) 30 %) (range 50))))
  (is (every? #{:a :b} (map #(p/generate (p/elements [:a :b]) 30 %) (range 20))))
  (is (every? even? (map #(p/generate (p/such-that even? (p/integers)) 30 %) (range 20))))
  (is (every? string? (map #(p/generate (p/strings :unicode true) 30 %) (range 20))))
  (is (= (p/generate (p/maps (p/keyword) (p/floats)) 20 5) (p/generate (p/maps (p/keyword) (p/floats)) 20 5))
      "a seed gives the same value"))

;;; ---- round trips through the codecs ----

(def ^:private json-scalar
  (p/one-of (p/constant nil) (p/booleans) (p/integers) (p/floats) (p/strings :unicode true)))

(def ^:private json-value
  (p/recursive (fn [inner] (p/one-of (p/vectors inner :max 4) (p/maps (p/strings) inner :max 4))) json-scalar))

(def ^:private norn-value
  (p/recursive (fn [inner] (p/one-of (p/vectors inner :max 4) (p/lists inner :max 4) (p/sets inner :max 4)
                                     (p/maps inner inner :max 4)))
               (p/one-of (p/constant nil) (p/booleans) (p/integers) (p/floats) (p/strings :unicode true)
                         (p/keyword) (p/symbol) (p/chars :unicode true))))

(p/defproperty json-round-trips [x json-value]
  (= x (json/read-string (json/write-string x) :keywords false)))

(p/defproperty ndjson-round-trips [xs (p/vectors json-value :max 5)]
  (= xs (ndjson/read-string (ndjson/write-string xs) :keywords false)))

(p/defproperty edn-round-trips [x norn-value]
  (= x (edn/read-string (pr-str x))))

(p/defproperty bin-round-trips [x norn-value]
  (= x (bin/decode (bin/encode x))))

(p/defproperty cbor-round-trips
  [x (p/recursive (fn [inner] (p/one-of (p/vectors inner :max 4) (p/maps (p/one-of (p/integers) (p/strings)) inner :max 4)))
                  (p/one-of (p/constant nil) (p/booleans) (p/integers :min (- (bit-shift-left 1 70)) :max (bit-shift-left 1 70))
                            (p/floats) (p/strings :unicode true) (p/byte-strings)))]
  (= x (cbor/decode (cbor/encode x))))

(p/defproperty yaml-round-trips [x json-value]
  (= x (yaml/read-string (yaml/write-string x))))

(p/defproperty decimal-text-round-trips [c (p/integers) scale (p/integers :min -20 :max 20)]
  (let [x (d/decimal c scale)] (= x (d/parse (d/text x)))))

(p/defproperty packed-buffers-round-trip [vs (p/vectors (p/integers :min (- (bit-shift-left 1 31)) :max (dec (bit-shift-left 1 31))))]
  (= vs (buf/values (buf/pack :i32 vs))))

(p/defproperty hex-and-base64-round-trip [bs (p/byte-strings)]
  (and (= bs (b/unhex (b/hex bs))) (= bs (b/unbase64 (b/base64 bs)))))
