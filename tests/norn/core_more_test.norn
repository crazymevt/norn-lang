;;;; Clojure core functions added in M7.6.

(ns core-more-test
  (:require [norn.test :refer [is are deftest]]))

(deftest control-macros
  (are [x out] (= out (case x 1 :one (2 3) :few :many))
    1 :one 2 :few 3 :few 9 :many)
  (is (= :sym (case 'a a :sym :other)))
  (is (= :error (try (case 5 1 :one) (catch Error _ :error))))
  (is (= :b (condp = 2 1 :a 2 :b :c)))
  (is (= :c (condp = 9 1 :a 2 :b :c)))
  (is (= 6 (cond-> 1 true inc false (* 100) true (* 3))))
  (is (= [3 1] (cond->> [1] true (cons 3) false (cons 9) true vec)))
  (is (nil? (some-> {:a nil} :a inc)))
  (is (= 2 (some-> {:a 1} :a inc)))
  (is (= 3 (some->> [1 2] (map inc) last)))
  (is (= 12 (as-> 5 x (+ x 1) (* x 2))))
  (is (= false (when-some [x false] x)))
  (is (= :none (if-some [x nil] x :none)))
  (is (= 1 (when-first [x [1 2]] x)))
  (is (nil? (when-first [x []] x))))

(deftest sequences
  (is (= [3 4] (take-last 2 [1 2 3 4])))
  (is (nil? (take-last 2 [])))
  (is (= [1 2 3] (drop-last [1 2 3 4])))
  (is (= [[1 2] [3 4]] (split-at 2 [1 2 3 4])))
  (is (= [[1 2] [3 1]] (split-with (fn [x] (< x 3)) [1 2 3 1])))
  (is (= [[1 1] [2] [1]] (partition-by identity [1 1 2 1])))
  (is (= [1 2 3 4] (flatten [1 [2 [3 (list 4)]]])))
  (is (= [:b] (keep-indexed (fn [i x] (when (odd? i) x)) [:a :b])))
  (is (not-every? odd? [1 2]))
  (is (= [3 2 1] (rseq [1 2 3])))
  (is (= [2 3] (subvec [1 2 3 4] 1 3)))
  (is (= [2 3 4] (subvec [1 2 3 4] 1)))
  (is (= "ccc" (max-key count "a" "ccc" "bb")))
  (is (= "a" (min-key count "a" "ccc" "bb")))
  (is ((some-fn even? neg?) 1 3 -1))
  (is (not ((every-pred odd? pos?) 1 -3)))
  (is (= [0 1 3 6] (reductions + 0 [1 2 3])))
  (is (= [1 3 6] (reductions + [1 2 3])))
  (is (= [2 3] (eduction (map inc) [1 2])))
  (is (= [3 4] (nthrest [1 2 3 4] 2)))
  (is (= 2 (fnext [1 2 3])))
  (is (= '(1 2 3 4) (list* 1 2 [3 4]))))

(deftest sequence-functions-on-streams-give-streams
  ;; (each of these used to read its whole input, so hung on (range))
  (is (= [[0 1] [2 3]] (take 2 (partition 2 (range)))))
  (is (= [[0 1] [2 3]] (take 2 (partition-all 2 (range)))))
  (is (= [[0 1 2] [3 4 5]] (take 2 (partition-by (fn [x] (quot x 3)) (range)))))
  (is (= [0 :s 1 :s] (take 4 (interpose :s (range)))))
  (is (= [0 1 2] (take 3 (dedupe (map (fn [x] (quot x 2)) (range))))))
  (is (= [0 :a 1 :b] (take 4 (interleave (range) [:a :b]))))
  (is (= [0 :a 1 :b] (vec (interleave (range) [:a :b]))) "until one runs out")
  (is (= [0 1 3 6] (take 4 (reductions + (range)))))
  (is (= [10 10 11] (take 3 (reductions + 10 (range)))))
  (is (= [0 0 1 1] (take 4 (flatten (map (fn [x] [x [x]]) (range))))))
  (is (every? stream? [(partition 2 (range)) (partition-all 2 (range)) (partition-by odd? (range)) (interpose 0 (range))
                       (dedupe (range)) (interleave (range) (range)) (reductions + (range)) (flatten (range))]))
  (let [seen (atom [])]
    (first (partition-all 2 (map (fn [x] (swap! seen conj x) x) (range))))
    (is (= [0 1] @seen) "reading no more than the group it gives"))
  (are [x y] (= x y)
    [[1 2] [3 4]] (vec (partition 2 (lazy [1 2 3 4 5])))
    [[1 2] [3]] (vec (partition-all 2 (lazy [1 2 3])))
    [[1 3] [2 4] [5]] (vec (partition-by odd? (lazy [1 3 2 4 5])))
    [1 0 2 0 3] (vec (interpose 0 (lazy [1 2 3])))
    [1 2 1] (vec (dedupe (lazy [1 1 2 2 1])))
    [1 3 6] (vec (reductions + (lazy [1 2 3])))
    [1 2 3 4] (vec (flatten (lazy [1 [2 [3]] (lazy [4])])))
    [] (vec (partition-all 2 (lazy [])))
    [0] (vec (reductions + 0 (lazy [])))))

(deftest sequence-functions-on-collections-are-as-they-were
  (are [x y] (= x y)
    [[1 2] [3 4]] (partition 2 [1 2 3 4 5])
    [[1 2] [3]] (partition-all 2 [1 2 3])
    '([1 3] [2 4] [5]) (partition-by odd? [1 3 2 4 5])
    [1 0 2 0 3] (interpose 0 [1 2 3])
    [1 2 1] (dedupe [1 1 2 2 1])
    [1 :a 2 :b] (interleave [1 2] [:a :b :c])
    '(1 3 6) (reductions + [1 2 3])
    '(1 2 3) (flatten [1 [2 [3]]])
    [] (interleave))
  (is (vector? (partition 2 [1 2])))
  (is (not (stream? (interleave [1] [2])))))

(deftest maps-and-the-rest
  (is (= {:a 3 :b 2} (merge-with + {:a 1} {:a 2 :b 2})))
  (is (= {"a" 1} (update-keys {:a 1} name)))
  (is (= {:a 2} (update-vals {:a 1} inc)))
  (is (= [:a 1] (find {:a 1} :a)))
  (is (nil? (find {:a 1} :b)))
  (is (= [:a 1] [(key [:a 1]) (val [:a 1])]))
  (is (= :done (trampoline (fn f [n] (if (zero? n) :done (fn [] (f (dec n))))) 1000)))
  (are [f x] (f x) ident? :k int? 3 pos-int? 1 nat-int? 0 neg-int? -1 double? 1.5 any? nil NaN? ##NaN infinite? ##-Inf)
  (is (not (NaN? 1.0)))
  (is (= "1 \"a\"\n" (prn-str 1 "a")))
  (is (= "1 a" (print-str 1 "a")))
  (let [v (volatile! 1)] (vswap! v inc) (is (= 2 @v)) (vreset! v 9) (is (= 9 @v)))
  (let [seen (atom [])] (run! (fn [x] (swap! seen conj x)) [1 2]) (is (= [1 2] @seen)))
  (is (nil? (dorun (map inc [1 2]))))
  (is (= [true false false] (mapv boolean [0 nil false])))
  (is (= [3 2.0 1] [(long 3.7) (double 2) (num 1)]))
  (is (every? ifn? [inc :k {} #{} []]))
  (is (distinct? 1 2 3))
  (is (not (distinct? 1 2 1))))
