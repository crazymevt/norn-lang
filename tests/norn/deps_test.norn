;;;; Projects and packages (M8 part 8.10): norn.edn, path and Git packages,
;;;; norn.lock, two versions of one package, and overrides. Everything is in
;;;; a temporary folder: the packages, a Git repository, and the fetch cache.

(ns deps-test
  (:require [norn.test :refer [is deftest testing]] [norn.io :as io] [norn.sys :as sys]
            [norn.string :as str] [norn.process :as process] [norn.deps :as deps]))

(def dir (io/path (sys/temp-dir) (str "norn-deps-test-" (sys/pid) "-" (nano-time))))

(defn- file! [path text]
  (io/mkdirs! (io/parent (io/path dir path)))
  (io/write-text (io/path dir path) text))

(defn- git! [repo & args]
  (let [r (apply process/sh "git" "-C" (io/path dir repo) "-c" "user.name=Test" "-c" "user.email=test@example.com" args)]
    (when-not (= 0 (:exit r)) (error (str "git " (str/join " " args) ": " (:err r))))
    (str/trim (:out r))))

(defn- message [f] (try (f) nil (catch Error e (condition-message e))))

(defn- resolved [project & opts]
  (binding [deps/*deps-root* (io/path dir "fetched")]
    (apply deps/resolve-project (io/path dir project) opts)))

(defn- summary [r] (mapv (juxt :name :version) (:packages r)))

;; A Git package with two tagged versions (v1, then v2 on a later commit).
(file! "gitpkg/norn.edn" "{:name gp :version \"1.0.0\"}\n")
(file! "gitpkg/src/dt/gp.norn" "(ns dt.gp)\n(defn version [] 1)\n")
(git! "gitpkg" "init" "-q")
(git! "gitpkg" "add" "-A")
(git! "gitpkg" "commit" "-qm" "one")
(git! "gitpkg" "tag" "v1")
(def v1 (git! "gitpkg" "rev-parse" "HEAD"))
(file! "gitpkg/src/dt/gp.norn" "(ns dt.gp)\n(defn version [] 2)\n")
(git! "gitpkg" "commit" "-qam" "two")
(git! "gitpkg" "tag" "v2")
(def v2 (git! "gitpkg" "rev-parse" "HEAD"))

;; Path packages: a and b both use c; c comes in two folders.
(file! "a/norn.edn" "{:name a :version \"0.1.0\" :deps {c {:path \"../c1\"}}}\n")
(file! "a/src/dt/a.norn" "(ns dt.a (:require [dt.c :as c]))\n(defn a [] [:a (c/which)])\n")
(file! "b/norn.edn" "{:name b :version \"0.1.0\" :deps {c {:path \"../c1\"}}}\n")
(file! "c1/norn.edn" "{:name c :version \"1.0.0\"}\n")
(file! "c1/src/dt/c.norn" "(ns dt.c)\n(defn which [] :c1)\n")
(file! "c2/norn.edn" "{:name c :version \"2.0.0\"}\n")
(file! "c2/src/dt/c.norn" "(ns dt.c)\n(defn which [] :c2)\n")
(file! "b2/norn.edn" "{:name b2 :deps {c {:path \"../c2\"}}}\n")

(deftest finding-and-reading-a-project
  (file! "app/norn.edn" (str "{:name app :version \"0.1.0\"\n"
                             " :deps {a {:path \"../a\"} gp {:git " (pr-str (io/path dir "gitpkg")) " :tag \"v1\"}}}\n"))
  (io/mkdirs! (io/path dir "app" "src" "deep" "er"))
  (is (= (io/path dir "app") (deps/find-project (io/path dir "app" "src" "deep" "er"))) "from a folder below it")
  (is (= ["src"] (:paths (deps/read-project (io/path dir "app")))) "the default paths")
  (is (= {:paths ["src"] :deps {} :overrides {}} (deps/read-project (io/path dir "nothing-here"))) "a folder without one")
  (file! "bad/norn.edn" "{:deps {x {:git \"u\"}}}\n")
  (is (str/includes? (message (fn [] (deps/read-project (io/path dir "bad"))))
                     "the dependency x {:git \"u\"} should be {:path \"folder\"}, or {:git \"url\" :tag \"tag\"}")))

(deftest resolving-path-and-git-packages
  (let [r (resolved "app")]
    (is (= '[[a "0.1.0"] [c "1.0.0"] [gp "1.0.0"]] (summary r)) "a, then what a uses, then gp")
    (is (= '[app a c] (:chain (second (:packages r)))) "the chain that brought c in")
    (is (= v1 (:sha (get (:lock r) 'gp))) "gp at v1's commit")
    (is (io/file? (io/path (:dir (last (:packages r))) "src" "dt" "gp.norn")) "fetched into the cache"))
  (testing "norn.lock keeps a package at its commit when the tag moves"
    (is (true? (deps/write-lock! (resolved "app"))))
    (is (str/includes? (io/read-text (io/path dir "app" "norn.lock")) v1))
    (git! "gitpkg" "tag" "-f" "v1" v2)
    (is (= v1 (:sha (get (:lock (resolved "app")) 'gp))) "still the locked commit")
    (is (= v2 (:sha (get (:lock (resolved "app" :update true)) 'gp))) "--update looks it up again")
    (git! "gitpkg" "tag" "-f" "v1" v1))
  (testing "a package's code loads once the project is used"
    (binding [deps/*deps-root* (io/path dir "fetched")]
      (deps/use-project! (io/path dir "app")))
    (is (= [:a :c1] (eval '(do (require 'dt.a) (dt.a/a)))))
    (is (= 1 (eval '(do (require 'dt.gp) (dt.gp/version)))) "v1, as locked")))

(deftest two-versions-of-a-package
  (testing "one version reached two ways is fine"
    (file! "diamond/norn.edn" "{:deps {a {:path \"../a\"} b {:path \"../b\"}}}\n")
    (is (= '[a c b] (mapv :name (:packages (resolved "diamond"))))))
  (testing "two are an error showing the chain to each"
    (file! "clash/norn.edn" "{:name clash :deps {a {:path \"../a\"} b2 {:path \"../b2\"}}}\n")
    (let [m (message (fn [] (resolved "clash")))]
      (is (str/starts-with? m "Two versions of c in the build:") m)
      (is (str/includes? m "c1, by clash → a → c") m)
      (is (str/includes? m "c2, by clash → b2 → c") m)
      (is (str/includes? m "Add c to :overrides in") m)))
  (testing "an override settles it, wherever the package is asked for"
    (file! "settled/norn.edn" "{:deps {a {:path \"../a\"} b2 {:path \"../b2\"}} :overrides {c {:path \"../c2\"}}}\n")
    (is (= '[[a "0.1.0"] [c "2.0.0"] [b2 nil]] (summary (resolved "settled"))))))

(deftest a-git-package-by-commit
  (file! "pinned/norn.edn" (str "{:deps {gp {:git " (pr-str (io/path dir "gitpkg")) " :sha " (pr-str (subs v2 0 10)) "}}}\n"))
  (let [r (resolved "pinned")]
    (is (= v2 (:sha (get (:lock r) 'gp))) "a short commit, resolved")
    (is (str/includes? (:source (first (:packages r))) (subs v2 0 10)))))
