;;;; Pseudo-terminals (M9 part 9.10): a program on a terminal of its own,
;;;; read and written as streams, and resized.

(ns pty-test
  (:require [norn.test :refer [is deftest testing]] [norn.process :as proc] [norn.io :as io]
            [norn.string :as str]))

(defn- read-until
  "What p's terminal shows, until it shows s (or ends)."
  [p s]
  (loop [acc ""]
    (if (and s (str/includes? acc s))
      acc
      (if-let [b (io/read (:out p) 4096)] (recur (str acc (bytes->string b true))) acc))))

(deftest a-program-on-a-terminal
  (let [p (proc/start-pty "sh" :args ["-c" "stty size; [ -t 0 ] && [ -t 1 ] && echo terminal; echo TERM=$TERM; read x; echo got $x"]
                          :rows 30 :cols 90)]
    (is (:pty p))
    (let [shown (read-until p "TERM=")]
      (is (str/includes? shown "30 90") "its size")
      (is (str/includes? shown "terminal") "stdin and stdout are a terminal")
      (is (str/includes? shown "TERM=xterm-256color")))
    (io/write (:in p) "hello\n")
    (is (= "hello\r\ngot hello\r\n" (read-until p "got hello")) "the terminal echoes what's typed, and turns \\n into \\r\\n")
    (is (nil? (io/read (:out p) 10)) "the end, once it exits")
    (is (= {:exit 0 :signal nil} (proc/wait p)))))

(deftest resizing
  (let [p (proc/start-pty "sh" :args ["-c" "read x; stty size"])]
    (proc/resize p 40 100)
    (io/write (:in p) "go\n")
    (is (str/includes? (read-until p nil) "40 100"))
    (proc/wait p))
  (is (some? (try (proc/resize (proc/start "true") 1 1) nil (catch Error e e))) "only a pty's"))

(deftest the-terminal-is-a-controlling-one
  (testing "^C at the terminal interrupts the program"
    (let [p (proc/start-pty "sh" :args ["-c" "echo ready; sleep 30"])]
      (read-until p "ready")
      (io/write (:in p) (bytes [3]))
      (is (str/includes? (read-until p nil) "^C") "echoed")
      (is (= :int (:signal (proc/wait p))) "SIGINT"))))

(deftest an-interactive-program
  (let [p (proc/start-pty "cat")]
    (io/write (:in p) "one\n")
    (is (str/includes? (read-until p "one\r\none") "one"))
    (io/write (:in p) (bytes [4]))
    (read-until p nil)
    (is (= 0 (:exit (proc/wait p))) "^D: the end of its input")))
