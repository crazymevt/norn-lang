;;;; Modules (M8 part 8.4): a file starting with (ns …) is a module, with
;;;; forward references, private vars that other code can't name, a
;;;; registry, and reloading. The modules are written to a temporary folder.

(ns module-test
  (:require [norn.test :refer [is deftest testing]] [norn.io :as io] [norn.sys :as sys]
            [norn.string :as str] [norn.lint :as lint] [norn.dev :as dev]))

(def dir (io/path (sys/temp-dir) (str "norn-module-test-" (sys/pid) "-" (nano-time))))
(io/mkdirs! (io/path dir "mt"))
(add-lib-path! dir)

(defn- module! [name text] (io/write-text (io/path dir "mt" (str name ".norn")) text))

(module! "a" (str "(ns mt.a)\n"
                  "(defn start [] (finish 20))\n"
                  "(defn finish [x] (+ x (helper)))\n"
                  "(defn- helper [] 1)\n"
                  "(def ^:private hidden 5)\n"
                  "(defn reveal [] hidden)\n"
                  "(defn- double [x] (* 2 x))\n"
                  "(defmacro twice [x] `(double ~x))\n"
                  ;; (^:private on a defining macro's name: pulse finding)
                  "(defn ^:private also-hidden [] 2)\n"
                  "(defmacro ^:private quietly [x] x)\n"
                  "(defn use-both [] (quietly (also-hidden)))\n"))

(module! "b" (str "(ns mt.b\n  (:require [mt.a :as a]))\n"
                  "(defn twice-of [n] (a/twice n))\n"))

(module! "bad" (str "(ns mt.bad)\n\n(defn ok [] 1)\n(let* [1 2] 3)\n"))

;; A module taking core names for its own (:refer-core).
(module! "rc" (str "(ns mt.rc\n  (:refer-core :rename {get core-get}))\n"
                   "(defn lookup [m k] (core-get m k))\n"
                   "(defn get [url] (str \"GET \" url))\n"))
(module! "ex" (str "(ns mt.ex\n  (:refer-core :exclude [inc]))\n"
                   "(defn f [] (inc 1))\n"))

(defn- message [f] (try (f) nil (catch Error e (condition-message e))))

;; (the modules exist only once this file runs, so the tests reach them
;; through eval: the linter, reading this file, needn't find them)
(defn- run [form] (eval form))

(run '(require '[mt.a :as a] 'mt.b))

(deftest forward-references
  (is (= 21 (run '(mt.a/start))) "start calls finish, finish calls helper: both defined after it"))

(deftest private-vars
  (testing "other code can't name them"
    (is (= "mt.a/helper is private to mt.a" (message (fn [] (eval '(mt.a/helper))))))
    (is (= "mt.a/hidden is private to mt.a" (message (fn [] (eval 'mt.a/hidden))))))
  (testing "the module itself can, and so can its macros' expansions"
    (is (= 5 (run '(mt.a/reveal))))
    (is (= 8 (run '(mt.a/twice 4))))
    (is (= 14 (run '(mt.b/twice-of 7))) "a/twice used from another module"))
  (testing "a var reaches one on purpose"
    (is (= 1 (run '((var mt.a/helper))))))
  (testing "they aren't public, and can't be referred"
    (is (= '[finish reveal start twice use-both] (vec (sort (keys (ns-publics 'mt.a))))))
    (is (= 2 (run '(mt.a/use-both))) "defn ^:private and defmacro ^:private are private too")
    (is (contains? (ns-interns 'mt.a) 'helper))
    (is (= "No such public var: mt.a/helper" (message (fn [] (run '(require '[mt.a :refer [helper]]))))))))

(deftest the-registry
  (let [info (norn.expander/module-info 'mt.b)]
    (is (= '[mt.a] (:requires info)))
    (is (= '[twice-of] (:defines info)))
    (is (str/ends-with? (:path info) "mt/b.norn"))))

(deftest reloading
  (module! "a" (str "(ns mt.a)\n"
                    "(defn start [] (finish 20))\n"
                    "(defn finish [x] (* x (helper)))\n"
                    "(defn- helper [] 3)\n"
                    "(def ^:private hidden 5)\n"
                    "(defn reveal [] hidden)\n"
                    "(defn- double [x] (* 2 x))\n"
                    "(defmacro twice [x] `(double ~x))\n"))
  (run '(require 'mt.a :reload))
  (is (= 60 (run '(mt.a/start))) "redefined in place")
  (is (= "mt.a/helper is private to mt.a" (message (fn [] (eval '(mt.a/helper))))) "still private"))

(deftest a-reload-drops-what-the-source-no-longer-defines
  (module! "shrink" "(ns mt.shrink)\n(defn kept [] 1)\n(defn gone [] 2)\n(def ^:private hidden 3)\n")
  (module! "user" "(ns mt.user\n  (:require [mt.shrink :as s]))\n(defn call-gone [] (s/gone))\n")
  (run '(require 'mt.user))
  (module! "shrink" "(ns mt.shrink)\n(defn kept [] 10)\n")
  (run '(require 'mt.shrink :reload))
  (is (= ['kept] (vec (keys (ns-publics 'mt.shrink)))) "gone is no longer exported")
  (is (not (contains? (ns-interns 'mt.shrink) 'hidden)) "nor its private definitions")
  (is (= 10 (run '(mt.shrink/kept))) "what remains is redefined in place")
  (is (= 2 (run '(mt.user/call-gone))) "code compiled against a removed var keeps it")
  (is (some? (message (fn [] (eval '(mt.shrink/gone))))) "new code can't refer to it"))

(deftest taking-core-names
  (run '(require 'mt.rc 'mt.ex))
  (testing ":rename: core's get under another name, and the module's own get"
    (is (= 1 (run '(mt.rc/lookup {:a 1} :a))))
    (is (= "GET /x" (run '(mt.rc/get "/x")))))
  (testing ":exclude: the name is the module's, defined or not"
    (is (str/includes? (message (fn [] (run '(mt.ex/f)))) "mt.ex/inc")))
  (testing "mistakes"
    (is (= "norn.core has no nope to exclude or rename" (message (fn [] (eval '(ns mt.bad2 (:refer-core :exclude [nope])))))))
    (is (= "(:refer-core …) takes :exclude [names…] and :rename {name new-name}, not :only"
           (message (fn [] (eval '(ns mt.bad3 (:refer-core :only [map])))))))))

(deftest errors-in-a-module-say-where
  (let [m (message (fn [] (run '(require 'mt.bad))))]
    (is (str/includes? m "mt/bad.norn:4:8: Bad binding form in let*: 1") m)))

(deftest a-script-is-read-form-by-form
  ;; (no ns form: not a module, so no forward references)
  (is (some? (message (fn [] (load-string "(defn s-first [] (s-later)) (defn s-later [] 1)"))))))

(defn- lint [text] (mapv (juxt :line :kind :message) (lint/lint-string text "lm.norn")))

(deftest the-linter-knows-modules
  (is (= [] (lint "(ns lm)\n(defn f [] (g 1))\n(defn g [x] x)\n")) "forward references")
  (testing "unused requires (M8 part 8.8)"
    (is (= [[1 :unused-require "norn.string is required but never used (for its effect alone, require it without :as)"]]
           (lint "(ns lm-a (:require [norn.string :as str] [norn.set :as set]))\n(defn f [] (set/union #{1} #{2}))\n")))
    (is (= [[1 :unused-require "norn.string/join is referred but never used"]]
           (lint "(ns lm-b (:require [norn.string :refer [upper-case join]]))\n(defn f [] (upper-case \"a\"))\n")))
    (is (= [] (lint "(ns lm-c (:require [norn.string :as str] norn.set))\n(defmacro up [x] `(str/upper-case ~x))\n"))
        "used only in a template; a require without :as is for its effect"))
  (testing "missing requires"
    (is (= [[2 :missing-require "norn.string/upper-case: norn.string isn't required"]]
           (lint "(ns lm-d)\n(defn f [] (norn.string/upper-case \"a\"))\n")))
    (is (= [] (lint "(ns lm-e (:require [norn.string]))\n(defn f [] (norn.string/upper-case \"a\"))\n"))))
  (testing "another module's private var"
    (is (= [[2 :private "mt.a/helper is private to mt.a"]]
           (lint "(ns lm-f (:require [mt.a]))\n(defn f [] (mt.a/helper))\n")))
    (is (= [] (lint "(ns lm-g (:require [mt.a]))\n(defn f [] ((var mt.a/helper)))\n")) "var reaches it on purpose"))
  (testing "a definition that takes a core name silently"
    (is (= [[2 :shadow "definition of get shadows norn.core/get: every get in this module means it (say so with (:refer-core :exclude [get]), or rename it)"]]
           (lint "(ns lm-s)\n(defn get [x] x)\n(defn f [m] (get m))\n")))
    (is (= [] (lint "(ns lm-t (:refer-core :exclude [get]))\n(defn get [x] x)\n(defn f [m] (get m))\n")) "said so")
    (is (= [] (lint "(ns lm-u (:refer-core :rename {get core-get}))\n(defn get [x] x)\n(defn f [m k] (core-get m k))\n"))
        "renamed"))
  (testing "phases"
    (is (= [[3 :phase (str "helper is run-time code here, and macros run while compiling: "
                           "define it inside begin-for-syntax, or require its module with :require-for-syntax")]]
           (lint "(ns lm-h)\n(defn helper [x] (list 'quote x))\n(defmacro quoted [x] (helper x))\n")))
    (is (= [] (lint "(ns lm-i)\n(begin-for-syntax\n  (defn helper [x] (list 'quote x)))\n(defmacro quoted [x] (helper x))\n")))
    (is (= [] (lint "(ns lm-j (:require-for-syntax [norn.string :as s]))\n(defmacro up [x] (s/upper-case x))\n")))
    (is (= [[2 :phase (str "s/upper-case is run-time code here, and macros run while compiling: "
                           "define it inside begin-for-syntax, or require its module with :require-for-syntax")]]
           (lint "(ns lm-k (:require [norn.string :as s]))\n(defmacro up [x] (s/upper-case x))\n(defn f [] (s/upper-case \"a\"))\n")))
    (is (= [] (lint "(ns lm-l)\n(defn- dbl [x] (* 2 x))\n(defmacro twice [x] `(dbl ~x))\n"))
        "a template only names run-time code")))

(deftest fibers-loading-opposite-ends-of-a-cycle-get-an-error
  ;; (each waits before requiring the other, so both loads are under way)
  (module! "cyca" "(ns mt.cyca)\n(sleep 200)\n(require (quote mt.cycb))\n(def a 1)\n")
  (module! "cycb" "(ns mt.cycb)\n(sleep 200)\n(require (quote mt.cyca))\n(def b 2)\n")
  (let [load (fn [lib] (future (try (run (list 'require (list 'quote lib))) :loaded
                                    (catch Error e (condition-message e)))))
        results [(load 'mt.cyca) (load 'mt.cycb)]
        outcomes (mapv (fn [f] (deref f 10000 :timed-out)) results)]
    (is (not-any? #{:timed-out} outcomes) "neither waits forever")
    (is (some #(and (string? %) (str/includes? % "Circular require")) outcomes))))

(deftest fibers-loading-one-library-share-the-load
  (module! "shared" "(ns mt.shared)\n(sleep 100)\n(def loads (atom 0))\n(swap! loads inc)\n")
  (let [loads (mapv (fn [_] (future (run '(require 'mt.shared)) :ok)) (range 4))]
    (is (= [:ok :ok :ok :ok] (mapv #(deref % 10000 :timed-out) loads)))
    (is (= 1 (run '@mt.shared/loads)) "loaded once")))

(deftest a-macro-used-before-its-definition
  ;; (compiled as a call, it would give the expansion as data at run time)
  (module! "early" "(ns mt.early)\n(defn f [] (m 2))\n(defmacro m [x] `(* 2 ~x))\n")
  (let [m (message (fn [] (run '(require 'mt.early))))]
    (is (str/includes? m "mt/early.norn:2") m)
    (is (str/includes? m "mt.early/m is a macro defined further down this module") m))
  (module! "late" "(ns mt.late)\n(defmacro m [x] `(* 2 ~x))\n(defn f [] (m 2))\n(defn g [] (h 1))\n(defn h [x] x)\n")
  (is (= 4 (run '(do (require 'mt.late) (mt.late/f)))) "defined first: fine")
  (is (= 1 (run '(mt.late/g))) "a function may still come later")
  (testing "the linter says so too"
    (is (= [[2 :macro-order (str "m is a macro defined further down this module: a macro must be defined"
                                 " before its first use (loading the module stops here)")]]
           (lint "(ns lm-m)\n(defn f [] (m 2))\n(defmacro m [x] `(* 2 ~x))\n")))
    (is (= [] (lint "(ns lm-n)\n(defmacro m [x] `(* 2 ~x))\n(defn f [] (m 2))\n")))))

(deftest a-module-whose-ns-isnt-its-name
  (module! "named" "(ns mt.other)\n(defn hi [] :hi)\n")
  (let [m (message (fn [] (run '(require 'mt.named))))]
    (is (str/includes? m "Library mt.named is found at") m)
    (is (str/includes? m "but that file defines mt.other") m))
  (is (not (some #(= "mt.other" (str %)) (all-ns))) "nothing of it ran"))

(deftest auto-resolved-alias-keywords
  (module! "kw" "(ns mt.kw\n  (:require [norn.string :as money]))\n(defn k [] [::money/x ::y])\n")
  (is (= [:norn.string/x :mt.kw/y] (run '(do (require 'mt.kw) (mt.kw/k)))))
  (is (= [] (lint "(ns lm-o (:require [norn.string :as money]))\n(defn k [] ::money/x)\n(defn j [] (money/join []))\n"))
      "the linter reads them with the module's aliases")
  (is (str/includes? (message (fn [] (read-string "::nope/x"))) "nope isn't an alias")))

(deftest defonce-keeps-state-across-a-reload
  (module! "once" "(ns mt.once)\n(defonce hits \"Requests seen.\" (atom 0))\n(def plain (atom 0))\n")
  (eval '(require 'mt.once))
  (eval '(do (swap! mt.once/hits inc) (swap! mt.once/plain inc)))
  (eval '(require 'mt.once :reload))
  (is (= [1 0] (eval '[@mt.once/hits @mt.once/plain])) "defonce keeps its value; def evaluates again")
  (is (= "Requests seen." (:doc (meta (resolve 'mt.once/hits)))))
  (is (bound? (resolve 'mt.once/hits)))
  (eval '(def mt-unbound))
  (is (not (bound? (resolve 'mt-unbound))) "(def x) makes a var without a value"))

;; (pulse finding: a module's ns form may say what it's for)
(deftest an-ns-docstring
  (module! "nd" "(ns mt.nd\n  \"Things for the test.\n\n  More about them.\"\n  (:require [norn.string :as str]))\n(defn f \"F.\" [] (str/upper-case \"f\"))\n")
  (eval '(require 'mt.nd))
  (is (= "F" (eval '(mt.nd/f))) "the clauses after it still count")
  (is (= "Things for the test.\n\n  More about them." (get @%ns-docs 'mt.nd)))
  (require 'norn.doc)
  (is (= "mt.nd\n  Things for the test.\n\n  More about them.\n\n  f  F.\n" ((resolve 'norn.doc/ns-summary) "mt.nd")))
  (is (thrown-with-msg? Error #"expected an ns clause" (eval '(ns mt.nd2 "Doc." (:requir [x]))))))

(deftest meta-of-a-var
  (let [m (meta #'map)]
    (is (= ['map "norn.core"] [(:name m) (:ns m)]))
    (is (string? (:doc m)))
    (is (= '([f] [f coll] [f c1 c2] [f c1 c2 c3]) (:arglists m))))
  (is (:macro (meta #'when)))
  (is (:dynamic (meta #'*check-contracts*)))
  (is (nil? (meta [1 2])) "values carry none yet"))

(deftest norn-dev-reloads-a-changed-module-and-its-macros-users
  (module! "dw" "(ns mt.dw)\n(defmacro shout [s] `(str ~s \"!\"))\n(defn word [] \"one\")\n")
  (module! "du" "(ns mt.du (:require [mt.dw :as w]))\n(defn said [] (w/shout (w/word)))\n")
  (eval '(require 'mt.du))
  (is (= "one!" (eval '(mt.du/said))))
  (let [file (io/path dir "mt" "dw.norn")]
    (module! "dw" "(ns mt.dw)\n(defmacro shout [s] `(str ~s \"?\"))\n(defn word [] \"two\")\n")
    (is (= ['mt.dw 'mt.du] (:reloaded (dev/reload! [file]))) "a macro changed: its users too")
    (is (= "two?" (eval '(mt.du/said))))
    (module! "dw" "(ns mt.dw)\n(defn word [] \"three\"\n")
    (let [r (dev/reload! [file])]
      (is (= [] (:reloaded r)))
      (is (str/includes? (:error (first (:failed r))) "EOF while reading") "a save that doesn't read"))
    (is (= "two?" (eval '(mt.du/said))) "keeps the old code")
    ;; (an editor's temporary file, gone by the time its event comes, isn't
    ;; an embedded module, whose path doesn't exist either: pulse finding)
    (require 'norn.csv)
    (is (= {:reloaded [] :failed [] :unknown [(io/path dir "mt" ".!123!dw.norn")]}
           (dev/reload! [(io/path dir "mt" ".!123!dw.norn")])))))
