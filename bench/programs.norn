;;;; Whole programs, timed: the kinds of program the language tests wrote
;;;; (lang-tests: loglens, ledger, quire, chat), made here from the same
;;;; libraries with generated data, so the suite needs nothing outside this
;;;; checkout. Where time goes in real code: parsing, matching, small maps,
;;;; decimals, sequence functions, generic dispatch, channels. A baseline
;;;; for M10 (docs/plan-m10.md, part 0).
;;;;
;;;;   norn bench/programs.norn               (tier 1, the default)
;;;;   NORN_TIER=0 norn bench/programs.norn   (tier 0)
;;;;   norn bench/programs.norn log           (only programs named so)
;;;;   norn bench/programs.norn --edn         (results as data, for bench/compare.norn)

(ns bench-programs
  (:require [norn.bench :as bench]
            [norn.csv :as csv]
            [norn.decimal :as d]
            [norn.json :as json]
            [norn.markdown :as md]
            [norn.math :as math]
            [norn.random :as random]
            [norn.regex :as re]
            [norn.set :as set]
            [norn.stm :as stm]
            [norn.string :as str]
            [norn.sys :as sys]
            [norn.yaml :as yaml]))

;; ---- a log report (loglens): JSON Lines, a named-group regex, routes,
;; percentiles, a join with the users ----

(def log-lines
  (let [g (random/generator 1)
        paths ["/api/users/~a" "/api/orders" "/api/orders/~a" "/health"]
        methods ["GET" "GET" "GET" "POST" "DELETE"]]
    (vec (for [i (range 20000)]
           (json/write-string {:ts (str "2026-11-13T00:" (format "%02d:%02d" (mod (quot i 60) 60) (mod i 60)) ".000Z")
                               :req (str (nth methods (random/int g 5)) " "
                                         (str/replace (nth paths (random/int g 4)) "~a" (str (random/int g 5000)))
                                         " HTTP/1.1")
                               :status (if (< (random/int g 100) 4) 500 200)
                               :ms (+ 5 (random/int g 120))
                               :bytes (random/int g 20000)
                               :user (random/int g 300)})))))

(def users (set (for [i (range 300)] {:user i :plan (if (even? i) "free" "pro")})))

(def request-re #"(?<method>[A-Z]+) (?<path>/[^ ]*) HTTP/1\.1")

(defn- route [path]
  (str/join "/" (map (fn [part] (if (re-matches #"\d+" part) ":id" part)) (str/split path #"/"))))

(defn log-report []
  (let [entries (keep (fn [line]
                        (let [e (json/read-string line)]
                          (when-let [m (re/match request-re (:req e))]
                            (assoc e :method (:method (:named m)) :route (route (:path (:named m)))))))
                      log-lines)
        by-route (group-by :route entries)
        rows (for [[r es] (sort-by key by-route)
                   :let [ms (mapv :ms es)]]
               [r (count es) (math/percentile ms 50) (math/percentile ms 95) (count (filter (fn [e] (>= (:status e) 500)) es))])
        by-plan (frequencies (map :plan (set/join (set (map (fn [e] {:user (:user e) :route (:route e)}) entries)) users)))]
    [(str/join "\n" (map (fn [[r n p50 p95 errs]] (format "%-20s %6d p50 %4.0fms p95 %4.0fms %4d errors" r n p50 p95 errs)) rows))
     by-plan]))

;; ---- a ledger (ledger): CSV exports, exact decimals, categories by rule,
;; spending by month ----

(def ledger-csv
  (let [g (random/generator 2)
        payees ["WHOLE FOODS #123" "SHELL OIL 5521" "RENT, NOVEMBER" "NETFLIX.COM" "PAYROLL ACME" "CAFE ETE" "TRADER JOES"]]
    (csv/write-csv (cons ["Date" "Description" "Amount"]
                         (for [i (range 6000)]
                           [(format "%02d/%02d/2026" (inc (mod i 12)) (inc (mod i 28)))
                            (nth payees (random/int g (count payees)))
                            (format "%s%d.%02d" (if (= 0 (random/int g 9)) "" "-") (random/int g 400) (random/int g 100))])))))

(def rules [[#"(?i)whole foods|trader joe" "Groceries"] [#"(?i)shell" "Transport"] [#"(?i)rent" "Housing"]
            [#"(?i)payroll" "Income"] [#"(?i)netflix" "Subscriptions"]])

(defn ledger-report []
  (let [txs (for [{:keys [Date Description Amount]} (csv/read-maps ledger-csv)]
              (let [[m _ y] (str/split Date #"/")]
                {:month (str y "-" m) :payee Description :amount (d/parse Amount)
                 :category (or (some (fn [[re c]] (when (re-find re Description) c)) rules) "-")}))
        sums (reduce (fn [acc t] (update acc [(:month t) (:category t)] (fnil d/add (d/parse "0.00")) (:amount t))) {} txs)]
    (str/join "\n" (for [[[month cat] total] (sort sums)] (str month "  " cat "  " (d/text total))))))

;; ---- a static site (quire): Markdown posts with YAML front matter,
;; rendered, with an index and tag pages ----

(def posts
  (vec (for [i (range 150)]
         (str "---\ntitle: Post number " i "\ndate: 2026-" (format "%02d-%02d" (inc (mod i 12)) (inc (mod i 28)))
              "\ntags: [" (str/join ", " (map (fn [t] (str "t" t)) (range (mod i 4) (+ 2 (mod i 4))))) "]\n---\n\n"
              "# Heading " i "\n\nSome *emphasis*, some **strong** text, and `code`.\n\n"
              "- one item\n- two items, with [a link](https://example.com/" i ")\n\n"
              "```clojure\n(defn f [x] (* x " i "))\n```\n\n"
              (str/join "\n\n" (repeat 6 "A paragraph of text that goes on for a while, with words and more words in it."))))))

(defn site-build []
  (let [pages (for [p posts]
                (let [[_ front body] (re-find #"(?s)^---\n(.*?)\n---\n(.*)$" p)
                      meta (yaml/read-string front)]
                  (assoc meta :html (str "<article><h1>" (:title meta) "</h1>" (md/html body) "</article>"))))
        index (str "<ul>" (apply str (map (fn [p] (str "<li>" (:title p) " (" (:date p) ")</li>")) (sort-by :date pages))) "</ul>")
        tags (reduce (fn [m p] (reduce (fn [m t] (update m t (fnil conj []) (:title p))) m (:tags p))) {} pages)]
    [(reduce + (map (fn [p] (count (:html p))) pages)) (count index) (count tags)]))

;; ---- a chat server (chat): a roster in refs, a fiber per client, every
;; line to everyone in the room ----

(defn chat-fanout []
  (let [clients 40
        lines 500
        roster (stm/ref {})
        received (atom 0)]
    (with-scope [s]
      (let [boxes (vec (for [i (range clients)]
                         (let [c (chan 64)]
                           (stm/dosync (stm/alter roster assoc i c))
                           (spawn s (loop [n 0] (if (take! c) (recur (inc n)) (swap! received + n))))
                           c)))]
        (dotimes [i lines]
          (let [line (str "user" (mod i clients) ": message number " i)]
            (doseq [[_ c] @roster] (put! c line))))
        (doseq [c boxes] (close! c))))
    @received))

;; ---- Mandelbrot (the mandelbrot project's renderer): escape-time with
;; smooth colouring, floats throughout. bench/mandelbrot.lisp and .clj
;; compute the same thing in SBCL and Clojure, typed, for comparison
;; (bench/compare.norn); bench/mandelbrot.norn is this, as a program of
;; its own beside them ----

(def mandel-view {:re -0.7463 :im 0.1102 :span 0.028 :width 200 :height 125 :limit 220})

(defn- escape
  "Smoothed escape count for c, or -1.0 when c stays within the bailout
  (mandelbrot.fractal/escape)."
  [re im limit]
  (let [x (- re 0.25)
        im2 (* im im)
        q (+ (* x x) im2)
        bulb (+ re 1.0)]
    (if (or (< (* q (+ q x)) (* 0.25 im2))
            (< (+ (* bulb bulb) im2) 0.0625))
      -1.0
      (loop [zr 0.0 zi 0.0 n 0]
        (let [zr2 (* zr zr)
              zi2 (* zi zi)
              radius2 (+ zr2 zi2)]
          (cond
            (> radius2 16.0) (- (+ n 1.0) (math/log2 (* 0.5 (math/log2 radius2))))
            (= n limit) -1.0
            :else (let [t (* zr zi)]
                    (recur (+ (- zr2 zi2) re) (+ t t im) (inc n)))))))))

(defn mandelbrot
  "Every pixel of mandel-view: [interior pixels, the sum of the escape
  counts' whole parts], a checksum bench/mandelbrot.lisp's must match."
  []
  (let [{:keys [re im span width height limit]} mandel-view
        scale (/ span (min width height))
        left (- re (* width 0.5 scale))
        top (+ im (* height 0.5 scale))]
    (loop [y 0 inside 0 total 0]
      (if (= y height)
        [inside total]
        (let [ci (- top (* (+ y 0.5) scale))
              [i t] (loop [x 0 i 0 t 0]
                      (if (= x width)
                        [i t]
                        (let [n (escape (+ left (* (+ x 0.5) scale)) ci limit)]
                          (if (neg? n) (recur (inc x) (inc i) t) (recur (inc x) i (+ t (long n)))))))]
          (recur (inc y) (+ inside i) (+ total t)))))))

;; ---- running ----

(def programs
  [["log report: 20,000 JSON lines, routes, percentiles, a join" log-report]
   ["ledger: 6,000 CSV rows, decimals, rules, by month" ledger-report]
   ["site: 150 Markdown posts with YAML, an index, tags" site-build]
   ["chat: 500 lines to 40 clients through channels" chat-fanout]
   ["mandelbrot: 200×125 pixels, escape time, floats" mandelbrot]])

(defn -main [& args]
  (let [edn? (some #{"--edn"} args)
        only (first (remove #{"--edn"} args))
        chosen (filter (fn [[label _]] (or (nil? only) (str/includes? label only))) programs)]
    (when-not edn?
      (println (str "tier " (:tier (jit-stats)) ", ms per run (best of the runs in about 2 s)")))
    (let [results (into {} (for [[label f] chosen]
                             (let [ms (/ (:min-ns (bench/run f :warmup-ms 300 :ms 1500)) 1e6)]
                               (when-not edn? (println (format "%9.2f  %s" ms label)))
                               [label ms])))]
      (when edn? (prn results)))))

(apply -main (sys/program-args))
