+                    unsafe { assert_eq!(a.to_ptr::<u8>().read(), 7, "protecting keeps what's there") };
+                },
+                || {
+                    let _ = Windows::munmap(a, size);
+                },
+            );
+        });
+    }
+
+    #[test]
+    fn the_process() {
+        assert!(Windows::get_total_num_cpus() >= 1);
+        assert_eq!(Windows::get_process_id().unwrap(), std::process::id());
+        Windows::bind_current_thread_to_core(0);
+    }
+}
