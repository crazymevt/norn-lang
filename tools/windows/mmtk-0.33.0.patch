+    const RESERVE_ONLY: MmapStrategy = MmapStrategy { huge_page: HugePageSupport::No, prot: MmapProtection::NoAccess, replace: false, reserve: false };
+
+    fn write_read(start: Address, size: usize) {
+        let p = start.to_mut_ptr::<u8>();
+        for i in (0..size).step_by(BYTES_IN_PAGE) {
+            unsafe {
+                assert_eq!(p.add(i).read(), 0, "a fresh page is zero");
+                p.add(i).write(0xab);
+                assert_eq!(p.add(i).read(), 0xab);
+            }
+        }
+    }
