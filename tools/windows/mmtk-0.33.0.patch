+        let a = Windows::dzmmap_anywhere(size, BYTES_IN_CHUNK, RESERVE_ONLY, mmap_anno_test!()).unwrap();
+        Windows::munmap(a, size).unwrap();
+        assert_eq!(region(a).unwrap().1, MEM_FREE, "a whole reservation is released, not decommitted");
+        a
+    }
