+//! Windows implementation of the OS layer.
+//!
+//! Windows separates reserving address space from committing memory to it,
+//! where mmap does both (or, with MAP_NORESERVE, something between). The
+//! mapping of MMTk's requests:
+//!
+//! - quarantine (no access, not reserved): `MEM_RESERVE`;
+//! - a mapping to use: `MEM_COMMIT` of what's reserved, and
+//!   `MEM_RESERVE | MEM_COMMIT` of what's free. Committed pages are zero;
+//! - unmap: `MEM_RELEASE` when the range is a whole allocation, else
+//!   `MEM_DECOMMIT` (the address space stays reserved).
+//!
+//! A request may cross several regions (reservations can't be merged), so
+//! each is walked with `VirtualQuery`.
+
+use crate::util::address::Address;
+use crate::util::constants::BYTES_IN_PAGE;
+use crate::util::conversions::raw_align_up;
+use crate::util::os::*;
+use std::ffi::c_void;
+use std::io::{Error, ErrorKind, Result};
+use windows_sys::Win32::Foundation::{ERROR_COMMITMENT_LIMIT, ERROR_NOT_ENOUGH_MEMORY, ERROR_OUTOFMEMORY};
+use windows_sys::Win32::System::Memory::{
+    VirtualAlloc, VirtualFree, VirtualProtect, VirtualQuery, MEMORY_BASIC_INFORMATION, MEM_COMMIT, MEM_DECOMMIT, MEM_FREE,
+    MEM_RELEASE, MEM_RESERVE, PAGE_EXECUTE_READWRITE, PAGE_NOACCESS, PAGE_READWRITE,
+};
+use windows_sys::Win32::System::Threading::{GetCurrentProcessId, GetCurrentThread, GetCurrentThreadId, SetThreadAffinityMask};
+
+/// Windows implementation of the `OS` trait.
+pub struct Windows;
+
+impl MmapProtection {
+    fn get_native_flags(&self) -> u32 {
+        match self {
+            Self::ReadWrite => PAGE_READWRITE,
+            Self::ReadWriteExec => PAGE_EXECUTE_READWRITE,
+            Self::NoAccess => PAGE_NOACCESS,
+        }
+    }
+}
+
+/// The region `addr` is in: (its end, its state, the base of its allocation).
+fn region(addr: Address) -> Result<(Address, u32, Address)> {
+    let mut info: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+    let n = unsafe { VirtualQuery(addr.to_ptr::<c_void>(), &mut info, std::mem::size_of::<MEMORY_BASIC_INFORMATION>()) };
+    if n == 0 {
+        return Err(Error::last_os_error());
+    }
+    let end = Address::from_mut_ptr(info.BaseAddress) + info.RegionSize;
+    Ok((end, info.State, Address::from_mut_ptr(info.AllocationBase)))
+}
+
+fn alloc(start: Address, size: usize, kind: u32, prot: u32) -> Result<()> {
+    let p = unsafe { VirtualAlloc(start.to_ptr::<c_void>(), size, kind, prot) };
+    if p.is_null() {
+        Err(Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+/// The end of the allocation that starts at `base`.
+fn allocation_end(base: Address) -> Address {
+    let mut at = base;
+    while let Ok((region_end, state, allocation)) = region(at) {
+        if state == MEM_FREE || allocation != base {
+            break;
+        }
+        at = region_end;
+    }
+    at
+}
+
+/// Map [start, start + size) as `strategy` says, region by region.
+fn map(start: Address, size: usize, strategy: MmapStrategy) -> Result<()> {
+    let quarantine = matches!(strategy.prot, MmapProtection::NoAccess) && !strategy.reserve;
+    let prot = strategy.prot.get_native_flags();
+    let end = start + size;
+    let mut at = start;
+    while at < end {
+        let (region_end, state, _) = region(at)?;
+        let piece_end = if region_end < end { region_end } else { end };
+        let piece = piece_end - at;
+        if state == MEM_FREE {
+            let kind = if quarantine { MEM_RESERVE } else { MEM_RESERVE | MEM_COMMIT };
+            alloc(at, piece, kind, prot)?;
+        } else if !strategy.replace {
+            // (as mmap with MAP_FIXED_NOREPLACE)
+            return Err(Error::from(ErrorKind::AlreadyExists));
+        } else if !quarantine {
+            if state == MEM_COMMIT {
+                // (replacing a mapping gives zero pages: decommit them first)
+                if unsafe { VirtualFree(at.to_mut_ptr::<c_void>(), piece, MEM_DECOMMIT) } == 0 {
+                    return Err(Error::last_os_error());
+                }
+            }
+            alloc(at, piece, MEM_COMMIT, prot)?;
+        } else if state == MEM_COMMIT && unsafe { VirtualFree(at.to_mut_ptr::<c_void>(), piece, MEM_DECOMMIT) } == 0 {
+            // (quarantining what was in use: it stays reserved, with nothing committed)
+            return Err(Error::last_os_error());
+        }
+        at = piece_end;
+    }
+    Ok(())
+}
+
+/// Reserve `size` bytes aligned to `align`, near `preferred` if it's free.
+fn map_aligned(preferred: Address, size: usize, align: usize, strategy: MmapStrategy, annotation: &MmapAnnotation<'_>) -> MmapResult<Address> {
+    debug_assert!(align.is_power_of_two());
+    debug_assert!(align % BYTES_IN_PAGE == 0);
+    debug_assert!(size % BYTES_IN_PAGE == 0);
+    let aligned_size = raw_align_up(size, align);
+    let fail = |e: Error| MmapError::new(preferred, aligned_size + align, annotation, e);
+    let fresh = strategy.replace(false);
+    if !preferred.is_zero() && preferred.is_aligned_to(align) && map(preferred, size, fresh).is_ok() {
+        return Ok(preferred);
+    }
+    // Windows has no unmapping of part of a reservation: find room with a
+    // larger one, give it back, and take the aligned part of where it was.
+    // Another thread may take it between the two: try again.
+    for _ in 0..64 {
+        let p = unsafe { VirtualAlloc(std::ptr::null(), aligned_size + align, MEM_RESERVE, PAGE_NOACCESS) };
+        if p.is_null() {
+            return Err(fail(Error::last_os_error()));
+        }
+        unsafe { VirtualFree(p, 0, MEM_RELEASE) };
+        let aligned = Address::from_mut_ptr(p).align_up(align);
+        if map(aligned, size, fresh).is_ok() {
+            return Ok(aligned);
+        }
+    }
+    Err(fail(Error::from(ErrorKind::AddrNotAvailable)))
+}
+
+impl OSMemory for Windows {
+    fn dzmmap(start: Address, size: usize, strategy: MmapStrategy, annotation: &MmapAnnotation<'_>) -> MmapResult<Address> {
+        // (annotations and huge pages are ignored on Windows)
+        map(start, size, strategy).map_err(|e| MmapError::new(start, size, annotation, e))?;
+        Ok(start)
+    }
+
+    fn dzmmap_anywhere(size: usize, align: usize, strategy: MmapStrategy, annotation: &MmapAnnotation<'_>) -> MmapResult<Address> {
+        map_aligned(Address::ZERO, size, align, strategy, annotation)
+    }
+
+    fn dzmmap_preferred(start: Address, size: usize, align: usize, strategy: MmapStrategy, annotation: &MmapAnnotation<'_>) -> MmapResult<Address> {
+        map_aligned(start, size, align, strategy, annotation)
+    }
+
+    fn is_mmap_oom(os_errno: i32) -> bool {
+        let e = os_errno as u32;
+        e == ERROR_NOT_ENOUGH_MEMORY || e == ERROR_OUTOFMEMORY || e == ERROR_COMMITMENT_LIMIT
+    }
+
+    fn munmap(start: Address, size: usize) -> Result<()> {
+        // As with munmap, the range may cross allocations and free space, so
+        // walk it. An allocation wholly inside is released; part of one is
+        // decommitted, and its address space stays reserved (a later mapping
+        // there commits). Free space is skipped.
+        let end = start + size;
+        let mut at = start;
+        while at < end {
+            let (region_end, state, base) = region(at)?;
+            if state == MEM_FREE {
+                at = region_end;
+            } else if base >= start && allocation_end(base) <= end {
+                let next = allocation_end(base);
+                if unsafe { VirtualFree(base.to_mut_ptr::<c_void>(), 0, MEM_RELEASE) } == 0 {
+                    return Err(Error::last_os_error());
+                }
+                at = next;
+            } else {
+                let piece_end = if region_end < end { region_end } else { end };
+                if state == MEM_COMMIT && unsafe { VirtualFree(at.to_mut_ptr::<c_void>(), piece_end - at, MEM_DECOMMIT) } == 0 {
+                    return Err(Error::last_os_error());
+                }
+                at = piece_end;
+            }
+        }
+        Ok(())
+    }
+
+    fn set_memory_access(start: Address, size: usize, prot: MmapProtection) -> Result<()> {
+        let mut old = 0u32;
+        if unsafe { VirtualProtect(start.to_ptr::<c_void>(), size, prot.get_native_flags(), &mut old) } == 0 {
+            return Err(Error::last_os_error());
+        }
+        Ok(())
+    }
+
+    fn panic_if_unmapped(start: Address, size: usize) {
+        let end = start + size;
+        let mut at = start;
+        while at < end {
+            let (region_end, state, _) = region(at).unwrap();
+            assert!(state == MEM_COMMIT, "{at} is not mapped");
+            at = region_end;
+        }
+    }
+}
+
+impl OSProcess for Windows {
+    type ProcessIDType = u32;
+    type ThreadIDType = u32;
+
+    fn get_process_memory_maps() -> Result<String> {
+        // (only for debugging: there's no /proc/self/maps to read)
+        Ok(String::from("(the process's memory maps aren't listed on Windows)"))
+    }
+
+    fn get_process_id() -> Result<Self::ProcessIDType> {
+        Ok(unsafe { GetCurrentProcessId() })
+    }
+
+    fn get_thread_id() -> Result<Self::ThreadIDType> {
+        Ok(unsafe { GetCurrentThreadId() })
+    }
+
+    fn get_total_num_cpus() -> CoreNum {
+        std::thread::available_parallelism().map(|n| n.get() as CoreNum).unwrap_or(1)
+    }
+
+    fn bind_current_thread_to_core(core_id: CoreId) {
+        Self::bind_current_thread_to_cpuset(&[core_id]);
+    }
+
+    fn bind_current_thread_to_cpuset(core_ids: &[CoreId]) {
+        // (one processor group: the first 64 cores)
+        let mask = core_ids.iter().filter(|&&c| c < 64).fold(0usize, |m, &c| m | (1usize << c));
+        if mask != 0 {
+            unsafe { SetThreadAffinityMask(GetCurrentThread(), mask) };
+        }
+    }
+}
+
