;;;; skein.sync — coordinating fibers: semaphores, latches, barriers, a
;;;; rate limiter and once-only initialisation.
;;;;
;;;; All of them park the waiting fiber (never a carrier thread), being
;;;; built on channels and atoms.

(ns skein.sync
  (:refer-core :exclude [release!]))

;; ---- semaphores ----------------------------------------------------------------------------

(defclass Semaphore () ((permits) (tokens))
  (:doc "A number of permits that fibers acquire! and release!, waiting when none
  is left (from semaphore)."))

(defn semaphore "A semaphore with n permits." ^Semaphore [^Integer n]
  (let [tokens (chan n)]
    (dotimes [_ n] (offer! tokens true))
    (Semaphore :permits n :tokens tokens)))

(defn acquire! "Take a permit, parking until one is free." [^Semaphore s] (take! (:tokens s)) nil)
(defn try-acquire! "Take a permit if one is free now: true if it did." ^Boolean [^Semaphore s] (some? (poll! (:tokens s))))
(defn release! "Give a permit back." [^Semaphore s] (offer! (:tokens s) true) nil)
(defn available "How many permits are free now." ^Integer [^Semaphore s]
  ;; counted by draining and refilling; a snapshot only
  (loop [n 0] (if (poll! (:tokens s)) (recur (inc n)) (do (dotimes [_ n] (offer! (:tokens s) true)) n))))

(defmacro with-permit "Run body holding a permit of semaphore s." [s & body]
  `(let [s# ~s] (acquire! s#) (try (do ~@body) (~'finally (release! s#)))))

;; ---- latches -------------------------------------------------------------------------------

(defclass Latch () ((count) (done))
  (:doc "A count that fibers wait to reach zero (await-latch), counted down by
  count-down! (from latch)."))

(defn latch "A latch that opens after n count-down! calls." ^Latch [^Integer n]
  (let [l (Latch :count (atom n) :done (chan))]
    (when (<= n 0) (close! (:done l)))
    l))

(defn count-down! "Count the latch down by one; at zero it opens." [^Latch l]
  (when (zero? (swap! (:count l) (fn [c] (max 0 (dec c))))) (close! (:done l)))
  nil)

(defn await-latch
  "Park until the latch opens; with timeout-ms, give up after that long.
  True if it opened."
  (^Boolean [^Latch l] (take! (:done l)) true)
  (^Boolean [^Latch l ^Integer timeout-ms]
   (let [[_ ch] (alts! [(:done l) (timeout timeout-ms)])] (= ch (:done l)))))

(defn latch-count "How many count-downs are left." ^Integer [^Latch l] (deref (:count l)))

;; ---- barriers ------------------------------------------------------------------------------

(defclass Barrier () ((parties) (state))
  (:doc "A meeting point for a number of fibers: each arrive! waits until all of
  them have arrived (from barrier)."))

(defn barrier "A reusable barrier for n fibers: each arrive! parks until all n have arrived." ^Barrier [^Integer n]
  (Barrier :parties n :state (atom {:waiting 0 :gate (chan)})))

(defn arrive!
  "Wait at the barrier until all its parties are here; then they all go
  on and the barrier resets. Returns this fiber's arrival index."
  ^Integer [^Barrier b]
  (let [n (:parties b)
        [old _] (swap-vals! (:state b)
                            (fn [{:keys [waiting] :as st}]
                              (if (= (inc waiting) n) {:waiting 0 :gate (chan)} (assoc st :waiting (inc waiting)))))]
    (if (= (inc (:waiting old)) n)
      (close! (:gate old))
      (take! (:gate old)))
    (:waiting old)))

;; ---- rate limiting -------------------------------------------------------------------------

(defclass RateLimiter () ((rate) (burst) (state))
  (:doc "A token bucket: tokens come at a rate, up to a burst, and try-take! or
  take-token! spends them (from rate-limiter)."))

(defn rate-limiter
  "A token bucket: rate tokens a second, holding at most burst (default
  rate) at once."
  (^RateLimiter [^Number rate] (rate-limiter rate rate))
  (^RateLimiter [^Number rate ^Number burst] (RateLimiter :rate rate :burst burst :state (atom {:tokens (float burst) :at (nano-time)}))))

(defn- refill [{:keys [tokens at]} rate burst now]
  {:tokens (min (float burst) (+ tokens (* rate (/ (- now at) 1e9)))) :at now})

(defn try-take!
  "Take n tokens (default 1) if they're available now: true if it did."
  (^Boolean [^RateLimiter rl] (try-take! rl 1))
  (^Boolean [^RateLimiter rl ^Number n]
   (let [now (nano-time) took (atom false)]
     (swap! (:state rl)
            (fn [st]
              (let [st (refill st (:rate rl) (:burst rl) now)]
                (if (>= (:tokens st) n)
                  (do (reset! took true) (update st :tokens - n))
                  (do (reset! took false) st)))))
     (deref took))))

(defn take-token!
  "Take n tokens (default 1), sleeping until they're available."
  ([^RateLimiter rl] (take-token! rl 1))
  ([^RateLimiter rl ^Number n]
   (loop []
     (when-not (try-take! rl n)
       (let [missing (- n (:tokens (deref (:state rl))))]
         (sleep (max 1 (int (* 1000 (/ missing (:rate rl))))))
         (recur))))
   nil))

;; ---- once ----------------------------------------------------------------------------------

(defclass Once () ((f) (state))
  (:doc "A function run at most once, however many fibers call it: the others
  wait for its value (from once)."))

(defn once
  "A function that runs f the first time it's called, and afterwards
  returns that result. Callers that arrive while f runs wait for it."
  ^Function [f]
  (let [state (atom nil)]
    (fn []
      (let [mine (chan)
            [old _] (swap-vals! state (fn [s] (or s {:running mine})))]
        (cond (nil? old)
              (let [r (try {:value (f)} (catch Error e {:error e}))]
                (reset! state r)
                (close! mine)
                (if (contains? r :error) (throw (:error r)) (:value r)))
              (:running old)
              (do (take! (:running old)) (recur))
              (contains? old :error) (throw (:error old))
              :else (:value old))))))
