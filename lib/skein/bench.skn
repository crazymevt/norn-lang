;;;; skein.bench — measuring how long code takes.
;;;;
;;;;   (bench/bench (reduce + (range 1000)))
;;;;   (reduce + (range 1000)): 41.2 µs ± 1.3 µs (24,108 runs, 3 GCs)
;;;;
;;;; A run warms up (so tier-1 code is compiled: tier 1 compiles on a thread
;;;; of its own, which a run waits for), then times batches until a time
;;;; budget is spent, and reports per-run statistics over the batches.

(ns skein.bench
  (:require [skein.math :as math]))

(defn- now [] (nano-time))

(defn- compiled!
  "At tier 1, wait (at most 10 s) until the compile thread has compiled
  what's waiting: code that became hot runs compiled from its next call or
  loop turn."
  []
  (loop [k 0] (when (and (pos? (:pending (jit-stats))) (< k 1000)) (sleep 10) (recur (inc k)))))

(defn- time-batch [f n]
  (let [t0 (now)]
    (dotimes [_ n] (f))
    (- (now) t0)))

(defn run
  "Time thunk f. Options: :warmup-ms (default 200), :ms (time budget,
  default 1000). Returns {:mean-ns :stddev-ns :min-ns :runs :batches :gcs}."
  [f & {:keys [warmup-ms ms] :or {warmup-ms 200 ms 1000}}]
  (let [warm-end (+ (now) (* warmup-ms 1000000))]
    (loop [] (f) (when (< (now) warm-end) (recur))))
  (compiled!)
  ;; a batch size that takes about a hundredth of the budget (time-batch's
  ;; loop compiled too before timing)
  (let [batch (loop [n 1] (let [t (time-batch f n)] (if (and (< t (* ms 10000)) (< n 100000000)) (recur (* n 2)) n)))
        _ (compiled!)
        g0 (gc-count)
        end (+ (now) (* ms 1000000))
        per-run (loop [xs []] (if (< (now) end) (recur (conj xs (/ (time-batch f batch) (float batch)))) xs))]
    {:mean-ns (math/mean per-run)
     :stddev-ns (math/std-dev per-run)
     :min-ns (reduce min per-run)
     :runs (* batch (count per-run))
     :batches (count per-run)
     :gcs (- (gc-count) g0)}))

(defn- show-time [ns]
  (cond (< ns 1000) (format "%.1f ns" ns)
        (< ns 1e6) (format "%.1f µs" (/ ns 1e3))
        (< ns 1e9) (format "%.1f ms" (/ ns 1e6))
        :else (format "%.2f s" (/ ns 1e9))))

(defn report
  "One line describing result r of run, labelled label. With one batch
  there's no spread to give, so none is (a run longer than the time budget
  is one batch: give run more :ms to measure it)."
  [label r]
  (str label ": " (show-time (:mean-ns r))
       (when (> (:batches r) 1) (str " ± " (show-time (:stddev-ns r))))
       (format " (%,d %s, %d %s)" (:runs r) (if (= 1 (:runs r)) "run" "runs") (:gcs r) (if (= 1 (:gcs r)) "GC" "GCs"))))

(defmacro bench
  "Time expr (see run for the options) and print one line; returns the
  statistics."
  [expr & opts]
  `(let [r# (run (fn [] ~expr) ~@opts)]
     (println (report ~(pr-str expr) r#))
     r#))
