;;;; skein.time — instants, durations and calendar dates.
;;;;
;;;; An Instant is a point on the UTC time line (nanoseconds since
;;;; 1970-01-01T00:00:00Z). A Duration is an amount of time in nanoseconds.
;;;; Calendar fields and text use RFC 3339. A zone is UTC, this machine's
;;;; local time, a fixed offset in seconds, or a named IANA zone
;;;; ("Europe/Paris"), read from the system's TZif files ($TZDIR, else
;;;; /usr/share/zoneinfo). A ZonedDateTime is an instant with its zone and
;;;; the wall-clock time there.
;;;;
;;;; Calendar arithmetic (shift) moves dates by years, months and days on
;;;; the calendar, and zoned times by hours and smaller on the time line.
;;;; A wall-clock time a zone skips (spring forward) or repeats (fall back)
;;;; is resolved by an explicit policy, :resolve, as in JavaScript's
;;;; Temporal: :compatible (default: later for a skipped time, earlier for
;;;; a repeated one), :earlier, :later, or :reject (an error).
;;;;
;;;; Errors: text that isn't a date, time or zone name (an unknown zone
;;;; among them) is a ParseError; values that don't make one (2026-02-30
;;;; from numbers, a wall-clock time :reject refuses, the wrong kind of
;;;; argument) are a TypeError.

(ns skein.time
  (:refer-core :exclude [format])
  (:require [skein.bytes :as bytes] [skein.io :as io] [skein.string :as str] [skein.sys :as sys]))

(defclass Instant () ((nanos :initform 0))
  (:doc "A point on the time line, in nanoseconds since 1970-01-01T00:00:00Z, the
  same everywhere (from now, parse or of-epoch-ms)."))
(defclass Duration () ((nanos :initform 0))
  (:doc "A span of time in nanoseconds (from duration or between)."))
(defclass LocalDate () ((year :required true) (month :required true) (day :required true))
  (:doc "A calendar date without a time or a time zone (from local-date or
  parse-local-date)."))
(defclass LocalTime () ((hour :required true) (minute :required true) (second :required true) (nanos :required true))
  (:doc "A time of day without a date or a time zone (from local-time or
  parse-local-time)."))
(defclass LocalDateTime () ((date :required true) (time :required true))
  (:doc "A date and a time of day without a time zone (from local-date-time or
  parse-local-date-time)."))

(defn instant? "Is x an Instant?" ^Boolean [x] (instance? Instant x))
(defn duration? "Is x a Duration?" ^Boolean [x] (instance? Duration x))
(defn local-date? "Is x a LocalDate?" ^Boolean [x] (instance? LocalDate x))
(defn local-time? "Is x a LocalTime?" ^Boolean [x] (instance? LocalTime x))
(defn local-date-time? "Is x a LocalDateTime?" ^Boolean [x] (instance? LocalDateTime x))

(defn leap-year? "Is year a leap year in the Gregorian calendar?" ^Boolean [^Integer year]
  (and (zero? (mod year 4)) (or (not (zero? (mod year 100))) (zero? (mod year 400)))))

(defn- bad-value [msg expected value]
  (error TypeError :message (str "skein.time: " msg) :expected expected :value value))

(defn- bad-text [msg source]
  (error ParseError :message (str "skein.time: " msg) :source source))

(defn- parsing
  "(f), a ParseError (from source) for an error in it: text s whose parts
  don't make a date or time."
  [s source f]
  (handler-case (f)
    (Error [_] (bad-text (str "Invalid " source " " (pr-str s)) source))))

(defmethod initialize-instance :after ((date LocalDate) _)
  (let [{:keys [year month day]} (instance->map date)
        days (when (and (integer? month) (<= 1 month 12))
               (if (and (= month 2) (integer? year) (leap-year? year))
                 29 (nth [31 28 31 30 31 30 31 31 30 31 30 31] (dec month))))]
    (when-not (and (integer? year) (<= 0 year 9999) days (integer? day) (<= 1 day days))
      (bad-value (str "Invalid local date " year " " month " " day) "a date in years 0000–9999" [year month day]))))

(defmethod initialize-instance :after ((clock LocalTime) _)
  (let [{:keys [hour minute second nanos]} (instance->map clock)]
    (when-not (and (every? integer? [hour minute second nanos])
                   (<= 0 hour 23) (<= 0 minute 59) (<= 0 second 59) (<= 0 nanos 999999999))
      (bad-value (str "Invalid local time " hour " " minute " " second " " nanos) "a time of day" [hour minute second nanos]))))

(defmethod initialize-instance :after ((dt LocalDateTime) _)
  (when-not (and (local-date? (:date dt)) (local-time? (:time dt)))
    (bad-value "LocalDateTime expects a local date and local time" "a LocalDate and a LocalTime" [(:date dt) (:time dt)])))

(defn local-date "A Gregorian date without a time zone, in years 0000–9999."
  ^LocalDate [^Integer year ^Integer month ^Integer day]
  (LocalDate :year year :month month :day day))

(defn local-time "A time of day without a time zone, with seconds and nanoseconds defaulting to zero."
  (^LocalTime [^Integer hour ^Integer minute] (local-time hour minute 0 0))
  (^LocalTime [^Integer hour ^Integer minute ^Integer second] (local-time hour minute second 0))
  (^LocalTime [^Integer hour ^Integer minute ^Integer second ^Integer nanos]
   (LocalTime :hour hour :minute minute :second second :nanos nanos)))

(defn local-date-time "Combine a LocalDate and LocalTime without attaching a zone."
  ^LocalDateTime [^LocalDate date ^LocalTime clock]
  (LocalDateTime :date date :time clock))

(defn parse-local-date
  "Parse YYYY-MM-DD as a local date, or s as pattern says (see the patterns
  below: (parse-local-date \"11/03/2026\" \"%m/%d/%Y\")). A ParseError if
  it isn't one."
  (^LocalDate [^String s]
   (if-let [[_ year month day] (re-matches #"([0-9]{4})-([0-9]{2})-([0-9]{2})" s)]
     (parsing s "local date" (fn [] (apply local-date (map parse-long [year month day]))))
     (bad-text (str "Invalid local date " (pr-str s)) "local date")))
  (^LocalDate [^String s ^String pattern]
   (date-from-parts (parse-pattern s pattern "local date") s)))

(defn parse-local-time
  "Parse HH:MM, or HH:MM:SS with optional fractional seconds (truncating
  precision beyond nanoseconds), or s as pattern says (\"%I:%M %p\"). A
  ParseError if it isn't one."
  (^LocalTime [^String s]
   (if-let [[_ hour minute second fraction] (re-matches #"([0-9]{2}):([0-9]{2})(?::([0-9]{2})(?:\.([0-9]+))?)?" s)]
     (let [digits (or fraction "") nanos (parse-long (subs (str digits "000000000") 0 9))]
       (parsing s "local time" (fn [] (local-time (parse-long hour) (parse-long minute) (parse-long (or second "0")) nanos))))
     (bad-text (str "Invalid local time " (pr-str s)) "local time")))
  (^LocalTime [^String s ^String pattern]
   (time-from-parts (parse-pattern s pattern "local time") s)))

(defn parse-local-date-time
  "Parse a local date and time separated by T or a space, or s as pattern
  says (\"%d %b %Y %H:%M\"). A ParseError if it isn't one."
  (^LocalDateTime [^String s]
   (if-let [[_ date clock] (re-matches #"([0-9]{4}-[0-9]{2}-[0-9]{2})[Tt ](.+)" s)]
     (local-date-time (parse-local-date date) (parse-local-time clock))
     (bad-text (str "Invalid local date-time " (pr-str s)) "local date-time")))
  (^LocalDateTime [^String s ^String pattern]
   (let [parts (parse-pattern s pattern "local date-time")]
     (local-date-time (date-from-parts parts s) (time-from-parts parts s)))))

(defn format-local
  "Write a local date, local time or local date-time as ISO calendar text,
  or as pattern says (see the patterns below: (format-local d \"%d %b
  %Y\") is \"03 Nov 2026\")."
  (^String [^(U LocalDate LocalTime LocalDateTime) x ^String pattern] (format-pattern x pattern))
  (^String [^(U LocalDate LocalTime LocalDateTime) x]
   (cond (local-date? x) (skein.core/format "%04d-%02d-%02d" (:year x) (:month x) (:day x))
         (local-time? x) (str (skein.core/format "%02d:%02d:%02d" (:hour x) (:minute x) (:second x))
                              (when (pos? (:nanos x))
                                (str "." (str/replace (skein.core/format "%09d" (:nanos x)) #"0+$" ""))))
         (local-date-time? x) (str (format-local (:date x)) "T" (format-local (:time x)))
         :else (bad-value (str "Expected a local date or time, not " (pr-str x)) "a LocalDate, LocalTime or LocalDateTime" x))))

(defn now "The current instant (wall clock)." ^Instant [] (Instant :nanos (%now-nanos)))
(defn instant "The instant n nanoseconds after the epoch." ^Instant [^Integer n] (Instant :nanos n))
(defn of-epoch-ms "The instant ms milliseconds after the epoch." ^Instant [^Integer ms] (Instant :nanos (* ms 1000000)))
(defn epoch-ms "Instant i as milliseconds since the epoch (truncated toward zero)." ^Integer [^Instant i] (quot (:nanos i) 1000000))
(defn epoch-nanos "Instant i as nanoseconds since the epoch." ^Integer [^Instant i] (:nanos i))

(defn duration
  "(duration :hours 1 :minutes 30) — any of :days :hours :minutes :seconds :millis :nanos."
  ^Duration [& {:keys [days hours minutes seconds millis nanos]}]
  (Duration :nanos (+ (* (or days 0) 86400000000000) (* (or hours 0) 3600000000000)
                      (* (or minutes 0) 60000000000) (* (or seconds 0) 1000000000)
                      (* (or millis 0) 1000000) (or nanos 0))))
(defn nanos "Duration d in nanoseconds." ^Integer [^Duration d] (:nanos d))
(defn millis "Duration d in whole milliseconds, truncated toward zero." ^Integer [^Duration d] (quot (:nanos d) 1000000))
(defn seconds "Duration d in whole seconds, truncated toward zero." ^Integer [^Duration d] (quot (:nanos d) 1000000000))

(defn plus
  "An instant moved forward by a duration, or two durations added."
  ^(U Instant Duration) [^(U Instant Duration) x ^Duration d]
  (if (instant? x) (Instant :nanos (+ (:nanos x) (:nanos d))) (Duration :nanos (+ (:nanos x) (:nanos d)))))
(defn minus
  "An instant moved back by a duration, or one duration less another."
  ^(U Instant Duration) [^(U Instant Duration) x ^Duration d]
  (if (instant? x) (Instant :nanos (- (:nanos x) (:nanos d))) (Duration :nanos (- (:nanos x) (:nanos d)))))
(defn between "The duration from instant a to instant b." ^Duration [^Instant a ^Instant b]
  (Duration :nanos (- (:nanos b) (:nanos a))))

(def ^:private ns-per-second 1000000000)
(def ^:private ns-per-day 86400000000000)

(defn- floor-div [a b] (quot (- a (mod a b)) b))
(defn- seconds-of [i] (floor-div (:nanos i) ns-per-second))

;;; ---- zones ----

;; A zone: its transitions (seconds since the epoch, ascending), the local
;; time type index in effect from each, the types ({:offset :dst?
;; :abbreviation}; the first is in effect before any transition), and the
;; POSIX TZ rule for times after the last transition.
(defclass Zone ()
  ((name :required true) (times :initform []) (index :initform []) (types :initform []) (rule :initform nil))
  (:doc "A time zone: its offsets from UTC and when they change (from zone or
  system-zone)."))

(defmethod print-object ((z Zone)) (str "#<Zone " (:name z) ">"))

(defn zone? "Is x a Zone?" ^Boolean [x] (instance? Zone x))

(defn- hms
  "Seconds in POSIX TZ text [+-]h[:mm[:ss]]."
  [s]
  (let [[_ sign h m sec] (re-matches #"([+-]?)([0-9]+)(?::([0-9]+))?(?::([0-9]+))?" s)
        n (+ (* 3600 (parse-long h)) (* 60 (parse-long (or m "0"))) (parse-long (or sec "0")))]
    (if (= sign "-") (- n) n)))

(defn- posix-rule
  "A POSIX TZ string (\"EST5EDT,M3.2.0,M11.1.0\") as {:std {type} :dst {type}
  :start rule :end rule}, or nil if it isn't one."
  [s]
  (when-let [[_ std-name std-off dst-name dst-off start start-time end end-time]
             (re-matches #"(<[^>]*>|[A-Za-z]+)([+-]?[0-9:]+)(?:(<[^>]*>|[A-Za-z]+)([+-]?[0-9:]+)?(?:,([^,/]+)(?:/([+-]?[0-9:]+))?,([^,/]+)(?:/([+-]?[0-9:]+))?)?)?"
                         s)]
    (let [abbr (fn [n] (str/replace n #"[<>]" ""))
          std {:offset (- (hms std-off)) :dst? false :abbreviation (abbr std-name)}
          date-rule (fn [r t]
                      (let [at (if t (hms t) 7200)]
                        (if-let [[_ m w d] (re-matches #"M([0-9]+)\.([0-9])\.([0-9])" r)]
                          {:month (parse-long m) :week (parse-long w) :weekday (parse-long d) :at at}
                          (if-let [[_ n] (re-matches #"J([0-9]+)" r)]
                            {:julian (parse-long n) :at at}
                            {:yearday (parse-long r) :at at}))))]
      (if dst-name
        {:std std
         :dst {:offset (if dst-off (- (hms dst-off)) (+ (:offset std) 3600)) :dst? true :abbreviation (abbr dst-name)}
         :start (date-rule (or start "M3.2.0") start-time)
         :end (date-rule (or end "M11.1.0") end-time)}
        {:std std}))))

(defn days-in-month "The number of days in month (1–12) of year." ^Integer [^Integer year ^Integer month]
  (if (and (= month 2) (leap-year? year)) 29 (nth [31 28 31 30 31 30 31 31 30 31 30 31] (dec month))))

;; Days and dates, in whole days so any year a LocalDate holds works
;; (Howard Hinnant's algorithms; the proleptic Gregorian calendar).
(defn- days-from-civil [y m d]
  (let [y (if (<= m 2) (dec y) y)
        era (floor-div y 400)
        yoe (- y (* era 400))
        doy (+ (quot (+ (* 153 (if (> m 2) (- m 3) (+ m 9))) 2) 5) (dec d))
        doe (+ (* yoe 365) (quot yoe 4) (- (quot yoe 100)) doy)]
    (+ (* era 146097) doe -719468)))

(defn- civil-from-days
  "[year month day] of epoch day n."
  [n]
  (let [z (+ n 719468)
        era (floor-div z 146097)
        doe (- z (* era 146097))
        yoe (quot (+ doe (- (quot doe 1460)) (quot doe 36524) (- (quot doe 146096))) 365)
        doy (- doe (+ (* 365 yoe) (quot yoe 4) (- (quot yoe 100))))
        mp (quot (+ (* 5 doy) 2) 153)
        d (inc (- doy (quot (+ (* 153 mp) 2) 5)))
        m (if (< mp 10) (+ mp 3) (- mp 9))]
    [(+ yoe (* era 400) (if (<= m 2) 1 0)) m d]))

(defn- year-of-seconds [secs] (first (civil-from-days (floor-div secs 86400))))

(defn- time-nanos [t] (+ (* 3600000000000 (:hour t)) (* 60000000000 (:minute t)) (* ns-per-second (:second t)) (:nanos t)))

(defn- nanos-time [n]
  (local-time (quot n 3600000000000) (quot (mod n 3600000000000) 60000000000)
              (quot (mod n 60000000000) ns-per-second) (mod n ns-per-second)))

(defn- rule-day
  "The epoch day a POSIX date rule falls on in year y."
  [r y]
  (cond (:julian r) (let [n (:julian r)] (+ (days-from-civil y 1 1) (dec n) (if (and (leap-year? y) (>= n 60)) 1 0)))
        (:yearday r) (+ (days-from-civil y 1 1) (:yearday r))
        :else (let [first-day (days-from-civil y (:month r) 1)
                    ;; 1970-01-01 was a Thursday; 0 is Sunday here
                    first-match (+ first-day (mod (- (:weekday r) (mod (+ 4 first-day) 7)) 7))
                    last-day (+ first-day (dec (days-in-month y (:month r))))]
                (loop [d (+ first-match (* 7 (dec (:week r))))] (if (> d last-day) (recur (- d 7)) d)))))

(defn- rule-type
  "The local time type a POSIX rule gives at secs."
  [r secs]
  (if-not (:dst r)
    (:std r)
    (let [y (year-of-seconds (+ secs (:offset (:std r))))
          start (- (+ (* 86400 (rule-day (:start r) y)) (:at (:start r))) (:offset (:std r)))
          end (- (+ (* 86400 (rule-day (:end r) y)) (:at (:end r))) (:offset (:dst r)))]
      (if (if (< start end) (and (<= start secs) (< secs end)) (not (and (<= end secs) (< secs start))))
        (:dst r)
        (:std r)))))

(defn- type-at
  "The local time type ({:offset :dst? :abbreviation}) of zone z at secs
  seconds since the epoch."
  [z secs]
  (let [times (:times z) n (count times)]
    (cond (and (:rule z) (or (zero? n) (>= secs (nth times (dec n))))) (rule-type (:rule z) secs)
          (or (zero? n) (< secs (nth times 0))) (nth (:types z) 0)
          :else (loop [lo 0 hi (dec n)]   ; the last transition at or before secs
                  (if (< lo hi)
                    (let [mid (quot (+ lo hi 1) 2)] (if (<= (nth times mid) secs) (recur mid hi) (recur lo (dec mid))))
                    (nth (:types z) (nth (:index z) lo)))))))

(defn- tzif
  "Zone name from TZif data bs (RFC 8536): the 64-bit data and its
  footer rule when the file has them, else the 32-bit data."
  [name bs]
  (when-not (and (>= (count bs) 44) (= "TZif" (bytes->string (subbytes bs 0 4))))
    (bad-text (str "not a TZif zone file: " name) name))
  (let [u (fn [at width] (bytes/read-uint bs at width :be))
        s (fn [at width] (let [v (u at width) half (bit-shift-left 1 (dec (* 8 width)))]
                           (if (>= v half) (- v (* 2 half)) v)))
        block (fn [at width]
                (let [[isut isstd leap timecnt typecnt charcnt] (mapv #(u (+ at 20 (* 4 %)) 4) (range 6))
                      p-times (+ at 44)
                      p-index (+ p-times (* width timecnt))
                      p-types (+ p-index timecnt)
                      p-chars (+ p-types (* 6 typecnt))
                      abbr (fn [i] (let [start (+ p-chars i)
                                         end (loop [e start] (if (zero? (nth bs e)) e (recur (inc e))))]
                                     (bytes->string (subbytes bs start end))))]
                  {:times (mapv #(s (+ p-times (* width %)) width) (range timecnt))
                   :index (mapv #(nth bs (+ p-index %)) (range timecnt))
                   :types (mapv (fn [k] (let [q (+ p-types (* 6 k))]
                                          {:offset (s q 4) :dst? (= 1 (nth bs (+ q 4))) :abbreviation (abbr (nth bs (+ q 5)))}))
                                (range typecnt))
                   :end (+ p-chars charcnt (* leap (+ width 4)) isstd isut)}))
        v1 (block 0 4)]
    (if (= 0 (nth bs 4))
      (Zone :name name :times (:times v1) :index (:index v1) :types (:types v1))
      (let [v2 (block (:end v1) 8)
            footer (when (and (< (:end v2) (count bs)) (= 10 (nth bs (:end v2))))
                     (let [start (inc (:end v2))
                           end (loop [e start] (if (or (= e (count bs)) (= 10 (nth bs e))) e (recur (inc e))))]
                       (bytes->string (subbytes bs start end))))]
        (Zone :name name :times (:times v2) :index (:index v2) :types (:types v2)
              :rule (when (seq footer) (posix-rule footer)))))))

(defn- offset-text [secs]
  (let [a (abs secs)]
    (str (if (neg? secs) "-" "+") (skein.core/format "%02d:%02d" (quot a 3600) (quot (mod a 3600) 60))
         (when-not (zero? (mod a 60)) (skein.core/format ":%02d" (mod a 60))))))

(defn- fixed-zone [secs]
  (Zone :name (if (zero? secs) "UTC" (offset-text secs))
        :types [{:offset secs :dst? false :abbreviation (if (zero? secs) "UTC" (offset-text secs))}]))

(def utc "The UTC zone." (fixed-zone 0))

(def ^:private zone-cache (atom {}))
;; An image restored elsewhere reads that machine's zone files.
(swap! skein.core/%restore-hooks conj (fn [] (reset! zone-cache {})))

(defn zone-directories
  "Where zone files are looked for: $TZDIR, else the usual system places."
  ^Vector []
  (if-let [d (sys/getenv "TZDIR")]
    [d]
    ["/usr/share/zoneinfo" "/usr/lib/zoneinfo" "/usr/share/lib/zoneinfo" "/etc/zoneinfo"]))

(declare zone)

(defn system-zone
  "This machine's zone: $TZ (a zone name or a POSIX TZ string), else the
  zone /etc/localtime names or holds, else UTC."
  ^Zone []
  (let [tz (sys/getenv "TZ") tz (if (and tz (str/starts-with? tz ":")) (subs tz 1) tz)]
    (or (when (seq tz)
          (or (try (zone tz) (catch Error _ nil))
              (when-let [r (posix-rule tz)] (Zone :name tz :types [(:std r)] :rule r))))
        (when-let [c (try (io/canonical "/etc/localtime") (catch Error _ nil))]
          (when-let [i (str/last-index-of c "zoneinfo/")]
            (try (zone (subs c (+ i 9))) (catch Error _ nil))))
        (when (io/file? "/etc/localtime")
          (try (tzif "localtime" (io/read-bytes "/etc/localtime")) (catch Error _ nil)))
        utc)))

(defn- load-zone [name]
  (when-not (re-matches #"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*" name)
    (bad-text (str "not a zone name: " (pr-str name)) "time zone"))
  (if-let [f (first (filter io/file? (map #(io/path % name) (zone-directories))))]
    (tzif name (io/read-bytes f))
    (if (#{"UTC" "Etc/UTC" "GMT" "Etc/GMT"} name)
      (assoc utc :name name)
      (bad-text (str "unknown time zone " (pr-str name) " (looked in " (str/join ", " (zone-directories)) ")") "time zone"))))

(defn zone
  "The zone z names: an IANA name (\"America/New_York\"), \"+05:30\" or
  \"Z\", an offset in seconds, :utc, :local (system-zone), or a Zone
  (itself). Named zones are read once and kept. A name that isn't a zone
  here is a ParseError."
  ^Zone [^(U Zone String Integer Keyword) z]
  (cond (zone? z) z
        (= z :utc) utc
        (= z :local) (system-zone)
        (integer? z) (fixed-zone z)
        (= z "Z") utc
        (and (string? z) (re-matches #"[+-][0-9]{2}:[0-9]{2}(:[0-9]{2})?" z)) (fixed-zone (hms z))
        (string? z) (or (get @zone-cache z)
                        (let [loaded (load-zone z)] (swap! zone-cache assoc z loaded) loaded))
        :else (bad-value (str "not a zone: " (pr-str z)) "a zone name, an offset in seconds, :utc, :local or a Zone" z)))

(defn zone-name "Zone z's name." ^String [^(U Zone String Integer Keyword) z] (:name (zone z)))

(defn available-zones
  "The names of the zones in the first zone directory that exists, sorted."
  ^Vector []
  (if-let [root (first (filter io/directory? (zone-directories)))]
    (letfn [(walk [prefix dir]
                  (mapcat (fn [n]
                            (let [p (io/path dir n) full (str prefix n)]
                              (cond (#{"posix" "right" "Etc/posix"} full) []
                                    (io/directory? p) (walk (str full "/") p)
                                    (and (re-matches #"[A-Z][A-Za-z0-9_+-]*" n) (not (#{"SECURITY"} n))) [full]
                                    :else [])))
                          (io/list-dir dir)))]
      (vec (sort (walk "" root))))
    []))

(defn zone-info
  "{:offset (seconds) :dst? :abbreviation} for zone z at instant i (default now)."
  (^Map [^(U Zone String Integer Keyword) z] (zone-info z (now)))
  (^Map [^(U Zone String Integer Keyword) z ^Instant i] (type-at (zone z) (seconds-of i))))

(defn- offset-at [i z]
  (cond (or (nil? z) (= z :utc)) 0
        (= z :local) (%local-offset (seconds-of i))
        (integer? z) z
        :else (:offset (type-at (zone z) (seconds-of i)))))

(defn local-offset
  "This machine's UTC offset in seconds, now or at instant i."
  (^Integer [] (local-offset (now)))
  (^Integer [^Instant i] (offset-at i :local)))

;;; ---- zoned date-times ----

(defclass ZonedDateTime () ((instant :required true) (zone :required true) (offset :required true) (local :required true))
  (:doc "An instant as a date and time in a zone, with the offset in effect then
  (from zoned, in-zone or parse-zoned)."))

(defn zoned? "Is x a ZonedDateTime?" ^Boolean [x] (instance? ZonedDateTime x))

(defn- local-nanos
  "A local date-time's nanoseconds since 1970-01-01T00:00, as if in UTC."
  [ldt]
  (let [d (:date ldt)]
    (+ (* ns-per-day (days-from-civil (:year d) (:month d) (:day d))) (time-nanos (:time ldt)))))

(defn- civil->local
  "The wall-clock time n nanoseconds after the epoch, at offset (seconds)."
  [n offset]
  (let [l (+ n (* offset ns-per-second)) [y m d] (civil-from-days (floor-div l ns-per-day))]
    (local-date-time (local-date y m d) (nanos-time (mod l ns-per-day)))))

(defn in-zone
  "Instant i as a ZonedDateTime in zone z (anything zone accepts)."
  ^ZonedDateTime [^Instant i ^(U Zone String Integer Keyword) z]
  (let [z (zone z) o (:offset (type-at z (seconds-of i)))]
    (ZonedDateTime :instant i :zone z :offset o :local (civil->local (:nanos i) o))))

(defn- local-text [ldt] (format-local ldt))

(defn zoned
  "Local date-time ldt in zone z, as a ZonedDateTime. A wall-clock time the
  zone skips or repeats is resolved by :resolve — :compatible (default;
  later for skipped, earlier for repeated), :earlier, :later or :reject
  (a TypeError).
  :offset (seconds) picks that offset when it's one of the valid ones."
  ^ZonedDateTime
  [^LocalDateTime ldt ^(U Zone String Integer Keyword) z & {:keys [resolve offset] :or {resolve :compatible}}]
  (when-not (#{:compatible :earlier :later :reject} resolve)
    (bad-value (str ":resolve is :compatible, :earlier, :later or :reject, not " (pr-str resolve)) ":compatible, :earlier, :later or :reject" resolve))
  (let [z (zone z)
        l (local-nanos ldt)
        secs (floor-div l ns-per-second)
        before (:offset (type-at z (- secs 86400)))
        after (:offset (type-at z (+ secs 86400)))
        ;; offsets that give back this wall-clock time, the earlier instant first
        valid (vec (sort > (filter (fn [o] (= o (:offset (type-at z (floor-div (- l (* o ns-per-second)) ns-per-second)))))
                                   (distinct [before after]))))
        at (fn [o] (in-zone (Instant :nanos (- l (* o ns-per-second))) z))]
    (cond (and offset (some #(= offset %) valid)) (at offset)
          (= 1 (count valid)) (at (first valid))
          (seq valid) (case resolve
                        (:compatible :earlier) (at (first valid))
                        :later (at (peek valid))
                        :reject (bad-value (str (local-text ldt) " happens twice in " (:name z)
                                                " (a clock change repeats it); pass :resolve :earlier or :later")
                                           "a wall-clock time that happens once" ldt))
          :else (case resolve
                  (:compatible :later) (at before)
                  :earlier (at after)
                  :reject (bad-value (str (local-text ldt) " doesn't exist in " (:name z)
                                          " (a clock change skips it); pass :resolve :earlier or :later")
                                     "a wall-clock time that happens once" ldt)))))

(defn today
  "Today's date where this machine is (:local), or in zone z: a LocalDate."
  (^LocalDate [] (today :local))
  (^LocalDate [^(U Zone String Integer Keyword) z] (:date (:local (in-zone (now) z)))))

(defn local-now
  "The date and time now where this machine is (:local), or in zone z: a
  LocalDateTime."
  (^LocalDateTime [] (local-now :local))
  (^LocalDateTime [^(U Zone String Integer Keyword) z] (:local (in-zone (now) z))))

(defn to-instant "The instant of a ZonedDateTime (an Instant is itself)." ^Instant [^(U ZonedDateTime Instant) x]
  (if (zoned? x) (:instant x) x))

(defn- parse-iso
  "[nanos offset] of RFC 3339 text s, or a ParseError."
  [s]
  (handler-case (%parse-iso s)
    (Error [e] (bad-text (condition-message e) "RFC 3339"))))

(defn format-zoned
  "A ZonedDateTime as RFC 9557 text: 2026-03-08T03:30:00-04:00[America/New_York];
  or as pattern says (\"%F %H:%M %Z\")."
  (^String [^ZonedDateTime z]
   (str (%format-iso (:nanos (:instant z)) (:offset z)) "[" (:name (:zone z)) "]"))
  (^String [^ZonedDateTime z ^String pattern] (format-pattern z pattern)))

(defn parse-zoned
  "The ZonedDateTime written as RFC 9557 text (format-zoned's), or as RFC
  3339 text, whose offset is then its zone. A bracketed zone must have
  the offset given at that wall-clock time (to the minute). A ParseError
  if it isn't one. With pattern, s as it says, which must give the offset
  (%z): the offset is then its zone."
  (^ZonedDateTime [^String s ^String pattern]
   (let [parts (parse-pattern s pattern "zoned date-time")]
     (when-not (:offset parts) ((:bad parts) "the pattern gives no offset (%z)"))
     (zoned (local-date-time (date-from-parts parts s) (time-from-parts parts s)) (:offset parts))))
  (^ZonedDateTime [^String s]
   (if-let [[_ text zname] (re-matches #"(.*)\[([^\]]+)\]" s)]
     ;; The wall-clock time written, in that zone at the offset given (to
     ;; the minute, as text can't hold an offset's seconds).
     (let [[n o] (parse-iso text)
           l (civil->local n o)
           z (zone zname)]
       (or (first (filter #(and (= l (:local %)) (< (abs (- (:offset %) o)) 60))
                          [(zoned l z :resolve :earlier) (zoned l z :resolve :later)]))
           (bad-text (str (pr-str s) ": " (:name z) " isn't at offset " (offset-text o) " then") "RFC 9557")))
     (let [[n o] (parse-iso s)] (in-zone (Instant :nanos n) o)))))

;;; ---- calendar arithmetic ----

(defn- as-date [x]
  (cond (local-date? x) x
        (local-date-time? x) (:date x)
        (zoned? x) (:date (:local x))
        :else (bad-value (str "expected a date, not " (pr-str x)) "a LocalDate, LocalDateTime or ZonedDateTime" x)))

(defn epoch-day "Days from 1970-01-01 to the date of x (a date, date-time or zoned date-time)."
  ^Integer [^(U LocalDate LocalDateTime ZonedDateTime) x]
  (let [d (as-date x)] (days-from-civil (:year d) (:month d) (:day d))))

(defn from-epoch-day "The LocalDate n days after 1970-01-01." ^LocalDate [^Integer n]
  (apply local-date (civil-from-days n)))

(defn weekday "The weekday of x's date: 1 = Monday … 7 = Sunday."
  ^Integer [^(U LocalDate LocalDateTime ZonedDateTime) x]
  (inc (mod (+ (epoch-day x) 3) 7)))

(defn day-of-year "The day of the year of x's date, from 1." ^Integer [^(U LocalDate LocalDateTime ZonedDateTime) x]
  (inc (- (epoch-day x) (days-from-civil (:year (as-date x)) 1 1))))

(defn days-between "Days from the date of a to the date of b."
  ^Integer [^(U LocalDate LocalDateTime ZonedDateTime) a ^(U LocalDate LocalDateTime ZonedDateTime) b]
  (- (epoch-day b) (epoch-day a)))

(defn months-between
  "Whole months from the date of a to the date of b (negative if b is
  earlier): 2026-01-31 to 2026-02-28 is 0, to 2026-03-01 is 1."
  ^Integer [^(U LocalDate LocalDateTime ZonedDateTime) a ^(U LocalDate LocalDateTime ZonedDateTime) b]
  (let [a (as-date a) b (as-date b)
        m (- (+ (* 12 (:year b)) (:month b)) (+ (* 12 (:year a)) (:month a)))]
    (cond (and (pos? m) (< (:day b) (:day a))) (dec m)
          (and (neg? m) (> (:day b) (:day a))) (inc m)
          :else m)))

(defn- plus-months [d n]
  (if (zero? n)
    d
    (let [total (+ (* 12 (:year d)) (dec (:month d)) n)
          y (floor-div total 12) m (inc (mod total 12))]
      (local-date y m (min (:day d) (days-in-month y m))))))

(defn shift
  "x moved by :years :months :weeks :days :hours :minutes :seconds :millis
  :nanos (any of them, negative to go back). Years and months move along
  the calendar, a day past the month's end becoming its last
  (2026-01-31 + 1 month is 2026-02-28); then weeks and days.
    LocalDate: date units only.
    LocalDateTime: time units carry into days.
    ZonedDateTime: date units keep the wall-clock time (resolved by
      :resolve as in zoned, keeping the offset when it still holds), then
      time units move along the time line (an hour is always an hour).
    Instant: time units only."
  ^(U LocalDate LocalDateTime ZonedDateTime Instant)
  [^(U LocalDate LocalDateTime ZonedDateTime Instant) x
   & {:keys [years months weeks days hours minutes seconds millis nanos resolve] :or {resolve :compatible}}]
  (let [months (+ (* 12 (or years 0)) (or months 0))
        days (+ (* 7 (or weeks 0)) (or days 0))
        span (+ (* (or hours 0) 3600000000000) (* (or minutes 0) 60000000000) (* (or seconds 0) ns-per-second)
                (* (or millis 0) 1000000) (or nanos 0))
        move-date (fn [d] (let [d (plus-months d months)] (if (zero? days) d (from-epoch-day (+ (epoch-day d) days)))))]
    (cond (local-date? x)
          (do (when-not (zero? span) (bad-value "shift: a LocalDate has no time of day to move" "date units only" x))
              (move-date x))
          (local-date-time? x)
          (let [n (+ (time-nanos (:time x)) span)]
            (local-date-time (from-epoch-day (+ (epoch-day (move-date (:date x))) (floor-div n ns-per-day)))
                             (nanos-time (mod n ns-per-day))))
          (zoned? x)
          (let [l (:local x)
                z (if (and (zero? months) (zero? days))
                    x
                    (zoned (local-date-time (move-date (:date l)) (:time l)) (:zone x) :resolve resolve :offset (:offset x)))]
            (if (zero? span) z (in-zone (Instant :nanos (+ (:nanos (:instant z)) span)) (:zone x))))
          (instant? x)
          (do (when-not (and (zero? months) (zero? days))
                (bad-value "shift: an Instant has no calendar; use in-zone first, or :hours" "time units only" x))
              (Instant :nanos (+ (:nanos x) span)))
          :else (bad-value (str "shift: expected a date, date-time, zoned date-time or instant, not " (pr-str x))
                           "a LocalDate, LocalDateTime, ZonedDateTime or Instant" x))))

(defn start-of-day
  "The first instant of date d (a LocalDate, or the date of a date-time
  or zoned date-time) in zone z, as a
  ZonedDateTime: midnight, or the first time after it when a clock change
  skips midnight there."
  ^ZonedDateTime [^(U LocalDate LocalDateTime ZonedDateTime) d ^(U Zone String Integer Keyword) z]
  (zoned (local-date-time (as-date d) (local-time 0 0)) z :resolve :later))

;;; ---- comparing ----

(defn compare-time
  "Like compare, for two instants, durations, zoned date-times (by
  instant), local dates, local times or local date-times."
  ^Integer [^(U Instant Duration ZonedDateTime LocalDate LocalTime LocalDateTime) a
            ^(U Instant Duration ZonedDateTime LocalDate LocalTime LocalDateTime) b]
  (cond (or (zoned? a) (zoned? b)) (compare (:nanos (to-instant a)) (:nanos (to-instant b)))
        (local-date? a) (compare (epoch-day a) (epoch-day b))
        (local-time? a) (compare (time-nanos a) (time-nanos b))
        (local-date-time? a) (compare (local-nanos a) (local-nanos b))
        :else (compare (:nanos a) (:nanos b))))

(defn before? "Is a earlier than b? (Anything compare-time takes.)"
  ^Boolean [^(U Instant Duration ZonedDateTime LocalDate LocalTime LocalDateTime) a
            ^(U Instant Duration ZonedDateTime LocalDate LocalTime LocalDateTime) b]
  (neg? (compare-time a b)))
(defn after? "Is a later than b?"
  ^Boolean [^(U Instant Duration ZonedDateTime LocalDate LocalTime LocalDateTime) a
            ^(U Instant Duration ZonedDateTime LocalDate LocalTime LocalDateTime) b]
  (pos? (compare-time a b)))

;;; ---- fields and text ----

(defn fields
  "Calendar fields of instant i: {:year :month :day :hour :minute :second
  :nanos :weekday (1 = Monday) :yearday :offset}. zone: :utc (default),
  :local, an offset in seconds, or a named zone (anything zone takes). A
  ZonedDateTime gives its own fields."
  (^Map [^(U Instant ZonedDateTime) i] (if (zoned? i) (fields (:instant i) (:offset i)) (fields i :utc)))
  (^Map [^(U Instant ZonedDateTime) i ^(? (U Zone String Integer Keyword)) zone]
   (let [i (to-instant i)
         o (offset-at i zone)
         [y mo d h mi s ns wd yd] (%civil (:nanos i) o)]
     {:year y :month mo :day d :hour h :minute mi :second s :nanos ns :weekday wd :yearday yd :offset o})))

(defn from-fields
  "The instant of {:year :month :day :hour :minute :second :nanos :offset}
  (missing time fields are 0; :offset in seconds, default 0 = UTC). Fields
  that don't make a date-time are a TypeError."
  ^Instant [^Map m]
  (Instant :nanos (handler-case (%from-civil [(:year m) (:month m) (:day m) (or (:hour m) 0) (or (:minute m) 0)
                                              (or (:second m) 0) (or (:nanos m) 0)]
                                             (or (:offset m) 0))
                    (Error [e] (bad-value (condition-message e) "calendar fields of a date-time" m)))))

(defn format
  "RFC 3339 text of instant i, e.g. 2026-11-13T07:05:00Z. zone as for
  fields; a ZonedDateTime is written at its own offset. With pattern, i in
  zone written as it says (see the patterns below)."
  (^String [^(U Instant ZonedDateTime) i] (if (zoned? i) (format (:instant i) (:offset i)) (format i :utc)))
  (^String [^(U Instant ZonedDateTime) i ^(? (U Zone String Integer Keyword)) zone]
   (let [i (to-instant i)] (%format-iso (:nanos i) (offset-at i zone))))
  (^String [^(U Instant ZonedDateTime) i ^(? (U Zone String Integer Keyword)) zone ^String pattern]
   (format-pattern (in-zone (to-instant i) (or zone :utc)) pattern)))

(defn parse
  "The instant written as RFC 3339 text (2026-11-13T07:05:00Z,
  2026-11-13T08:05:00.5+01:00, or a date alone for midnight UTC). A
  ParseError if it isn't one."
  ^Instant [^String s]
  (Instant :nanos (first (parse-iso s))))

(defn monotonic-nanos
  "A clock for measuring elapsed time: it never jumps, but has no epoch."
  ^Integer []
  (nano-time))

(defn sleep-for "Sleep for a duration." [^Duration d] (sleep (millis d)))

;;; ---- patterns (strftime) ----
;;;
;;; format-local, format-zoned and format take a pattern, as do
;;; parse-local-date, parse-local-time, parse-local-date-time and
;;; parse-zoned: text with directives, as C's strftime and strptime have.
;;;
;;;   %Y year (2026)    %y year in two digits   %m month (01–12)   %d day (01–31)
;;;   %e day, space-padded   %j day of the year (001–366)
;;;   %b month's name, short (Nov)   %B in full (November)
;;;   %a weekday's name, short (Mon)   %A in full (Monday)
;;;   %H hour (00–23)   %I hour (01–12)   %p AM or PM   %M minute   %S second
;;;   %f microseconds (6 digits; read: 1–9 digits of a fraction)
;;;   %z offset (+0100; read: +01:00 and Z too)   %Z zone name (written only)
;;;   %F is %Y-%m-%d   %T is %H:%M:%S   %% a %
;;;
;;; Names are English. Reading, numbers may have fewer digits than written
;;; (3/7/2026 with %m/%d/%Y), case doesn't matter, a month's name may be
;;; short or full, whitespace matches any whitespace, and a weekday must be
;;; the date's. A two-digit year is 1969–2068, as POSIX has it.

(def ^:private month-names
  ["January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"])
(def ^:private day-names ["Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday" "Sunday"])

(def ^:private directives (set "YymdejbBaAHIpMSfzZ"))

(defn- bad-pattern [p why]
  (bad-value (str "pattern " (pr-str p) ": " why) "a strftime pattern" p))

(defn- pattern-tokens
  "Pattern p as tokens: literal text (strings) and directives (characters)."
  [p]
  (loop [i 0 lit "" out []]
    (let [flush (fn [] (if (seq lit) (conj out lit) out))]
      (if (>= i (count p))
        (flush)
        (let [c (nth p i)]
          (if (= c \%)
            (let [d (nth p (inc i) nil)]
              (cond (nil? d) (bad-pattern p "it ends with %")
                    (= d \%) (recur (+ i 2) (str lit "%") out)
                    (= d \F) (recur (+ i 2) "" (into (flush) [\Y "-" \m "-" \d]))
                    (= d \T) (recur (+ i 2) "" (into (flush) [\H ":" \M ":" \S]))
                    (contains? directives d) (recur (+ i 2) "" (conj (flush) d))
                    :else (bad-pattern p (str "%" d " isn't a directive"))))
            (recur (inc i) (str lit c) out)))))))

(defn- pad [n width] (skein.core/format (str "%0" width "d") n))

(defn- parts-of
  "The fields of x the directives write."
  [x]
  (cond (local-date? x) {:year (:year x) :month (:month x) :day (:day x) :weekday (weekday x) :yearday (day-of-year x)}
        (local-time? x) {:hour (:hour x) :minute (:minute x) :second (:second x) :nanos (:nanos x)}
        (local-date-time? x) (merge (parts-of (:date x)) (parts-of (:time x)))
        (zoned? x) (assoc (parts-of (:local x)) :offset (:offset x) :zone (:name (:zone x)))
        :else (bad-value (str "Expected a date or time, not " (pr-str x)) "a LocalDate, LocalTime, LocalDateTime or ZonedDateTime" x)))

(defn- format-pattern
  "x (anything parts-of takes) written as pattern says."
  [x pattern]
  (let [parts (parts-of x)]
    (apply str
           (for [t (pattern-tokens pattern)]
             (if (string? t)
               t
               (let [need (fn [k] (let [v (get parts k)]
                                    (if (nil? v)
                                      (bad-value (str "%" t " writes the " (name k) ", which " (pr-str x) " hasn't got")
                                                 "a value with that field" x)
                                      v)))]
                 (case t
                   \Y (pad (need :year) 4)
                   \y (pad (mod (need :year) 100) 2)
                   \m (pad (need :month) 2)
                   \d (pad (need :day) 2)
                   \e (skein.core/format "%2d" (need :day))
                   \j (pad (need :yearday) 3)
                   \b (subs (nth month-names (dec (need :month))) 0 3)
                   \B (nth month-names (dec (need :month)))
                   \a (subs (nth day-names (dec (need :weekday))) 0 3)
                   \A (nth day-names (dec (need :weekday)))
                   \H (pad (need :hour) 2)
                   \I (pad (let [h (mod (need :hour) 12)] (if (zero? h) 12 h)) 2)
                   \p (if (< (need :hour) 12) "AM" "PM")
                   \M (pad (need :minute) 2)
                   \S (pad (need :second) 2)
                   \f (pad (quot (need :nanos) 1000) 6)
                   \z (let [o (need :offset) a (abs o)]
                        (str (if (neg? o) "-" "+") (pad (quot a 3600) 2) (pad (quot (mod a 3600) 60) 2)))
                   \Z (need :zone))))))))

(defn- regex-quote [s]
  (str/replace s #"[\\^$.|?*+()\[\]{}]" (fn [m] (str "\\" m))))

(def ^:private directive-regex
  {\Y "(\\d{4})" \y "(\\d{2})" \m "(\\d{1,2})" \d "(\\d{1,2})" \e "\\s?(\\d{1,2})" \j "(\\d{1,3})"
   \b "([A-Za-z]+)" \B "([A-Za-z]+)" \a "([A-Za-z]+)" \A "([A-Za-z]+)"
   \H "(\\d{1,2})" \I "(\\d{1,2})" \p "([AaPp][Mm])" \M "(\\d{1,2})" \S "(\\d{1,2})" \f "(\\d{1,9})"
   \z "(Z|z|[+-]\\d{2}:?\\d{2})"})

(defn- name-index
  "The 1-based index of name s in names, by its first three letters or in
  full (case aside), or nil."
  [names s]
  (let [s (str/lower-case s)]
    (some (fn [[i n]] (let [n (str/lower-case n)] (when (or (= s n) (= s (subs n 0 3))) (inc i))))
          (map-indexed vector names))))

(defn- parse-pattern
  "The fields text s gives, read as pattern says, or a ParseError (source
  names what was being read)."
  [s pattern source]
  (let [tokens (pattern-tokens pattern)
        _ (when (some #{\Z} tokens) (bad-pattern pattern "%Z is written, not read: read the offset with %z"))
        regex (re-pattern (apply str (for [t tokens]
                                       (if (string? t)
                                         (str/replace (regex-quote t) #"\s+" "\\s+")
                                         (directive-regex t)))))
        groups (rest (re-matches regex s))
        bad (fn [why] (bad-text (str "Invalid " source " " (pr-str s) " for " (pr-str pattern) (when why (str ": " why))) source))]
    (when (empty? groups) (bad nil))
    (let [found (zipmap (filter char? tokens) groups)
          num (fn [d] (some-> (get found d) parse-long))
          year (or (num \Y) (some-> (num \y) (as-> y (if (< y 69) (+ 2000 y) (+ 1900 y)))))
          month (or (num \m) (when-let [n (or (get found \b) (get found \B))]
                               (or (name-index month-names n) (bad (str "no month " (pr-str n))))))
          hour (if (num \I)
                 (let [h (num \I) pm (= "pm" (some-> (get found \p) str/lower-case))]
                   (when-not (<= 1 h 12) (bad (str "hour " h " with %I")))
                   (+ (mod h 12) (if pm 12 0)))
                 (num \H))
          weekday (when-let [n (or (get found \a) (get found \A))]
                    (or (name-index day-names n) (bad (str "no weekday " (pr-str n)))))
          offset (when-let [z (get found \z)]
                   (if (contains? #{"Z" "z"} z)
                     0
                     (let [[_ sign h m] (re-matches #"([+-])(\d{2}):?(\d{2})" z)]
                       (* (if (= sign "-") -1 1) (+ (* 3600 (parse-long h)) (* 60 (parse-long m)))))))]
      {:year year :month month :day (or (num \d) (num \e)) :yearday (num \j) :weekday weekday
       :hour hour :minute (num \M) :second (num \S)
       :nanos (some-> (get found \f) (as-> f (parse-long (subs (str f "000000000") 0 9))))
       :offset offset :bad bad})))

(defn- date-from-parts [{:keys [year month day yearday weekday bad]} s]
  (when-not year (bad "the pattern gives no year"))
  (when-not (or (and month day) yearday) (bad "the pattern gives no month and day, or day of the year"))
  (when (and yearday (not (and month day)) (not (<= 1 yearday (if (leap-year? year) 366 365))))
    (bad (str "no day " yearday " in " year)))
  (let [d (parsing s "local date"
                   (fn [] (if (and month day)
                            (local-date year month day)
                            (from-epoch-day (+ (days-from-civil year 1 1) (dec yearday))))))]
    (when (and weekday (not= weekday (weekday-of d)))
      (bad (str "it's a " (nth day-names (dec (weekday-of d))) ", not a " (nth day-names (dec weekday)))))
    d))

(defn- weekday-of [d] (weekday d))

(defn- time-from-parts [{:keys [hour minute second nanos bad]} s]
  (when-not hour (bad "the pattern gives no hour"))
  (parsing s "local time" (fn [] (local-time hour (or minute 0) (or second 0) (or nanos 0)))))

;;; ---- printing ----
;;;
;;; Instants, dates and times print as tagged literals the reader and EDN
;;; read back (#inst "2026-11-13T07:05:00Z", #skein/date "2026-11-03"…),
;;; and as their text for people (str, print).

(defmethod tagged-form ((i Instant)) ['inst (format i)])
(defmethod tagged-form ((d LocalDate)) ['skein/date (format-local d)])
(defmethod tagged-form ((x LocalTime)) ['skein/time (format-local x)])
(defmethod tagged-form ((x LocalDateTime)) ['skein/date-time (format-local x)])
(defmethod tagged-form ((z ZonedDateTime)) ['skein/zoned (format-zoned z)])

(defmethod print-object ((i Instant)) (if *print-readably* (tagged-text i) (format i)))
(defmethod print-object ((d LocalDate)) (if *print-readably* (tagged-text d) (format-local d)))
(defmethod print-object ((x LocalTime)) (if *print-readably* (tagged-text x) (format-local x)))
(defmethod print-object ((x LocalDateTime)) (if *print-readably* (tagged-text x) (format-local x)))
(defmethod print-object ((z ZonedDateTime)) (if *print-readably* (tagged-text z) (format-zoned z)))
