;;;; skein.toml — TOML 1.0 (M9 part 9.12): configuration files as maps.
;;;;
;;;;   (read-string "title = \"x\"\n[owner]\nname = \"Ada\"\n")
;;;;   ; => {:title "x" :owner {:name "Ada"}}
;;;;   (write-string {:title "x" :owner {:name "Ada"}})
;;;;
;;;; Tables are maps (keys as keywords; :keys identity keeps them strings),
;;;; arrays vectors, and strings, integers, floats (##Inf, ##NaN) and
;;;; booleans themselves. An offset date-time (1979-05-27T07:32:00Z) is a
;;;; skein.time instant; :local-times true reads local dates and times as
;;;; skein.time values. They stay strings by default. A key or table defined twice is an error, as the
;;;; spec says, and so is anything else that isn't TOML, with its line.

(ns skein.toml
  (:refer-core :exclude [read-string])
  (:require [skein.io :as io] [skein.string :as str] [skein.time :as t]))

;; ---- reading ----

(defn- parse-radix
  "The integer the digits of s write in base radix (2, 8 or 16), or nil."
  [s radix]
  (reduce (fn [acc c]
            (let [d (%str-index "0123456789abcdef" (str/lower-case (str c)) nil false)]
              (if (and d (< d radix)) (+ (* acc radix) d) (reduced nil))))
          0 s))

(defn- fail! [st msg]
  (let [{:keys [cs i]} @st
        line (inc (count (filter (fn [c] (= c \newline)) (subvec cs 0 (min i (count cs))))))]
    (error ParseError :message (str "TOML, line " line ": " msg) :source "TOML" :line line)))

(defn- peek-c ([st] (peek-c st 0)) ([st k] (let [{:keys [cs i]} @st] (get cs (+ i k)))))
(defn- next-c! [st] (let [c (peek-c st)] (swap! st update :i inc) c))
(defn- looking-at? [st s] (every? true? (map-indexed (fn [k c] (= c (peek-c st k))) s)))
(defn- skip! [st n] (swap! st update :i + n))

(defn- skip-ws! [st] (while (contains? #{\space \tab} (peek-c st)) (skip! st 1)))

(defn- skip-comment! [st]
  (when (= \# (peek-c st))
    (while (and (peek-c st) (not= \newline (peek-c st)))
      (let [c (next-c! st)]
        (when (and (< (int c) 32) (not= c \tab)) (fail! st "a control character in a comment"))))))

(defn- end-of-line! [st]
  (skip-ws! st)
  (skip-comment! st)
  (cond (nil? (peek-c st)) nil
        (= \newline (peek-c st)) (skip! st 1)
        (and (= \return (peek-c st)) (= \newline (peek-c st 1))) (skip! st 2)
        :else (fail! st (str "more on the line: " (pr-str (peek-c st))))))

(defn- skip-blank! [st]
  ;; (whitespace, comments and line breaks: between array items)
  (loop []
    (skip-ws! st)
    (skip-comment! st)
    (cond (= \newline (peek-c st)) (do (skip! st 1) (recur))
          (and (= \return (peek-c st)) (= \newline (peek-c st 1))) (do (skip! st 2) (recur)))))

(defn- bare-key-char? [c]
  (and c (or (<= (int \a) (int c) (int \z)) (<= (int \A) (int c) (int \Z)) (<= (int \0) (int c) (int \9)) (= c \_) (= c \-))))

(defn- hex-char [st n]
  (let [h (apply str (repeatedly n (fn [] (or (next-c! st) (fail! st "an escape ends too soon")))))
        cp (or (parse-radix h 16) (fail! st (str "not hex: " h)))]
    (when (or (nil? cp) (<= 0xD800 cp 0xDFFF) (> cp 0x10FFFF)) (fail! st (str "not a Unicode scalar value: " h)))
    (char cp)))

(defn- escape! [st]
  (let [c (next-c! st)]
    (case c
      \b \backspace \t \tab \n \newline \f \formfeed \r \return \" \" \\ \\ \e (char 27)
      \u (hex-char st 4)
      \U (hex-char st 8)
      (fail! st (str "an unknown escape: \\" c)))))

(defn- basic-string! [st]
  (skip! st 1)
  (loop [out (transient [])]
    (let [c (next-c! st)]
      (cond (nil? c) (fail! st "a string isn't closed")
            (= c \") (str/join (persistent! out))
            (= c \\) (recur (conj! out (escape! st)))
            (= c \newline) (fail! st "a line break in a one-line string")
            (and (< (int c) 32) (not= c \tab)) (fail! st "a control character in a string")
            :else (recur (conj! out c))))))

(defn- literal-string! [st]
  (skip! st 1)
  (loop [out (transient [])]
    (let [c (next-c! st)]
      (cond (nil? c) (fail! st "a string isn't closed")
            (= c \') (str/join (persistent! out))
            (= c \newline) (fail! st "a line break in a one-line string")
            :else (recur (conj! out c))))))

(defn- multiline! [st quote basic?]
  (skip! st 3)
  ;; (a line break right after the opening quotes isn't part of it)
  (cond (= \newline (peek-c st)) (skip! st 1)
        (and (= \return (peek-c st)) (= \newline (peek-c st 1))) (skip! st 2))
  (loop [out (transient [])]
    (let [c (peek-c st)]
      (cond (nil? c) (fail! st "a multi-line string isn't closed")
            (and (= c quote) (= quote (peek-c st 1)) (= quote (peek-c st 2)))
            ;; (up to two quotes may end the content, just before the closing three)
            (let [extra (cond (and (= quote (peek-c st 3)) (= quote (peek-c st 4))) 2 (= quote (peek-c st 3)) 1 :else 0)]
              (skip! st (+ 3 extra))
              (str/join (persistent! (reduce conj! out (repeat extra quote)))))
            (and basic? (= c \\))
            (do (skip! st 1)
                (if (contains? #{\space \tab \newline \return} (peek-c st))
                  ;; (a backslash ending a line: the break and the whitespace after it go)
                  (do (while (contains? #{\space \tab \newline \return} (peek-c st)) (skip! st 1)) (recur out))
                  (recur (conj! out (escape! st)))))
            :else (do (skip! st 1) (recur (conj! out c)))))))

(defn- key-part! [st]
  (skip-ws! st)
  (let [c (peek-c st)]
    (cond (= c \") (basic-string! st)
          (= c \') (literal-string! st)
          (bare-key-char? c) (loop [out []] (if (bare-key-char? (peek-c st)) (recur (conj out (next-c! st))) (apply str out)))
          :else (fail! st (str "a key expected, not " (pr-str c))))))

(defn- dotted-key! [st]
  (loop [parts [(key-part! st)]]
    (skip-ws! st)
    (if (= \. (peek-c st))
      (do (skip! st 1) (recur (conj parts (key-part! st))))
      parts)))

(def ^:private datetime-re
  #"^(\d{4}-\d{2}-\d{2})(?:[Tt ](\d{2}:\d{2}:\d{2}(?:\.\d+)?)(Z|z|[+-]\d{2}:\d{2})?)?$")
(def ^:private time-re #"^\d{2}:\d{2}:\d{2}(?:\.\d+)?$")

(defn- local-time-value! [st parse token]
  (try (parse token)
       (catch Error e (fail! st (condition-message e)))))

(defn- number-or-date! [st opts]
  (let [token (loop [out []]
                (let [c (peek-c st)]
                  (if (and c (or (bare-key-char? c) (contains? #{\+ \. \: \Z \z} c)
                                 ;; (a space inside a date-time: 1979-05-27 07:32:00)
                                 (and (= c \space) (re-find #"^\d{4}-\d{2}-\d{2}$" (apply str out)) (re-find #"\d" (str (peek-c st 1))))))
                    (do (skip! st 1) (recur (conj out c)))
                    (apply str out))))
        clean (str/replace token "_" "")
        bad (fn [] (fail! st (str "not a value: " (pr-str token))))]
    ;; (every underscore needs a digit on each side: 1_000, 0xdead_beef)
    (when (or (str/starts-with? token "_") (str/ends-with? token "_")
              (re-find (if (str/starts-with? token "0x") #"[^0-9a-fA-F]_|_[^0-9a-fA-F]" #"[^0-9]_|_[^0-9]") token))
      (bad))
    (cond
      (contains? #{"true" "false"} token) (= token "true")
      (contains? #{"inf" "+inf"} token) ##Inf
      (= token "-inf") ##-Inf
      (contains? #{"nan" "+nan" "-nan"} token) ##NaN
      (re-find #"^0x[0-9a-fA-F]+$" clean) (parse-radix (subs clean 2) 16)
      (re-find #"^0o[0-7]+$" clean) (parse-radix (subs clean 2) 8)
      (re-find #"^0b[01]+$" clean) (parse-radix (subs clean 2) 2)
      (re-find #"^[+-]?(0|[1-9]\d*)$" clean) (parse-long (str/replace clean "+" ""))
      (re-find #"^[+-]?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?$" clean)
      (if (or (str/includes? clean ".") (str/includes? clean "e") (str/includes? clean "E"))
        (parse-double clean)
        (bad))
      (re-find datetime-re token)
      (let [[_ _date time zone] (re-find datetime-re token)]
        (cond zone (t/parse (str/upper-case (str/replace token " " "T")))
              (not (:local-times opts)) token
              time (local-time-value! st t/parse-local-date-time token)
              :else (local-time-value! st t/parse-local-date token)))
      (re-find time-re token) (if (:local-times opts) (local-time-value! st t/parse-local-time token) token)
      :else (bad))))

(declare value!)

(defn- array! [st opts]
  (skip! st 1)
  (loop [out []]
    (skip-blank! st)
    (if (= \] (peek-c st))
      (do (skip! st 1) out)
      (let [v (value! st opts)]
        (skip-blank! st)
        (cond (= \, (peek-c st)) (do (skip! st 1) (recur (conj out v)))
              (= \] (peek-c st)) (do (skip! st 1) (conj out v))
              :else (fail! st "an array's items are separated by commas"))))))

(defn- assoc-key
  "m (the table at path base, or nil inside an inline table) with dotted
  key ks set to v: an error if it's set already, or not a table where one
  is needed. The tables dotted keys make, and inline ones, are noted."
  [st base m ks v]
  (let [[k & more] ks
        existing (get m k ::none)
        here (when base (conj base k))
        taken (fn [] (fail! st (str "the key " (pr-str (name k)) " is defined already")))]
    (if more
      (cond (= existing ::none)
            (do (when here (swap! st update :dotted conj here))
                (assoc m k (assoc-key st here {} more v)))
            (and (map? existing) (or (nil? base) (contains? (:dotted @st) here)))
            (assoc m k (assoc-key st here existing more v))
            :else (taken))
      (if (= existing ::none)
        (do (when (and here (map? v)) (swap! st update :inline conj here))
            (assoc m k v))
        (taken)))))

(defn- inline-table! [st opts]
  (skip! st 1)
  (skip-ws! st)
  (if (= \} (peek-c st))
    (do (skip! st 1) {})
    (loop [m {}]
      (let [ks (mapv (:keys opts) (dotted-key! st))]
        (skip-ws! st)
        (when-not (= \= (next-c! st)) (fail! st "= expected after a key"))
        (skip-ws! st)
        (let [m (assoc-key st nil m ks (value! st opts))]
          (skip-ws! st)
          (case (next-c! st)
            \, (do (skip-ws! st) (recur m))
            \} m
            (fail! st "an inline table's entries are separated by commas, on one line")))))))

(defn- value! [st opts]
  (let [c (peek-c st)]
    (cond (looking-at? st "\"\"\"") (multiline! st \" true)
          (looking-at? st "'''") (multiline! st \' false)
          (= c \") (basic-string! st)
          (= c \') (literal-string! st)
          (= c \[) (array! st opts)
          (= c \{) (inline-table! st opts)
          (nil? c) (fail! st "a value expected")
          :else (number-or-date! st opts))))

(defn- real-path
  "Where header keys ks lead in doc: through the last table of each array
  of tables on the way. An error where something on the way isn't a
  table, or is one that can't be added to here."
  [st doc ks header]
  (loop [at [] [k & more] ks]
    (if (nil? k)
      at
      (let [here (conj at k)
            x (get-in doc here)
            {:keys [aot inline dotted]} @st]
        (cond (contains? aot here) (recur (conj here (dec (count x))) more)
              (or (nil? x) (map? x))
              (do (when (or (contains? inline here) (and (empty? more) (contains? dotted here)))
                    (fail! st (str header ": that table is defined already")))
                  (recur here more))
              :else (fail! st (str header ": " (name k) " isn't a table")))))))

(defn read-string
  "The TOML document s, as a map. :keys transforms keys (keyword by default).
  With :local-times true, read local dates and times as skein.time values."
  ^Map [^String s & {:keys [keys local-times] :or {keys keyword}}]
  (let [st (atom {:cs (vec (str s)) :i 0 :dotted #{} :inline #{} :aot #{}})
        opts {:keys keys :local-times local-times}]
    (loop [doc {} path [] defined #{}]
      (skip-blank! st)
      (let [c (peek-c st)]
        (cond
          (nil? c) doc

          (looking-at? st "[[")
          (do (skip! st 2)
              (let [ks (mapv keys (dotted-key! st))
                    header (str "[[" (str/join "." (map name ks)) "]]")]
                (skip-ws! st)
                (when-not (looking-at? st "]]") (fail! st "]] expected"))
                (skip! st 2)
                (end-of-line! st)
                (let [full (conj (real-path st doc (pop ks) header) (peek ks))
                      existing (get-in doc full ::none)]
                  (when-not (or (= existing ::none) (contains? (:aot @st) full))
                    (fail! st (str header ": defined already, not as an array of tables")))
                  (let [arr (if (= existing ::none) [] existing)]
                    (swap! st update :aot conj full)
                    (recur (assoc-in doc full (conj arr {})) (conj full (count arr)) defined)))))

          (= c \[)
          (do (skip! st 1)
              (let [ks (mapv keys (dotted-key! st))
                    header (str "[" (str/join "." (map name ks)) "]")]
                (skip-ws! st)
                (when-not (= \] (next-c! st)) (fail! st "] expected"))
                (end-of-line! st)
                (let [real (real-path st doc ks header)]
                  (when (contains? defined real) (fail! st (str header " is defined twice")))
                  (recur (if (get-in doc real) doc (assoc-in doc real {})) real (conj defined real)))))

          :else
          (let [ks (mapv keys (dotted-key! st))]
            (skip-ws! st)
            (when-not (= \= (next-c! st)) (fail! st "= expected after a key"))
            (skip-ws! st)
            (let [v (value! st opts)
                  table (assoc-key st path (get-in doc path {}) ks v)
                  ;; (assoc-in with an empty path sets the key nil)
                  doc (if (empty? path) table (assoc-in doc path table))]
              (end-of-line! st)
              (recur doc path defined))))))))

;; ---- writing ----

(defn- key-text [k]
  (let [s (if (keyword? k) (name k) (str k))]
    (if (and (seq s) (every? bare-key-char? s)) s (pr-str s))))

(defn- scalar-text [x]
  (cond (string? x) (pr-str x)
        (keyword? x) (pr-str (name x))
        (or (true? x) (false? x)) (str x)
        (integer? x) (str x)
        (float? x) (cond (NaN? x) "nan" (= x ##Inf) "inf" (= x ##-Inf) "-inf"
                         :else (let [s (str x)] (if (re-find #"[.eE]" s) s (str s ".0"))))
        (t/instant? x) (t/format x)
        (or (t/local-date? x) (t/local-time? x) (t/local-date-time? x)) (t/format-local x)
        (map? x) (str "{ " (str/join ", " (map (fn [[k v]] (str (key-text k) " = " (scalar-text v))) x)) " }")
        (sequential? x) (str "[" (str/join ", " (map scalar-text x)) "]")
        :else (error (str "TOML has no way to write " (pr-str x)))))

(defn- table-of-tables? [v] (and (sequential? v) (seq v) (every? map? v)))

(defn- write-table [out path m]
  (let [plain (remove (fn [[_ v]] (or (map? v) (table-of-tables? v))) m)
        tables (filter (fn [[_ v]] (map? v)) m)
        arrays (filter (fn [[_ v]] (table-of-tables? v)) m)
        header (fn [p] (str/join "." (map key-text p)))]
    (doseq [[k v] plain] (swap! out conj (str (key-text k) " = " (scalar-text v))))
    (doseq [[k v] tables]
      (let [p (conj path k)]
        (swap! out conj "" (str "[" (header p) "]"))
        (write-table out p v)))
    (doseq [[k vs] arrays]
      (let [p (conj path k)]
        (doseq [v vs]
          (swap! out conj "" (str "[[" (header p) "]]"))
          (write-table out p v))))))

(defn write-string
  "Map m as a TOML document: plain values first, then tables, then arrays
  of tables. Keys may be keywords or strings."
  ^String [^Map m]
  (let [out (atom [])]
    (write-table out [] m)
    (str (str/join "\n" (drop-while empty? @out)) "\n")))

(defn read-file
  "The TOML document in file path (UTF-8), as a map (options as
  read-string's)."
  ^Map [path & opts]
  (apply read-string (io/read-text path) opts))

(defn write-file "Write map m to path as a TOML document (UTF-8)." [path ^Map m] (io/write-text path (write-string m)))
