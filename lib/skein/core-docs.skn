;;;; skein.core-docs — the docstrings of skein.core's primitives, the
;;;; functions written in Rust, which have no Skein definition to carry one.
;;;; `doc`, `definition` and `skein doc` read them from here, loading this
;;;; module the first time they're asked about one.
;;;;
;;;; Each entry is (primitive name "docstring" [params]…), one parameter
;;;; vector per arity, as a defn's would be.

(ns skein.core-docs)

(def docs "Primitive name (a symbol) → {:doc :arglists}." (atom {}))

(defmacro primitive
  "(primitive name \"docstring\" [params]…): document primitive name."
  {:indent 1}
  [nm doc & arglists]
  `(swap! docs assoc '~nm {:doc ~doc :arglists '~(apply list arglists)}))

;; ---- arithmetic ----

(primitive inc "x plus one." [x])

(primitive dec "x minus one." [x])

(primitive +
  "The sum of the numbers; (+) is 0.
  Integers grow to any size; a float anywhere makes the result a float. A
  non-number signals TypeError."
  [] [x & more])

(primitive -
  "x negated, or x minus each of more in turn.
  Integers grow to any size; a float anywhere makes the result a float. A
  non-number signals TypeError."
  [x] [x y & more])

(primitive *
  "The product of the numbers; (*) is 1.
  Integers grow to any size; a float anywhere makes the result a float. A
  non-number signals TypeError."
  [] [x & more])

(primitive /
  "1 divided by x, or x divided by each of more in turn.
  Integers divide exactly, giving a ratio when they must: (/ 6 4) is 3/2.
  A float anywhere gives a float, and a float divided by zero is ##Inf or
  ##NaN; an exact division by zero signals ArithmeticError."
  [x] [x y & more])

(primitive quot
  "x divided by y, truncated toward zero: (quot -7 2) is -3.
  Both must be integers (TypeError otherwise); a zero y signals
  ArithmeticError."
  [x y])

(primitive rem
  "The remainder of (quot x y), with x's sign: (rem -7 2) is -1.
  Both must be integers (TypeError otherwise); a zero y signals
  ArithmeticError."
  [x y])

(primitive mod
  "x modulo y, with y's sign: (mod -7 2) is 1.
  Both must be integers (TypeError otherwise); a zero y signals
  ArithmeticError."
  [x y])

(primitive <
  "True if the numbers increase strictly from left to right.
  Integers, ratios and floats compare exactly by value. One argument is
  true; a non-number signals TypeError."
  [x] [x y & more])

(primitive >
  "True if the numbers decrease strictly from left to right.
  Integers, ratios and floats compare exactly by value. One argument is
  true; a non-number signals TypeError."
  [x] [x y & more])

(primitive <=
  "True if no number is greater than the one after it.
  Integers, ratios and floats compare exactly by value. One argument is
  true; a non-number signals TypeError."
  [x] [x y & more])

(primitive >=
  "True if no number is less than the one after it.
  Integers, ratios and floats compare exactly by value. One argument is
  true; a non-number signals TypeError."
  [x] [x y & more])

(primitive ==
  "True if the numbers are all equal in value, whatever their kind.
  (== 1 1.0) is true where (= 1 1.0) is false. A non-number signals
  TypeError."
  [x] [x y & more])

(primitive float
  "Number x as a float. A non-number signals TypeError."
  [x])

(primitive int
  "x as an integer: a float or ratio truncated toward zero, or a
  character's code point. Large floats give large integers; anything else
  signals RuntimeError."
  [x])

(primitive numerator
  "The numerator of rational x in lowest terms; an integer is its own.
  A float signals RuntimeError."
  [x])

(primitive denominator
  "The denominator of rational x in lowest terms; 1 for an integer.
  A float signals RuntimeError."
  [x])

(primitive bit-and
  "The bitwise and of the integers, of any size, as two's complement.
  A non-integer signals TypeError."
  [x y] [x y & more])

(primitive bit-or
  "The bitwise or of the integers, of any size, as two's complement.
  A non-integer signals TypeError."
  [x y] [x y & more])

(primitive bit-xor
  "The bitwise exclusive or of the integers, of any size, as two's
  complement. A non-integer signals TypeError."
  [x y] [x y & more])

(primitive bit-not
  "The bitwise complement of integer x: (- -1 x)."
  [x])

(primitive bit-shift-left
  "Integer x shifted left n bits; the result grows as it needs to.
  n must be from 0 to 65536, or it signals RuntimeError."
  [x n])

(primitive bit-shift-right
  "Integer x shifted right n bits, rounding toward negative infinity:
  (bit-shift-right -7 1) is -4. n must be from 0 to 65536, or it signals
  RuntimeError."
  [x n])

;; ---- equality, order and types ----

(primitive =
  "True if the values are all equal.
  Collections compare by their items (a vector equals a list of the same
  items), numbers within their kind ((= 1 1.0) is false: see ==), atoms,
  functions and the like by identity. Streams compared are realized."
  [x] [x y & more])

(primitive not=
  "(not (= x y …)): true if any two of the values differ."
  [x] [x y & more])

(primitive identical?
  "True if x and y are the same object.
  Small integers, keywords, booleans and nil are always identical to
  themselves; two equal strings or vectors needn't be."
  [x y])

(primitive hash
  "An integer hash of x. Values equal under = hash the same.
  Streams inside x are realized."
  [x])

(primitive compare
  "-1, 0 or 1 as x sorts before, with or after y: sort's order.
  Numbers compare by value (so 1 and 1.0 give 0) and nil before anything.
  Strings, characters, booleans (false first), symbols and keywords
  compare with their own kind; vectors by length, then item by item.
  Other pairs, mixed kinds among them, signal RuntimeError."
  [x y])

(primitive type
  "A keyword naming x's kind: :integer, :float, :ratio, :string, :vector,
  :list, :map, :function, :nil and so on. An instance gives its class's
  name, lower-cased (:point for a Point)."
  [x])

(primitive nil? "True if x is nil." [x])

(primitive number?
  "True if x is a number: an integer, ratio or float."
  [x])

(primitive integer?
  "True if x is an integer, of any size (1.0 is not one)."
  [x])

(primitive ratio? "True if x is a ratio, such as 1/3." [x])

(primitive rational? "True if x is an integer or a ratio." [x])

(primitive float? "True if x is a float." [x])

(primitive string? "True if x is a string." [x])

(primitive symbol? "True if x is a symbol." [x])

(primitive keyword? "True if x is a keyword." [x])

(primitive char? "True if x is a character." [x])

(primitive boolean? "True if x is true or false." [x])

(primitive fn?
  "True if x is a function: a closure or a primitive.
  Keywords, maps, sets and generic functions can be called, but aren't
  fn?."
  [x])

(primitive list?
  "True if x is a list: () or a chain of conses (cons makes one)."
  [x])

(primitive vector? "True if x is a vector." [x])

(primitive map? "True if x is a map, hash or sorted." [x])

(primitive set? "True if x is a set, hash or sorted." [x])

(primitive sorted? "True if x is a sorted map or sorted set." [x])

(primitive queue? "True if x is a queue." [x])

(primitive transient? "True if x is a transient, from transient." [x])

(primitive seq?
  "True if x is a seq: a list, a seq over a vector, or a range.
  A stream is not one: stream? tests for those."
  [x])

(primitive sequential?
  "True if x keeps its items in order: a list, seq, range, vector, stream
  or queue. Maps, sets and strings are not sequential."
  [x])

(primitive coll?
  "True if x is a collection: something seq takes, other than nil and
  strings."
  [x])

(primitive seqable?
  "True if seq takes x: nil, a string, bytes or a collection."
  [x])

(primitive stream?
  "True if x is a stream, the lazy sequence lazy-seq, lazy, iterate and
  the like make."
  [x])

(primitive reduced? "True if x is a value wrapped by reduced." [x])

(primitive regex? "True if x is a regex." [x])

(primitive bytes? "True if x is bytes (an immutable byte string)." [x])

(primitive var? "True if x is a var." [x])

(primitive macro? "True if x is a var holding a macro." [x])

(primitive private?
  "True if x is a var private to its namespace (defn-, ^:private)."
  [x])

(primitive fiber? "True if x is a fiber." [x])

(primitive handle? "True if x is an I/O handle." [x])

(primitive class? "True if x is a class." [x])

(primitive generic? "True if x is a generic function." [x])

(primitive mutable?
  "True if x is an instance of a (:mutable) class."
  [x])

;; ---- collections ----

(primitive list "A list of the items." [& items])

(primitive vector "A vector of the items." [& items])

(primitive hash-map
  "A map of the key/value pairs kvs; a later key replaces an earlier one.
  An odd number of arguments signals RuntimeError."
  [& kvs])

(primitive hash-set
  "A set of the items, without duplicates."
  [& items])

(primitive sorted-map
  "A sorted map of the key/value pairs kvs, in compare's order of keys.
  Keys compare can't order, or an odd number of arguments, signal
  RuntimeError."
  [& kvs])

(primitive sorted-set
  "A sorted set of the items, in compare's order.
  Items compare can't order signal RuntimeError."
  [& items])

(primitive vec
  "coll's items as a vector; a vector is returned as it is.
  nil gives [], a string its characters, a map its [key value] entries."
  [coll])

(primitive set
  "coll's items as a hash set. nil gives #{}."
  [coll])

(primitive cons
  "A list of x followed by coll's items (nil gives (x)).
  coll is anything seq takes; anything else signals TypeError."
  [x coll])

(primitive first
  "coll's first item, or nil if it is empty or nil.
  A map's items are [key value] entries and a string's its characters;
  something seq can't take signals TypeError."
  [coll])

(primitive rest
  "The items of coll after the first, as a seq: () if there are none,
  never nil (next gives nil)."
  [coll])

(primitive next
  "The items of coll after the first, as a seq, or nil if there are none."
  [coll])

(primitive seq
  "A seq of coll's items, or nil if it is empty or nil.
  Takes lists, vectors, maps ([key value] entries), sets, strings
  (characters), bytes, streams and collection instances; anything else
  signals TypeError."
  [coll])

(primitive count
  "The number of items in coll: 0 for nil, the characters of a string.
  A stream is realized to its end, so an unbounded one never returns. A
  non-collection signals TypeError."
  [coll])

(primitive nth
  "The item at index i of coll, counting from 0: a vector, list, seq,
  string, bytes or stream. Out of range, not-found if given, else
  IndexError. Maps and sets, or an i that isn't an integer, signal
  TypeError."
  [coll i] [coll i not-found])

(primitive get
  "The value of key in coll, or not-found (default nil) if it has none.
  Maps look up keys, sets members (giving the member), vectors, strings
  and bytes indexes, instances slots. Anything else, lists included,
  gives not-found."
  [coll key] [coll key not-found])

(primitive contains?
  "True if coll has key: a map key (even one whose value is nil), set
  member, instance slot or vector index. Not a value: (contains? [5 6] 5)
  is false. nil gives false; lists and strings signal TypeError."
  [coll key])

(primitive keys
  "A seq of map m's keys, or nil if it has none.
  A sorted map's come in order; an instance gives its slot names."
  [m])

(primitive vals
  "A seq of map m's values, or nil if it has none.
  A sorted map's come in key order; an instance gives its slot values."
  [m])

(primitive assoc
  "coll with each key k set to its value v.
  coll is a map (nil counts as {}), sorted map, vector or instance. A
  vector index may be the vector's count, to append; past it signals
  IndexError. Instance slots are checked against their :type. Anything
  else signals TypeError."
  [coll k v] [coll k v & kvs])

(primitive dissoc
  "Map m without the keys ks. nil gives nil; a non-map signals TypeError."
  [m] [m k & ks])

(primitive conj
  "coll with the xs added, each where it goes fastest.
  At the end of a vector or queue, the front of a list or seq, into a
  set; a map takes [key value] vectors or maps, and adds nothing for nil.
  (conj) is [], and (conj nil x) is the list (x)."
  [] [coll] [coll x & xs])

(primitive disj
  "Set s without the xs. nil gives nil; a non-set signals TypeError."
  [s] [s x & xs])

(primitive empty
  "An empty collection of coll's kind: [] for a vector, {} for a map, ()
  for a list, seq or range. A sorted map or set, or a queue, stays one.
  nil for anything else, strings included."
  [coll])

(primitive peek
  "The item pop would remove: a vector's last, a list's or queue's first.
  nil when coll is empty or nil; other collections signal TypeError."
  [coll])

(primitive pop
  "coll without the item peek gives: a vector without its last, a list or
  queue without its first. nil gives nil; an empty vector or list signals
  RuntimeError, other collections TypeError."
  [coll])

(primitive subseq
  "The items of sorted map or set sc within bounds, in order, as a vector.
  A bound is a test (the function <, <=, > or >=) and a key:
  (subseq s > 2), (subseq s >= 2 < 5). A sorted map gives [key value]
  entries."
  [sc test key] [sc start-test start-key end-test end-key])

(primitive rsubseq
  "subseq's items in reverse order: those of sorted map or set sc within
  bounds, last first, as a vector."
  [sc test key] [sc start-test start-key end-test end-key])

(primitive transient
  "A transient copy of vector, map or set coll, to build quickly.
  Change it with conj!, assoc!, dissoc!, disj! and pop!, read it with get,
  nth, count and contains?, and finish with persistent!. Only the fiber
  that made it may use it (OwnershipError). Other values signal TypeError."
  [coll])

(primitive persistent!
  "The finished collection from transient t. Using t afterwards signals
  RuntimeError."
  [t])

(primitive conj!
  "Add x to transient t, as conj would; returns t."
  [t x])

(primitive assoc!
  "Set key k of transient map or vector t to v; returns t.
  A vector index may be its count, to append; past it signals IndexError."
  [t k v])

(primitive dissoc!
  "Remove key k from transient map t; returns t."
  [t k])

(primitive disj!
  "Remove x from transient set t; returns t."
  [t x])

(primitive pop!
  "Remove the last item of transient vector t; returns t.
  An empty one signals RuntimeError."
  [t])

(primitive reduced
  "x wrapped so that reduce (and a transducer) stops and returns x."
  [x])

(primitive unreduced
  "The value inside reduced x, or x itself if it isn't wrapped."
  [x])

(primitive apply
  "Call f with args' items as its arguments, after any xs before them:
  (apply + 1 [2 3]) is 6. args is anything seq takes, nil included."
  [f args] [f x & more])

;; ---- strings, characters and printing ----

(primitive str
  "The text of the xs joined: strings and characters as they are, other
  values as print shows them, nil as nothing. (str) is \"\". A stream not
  yet realized shows as #<stream>."
  [& xs])

(primitive subs
  "The characters of s from start (inclusive) to end (exclusive; default
  its length), counted as characters, not bytes. Indexes out of range
  signal IndexError."
  [s start] [s start end])

(primitive name
  "The name of a symbol or keyword as a string, without its namespace; a
  string is returned as it is. Anything else signals TypeError."
  [x])

(primitive namespace
  "The namespace of a symbol or keyword as a string, or nil if it has
  none. Anything else signals TypeError."
  [x])

(primitive symbol
  "The symbol named name: \"a/b\" gives the qualified a/b, and a keyword
  the symbol with its namespace and name. With ns (a string, or nil for
  none), ns/name."
  [name] [ns name])

(primitive keyword
  "The keyword named name, given without its colon: (keyword \"a\") is :a.
  A symbol gives the keyword with its namespace and name. With ns (a
  string, or nil for none), :ns/name."
  [name] [ns name])

(primitive gensym
  "A new symbol no other has: prefix (default G__) and a number. For
  names in a macro's expansion that mustn't clash."
  [] [prefix])

(primitive char
  "The character with Unicode code point n. An invalid code point signals
  RuntimeError, a non-integer TypeError."
  [n])

(primitive pr-str
  "The xs printed readably (as read-string reads them back), separated by
  spaces, as a string. Instances print as print-object says."
  [& xs])

(primitive pr
  "Print the xs readably, separated by spaces, with no newline; returns
  nil. Output goes to standard output, or where *out* is bound (as
  with-out-str binds it)."
  [& xs])

(primitive prn
  "Print the xs readably, separated by spaces, then a newline; returns
  nil. Output goes to standard output, or where *out* is bound."
  [& xs])

(primitive print
  "Print the xs for people (strings and characters as they are), separated
  by spaces, with no newline; returns nil. Output goes to standard output,
  or where *out* is bound."
  [& xs])

(primitive println
  "Print the xs for people (strings and characters as they are), separated
  by spaces, then a newline; returns nil. Output goes to standard output,
  or where *out* is bound."
  [& xs])

(primitive read-string
  "The first form in string s, or nil if it has none (only whitespace and
  comments). The rest of s is ignored; a malformed form signals
  ParseError."
  [s])

(primitive re-pattern
  "A regex compiled from string s; a regex is returned as it is.
  Invalid syntax signals RuntimeError."
  [s])

(primitive re-quote
  "A regex matching string s literally, its special characters escaped."
  [s])

(primitive bytes
  "Immutable bytes from x: a string's UTF-8, a collection of integers
  0–255 (nil gives none), or bytes as they are. An integer out of range
  signals RuntimeError, other values TypeError."
  [x])

(primitive bytes->string
  "Bytes b decoded as UTF-8 text. Invalid UTF-8 signals RuntimeError,
  unless lossy? is true: then each bad sequence becomes U+FFFD."
  [b] [b lossy?])

(primitive subbytes
  "Bytes start (inclusive) to end (exclusive; default the end) of b, as
  new bytes. A range out of bounds signals RuntimeError."
  [b start] [b start end])

(primitive bytes-concat
  "The bytes bs joined into one; (bytes-concat) is empty bytes. A non-bytes
  argument signals TypeError."
  [& bs])

(primitive slurp
  "The whole file at path, as a string. Read off the fiber's carrier, so
  other fibers run meanwhile. A missing file signals FileNotFound (an
  IOError, as other failures are), text that isn't UTF-8 ParseError."
  [path])

(primitive spit
  "Write x to the file at path, creating or replacing it; returns nil.
  Bytes are written as they are, anything else as str gives it. Failures
  signal IOError (FileNotFound for a missing folder)."
  [path x])

;; ---- fibers, channels and time ----

(primitive current-fiber "The fiber running this code." [])

(primitive fiber-id "Fiber f's number, unique in this process." [f])

(primitive await
  "Fiber f's result, parking until it finishes. If f failed, its
  condition is signaled here; a cancelled f signals RuntimeError
  \"Cancelled\". A fiber can't await itself."
  [f])

(primitive done?
  "True if fiber f has finished: returned, failed or been cancelled."
  [f])

(primitive fiber-error
  "The message f failed with (\"Cancelled\" if it was cancelled), or nil
  if fiber f succeeded or hasn't finished."
  [f])

(primitive cancel!
  "Ask fiber f to stop: it signals Cancelled at its next safepoint, or at
  once if parked, running its cleanups as it unwinds. Cancelling a fiber
  that waits on a scope cancels the scope's fibers too. Returns nil; a
  finished f is left alone."
  [f])

(primitive yield
  "Let other fibers run, then carry on; returns nil."
  [])

(primitive sleep
  "Park this fiber for ms milliseconds (a negative ms counts as 0) while
  others run; returns nil. A non-integer signals TypeError."
  [ms])

(primitive chan
  "A channel buffering up to n values (default 0: a put! waits for a
  take!). policy says what a put! on a full buffer does: :fixed waits (the
  default), :dropping drops the new value, :sliding the oldest; those two
  need n above 0. A negative n signals TypeError."
  [] [n] [n policy])

(primitive put!
  "Put v on channel c, parking while c is full. True once v is delivered
  or buffered, false if c is closed. nil can't be put (RuntimeError)."
  [c v])

(primitive take!
  "The next value from channel c, parking until there is one; nil once c
  is closed and empty."
  [c])

(primitive offer!
  "Put v on channel c only if that can happen now: true if it did, false
  if not."
  [c v])

(primitive poll!
  "Take a value from channel c only if one is there now, else nil."
  [c])

(primitive close!
  "Close channel c; returns nil. Parked takers get nil and parked putters
  false, as later puts do; values buffered already can still be taken."
  [c])

(primitive closed? "True if channel c has been closed." [c])

(primitive alts!
  "Do whichever one of ops can go first, parking until one can.
  An op is a channel (take from it) or [channel value] (put on it). Returns
  [result channel], result being the value taken or put!'s true or false.
  Of several ready, one is picked at random, or the first with :priority
  true; with :default d and none ready, returns [d :default] at once."
  [ops & options])

(primitive timeout
  "A channel that closes after ms milliseconds, so a take! on it gives nil
  then: a time limit for alts!."
  [ms])

(primitive atom
  "A new atom holding x. Read it with deref (@), change it with swap!,
  reset! or compare-and-set!."
  [x])

(primitive deref
  "The value of ref: an atom's or var's value, a fiber's result (waiting
  as await does), or a delay's, promise's or future's. With timeout-ms
  (promises and futures only), timeout-val if it isn't ready by then.
  Anything else signals TypeError."
  [ref] [ref timeout-ms timeout-val])

(primitive compare-and-set!
  "Set atom a to new if its value is old, the same object (identical?)
  rather than merely equal: true if it did, false if a is unchanged."
  [a old new])

(primitive nano-time
  "Nanoseconds from a monotonic clock, counted from early in the process:
  for measuring intervals, not telling the time."
  [])

(primitive carrier-count
  "The number of carrier threads that run fibers."
  [])

(primitive fiber-stats
  "{:spawned :finished :live}: how many fibers were made, have finished
  and are still alive, since the process began."
  [])

(primitive fiber-dump
  "A string listing every unfinished fiber and its stack, for debugging.
  Ctrl-\\ (SIGQUIT) prints one to standard error too."
  [])

;; ---- classes and instances ----

(primitive class-of
  "The class of x: an instance's class, or a built-in one for other
  values (Integer, Null for nil, Atom…)."
  [x])

(primitive instance?
  "True if x is an instance of class c or of a subclass of it; built-in
  values count too, as (instance? Number 1) does. A non-class c signals
  TypeError."
  [c x])

(primitive subclass?
  "True if class c is class super or inherits from it."
  [c super])

(primitive slot-value
  "The value of slot k of instance obj. A missing slot signals
  RuntimeError, a non-instance TypeError. A metaclass may take it over
  with slot-value-using-class."
  [obj k])

(primitive with
  "A copy of instance obj with each slot k set to its value v (checked
  against the slot's :type); obj is unchanged. An unknown slot signals
  RuntimeError."
  [obj & kvs])

;; ---- the runtime ----

(primitive eval
  "Evaluate form in the current namespace; returns its value. A top-level
  do is evaluated form by form, so a macro it defines works later in it."
  [form])

(primitive macroexpand-1
  "form expanded once if it calls a macro, else form itself. Only the
  outermost form is expanded."
  [form])

(primitive macroexpand
  "form expanded until it no longer calls a macro. Only the outermost form
  is expanded, not the forms inside it."
  [form])

(primitive in-ns
  "Make namespace sym current, creating it if need be; returns sym. A
  non-symbol signals TypeError."
  [sym])

(primitive current-ns "The current namespace's name, a symbol." [])

(primitive all-ns "Every namespace's name, as a list of symbols." [])

(primitive ns-publics
  "The public vars namespace ns (a symbol) defines, as a map of symbol to
  var. A namespace that doesn't exist signals RuntimeError."
  [ns])

(primitive ns-interns
  "Every var namespace ns (a symbol) defines, private ones too, as a map
  of symbol to var. A namespace that doesn't exist signals RuntimeError."
  [ns])

(primitive ns-aliases
  "Namespace ns's aliases (ns a symbol), as a map of alias to namespace
  name: {s skein.string}. {} if there is no such namespace."
  [ns])

(primitive resolve
  "The var symbol sym names in the current namespace (its own, referred,
  aliased or skein.core's), or nil if none."
  [sym])

(primitive var-get
  "The root value of var v. A non-var signals TypeError."
  [v])

(primitive disassemble
  "Print the bytecode of Skein function f (or of var f's), each arity in
  turn; returns nil. A primitive or non-function signals TypeError."
  [f])

(primitive add-lib-path!
  "Add folder dir to those require searches for a library (a.b-c as
  a/b-c.skn), before SKEIN_PATH; returns nil."
  [dir])

(primitive heap-bytes "How many bytes the heap holds now." [])

(primitive gc
  "Ask for a garbage collection at the next safepoint; returns nil at
  once."
  [])

(primitive gc-count "How many garbage collections have run." [])

(primitive jit-stats
  "{:tier :compiled :rejected :code-bytes :linked :relinked :despecialised
  :pending}: whether the JIT is on (1 or 0), how many functions it has
  compiled and turned down, their code's size, how many of their calls it
  linked to the function called (a call through a var, or of the function
  itself), how many functions it compiled again because a var they call
  had been redefined or because what it assumed of a float didn't hold,
  and how many wait for the compile thread (queued or being compiled)."
  [])

(primitive image-info
  "{:image path :chain [base… path]}: the image this process started
  from, and those it builds on. nil if it booted from source."
  [])

(primitive exit
  "End the process with status code (default 0), flushing standard output
  first. Cleanups and unwind-protect forms don't run."
  [] [code])

(primitive weak-ref
  "A weak reference to x, which doesn't keep x alive: weak-get gives x, or
  nil once x has been collected."
  [x])

(primitive weak-get
  "What weak reference w refers to, or nil once it has been collected. A
  non-weak-ref signals TypeError."
  [w])

(primitive add-cleanup!
  "Call f (with no arguments, in a fiber of its own) once x has been
  collected. Returns a weak reference to x, for cancel-cleanup!. f mustn't
  hold x, or x is never collected."
  [x f])

(primitive cancel-cleanup!
  "Drop the cleanup of w, from add-cleanup!, so it never runs. True if one
  was pending."
  [w])

(primitive handle-kind
  "What I/O handle h is, a keyword: :file, :tcp, :tls, :udp,
  :tcp-listener, :process, :pipe-in, :pipe-out and so on."
  [h])

(primitive handle-info
  "What I/O handle h was opened with, a map (a file's :path and :mode, a
  socket's :host…), or nil."
  [h])
