;;;; skein.package — `skein package`: a project as something to hand someone.
;;;;
;;;; It builds the project's image (skein build, its :main the entry), and
;;;; lays it out with the very skein that built it, copied under the app's
;;;; name: run as that name, skein finds the image beside it and runs it,
;;;; every argument going to :main (see the launcher in crates/skein).
;;;;
;;;;   a command-line archive, NAME-VERSION-OS-ARCH.tar.gz:
;;;;     bin/NAME                  the launcher (skein)
;;;;     lib/NAME/NAME.skimg        the image
;;;;     lib/NAME/…                resources, and native helpers
;;;;   a macOS app, Display Name.app (in a .zip):
;;;;     Contents/Info.plist
;;;;     Contents/MacOS/NAME       the launcher, and native helpers
;;;;     Contents/Resources/NAME.skimg, NAME.icns, resources
;;;;
;;;; skein.edn says what goes in, beside :name, :version and :main:
;;;;   :package {:id "org.example.app"   the app's identifier (macOS)
;;;;             :display-name "App"     its name in Finder and the Dock
;;;;             :icon "icon.png"        a PNG (made into .icns) or .icns
;;;;             :resources ["assets"]   files and folders to include
;;;;             :targets [:cli :app]    what to make (default [:cli])
;;;;             :shake true             leave out what :main doesn't reach
;;;;             :keep [app.plugins/x]}  …but keep these (vars, namespaces)
;;;; and a package may declare native helpers its code runs, found in its
;;;; folder, the first candidate that exists ({os} and {arch} filled in):
;;;;   :helpers {"skein-ui-host" ["target/release/skein-ui-host"
;;;;                             "bin/{os}-{arch}/skein-ui-host"]}
;;;;
;;;; The app is signed ad hoc (no Developer ID): it runs on this Mac; on
;;;; another, macOS asks before it opens a downloaded one the first time.

(ns skein.package
  (:require [skein.deps :as deps] [skein.io :as io] [skein.process :as proc] [skein.string :as str]
            [skein.sys :as sys]))

(defn- fail [& parts] (error (str "skein package: " (apply str parts))))

(defn- sh!
  "Run cmd with args (options as skein.process/sh's after them); its output,
  or an error with what it said."
  [cmd & args]
  (let [r (apply proc/sh cmd args)]
    (when-not (= 0 (:exit r))
      (fail cmd " failed: " (str/trim (str (:err r) (:out r)))))
    (:out r)))

;; ---- what to package ----

(defn- default-display-name [name]
  (str/join " " (map (fn [w] (str (str/upper-case (subs w 0 1)) (subs w 1))) (remove str/blank? (str/split (str name) #"[-_]")))))

(defn package-info
  "What `skein package` makes of the project in folder dir: {:dir :name
  :version :main :id :display-name :icon :resources :targets :helpers
  :shake :keep}, paths absolute. An error says what's missing."
  [dir]
  (let [dir (io/canonical dir)
        project (deps/read-project dir)
        p (or (:package project) {})
        pname (:name project)]
    (when-not (symbol? pname) (fail (io/path dir "skein.edn") " needs a :name"))
    (when-not (re-matches #"[A-Za-z0-9][A-Za-z0-9._-]*" (str pname))
      (fail "the :name " pname " can't name a program: letters, digits, . _ -"))
    (when-not (:main project) (fail (io/path dir "skein.edn") " needs a :main, the entry function (ns/name)"))
    (when-not (map? p) (fail ":package is a map"))
    (when-not (every? symbol? (or (:keep p) []))
      (fail ":package :keep is a vector of names: vars (ns/name) and namespaces"))
    (let [res (mapv (fn [r] (let [f (io/path dir r)]
                              (when-not (io/exists? f) (fail "the resource " r " isn't there"))
                              f))
                    (or (:resources p) []))
          icon (when-let [i (:icon p)]
                 (let [f (io/path dir i)]
                   (when-not (io/file? f) (fail "the icon " i " isn't there"))
                   f))
          r (deps/resolve-project dir)
          {:keys [os arch]} (sys/info)
          fill (fn [s] (-> s (str/replace "{os}" (name os)) (str/replace "{arch}" (name arch))))
          helpers (into (sorted-map)
                        (for [pkg (cons {:name pname :dir dir} (:packages r))
                              [h candidates] (:helpers (deps/read-project (:dir pkg)))]
                          (let [found (some (fn [c] (let [f (io/path (:dir pkg) (fill c))] (when (io/file? f) f))) candidates)]
                            (when-not found
                              (fail (:name pkg) " needs its helper " h ", and none of " (pr-str (mapv fill candidates))
                                    " is in " (:dir pkg) ": build it first"))
                            [h found])))]
      {:dir dir :name (str pname) :version (or (:version project) "0.0.0") :main (:main project)
       :id (or (:id p) (str "dev.skn." pname)) :display-name (or (:display-name p) (default-display-name pname))
       :icon icon :resources res :targets (vec (or (:targets p) [:cli])) :helpers helpers
       :shake (boolean (:shake p)) :keep (vec (or (:keep p) []))})))

;; ---- pieces ----

(defn- copy-tree!
  "Copy file or folder from into to (a path that doesn't exist yet)."
  [from to]
  (if (io/directory? from)
    (do (io/mkdirs! to)
        (doseq [n (io/list-dir from)] (copy-tree! (io/path from n) (io/path to n))))
    (do (io/mkdirs! (io/parent to)) (io/copy! from to)))
  nil)

(defn- fresh-dir! [d]
  (when (io/exists? d) (io/delete! d :recursive true))
  (io/mkdirs! d)
  d)

(defn build-image!
  "Build the project's image (its :main the entry) at out, with this skein:
  shaken when info says :shake (skein build --shake, printing its report)."
  [info out]
  (io/mkdirs! (io/parent out))
  (let [args (concat ["build" out] (when (:shake info) (cons "--shake" (mapcat (fn [k] ["--keep" (str k)]) (:keep info)))))
        said (apply sh! (:executable (sys/info)) (concat args [:dir (:dir info)]))]
    (when (:shake info) (print said)))
  (when-not (io/file? out) (fail "skein build made no image"))
  out)

(defn- plist-escape [s] (-> (str s) (str/replace "&" "&amp;") (str/replace "<" "&lt;") (str/replace ">" "&gt;")))

(defn info-plist
  "The Info.plist of the app info describes."
  [info]
  (let [entry (fn [k v] (str "  <key>" k "</key>\n  <string>" (plist-escape v) "</string>\n"))]
    (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
         "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
         "<plist version=\"1.0\">\n<dict>\n"
         (entry "CFBundleDevelopmentRegion" "en")
         (entry "CFBundleExecutable" (:name info))
         (entry "CFBundleIdentifier" (:id info))
         (entry "CFBundleInfoDictionaryVersion" "6.0")
         (entry "CFBundleName" (:display-name info))
         (entry "CFBundleDisplayName" (:display-name info))
         (entry "CFBundlePackageType" "APPL")
         (entry "CFBundleShortVersionString" (:version info))
         (entry "CFBundleVersion" (:version info))
         (when (:icon info) (entry "CFBundleIconFile" (:name info)))
         (entry "LSMinimumSystemVersion" "11.0")
         "  <key>NSHighResolutionCapable</key>\n  <true/>\n"
         "</dict>\n</plist>\n")))

(defn- make-icns!
  "Icon file (a PNG, or .icns) as the .icns at out."
  [icon out tmp]
  (if (str/ends-with? (str/lower-case icon) ".icns")
    (io/copy! icon out)
    (let [iconset (fresh-dir! (io/path tmp "icon.iconset"))]
      (doseq [[n px] [[16 16] [32 32] [128 128] [256 256] [512 512]]]
        (sh! "sips" "-z" (str px) (str px) icon "--out" (io/path iconset (str "icon_" n "x" n ".png")))
        (sh! "sips" "-z" (str (* 2 px)) (str (* 2 px)) icon "--out" (io/path iconset (str "icon_" n "x" n "@2x.png"))))
      (sh! "iconutil" "-c" "icns" iconset "-o" out)))
  out)

;; ---- the targets ----

(defn cli-archive!
  "The command-line archive of the project info describes, in folder out,
  from image: its path."
  [info image out]
  (let [{:keys [os arch]} (sys/info)
        base (str (:name info) "-" (:version info) "-" (name os) "-" (name arch))
        root (fresh-dir! (io/path out base))
        lib (io/path root "lib" (:name info))
        archive (io/path out (str base ".tar.gz"))]
    (io/mkdirs! (io/path root "bin"))
    (io/copy! (:executable (sys/info)) (io/path root "bin" (:name info)))
    (io/mkdirs! lib)
    (io/copy! image (io/path lib (str (:name info) ".skimg")))
    (doseq [r (:resources info)] (copy-tree! r (io/path lib (io/file-name r))))
    (doseq [[h f] (:helpers info)] (io/copy! f (io/path lib h)))
    (when (io/exists? archive) (io/delete! archive))
    (sh! "tar" "-czf" archive "-C" out base)
    archive))

(defn mac-app!
  "The macOS app of the project info describes, in folder out, from image,
  signed ad hoc and zipped: [app zip]."
  [info image out]
  (when-not (= :macos (sys/os)) (fail "a macOS app is made on macOS"))
  (let [app (io/path out (str (:display-name info) ".app"))
        zip (io/path out (str (:display-name info) "-" (:version info) "-macos-" (name (sys/arch)) ".zip"))
        contents (io/path app "Contents")
        macos (io/path contents "MacOS")
        res (io/path contents "Resources")]
    (fresh-dir! app)
    (io/mkdirs! macos)
    (io/mkdirs! res)
    (io/write-text (io/path contents "Info.plist") (info-plist info))
    (io/write-text (io/path contents "PkgInfo") "APPL????")
    (io/copy! (:executable (sys/info)) (io/path macos (:name info)))
    (doseq [[h f] (:helpers info)] (io/copy! f (io/path macos h)))
    (io/copy! image (io/path res (str (:name info) ".skimg")))
    (when-let [i (:icon info)] (make-icns! i (io/path res (str (:name info) ".icns")) (io/path out ".build")))
    (doseq [r (:resources info)] (copy-tree! r (io/path res (io/file-name r))))
    ;; ad hoc: the helpers, then the app (its seal covers the rest)
    (doseq [[h _] (:helpers info)] (sh! "codesign" "--force" "--sign" "-" (io/path macos h)))
    (sh! "codesign" "--force" "--sign" "-" app)
    (sh! "codesign" "--verify" "--strict" app)
    (when (io/exists? zip) (io/delete! zip))
    (sh! "ditto" "-c" "-k" "--sequesterRsrc" "--keepParent" app zip)
    [app zip]))

(defn package!
  "Package the project in folder dir: what it made, {:image :cli :app :zip}.
  Options: :out (default dir/dist), :targets (default the project's)."
  [dir & {:keys [out targets]}]
  (let [info (package-info dir)
        out (io/absolute (or out (io/path (:dir info) "dist")))
        targets (or targets (:targets info))
        image (build-image! info (io/path out ".build" (str (:name info) ".skimg")))]
    (cond-> {:image image}
            (some #{:cli} targets) (assoc :cli (cli-archive! info image out))
            (some #{:app} targets) (merge (let [[app zip] (mac-app! info image out)] {:app app :zip zip})))))

(defn main
  "`skein package [--cli] [--app] [--out DIR] [FOLDER]`: package the project
  (default the current folder). --cli and --app choose what to make
  instead of skein.edn's :package :targets."
  [& args]
  (let [opts (loop [args args o {:targets []}]
               (if-let [a (first args)]
                 (cond (= a "--cli") (recur (next args) (update o :targets conj :cli))
                       (= a "--app") (recur (next args) (update o :targets conj :app))
                       (= a "--out") (recur (nnext args) (assoc o :out (second args)))
                       (str/starts-with? a "-") (do (println "skein package: unknown option" a) ::bad)
                       :else (recur (next args) (assoc o :dir a)))
                 o))]
    (if (= ::bad opts)
      2
      (try
        (let [r (package! (or (:dir opts) (sys/cwd)) :out (:out opts) :targets (not-empty (:targets opts)))]
          (when (:cli r) (println "made" (:cli r)))
          (when (:app r) (println "made" (:app r) "\n     " (:zip r)))
          0)
        (catch Error e (println (condition-message e)) 1)))))
