;;;; skein.async — more ways to connect channels.
;;;;
;;;; Channels, put!/take! (>!/<!), offer!/poll!, alts!, timeout and close!
;;;; are in skein.core; (chan n :dropping) and (chan n :sliding) make
;;;; channels whose puts never wait (dropping the newest or the oldest value
;;;; when full). Everything here is built on those: each connector runs in
;;;; detached fibers that stop when their source closes.

(ns skein.async
  (:refer-core :exclude [reduce into map filter merge]))

(defn onto-chan!
  "Put coll's items on ch, then close ch (unless close? is false).
  Returns a fiber that finishes when done."
  (^Fiber [^Channel ch coll] (onto-chan! ch coll true))
  (^Fiber [^Channel ch coll close?]
   ;; (a fiber for its caller to await: a failure is theirs, not printed)
   (%spawn-held
    (fn [] (loop [xs (seq coll)]
             (if (and xs (put! ch (first xs))) (recur (next xs)) (when close? (close! ch))))))))

(defn to-chan! "A channel holding coll's items, closed after the last." ^Channel [coll]
  (let [ch (chan (max 1 (min 1024 (count coll))))] (onto-chan! ch coll) ch))

(defn reduce
  "f reduced over everything taken from ch until it closes (blocks the
  calling fiber)."
  [f init ^Channel ch]
  (loop [acc init]
    (let [v (take! ch)] (if (nil? v) acc (recur (f acc v))))))

(defn into "coll with everything taken from ch until it closes." [coll ^Channel ch] (reduce conj coll ch))

(defn pipe
  "Take from from and put on to until from closes; then close to (unless
  close? is false). Returns to."
  (^Channel [^Channel from ^Channel to] (pipe from to true))
  (^Channel [^Channel from ^Channel to close?]
   (spawn-detached
     (loop []
       (let [v (take! from)]
         (if (nil? v) (when close? (close! to)) (if (put! to v) (recur) nil)))))
   to))

(defn map
  "A channel of (f v) for each v taken from ch (closed when ch closes)."
  ^Channel [f ^Channel ch & {:keys [buffer] :or {buffer 0}}]
  (let [out (chan buffer)]
    (spawn-detached
      (loop [] (let [v (take! ch)] (if (nil? v) (close! out) (do (put! out (f v)) (recur))))))
    out))

(defn filter "A channel of the values from ch for which pred is true." ^Channel [pred ^Channel ch & {:keys [buffer] :or {buffer 0}}]
  (let [out (chan buffer)]
    (spawn-detached
      (loop [] (let [v (take! ch)] (cond (nil? v) (close! out) (pred v) (do (put! out v) (recur)) :else (recur)))))
    out))

(defn transduce-chan
  "A channel of what transducer xf makes of the values from ch."
  ^Channel [xf ^Channel ch & {:keys [buffer] :or {buffer 0}}]
  (let [out (chan buffer)
        rf (xf (fn ([o] o) ([o v] (if (put! o v) o (reduced o)))))]
    (spawn-detached
      (loop [acc out]
        (let [v (take! ch)]
          (if (nil? v)
            (do (rf acc) (close! out))
            (let [r (rf acc v)] (if (reduced? r) (do (rf (unreduced r)) (close! out)) (recur r)))))))
    out))

(defn merge
  "One channel carrying the values of all chs, closed once they all close."
  ^Channel [^(? Collection) chs & {:keys [buffer] :or {buffer 0}}]
  (let [out (chan buffer) left (atom (count chs))]
    (doseq [ch chs]
      (spawn-detached
        (loop []
          (let [v (take! ch)]
            (if (nil? v)
              (when (zero? (swap! left dec)) (close! out))
              (do (put! out v) (recur)))))))
    (when (empty? chs) (close! out))
    out))

(defn split
  "Two channels: the values from ch for which pred is true, and the rest."
  ^Vector [pred ^Channel ch]
  (let [yes (chan) no (chan)]
    (spawn-detached
      (loop []
        (let [v (take! ch)]
          (if (nil? v) (do (close! yes) (close! no)) (do (put! (if (pred v) yes no) v) (recur))))))
    [yes no]))

(defn pipeline
  "Apply f to each value from from, at most n calls at a time in parallel,
  putting the results on to in the original order. Closes to when from
  closes (unless close? is false). Returns a fiber that ends when the
  pipeline does.

  If f fails on a value, the results for the values before it still reach
  to, in order; then the pipeline stops: the calls still running are
  cancelled, nothing more is taken from from, to is closed (unless close?
  is false), and awaiting the returned fiber raises f's error. A consumer
  reading to sees it end early, so await the fiber after reading to
  learn why."
  (^Fiber [^Integer n ^Channel to f ^Channel from] (pipeline n to f from true))
  (^Fiber [^Integer n ^Channel to f ^Channel from close?]
   (when-not (pos-int? n)
     (error TypeError :message (str "pipeline expects n to be a positive integer, got " (pr-str n))
            :expected "a positive integer" :value n))
   (let [jobs (chan n)
         slots (chan n)]
     (dotimes [_ n] (offer! slots true))
     ;; (a fiber for its caller to await: f's error is theirs, not printed
     ;; when the pipeline stops, maybe before they await it)
     (%spawn-held
      (fn []
        (try
          ;; a reader starts each call in a fiber of the scope once a slot
          ;; is free and queues the fiber; the body puts the results on to
          ;; in order, freeing the slot as each call ends. A call's failure
          ;; comes back as a value, so it's raised in its turn; the scope
          ;; then cancels the rest.
          (with-scope [s]
            (spawn s (loop []
                       (let [v (take! from)]
                         (if (nil? v)
                           (close! jobs)
                           (do (take! slots)
                               (put! jobs (spawn s (handler-case [::value (f v)] (Error [c] [::failed c]))))
                               (recur))))))
            (loop []
              (when-some [job (take! jobs)]
                (let [[how r] (await job)]
                  (put! slots true)
                  (when (= how ::failed) (error r))
                  (put! to r)
                  (recur)))))
          (finally (when close? (close! to)))))))))

;; ---- mult: one source, many taps ------------------------------------------------------------

(defclass Mult () ((source) (taps))
  (:doc "A channel copied to several others: what mult makes, for tap and untap."))

(defn mult
  "Copy every value from ch to each tap (see tap). A slow tap holds up the
  others; give it a buffer or a :dropping channel."
  ^Mult [^Channel ch]
  (let [m (Mult :source ch :taps (atom {}))]
    (spawn-detached
      (loop []
        (let [v (take! ch)]
          (if (nil? v)
            (doseq [[t close?] (deref (:taps m))] (when close? (close! t)))
            (do (doseq [[t _] (deref (:taps m))]
                  (when-not (put! t v) (swap! (:taps m) dissoc t)))
                (recur))))))
    m))

(defn tap "Start copying m's values to ch (closing it when the source closes, unless close? is false). Returns ch."
  (^Channel [^Mult m ^Channel ch] (tap m ch true))
  (^Channel [^Mult m ^Channel ch close?] (swap! (:taps m) assoc ch close?) ch))

(defn untap "Stop copying to ch." [^Mult m ^Channel ch] (swap! (:taps m) dissoc ch) nil)

;; ---- pub/sub: values routed by topic --------------------------------------------------------

(defclass Pub () ((source) (topic-fn) (subs))
  (:doc "A channel split by topic: what pub makes, for sub and unsub."))

(defn pub
  "Route each value v from ch to the channels subscribed to (topic-fn v)."
  ^Pub [^Channel ch topic-fn]
  (let [p (Pub :source ch :topic-fn topic-fn :subs (atom {}))]
    (spawn-detached
      (loop []
        (let [v (take! ch)]
          (if (nil? v)
            (doseq [[_ chs] (deref (:subs p))] (doseq [[c close?] chs] (when close? (close! c))))
            (do (doseq [[c _] (get (deref (:subs p)) (topic-fn v))]
                  (when-not (put! c v) (swap! (:subs p) update (topic-fn v) dissoc c)))
                (recur))))))
    p))

(defn sub "Subscribe ch to topic on p. Returns ch."
  (^Channel [^Pub p topic ^Channel ch] (sub p topic ch true))
  (^Channel [^Pub p topic ^Channel ch close?] (swap! (:subs p) update topic (fn [m] (assoc (or m {}) ch close?))) ch))

(defn unsub "Unsubscribe ch from topic." [^Pub p topic ^Channel ch] (swap! (:subs p) update topic dissoc ch) nil)
