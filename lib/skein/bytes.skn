;;;; skein.bytes — byte strings and their text encodings.
;;;;
;;;; Bytes are immutable values, like strings: (bytes "héllo") is the UTF-8,
;;;; (bytes [1 2 3]) builds from integers, and they print as #bytes "0102".
;;;; count, nth, get and seq work on them; = and hash compare contents.

(ns skein.bytes)

(defn utf8
  "The UTF-8 bytes of string s."
  ^Bytes [s]
  (bytes (str s)))

(defn utf8-string
  "Decode UTF-8. Invalid sequences are an error, unless lossy? is true, which
  replaces them with U+FFFD."
  (^String [^Bytes b] (bytes->string b))
  (^String [^Bytes b lossy?] (bytes->string b lossy?)))

(defn hex
  "Lower-case hex digits of b."
  ^String [^Bytes b]
  (%hex-encode b))

(defn unhex
  "Bytes from hex digits (either case)."
  ^Bytes [^String s]
  (%hex-decode s))

(defn base64
  "Base64 of b: the standard alphabet with padding, or with :url the
  URL-safe alphabet without padding."
  (^String [^Bytes b] (%base64-encode b false))
  (^String [^Bytes b alphabet] (%base64-encode b (= alphabet :url))))

(defn unbase64
  "Bytes from base64 in either alphabet, padded or not."
  ^Bytes [^String s]
  (%base64-decode s))

(defn concat-bytes
  "One byte string from several."
  [& bs]
  (apply bytes-concat bs))

(defn slice
  "Bytes from index start (inclusive) to end (exclusive, default: the end)."
  (^Bytes [^Bytes b ^Integer start] (subbytes b start))
  (^Bytes [^Bytes b ^Integer start ^Integer end] (subbytes b start end)))

(defn read-uint
  "Read width bytes as an unsigned integer at offset. Byte order is :be or :le."
  ^Integer [^Bytes b ^Integer offset ^Integer width ^Keyword order]
  (when-not (and (bytes? b) (integer? offset) (integer? width) (<= 0 offset (+ offset width) (count b)))
    (error IndexError :message "Unsigned integer is outside the byte string" :index offset))
  (let [start (case order :be offset :le (+ offset (dec width)) (error "Unknown byte order" order))
        step (if (= :be order) 1 -1)]
    (loop [i start n width value 0]
      (if (zero? n) value (recur (+ i step) (dec n) (+ (* 256 value) (nth b i)))))))

(defn uint-bytes
  "Encode a nonnegative integer in exactly width bytes, in :be or :le order."
  ^Bytes [^Integer n ^Integer width ^Keyword order]
  (when-not (and (integer? n) (<= 0 n) (integer? width) (<= 0 width))
    (error "Expected an unsigned integer and byte width" n width))
  (let [out (loop [remaining width value n out []]
              (if (zero? remaining)
                (do (when-not (zero? value) (error "Unsigned integer does not fit" n width)) out)
                (recur (dec remaining) (quot value 256) (conj out (mod value 256)))))]
    (case order :be (bytes (reverse out)) :le (bytes out) (error "Unknown byte order" order))))

(defn float-bytes "Encode an IEEE 754 number in 4 or 8 bytes, in :be or :le order." ^Bytes [^Number n ^Integer width ^Keyword order]
  (let [b (%float-bytes n width)]
    (case order :be b :le (bytes (reverse (vec b))) (error "Unknown byte order" order))))

(defn read-float "Read an IEEE 754 number in 4 or 8 bytes at offset, in :be or :le order."
  ^Float [^Bytes b ^Integer offset ^Integer width ^Keyword order]
  (when-not (contains? #{4 8} width) (error "Float width must be 4 or 8 bytes"))
  (let [part (slice b offset (+ offset width))]
    (%bytes-float (case order :be part :le (bytes (reverse (vec part))) (error "Unknown byte order" order)))))

(defn decoder
  "Create an incremental decoder for :utf-8, :utf-16le or :utf-16be.
  The decoder preserves byte order marks as characters."
  ^Map [^Keyword encoding]
  (when-not (contains? #{:utf-8 :utf-16le :utf-16be} encoding)
    (error "Unsupported text encoding" encoding))
  {:encoding encoding :pending (bytes []) :offset 0})

(defn- utf8-end [data]
  (let [size (count data)]
    (loop [i (dec size) continuation 0]
      (if (or (neg? i) (> continuation 3)) size
          (let [b (nth data i)
                needed (cond (<= 0xC2 b 0xDF) 1 (<= 0xE0 b 0xEF) 2 (<= 0xF0 b 0xF4) 3 :else 0)]
            (cond (<= 0x80 b 0xBF) (recur (dec i) (inc continuation))
                  (< continuation needed) i
                  :else size))))))

(defn- utf16-unit [data i encoding]
  (let [a (nth data i) b (nth data (inc i))]
    (if (= encoding :utf-16le) (+ a (* 256 b)) (+ (* 256 a) b))))

(defn- utf16-end [data encoding]
  (let [end (* 2 (quot (count data) 2))]
    (if (and (pos? end) (<= 0xD800 (utf16-unit data (- end 2) encoding) 0xDBFF)) (- end 2) end)))

(defn- encoding-error! [encoding offset reason]
  (error ParseError :source (name encoding)
         :message (str (name encoding) " at byte " offset ": " reason)))

(defn- decode-utf16 [data end encoding offset]
  (loop [i 0 out (transient [])]
    (if (= i end)
      (apply str (persistent! out))
      (let [unit (utf16-unit data i encoding)]
        (cond
          (<= 0xD800 unit 0xDBFF)
          (let [j (+ i 2) low (when (< j end) (utf16-unit data j encoding))]
            (when-not (and low (<= 0xDC00 low 0xDFFF))
              (encoding-error! encoding (+ offset i) "unpaired UTF-16 surrogate"))
            (let [cp (+ 0x10000 (* (- unit 0xD800) 1024) (- low 0xDC00))]
              (recur (+ i 4) (conj! out (char cp)))))
          (<= 0xDC00 unit 0xDFFF)
          (encoding-error! encoding (+ offset i) "unpaired UTF-16 surrogate")
          :else (recur (+ i 2) (conj! out (char unit))))))))

(defn decode-chunk
  "Decode the complete characters in a byte chunk. Returns [next-state text]."
  ^Vector [^Map state ^Bytes chunk]
  (when-not (bytes? chunk) (error "decode-chunk expects Bytes"))
  (let [{:keys [encoding pending offset]} state
        data (if (zero? (count pending)) chunk (bytes-concat pending chunk))
        end (if (= encoding :utf-8) (utf8-end data) (utf16-end data encoding))
        text (if (= encoding :utf-8)
               (let [complete (if (= end (count data)) data (slice data 0 end))]
                 (if-let [bad (%utf8-valid-up-to complete)]
                   (encoding-error! encoding (+ offset bad) "invalid UTF-8 sequence")
                   (bytes->string complete)))
               (decode-utf16 data end encoding offset))]
    [{:encoding encoding :pending (slice data end) :offset (+ offset end)} text]))

(defn finish-decoder
  "Signal ParseError if the stream ended partway through a character."
  [^Map {:keys [encoding pending offset]}]
  (when (pos? (count pending))
    (encoding-error! encoding offset
                     (cond (= encoding :utf-8) "incomplete UTF-8 sequence"
                           (odd? (count pending)) "incomplete UTF-16 code unit"
                           :else "unpaired UTF-16 surrogate"))))

(defn decode-text
  "Decode a complete Bytes value as :utf-8, :utf-16le or :utf-16be."
  ^String [^Bytes data ^Keyword encoding]
  (let [[state text] (decode-chunk (decoder encoding) data)]
    (finish-decoder state)
    text))
