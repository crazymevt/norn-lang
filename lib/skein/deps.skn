;;;; skein.deps — projects and packages (M8 part 8.10, decision 7).
;;;;
;;;; A project is a folder with a skein.edn:
;;;;
;;;;   {:name my-app
;;;;    :version "0.1.0"
;;;;    :paths ["src"]                              ; its source folders (default)
;;;;    :test-paths ["tests"]                       ; its tests' (default)
;;;;    :deps {skein-ui {:path "../skein-ui"}         ; a folder
;;;;           json-x {:git "https://…/json-x" :tag "v1.2.0"}
;;;;           other {:git "https://…/other" :sha "4f1c…"}}
;;;;    :overrides {json-x {:git "…" :tag "v1.3.0"}} ; settles two versions
;;;;    :main my.app/main}                          ; skein build's entry
;;;;
;;;; The project's :test-paths are on the library path too, after the
;;;; others, so its test files can share helpers (tests/my/helpers.skn is
;;;; my.helpers); a package's aren't.
;;;;
;;;; A package is a project used as a dependency: its own skein.edn gives its
;;;; paths and its dependencies (a folder without one is a package whose
;;;; source is in src). A path is relative to the skein.edn that names it.
;;;;
;;;; Resolution walks the dependencies from the project. Two versions of one
;;;; package (two folders, or two commits) are an error that shows the chain
;;;; to each, unless the project's :overrides names the package; an override
;;;; is used wherever the package is asked for.
;;;;
;;;; skein.lock, beside skein.edn, records the commit of every Git package in
;;;; the build, so a tag that moves doesn't change it: a locked package is
;;;; used at its commit, and only a new or changed one is looked up.
;;;; `skein deps --update` looks them all up again. Git packages are fetched,
;;;; with the git command, into a cache: SKEIN_DEPS, else the cache folder's
;;;; deps folder, one folder per package and commit.
;;;;
;;;; `skein` uses the project it finds (skein.edn in the folder of the file it
;;;; runs, else the current one, or a folder above): the project's paths and
;;;; its packages' come before SKEIN_PATH, which stays as a fallback.

(ns skein.deps
  (:require [skein.io :as io] [skein.edn :as edn] [skein.process :as process] [skein.string :as str]
            [skein.sys :as sys]))

(def ^:dynamic *deps-root*
  "Where Git packages are fetched to (nil: SKEIN_DEPS, else the cache
  folder's deps folder)."
  nil)

(defn deps-root
  "The folder packages are fetched to: *deps-root*, else $SKEIN_DEPS, else
  deps in the module cache's folder. An error when there's none."
  []
  (or *deps-root*
      (sys/getenv "SKEIN_DEPS")
      (when-let [c (%cache-dir)] (io/path c "deps"))
      (error "No folder to fetch packages to: set SKEIN_DEPS (the module cache is off)")))

;; ---- project files ----

(defn find-project
  "The folder of the project dir is in (dir, or the nearest folder above
  it with a skein.edn), or nil."
  [dir]
  (loop [d (io/absolute dir)]
    (cond (nil? d) nil
          (io/file? (io/path d "skein.edn")) d
          :else (let [p (io/parent d)] (when (and p (not= p d)) (recur p))))))

(defn- check-spec [where name spec]
  (when-not (and (symbol? name) (map? spec)
                 (or (and (string? (:path spec)) (nil? (:git spec)))
                     (and (string? (:git spec)) (nil? (:path spec))
                          (= 1 (count (filter some? [(:tag spec) (:sha spec)])))
                          (every? (fn [k] (or (nil? (k spec)) (string? (k spec)))) [:tag :sha]))))
    (error (str where ": the dependency " (pr-str name) " " (pr-str spec)
                " should be {:path \"folder\"}, or {:git \"url\" :tag \"tag\"} or {:git \"url\" :sha \"commit\"}")))
  spec)

(defn read-project
  "Folder dir's skein.edn (checked), with defaults: :paths [\"src\"],
  :test-paths [\"tests\"], :deps {}, :overrides {}. A folder without one is
  a package with the defaults."
  [dir]
  (let [f (io/path dir "skein.edn")
        p (if (io/file? f)
            (try (edn/read-string (io/read-text f))
                 (catch Error e (error (str f ": " (condition-message e)))))
            {})]
    (when-not (map? p) (error (str f ": a project file is a map, {:name … :deps {…}}")))
    (doseq [k [:deps :overrides]]
      (when-not (or (nil? (k p)) (map? (k p))) (error (str f ": " k " is a map of name to dependency")))
      (doseq [[n s] (k p)] (check-spec f n s)))
    (doseq [k [:paths :test-paths]]
      (when-not (or (nil? (k p)) (and (vector? (k p)) (every? string? (k p))))
        (error (str f ": " k " is a vector of folders"))))
    (merge {:paths ["src"] :test-paths ["tests"] :deps {} :overrides {}} p)))

;; ---- Git ----

(defn- git [& args]
  (let [r (apply process/sh "git" args)]
    (when-not (= 0 (:exit r))
      (error (str "git " (str/join " " args) " failed: " (str/trim (str (:err r))))))
    (:out r)))

(defn- full-sha? [s] (and (string? s) (= 40 (count s)) (every? (fn [c] (str/includes? "0123456789abcdef" (str c))) s)))

(defn- tag-commit
  "The commit tag names in the repository at url (asks it)."
  [url tag]
  (let [lines (str/split-lines (git "ls-remote" "--tags" url (str "refs/tags/" tag) (str "refs/tags/" tag "^{}")))
        refs (into {} (keep (fn [l] (let [[sha ref] (str/split l #"\s+")] (when ref [ref sha])))) lines)]
    (or (get refs (str "refs/tags/" tag "^{}")) ; an annotated tag's commit
        (get refs (str "refs/tags/" tag))
        (error (str url " has no tag " tag)))))

(defn- fetch!
  "Package name's folder at commit sha of the repository at url, fetched
  into the cache if it isn't there yet. A short sha is resolved in the
  clone. [folder full-sha]."
  [name url sha]
  (let [root (io/path (deps-root) (str name))
        done (fn [d] (io/file? (io/path d ".skein-fetched")))]
    (if (and (full-sha? sha) (done (io/path root sha)))
      [(io/path root sha) sha]
      (let [tmp (io/path root (str ".fetch-" (nano-time)))]
        (io/mkdirs! root)
        (try
          (git "clone" "--quiet" "--no-checkout" url tmp)
          (let [full (str/trim (git "-C" tmp "rev-parse" "--verify" (str sha "^{commit}")))
                dir (io/path root full)]
            (if (done dir)
              (do (io/delete! tmp :recursive true) [dir full])
              (do (git "-C" tmp "-c" "advice.detachedHead=false" "checkout" "--quiet" full)
                  (io/write-text (io/path tmp ".skein-fetched") (str url "\n" full "\n"))
                  (when (io/exists? dir) (io/delete! dir :recursive true))
                  (io/rename! tmp dir)
                  [dir full])))
          (catch Error e
            (when (io/exists? tmp) (try (io/delete! tmp :recursive true) (catch Error _ nil)))
            (error (str "Fetching " name " from " url ": " (condition-message e)))))))))

;; ---- resolution ----

(defn- chain-text [chain] (str/join " → " (map str chain)))

(defn- locate
  "Where package name (spec, named from folder base) is: {:id :dir
  :source :lock}, fetching a Git package if need be. :lock is its skein.lock
  entry."
  [name spec base lock update?]
  (if-let [p (:path spec)]
    (let [dir (io/canonical (io/path base p))]
      (when-not (io/directory? dir) (error (str "The package " name " should be at " (io/path base p) ", which isn't a folder")))
      {:id [:path dir] :dir dir :source (str "path " dir)})
    (let [url (:git spec)
          locked (get lock name)
          ref (or (:tag spec) (:sha spec))
          sha (cond (and (not update?) locked (= url (:git locked)) (= (:tag spec) (:tag locked)) (= (:sha spec) (:want locked)))
                    (:sha locked)
                    (:tag spec) (tag-commit url (:tag spec))
                    :else (:sha spec))
          [dir full] (fetch! name url sha)]
      {:id [:git url full] :dir dir :source (str "git " url " " ref (when (not= ref full) (str " (" (subs full 0 12) ")")))
       :lock (cond-> {:git url :sha full} (:tag spec) (assoc :tag (:tag spec)) (:sha spec) (assoc :want (:sha spec)))})))

(defn read-lock
  "The Git packages project folder dir's skein.lock pins: a map of each
  package's entry ({} with no skein.lock). An error names a malformed one."
  [dir]
  (let [f (io/path dir "skein.lock")]
    (if (io/file? f)
      (let [l (try (edn/read-string (io/read-text f)) (catch Error e (error (str f ": " (condition-message e)))))]
        (or (:git l) {}))
      {})))

(defn- lock-text [entries]
  (str ";; Written by skein: the commit of each Git package in the build (see skein deps).\n"
       "{:git {"
       (str/join "\n       "
                 (for [[n e] (sort-by (fn [[n _]] (str n)) entries)]
                   (str n " " (pr-str (into (sorted-map) e)))))
       "}}\n"))

(defn resolve-project
  "Project folder dir's packages, resolved: {:project :dir :packages
  [{:name :version :dir :paths :source :chain}…] :lock}, in the order
  they're first reached. Options: :update (look Git packages up again,
  not from skein.lock)."
  [dir & {:keys [update]}]
  (let [dir (io/canonical dir)
        project (read-project dir)
        lock (read-lock dir)
        overrides (:overrides project)
        root-name (or (:name project) (symbol (io/file-name dir)))
        chosen (atom {root-name {:id [:path dir] :chain [root-name] :source "this project"}})
        order (atom [])
        new-lock (atom {})
        visit (fn visit [name spec base chain]
                (let [[spec base] (if-let [o (get overrides name)] [o dir] [spec base])
                      chain (conj chain name)
                      found (locate name spec base lock update)
                      seen (get @chosen name)]
                  (when (:lock found) (swap! new-lock assoc name (:lock found)))
                  (cond
                    (nil? seen)
                    (let [p (read-project (:dir found))
                          pkg {:name name :version (:version p) :dir (:dir found)
                               :paths (mapv (fn [x] (io/path (:dir found) x)) (:paths p))
                               :source (:source found) :chain chain :id (:id found)}]
                      (swap! chosen assoc name pkg)
                      (swap! order conj name)
                      (doseq [[n s] (sort-by (fn [[n _]] (str n)) (:deps p))]
                        (visit n s (:dir found) chain)))

                    (not= (:id seen) (:id found))
                    (error (str "Two versions of " name " in the build:\n"
                                "  " (:source seen) ", by " (chain-text (:chain seen)) "\n"
                                "  " (:source found) ", by " (chain-text chain) "\n"
                                "Add " name " to :overrides in " (io/path dir "skein.edn") " to choose one."))

                    :else nil)))]
    (doseq [[n s] (sort-by (fn [[n _]] (str n)) (:deps project))]
      (visit n s dir [root-name]))
    {:project project :dir dir
     :paths (mapv (fn [x] (io/path dir x)) (:paths project))
     :packages (mapv (fn [n] (dissoc (get @chosen n) :id)) @order)
     :lock @new-lock}))

(defn write-lock!
  "Write resolution r's skein.lock, if it changed. True if it was written."
  [r]
  (let [f (io/path (:dir r) "skein.lock")
        entries (:lock r)]
    (cond (and (empty? entries) (not (io/exists? f))) false
          (= entries (read-lock (:dir r))) false
          :else (do (io/write-text f (lock-text entries)) true))))

(defn use-project!
  "Use the project in folder dir: resolve its packages (fetching what's
  missing, and writing skein.lock if it changed), and put its paths, then
  its packages', then its test paths, on the library path. The
  resolution."
  [dir]
  (let [r (resolve-project dir)
        tests (map (fn [p] (io/path (:dir r) p)) (:test-paths (:project r)))]
    (try (write-lock! r) (catch Error _ nil)) ; (a project we can't write to still runs)
    (doseq [p (concat (:paths r) (mapcat :paths (:packages r)) (filter io/directory? tests))]
      (add-lib-path! p))
    r))

;; ---- the command line ----

(defn main
  "`skein deps [--update]`: resolve the project here (or above), fetch its
  Git packages, write skein.lock, and list the packages with the chain
  that brought each in. --update looks Git packages up again rather than
  using the commits skein.lock recorded."
  [& args]
  (if-let [dir (find-project (sys/cwd))]
    (let [r (resolve-project dir :update (some (fn [a] (= a "--update")) args))
          wrote (write-lock! r)
          p (:project r)]
      (println (str (or (:name p) (io/file-name dir)) (when (:version p) (str " " (:version p))) " (" dir ")"))
      (doseq [pkg (:packages r)]
        (println (str "  " (:name pkg) (when (:version pkg) (str " " (:version pkg))) ": " (:source pkg)
                      (when (> (count (:chain pkg)) 2) (str ", for " (chain-text (butlast (:chain pkg))))))))
      (when (empty? (:packages r)) (println "  (no packages)"))
      (when wrote (println "Wrote skein.lock."))
      0)
    (do (println "skein deps: no skein.edn here or in a folder above") 1)))

(defn load-main!
  "Project folder dir's :main (ns/name), its namespace loaded, as a
  string; nil if it has none. For skein build."
  [dir]
  (when-let [m (:main (read-project dir))]
    (when-not (and (symbol? m) (namespace m))
      (error (str (io/path dir "skein.edn") ": :main is a function's full name, as my.app/main")))
    (require (symbol (namespace m)))
    (str m)))
