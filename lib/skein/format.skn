;;;; skein.format — numbers and quantities as text for people.
;;;;
;;;; `format` and `printf` themselves are in skein.core (printf-style
;;;; directives: %s %S %d %f %e %g %x %o %b %c %% %n, with flags - 0 + space
;;;; and , and a width and precision).

(ns skein.format
  (:require [skein.math :as math]))

(defn number
  "n with thousands separators and, with :decimals, that many digits after
  the point."
  ^String [^Number n & {:keys [decimals]}]
  (if (and (integer? n) (nil? decimals))
    (format "%,d" n)
    (format (str "%,." (or decimals 2) "f") n)))

(defn percent
  "Fraction x as a percentage, with :decimals digits after the point (none
  by default), as number takes them: 0.256 → \"26%\"."
  ^String [^Number x & {:keys [decimals] :or {decimals 0}}]
  (str (format (str "%." decimals "f") (* 100.0 x)) "%"))

(defn bytes-size
  "A byte count in the largest unit that keeps it at least 1, with one
  decimal: 1536 → \"1.5 KB\" (units of 1024)."
  ^String [^Number n]
  (let [units ["B" "KB" "MB" "GB" "TB" "PB"]]
    (loop [x (float n) i 0]
      (if (and (>= (abs x) 1024) (< i (dec (count units))))
        (recur (/ x 1024) (inc i))
        (if (zero? i) (str (int x) " B") (format "%.1f %s" x (nth units i)))))))

(defn duration
  "Milliseconds as the two largest units, rounded: 3725000 → \"1h 2m\",
  1500 → \"1.5s\", 19.6 → \"20ms\", 0.4 → \"0.4ms\" (a decimal under 10 ms)."
  ^String [^Number ms]
  (let [x (double ms)]
    (cond (< x 9.95) (str (format "%.1f" x) "ms")
          (< x 999.5) (str (math/round x) "ms")
          (< x 59950) (format "%.1fs" (/ x 1000.0))
          :else (let [s (math/round (/ x 1000.0)) m (quot s 60) h (quot m 60) d (quot h 24)]
                  (cond (pos? d) (str d "d " (rem h 24) "h")
                        (pos? h) (str h "h " (rem m 60) "m")
                        :else (str m "m " (rem s 60) "s"))))))

(defn ordinal "n with its English ordinal suffix: 1st, 2nd, 3rd, 11th, 22nd." ^String [^Integer n]
  (let [r100 (rem (abs n) 100) r10 (rem (abs n) 10)]
    (str n (cond (<= 11 r100 13) "th" (= r10 1) "st" (= r10 2) "nd" (= r10 3) "rd" :else "th"))))

(defn plural
  "\"1 file\", \"2 files\": n with word, made plural (adding s, or using
  plural-word) unless n is 1."
  (^String [n word] (plural n word (str word "s")))
  (^String [n word plural-word] (str n " " (if (= 1 n) word plural-word))))
