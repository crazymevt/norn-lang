;;;; JSON Lines, with streaming reduction over existing Skein I/O handles.

(ns skein.ndjson
  (:refer-core :exclude [read-string])
  (:require [skein.io :as io] [skein.json :as json] [skein.string :as str]))

(defn- parse-line [s source line keys]
  (try (json/read-string s :keys keys)
       (catch ParseError e
         (error ParseError :source source :line line
                :message (str "JSON Lines, line " line ": " (condition-message e))))))

(defn- reduce-lines [read-line f init source keys]
  (loop [acc init line 1]
    (if-some [s (read-line)]
      (let [result (f acc (parse-line s source line keys))]
        (if (reduced? result) (unreduced result) (recur result (inc line))))
      acc)))

(defn reduce-records
  "Reduce JSON Lines from a skein.io line reader. A reduced result finishes
  the reduction and the same reader can continue with the next record.
  :keys as skein.json/read-string's (keyword by default)."
  [f init ^io/LineReader reader & {:keys [keys] :or {keys keyword}}]
  (reduce-lines #(io/read-line reader) f init "JSON Lines" keys))

(defn read-file "Read a UTF-8 JSON Lines file as a vector. :keys as skein.json/read-string's."
  ^Vector [^String path & {:keys [keys] :or {keys keyword}}]
  (io/with-open [handle (io/open path :read)]
    (let [reader (io/line-reader handle)]
      (reduce-lines #(io/read-line reader) conj [] (str path) keys))))

(defn read-string "Read JSON Lines text as a vector. :keys as skein.json/read-string's."
  ^Vector [^String s & {:keys [keys] :or {keys keyword}}]
  (if (= "" s) []
      (let [lines (vec (str/split s "\n"))
            lines (if (str/ends-with? s "\n") (pop lines) lines)]
        (mapv (fn [i line] (parse-line line "JSON Lines" (inc i) keys)) (range (count lines)) lines))))

(defn write-record "Write a JSON value and LF to an open handle." [handle value]
  (io/write handle (str (json/write-string value) "\n")))

(defn write-file "Write one JSON value per line to a UTF-8 file." [^String path values]
  (io/with-open [handle (io/open path :write)]
    (doseq [value values] (write-record handle value))))

(defn write-string "Write a sequence of values as JSON Lines text with LF terminators." ^String [values]
  (str/join (map #(str (json/write-string %) "\n") values)))
