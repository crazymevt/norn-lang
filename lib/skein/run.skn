;;;; skein.run — `skein run ARGS…`: the project's :main, called with ARGS, as
;;;; a built image calls it: an integer result is the exit status.

(ns skein.run
  (:require [skein.deps :as deps]))

(defn main
  "Call the :main of the project here (this folder's or the nearest above
  with a skein.edn) with args: the exit status (2 when there's no project or
  :main)."
  [& args]
  (if-let [dir (deps/find-project ".")]
    (if-let [entry (deps/load-main! dir)]
      (let [r (apply (var-get (resolve (symbol entry))) args)]
        (if (integer? r) r 0))
      (do (println (str "skein run: " dir "/skein.edn has no :main (the entry function, as my.app/main)")) 2))
    (do (println "skein run: no skein.edn here or in a folder above") 2)))
