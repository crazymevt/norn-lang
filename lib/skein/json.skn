;;;; skein.json — JSON text to Skein data and back.
;;;;
;;;; Reading: objects become maps (keys as keywords, or as :keys makes them),
;;;; arrays become vectors, numbers become integers (of any size) or floats,
;;;; null becomes nil.
;;;;
;;;; Writing: maps (with string, keyword, symbol or number keys) become
;;;; objects; vectors, lists, sets and other sequences become arrays;
;;;; keywords, symbols and characters become strings; ratios become floats.
;;;; NaN, the infinities, and other values are an error.

(ns skein.json
  (:refer-core :exclude [read-string]))

(defn- keys-with
  "x with every map's string keys made (f key)."
  [f x]
  (cond (map? x) (into {} (map (fn [[k v]] [(if (string? k) (f k) k) (keys-with f v)])) x)
        (vector? x) (mapv (fn [v] (keys-with f v)) x)
        :else x))

(defn read-string
  "The value of JSON text s. Option :keys: what object keys become, a
  function of the key's text: keyword (the default), identity to keep them
  strings, or another (as skein.yaml, skein.toml and skein.csv take it)."
  [^String s & {:keys [keys] :or {keys keyword}}]
  (cond (identical? keys keyword) (%json-read s true)
        (identical? keys identity) (%json-read s false)
        :else (keys-with keys (%json-read s false))))

(defn- key-text [k]
  (cond (or (keyword? k) (symbol? k)) (if (namespace k) (str (namespace k) "/" (name k)) (name k))
        :else (str k)))

(defn- check-keys
  "An error for the first map in x with two keys that write as the same
  text (\"a\" and :a, 1 and \"1\"): JSON would hold the key twice."
  [x]
  (cond (map? x) (do (when (and (> (count x) 1) (not (every? string? (keys x))))
                       (loop [ks (keys x) seen #{}]
                         (when (seq ks)
                           (let [t (key-text (first ks))]
                             (when (contains? seen t)
                               (error TypeError :expected "keys that write as different text" :value x
                                      :message (str "JSON: two keys of the map write as " (pr-str t))))
                             (recur (rest ks) (conj seen t))))))
                     (doseq [v (vals x)] (check-keys v)))
        (and (coll? x) (not (string? x))) (doseq [v x] (check-keys v))
        :else nil))

(defn write-string
  "JSON text for x. Options: :pretty indents two spaces per level; :ascii
  escapes every non-ASCII character as \\uXXXX. Two keys of a map that
  write as the same text (\"a\" and :a) are an error."
  ^String [x & {:keys [pretty ascii]}]
  (check-keys x)
  (%json-write x pretty ascii))

(defn read-file "The JSON value in file path (UTF-8)." [^String path & opts] (apply read-string (slurp path) opts))
(defn write-file "Write x to path as JSON." [^String path x & opts] (spit path (apply write-string x opts)))
