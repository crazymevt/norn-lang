;;;; YAML configuration documents, using YAML 1.2 Core scalar resolution.
;;;; Maps' string keys read as keywords, as in norn.json and norn.toml
;;;; (:keys identity keeps them strings).

(ns norn.yaml
  (:refer-core :exclude [read-string])
  (:require [norn.io :as io] [norn.json :as json] [norn.string :as str]))

(defn- fail! [{:keys [source]} line message]
  (error ParseError :source source :line line :message (str "YAML, line " line ": " message)))

(defn- indent [s]
  (loop [i 0] (if (= \space (nth s i nil)) (recur (inc i)) i)))

(defn- separation? [c] (contains? #{nil \space \tab \newline \return} c))

(defn- scan-line [s]
  ;; Find the first block mapping colon and comment outside quoted/flow text.
  (let [cs (vec s)]
    (loop [i 0 quote nil flow 0 colon nil boundary? true]
      (let [c (get cs i) next-c (get cs (inc i))]
        (cond
          (nil? c) [s colon flow]
          quote (cond
                  (or (and (= quote \") (= c \\)) (and (= quote \') (= c next-c \')))
                  (recur (+ i 2) quote flow colon false)
                  (= c quote) (recur (inc i) nil flow colon true)
                  :else (recur (inc i) quote flow colon false))
          (and (= c \#) (or (zero? i) (separation? (get cs (dec i)))))
          [(subs s 0 i) colon flow]
          (and boundary? (= c \&))
          (let [end (loop [j (inc i)]
                      (let [a (get cs j)]
                        (if (or (separation? a) (contains? #{\, \[ \] \{ \}} a)) j (recur (inc j)))))]
            (recur end nil flow colon true))
          (and boundary? (contains? #{\" \'} c)) (recur (inc i) c flow colon false)
          (and boundary? (contains? #{\[ \{} c)) (recur (inc i) nil (inc flow) colon true)
          (and (pos? flow) (contains? #{\] \}} c)) (recur (inc i) nil (dec flow) colon false)
          (and (= c \:) (separation? next-c))
          (recur (inc i) nil flow (or colon (when (zero? flow) i)) true)
          :else (recur (inc i) nil flow colon
                       (or (and boundary? (separation? c))
                           (and boundary? (contains? #{\- \?} c) (separation? next-c))
                           (and (pos? flow) (contains? #{\, \:} c)))))))))

(defn- line-info [st i]
  (let [s (nth (:lines st) i) spaces (indent s)
        [body _ _] (scan-line (subs s spaces))]
    (when (= \tab (nth body 0 nil))
      (fail! st (inc i) "tabs cannot indent YAML"))
    {:indent spaces :body (str/trimr body) :line (inc i)}))

(defn- peek-line! [{:keys [lines at] :as st}]
  (loop [i @at]
    (when (< i (count lines))
      (let [line (line-info st i)]
        (if (= "" (:body line))
          (recur (inc i))
          (do (vreset! at i) line))))))

(defn- take-line! [st]
  (when-let [line (peek-line! st)]
    (vswap! (:at st) inc)
    line))

(defn- radix-int [s base]
  (reduce (fn [n c] (+ (* n base) (str/index-of "0123456789abcdef" c))) 0 (str/lower-case s)))

(defn- core-scalar [s]
  (cond
    (contains? #{"" "~" "null" "Null" "NULL"} s) nil
    (contains? #{"true" "True" "TRUE"} s) true
    (contains? #{"false" "False" "FALSE"} s) false
    (re-matches #"[+-]?[0-9]+" s) (parse-long (str/replace-first s "+" ""))
    (re-matches #"0o[0-7]+" s) (radix-int (subs s 2) 8)
    (re-matches #"0x[0-9A-Fa-f]+" s) (radix-int (subs s 2) 16)
    (re-matches #"[+-]?(?:\.inf|\.Inf|\.INF)" s) (if (str/starts-with? s "-") ##-Inf ##Inf)
    (contains? #{".nan" ".NaN" ".NAN"} s) ##NaN
    (re-matches #"[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?" s) (parse-double s)
    :else s))

(defn- cursor [s] {:chars (vec s) :pos (volatile! 0)})
(defn- peek-c [{:keys [chars pos]}] (get chars @pos))
(defn- next-c! [{:keys [pos] :as c}]
  (let [ch (peek-c c)] (vswap! pos inc) ch))
(defn- take-c! [c ch]
  (when (= ch (peek-c c)) (next-c! c) true))
(defn- skip-flow-space! [c]
  (while (and (peek-c c) (separation? (peek-c c))) (next-c! c)))

(def ^:private escapes
  {\0 (char 0) \a (char 7) \b \backspace \t \tab \tab \tab \n \newline
   \v (char 11) \f \formfeed \r \return \e (char 27) \space \space
   \" \" \/ \/ \\ \\ \N (char 0x85) \_ (char 0xA0) \L (char 0x2028) \P (char 0x2029)})

(defn- escape! [st line c]
  (let [ch (next-c! c) width (get {\x 2 \u 4 \U 8} ch)]
    (if width
      (let [digits (apply str (repeatedly width #(next-c! c)))]
        (when-not (and (= width (count digits)) (re-matches #"[0-9A-Fa-f]+" digits))
          (fail! st line "invalid Unicode escape"))
        (let [n (radix-int digits 16)]
          (when (or (> n 0x10FFFF) (<= 0xD800 n 0xDFFF)) (fail! st line "invalid Unicode scalar"))
          (char n)))
      (or (get escapes ch) (fail! st line "invalid double-quoted escape")))))

(defn- quoted! [st line c]
  (let [quote (next-c! c)]
    (loop [out (transient [])]
      (let [ch (next-c! c)]
        (cond (nil? ch) (fail! st line "unclosed quoted string")
              (and (= ch quote \') (take-c! c \')) (recur (conj! out \'))
              (= ch quote) (str/join (persistent! out))
              (and (= quote \") (= ch \\)) (recur (conj! out (escape! st line c)))
              :else (recur (conj! out ch)))))))

(defn- flow-token! [{:keys [chars pos] :as c}]
  (let [start @pos]
    (while (let [ch (peek-c c) after (get chars (inc @pos))]
             (and ch (not (contains? #{\, \[ \] \{ \}} ch))
                  (not (and (= ch \:) (or (separation? after) (contains? #{\, \[ \] \{ \}} after))))))
      (next-c! c))
    (str/trim (str/join (subvec chars start @pos)))))

(defn- name-token! [st line c]
  (let [{:keys [chars pos]} c start @pos]
    (while (let [ch (peek-c c)] (and (not (separation? ch)) (not (contains? #{\, \[ \] \{ \}} ch))))
      (next-c! c))
    (when (= start @pos) (fail! st line "expected an anchor or alias name"))
    (str/join (subvec chars start @pos))))

(defn- alias! [st line name]
  (let [anchors @(:anchors st)]
    (when-not (contains? anchors name) (fail! st line (str "unknown or cyclic alias " name)))
    (get anchors name)))

(defn- assoc-key! [st line out key value]
  (let [key (if (string? key) ((:key-fn st) key) key)]
    (when (coll? key) (fail! st line "collection keys are outside the YAML configuration reader"))
    (when (contains? out key) (fail! st line (str "duplicate map key " (pr-str key))))
    (assoc out key value)))

(defn- check-depth! [st line depth]
  (when (> depth 128) (fail! st line "document nests deeper than 128 levels")))

(declare flow-node! block-node!)

(defn- flow-seq! [st line c depth]
  (loop [out []]
    (skip-flow-space! c)
    (if (take-c! c \]) out
        (let [node (flow-node! st line c depth)]
          (skip-flow-space! c)
          (let [node (if (take-c! c \:)
                       (do (skip-flow-space! c)
                           (assoc-key! st line {} node
                                       (when-not (contains? #{\, \]} (peek-c c))
                                         (flow-node! st line c (inc depth)))))
                       node)
                out (conj out node)]
            (skip-flow-space! c)
            (cond (take-c! c \]) out
                  (take-c! c \,) (recur out)
                  :else (fail! st line "expected ',' or ']'")))))))

(defn- flow-map! [st line c depth]
  (loop [out {}]
    (skip-flow-space! c)
    (if (take-c! c \}) out
        (let [key (flow-node! st line c depth)]
          (skip-flow-space! c)
          (let [value (when (take-c! c \:)
                        (skip-flow-space! c)
                        (when-not (contains? #{\, \}} (peek-c c))
                          (flow-node! st line c depth)))
                out (assoc-key! st line out key value)]
            (skip-flow-space! c)
            (cond (take-c! c \}) out
                  (take-c! c \,) (recur out)
                  :else (fail! st line "expected ',' or '}'")))))))

(defn- plain! [st line s]
  (when (or (= "" s) (re-find #"^[!&*%@\x60|>,\]\}]" s))
    (fail! st line (str "unsupported or empty plain scalar " (pr-str s))))
  (core-scalar s))

(defn- flow-node! [st line c depth]
  (check-depth! st line depth)
  (skip-flow-space! c)
  (case (peek-c c)
    \[ (do (next-c! c) (flow-seq! st line c (inc depth)))
    \{ (do (next-c! c) (flow-map! st line c (inc depth)))
    \' (quoted! st line c)
    \" (quoted! st line c)
    \* (do (next-c! c) (alias! st line (name-token! st line c)))
    \& (do (next-c! c)
           (let [name (name-token! st line c) value (flow-node! st line c (inc depth))]
             (vswap! (:anchors st) assoc name value)
             value))
    (plain! st line (flow-token! c))))

(defn- inline-node! [st line s depth]
  (let [head (nth s 0 nil)]
    (if (contains? #{\[ \{ \" \' \*} head)
      (let [text (if (contains? #{\[ \{} head)
                   (loop [text s]
                     (if (pos? (nth (scan-line text) 2))
                       (if-let [more (take-line! st)]
                         (recur (str text " " (:body more)))
                         (fail! st line "unclosed flow collection"))
                       text))
                   s)
            c (cursor text)
            value (flow-node! st line c depth)]
        (skip-flow-space! c)
        (when (peek-c c) (fail! st line "unexpected text after scalar or flow collection"))
        value)
      (plain! st line s))))

(defn- sequence-entry? [s] (and (= \- (nth s 0 nil)) (separation? (nth s 1 nil))))
(defn- colon-index [s] (second (scan-line s)))

(defn- block-lines! [{:keys [lines at final-newline?]} parent width]
  (let [start @at size (count lines)
        first-content (loop [i start]
                        (when (< i size)
                          (let [s (nth lines i)] (if (str/blank? s) (recur (inc i)) s))))
        margin (if width (+ parent width) (max (inc parent) (if first-content (indent first-content) 0)))]
    (loop [i start out []]
      (if (= i size) (do (vreset! at i) out)
          (let [s (nth lines i) spaces (indent s)]
            (if (and (not (str/blank? s)) (< spaces margin))
              (do (vreset! at i) out)
              (recur (inc i) (conj out [(subs s (min margin (count s))) (or final-newline? (< (inc i) size))]))))))))

(defn- block-text [lines style chomp]
  (let [body (str/join
              (map-indexed
               (fn [i [s ended?]]
                 (let [next-s (first (get lines (inc i)))
                       next-content (when (and (seq s) (= "" next-s))
                                      (loop [j (inc i)]
                                        (when-let [[text _] (get lines j)]
                                          (if (seq text) text (recur (inc j))))))
                       normal? #(and (seq %) (not (contains? #{\space \tab} (first %))))]
                   (str s (when ended?
                            (cond
                              (and (= style ">") (normal? s) (normal? next-s)) " "
                              (and (= style ">") (normal? s) (= "" next-s) (normal? next-content)) ""
                              :else "\n")))))
               lines))
        trimmed (str/replace body #"\n+$" "")]
    (case chomp
      "+" body
      "-" trimmed
      (if (and (seq trimmed) (str/ends-with? body "\n")) (str trimmed "\n") trimmed))))

(defn- block-scalar! [st line parent s]
  (if-let [[_ style marker width width2 marker2] (re-matches #"([|>])(?:([-+])([1-9])?|([1-9])([-+])?)?" s)]
    (block-text (block-lines! st parent (when-let [n (or width width2)] (parse-long n)))
                style (or marker marker2))
    (fail! st line "invalid block scalar header")))

(defn- anchor-info [st line s]
  (or (re-matches #"&([^ \t,\[\]{}]+)(?:[ \t]+(.*))?" s)
      (fail! st line "invalid anchor")))

(defn- child! [st line parent body depth indentless?]
  (check-depth! st line depth)
  (cond
    (= "" body)
    (when-let [{:keys [indent body] :as more} (peek-line! st)]
      (when (or (> indent parent) (and indentless? (= indent parent) (sequence-entry? body)))
        (take-line! st)
        (block-node! st more depth)))
    (str/starts-with? body "&")
    (let [[_ name rest] (anchor-info st line body)
          value (child! st line parent (or rest "") (inc depth) indentless?)]
      (vswap! (:anchors st) assoc name value)
      value)
    (contains? #{\| \>} (first body)) (block-scalar! st line parent body)
    (colon-index body) (fail! st line "a nested block mapping must start on its own line")
    :else (inline-node! st line body depth)))

(defn- check-no-continuation!
  "A line indented past level that no node consumed would continue a scalar."
  [st more level]
  (when (and more (> (:indent more) level))
    (fail! st (:line more) "unexpected indentation (multi-line plain scalars are unsupported)")))

(defn- block-map! [st first-entry depth]
  (let [level (:indent first-entry)]
    (loop [out {} entry first-entry]
      (let [{:keys [line body]} entry i (colon-index body)
            key-text (str/trimr (subs body 0 i))
            key (when (seq key-text) (inline-node! st line key-text (inc depth)))
            val (child! st line level (str/triml (subs body (inc i))) (inc depth) true)
            out (assoc-key! st line out key val)
            more (peek-line! st)]
        (check-no-continuation! st more level)
        (if (and (= level (:indent more)) (colon-index (:body more)) (not (sequence-entry? (:body more))))
          (recur out (take-line! st))
          out)))))

(defn- block-seq! [st first-entry depth]
  (let [level (:indent first-entry)]
    (loop [out [] entry first-entry]
      (let [{:keys [line body]} entry rest (subs body 1) content (str/triml rest)
            child-indent (+ level 1 (- (count rest) (count content)))
            value (if (or (sequence-entry? content) (and (seq content) (colon-index content)))
                    (block-node! st {:line line :indent child-indent :body content} (inc depth))
                    (child! st line level content (inc depth) false))
            out (conj out value)
            more (peek-line! st)]
        (check-no-continuation! st more level)
        (if (and (= level (:indent more)) (sequence-entry? (:body more)))
          (recur out (take-line! st))
          out)))))

(defn- block-node! [st {:keys [line body indent] :as entry} depth]
  (check-depth! st line depth)
  (cond (sequence-entry? body) (block-seq! st entry depth)
        (colon-index body) (block-map! st entry depth)
        (or (str/starts-with? body "&") (contains? #{\| \>} (first body)))
        (child! st line (max 0 (dec indent)) body depth false)
        :else (inline-node! st line body depth)))

(defn- document [s source key-fn]
  (let [s (str/replace (str/replace s "\r\n" "\n") "\r" "\n")
        s (if (= (char 0xFEFF) (first s)) (subs s 1) s)
        end? (str/ends-with? s "\n")
        lines (vec (str/split s "\n"))
        st {:lines (if end? (pop lines) lines) :at (volatile! 0) :anchors (volatile! {})
            :source source :key-fn key-fn :final-newline? end?}
        start (take-line! st)
        start (if (and (= 0 (:indent start)) (str/starts-with? (:body start) "---")
                       (separation? (nth (:body start) 3 nil)))
                (let [body (str/triml (subs (:body start) 3))]
                  (if (= "" body) (take-line! st) (assoc start :body body)))
                start)
        end-marker? (fn [line] (and (= 0 (:indent line)) (= "..." (:body line))))
        value (when (and start (not (end-marker? start))) (block-node! st start 0))]
    (when start (check-no-continuation! st (peek-line! st) (:indent start)))
    (when-not (end-marker? start)
      (when (end-marker? (peek-line! st)) (take-line! st)))
    (when-let [extra (peek-line! st)] (fail! st (:line extra) "unexpected content after the document"))
    value))

(defn read-string
  "Read one YAML configuration document. :keys transforms string map keys
  (keyword by default; identity keeps them strings). Supports block and
  flow collections, Core scalars, block strings, and aliases to previously
  completed nodes."
  [^String s & {:keys [keys] :or {keys keyword}}]
  (document s "YAML" keys))

(defn read-file "Read one UTF-8 YAML configuration document (options as read-string's)." [^String path & {:keys [keys] :or {keys keyword}}]
  (document (io/read-text path) (str path) keys))

(defn- write-node [x depth]
  (when (> depth 128) (error "YAML document nests deeper than 128 levels"))
  (cond
    (string? x) (json/write-string x)
    (keyword? x) (json/write-string (subs (str x) 1))
    (nil? x) "null"
    (or (boolean? x) (integer? x)) (str x)
    (float? x) (cond (NaN? x) ".nan" (= x ##Inf) ".inf" (= x ##-Inf) "-.inf" :else (json/write-string x))
    (map? x) (let [deeper (inc depth)
                   entries (mapv (fn [[k v]]
                                   (when (coll? k) (error "YAML map keys must be scalar" k))
                                   [(write-node k deeper) v]) x)]
               (when-not (= (count entries) (count (set (map first entries))))
                 (error "Duplicate YAML map key after encoding"))
               (str "{" (str/join ", " (map (fn [[k v]] (str k ": " (write-node v deeper))) entries)) "}"))
    (sequential? x) (str "[" (str/join ", " (map #(write-node % (inc depth)) x)) "]")
    :else (error "Unsupported YAML value" x)))

(defn write-string "Write Norn values as YAML flow collections and Core scalars." ^String [x]
  (str (write-node x 0) "\n"))

(defn write-file "Write Norn values as a UTF-8 YAML document." [^String path x]
  (io/write-text path (write-string x)))
