;;;; norn.validate — the shapes of the core forms people get wrong most
;;;; (M8 part 8.3, decision 5): let, loop, fn, defn, cond, case and ns.
;;;;
;;;; Each is still the defmacro it was; the expander first checks a call
;;;; here, so a malformed one is an error that says what was expected, at
;;;; the part that's wrong, rather than whatever the expansion tripped over.
;;;; A call that fits goes on to the macro unchanged.
;;;;
;;;; A quick look at the call's shape passes almost every call; only one it
;;;; doesn't is matched against the form's syntax-parse pattern, which words
;;;; the error (and lets through anything the quick look was too strict
;;;; about).

(ns norn.validate
  (:require [norn.syntax :as syn :refer [syntax-parse define-syntax-class]]))

(defn- binding-form? [e] (or (and (symbol? e) (nil? (namespace e))) (vector? e) (map? e)))

(syn/%define-pred-class! 'binding-form "a binding form (a name, a vector or a map)"
                         (fn [s] (binding-form? (syn/syntax-e s))))

(syn/%define-pred-class! 'param "a parameter (a name, &, a vector or a map)"
                         (fn [s] (binding-form? (syn/syntax-e s))))

(syn/%define-pred-class! 'attr-map "an attribute map" (fn [s] (map? (syn/syntax-e s))))

(define-syntax-class arity "an arity ([params] body…)"
                     ([p:param ...] body ...))

;; ---- the quick look: each part's syntax-e, one level down ----

(defn- parts [s] (vec (syn/syntax-e s)))

(defn- params? [s]
  (let [e (syn/syntax-e s)]
    (and (vector? e) (every? (fn [p] (binding-form? (syn/syntax-e p))) e))))

(defn- bindings? [s]
  (let [e (syn/syntax-e s)]
    (and (vector? e) (even? (count e))
         (loop [xs (seq e)]
           (or (nil? xs) (and (binding-form? (syn/syntax-e (first xs))) (recur (nnext xs))))))))

(defn- fn-tail?
  "Arities: [params] body…, or ([params] body…)…."
  [xs]
  (and (seq xs)
       (or (params? (first xs))
           (every? (fn [a] (let [e (syn/syntax-e a)] (and (seq? e) (seq e) (params? (first e))))) xs))))

(defn- quick-let [s] (let [xs (parts s)] (and (>= (count xs) 2) (bindings? (nth xs 1)))))

(defn- quick-fn [s]
  (let [xs (subvec (parts s) 1)
        xs (if (and (seq xs) (symbol? (syn/syntax-e (first xs)))) (subvec xs 1) xs)]
    (fn-tail? xs)))

(defn- quick-defn [s]
  (let [xs (parts s)]
    (and (>= (count xs) 3) (symbol? (syn/syntax-e (nth xs 1)))
         (let [xs (subvec xs 2)
               xs (if (and (seq xs) (string? (syn/syntax-e (first xs)))) (subvec xs 1) xs)
               xs (if (and (seq xs) (map? (syn/syntax-e (first xs)))) (subvec xs 1) xs)]
           (fn-tail? xs)))))

(defn- quick-cond [s] (odd? (count (parts s))))

(defn- quick-case [s] (>= (count (parts s)) 2))

(defn- checked
  "A validator: calls quick? passes, else the syntax-parse check."
  [quick? check]
  (fn [s] (when-not (quick? s) (check s))))

(def validators
  "Core macro (by var name) → its validator."
  {"norn.core/let"
   (checked quick-let (fn [s] (syntax-parse s [(_ (~describe "a binding vector [name value …]" [(~seq b:binding-form (~describe "a value" v)) ...]) body ...) nil])))
   "norn.core/loop"
   (checked quick-let (fn [s] (syntax-parse s [(_ (~describe "a binding vector [name value …]" [(~seq b:binding-form (~describe "a value" v)) ...]) body ...) nil])))
   "norn.core/fn"
   (checked quick-fn (fn [s] (syntax-parse s [(_ (~optional name:id) (~or (~seq [p:param ...] body ...) (~seq a:arity ...+))) nil])))
   "norn.core/defn"
   (checked quick-defn (fn [s] (syntax-parse s [(_ name:id (~optional doc:str) (~optional attrs:attr-map)
                                                   (~or (~seq [p:param ...] body ...) (~seq a:arity ...+)))
                                                nil])))
   "norn.core/cond"
   (checked quick-cond (fn [s] (syntax-parse s [(_ (~seq test (~describe "a result after the test" then)) ...) nil])))
   "norn.core/case"
   (checked quick-case (fn [s] (syntax-parse s [(_ (~describe "an expression to choose by" e) clause ...) nil])))
   ;; (rare enough to match every time)
   "norn.core/ns"
   (fn [s] (syntax-parse s [(_ name:id (~describe "an ns clause, (:require …), (:require-for-syntax …) or (:refer-core …)"
                                                  (~or (:require (~or lib:id [lib:id & opts]) ...)
                                                       (:require-for-syntax (~or lib:id [lib:id & opts]) ...)
                                                       (:refer-core opt ...)))
                               ...)
                            nil]))})
