;;;; norn.stm — software transactional memory (M9 part 9.7, design §3.2).
;;;;
;;;; A ref is a cell changed only inside a transaction, (dosync …), with
;;;; other refs, all or none:
;;;;
;;;;   (def from (ref 100))  (def to (ref 0))
;;;;   (dosync (alter from - 10) (alter to + 10))
;;;;
;;;; As Clojure's, it's MVCC. A transaction reads every ref as it was when
;;;; the transaction began (its read point), so it sees one moment
;;;; throughout, and its writes stay its own until it commits. A commit
;;;; locks the refs it changes, in a fixed order, checks that none was
;;;; changed by another transaction since the read point, and writes them
;;;; at a new point; if one was, the transaction runs again, from the
;;;; start, at a new read point. So its body may run more than once: no
;;;; side effects in it (io! says so), or run them after-commit.
;;;;
;;;; - alter and ref-set change a ref: a ref another transaction changes
;;;;   first is a conflict.
;;;; - commute changes it with a function that commutes (+, conj…): at
;;;;   commit it's applied again to the newest value, and two commutes
;;;;   don't conflict.
;;;; - ensure guards a ref only read, against write skew: the transaction
;;;;   conflicts with any that changes it.
;;;;
;;;; A ref keeps a few old values (:max-history, 10) for transactions
;;;; reading at older points; one that needs a value older than that runs
;;;; again. A ref can't hold a mutable object (design §4.2: a transaction
;;;; run twice can't undo a change to one), unless it's shared.

(ns norn.stm)

(defclass Ref ()
  ((id :initarg :id) (versions :initarg :versions) (lock :initarg :lock)
                     (validator :initarg :validator) (max-history :initarg :max-history)))

(defmethod print-object ((r Ref)) (str "#<ref " (:id r) " " (pr-str (second (peek @(:versions r)))) ">"))

(def ^:private clock "The newest commit point." (atom 0))
(def ^:private ids (atom 0))
(def ^:private stats (atom {:commits 0 :retries 0 :conflicts 0 :history 0 :locks 0}))

(defn ref? "Is x a ref?" ^Boolean [x] (instance? Ref x))

(defn- check-value [v]
  (when (and (mutable? v) (not= :shared (owner v)))
    (error TypeError :message (str "A ref can't hold a mutable object (share it first): " (pr-str v))
           :expected "an immutable value" :value v))
  v)

(defn ref
  "A ref holding x. Options: :validator (a function the new value must
  satisfy for a commit; a falsey answer or an error refuses it),
  :max-history (old values kept for older transactions, 10)."
  ^Ref [x & {:keys [validator max-history]}]
  (check-value x)
  (when (and validator (not (validator x))) (error "ref: the validator refuses the initial value"))
  (make Ref :id (swap! ids inc) :versions (atom [[0 x]]) :lock (atom nil)
        :validator validator :max-history (or max-history 10)))

(defn ref-history-count "How many old values ref r keeps now." ^Integer [^Ref r] (dec (count @(:versions r))))

;; ---- the transaction ----

;; A transaction: {:id :fiber :read-point
;;                 :vals {id [ref value]}  its values for the refs it has changed
;;                 :sets #{id}  :commutes {id [[f args]…]}  :ensures {id ref}
;;                 :after [f…]}, in an atom (it's its fiber's alone).
(def ^:dynamic ^:private *tx* nil)

(defn- retry!
  "Run the transaction again (unwinding to its dosync: tag is its :id,
  also its locks' holder)."
  [tag reason]
  (throw-tag tag [::retry reason]))

(defn- current-tx
  "This fiber's transaction, or nil. (A fiber started inside one inherits
  the binding, not the transaction.)"
  []
  (let [tx *tx*]
    (when (and tx (identical? (:fiber @tx) (current-fiber))) tx)))

(defn in-transaction? "Is this code running in a transaction?" ^Boolean [] (some? (current-tx)))

(defn- tx! [what]
  (or (current-tx) (error (str what ": not in a transaction (dosync)"))))

(defn- newest-point [r] (first (peek @(:versions r))))

(defn- read-at
  "Ref r's value at point rp: waiting if a commit holds it (it may be
  writing a value this transaction should see); a retry if r no longer
  keeps one that old (or, newest?, its newest value)."
  [r rp tx-id newest?]
  (loop [spins 0]
    (let [holder @(:lock r)]
      (if (and holder (not (identical? holder tx-id)))
        (do (yield) (recur (inc spins)))
        (let [vs @(:versions r)
              v (loop [i (dec (count vs))]
                  (cond (neg? i) ::too-old
                        (<= (first (nth vs i)) rp) (second (nth vs i))
                        :else (recur (dec i))))]
          (cond (not= v ::too-old) v
                newest? (second (peek vs))
                :else (retry! tx-id :history)))))))

(defn- tx-value
  ([tx r] (tx-value tx r false))
  ([tx r newest?]
   (let [t @tx]
     (if-let [[_ v] (get (:vals t) (:id r))]
       v
       (read-at r (:read-point t) (:id t) newest?)))))

(defmethod deref-object ((r Ref) _ms _timeout-value)
  (if-let [tx (current-tx)]
    (tx-value tx r)
    (second (peek @(:versions r)))))

(defn ref-set
  "Set ref r to v, in this transaction. v."
  [^Ref r v]
  (let [tx (tx! "ref-set")]
    (check-value v)
    (when (contains? (:commutes @tx) (:id r)) (error "ref-set: can't set a ref after commuting it"))
    ;; (changed since this transaction's read point: it would conflict at
    ;; commit, so run it again now)
    (when (> (newest-point r) (:read-point @tx)) (retry! (:id @tx) :conflicts))
    (swap! tx (fn [t] (-> t (assoc-in [:vals (:id r)] [r v]) (update :sets conj (:id r)))))
    v))

(defn alter
  "Set ref r to (apply f its-value args), in this transaction. The value."
  [^Ref r f & args]
  (let [tx (tx! "alter")]
    (ref-set r (apply f (tx-value tx r) args))))

(defn commute
  "Set ref r to (apply f its-value args), in this transaction; at commit,
  f is applied again to r's newest value, so other transactions changing
  r don't conflict with this one. For an f whose order doesn't matter.
  The value this transaction sees."
  [^Ref r f & args]
  (let [tx (tx! "commute")
        ;; (a value too old for r's history: its newest will do, as
        ;; commit applies f again to the newest anyway)
        v (check-value (apply f (tx-value tx r true) args))]
    (swap! tx (fn [t] (-> t (assoc-in [:vals (:id r)] [r v])
                          (update-in [:commutes (:id r)] (fnil conj []) [f args]))))
    v))

(defn ensure
  "Ref r's value, guarded: this transaction conflicts with any other that
  changes r before it commits (against write skew)."
  [^Ref r]
  (let [tx (tx! "ensure")]
    (swap! tx update :ensures assoc (:id r) r)
    (tx-value tx r)))

(defn after-commit
  "Run (f) once this transaction commits (not if it runs again, or
  fails): the place for side effects. Outside one, at once."
  [f]
  (if-let [tx (current-tx)]
    (do (swap! tx update :after conj f) nil)
    (do (f) nil)))

(defmacro io!
  "(io! body…): body, refused inside a transaction (which may run more
  than once)."
  [& body]
  `(do (when (in-transaction?) (error "io!: side effects inside a transaction")) ~@body))

;; ---- committing ----

(defn- lock-all!
  "Take the locks of refs (in id order, so two commits can't wait on
  each other). false if one stays held too long (then none is held)."
  [refs tx-id]
  (loop [rs refs held []]
    (if (empty? rs)
      true
      (let [r (first rs)]
        (if (loop [spins 0]
              (cond (compare-and-set! (:lock r) nil tx-id) true
                    (< spins 1000) (do (yield) (recur (inc spins)))
                    :else false))
          (recur (rest rs) (conj held r))
          (do (doseq [h held] (reset! (:lock h) nil)) false))))))

(defn- commit!
  "Commit transaction t: the ref changes made, [[ref old new]…], or
  [::retry reason] if it conflicts."
  [t]
  (let [{:keys [id read-point vals sets commutes ensures]} t
        changed (into (set (keys vals)) (keys ensures))]
    (if (empty? changed)
      []
      (let [ref-of (fn [i] (if-let [[r _] (get vals i)] r (get ensures i)))
            refs (sort-by :id (map ref-of changed))]
        (if-not (lock-all! refs id)
          [::retry :locks]
          (try
            (if (some (fn [i] (> (newest-point (ref-of i)) read-point)) (concat sets (keys ensures)))
              [::retry :conflicts]
              (let [news (mapv (fn [i]
                                 (let [[r v] (get vals i)
                                       old (second (peek @(:versions r)))
                                       new (if (contains? sets i)
                                             v
                                             (reduce (fn [x [f args]] (apply f x args)) old (get commutes i)))]
                                   (when-let [ok? (:validator r)]
                                     (when-not (ok? new)
                                       (error (str "A validator refused the new value of " (pr-str r) ": " (pr-str new)))))
                                   [r old (check-value new)]))
                               (filter (fn [i] (contains? vals i)) changed))
                    point (swap! clock inc)]
                (doseq [[r _ new] news]
                  (swap! (:versions r) (fn [vs] (let [vs (conj vs [point new])
                                                      extra (- (count vs) (inc (:max-history r)))]
                                                  (if (pos? extra) (subvec vs extra) vs)))))
                news))
            (finally (doseq [r refs] (reset! (:lock r) nil)))))))))

(def ^:dynamic *max-retries* "How many times a transaction may run again before it's an error." 10000)

(defn run-transaction
  "(f) in a transaction (dosync's function): its value."
  [f]
  (if (current-tx)
    (f) ; (a transaction inside one is part of it)
    (loop [n 0]
      (when (> n *max-retries*) (error (str "A transaction ran " *max-retries* " times without committing")))
      (let [tag (atom nil) ; (the transaction's identity: its retries' catch tag, its locks' holder)
            tx (atom {:id tag :fiber (current-fiber) :read-point @clock
                      :vals {} :sets #{} :commutes {} :ensures {} :after []})
            r (catch-tag tag
                (binding [*tx* tx]
                  (let [v (f)
                        news (commit! @tx)]
                    (if (= ::retry (first news)) news [::ok v news]))))]
        (if (= ::retry (first r))
          (do (swap! stats (fn [m] (-> m (update :retries inc) (update (second r) inc))))
              (yield)
              (recur (inc n)))
          (let [[_ v news] r]
            (swap! stats update :commits inc)
            (when (pos? @%watched) (doseq [[r old new] news] (%fire-watches r old new)))
            (doseq [g (:after @tx)] (g))
            v))))))

(defmacro dosync
  "(dosync body…): body in a transaction: its changes to refs all made at
  once, or none; run again if another transaction got there first. Its
  value."
  [& body]
  `(run-transaction (fn [] ~@body)))

(defn stm-stats
  "Commits and retries so far: {:commits :retries, and the retries'
  reasons: :conflicts (another transaction changed a ref first), :history
  (a value older than a ref keeps), :locks (a commit's lock held too
  long)}."
  ^Map []
  @stats)
