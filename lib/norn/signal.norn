;;;; norn.signal — OS signals as channel messages.

(ns norn.signal)

(defn listen
  "Listen for signals (:int :term :hup :usr1 :usr2 :winch :quit :pipe
  :alrm :cont): {:handle h :signals ch}, where ch receives each signal's
  keyword as it arrives. Stop with stop."
  [& sigs]
  (let [[h ch] (%signal-listen (vec sigs))]
    {:handle h :signals ch}))

(defn stop "Stop listening; the channel closes." [l]
  (%io-close (:handle l))
  (close! (:signals l)))

(defn raise "Send a signal to this process." [sig] (%raise-signal sig))
