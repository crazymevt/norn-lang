;;;; norn.dev — `norn dev ARGS…`: run the project's :main, and reload each
;;;; module of it that's saved, while it runs.
;;;;
;;;; - Calls go through vars (dev mode, design 8.1), so a reloaded function
;;;;   takes effect at its next call, in code already running. A loop
;;;;   already running keeps its own body until it ends.
;;;; - A module with macros reloads its dependents too (they expanded them).
;;;; - A file that doesn't read (a syntax error) isn't loaded: the old code
;;;;   keeps running, and the error is shown.
;;;; - defonce keeps a module's state when it reloads.
;;;; - after-reload! hooks run after each reload (a UI re-renders).
;;;; - When :main has returned, the next save runs it again.
;;;; - Ctrl-C (or SIGTERM) stops it. A program that listens for the signal
;;;;   itself gets it too, and dev waits for it to finish shutting down;
;;;;   one that doesn't is cancelled.

(ns norn.dev
  (:require [norn.deps :as deps] [norn.fs :as fs] [norn.io :as io] [norn.signal :as signal] [norn.string :as str]
            [norn.syntax :as syn]))

;; ---- hooks ----

(def ^:private hooks (atom {}))

(defn after-reload!
  "After each reload norn dev makes, call (f names), names the modules
  reloaded. key names the hook, so registering it again (as a module that
  reloads does) replaces it. Outside norn dev, nothing calls it."
  [key f]
  (swap! hooks assoc key f)
  nil)

;; ---- what a save reloads ----

;; (a path that's gone, as an editor's temporary file is by the time its
;; event comes, or an embedded module's "<norn.x>", stays as it is: it
;; matches no module's file)
(defn- real-path [p] (or (try (io/canonical p) (catch Error _ nil)) p))

(defn- module-at
  "The loaded module whose source is file (a canonical path), or nil."
  [file]
  (some (fn [[m info]] (when (and (:path info) (= file (real-path (:path info)))) m)) @norn.expander/modules))

(defn- has-macros? [m]
  (boolean (some (fn [[_ v]] (macro? v)) (try (ns-interns m) (catch Error _ nil)))))

(defn- dependents
  "Every loaded module that requires one of ms, directly or not, in an
  order that reloads a module after those it requires."
  [ms]
  (let [mods @norn.expander/modules
        req (fn [m] (set (:requires (get mods m))))
        found (loop [found #{} todo (set ms)]
                (let [more (set (for [[m _] mods :when (and (not (contains? found m)) (not (contains? (set ms) m))
                                                            (some todo (req m)))]
                                  m))]
                  (if (empty? more) found (recur (into found more) more))))]
    (loop [order [] left found done (set ms)]
      (if (empty? left)
        order
        (let [ready (filter (fn [m] (every? (fn [r] (or (contains? done r) (not (contains? left r)))) (req m))) left)
              ;; (a cycle can't load at all; take one to go on)
              ready (if (seq ready) (sort-by str ready) [(first (sort-by str left))])]
          (recur (into order ready) (reduce disj left ready) (into done ready)))))))

(defn- reads?
  "nil if file's text reads, else the error's message."
  [file]
  (try (syn/read-all-syntax (io/read-text file) file) nil
       (catch Error e (or (:message e) (str e)))))

(defn reload!
  "Reload the modules whose source files changed (paths), and the
  dependents of any with macros: {:reloaded [module…] :failed [{:module
  :file :error}…] :unknown [file…]} (unknown: no loaded module is from
  that file). A file that doesn't read isn't loaded, so its module keeps
  its old code."
  [files]
  (let [files (distinct (map real-path files))
        found (for [f files] [f (module-at f)])
        unknown (vec (keep (fn [[f m]] (when-not m f)) found))
        [bad good] ((juxt filter remove) (fn [[f _]] (reads? f)) (filter second found))
        failed (atom (mapv (fn [[f m]] {:module m :file f :error (reads? f)}) bad))
        changed (mapv second good)
        order (concat changed (dependents (filter has-macros? changed)))
        reloaded (atom [])]
    (doseq [m order]
      (try (require m :reload)
           (swap! reloaded conj m)
           (catch Error e
             (swap! failed conj {:module m :file (:path (get @norn.expander/modules m)) :error (or (:message e) (str e))}))))
    (when (seq @reloaded)
      (doseq [[k f] @hooks]
        (try (f @reloaded)
             (catch Error e (println (str "norn dev: the after-reload hook " (pr-str k) " failed: " (:message e)))))))
    {:reloaded @reloaded :failed @failed :unknown unknown}))

;; ---- the command ----

(defn- changes
  "The .norn files the next save changed: events from chs, gathered until
  they stop for 100 ms (an editor's save can be several). The signal
  instead if one comes on stop first."
  [chs stop]
  (let [paths (fn [ev] (filter (fn [p] (str/ends-with? p ".norn")) (:paths ev)))
        [ev port] (alts! (conj (vec chs) stop))]
    (cond
      (identical? port stop) ev
      ev
      (loop [acc (set (paths ev))]
        (let [[ev port] (alts! (conj (vec chs) (timeout 100)))]
          (if (and ev (some (fn [c] (identical? c port)) chs))
            (recur (into acc (paths ev)))
            acc))))))

(defn- start-main [entry args done]
  (reset! done false)
  (spawn-detached
    (try (apply (var-get (resolve (symbol entry))) args)
         (catch Error e (println (str "norn dev: " entry " failed: " (:message e))))
         (finally (reset! done true)))))

(defn- stop-main!
  "On signal sig: wait for main, running (fiber), to end if it listens for
  sig itself (it's shutting down), else cancel it."
  [fiber done sig]
  (when-not @done
    (if (> (%signal-listeners sig) 1)
      (loop [n 0] (when (and (not @done) (< n 600)) (sleep 50) (recur (inc n))))
      (cancel! fiber))))

(defn main
  "Run the project's :main with args, reloading what's saved: runs until
  stopped (Ctrl-C)."
  [& args]
  (if-let [dir (deps/find-project ".")]
    (if-let [entry (deps/load-main! dir)]
      (let [project (deps/read-project dir)
            roots (filter io/directory? (map (fn [p] (io/path dir p)) (or (:paths project) ["src"])))
            watches (mapv (fn [r] (fs/watch r :recursive true)) roots)
            done (atom false)]
        (println (str "norn dev: running " entry ", reloading what's saved in " (str/join ", " (:paths project ["src"]))))
        (let [stop (or (try (signal/listen :int :term) (catch Error _ nil)) ; (Windows has only :int)
                       (signal/listen :int))
              fiber (atom (start-main entry args done))]
          (loop []
            (let [files (changes (mapv :events watches) (:signals stop))]
              (cond
                (keyword? files)
                (do (stop-main! @fiber done files)
                    (signal/stop! stop)
                    (println "norn dev: stopped")
                    0)

                (nil? files) 0

                :else
                (do (when (seq files)
                      (let [{:keys [reloaded failed]} (reload! files)]
                        (when (seq reloaded) (println (str "norn dev: reloaded " (str/join ", " reloaded))))
                        (doseq [{:keys [module error]} failed]
                          (println (str "norn dev: " module " wasn't reloaded: " error)))
                        (when (and (seq reloaded) @done)
                          (println (str "norn dev: running " entry " again"))
                          (reset! fiber (start-main entry args done)))))
                    (recur)))))))
      (do (println (str "norn dev: " dir "/norn.edn has no :main (the entry function, as my.app/main)")) 2))
    (do (println "norn dev: no norn.edn here or in a folder above") 2)))
