;;;; Immutable packed numeric buffers backed by Norn Bytes.

(ns norn.buffer
  (:refer-core :exclude [count nth])
  (:require [norn.bytes :as b]))

(defclass Buffer () ((element-type :required true) (order :required true) (data :required true)))

(def ^:private widths {:u8 1 :i8 1 :u16 2 :i16 2 :u32 4 :i32 4 :u64 8 :i64 8 :f32 4 :f64 8})
(def ^:private signed-types #{:i8 :i16 :i32 :i64})
(def ^:private float-types #{:f32 :f64})

(defn- width-of [type] (or (get widths type) (error "Unknown buffer element type" type)))

(defmethod initialize-instance :after ((buf Buffer) _)
  (let [data (:data buf) width (width-of (:element-type buf))]
    (when-not (and (bytes? data) (zero? (mod (norn.core/count data) width))
                   (contains? #{:be :le} (:order buf)))
      (error "Buffer data must be Bytes of a whole number of elements, with byte order :be or :le"))))

(defn from-bytes
  "View a Bytes value as typed elements without copying. :order defaults to :le."
  [type data & {:keys [order] :or {order :le}}]
  (Buffer :element-type type :order order :data data))

(defn- encode-element [value type width order]
  (if (contains? float-types type)
    (b/float-bytes value width order)
    (let [limit (bit-shift-left 1 (* 8 width))
          signed? (contains? signed-types type)
          end (if signed? (quot limit 2) limit)
          start (if signed? (- end) 0)]
      (when-not (and (integer? value) (<= start value) (< value end))
        (error "Value outside buffer element range" type value))
      (b/uint-bytes (mod value limit) width order))))

(defn pack
  "Pack values as :u8, :i8, :u16, :i16, :u32, :i32, :u64, :i64, :f32 or :f64.
  :order defaults to :le. Integer values must fit the selected type."
  [type values & {:keys [order] :or {order :le}}]
  (let [width (width-of type)]
    (from-bytes type (apply b/concat-bytes (map #(encode-element % type width order) values)) :order order)))

(defn to-bytes "The underlying packed Bytes." [buf] (:data buf))

(defn count "Number of elements in buf." [buf]
  (quot (norn.core/count (:data buf)) (width-of (:element-type buf))))

(defn nth "Read the element at a zero-based index." [buf i]
  (when-not (and (integer? i) (<= 0 i) (< i (count buf)))
    (error IndexError :message "Buffer index out of bounds" :index i))
  (let [{:keys [element-type order data]} (instance->map buf) width (width-of element-type)
        offset (* i width)]
    (if (contains? float-types element-type)
      (b/read-float data offset width order)
      (let [n (b/read-uint data offset width order) sign (bit-shift-left 1 (dec (* 8 width)))]
        (if (and (contains? signed-types element-type) (>= n sign)) (- n (* 2 sign)) n)))))

(defn values "Read all buffer elements as a vector." [buf]
  (mapv #(nth buf %) (range (count buf))))
