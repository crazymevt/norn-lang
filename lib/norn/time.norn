;;;; norn.time — instants, durations and calendar dates.
;;;;
;;;; An Instant is a point on the UTC time line (nanoseconds since
;;;; 1970-01-01T00:00:00Z). A Duration is an amount of time in nanoseconds.
;;;; Calendar fields and text use RFC 3339; zones are UTC, this machine's
;;;; local time, or a fixed offset in seconds.

(ns norn.time
  (:refer-core :exclude [format])
  (:require [norn.string :as str]))

(defclass Instant () ((nanos :initform 0)))
(defclass Duration () ((nanos :initform 0)))
(defclass LocalDate () ((year :required true) (month :required true) (day :required true)))
(defclass LocalTime () ((hour :required true) (minute :required true) (second :required true) (nanos :required true)))
(defclass LocalDateTime () ((date :required true) (time :required true)))

(defn instant? [x] (instance? Instant x))
(defn duration? [x] (instance? Duration x))
(defn local-date? [x] (instance? LocalDate x))
(defn local-time? [x] (instance? LocalTime x))
(defn local-date-time? [x] (instance? LocalDateTime x))

(defn- leap-year? [year]
  (and (zero? (mod year 4)) (or (not (zero? (mod year 100))) (zero? (mod year 400)))))

(defmethod initialize-instance :after ((date LocalDate) _)
  (let [{:keys [year month day]} (instance->map date)
        days (when (and (integer? month) (<= 1 month 12))
               (if (and (= month 2) (integer? year) (leap-year? year))
                 29 (nth [31 28 31 30 31 30 31 31 30 31 30 31] (dec month))))]
    (when-not (and (integer? year) (<= 0 year 9999) days (integer? day) (<= 1 day days))
      (error "Invalid local date" year month day))))

(defmethod initialize-instance :after ((clock LocalTime) _)
  (let [{:keys [hour minute second nanos]} (instance->map clock)]
    (when-not (and (every? integer? [hour minute second nanos])
                   (<= 0 hour 23) (<= 0 minute 59) (<= 0 second 59) (<= 0 nanos 999999999))
      (error "Invalid local time" hour minute second nanos))))

(defmethod initialize-instance :after ((dt LocalDateTime) _)
  (when-not (and (local-date? (:date dt)) (local-time? (:time dt)))
    (error "LocalDateTime expects a local date and local time")))

(defn local-date "A Gregorian date without a time zone, in years 0000–9999." [year month day]
  (LocalDate :year year :month month :day day))

(defn local-time "A time of day without a time zone, with seconds and nanoseconds defaulting to zero."
  ([hour minute] (local-time hour minute 0 0))
  ([hour minute second] (local-time hour minute second 0))
  ([hour minute second nanos] (LocalTime :hour hour :minute minute :second second :nanos nanos)))

(defn local-date-time "Combine a LocalDate and LocalTime without attaching a zone." [date clock]
  (LocalDateTime :date date :time clock))

(defn parse-local-date "Parse YYYY-MM-DD as a local date." [s]
  (if-let [[_ year month day] (re-matches #"([0-9]{4})-([0-9]{2})-([0-9]{2})" s)]
    (apply local-date (map parse-long [year month day]))
    (error "Invalid local date" s)))

(defn parse-local-time
  "Parse HH:MM:SS with optional fractional seconds. Truncates precision beyond nanoseconds."
  [s]
  (if-let [[_ hour minute second fraction] (re-matches #"([0-9]{2}):([0-9]{2}):([0-9]{2})(?:\.([0-9]+))?" s)]
    (let [digits (or fraction "") nanos (parse-long (subs (str digits "000000000") 0 9))]
      (local-time (parse-long hour) (parse-long minute) (parse-long second) nanos))
    (error "Invalid local time" s)))

(defn parse-local-date-time "Parse a local date and time separated by T or a space." [s]
  (if-let [[_ date clock] (re-matches #"([0-9]{4}-[0-9]{2}-[0-9]{2})[Tt ](.+)" s)]
    (local-date-time (parse-local-date date) (parse-local-time clock))
    (error "Invalid local date-time" s)))

(defn format-local "Write a local date, local time or local date-time as ISO calendar text." [x]
  (cond (local-date? x) (norn.core/format "%04d-%02d-%02d" (:year x) (:month x) (:day x))
        (local-time? x) (str (norn.core/format "%02d:%02d:%02d" (:hour x) (:minute x) (:second x))
                             (when (pos? (:nanos x))
                               (str "." (str/replace (norn.core/format "%09d" (:nanos x)) #"0+$" ""))))
        (local-date-time? x) (str (format-local (:date x)) "T" (format-local (:time x)))
        :else (error "Expected a local date or time" x)))

(defn now "The current instant (wall clock)." [] (Instant :nanos (%now-nanos)))
(defn instant "The instant n nanoseconds after the epoch." [n] (Instant :nanos n))
(defn of-epoch-ms "The instant ms milliseconds after the epoch." [ms] (Instant :nanos (* ms 1000000)))
(defn epoch-ms [i] (quot (:nanos i) 1000000))
(defn epoch-nanos [i] (:nanos i))

(defn duration
  "(duration :hours 1 :minutes 30) — any of :days :hours :minutes :seconds :millis :nanos."
  [& {:keys [days hours minutes seconds millis nanos]}]
  (Duration :nanos (+ (* (or days 0) 86400000000000) (* (or hours 0) 3600000000000)
                      (* (or minutes 0) 60000000000) (* (or seconds 0) 1000000000)
                      (* (or millis 0) 1000000) (or nanos 0))))
(defn nanos [d] (:nanos d))
(defn millis [d] (quot (:nanos d) 1000000))
(defn seconds [d] (quot (:nanos d) 1000000000))

(defn plus
  "An instant moved forward by a duration, or two durations added."
  [x d]
  (if (instant? x) (Instant :nanos (+ (:nanos x) (:nanos d))) (Duration :nanos (+ (:nanos x) (:nanos d)))))
(defn minus
  "An instant moved back by a duration, or one duration less another."
  [x d]
  (if (instant? x) (Instant :nanos (- (:nanos x) (:nanos d))) (Duration :nanos (- (:nanos x) (:nanos d)))))
(defn between "The duration from instant a to instant b." [a b] (Duration :nanos (- (:nanos b) (:nanos a))))
(defn before? [a b] (< (:nanos a) (:nanos b)))
(defn after? [a b] (> (:nanos a) (:nanos b)))
(defn compare-time "Like compare, for two instants or two durations." [a b] (compare (:nanos a) (:nanos b)))

(defn- offset-at [i zone]
  (cond (or (nil? zone) (= zone :utc)) 0
        (= zone :local) (%local-offset (quot (:nanos i) 1000000000))
        (integer? zone) zone
        :else (error "Unknown zone (use :utc, :local or an offset in seconds):" (pr-str zone))))

(defn local-offset
  "This machine's UTC offset in seconds, now or at instant i."
  ([] (local-offset (now)))
  ([i] (offset-at i :local)))

(defn fields
  "Calendar fields of instant i: {:year :month :day :hour :minute :second
  :nanos :weekday (1 = Monday) :yearday :offset}. zone: :utc (default),
  :local or an offset in seconds."
  ([i] (fields i :utc))
  ([i zone]
   (let [o (offset-at i zone)
         [y mo d h mi s ns wd yd] (%civil (:nanos i) o)]
     {:year y :month mo :day d :hour h :minute mi :second s :nanos ns :weekday wd :yearday yd :offset o})))

(defn from-fields
  "The instant of {:year :month :day :hour :minute :second :nanos :offset}
  (missing time fields are 0; :offset in seconds, default 0 = UTC)."
  [m]
  (Instant :nanos (%from-civil [(:year m) (:month m) (:day m) (or (:hour m) 0) (or (:minute m) 0)
                                (or (:second m) 0) (or (:nanos m) 0)]
                               (or (:offset m) 0))))

(defn format
  "RFC 3339 text of instant i, e.g. 2026-11-13T07:05:00Z. zone as for fields."
  ([i] (format i :utc))
  ([i zone] (%format-iso (:nanos i) (offset-at i zone))))

(defn parse
  "The instant written as RFC 3339 text (2026-11-13T07:05:00Z,
  2026-11-13T08:05:00.5+01:00, or a date alone for midnight UTC)."
  [s]
  (Instant :nanos (first (%parse-iso s))))

(defn monotonic-nanos
  "A clock for measuring elapsed time: it never jumps, but has no epoch."
  []
  (nano-time))

(defn sleep-for "Sleep for a duration." [d] (sleep (millis d)))
