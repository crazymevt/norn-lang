;;;; norn.set — set algebra and relations (sets of maps).
;;;;
;;;; The operations keep the kind of their first argument: a sorted set
;;;; stays sorted.

(ns norn.set)

(defn union "Everything in any of the sets." ([] #{}) ([s] s)
  ([s1 s2] (if (< (count s1) (count s2)) (into s2 s1) (into s1 s2)))
  ([s1 s2 & more] (reduce union (union s1 s2) more)))

(defn intersection "What every set has." ([s] s)
  ([s1 s2] (reduce (fn [acc x] (if (contains? s2 x) acc (disj acc x))) s1 s1))
  ([s1 s2 & more] (reduce intersection (intersection s1 s2) more)))

(defn difference "What s1 has and the others don't." ([s] s)
  ([s1 s2] (reduce disj s1 s2))
  ([s1 s2 & more] (reduce difference (difference s1 s2) more)))

(defn subset? "Is every member of a in b?" [a b] (and (<= (count a) (count b)) (every? (fn [x] (contains? b x)) a)))
(defn superset? "Is every member of b in a?" [a b] (subset? b a))
(defn disjoint? "Do a and b have no members in common?" [a b] (not-any? (fn [x] (contains? b x)) a))

(defn select "The members of s for which pred is true." [pred s] (reduce (fn [acc x] (if (pred x) acc (disj acc x))) s s))

(defn map-invert "m with keys and values swapped." [m] (reduce-kv (fn [acc k v] (assoc acc v k)) {} m))

(defn rename-keys "m with the keys in kmap renamed to kmap's values." [m kmap]
  (reduce-kv (fn [acc old new] (if (contains? m old) (assoc acc new (get m old)) acc))
             (apply dissoc m (keys kmap)) kmap))

(defn project "The relation xrel (a set of maps) keeping only keys ks." [xrel ks] (set (map (fn [r] (select-keys r ks)) xrel)))

(defn rename "The relation xrel with keys renamed by kmap." [xrel kmap] (set (map (fn [r] (rename-keys r kmap)) xrel)))

(defn index "The maps of xrel grouped by their values for ks: {(select-keys r ks) #{r …}}." [xrel ks]
  (reduce (fn [m r] (update m (select-keys r ks) (fn [rs] (conj (or rs #{}) r)))) {} xrel))

(defn join
  "The natural join of two relations (on their shared keys, or on km: a map
  of xrel's keys to yrel's)."
  ([xrel yrel]
   (if (and (seq xrel) (seq yrel))
     (let [ks (filter (set (keys (first xrel))) (keys (first yrel)))]
       (join xrel yrel (zipmap ks ks)))
     #{}))
  ([xrel yrel km]
   (let [idx (index xrel (keys km))]
     (set (mapcat (fn [y]
                    (let [found (get idx (rename-keys (select-keys y (vals km)) (map-invert km)))]
                      (map (fn [x] (merge x y)) found)))
                  yrel)))))
