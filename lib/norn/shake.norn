;;;; norn.shake — what shaking an image leaves out (save-image :shake,
;;;; norn build --shake): the names a release image's entry doesn't reach,
;;;; and what only they kept. It loads nothing but norn.xref, so as not to
;;;; add to the image it shakes (a module's methods on core's generic
;;;; functions would stay).
;;;;
;;;;   (save-image "app.nimg" :entry #'app/main :shake true)
;;;;   norn build app.nimg --shake --keep app.plugins

(ns norn.shake
  (:require [norn.xref :as xref]))

(def ^:private runtime-names
  "norn.core's vars the runtime finds by name (the Rust side's core_fn
  lookups, its root tasks, and what an image's start calls): kept in every
  shaken image. crates/norn-vm/tests/shake.rs checks the Rust side names
  no others."
  '[print-object *print-readably* %collection-op collection-seq deref-object make
    slot-value-using-class %gf-dispatch-custom %gf-miss %force-stream %read-tagged
    %set-slot-typed %with-typed *out* *inspecting* %image-entry %image-restored %run-entry
    %run-entry-with-args %has-entry? %image-summary %abort error throw signal invoke-debugger
    StandardObject])

(def ^:private evaluator-names
  "The runtime's ways in to evaluating code (its root tasks, the REPL's
  and the editor's): kept with the language."
  '[%eval-all %eval-root %repl-eval %serve-request load-file])

(def ^:private language
  "The language itself: what evaluating code at run time needs, kept whole
  when reachable code evaluates."
  '#{norn.core norn.compiler norn.expander norn.syntax norn.validate})

(def ^:private evaluating
  "Calls that evaluate code: with one reachable, the language is kept."
  '#{norn.core/eval norn.core/load-string norn.core/load-file norn.core/%eval-reader norn.core/%eval-root})

(def ^:private by-name
  "Calls that find definitions by a name computed at run time: shaking
  can't see what they'll want, so it says where they are."
  '#{norn.core/eval norn.core/load-string norn.core/load-file norn.core/resolve norn.core/ns-resolve
     norn.core/require norn.core/find-var norn.core/ns-publics
     norn.core/ns-interns norn.core/%tool-call})

(defn- var-ns
  "The namespace (a symbol) var v is interned in."
  [v]
  (symbol (namespace (symbol (subs (str v) 2)))))

(defn- own-vars
  "Namespace ns's own vars (not those it refers to)."
  [ns]
  (vec (keep (fn [[_ v]] (when (= ns (var-ns v)) v)) (ns-interns ns))))

(defn- sealed-module?
  "Can shaking drop from namespace ns? Only a sealed module's (a phase
  instance's, name$1, by its module's seal)."
  [ns]
  (sealed? (%base-ns ns)))

(defn- tag-reader-targets
  "The functions *tag-readers*' library readers call (#inst's
  norn.time/parse, and the rest), found by name when a literal is read:
  kept when their module is."
  [nss]
  (vec (for [f (vals *tag-readers*)
             :when (fn? f)
             target (%fn-captured f)
             :when (and (symbol? target) (namespace target) (contains? nss (symbol (namespace target))))
             :let [v (resolve target)]
             :when v]
         v)))

(defn- tag-reader-libraries
  "The libraries *tag-readers*' readers load."
  []
  (vec (distinct (for [f (vals *tag-readers*) :when (fn? f) target (%fn-captured f)
                       :when (and (symbol? target) (namespace target))]
                   (symbol (namespace target))))))

(declare keep-roots)

(defn- reads?
  "Does what entry and keeps reach read text (and so tagged literals)?"
  [entry keeps]
  (let [refs (xref/references)
        reach (xref/reachable (concat (if (var? entry) [entry] (xref/refers-to entry)) (keep-roots keeps)) refs)]
    (boolean (some (fn [v] (contains? reach v)) [#'read-string #'%reader #'%read #'*tag-readers*]))))

(defn- keep-roots
  "The vars :keep names: vars, qualified symbols, and namespace symbols
  (every var in it)."
  [keeps]
  (mapcat (fn [k] (cond (var? k) [k]
                        (and (symbol? k) (namespace k)) (if-let [v (resolve k)] [v] (error "save-image :keep: no var" (str k)))
                        (symbol? k) (own-vars k)
                        :else (error "save-image :keep takes vars and symbols, not" (pr-str k))))
          keeps))

(defn- value-of [v] (when (bound? v) (var-get v)))

(defn- live-classes
  "The classes vars vs make (a class var's class) and those they inherit
  from: instances of them can exist."
  [vs]
  (set (mapcat (fn [v] (let [c (value-of v)] (when (class? c) (cons c (%class-get c :cpl))))) vs)))

(defn- walk
  "Every var reachable from roots, a generic function counting only the
  methods (live? m) says are kept: a set."
  [roots refs live?]
  (let [method-refs (memoize (fn [m] (xref/refers-to (:fn m))))
        next-of (fn [v] (let [x (value-of v)]
                          (if (generic? x)
                            (set (mapcat method-refs (filter live? (generic-methods x))))
                            (get refs v))))]
    (loop [seen (set roots) todo (vec roots)]
      (if (empty? todo)
        seen
        (let [new (remove seen (next-of (peek todo)))]
          (recur (into seen new) (into (pop todo) new)))))))

(defn- plan
  "shake-plan's plan, with the libraries loaded now, and :evaluates (does
  what's kept evaluate code?)."
  [entry keeps]
  (let [nss (vec (all-ns))
        sealed (set (filter sealed-module? nss))
        droppable (fn [ns] (contains? sealed ns))
        refs (xref/references)
        core (fn [names] (keep (fn [n] (resolve (symbol "norn.core" (str n)))) names))
        whole (fn [ns-set] (concat (mapcat own-vars (filter ns-set nss)) (core evaluator-names)))
        ;; (a class of a module that can be dropped, the language's aside,
        ;; is live only if something kept makes it)
        dead-class? (fn [live c] (and (class? c) (not (contains? live c))
                                      (when-let [n (class-name c)]
                                        (let [m (when (namespace n) (symbol (namespace n)))]
                                          (and m (droppable m) (not (contains? language (%base-ns m))))))))
        method-live? (fn [live m] (not-any? (fn [s] (dead-class? live s)) (:specs m)))
        ;; (methods for classes nothing reached makes don't count, and what
        ;; reaches more classes may make more methods count: until it settles)
        settle (fn [roots]
                 (loop [live #{}]
                   (let [reach (walk roots refs (fn [m] (method-live? live m)))
                         live2 (live-classes reach)]
                     (if (= live2 live) [reach live] (recur live2)))))
        roots (concat (cond (var? entry) [entry]
                            (some? entry) (vec (xref/refers-to entry))
                            :else (whole language))
                      (keep-roots keeps)
                      (core runtime-names)
                      (mapcat own-vars (remove sealed nss)))
        [reach live] (settle roots)
        evaluates? (some (fn [v] (contains? evaluating (symbol (subs (str v) 2)))) reach)
        [reach live] (if (and entry evaluates?) (settle (concat roots (whole language))) [reach live])
        ;; (code that reads text reads tagged literals: their readers'
        ;; functions in the libraries loaded are kept, found by name)
        [reach live] (let [extra (when (and entry (reads? entry keeps)) (tag-reader-targets (set nss)))]
                       (if (seq extra) (settle (concat reach extra)) [reach live]))
        warnings (vec (sort (for [w reach
                                  :when (not (contains? language (var-ns w)))
                                  c (get refs w)
                                  :let [n (symbol (subs (str c) 2))]
                                  :when (contains? by-name n)]
                              (str (subs (str w) 2) " calls " n
                                   (if (contains? evaluating n)
                                     ": the language is kept whole, but what the code it evaluates refers to by name may be gone"
                                     ": what it looks up may be gone; name it in :keep")))))
        by-var? (and entry (not evaluates?))
        ;; (by var only when nothing kept can load code: an image that can
        ;; might load a module that refers to any name of one it has)
        gone-nss (if by-var?
                   (let [r (set (map var-ns reach))]
                     (vec (filter (fn [ns] (and (droppable ns) (not (contains? r ns))
                                                (not-any? reach (own-vars ns))))
                                  nss)))
                   (let [used (set (map var-ns reach))]
                     (vec (filter (fn [ns] (and (droppable ns) (not (contains? used ns)))) nss))))
        kept-vars (if by-var?
                    reach
                    (set (mapcat own-vars (remove (set gone-nss) nss))))
        live (if by-var? live (live-classes kept-vars))
        generics (vec (for [v kept-vars
                            :let [g (value-of v)]
                            :when (generic? g)
                            :let [ms (generic-methods g)
                                  kept (vec (filter (fn [m] (method-live? live m)) ms))]
                            :when (< (count kept) (count ms))]
                        [g kept]))]
    {:lazy (vec (distinct (for [w reach
                                :when (contains? (get refs w) #'norn.core/%require-lazily)
                                s (let [f (value-of w)] (when (fn? f) (%fn-symbols f)))
                                :when (and (nil? (namespace s)) (%find-lib (str s)))]
                            s)))
     :drop-vars (if by-var?
                  (vec (for [ns nss :when (droppable ns) v (own-vars ns) :when (not (contains? reach v))] v))
                  [])
     :drop-namespaces gone-nss
     :drop-methods generics
     :kept (count kept-vars)
     :warnings warnings
     :evaluates (not by-var?)}))

(defn shake-plan
  "What (save-image f :shake true) leaves out: {:drop-vars [var…]
  :drop-namespaces [symbol…] :drop-methods [[generic kept-methods]…] :kept n
  :warnings [text…]}. It keeps what
  entry (a var or function; nil for an image that starts a REPL) reaches,
  as norn.xref sees references, from it, the vars in keeps (vars, qualified
  symbols, or namespace symbols for all of one), the names the runtime
  calls, and every var of a module that isn't sealed; it drops the rest of
  the sealed modules' names, and with them what only they reached.
  Reachable code that evaluates keeps the language whole (norn.core, the
  compiler and the expander). Then, when nothing kept can load code, it
  drops by var; when something can (a REPL's image, with no entry, or code
  that evaluates), whole modules, as one loaded later may refer to any of
  a module's names: those nothing reaches go, and requiring one loads it
  again. A generic function keeps only the methods for classes something
  kept can make (with those of the language's own, and Object's). Calls
  that find definitions by a computed name are warned about, as :keep
  should name what they want."
  ^Map [entry keeps]
  ;; (libraries kept code loads lazily, %require-lazily with their names
  ;; quoted, are loaded now and kept whole: until no more turn up)
  (let [[p keeps] (loop [keeps (vec keeps) tries 0]
                    (let [p (plan entry keeps)
                          more (remove (set keeps) (:lazy p))]
                      (if (and (seq more) (< tries 8))
                        (do (doseq [lib more] (%require-lazily lib))
                            (recur (into keeps more) (inc tries)))
                        [p keeps])))
        p (dissoc p :lazy)
        missing (remove (set (all-ns)) (tag-reader-libraries))]
    ;; Reading text (read-string, the reader, norn.edn) reads tagged
    ;; literals, whose readers load their libraries (norn.time for #inst)
    ;; the first time: an image without the compiler can't, so they're
    ;; loaded now, and the plan made again.
    (if (and entry (not (:evaluates p)) (seq missing) (reads? entry keeps))
      (do (doseq [lib missing] (%require-lazily lib))
          (dissoc (plan entry keeps) :evaluates :lazy))
      (dissoc p :evaluates))))

(defn- size-text
  "n bytes for people: 566.2 KB, 1.7 MB."
  [n]
  (cond (< n 1024) (str n " bytes")
        (< n (* 1024 1024)) (format "%.1f KB" (/ n 1024.0))
        :else (format "%.1f MB" (/ n (* 1024.0 1024)))))

(defn shake-report
  "Save a shaken image of this process at path (entry and keeps as
  shake-plan takes them, fibers left out, as norn build saves), and say
  what it left out and what that saved against whole, the size in bytes of
  the same image unshaken (saved before this module was loaded): the line
  norn build --shake prints, then each warning on a line of its own."
  ^String [path entry keeps whole]
  (let [r (save-image path :entry entry :fibers :none :shake true :keep keeps)
        {:keys [dropped-vars dropped-namespaces dropped-methods warnings]} (:shaken r)
        plural (fn [n one many] (str n " " (if (= 1 n) one many)))]
    (str (:objects r) " objects, " (size-text (:bytes r))
         ", shaken from " (size-text whole) " (" (format "%.0f%%" (* 100 (- 1 (/ (:bytes r) (double whole)))))
         " smaller): " (plural dropped-vars "definition" "definitions") " left out, "
         (plural (count dropped-namespaces) "module" "modules") " whole, and "
         (plural dropped-methods "method" "methods")
         (apply str (map (fn [w] (str "\nwarning: " w)) warnings)))))
