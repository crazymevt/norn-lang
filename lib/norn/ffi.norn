;;;; norn.ffi — calling C (runtime.md §5.6; the full FFI, M9 part 9.8).
;;;;
;;;;   (ns my.module (:require [norn.ffi :as ffi]) (:unsafe))
;;;;   (def libc (ffi/library :c))
;;;;   (ffi/defcfun strlen libc "strlen" [s :string] :usize)
;;;;   (strlen "hello")  ; => 5
;;;;
;;;; A module using the FFI says (:unsafe) in its ns: a wrong signature or
;;;; address can crash the process, and the expander refuses this library's
;;;; unsafe functions anywhere else (the REPL's user namespace may).
;;;;
;;;; Types: :void :i8 :u8 :i16 :u16 :i32/:int :u32/:uint :i64 :u64/:usize
;;;; :long :ulong (C's long: 64 bits, but 32 on Windows) :f32/:float
;;;; :f64/:double :pointer (an address, as an integer; nil is NULL). Parameters also take
;;;; - :bytes (a pointer to a Bytes value's data), :string (a NUL-terminated
;;;;   copy), :out (pass a size: C fills a fresh buffer, returned as Bytes
;;;;   after the result);
;;;; - [:* layout]: a pointer to a struct, passed a map (copied to memory
;;;;   for the call) or an address;
;;;; - [:out layout]: a struct C fills, returned as a map after the result;
;;;; - [:callback [param-types] ret]: a C function pointer, passed a
;;;;   callback, or a Norn function (made a callback once, and kept);
;;;; - a layout: the struct by value, passed a map (or an address, copied);
;;;; - :... last: a variadic function, the rest of the arguments numbers
;;;;   (as 64-bit integers or doubles, C's promotions), strings, Bytes and
;;;;   nil. Pass 1.0, not 1, where C reads a double.
;;;; A :string return copies the C string (nil for NULL); a layout returns
;;;; the struct by value, as a map.
;;;;
;;;; A function marked :blocking true runs on the blocking pool; others run
;;;; on the carrier (keep them quick: one that takes long makes the runtime
;;;; start a spare carrier). One marked :main-thread true runs on the
;;;; process's first thread, which the norn command keeps for such calls:
;;;; window, event and graphics APIs that need that thread or one fixed
;;;; thread. Its calls run one at a time, and a :string result is copied
;;;; there, before the next call can reuse a static buffer. A callback C
;;;; makes during one can make main-thread calls of its own. After an image restore, libraries reload and
;;;; functions re-resolve by themselves: a library holds no session state.
;;;;
;;;; Structs: (defcstruct point [x :i32 y :i32]) lays out fields as C does
;;;; (each at its alignment, the size rounded up to the largest), with
;;;; nested structs, [:array type n] and bit fields [:bits type width];
;;;; defcunion lays out a union. Memory: alloc and free!, mem-get and
;;;; mem-set!, struct-get and struct-set! (as maps), field and set-field!,
;;;; string-at and bytes-at. A :string in memory (a struct's field) is a
;;;; char *: it reads and writes as its address (nil for NULL), so a
;;;; struct round-trips; string-at reads the string, and alloc-string
;;;; makes one (free! it when C is done with it).
;;;;
;;;; Callbacks: (callback [:pointer :pointer] :int f) is a C function
;;;; pointer that calls f. Called during a (fast) call from Norn, on its
;;;; thread, f runs there and then. Called from another thread (the blocking
;;;; pool, or one of C's own), the call goes to a fiber serving the
;;;; callback, while that thread waits. An error in f can't unwind through
;;;; C: C gets 0, and the error is signalled when the call from Norn
;;;; returns (from another thread, it's reported). Callbacks take and
;;;; return structs by value too. A freed callback's code is reused by the
;;;; next of its signature.
;;;;
;;;; Structs by value and variadic functions are for arm64 (macOS and
;;;; Linux) so far; elsewhere they're an error.

(ns norn.ffi
  (:unsafe))

(defclass Library () ((path) (cell))
  (:doc "A loaded shared library, to look functions up in (from library)."))
;; mode: false (on the carrier), true (the blocking pool) or :main (the
;; main-thread lane), as %ffi-fn takes it.
(defclass ForeignFunction () ((name) (lib) (params) (ret) (mode) (cell) (prep))
  (:doc "A C function with its parameter and return types, to call (from function
  or function-at)."))
(defclass Callback () ((id) (address) (params) (ret) (fn) (chan))
  (:doc "A Norn function that C can call, at an address (from callback; freed by
  free-callback!)."))

(defmethod print-object ((f ForeignFunction)) (str "#<foreign " (:name f) ">"))
(defmethod print-object ((c Callback)) (str "#<callback " (:params c) " " (:ret c) ">"))

;; ---- types and struct layouts ----

(def ^:private c-long-size "C's long: 8 bytes, but 4 on Windows." (if (= :windows (:family (%sys-info))) 4 8))

(def ^:private prim-sizes
  {:i8 1 :char 1 :u8 1 :uchar 1 :bool 1 :i16 2 :short 2 :u16 2 :ushort 2
   :i32 4 :int 4 :u32 4 :uint 4 :f32 4 :float 4
   :i64 8 :isize 8 :ssize 8 :u64 8 :usize 8 :size 8 :f64 8 :double 8 :pointer 8
   :long c-long-size :ulong c-long-size
   :string 8})

(defn layout? "Is x a struct layout (from defcstruct)?" ^Boolean [x] (and (map? x) (contains? x ::fields)))

;; ([:bits type width]: a bit field, width bits of an integer type's unit)
(defn- array-type? [t] (and (vector? t) (= :array (first t))))
(defn- bits-type? [t] (and (vector? t) (= :bits (first t))))

(def ^:private unsigned-of
  {:i8 :u8 :char :u8 :i16 :u16 :short :u16 :i32 :u32 :int :u32 :i64 :u64 :long :ulong :isize :u64 :ssize :u64})

(defn- signed? [t] (contains? unsigned-of t))

(defn sizeof "The size of C type t (a keyword, a struct or union layout, [:array t n]) in bytes." ^Integer [^(U Keyword Map Vector) t]
  (cond (layout? t) (:size t)
        (array-type? t) (* (sizeof (second t)) (nth t 2))
        (bits-type? t) (error "A bit field has no size of its own")
        :else (or (get prim-sizes t) (error (str "Not a C type: " (pr-str t))))))

(defn alignof "The alignment of C type t." ^Integer [^(U Keyword Map Vector) t]
  (cond (layout? t) (:align t)
        (array-type? t) (alignof (second t))
        (bits-type? t) (sizeof (second t))
        :else (sizeof t)))

(defn- round-up [n a] (* a (quot (+ n (dec a)) a)))

(defn- field-pairs [what lname fields]
  (when (odd? (count fields)) (error (str what " " lname ": fields come as name type pairs")))
  (map (fn [[n t]] [(keyword (name n)) t]) (partition 2 fields)))

(defn- finish-layout [lname out size align union?]
  {::fields out :name lname :size (round-up size align) :align align :union union?
   :index (into {} (map (fn [f] [(:name f) f]) (remove (fn [f] (nil? (:name f))) out)))})

(defn struct-layout
  "A struct's layout from its fields, [name type …] (names as keywords or
  symbols): each at the next offset its alignment allows, the size rounded
  up to the struct's alignment (its largest field's), as C lays them out.
  A bit field, [:bits type width], goes in the unit of its type it starts
  in, if it fits there, else the next one (width 0: on to the next unit);
  bits go from the lowest up."
  ^Map [sname ^Sequential fields]
  (loop [fs (field-pairs "defcstruct" sname fields) bit 0 align 1 out []]
    (if (empty? fs)
      (finish-layout sname out (quot (+ bit 7) 8) align false)
      (let [[n t] (first fs)]
        (if (bits-type? t)
          (let [[_ ut w] t
                unit (* 8 (sizeof ut))
                _ (when-not (and (integer? w) (<= 0 w unit)) (error (str "A bit field of " ut " has 0 to " unit " bits, not " w)))
                bit (if (or (zero? w) (not= (quot bit unit) (quot (+ bit w -1) unit))) (round-up bit unit) bit)]
            (recur (rest fs) (+ bit w) (max align (sizeof ut))
                   (if (zero? w)
                     out
                     (conj out {:name n :type t :offset (* (quot bit unit) (sizeof ut)) :shift (mod bit unit) :width w}))))
          (let [a (alignof t)
                at (round-up (quot (+ bit 7) 8) a)]
            (recur (rest fs) (* 8 (+ at (sizeof t))) (max align a)
                   (conj out {:name n :type t :offset at}))))))))

(defn union-layout
  "A union's layout: every field at offset 0, the size the largest
  field's, rounded up to the largest alignment."
  ^Map [uname ^Sequential fields]
  (let [fs (field-pairs "defcunion" uname fields)]
    (when (some (fn [[_ t]] (bits-type? t)) fs) (error (str "defcunion " uname ": no bit fields in a union")))
    (finish-layout uname (mapv (fn [[n t]] {:name n :type t :offset 0}) fs)
                   (reduce max 0 (map (fn [[_ t]] (sizeof t)) fs))
                   (reduce max 1 (map (fn [[_ t]] (alignof t)) fs))
                   true)))

(defmacro defcstruct
  "(defcstruct name [field type …]): name is the struct's layout. A type is
  a C type keyword, another layout, [:array type n], or a bit field
  [:bits integer-type width]."
  [sname fields]
  `(def ~sname (struct-layout '~sname [~@(mapcat (fn [[n t]] [(keyword (name n)) t]) (partition 2 fields))])))

(defmacro defcunion
  "(defcunion name [field type …]): name is the union's layout (its fields
  share the memory; struct-get reads each)."
  [uname fields]
  `(def ~uname (union-layout '~uname [~@(mapcat (fn [[n t]] [(keyword (name n)) t]) (partition 2 fields))])))

(defn- field-of [layout k]
  (or (get (:index layout) k) (error (str (:name layout) " has no field " k))))

(defn offset-of
  "The offset of a field in a struct layout: a key, or a path of them
  through nested structs ([:origin :x]). (A bit field's: its unit's.)"
  ^Integer [^Map layout ^(U Keyword Vector) k]
  (if (vector? k)
    (loop [l layout ks (seq k) off 0]
      (if ks
        (let [f (field-of l (first ks))] (recur (:type f) (next ks) (+ off (:offset f))))
        off))
    (:offset (field-of layout k))))

(defn %leaves
  "The scalar pieces of C type t, [[offset type]…] (for passing structs by
  value: the runtime classifies them)."
  (^Vector [^(U Keyword Map Vector) t] (%leaves t 0))
  (^Vector [^(U Keyword Map Vector) t ^Integer at]
   (cond (layout? t) (vec (distinct (mapcat (fn [f]
                                              (if (bits-type? (:type f))
                                                (let [ut (second (:type f))] [[(+ at (:offset f)) (get unsigned-of ut ut)]])
                                                (%leaves (:type f) (+ at (:offset f)))))
                                            (::fields t))))
         (array-type? t) (let [[_ et n] t s (sizeof et)] (vec (mapcat (fn [i] (%leaves et (+ at (* i s)))) (range n))))
         (= t :string) [[at :pointer]]
         :else [[at t]])))

;; ---- memory ----

(defn alloc
  "n zeroed bytes from C's allocator (or room for C type n: a layout, an
  array type, a keyword): their address. free! them."
  ^Integer [^(U Integer Keyword Map Vector) n]
  (%mem-alloc (if (integer? n) n (sizeof n))))

(defn free! "Give memory from alloc back." [^(? Integer) addr] (%mem-free addr))

(declare struct-get struct-set!)

(defn mem-get
  "The C value of type t at addr (+ offset): a number, an address for
  :pointer or :string (string-at reads the string), a map for a layout, a
  vector for [:array t n]."
  ([^Integer addr ^(U Keyword Map Vector) t] (mem-get addr t 0))
  ([^Integer addr ^(U Keyword Map Vector) t ^Integer offset]
   (cond (layout? t) (struct-get (+ addr offset) t)
         (array-type? t) (let [[_ et n] t s (sizeof et)]
                           (mapv (fn [i] (mem-get addr et (+ offset (* i s)))) (range n)))
         (= t :string) (%mem-get addr :pointer offset)
         :else (%mem-get addr t offset))))

(defn mem-set!
  "Write v at addr (+ offset) as C type t (a map for a layout, a
  sequence for an array; :string, like :pointer, takes an address or nil,
  as alloc-string gives one). v."
  ([^Integer addr ^(U Keyword Map Vector) t v] (mem-set! addr t 0 v))
  ([^Integer addr ^(U Keyword Map Vector) t ^Integer offset v]
   (cond (layout? t) (struct-set! (+ addr offset) t v)
         (array-type? t) (let [[_ et n] t s (sizeof et)]
                           (when (> (count v) n) (error (str "More than " n " items for " (pr-str t))))
                           (doseq [[i x] (map vector (range) v)] (mem-set! addr et (+ offset (* i s)) x)))
         (= t :string) (if (or (nil? v) (integer? v))
                         (%mem-set! addr :pointer offset v)
                         (error TypeError :message (str "A :string in memory takes an address (from alloc-string) or nil, got "
                                                        (pr-str v))
                                :expected "an address or nil" :value v))
         :else (%mem-set! addr t offset v))
   v))

(defn- read-field [addr base f]
  (if (bits-type? (:type f))
    (let [[_ ut w] (:type f)
          unit (%mem-get addr (get unsigned-of ut ut) (+ base (:offset f)))
          v (bit-and (bit-shift-right unit (:shift f)) (dec (bit-shift-left 1 w)))]
      (if (and (signed? ut) (pos? (bit-and v (bit-shift-left 1 (dec w))))) (- v (bit-shift-left 1 w)) v))
    (mem-get addr (:type f) (+ base (:offset f)))))

(defn- write-field! [addr base f v]
  (if (bits-type? (:type f))
    (let [[_ ut w] (:type f)
          uut (get unsigned-of ut ut)
          at (+ base (:offset f))
          [lo hi] (if (signed? ut) [(- (bit-shift-left 1 (dec w))) (dec (bit-shift-left 1 (dec w)))] [0 (dec (bit-shift-left 1 w))])
          _ (when-not (and (integer? v) (<= lo v hi)) (error (str (pr-str v) " doesn't fit the " w "-bit field " (:name f))))
          mask (bit-shift-left (dec (bit-shift-left 1 w)) (:shift f))
          unit (%mem-get addr uut at)
          ;; (the unit's bits, from 0, as its unsigned type holds them)
          all (dec (bit-shift-left 1 (* 8 (sizeof ut))))]
      (%mem-set! addr uut at (bit-or (bit-and unit (bit-and all (bit-not mask)))
                                     (bit-and mask (bit-shift-left (bit-and v (dec (bit-shift-left 1 w))) (:shift f)))))
      v)
    (mem-set! addr (:type f) (+ base (:offset f)) v)))

(defn struct-get
  "The struct (or union) at addr, as a map of its fields. A :string field
  is its address, as struct-set! takes it: string-at reads the string."
  ^Map [^Integer addr ^Map layout]
  (into {} (map (fn [f] [(:name f) (read-field addr 0 f)]) (::fields layout))))

(defn struct-set!
  "Write the fields of map m (those it has) into the struct at addr. addr."
  ^Integer [^Integer addr ^Map layout ^Map m]
  (doseq [[k v] m] (write-field! addr 0 (field-of layout k) v))
  addr)

(defn- field-at
  "Field k (or the last of path k) of layout, and its struct's offset."
  [layout k]
  (if (vector? k)
    (let [inner (reduce (fn [l k] (:type (field-of l k))) layout (pop k))]
      [(field-of inner (peek k)) (if (= 1 (count k)) 0 (offset-of layout (pop k)))])
    [(field-of layout k) 0]))

(defn field "The field k (or path) of the struct at addr." [^Integer addr ^Map layout ^(U Keyword Vector) k]
  (let [[f base] (field-at layout k)] (read-field addr base f)))

(defn set-field! "Set field k (or path) of the struct at addr to v. v." [^Integer addr ^Map layout ^(U Keyword Vector) k v]
  (let [[f base] (field-at layout k)] (write-field! addr base f v)))

(defn new-struct "Room for a struct, its fields from map m (the rest zero): its address. free! it." ^Integer [^Map layout ^Map m]
  (struct-set! (alloc layout) layout m))

(defmacro with-alloc
  "(with-alloc [name type-or-size init?] body…): name is new zeroed memory
  (a struct from init, a map, for a layout) while body runs, then freed."
  [[n t init] & body]
  `(let [~n (alloc ~t)]
     (try ~@(when init [`(mem-set! ~n ~t ~init)]) ~@body
          (finally (free! ~n)))))

(defn string-at "The NUL-terminated string at addr (nil for NULL)." ^(? String) [^(? Integer) addr] (%mem-string addr))
(defn bytes-at "A copy of n bytes at addr, as Bytes." ^Bytes [^Integer addr ^Integer n] (%mem-bytes addr n))
(defn write-bytes! "Copy bytes (or a string's UTF-8) to addr: the count." ^Integer [^Integer addr ^(U String Bytes) b] (%mem-write-bytes! addr b))

(defn alloc-string "A NUL-terminated copy of string s in new memory: its address. free! it." ^Integer [^String s]
  (let [b (bytes (str s)) p (alloc (inc (count b)))]
    (write-bytes! p b)
    p))

;; ---- callbacks ----

(defn- report [e]
  (%write-stderr (str "norn.ffi: a C callback failed: " (condition-message e) "\n")))

(declare by-value)

(defn- struct-converting
  "f, for a callback with structs by value: their addresses (and, first,
  the result's) become maps (and the map f returns is written there)."
  [params ret f]
  (if (not (or (layout? ret) (some layout? params)))
    f
    (fn [& raw]
      (let [[at raw] (if (layout? ret) [(first raw) (rest raw)] [nil raw])
            v (apply f (map (fn [t a] (if (layout? t) (struct-get a t) a)) params raw))]
        (if (layout? ret) (do (struct-set! at ret v) nil) v)))))

(defn callback
  "A C function pointer (callback-address) that calls Norn function f:
  (callback [:pointer :pointer] :int f). Parameters and the result are
  numbers and addresses, or structs by value (layouts), as maps.
  free-callback! it when C is done with it."
  ^Callback [^Sequential params ^(U Keyword Map) ret f]
  (let [ch (chan 1024)
        g (struct-converting (vec params) ret f)
        [id address] (%ffi-callback (mapv by-value params) (by-value ret) g ch)
        f g
        cb (Callback :id id :address address :params (vec params) :ret ret :fn f :chan ch)]
    ;; (serving calls from threads other than a call from Norn's)
    (spawn-detached
      (loop []
        (when-let [[args token] (<! ch)]
          (%ffi-callback-reply! id token (try (apply f args) (catch Error e (report e) nil)))
          (recur))))
    cb))

(defn callback? "Is x a callback?" ^Boolean [x] (instance? Callback x))
(defn callback-address "Callback cb's address, to pass to C as a function pointer." ^Integer [^Callback cb] (:address cb))
(defn free-callback! "C mustn't call callback cb after this." [^Callback cb] (%ffi-callback-free! (:id cb)) nil)

(def ^:private fn-callbacks "(the callbacks made for functions passed as [:callback …]: [f type] → callback)" (atom {}))

(defn- callback-for [t f]
  (cond (callback? f) (:address f)
        (fn? f) (:address (or (get @fn-callbacks [f t])
                              (let [cb (callback (second t) (nth t 2) f)]
                                (swap! fn-callbacks assoc [f t] cb)
                                cb)))
        :else f))

;; ---- functions ----

(defn library
  "Load a dynamic library: a path or name, or :c / :m for the C and math libraries."
  ^Library [^(U String Keyword) name]
  (let [path (cond (= name :c) (%ffi-libc-path)
                   (= name :m) (%ffi-libm-path)
                   :else (str name))]
    (Library :path path :cell (atom (%ffi-open path)))))

(defn- live-lib [lib]
  (let [h @(:cell lib)]
    (if (%handle-current? h) h (reset! (:cell lib) (%ffi-open (:path lib))))))

(defn- by-value
  "Type t as the runtime takes it, a struct by value as [:struct size
  leaves]."
  [t]
  (if (layout? t) [:struct (sizeof t) (%leaves t)] t))

(defn- low-type
  "Parameter type t as the runtime takes it."
  [t]
  (cond (layout? t) (by-value t)
        (vector? t) (case (first t)
                      (:* :out :callback) :pointer
                      (error (str "Not a parameter type: " (pr-str t))))
        :else t))

(defn- prep-for
  "For parameters ps and result ret: nil if every argument goes to the
  runtime as it is, else true (call-converting converts them)."
  [ps ret]
  (when (or (layout? ret) (some (fn [t] (or (vector? t) (layout? t))) ps)) true))

(defn main-thread-available?
  "Does a thread serve :main-thread calls? The norn command's first thread
  does; a program embedding Norn serves them only if it says so."
  ^Boolean []
  (%main-thread-served?))

(defn- call-mode [blocking main-thread]
  (when (and blocking main-thread) (error "A foreign function can't be both :blocking and :main-thread"))
  (cond main-thread :main blocking true :else false))

(defn- open-fn [lib name params ret mode]
  (if lib
    (%ffi-fn (live-lib lib) (str name) (mapv low-type params) (by-value ret) mode)
    (%ffi-fn nil name (mapv low-type params) (by-value ret) mode)))

(defn function
  "A C function of lib: (function libc \"strlen\" [:string] :usize). A
  struct layout as a parameter or result type passes it by value (as a
  map); :... last makes it variadic. Options: :blocking true runs calls on
  the blocking pool, :main-thread true on the process's first thread."
  ^ForeignFunction [^Library lib ^String name ^Sequential params ^(U Keyword Map) ret & {:keys [blocking main-thread]}]
  (let [mode (call-mode blocking main-thread)
        ps (vec params)]
    (ForeignFunction :name (str name) :lib lib :params ps :ret ret :mode mode
                     :cell (atom (open-fn lib (str name) ps ret mode)) :prep (prep-for ps ret))))

(defn function-at
  "A C function known by its address (a function pointer C gave), as
  function. (It doesn't survive an image restore.)"
  ^ForeignFunction [^Integer addr ^Sequential params ^(U Keyword Map) ret & {:keys [blocking main-thread]}]
  (let [ps (vec params) mode (call-mode blocking main-thread)]
    (ForeignFunction :name addr :lib nil :params ps :ret ret :mode mode
                     :cell (atom (open-fn nil addr ps ret mode)) :prep (prep-for ps ret))))

(defn- live-fn [ff]
  (let [h @(:cell ff)]
    (cond (%handle-current? h) h
          (nil? (:lib ff)) (error "A C function known by its address doesn't survive an image restore")
          :else (reset! (:cell ff) (open-fn (:lib ff) (:name ff) (:params ff) (:ret ff) (:mode ff))))))

(defn- call-converting
  "Call ff with arguments converted for its struct and callback
  parameters, the struct outs read back (with any Bytes outs, in order)."
  [ff args]
  (let [all (:params ff)
        ps (vec (take-while (fn [t] (not= t :...)) all))
        variadic? (not= (count ps) (count all))
        temps (atom [])
        outs (atom [])
        temp (fn [n] (let [p (alloc (max 16 n))] (swap! temps conj p) p))
        _ (when (if variadic? (< (count args) (count ps)) (not= (count ps) (count args)))
            (error (str "The foreign function takes " (count ps) (when variadic? " or more") " arguments, got " (count args))))
        raw (mapv (fn [t a]
                    (cond (layout? t) (let [p (temp (sizeof t))]
                                        ;; (a copy: C may change its own)
                                        (if (map? a) (struct-set! p t a) (write-bytes! p (bytes-at a (sizeof t))))
                                        p)
                          (not (vector? t)) a
                          (= :* (first t)) (if (map? a)
                                             (let [p (new-struct (second t) a)] (swap! temps conj p) p)
                                             a)
                          (= :out (first t)) (let [p (alloc (second t))]
                                               (swap! temps conj p)
                                               (swap! outs conj [:struct p (second t)])
                                               p)
                          (= :callback (first t)) (callback-for t a)
                          :else a))
                  ps args)
        raw (into raw (drop (count ps) args))
        ret-at (when (layout? (:ret ff)) (temp (sizeof (:ret ff))))]
    (try
      (let [r (apply %ffi-call (live-fn ff) (if ret-at (cons ret-at raw) raw))
            r (cond (not ret-at) r
                    (vector? r) (assoc r 0 (struct-get ret-at (:ret ff)))
                    :else (struct-get ret-at (:ret ff)))
            byte-outs? (some (fn [t] (= t :out)) ps)
            [ret byte-outs] (if byte-outs? [(first r) (rest r)] [r nil])]
        (if (empty? @outs)
          r
          ;; (outs in parameter order: Bytes ones from the runtime, struct ones read here)
          (loop [ts (seq ps) bs (seq byte-outs) ss (seq @outs) acc [ret]]
            (cond (nil? ts) acc
                  (= :out (first ts)) (recur (next ts) (next bs) ss (conj acc (first bs)))
                  (and (vector? (first ts)) (= :out (first (first ts))))
                  (let [[_ p l] (first ss)] (recur (next ts) bs (next ss) (conj acc (struct-get p l))))
                  :else (recur (next ts) bs ss acc)))))
      (finally (doseq [p @temps] (free! p))))))

(defn call
  "Call a foreign function. With :out parameters, the result is
  [return-value out…]."
  ;; (no signature: every defcfun function calls this, and checks its
  ;; arguments against its own C signature first)
  [ff & args]
  (if (:prep ff)
    (call-converting ff args)
    (apply %ffi-call (live-fn ff) args)))

(begin-for-syntax
 ;; (for defcfun, when it expands)
 (defn contract-for
   "A predicate for an argument (or result) of C type t."
   [t]
   (cond (contains? #{:f32 :float :f64 :double} t) 'number?
         (= t :string) '(nilable string?)
         (= t :bytes) 'bytes?
         (= t :out) 'integer?
         (= t :pointer) '(nilable integer?)
         (= t :void) 'any?
         (and (vector? t) (= :* (first t))) '(any-of map? integer?)
         (and (vector? t) (= :callback (first t))) '(any-of fn? norn.ffi/callback? integer?)
         (and (vector? t) (= :out (first t))) 'any?
         (and (symbol? t) (not (keyword? t))) '(any-of map? integer?)
         (keyword? t) 'integer?
         :else 'any?)))

(defmacro defcfun
  "(defcfun name lib \"c_name\" [param type …] return-type & options):
  define a Norn function calling a C function (options as for function).
  Its signature is checked on calls from other modules. A variadic one
  ends [… & more]. Parameter types may come alone ([:string :int]),
  unnamed and unchecked (:... for variadic). :private true keeps the
  function inside its module, as defn- does (a library's raw bindings)."
  [fname lib cname params ret & opts]
  (let [private? (true? (get (apply hash-map opts) :private))
        opts (apply concat (dissoc (apply hash-map opts) :private))
        named? (symbol? (first params))
        [fixed rest-name] (let [[a b] (split-with (fn [x] (not= x '&)) params)] [a (second b)])
        names (if named? (mapv first (partition 2 fixed)) (mapv (fn [i] (symbol (str "arg" i))) (range (count params))))
        types (if named? (cond-> (mapv second (partition 2 fixed)) rest-name (conj :...)) params)
        ff (symbol (str fname "%ffi"))
        out? (some (fn [t] (or (= t :out) (and (vector? t) (= :out (first t))))) types)]
    `(do (def ~ff (norn.ffi/function ~lib ~cname ~types ~ret ~@opts))
         (%set-private! (var ~ff))
         ~(cond rest-name `(defn ~fname [~@names ~'& ~rest-name] (apply norn.ffi/call ~ff ~@names ~rest-name))
                named? `(defn ~fname ~names (norn.ffi/call ~ff ~@names))
                :else `(defn ~fname [& args#] (apply norn.ffi/call ~ff args#)))
         ~@(if private?
             [`(%set-private! (var ~fname))]
             (when (and named? (not rest-name))
               [`(defcontract ~fname (fn-of [~@(map contract-for types)] ~(if out? 'vector? (contract-for ret))))]))
         (var ~fname))))

;; (everything here that touches C or its memory is for (:unsafe) modules)
(doseq [v [#'library #'function #'function-at #'call #'defcfun #'callback #'free-callback!
           #'alloc #'free! #'mem-get #'mem-set! #'struct-get #'struct-set! #'field #'set-field!
           #'new-struct #'with-alloc #'string-at #'bytes-at #'write-bytes! #'alloc-string]]
  (%set-unsafe! v))
