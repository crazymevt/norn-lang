;;;; norn.zip — zip archives (M9 part 9.12), on norn.compress.
;;;;
;;;;   (def z (zip {"a.txt" "hello" "dir/b.bin" (bytes [1 2 3])}))
;;;;   (entries z)              ; [{:name "a.txt" :size 5 …} …]
;;;;   (read-entry z "a.txt")   ; => #bytes "68656c6c6f"
;;;;   (unzip z)                ; => {"a.txt" #bytes … "dir/b.bin" #bytes …}
;;;;   (extract! z "out/")
;;;;
;;;; Archives are Bytes. Entries are stored or deflated (the methods nearly
;;;; every zip uses), names UTF-8, each one's CRC checked when read. For
;;;; untrusted archives: reading stops past :max-size bytes in all (256 MiB),
;;;; whatever the headers claim, and extract! refuses a name that would
;;;; land outside its folder (/abs, ../). Not yet: ZIP64 (archives over
;;;; 4 GiB or 65535 entries), encryption, other methods.

(ns norn.zip (:require [norn.compress :as z] [norn.bytes :as b] [norn.io :as io] [norn.string :as str]))

(defn- u16 [bs i] (+ (nth bs i) (* 256 (nth bs (inc i)))))
(defn- u32 [bs i] (+ (u16 bs i) (* 65536 (u16 bs (+ i 2)))))
(defn- le [n width] (bytes (map (fn [k] (bit-and (bit-shift-right n (* 8 k)) 255)) (range width))))

(defn- bad! [msg] (error ParseError :message (str "Not a zip archive (or one norn.zip reads): " msg) :source "zip"))

(defn- dos-time
  "[time date], MS-DOS style, of epoch milliseconds (as UTC)."
  [ms]
  (let [[y mo d h mi s] (%civil (* ms 1000000) 0)
        y (max 1980 y)]
    [(+ (* h 2048) (* mi 32) (quot s 2)) (+ (* (- y 1980) 512) (* mo 32) d)]))

(defn- from-dos [t d]
  (let [ns (%from-civil [(+ 1980 (bit-shift-right d 9)) (max 1 (bit-and (bit-shift-right d 5) 15)) (max 1 (bit-and d 31))
                         (bit-shift-right t 11) (bit-and (bit-shift-right t 5) 63) (* 2 (bit-and t 31)) 0]
                        0)]
    (quot ns 1000000)))

(defn entries
  "The entries of archive bs, in the central directory's order: {:name
  :size :compressed-size :method (:stored or :deflated) :crc :modified
  (epoch ms) :directory? :offset}."
  ^Vector [^Bytes bs]
  (when-not (bytes? bs) (error "A zip archive is Bytes"))
  (let [n (count bs)
        eocd (first (filter (fn [i] (and (>= i 0) (= (u32 bs i) 0x06054b50)))
                            (range (- n 22) (max -1 (- n 65558)) -1)))]
    (when-not eocd (bad! "no end of central directory record"))
    (let [count-entries (u16 bs (+ eocd 10))
          dir-at (u32 bs (+ eocd 16))]
      (when (or (= dir-at 0xFFFFFFFF) (= count-entries 0xFFFF)) (bad! "ZIP64 isn't read yet"))
      (when (> dir-at eocd) (bad! "the central directory is past its end"))
      (loop [i dir-at k 0 out []]
        (if (= k count-entries)
          out
          (do (when (or (> (+ i 46) n) (not= (u32 bs i) 0x02014b50)) (bad! "a broken central directory"))
              (let [method (u16 bs (+ i 10))
                    nlen (u16 bs (+ i 28)) xlen (u16 bs (+ i 30)) clen (u16 bs (+ i 32))
                    _ (when (> (+ i 46 nlen) n) (bad! "a name runs past the end"))
                    name (bytes->string (b/slice bs (+ i 46) (+ i 46 nlen)) true)]
                (recur (+ i 46 nlen xlen clen) (inc k)
                       (conj out {:name name :size (u32 bs (+ i 24)) :compressed-size (u32 bs (+ i 20))
                                  :method (case method 0 :stored 8 :deflated method) :crc (u32 bs (+ i 16))
                                  :modified (from-dos (u16 bs (+ i 12)) (u16 bs (+ i 14)))
                                  :directory? (str/ends-with? name "/") :offset (u32 bs (+ i 42))})))))))))

(defn- data-of [bs e limit]
  (let [at (:offset e)
        n (count bs)]
    (when (or (> (+ at 30) n) (not= (u32 bs at) 0x04034b50)) (bad! (str "no local header for " (:name e))))
    (let [start (+ at 30 (u16 bs (+ at 26)) (u16 bs (+ at 28)))
          end (+ start (:compressed-size e))
          _ (when (> end n) (bad! (str (:name e) " runs past the end")))
          raw (b/slice bs start end)
          data (case (:method e)
                 :stored raw
                 :deflated (z/decompress raw :format :raw :max-size limit)
                 (error (str "norn.zip reads stored and deflated entries, not method " (:method e) " (" (:name e) ")")))]
      (when-not (= (count data) (:size e)) (bad! (str (:name e) " isn't the size its header says")))
      (when-not (= (z/crc32 data) (:crc e)) (bad! (str (:name e) "'s CRC doesn't match: damaged")))
      data)))

(defn read-entry
  "The contents of entry name (a string, or an entry map) in archive bs,
  as Bytes; nil if there's none. Option :max-size."
  ^(? Bytes) [^Bytes bs ^(U String Map) name & {:keys [max-size] :or {max-size z/default-max-size}}]
  (when-let [e (if (map? name) name (first (filter (fn [e] (= (:name e) name)) (entries bs))))]
    (data-of bs e max-size)))

(defn unzip
  "Every file in archive bs: {name bytes} (directories left out). Option
  :max-size, for all of them together."
  ^Map [^Bytes bs & {:keys [max-size] :or {max-size z/default-max-size}}]
  (loop [es (remove :directory? (entries bs)) left max-size out {}]
    (if (empty? es)
      out
      (let [e (first es)
            _ (when (> (:size e) left) (error (str "unzip: more than :max-size (" max-size " bytes) in all")))
            d (data-of bs e left)]
        (recur (rest es) (- left (count d)) (assoc out (:name e) d))))))

(defn- safe-name [name]
  (let [parts (str/split name #"/")]
    (when (or (str/starts-with? name "/") (str/starts-with? name "\\") (re-find #"^[A-Za-z]:" name)
              (some (fn [p] (contains? #{".." "."} p)) parts) (str/includes? name "\\"))
      (error (str "extract!: refusing " (pr-str name) ": it would land outside the folder")))
    name))

(defn extract!
  "Write archive bs's files under folder dir (made as needed); their paths.
  A name that would land outside dir is an error, before anything's
  written. Option :max-size."
  ^Vector [^Bytes bs ^String dir & opts]
  (let [files (apply unzip bs opts)]
    (doseq [n (keys files)] (safe-name n))
    (vec (for [[n data] (sort-by first files)]
           (let [path (io/path dir n)]
             (when-let [p (io/parent path)] (io/mkdirs! p))
             (io/write-bytes path data)
             path)))))

(defn zip
  "An archive of entries: a map, or pairs, of name to contents (Bytes, or
  a string as UTF-8; a name ending / is a directory). Each is deflated
  unless that doesn't make it smaller. Option :modified (epoch ms, now by
  default)."
  ^Bytes [^(U Map Sequential) entries & {:keys [modified]}]
  (let [ms (or modified (quot (%now-nanos) 1000000))
        [t d] (dos-time ms)
        parts (reduce (fn [{:keys [out offset central]} [name content]]
                        (let [data (if (string? content) (bytes content) (or content (bytes [])))
                              nb (bytes (str name))
                              crc (z/crc32 data)
                              packed (z/compress data :format :raw :level 6)
                              [method body] (if (< (count packed) (count data)) [8 packed] [0 data])
                              common (b/concat-bytes (le 20 2) (le 2048 2) (le method 2) (le t 2) (le d 2) (le crc 4)
                                                     (le (count body) 4) (le (count data) 4) (le (count nb) 2) (le 0 2))
                              local (b/concat-bytes (le 0x04034b50 4) common nb body)
                              entry (b/concat-bytes (le 0x02014b50 4) (le 0x031e 2) common (le 0 2) (le 0 2) (le 0 2)
                                                    (le (if (str/ends-with? (str name) "/") 0x10 0) 4) (le offset 4) nb)]
                          {:out (conj out local) :offset (+ offset (count local)) :central (conj central entry)}))
                      {:out [] :offset 0 :central []}
                      (seq entries))
        dir (apply b/concat-bytes (:central parts))
        n (count (:central parts))
        eocd (b/concat-bytes (le 0x06054b50 4) (le 0 2) (le 0 2) (le n 2) (le n 2) (le (count dir) 4) (le (:offset parts) 4) (le 0 2))]
    (when (>= n 0xFFFF) (error "norn.zip writes up to 65534 entries (no ZIP64 yet)"))
    (apply b/concat-bytes (concat (:out parts) [dir eocd]))))
