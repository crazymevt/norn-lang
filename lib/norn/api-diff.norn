;;;; norn.api-diff — `norn api-diff`: each sealed module's public interface,
;;;; recorded under api/ when it's sealed, and what has changed since.
;;;;
;;;; A module's interface is its public names: a function's parameter lists
;;;; and checked signature, a macro's or generic function's parameter
;;;; lists, a class's superclasses and slots, and whether a var is dynamic.
;;;; Adding is fine. Removing, or changing what's there, breaks callers:
;;;; a name or an arity gone, a kind changed, a signature's types changed,
;;;; a slot or superclass gone.
;;;;
;;;;   norn api-diff            compare the modules with api/ (status 1 if
;;;;                            anything breaks)
;;;;   norn api-diff --record   write api/ from the modules as they are
;;;;   norn api-diff MODULE…    just those (with --record too)
;;;;
;;;; In a project, the modules are the project's own (every module under its
;;;; :paths); in the Norn checkout, the standard library's.

(ns norn.api-diff
  (:require [norn.deps :as deps] [norn.io :as io] [norn.string :as str] [norn.edn :as edn]))

(def internal
  "The libraries that come with Norn but aren't its interface: the
  compiler, the expander, and core's documentation table."
  #{"norn.compiler" "norn.expander" "norn.core-docs"})

(defn standard-modules
  "The modules whose interfaces are recorded: norn.core and every library
  that comes with Norn, but the internal ones, sorted."
  ^Vector []
  (vec (sort (remove internal (cons "norn.core" (keep (fn [n] (when (%find-lib n) n)) (%embedded-libs)))))))

(defn project-modules
  "The modules of the project in folder dir (every .norn file under its
  :paths, by the name it's required as), sorted."
  ^Vector [^String dir]
  (vec (sort (for [p (:paths (deps/read-project dir))
                   :let [root (io/path dir p)]
                   :when (io/directory? root)
                   f (%fs-walk root)
                   :when (str/ends-with? f ".norn")]
               (-> (subs f (inc (count root)) (- (count f) 5)) (str/replace "/" ".") (str/replace "\\" "."))))))

(defn- contract-text [c] (if c (:name c) "Any"))

(defn- signature [v]
  (when-let [c (%contract-of v)]
    (mapv (fn [p]
            (cond-> {:args (mapv contract-text (:args p)) :result (contract-text (:result p))}
                    (:variadic p) (assoc :rest (contract-text (:rest p)))))
          (if (map? c) [c] c))))

(defn- arglists [v] (some->> (:arglists (definition v)) (mapv pr-str)))

(defn- entry
  "What module users rely on about public var v."
  [v]
  (let [x (var-get v)]
    (cond (macro? v) {:kind :macro :arglists (arglists v)}
          (class? x) {:kind :class
                      :supers (mapv (fn [c] (str (class-name c))) (class-direct-superclasses x))
                      :slots (vec (sort (map (comp name :name) (class-slots x))))}
          (generic? x) {:kind :generic :arglists (arglists v)}
          (fn? x) (cond-> {:kind :function :arglists (arglists v)}
                          (signature v) (assoc :signature (signature v)))
          :else (cond-> {:kind :var} (%var-dynamic? v) (assoc :dynamic true)))))

(defn interface
  "Module m's (a name) public interface: {name entry}, sorted by name. Names
  starting with % are the runtime's own, and left out."
  ^Map [^String m]
  (require (symbol m))
  (into (sorted-map)
        (for [[s v] (ns-publics (symbol m))
              :when (not= "%" (subs (str s) 0 1))]
          [(str s) (entry v)])))

;; ---- comparing ----

(defn- arity-of
  "An arglist's text as [fixed variadic?]."
  [text]
  (let [ps (read-string text)
        amp (some (fn [[i p]] (when (= '& p) i)) (map-indexed vector ps))]
    [(or amp (count ps)) (some? amp)]))

(defn- accepts?
  "Does an arity in news take k arguments?"
  [news k]
  (some (fn [[m v]] (if v (<= m k) (= m k))) news))

(defn- takes?
  "Do the arities news, between them, accept every call old (an arity) did?
  (A variadic arity split into fixed ones and a later variadic one, as
  (swap! a f x) for speed, still takes every count.)"
  [news [n variadic?]]
  (if variadic?
    (when-let [m (some (fn [[m v]] (when v m)) news)]
      (every? (fn [k] (accepts? news k)) (range n (inc (max n m)))))
    (accepts? news n)))

(defn changes
  "How interface new differs from old (both from interface): a vector of
  {:name :change :breaking}, sorted by name."
  ^Vector [^Map old ^Map new]
  (vec
   (sort-by :name
            (concat
             (for [[n e] old :when (not (contains? new n))]
               {:name n :change (str "removed (a " (name (:kind e)) ")") :breaking true})
             (for [[n e] new :when (not (contains? old n))]
               {:name n :change (str "added (a " (name (:kind e)) ")") :breaking false})
             (for [[n o] old
                   :let [e (get new n)]
                   :when (and e (not= o e))
                   c (cond
                       (not= (:kind o) (:kind e))
                       [[(str "was a " (name (:kind o)) ", is a " (name (:kind e))) true]]
                       :else
                       (concat
                        (let [news (map arity-of (:arglists e))]
                          (for [a (:arglists o) :when (not (takes? news (arity-of a)))]
                            [(str "no longer takes " a) true]))
                        (for [a (:arglists e) :when (not (some #{a} (:arglists o)))
                              :when (takes? (map arity-of (:arglists o)) (arity-of a))]
                          [(str "parameters renamed: " a) false])
                        (for [a (:arglists e) :when (not (takes? (map arity-of (:arglists o)) (arity-of a)))]
                          [(str "now also takes " a) false])
                        (when (and (:signature o) (not= (:signature o) (:signature e)))
                          [[(str "signature " (pr-str (:signature o)) " is now " (pr-str (:signature e))) true]])
                        (when (and (nil? (:signature o)) (:signature e))
                          [[(str "now checked: " (pr-str (:signature e))) false]])
                        (for [s (:slots o) :when (not (some #{s} (:slots e)))] [(str "slot " s " removed") true])
                        (for [s (:slots e) :when (not (some #{s} (:slots o)))] [(str "slot " s " added") false])
                        (for [s (:supers o) :when (not (some #{s} (:supers e)))] [(str "no longer a " s) true])
                        (when (and (:dynamic o) (not (:dynamic e))) [["no longer dynamic" true]])))]
               {:name n :change (first c) :breaking (second c)})))))

;; ---- api/ ----

(defn- file-of [dir m] (io/path dir (str m ".edn")))

(defn record!
  "Write module m's interface to dir/m.edn, one name to a line. Its path."
  ^String [^String dir ^String m]
  (io/mkdirs! dir)
  (let [api (interface m)
        path (file-of dir m)]
    (io/write-text path (str ";; " m "'s public interface, recorded by norn api-diff --record.\n{\n"
                             (apply str (for [[n e] api] (str " " (pr-str n) " " (edn/write-string e) "\n")))
                             "}\n"))
    path))

(defn recorded
  "Module m's interface as recorded in dir, or nil without one."
  [^String dir ^String m]
  (let [path (file-of dir m)]
    (when (io/file? path) (edn/read-string (io/read-text path)))))

(defn diff
  "Each of modules (names) against its record in dir: {module changes},
  modules without a record left out."
  ^Map [^String dir modules]
  (into (sorted-map)
        (for [m modules
              :let [old (recorded dir m)]
              :when old]
          [m (changes old (interface m))])))

(defn main
  "`norn api-diff [--record] [--dir DIR] [MODULE…]`: the exit status."
  [& args]
  (let [opts (loop [args args o {:dir "api" :modules []}]
               (if-let [a (first args)]
                 (cond (= a "--record") (recur (next args) (assoc o :record true))
                       (= a "--dir") (recur (nnext args) (assoc o :dir (second args)))
                       (str/starts-with? a "-") (assoc o :bad a)
                       :else (recur (next args) (update o :modules conj a)))
                 o))
        project (deps/find-project ".")
        modules (cond (seq (:modules opts)) (:modules opts)
                      project (project-modules project)
                      :else (standard-modules))
        dir (:dir opts)]
    (cond
      (:bad opts) (do (println "norn api-diff: unknown option" (:bad opts)) 2)
      (:record opts) (do (doseq [m modules] (record! dir m))
                         (println "norn api-diff: recorded" (count modules) (if (= 1 (count modules)) "module in" "modules in") dir)
                         0)
      (not (io/directory? dir))
      (do (println (str "norn api-diff: no " dir "/ yet: norn api-diff --record takes the baseline")) 0)
      :else
      (let [d (diff dir modules)
            broken (for [[m cs] d c cs :when (:breaking c)] [m c])
            added (for [[m cs] d c cs :when (not (:breaking c))] [m c])
            missing (remove (fn [m] (contains? d m)) modules)]
        (doseq [[m c] broken] (println (str "BREAKING  " m "/" (:name c) ": " (:change c))))
        (doseq [[m c] added] (println (str "          " m "/" (:name c) ": " (:change c))))
        (doseq [m missing] (println (str "unrecorded " m " (norn api-diff --record " m ")")))
        (println (str "norn api-diff: " (count d) (if (= 1 (count d)) " module, " " modules, ") (count broken) " breaking, "
                      (count added) (if (= 1 (count added)) " compatible change" " compatible changes")))
        (if (seq broken)
          (do (println (str "A breaking change needs a new major version (or a deprecation first). If it's"
                            " meant, record it with norn api-diff --record and commit the change to " dir "/."))
              1)
          0)))))
