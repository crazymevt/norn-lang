;;;; norn.new — `norn new NAME`: a new project, ready to run, test and
;;;; package.
;;;;
;;;;   NAME/
;;;;     norn.edn             :name, :version, :main and :package
;;;;     src/NAME/main.norn   its main, the entry function
;;;;     tests/main_test.norn a test of it
;;;;     README.md, .gitignore
;;;;
;;;; and a Git repository, unless the folder is in one already (or --no-git).
;;;; `norn run` runs it, `norn test` tests it, `norn package` packages it.

(ns norn.new
  (:require [norn.cli :as cli] [norn.io :as io] [norn.process :as process] [norn.string :as str]))

(defn- fail [& parts] (error (apply str "norn new: " parts)))

(defn- display-name
  "my-app as My App."
  [name]
  (str/join " " (map (fn [w] (str (str/upper-case (subs w 0 1)) (subs w 1))) (remove str/blank? (str/split name #"-")))))

(defn files
  "The files of a new project called name (a string), as {path text}; with
  app, packaged as a macOS app as well as a command-line archive."
  ^Map [^String name ^Boolean app]
  {"norn.edn"
   (str "{:name " name "\n"
        " :version \"0.1.0\"\n"
        " :paths [\"src\"]\n"
        " :main " name ".main/main\n"
        " ;; norn package: what it makes (a macOS app also takes :id, :display-name\n"
        " ;; and :icon, a PNG)\n"
        (if app
          (str " :package {:display-name \"" (display-name name) "\"\n"
               "           :targets [:app :cli]}}\n")
          " :package {:targets [:cli]}}\n"))

   (str "src/" name "/main.norn")
   (str "(ns " name ".main\n"
        "  (:require [norn.string :as str]))\n"
        "\n"
        "(defn greeting\n"
        "  \"What main says to the names it's given.\"\n"
        "  [names]\n"
        "  (str \"Hello, \" (if (seq names) (str/join \" and \" names) \"world\") \"!\"))\n"
        "\n"
        "(defn main\n"
        "  \"" name "'s entry point: its command-line arguments in, its exit status out.\"\n"
        "  [& args]\n"
        "  (println (greeting args))\n"
        "  0)\n")

   "tests/main_test.norn"
   (str "(ns " name ".main-test\n"
        "  (:require [norn.test :refer [deftest is]] [" name ".main :as main]))\n"
        "\n"
        "(deftest greeting\n"
        "  (is (= \"Hello, world!\" (main/greeting [])))\n"
        "  (is (= \"Hello, Ada and Grace!\" (main/greeting [\"Ada\" \"Grace\"]))))\n")

   "README.md"
   (str "# " name "\n"
        "\n"
        "```sh\n"
        "norn run Ada        # run it: its arguments follow\n"
        "norn test           # run its tests\n"
        "norn package        # a command-line archive" (when app ", and a macOS app,") " in dist/\n"
        "```\n")

   ".gitignore"
   "/.norn/\n/dist/\n*.nimg\n.DS_Store\n"})

(defn- in-git? [dir]
  (try (= 0 (:exit (process/sh "git" "-C" dir "rev-parse" "--is-inside-work-tree")))
       (catch Error _ false)))

(defn create!
  "Write a new project called name (a string) into folder dir, which must
  be missing or empty: its path. Options: :app (a macOS app too) and :git
  (a Git repository, when dir isn't in one already; default true)."
  ^String [^String name ^String dir & {:keys [app git] :or {git true}}]
  (when-not (re-matches #"[a-z][a-z0-9]*(-[a-z0-9]+)*" name)
    (fail "a project's name is lower-case letters and digits, joined by hyphens (my-app), not " (pr-str name)))
  (when (and (io/exists? dir) (not (and (io/directory? dir) (empty? (io/list-dir dir)))))
    (fail dir " is there already, and isn't an empty folder"))
  (io/mkdirs! dir)
  (doseq [[f text] (files name (boolean app))]
    (let [p (io/path dir f)]
      (io/mkdirs! (io/parent p))
      (io/write-text p text)))
  (when (and git (not (in-git? (io/parent (io/absolute dir)))))
    (let [r (try (process/sh "git" "init" "-q" dir) (catch Error _ nil))]
      (when-not (= 0 (:exit r))
        (println "norn new: no Git repository made (is git installed?)"))))
  dir)

(def ^:private spec
  {:name "norn new" :summary "Make a new project, ready to run, test and package."
   :options [{:name :dir :value "DIR" :doc "Where to put it (default: NAME, here)"}
             {:name :app :doc "Package it as a macOS app as well as a command-line archive"}
             {:name :git :default true :negatable true :doc "Make it a Git repository (unless it's in one)"}]
   :args [{:name :name :doc "The project's name: lower-case letters and digits, joined by hyphens"}]
   :run (fn [{:keys [options args]}]
          (let [n (:name args)
                d (create! n (or (:dir options) n) :app (:app options) :git (:git options))]
            (println (str "Made " d ". Next:"))
            (println (str "  cd " d))
            (println "  norn run")
            0))})

(defn main
  "norn new's command line: the exit status."
  [& args]
  (try (cli/run spec args)
       (catch Error e (println (:message e)) 1)))
