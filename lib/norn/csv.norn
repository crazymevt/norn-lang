;;;; norn.csv — comma-separated values (RFC 4180; M9 part 9.12).
;;;;
;;;;   (read-csv "a,b\n1,\"x, y\"\n")       ; => [["a" "b"] ["1" "x, y"]]
;;;;   (read-maps "id,name\n1,ada\n")       ; => [{:id "1" :name "ada"}]
;;;;   (write-csv [["a" "b"] [1 "x, y"]])  ; => "a,b\r\n1,\"x, y\"\r\n"
;;;;
;;;; A field in quotes may hold separators, quotes (doubled) and line
;;;; breaks. Lines end in \n or \r\n. Fields are strings: convert them as the
;;;; data needs. write-csv quotes a field only when it must, and ends lines
;;;; with \r\n (as RFC 4180 says; :newline "\n" for the other).

(ns norn.csv (:require [norn.string :as str]))

(defn- fail [line why]
  (error ParseError :source "CSV" :line line :message (str "CSV, line " line ": " why)))

(defn- end-field [row field] (conj! row (str/join (persistent! field))))

(defn- end-row
  "The state after a row ends at a line break on line."
  [field row rows starts line row-line]
  [:start (transient []) (transient []) (conj! rows (persistent! (end-field row field))) (conj! starts row-line) (inc line) (inc line)])

(defn- parse
  "[rows lines]: the rows of CSV text, and the line each starts on."
  [text separator quote]
  (let [[state field row rows starts _ row-line]
        (reduce (fn [[state field row rows starts line row-line] c]
                  (case state
                    ;; (:start: at a field's start; :plain: in an unquoted one;
                    ;; :quoted: inside quotes; :quote: a quote inside quotes,
                    ;; doubled or closing; :cr: after a \r)
                    :quoted (cond (= c quote) [:quote field row rows starts line row-line]
                                  (= c \newline) [:quoted (conj! field c) row rows starts (inc line) row-line]
                                  :else [:quoted (conj! field c) row rows starts line row-line])
                    :quote (cond (= c quote) [:quoted (conj! field c) row rows starts line row-line]
                                 (= c separator) [:start (transient []) (end-field row field) rows starts line row-line]
                                 (= c \newline) (end-row field row rows starts line row-line)
                                 (= c \return) [:cr field row rows starts line row-line]
                                 :else (fail line (str "text after a closing quote: " (pr-str c))))
                    :cr (if (= c \newline)
                          (end-row field row rows starts line row-line)
                          (fail line "a \\r without its \\n"))
                    (cond (and (= c quote) (= state :start)) [:quoted field row rows starts line row-line]
                          (= c separator) [:start (transient []) (end-field row field) rows starts line row-line]
                          (= c \newline) (end-row field row rows starts line row-line)
                          (= c \return) [:cr field row rows starts line row-line]
                          :else [:plain (conj! field c) row rows starts line row-line])))
                [:start (transient []) (transient []) (transient []) (transient []) 1 1]
                (str text))
        row (persistent! row)
        field (persistent! field)]
    (when (= state :quoted) (fail row-line "a quoted field is never closed"))
    (if (and (empty? row) (empty? field) (not= state :quote))
      [(persistent! rows) (persistent! starts)]
      [(persistent! (conj! rows (conj row (str/join field)))) (persistent! (conj! starts row-line))])))

(defn read-csv
  "The rows of CSV text, each a vector of strings. Options: :separator
  (\\,), :quote (\\\"). Text that isn't CSV (a quote left open, text after
  a closing quote) signals ParseError, with its :line."
  ^Vector [^String text & {:keys [separator quote] :or {separator \, quote \"}}]
  (first (parse text separator quote)))

(defn read-maps
  "CSV text with a header row, as maps of its column names (as keywords,
  or :keys identity for the strings) to each row's fields. A row with more
  or fewer fields than the header signals ParseError naming its line;
  with :strict false, extra fields are dropped and missing ones left out
  of its map. Blank lines are skipped when there are two or more columns.
  Options as read-csv, and :keys and :strict."
  ^Vector [^String text & {:keys [keys strict separator quote] :or {keys keyword strict true separator \, quote \"}}]
  (let [[rows lines] (parse text separator quote)
        ks (mapv keys (first rows))
        n (count ks)]
    (into []
          (comp (remove (fn [[r _]] (and (> n 1) (= [""] r))))
                (map (fn [[r line]]
                       (when (and strict (not= n (count r)))
                         (fail line (str "a row of " (count r) (if (= 1 (count r)) " field" " fields")
                                         ", while the header has " n)))
                       (zipmap ks r))))
          (map vector (rest rows) (rest lines)))))

(defn- field-text [x separator quote]
  (let [s (if (nil? x) "" (str x))]
    (if (some (fn [c] (or (= c separator) (= c quote) (= c \newline) (= c \return))) s)
      (str quote (str/replace s (str quote) (str quote quote)) quote)
      s)))

(defn write-csv
  "Rows (sequences of values, written with str; nil empty) as CSV text.
  Options: :separator, :quote, :newline (\"\\r\\n\")."
  ^String [^Sequential rows & {:keys [separator quote newline] :or {separator \, quote \" newline "\r\n"}}]
  (str/join (map (fn [r] (str (str/join (str separator) (map (fn [x] (field-text x separator quote)) r)) newline)) rows)))

(defn write-maps
  "Maps as CSV text, a header row first: the columns are :columns, or the
  first map's keys. Options as write-csv."
  ^String [^Sequential ms & {:keys [columns] :as opts}]
  (let [cols (or columns (vec (keys (first ms))))]
    (apply write-csv (cons (mapv (fn [k] (if (keyword? k) (name k) k)) cols) (map (fn [m] (mapv (fn [k] (get m k)) cols)) ms))
           (mapcat identity (dissoc opts :columns)))))
