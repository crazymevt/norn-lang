;;;; norn.walk — transforming nested data.
;;;;
;;;; walk rebuilds a collection of the same kind (a list stays a list, a
;;;; sorted map stays sorted); other values are leaves.

(ns norn.walk)

(defn walk
  "outer applied to form with inner applied to each of its items (map
  entries as [k v] vectors)."
  [inner outer form]
  (cond (list? form) (outer (apply list (map inner form)))
        (map? form) (outer (into (empty form) (map (fn [[k v]] (let [e (inner [k v])] [(nth e 0) (nth e 1)]))) form))
        (vector? form) (outer (mapv inner form))
        (set? form) (outer (into (empty form) (map inner) form))
        (queue? form) (outer (into (empty form) (map inner) form))
        (seq? form) (outer (doall (map inner form)))
        :else (outer form)))

(defn postwalk "f applied to every subform, children first." [f form] (walk (fn [x] (postwalk f x)) f form))
(defn prewalk "f applied to every subform, parents first." [f form] (walk (fn [x] (prewalk f x)) identity (f form)))

(defn postwalk-replace "form with every subform that is a key of smap replaced by its value (children first)." [^Map smap form]
  (postwalk (fn [x] (if (contains? smap x) (get smap x) x)) form))
(defn prewalk-replace "As postwalk-replace, parents first." [^Map smap form]
  (prewalk (fn [x] (if (contains? smap x) (get smap x) x)) form))

(defn keywordize-keys "Every string key in nested maps made a keyword." [m]
  (postwalk (fn [x] (if (map? x) (into (empty x) (map (fn [[k v]] [(if (string? k) (keyword k) k) v])) x) x)) m))

(defn stringify-keys "Every keyword key in nested maps made a string (its name)." [m]
  (postwalk (fn [x] (if (map? x) (into (empty x) (map (fn [[k v]] [(if (keyword? k) (name k) k) v])) x) x)) m))

(defn macroexpand-all "form with every macro call expanded, at every level (quoted forms left alone)." [form]
  (prewalk (fn [x] (if (and (seq? x) (not= 'quote (first x))) (macroexpand x) x)) form))

(defn leaves "The values of form that aren't collections, depth first." ^Vector [form]
  (if (coll? form) (vec (mapcat leaves (if (map? form) (mapcat identity form) form))) [form]))
