;;;; norn.process — child processes. Their pipes are ordinary streams
;;;; (norn.io read/write/close) on the reactor; waiting runs on the blocking
;;;; pool, so a fiber waiting for a child never blocks a carrier.

(ns norn.process (:require [norn.io :as io]))

(defn start
  "Start a program. Options:
    :args [...]       its arguments
    :dir path         its working directory
    :env {name val}   environment variables to add or override
    :clear-env true   start from an empty environment
    :in :out :err     :pipe (default), :inherit or :null
  Returns {:process h :pid n :in stream :out stream :err stream}; a stream is
  nil unless piped."
  ^Map [^String cmd & {:keys [args dir env clear-env in out err]}]
  (%process-start (str cmd) (mapv str (or args [])) (when dir (str dir)) (or env {})
                  (if clear-env true false) [(or in :pipe) (or out :pipe) (or err :pipe)]))

(defn start-pty
  "Start a program on a pseudo-terminal (rows × cols: 24 × 80), its
  controlling terminal: for shells, editors and anything else that wants
  one. Options as for start, plus :rows and :cols. Returns {:process h
  :pid n :in stream :out stream :pty true}: :in is what's typed at the
  terminal, :out what it shows (standard output and error together, and
  the terminal's echo). TERM is xterm-256color unless :env sets it.

  Read :out as the program runs, as a terminal emulator does: a program
  whose terminal output nobody reads waits for it, and on macOS even its
  exit does (wait won't return until its last output is read)."
  ^Map [^String cmd & {:keys [args dir env clear-env rows cols]}]
  (assoc (%pty-start (str cmd) (mapv str (or args [])) (when dir (str dir)) (merge {"TERM" "xterm-256color"} env)
                     (if clear-env true false) [(or rows 24) (or cols 80)])
         :pty true))

(defn resize
  "Tell the terminal of p (from start-pty) its new size: the program gets
  SIGWINCH."
  [^Map p ^Integer rows ^Integer cols]
  (when-not (:pty p) (error "resize: not a process on a pseudo-terminal (start-pty)"))
  (%pty-resize (:in p) rows cols))

(defn wait
  "Wait for process p to end: {:exit code :signal sig} (one of them nil).
  sig names the signal that ended it (:term, :kill, :int, :segv…), or is
  its number when Norn has no name for it."
  ^Map [^Map p]
  (%process-wait (:process p)))

(defn kill
  "Send p a signal: :term (default), :kill, :int, :hup, … or a number. A
  signal this OS doesn't have is an error; on Windows, :term and :kill
  end the process and the others aren't there."
  ([^Map p] (kill p :term))
  ([^Map p ^(U Keyword Integer) sig] (%process-kill (:process p) sig)))

(defn- split-opts [xs]
  (loop [args [] xs (seq xs)]
    (if (and xs (not (keyword? (first xs))))
      (recur (conj args (first xs)) (next xs))
      [args (apply hash-map xs)])))

(defn sh
  "Run cmd with arguments and wait for it: {:exit :signal :out :err}, with
  output as text. Options may follow the arguments: :in (a string or bytes
  to send), :dir, :env. E.g. (sh \"ls\" \"-l\" :dir \"/tmp\")."
  ^Map [^String cmd & args]
  (let [[args opts] (split-opts args)
        p (start cmd :args args :dir (:dir opts) :env (:env opts))
        out (spawn-detached (bytes->string (io/read-all (:out p)) true))
        err (spawn-detached (bytes->string (io/read-all (:err p)) true))]
    (when-let [in (:in opts)] (io/write (:in p) in))
    (io/close (:in p))
    (let [r (wait p)
          o (await out)
          e (await err)]
      (io/close (:out p))
      (io/close (:err p))
      (io/close (:process p))
      (assoc r :out o :err e))))
