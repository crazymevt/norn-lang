;;;; norn.io — files, streams and paths.
;;;;
;;;; Whole-file functions take a path. Streams are handles (files, pipes,
;;;; sockets): read, write and close work on all of them. Files are read and
;;;; written on the blocking pool, sockets and pipes through the reactor, so
;;;; no call ever blocks a carrier. An unreachable handle is closed by a
;;;; cleanup; close it yourself (or use with-open) to free it promptly.

(ns norn.io
  (:require [norn.bytes :as bytes] [norn.sys :as sys]))

;;; ---- whole files ----

(defn read-text "The contents of a file, as UTF-8 text (line endings as they are, on every OS)." [path] (%fs-read (str path) true))
(defn read-bytes "The contents of a file, as bytes." [path] (%fs-read (str path) false))
(defn write-text "Replace a file's contents with s (a string, as UTF-8)." [path s] (%fs-write (str path) (str s) false))
(defn write-bytes "Replace a file's contents with bytes b." [path b] (%fs-write (str path) b false))
(defn append-text "Add s to the end of a file (creating it)." [path s] (%fs-write (str path) (str s) true))
(defn lines "The lines of a text file, as a vector (split at \\n or \\r\\n)." [path] (%split-lines (read-text path)))

;;; ---- the file system ----

(defn info
  "{:type :file|:dir|:symlink|:other :size :modified (epoch ms) :readonly}, or nil if path doesn't exist."
  [path]
  (%fs-info (str path)))
(defn exists? "Is there a file, folder or other entry at path? (A symbolic link is, even one whose target is gone.)" [path] (some? (info path)))
(defn- type-of
  "Path's type, a symbolic link's being its target's (nil if it dangles)."
  [path]
  (let [t (:type (info path))]
    (if (= :symlink t)
      (when-let [c (%path-part (str path) :canonical)] (:type (info c)))
      t)))
(defn file? "Is path a file (or a symbolic link to one)?" [path] (= :file (type-of path)))
(defn directory? "Is path a directory (or a symbolic link to one)?" [path] (= :dir (type-of path)))
(defn list-dir "The names in a directory, sorted." [path] (%fs-list (str path)))
(defn mkdirs! "Create a directory and any missing parents." [path] (%fs-mkdirs (str path)))
(defn delete!
  "Delete a file or an empty directory; with :recursive true, a directory and everything in it."
  [path & {:keys [recursive]}]
  (%fs-delete (str path) (if recursive true false)))
(defn rename! "Rename (move) from to to, replacing a file already at to." [from to] (%fs-rename (str from) (str to)))
(defn copy! "Copy a file; returns the number of bytes copied." [from to] (%fs-copy (str from) (str to)))

;;; ---- paths ----

(defn path "Join path parts." [& parts] (%path-join (mapv str parts)))
(defn parent
  "The directory part of a path, or nil when it has none (a bare file
  name, or a root)."
  [p]
  (let [d (%path-part (str p) :parent)] (when-not (= "" d) d)))
(defn file-name "The last part of a path, or nil." [p] (%path-part (str p) :name))
(defn extension "The extension (without the dot), or nil." [p] (%path-part (str p) :ext))
(defn stem "The file name without its extension, or nil." [p] (%path-part (str p) :stem))
(defn absolute "The path made absolute against the current directory." [p] (%path-part (str p) :absolute))
(defn canonical
  "The path made absolute with every symbolic link, . and .. resolved, as
  file-system events report it; nil if it doesn't exist."
  [p]
  (%path-part (str p) :canonical))

;;; ---- streams ----

(defn auto-close
  "Low level: close handle h once it is unreachable. Returns h."
  [h]
  ;; A cleanup that closes the handle once it is unreachable (it holds the
  ;; handle's number, not the handle).
  (let [id (%handle-id h)] (add-cleanup! h (fn [] (%io-close-id id))))
  h)

(defn open
  "Open a file as a stream. mode: :read, :write (create or truncate),
  :append (create, add to the end), :read-write (read and write from the
  start, creating the file if it's missing, keeping its contents if not),
  or :create-new (create for writing, signalling FileExists if path exists
  already)."
  [path mode]
  (auto-close (%fs-open (str path) mode)))

(defn sync!
  "Flush everything written to file handle h to storage, so it survives a
  crash. nil."
  [h]
  (%file-sync (ensure-live h)))

(defn retry-io
  "Low level: call (f) until it stops answering :again (wait until h is
  readable) or :again-write (wait until it is writable), and return its
  answer. The event counts are read before each try, so a wake-up between
  the try and the wait is never lost."
  [h f]
  (loop []
    (let [rs (%io-seq h :read)
          ws (%io-seq h :write)
          r (f)]
      (cond (= r :again) (do (%io-wait h :read rs) (recur))
            (= r :again-write) (do (%io-wait h :write ws) (recur))
            :else r))))

(defgeneric stream-read (s n)
  "Up to n bytes from stream s, an instance of a class that is one (an HTTP
  response body, say), or nil at the end. A method for a class makes read,
  and everything built on it (read-line, read-all, copy-stream!,
  text-reader…), take its instances.")

(defgeneric stream-write (s data)
  "Write all of data (bytes) to stream s, an instance of a class that is one.")

(defgeneric stream-close (s)
  "Close stream s, an instance of a class that is one (twice is harmless).")

(defmethod stream-close ((s Object)) nil)

(defn read
  "Up to n bytes from a stream (file, pipe or socket, or an instance with
  a stream-read method), or nil at the end."
  [h n]
  (if (%instance? h)
    (stream-read h n)
    (let [h (ensure-live h)]
      (if (= :file (handle-kind h))
        (%file-read h n)
        (retry-io h (fn [] (%io-read h n)))))))

(defn write
  "Write all of data (a string, as UTF-8, or bytes) to a stream (or an
  instance with a stream-write method)."
  [h data]
  (let [b (bytes data)]
    (if (%instance? h)
      (stream-write h b)
      (let [h (ensure-live h)]
        (if (= :file (handle-kind h))
          (%file-write h b)
          (loop [i 0]
            (when (< i (count b))
              (recur (+ i (retry-io h (fn [] (%io-write h b i))))))))))
    nil))

(defn close
  "Close a stream (closing twice is harmless, and closing nil does
  nothing). A TLS stream first tells the peer it is closing."
  [h]
  (cond (nil? h) nil
        (%instance? h) (stream-close h)
        :else (do (when (and (= :tls (handle-kind h)) (%handle-live? h))
                    (try (retry-io h (fn [] (%tls-shutdown h))) (catch Error _ nil)))
                  (%io-close h))))

(defmacro with-open
  "(with-open [a (open path :read) b (open other :write) …] body…): bind
  each name in turn (a later init can use the earlier names), and close
  them all when body ends, however it ends: the last opened first. If an
  init fails, the streams opened before it are closed."
  [bindings & body]
  (when-not (and (vector? bindings) (even? (count bindings)))
    (error "with-open needs a vector of name/stream pairs" bindings))
  (if (empty? bindings)
    `(do ~@body)
    (let [[sym init & more] bindings]
      (when-not (symbol? sym) (error "with-open binds names (symbols)" sym))
      `(let [~sym ~init]
         (try ~(if (seq more) `(with-open [~@more] ~@body) `(do ~@body))
              (finally (norn.io/close ~sym)))))))

;;; ---- standard error ----

(defn eprint
  "Print xs to standard error, as print does (with-out-str doesn't catch
  it). nil."
  [& xs]
  (%write-stderr (apply print-str xs))
  nil)

(defn eprintln
  "Print xs and a newline to standard error, as println does. nil."
  [& xs]
  (%write-stderr (str (apply print-str xs) "\n"))
  nil)

(defn read-all
  "Everything left in a stream, as bytes."
  [h]
  (loop [acc (bytes [])]
    (let [b (read h 65536)]
      (if b (recur (bytes-concat acc b)) acc))))

;;; ---- lines ----

;; A line reader keeps the bytes it has read past the last line: buf, the
;; unread part from at, and scan, how far from at a newline was looked for.
(defclass LineReader () ((stream :required true) (state :required true))
  (:doc "The class of line readers, as line-reader makes: a stream's bytes,
  read a line at a time with read-line. A line reader is a stream too."))

(defmethod print-object ((_ LineReader)) "#<line-reader>")

(defn line-reader
  "A reader of lines from stream h, for read-line. It's a stream too:
  read gives the bytes it holds past the last line first, then h's."
  [h]
  (LineReader :stream h :state (atom {:buf (bytes []) :at 0 :scan 0})))

(defn line-reader? "Is x a line reader?" [x] (instance? LineReader x))

(defn- strip-cr [s]
  (if (and (pos? (count s)) (= \return (nth s (dec (count s))))) (subs s 0 (dec (count s))) s))

(def ^:private newline-byte (bytes [10]))

(defn read-line
  "The next line (without its line ending), or nil at the end. With no
  argument, reads standard input; otherwise a line reader."
  ([] (%stdin-line))
  ([r]
   (let [st (:state r)]
     (loop []
       (let [{:keys [buf at scan]} @st
             i (%bytes-find buf newline-byte (+ at scan))]
         (if (>= i 0)
           (do (reset! st {:buf buf :at (inc i) :scan 0})
               (strip-cr (bytes->string (subbytes buf at i))))
           (let [more (read (:stream r) 65536)
                 unread (- (count buf) at)]
             ;; (what's unread moves to the front once per read, not per line)
             (cond more (do (reset! st {:buf (bytes-concat (subbytes buf at) more) :at 0 :scan unread}) (recur))
                   (pos? unread) (do (reset! st {:buf (bytes []) :at 0 :scan 0}) (strip-cr (bytes->string (subbytes buf at))))
                   :else nil))))))))

(defmethod stream-read ((r LineReader) n)
  (let [{:keys [buf at]} @(:state r)]
    (if (< at (count buf))
      (let [end (min (count buf) (+ at n))]
        (reset! (:state r) {:buf buf :at end :scan 0})
        (subbytes buf at end))
      (read (:stream r) n))))

(defmethod stream-close ((r LineReader)) (close (:stream r)))

;;; ---- exact reads, copying and decoding ----

(defn read-exactly
  "Exactly n bytes from a stream, or nil if it ends before the first. A
  stream that ends partway signals IOError, with :reason :truncated."
  [h n]
  (when-not (and (integer? n) (<= 0 n)) (error "read-exactly needs a byte count" n))
  (loop [parts [] left n]
    (if (zero? left)
      (apply bytes-concat parts)
      (if-let [part (read h (min left 65536))]
        (recur (conj parts part) (- left (count part)))
        (when (< left n)
          (error IOError :reason :truncated
                 :message (str "The stream ended after " (- n left) " of " n " bytes")))))))

(defn copy-stream!
  "Copy from stream in to stream out until in ends, or, with :limit, until
  that many bytes are copied. The number of bytes copied."
  [in out & {:keys [limit]}]
  (when (and limit (not (and (integer? limit) (<= 0 limit)))) (error "copy-stream! :limit is a byte count" limit))
  (loop [total 0]
    (let [want (if limit (min 65536 (- limit total)) 65536)]
      (if-let [part (when (pos? want) (read in want))]
        (do (write out part) (recur (+ total (count part))))
        total))))

(defclass TextReader () ((stream :required true) (decoder :required true))
  (:doc "The class of text readers, as text-reader makes: a stream's bytes,
  decoded and read a piece of text at a time with read-chunk."))

(defmethod print-object ((_ TextReader)) "#<text-reader>")

(defn text-reader
  "A reader of decoded text from stream h, for read-chunk. :encoding is
  :utf-8 (the default), :utf-16le or :utf-16be."
  [h & {:keys [encoding] :or {encoding :utf-8}}]
  (TextReader :stream h :decoder (atom (bytes/decoder encoding))))

(defn text-reader? "Is x a text reader?" [x] (instance? TextReader x))

(defn read-chunk
  "The next piece of text from a text reader, or nil at the end. A
  character split between reads comes whole in the next piece; a stream
  that ends partway through one signals ParseError."
  [r]
  (loop []
    (if-let [data (read (:stream r) 65536)]
      (let [[state text] (bytes/decode-chunk @(:decoder r) data)]
        (reset! (:decoder r) state)
        (if (= "" text) (recur) text))
      (do (bytes/finish-decoder @(:decoder r)) nil))))

;;; ---- temporary files and atomic replacement ----

(defn- unique-name [prefix suffix]
  (str prefix (abs (%rand-seed)) suffix))

(defn- create-unique
  "Make a path in dir with (make path) until one is new: make signals
  FileExists for a taken one."
  [dir prefix suffix make]
  (loop [tries 0]
    (let [p (path dir (unique-name prefix suffix))
          made (try (make p) p (catch FileExists e (if (< tries 100) nil (error e))))]
      (or made (recur (inc tries))))))

(defn temp-file
  "Create a new, empty file with a name no other has, in :dir (the system's
  temporary directory by default), and give its path. :prefix and :suffix
  shape the name. Delete it when done, or use with-temp-file."
  [& {:keys [dir prefix suffix] :or {prefix "norn-" suffix ".tmp"}}]
  (create-unique (or dir (sys/temp-dir)) prefix suffix (fn [p] (close (open p :create-new)))))

(defn temp-directory
  "Create a new, empty directory with a name no other has, as temp-file
  does, and give its path."
  [& {:keys [dir prefix suffix] :or {prefix "norn-" suffix ""}}]
  (create-unique (or dir (sys/temp-dir)) prefix suffix (fn [p] (%fs-mkdir p))))

(defmacro with-temp-file
  "(with-temp-file [p options…] body…): p is a new temporary file (options
  as temp-file's), deleted when body ends, however it ends."
  [[sym & opts] & body]
  `(let [~sym (temp-file ~@opts)]
     (try (do ~@body)
          (finally (when (exists? ~sym) (delete! ~sym))))))

(defmacro with-temp-directory
  "(with-temp-directory [d options…] body…): d is a new temporary directory
  (options as temp-directory's), deleted with everything in it when body
  ends, however it ends."
  [[sym & opts] & body]
  `(let [~sym (temp-directory ~@opts)]
     (try (do ~@body)
          (finally (when (exists? ~sym) (delete! ~sym :recursive true))))))

(defn call-with-atomic-file
  "Call (f h) with h a stream writing a new file beside path. When f
  returns, the file is flushed to storage and renamed over path, so readers
  see the old contents or the new, never a mix, and a crash leaves one of
  them. If f fails, path is untouched. f's result. The new file doesn't
  keep the old one's permissions."
  [path f]
  (let [path (str path)
        dir (or (parent (absolute path)) ".")
        tmp (temp-file :dir dir :prefix (str "." (file-name path) ".") :suffix ".tmp")
        done (atom false)]
    (try
      (let [result (with-open [h (open tmp :write)]
                     (let [r (f h)] (sync! h) r))]
        (rename! tmp path)
        (reset! done true)
        ;; (the rename itself is on storage once the directory is)
        (%fs-sync-dir dir)
        result)
      (finally (when (and (not @done) (exists? tmp)) (delete! tmp))))))

(defmacro with-atomic-file
  "(with-atomic-file [h path] body…): write path's new contents to h, and
  replace path with them all at once when body ends (see
  call-with-atomic-file). If body fails, path is untouched."
  [[sym path] & body]
  `(call-with-atomic-file ~path (fn [~sym] ~@body)))

(defn write-atomic!
  "Replace path's contents with data (a string, as UTF-8, or bytes) all at
  once: readers see the old file or the new one, never a mix, and a crash
  leaves one of them."
  [path data]
  (call-with-atomic-file path (fn [h] (write h data)))
  nil)

;;; ---- reconnecting after an image restore ----

(defmethod reconnect ((h Handle))
  ;; A file reopens at its path. (:write reopens as :append, so what was
  ;; written before the restore stays.)
  (let [i (handle-info h)]
    (cond (= :file (handle-kind h))
          (open (:path i) (if (= :write (:mode i)) :append (:mode i)))
          ;; Sockets: norn.net knows how (it is loaded if a socket exists).
          (and (contains? #{:tcp :tls} (handle-kind h)) (:host i))
          ((var-get (resolve 'norn.net/%reconnect)) h)
          :else (error "Don't know how to reconnect" (pr-str h)))))
