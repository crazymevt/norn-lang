;;;; norn.fmt — the one Norn code style.
;;;;
;;;; `norn fmt` rewrites files in it; `norn fmt --check` lists files that
;;;; aren't. There are no options. The style keeps your line breaks and
;;;; fixes everything else:
;;;;
;;;; - no space just inside brackets, so closing brackets join the line
;;;;   before (unless a comment ends it);
;;;; - one space between items on a line (commas stay);
;;;; - no trailing whitespace, at most one blank line in a row, and one
;;;;   newline at the end of the file;
;;;; - indentation:
;;;;   - items in [ ], { } and #{ } line up just inside the bracket;
;;;;   - a form with a body (defn, let, when, fn, deftest… any name starting
;;;;     with def or with-, and macros declaring {:indent n}, whether loaded
;;;;     or defined by a defmacro in the files being formatted) indents its
;;;;     later lines by two;
;;;;   - any other call aligns later lines with its first argument when that
;;;;     is on the head's line, and indents by one when it isn't;
;;;;   - comment lines indent like the code around them, and top-level
;;;;     comments start in column 0.
;;;;
;;;; Text inside strings is never touched. Formatting never changes the
;;;; code: the same tokens come out in the same order (same-code?).

(ns norn.fmt
  (:require [norn.string :as str]))

(def ^:private block-forms
  "Forms whose body indents by two when it starts on a new line, by how
  many arguments come before the body (cljfmt's block rule)."
  {"do" 0 "cond" 0 "try" 0 "finally" 0 "comment" 0 "lazy-seq" 0 "spawn-detached" 0 "future" 0
   "unwind-protect" 0 "case" 1 "let" 1 "let*" 1 "letrec*" 1 "loop" 1 "loop*" 1 "letfn" 1
   "binding" 1 "doseq" 1 "dotimes" 1 "for" 1 "when" 1 "when-not" 1 "when-let" 1 "when-some" 1
   "if" 1 "if-not" 1 "if-let" 1 "if-some" 1 "while" 1 "locking" 1 "testing" 1 "deftest" 1
   "ns" 1 "spawn" 1 "catch-tag" 1 "handler-case" 1 "handler-bind" 1 "restart-case" 1
   "restart-bind" 1 "with-scope" 1 "condp" 2 "catch" 2 "are" 2})

(def ^:private inner-forms
  "Forms whose later lines always indent by two."
  #{"fn" "fn*" "defmethod" "reify" "proxy" "extend"})

(def ^:dynamic *file-hints*
  "Macro name → its {:indent n}, from the defmacro forms in the files being
  formatted (read, not run)."
  {})

(defn- indent-rule
  "How a form headed by symbol text t indents: :inner, [:block n] or nil
  (align with the first argument)."
  [t]
  (let [n (let [i (str/last-index-of t "/")] (if (and i (pos? i) (< i (dec (count t)))) (subs t (inc i)) t))
        hint (or (get *file-hints* n) (get (deref %indent-hints) n))]
    (cond (some? hint) [:block hint]
          (contains? inner-forms n) :inner
          (str/starts-with? n "def") :inner
          (contains? block-forms n) [:block (get block-forms n)]
          (str/starts-with? n "with-") [:block 1]
          :else nil)))

;; ---- nodes ----------------------------------------------------------------------------------

(defmacro ^:private case-kind [n & clauses]
  (let [k (gensym "k")]
    `(let [~k (kind ~n)]
       (cond ~@(mapcat (fn [[kw body]] [`(= ~k ~kw) body]) (partition 2 (butlast clauses)))
             :else ~(last clauses)))))

(defn- kind [n] (nth n 0))
(defn- form? [n] (contains? #{:token :coll :prefix} (kind n)))

(defn- symbol-token? [n]
  (and (= :token (kind n))
       (let [t (nth n 1) c (first t)]
         (and (not (str/includes? "\"\\:#0123456789" (str c)))
              (not (and (contains? #{\- \+} c) (> (count t) 1) (str/includes? "0123456789" (str (second t)))))))))

(defn- end-col
  "The column after text t, written starting at column col."
  [t col]
  (if-let [i (str/last-index-of t "\n")] (- (count t) i 1) (+ col (count t))))

(defn- elements
  "A collection's children as elements: {:node n :nls k :space s :comma c},
  where k counts the newlines before n, s is the space just before it, and
  c says whether a comma separated it from the previous element."
  [kids]
  (loop [kids (seq kids) nls 0 sp nil comma false out []]
    (if-let [n (first kids)]
      (case-kind n
                 :newline (recur (next kids) (inc nls) nil comma out)
                 :space (recur (next kids) nls (nth n 1) (or comma (str/includes? (nth n 1) ",")) out)
                 (recur (next kids) 0 nil false (conj out {:node n :nls nls :space sp :comma comma})))
      out)))

(declare render node-text)

(defn- render-elements
  "Write elements starting at column col (the first one there). indent-fn
  gives the indentation of a new line from the elements so far. Returns
  [text end-col]."
  [els col indent-fn top?]
  (loop [i 0 els (seq els) out [] c col placed []]
    (if-let [e (first els)]
      (let [n (:node e)
            comma (if (and (pos? i) (:comma e)) "," "")
            newline? (and (pos? i) (pos? (:nls e)))
            [sep c0] (cond (zero? i) ["" c]
                           newline? (let [ind (if top? 0 (indent-fn placed))]
                                      [(str comma (if (> (:nls e) 1) "\n\n" "\n") (str/repeat-str ind " ")) ind])
                           ;; a trailing comment keeps the spaces before it (alignment)
                           (= :comment (kind n)) (let [s (str/replace (or (:space e) "") "," "")
                                                       s (if (= "" s) " " s)]
                                                   [(str comma s) (+ c (count comma) (count s))])
                           :else [(str comma " ") (+ c (count comma) 1)])
            [t c1] (render n c0)]
        (recur (inc i) (next els) (conj out sep t) c1 (conj placed {:node n :col c0 :line-start newline?})))
      [(apply str out) c placed])))

(defn- list-indent
  "The indentation of a new line in a list opened at col, given the
  elements placed so far (the new line starts the next one)."
  [col open placed]
  (let [placed (filterv (fn [p] (form? (:node p))) placed) ; comments don't count
        ;; (a leading ^hint belongs to what follows it: (^Map [a] body)
        ;; indents as ([a] body) does)
        placed (if (let [h (:node (first placed))] (and (= :prefix (kind h)) (= "^" (nth h 1))))
                 (subvec placed 1)
                 placed)
        head (:node (first placed))
        inner (+ col (count open))
        rule (when (and head (symbol-token? head)) (indent-rule (nth head 1)))
        aligned (fn []
                  (if (and (second placed) (not (:line-start (second placed))) (form? head))
                    (:col (second placed))
                    inner))]
    (cond (= rule :inner) (inc inner)
          (vector? rule)
          (let [idx (inc (second rule))]
            (cond (<= (count placed) idx) (inc inner)
                  (and (> (count placed) idx) (:line-start (nth placed idx))) (inc inner)
                  :else (aligned)))
          :else (aligned))))

(defn- render-coll [n col]
  (let [open (nth n 1) close (nth n 2)
        els (elements (nth n 3))
        inner (+ col (count open))
        indent-fn (if (contains? #{"(" "#("} open)
                    (fn [placed] (list-indent col open placed))
                    (fn [_] inner))
        [t c placed] (render-elements els inner indent-fn false)
        last-comment? (and (seq els) (= :comment (kind (:node (peek els)))))]
    (if last-comment?
      (let [ind (indent-fn placed)]
        [(str open t "\n" (str/repeat-str ind " ") close) (+ ind (count close))])
      [(str open t close) (+ c (count close))])))

(defn- render-prefix [n col]
  (let [marker (nth n 1)
        kids (nth n 2)
        tagged? (and (str/starts-with? marker "#") (> (count marker) 1) (not (contains? #{"#'" "#_"} marker)))
        form (first (filter form? kids))]
    (if (or (some (fn [k] (= :comment (kind k))) kids) (nil? form))
      (let [t (str marker (apply str (map (fn [k] (node-text k)) kids)))] [t (end-col t col)])
      (let [sep (if tagged? " " "")
            [t c] (render form (+ col (count marker) (count sep)))]
        [(str marker sep t) c]))))

(defn node-text "A syntax-tree node's original text." [n]
  (case-kind n
             :token (nth n 1)
             :space (nth n 1)
             :comment (nth n 1)
             :newline "\n"
             :prefix (str (nth n 1) (apply str (map node-text (nth n 2))))
             (str (nth n 1) (apply str (map node-text (nth n 3))) (nth n 2))))

(defn- render [n col]
  (case-kind n
             :coll (render-coll n col)
             :prefix (render-prefix n col)
             (let [t (str/trimr (nth n 1))] [t (end-col t col)])))

;; ---- the API --------------------------------------------------------------------------------

(defn parse "The syntax tree of source text s (see %read-cst)." [s] (%read-cst s))

(defn- forms-of [n] (filterv form? (nth n 3)))

(defn- indent-hint
  "The {:indent n} of a top-level (defmacro name doc? {attrs} …) node, as
  [name n], or nil."
  [node]
  (when (and (= :coll (kind node)) (= "(" (nth node 1)))
    (let [[head & more] (forms-of node)
          t (when (and head (= :token (kind head))) (nth head 1))]
      (when (and t (or (= t "defmacro") (str/ends-with? t "/defmacro")))
        (let [more (drop-while (fn [x] (= :prefix (kind x))) more) ; ^:private
              nm (first more)
              more (rest more)
              more (if (and (first more) (= :token (kind (first more))) (str/starts-with? (nth (first more) 1) "\""))
                     (rest more)
                     more)
              attrs (first more)]
          (when (and nm (= :token (kind nm)) attrs (= :coll (kind attrs)) (= "{" (nth attrs 1)))
            (let [kv (forms-of attrs)
                  i (first (keep-indexed (fn [i x] (when (and (even? i) (= :token (kind x)) (= ":indent" (nth x 1))) i)) kv))
                  v (when i (nth kv (inc i) nil))
                  n (when (and v (= :token (kind v))) (try (read-string (nth v 1)) (catch Error _ nil)))]
              (when (and (integer? n) (>= n 0)) [(nth nm 1) n]))))))))

(defn indent-hints
  "Macro name → its {:indent n}, from the top-level defmacro forms in
  source text s (read, not run)."
  [s]
  (into {} (keep indent-hint) (try (parse s) (catch Error _ []))))

(defn format-string "Source text s in the Norn style." [s]
  (let [nodes (parse s)
        els (elements nodes)]
    (binding [*file-hints* (merge *file-hints* (into {} (keep indent-hint) nodes))]
      (if (empty? els)
        ""
        (str (first (render-elements els 0 (fn [_] 0) true)) "\n")))))

(defn- tokens
  "The code of a syntax tree without layout: tokens and brackets, in order."
  [nodes]
  (mapcat (fn [n]
            (case-kind n
                       :token [(nth n 1)]
                       :coll (concat [(nth n 1)] (tokens (nth n 3)) [(nth n 2)])
                       :prefix (concat [(nth n 1)] (tokens (nth n 2)))
                       :comment [(str/trimr (nth n 1))]
                       []))
          nodes))

(defn same-code? "Do source texts a and b hold the same code and comments, laid out differently at most?" [a b]
  (= (vec (tokens (parse a))) (vec (tokens (parse b)))))

(defn formatted? "Is s already in the Norn style?" [s] (= s (format-string s)))

(defn format-file!
  "Rewrite file path in the Norn style. Returns true if it changed."
  [path]
  (let [s (slurp path) f (format-string s)]
    (when-not (same-code? s f) (error "norn fmt would change the code of" path "— a formatter bug; file left alone"))
    (if (= s f) false (do (spit path f) true))))

(defn- norn-files [p]
  (if (str/ends-with? p ".norn")
    [p]
    (vec (sort (filter (fn [f] (and (str/ends-with? f ".norn")
                                    (not (str/includes? f "/target/"))
                                    (not (str/includes? f "/.git/"))))
                       (%fs-walk p))))))

(defn main
  "`norn fmt [--check] [paths…]`: format .norn files (default: the current
  directory, recursively). With --check, change nothing: list the files
  that aren't formatted and exit 1 if there are any."
  [& args]
  (let [check (some (fn [a] (= a "--check")) args)
        paths (remove (fn [a] (= a "--check")) args)
        files (vec (mapcat norn-files (if (seq paths) paths ["."])))
        ;; (a macro defined in one of the files indents its calls in all)
        hints (into {} (mapcat (fn [f] (indent-hints (slurp f)))) files)
        bad (binding [*file-hints* hints]
              (filterv (fn [f]
                         (if check
                           (not (formatted? (slurp f)))
                           (format-file! f)))
                       files))]
    (doseq [f bad] (println (if check (str "not formatted: " f) (str "formatted " f))))
    (if (and check (seq bad)) 1 0)))
