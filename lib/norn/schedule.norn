;;;; norn.schedule — running things on a cron-like schedule (M9 part 9.12).
;;;;
;;;;   (def s (schedule "*/15 9-17 * * mon-fri" (fn [] (report!))))   ; every 15 minutes, working hours
;;;;   (next-run "0 3 * * *" (t/now))                               ; when 03:00 comes next
;;;;   (stop! s)
;;;;
;;;; An expression is five fields: minute (0-59), hour (0-23), day of the
;;;; month (1-31), month (1-12 or jan-dec) and day of the week (0-7, 0 and 7
;;;; Sunday, or sun-sat). Each is *, a number, a range a-b, a list a,b,c, and
;;;; any of them /step. As in cron, when both days are restricted, a time
;;;; matching either runs. @yearly, @monthly, @weekly, @daily and @hourly
;;;; are short for the usual ones. Times are in :zone, :utc by default
;;;; (:local, an offset in seconds, or a named zone). When a clock change
;;;; skips a time, a run due then happens at the change; when it repeats
;;;; one, the run happens once, the first time. An expression whose minute
;;;; or hour is * follows the clock instead, as in Vixie cron: it runs in
;;;; both occurrences of a repeated hour, and not in a skipped one.
;;;;
;;;; schedule runs f in a fiber of its own, each time it's due; a run that
;;;; fails is reported, and the schedule goes on. A run still going when
;;;; the next is due delays it: runs never overlap.

(ns norn.schedule (:require [norn.time :as t] [norn.string :as str]))

(def ^:private names
  {:month {"jan" 1 "feb" 2 "mar" 3 "apr" 4 "may" 5 "jun" 6 "jul" 7 "aug" 8 "sep" 9 "oct" 10 "nov" 11 "dec" 12}
   :weekday {"sun" 0 "mon" 1 "tue" 2 "wed" 3 "thu" 4 "fri" 5 "sat" 6}})

(def ^:private shorthands
  {"@yearly" "0 0 1 1 *" "@annually" "0 0 1 1 *" "@monthly" "0 0 1 * *" "@weekly" "0 0 * * 0"
   "@daily" "0 0 * * *" "@midnight" "0 0 * * *" "@hourly" "0 * * * *"})

(defn- bad [expr msg] (error ParseError :message (str "cron " (pr-str expr) ": " msg) :source "cron"))

(defn- number-in [s kind expr]
  (or (get (get names kind) (str/lower-case s))
      (parse-long s)
      (bad expr (str (pr-str s) " isn't a " (name kind) " value"))))

(defn- field-values
  "The values field text s allows, between lo and hi."
  [s kind lo hi expr]
  (into (sorted-set)
        (mapcat (fn [part]
                  (let [[range-text step-text] (str/split part #"/")
                        step (if step-text (number-in step-text kind expr) 1)
                        [a b] (cond (= range-text "*") [lo hi]
                                    (str/includes? range-text "-")
                                    (let [[x y] (str/split range-text #"-")] [(number-in x kind expr) (number-in y kind expr)])
                                    :else (let [x (number-in range-text kind expr)] [x (if step-text hi x)]))]
                    (when (or (< a lo) (> b hi) (> a b) (< step 1))
                      (bad expr (str (pr-str part) " is outside " lo "-" hi)))
                    (range a (inc b) step)))
                (str/split s #","))))

(defn parse
  "Cron expression text, parsed: {:minute :hour :day :month :weekday} (sets
  of values), which days are restricted, and whether the minute or hour is
  * (:follows-clock?, for clock changes: see next-run). Text that isn't
  one is a ParseError."
  ^Map [^String expr]
  (let [text (get shorthands (str/trim expr) (str/trim expr))
        fields (str/split text #"\s+")]
    (when-not (= 5 (count fields))
      (bad expr (str "five fields (minute hour day month weekday), not " (count fields))))
    (let [[mi h d mo wd] fields
          weekdays (set (map (fn [x] (if (= x 7) 0 x)) (field-values wd :weekday 0 7 expr)))]
      {:expr expr
       :minute (field-values mi :minute 0 59 expr)
       :hour (field-values h :hour 0 23 expr)
       :day (field-values d :day 1 31 expr)
       :month (field-values mo :month 1 12 expr)
       :weekday weekdays
       :days-restricted? (not= d "*")
       :weekdays-restricted? (not= wd "*")
       :follows-clock? (or (str/starts-with? mi "*") (str/starts-with? h "*"))})))

;; Searching works in wall-clock time, as minutes since 1970-01-01T00:00
;; in the zone (a "wall": the instant it would be if the zone were UTC),
;; then turns each matching wall into the instants it happens at there.

(defn- day-ok? [c f]
  (let [dom ((:day c) (:day f))
        dow ((:weekday c) (mod (:weekday f) 7))] ; (norn.time: 1 Monday … 7 Sunday)
    (cond (and (:days-restricted? c) (:weekdays-restricted? c)) (or dom dow)
          (:days-restricted? c) dom
          (:weekdays-restricted? c) dow
          :else true)))

(defn- wall-fields [w] (t/fields (t/of-epoch-ms (* w 60000)) :utc))
(defn- fields-wall [m] (quot (t/epoch-ms (t/from-fields m)) 60000))

(defn- next-wall
  "The first wall at or after w (minutes) that c matches, or nil past limit."
  [c w limit]
  (loop [w w]
    (let [f (wall-fields w)]
      (cond
        (> w limit) nil
        (not ((:month c) (:month f)))
        (recur (fields-wall {:year (if (= 12 (:month f)) (inc (:year f)) (:year f))
                             :month (if (= 12 (:month f)) 1 (inc (:month f))) :day 1}))
        (not (day-ok? c f)) (recur (+ (- w (mod w 1440)) 1440))
        (not ((:hour c) (:hour f))) (recur (+ (- w (mod w 60)) 60))
        (not ((:minute c) (:minute f))) (recur (inc w))
        :else w))))

(defn- offset-at
  "The zone's UTC offset in seconds at s seconds since the epoch."
  [zone s]
  (:offset (t/fields (t/of-epoch-ms (* s 1000)) zone)))

(defn- wall-instants
  "The instants (seconds since the epoch) that wall w (minutes) runs at in
  zone, and the offsets in force around it. A time that happens once runs
  then. A time a clock change skips runs once, at the change (the first
  valid time after it), and a time it repeats runs at its first
  occurrence; as in Vixie cron, an expression whose minute or hour is *
  follows the clock instead: it runs in both occurrences of a repeated
  time, and not at all in a skipped one."
  [c zone w]
  (let [s (* w 60)
        before (offset-at zone (- s 86400))
        after (offset-at zone (+ s 86400))
        ;; offsets that give back this wall, the earlier instant first
        valid (sort > (filter (fn [o] (= o (offset-at zone (- s o)))) (distinct [before after])))
        clock? (:follows-clock? c)]
    {:offsets [before after]
     :instants (cond (= 1 (count valid)) [(- s (first valid))]
                     (seq valid) (if clock? (mapv #(- s %) valid) [(- s (first valid))])
                     clock? []
                     ;; skipped: the change, the first second at the later offset
                     :else (loop [lo (- s after) hi (- s before)]
                             (if (> (- hi lo) 1)
                               (let [mid (quot (+ lo hi) 2)]
                                 (if (= before (offset-at zone mid)) (recur mid hi) (recur lo mid)))
                               [hi])))}))

(defn next-run
  "The first time after instant from (now) that cron expression c (text or
  parsed) is due. Option :zone. nil if none comes within 5 years
  (30 February…). Across a clock change, a time that's skipped runs at
  the change, and one that's repeated runs once, the first time; an
  expression whose minute or hour is * (every 15 minutes, say) follows
  the clock instead, as in Vixie cron: it runs in both occurrences of a
  repeated hour, and not in a skipped one."
  (^(? t/Instant) [^(U String Map) c] (next-run c (t/now)))
  (^(? t/Instant) [^(U String Map) c ^t/Instant from & {:keys [zone] :or {zone :utc}}]
   (let [c (if (string? c) (parse c) c)
         from-ns (t/epoch-nanos from)
         from-s (quot (t/epoch-ms from) 1000)
         ;; The wall to start from: from's own, unless the clock is about to
         ;; go back past it (then the repeated hour's).
         now-offset (offset-at zone from-s)
         day-offset (offset-at zone (+ from-s 86400))
         back? (and (< day-offset now-offset) (not= now-offset (offset-at zone (+ from-s (- now-offset day-offset)))))
         start (quot (+ from-s (if back? day-offset now-offset)) 60)
         limit (+ start (* 5 366 1440))]
     ;; Walls come in order, and so do their instants, but for one: the
     ;; second occurrence of a repeated time comes after the first
     ;; occurrences of the walls following it. So after one of those, keep
     ;; looking until no later wall can come before it.
     (loop [w (next-wall c start limit) best nil reach nil]
       (if (or (nil? w) (and reach (> w reach)))
         (when best (t/of-epoch-ms (* best 1000)))
         (let [{:keys [offsets instants]} (wall-instants c zone w)
               i (first (filter #(> (* % 1000000000) from-ns) instants))
               w' (next-wall c (inc w) limit)]
           (cond (or (nil? i) (and best (>= i best))) (recur w' best reach)
                 (not (and (= 2 (count instants)) (= i (second instants)))) (t/of-epoch-ms (* i 1000))
                 :else (recur w' i (quot (+ i (apply max offsets)) 60)))))))))

(defn next-runs "The next n times c is due after from (fewer if it stops coming)."
  ^Vector [^(U String Map) c ^t/Instant from ^Integer n & opts]
  (let [c (if (string? c) (parse c) c)]
    (vec (take n (take-while some? (rest (iterate (fn [i] (when i (apply next-run c i opts))) from)))))))

(defn- report [c e]
  (%write-stderr (str "norn.schedule: a run of " (pr-str (:expr c)) " failed: " (condition-message e) "\n")))

(defn schedule
  "Run (f) each time cron expression c is due, in a fiber of its own:
  a schedule, for stop!. Option :zone."
  ^Map [^(U String Map) c f & {:keys [zone] :or {zone :utc}}]
  (let [c (if (string? c) (parse c) c)
        runs (atom 0)
        fiber (spawn-detached
                (loop [after (t/now)]
                  (when-let [due (next-run c after :zone zone)]
                    (let [wait (- (t/epoch-ms due) (t/epoch-ms (t/now)))]
                      (when (pos? wait) (sleep wait))
                      (try (f) (catch Error e (report c e)))
                      (swap! runs inc)
                      (recur due)))))]
    {:cron c :fiber fiber :runs runs}))

(defn stop! "Stop schedule s (a run going on is cancelled)." [^Map s] (cancel! (:fiber s)) nil)

(defn runs "How many times schedule s has run." ^Integer [^Map s] @(:runs s))
