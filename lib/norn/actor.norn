;;;; norn.actor — processes and supervisors (M9 part 9.6, design §6.5).
;;;; (norn.process is for the operating system's processes.)
;;;;
;;;; A process is a fiber with a mailbox. send puts a message in it;
;;;; receive takes the first message any of its patterns (match's, 9.2)
;;;; matches, leaving the others in order, waiting until one comes (or
;;;; :after ms). A process may be registered under a name.
;;;;
;;;;   (defprocess counter [n]
;;;;     (receive
;;;;       [:inc]      (recur (inc n))
;;;;       [:get from] (do (send from n) (recur n))))
;;;;
;;;;   (def sup (supervisor {:strategy :one-for-one}
;;;;              [(child :counter counter 0)]))
;;;;   (send :counter [:inc])
;;;;
;;;; When a process ends, its reason is :normal (its function returned), the
;;;; condition it failed with (the very one, 9.13), :killed, or the reason
;;;; it was told to exit with. Processes linked to it (link!) end too,
;;;; unless they trap exits (trap-exits!): then they get [:EXIT p reason].
;;;; A normal end ends no one. A monitor (monitor) gets [:DOWN ref p reason].
;;;;
;;;; A crash is noticed by the process's outermost handler, which tells its
;;;; links and monitors, then declines: the debugger gets the condition as
;;;; for any fiber (design §5.3). At the REPL the process waits there with
;;;; its stack, while its supervisor restarts it.
;;;;
;;;; A supervisor is a process that starts its children, links to them,
;;;; and restarts them when they end: :one-for-one (that one),
;;;; :one-for-all (all of them), :rest-for-one (it and those started after
;;;; it). A child is :permanent (always restarted), :transient (only after a
;;;; crash) or :temporary (never). More than :max-restarts (3) in
;;;; :max-ms (5000) and the supervisor gives up: it ends its children and
;;;; ends itself, with reason :too-many-restarts. start-child! and
;;;; stop-child! add and remove children while it runs.

(ns norn.actor)

(defclass Process ()
  ((id :initarg :id) (fiber :initarg :fiber) (mailbox :initarg :mailbox) (signal :initarg :signal)
                     (links :initarg :links) (monitors :initarg :monitors) (trapping :initarg :trapping)
                     (reason :initarg :reason) (done :initarg :done) (name :initarg :name))
  (:doc "A process: a fiber with a mailbox, started by spawn-process or a
  supervisor. send puts a message in it; receive takes one."))

(defmethod print-object ((p Process)) (str "#<process " (:id p) (when-let [n @(:name p)] (str " " n)) ">"))

(def ^:dynamic *self* "The process this fiber is (nil outside one)." nil)

(def ^:private ids (atom 0))
(def ^:private registry "Name → process." (atom {}))

(defn process? "Is x a process?" ^Boolean [x] (instance? Process x))

(defn self
  "The process running this code (an error outside one)."
  ^Process []
  (or (when (and *self* (identical? (current-fiber) @(:fiber *self*))) *self*)
      (error "self: not inside a process (a fiber a process spawned isn't the process)")))

(defn- new-process []
  (make Process :id (swap! ids inc) :fiber (atom nil) :mailbox (atom []) :signal (chan 1 :dropping)
        :links (atom #{}) :monitors (atom {}) :trapping (atom false)
        :reason (atom nil) :done (promise) :name (atom nil)))

(defn whereis "The process registered as name, or nil." ^(? Process) [name] (get @registry name))

(defn- target [p]
  (cond (process? p) p
        :else (or (whereis p) (error (str "No process is registered as " (pr-str p))))))

(defn alive? "Is process p (or the process registered as p) still running?" ^Boolean [p]
  (let [p (if (process? p) p (whereis p))]
    (boolean (and p (nil? @(:reason p))))))

(defn exit-reason "Why process p ended: :normal, a condition, :killed…; nil while it runs." [^Process p]
  @(:reason p))

(defn await-exit
  "Wait for process p to end (at most ms, then :timeout): its reason."
  ([^Process p] @(:done p))
  ([^Process p ^Integer ms] (deref (:done p) ms :timeout)))

;; ---- messages ----

(defn send
  "Put msg in process p's mailbox (p: a process, or a registered name).
  A message to a process that has ended is dropped. msg."
  [p msg]
  (let [p (if (process? p) p (whereis p))]
    (when (and p (nil? @(:reason p)))
      (swap! (:mailbox p) conj msg)
      (offer! (:signal p) true))
    msg))

(defn- take-matching!
  "Take the first message in the mailbox that (matches? msg) is true of,
  waiting for one at most ms (nil: as long as it takes). ::timeout if
  none came."
  [p matches? ms]
  (let [deadline (when ms (+ (nano-time) (* ms 1000000)))]
    (loop []
      (let [q @(:mailbox p)
            i (first (keep-indexed (fn [i m] (when (matches? m) i)) q))]
        (if i
          (if (compare-and-set! (:mailbox p) q (into (subvec q 0 i) (subvec q (inc i))))
            (nth q i)
            (recur))
          (let [left (when deadline (quot (- deadline (nano-time)) 1000000))]
            (if (and left (<= left 0))
              ::timeout
              (let [[_ port] (alts! (if left [(:signal p) (timeout left)] [(:signal p)]))]
                (if (identical? port (:signal p)) (recur) ::timeout)))))))))

(defmacro receive
  "(receive pattern [:when guard] body… :after ms timeout-body): the first
  message in this process's mailbox a clause matches (see match), its
  body run (in tail position: recur works); messages no clause matches
  stay where they are. Waits for one, or ms then timeout-body."
  [& clauses]
  (let [[clauses after] (let [[before from] (split-with (fn [x] (not= x :after)) clauses)]
                          [before (next from)])
        ;; (each clause's pattern and guard, with its body replaced by true:
        ;; a test for whether some clause takes the message. The names are
        ;; mentioned, for lint: they're used, in the clause's body.)
        tests (loop [cs (seq clauses) out []]
                (if (nil? cs)
                  out
                  (let [[p & more] cs
                        [guard more] (if (= :when (first more)) [[:when (second more)] (nnext more)] [[] more])]
                    (recur (next more) (into out (concat [p] guard [`(do ~@(%pattern-vars p) true)]))))))
        m (gensym "msg")]
    `(let [~m (take-matching! (self) (fn [x#] (match x# ~@tests ~'_ false)) ~(first after))]
       (if (= ~m ::timeout)
         ~(second after)
         (match ~m ~@clauses)))))

;; ---- starting, links and exits ----

(declare end!)

(defn- notify!
  "Process p has ended with reason: tell its links and monitors, once.
  A linked process ends with the same reason, unless it traps exits."
  [p reason]
  (when (compare-and-set! (:reason p) nil reason)
    (when-let [n @(:name p)] (swap! registry (fn [r] (if (identical? (get r n) p) (dissoc r n) r))))
    (doseq [[ref who] @(:monitors p)] (send who [:DOWN ref p reason]))
    (doseq [q @(:links p)]
      (swap! (:links q) disj p)
      (cond @(:trapping q) (send q [:EXIT p reason])
            (not= reason :normal) (end! q reason)))
    (deliver (:done p) reason)))

(defn- end! [p reason]
  (when (nil? @(:reason p))
    (notify! p reason)
    (when-let [f @(:fiber p)] (cancel! f))))

(defn exit!
  "End process p (or the one registered as p) with reason (:killed). If p
  traps exits it gets [:EXIT from reason] instead (from: this process, or
  nil), unless reason is :kill, which always ends it (as :killed)."
  ([p] (exit! p :killed))
  ([p reason]
   (let [p (target p)]
     (cond (= reason :kill) (end! p :killed)
           @(:trapping p) (send p [:EXIT *self* reason])
           :else (end! p reason)))
   nil))

(defn spawn-process
  "Start a process running (apply f args): the process."
  ^Process [f & args]
  (let [p (new-process)
        run (fn []
              (reset! (:fiber p) (current-fiber)) ; (before anything can ask)
              (binding [*self* p]
                (try
                  ;; (an error nothing in the process handles: its end, told
                  ;; to its links and monitors; then on to the debugger. A
                  ;; fiber inherits its spawner's handlers, so a process this
                  ;; one starts would come here too: only this one's own.)
                  (let [v (handler-bind [Error (fn [c] (when (identical? (current-fiber) @(:fiber p)) (notify! p c)))]
                            (apply f args))]
                    (notify! p :normal)
                    v)
                  (finally (notify! p :killed)))))]
    (reset! (:fiber p) (spawn-detached (run)))
    p))

(defn link!
  "Link this process and p: when either ends abnormally, so does the other
  (or it hears of it, trapping exits)."
  ^Process [p]
  (let [me (self) p (target p)]
    (swap! (:links me) conj p)
    (swap! (:links p) conj me)
    (when-let [r @(:reason p)]
      (swap! (:links p) disj me)
      (cond @(:trapping me) (send me [:EXIT p r])
            (not= r :normal) (end! me r)))
    p))

(defn spawn-link "spawn-process, linked to this process." ^Process [f & args]
  (let [p (apply spawn-process f args)] (link! p) p))

(defn trap-exits!
  "From now on, a linked process's end is a message to this one,
  [:EXIT p reason], rather than its end too."
  ([] (trap-exits! true))
  ([on?] (reset! (:trapping (self)) (boolean on?)) nil))

(defn monitor
  "Watch process p: when it ends, this process gets [:DOWN ref p reason]
  (at once if it has). The ref."
  ^Symbol [p]
  (let [me (self) p (target p) ref (gensym "monitor")]
    (swap! (:monitors p) assoc ref me)
    (when-let [r @(:reason p)] (send me [:DOWN ref p r]))
    ref))

(defn register!
  "Register process p (default: this one) under name, for send, whereis and
  exit!. An error if another living process has the name."
  (^Process [name] (register! name (self)))
  (^Process [name ^Process p]
   (swap! registry (fn [r] (if (and (get r name) (alive? (get r name)) (not (identical? (get r name) p)))
                             (error (str (pr-str name) " is registered already"))
                             (assoc r name p))))
   (reset! (:name p) name)
   p))

(defmacro defprocess
  "(defprocess name [params…] body…): a process function: body runs with
  params bound, and recur runs it again with new ones (a process's state).
  Start one with spawn-process, or in a supervisor's child."
  [pname params & body]
  `(defn ~pname ~params (loop [~@(mapcat (fn [p] [p p]) params)] ~@body)))

;; ---- asking ----

(defn ask
  "Send process p (msg… reply), msg a vector with a promise added at the
  end, and wait for the process to deliver it (at most ms: 5000), from
  anywhere, in a process or not. Its value, or a TimeoutError.

    [:get reply] (do (deliver reply n) (recur n))   ; in the process
    (ask counter [:get])                            ; elsewhere"
  ([p ^Vector msg] (ask p msg 5000))
  ([p ^Vector msg ^Integer ms]
   (let [reply (promise)]
     (send p (conj msg reply))
     (let [v (deref reply ms ::no-answer)]
       (if (= v ::no-answer)
         (error TimeoutError :message (str (pr-str p) " didn't answer " (pr-str msg) " in " ms " ms") :after ms)
         v)))))

;; ---- supervisors ----

(defn child
  "A supervisor's child: (child id f args…), started as (apply f args) in a
  process registered as id when id is a keyword or symbol. Options, as a
  map before f: :restart :permanent (always restarted), :transient (after
  a crash) or :temporary (never); :shutdown-ms, how long it has to end when
  told to (5000) before it's killed.

  The child keeps f itself, so a restart calls the same function value
  even after its defn is evaluated again. Pass the var (#'store rather
  than store) for restarts to pick up a redefinition."
  ^Map [id & more]
  (let [[opts f & args] (if (map? (first more)) more (cons {} more))]
    {:id id :start (fn [] (let [p (apply spawn-process f args)]
                            (when (or (keyword? id) (symbol? id)) (register! id p))
                            p))
     :restart (or (:restart opts) :permanent)
     :shutdown-ms (or (:shutdown-ms opts) 5000)}))

(defn- start-child [spec]
  (let [p ((:start spec))]
    (link! p)
    (assoc spec :process p)))

(defn- stop-child
  "End child c: unlinked first (its end is no news), told to (:shutdown),
  waited for, and killed if it takes too long."
  [c]
  (let [me (self) p (:process c)]
    (swap! (:links me) disj p)
    (swap! (:links p) disj me)
    (when (alive? p)
      (exit! p :shutdown)
      (when (= :timeout (await-exit p (:shutdown-ms c)))
        (exit! p :kill)))))

(defn- restart? [spec reason]
  (case (:restart spec)
    :permanent true
    :transient (not= reason :normal)
    false))

(defn supervise
  "What a supervisor process runs (see supervisor): a child's function,
  for a supervisor under a supervisor, (child :id supervise opts children)."
  [^(? Map) opts ^(? Sequential) specs]
  (trap-exits!)
  (let [strategy (or (:strategy opts) :one-for-one)
        max-restarts (or (:max-restarts opts) 3)
        max-ms (or (:max-ms opts) 5000)
        ;; (the last started, the first stopped)
        stop-all (fn [children] (doseq [c (rseq children)] (stop-child c)))]
    (loop [children (reduce (fn [cs spec] (conj cs (start-child spec))) [] specs)
           restarts []]
      (receive
       [:EXIT from reason]
       (let [i (first (keep-indexed (fn [i c] (when (identical? (:process c) from) i)) children))]
         (cond
           (and (nil? i) (= reason :normal))
           (recur children restarts)

           ;; (not a child: the supervisor's own supervisor, or someone
           ;; else linked to it, has ended, or told it to)
           (nil? i)
           (do (stop-all children) (end! (self) reason))

           (not (restart? (nth children i) reason))
           (recur (into (subvec children 0 i) (subvec children (inc i))) restarts)

           :else
           (let [now (quot (nano-time) 1000000)
                 restarts (conj (vec (filter (fn [t] (> t (- now max-ms))) restarts)) now)]
             (if (> (count restarts) max-restarts)
               (do (stop-all children) (end! (self) :too-many-restarts))
               (let [again (case strategy
                             :one-for-all (vec (range (count children)))
                             :rest-for-one (vec (range i (count children)))
                             [i])]
                 (doseq [j (rseq again) :when (not= j i)] (stop-child (nth children j)))
                 ;; (in order; a :temporary one stopped stays stopped)
                 (recur (reduce (fn [cs j]
                                  (let [c (nth children j)]
                                    (cond (not (some #{j} again)) (conj cs c)
                                          (= :temporary (:restart c)) cs
                                          :else (conj cs (start-child c)))))
                                [] (range (count children)))
                        restarts))))))

       [:which-children reply]
       (do (deliver reply (mapv (fn [c] [(:id c) (:process c)]) children))
           (recur children restarts))

       [:start-child spec reply]
       (if (some (fn [c] (= (:id c) (:id spec))) children)
         (do (deliver reply [nil (str "the supervisor has a child " (pr-str (:id spec)) " already")])
             (recur children restarts))
         (let [c (try (start-child spec) (catch Error e (condition-message e)))]
           (if (string? c)
             (do (deliver reply [nil c]) (recur children restarts))
             (do (deliver reply [(:process c) nil]) (recur (conj children c) restarts)))))

       [:stop-child id reply]
       (let [i (first (keep-indexed (fn [i c] (when (= (:id c) id) i)) children))]
         (if i
           (do (stop-child (nth children i))
               (deliver reply true)
               (recur (into (subvec children 0 i) (subvec children (inc i))) restarts))
           (do (deliver reply false) (recur children restarts))))

       [:stop reply]
       (do (stop-all children) (deliver reply :stopped))))))

(defn supervisor
  "Start a supervisor of children (made with child), in order: the
  supervisor process. Options: :strategy :one-for-one (restart the child
  that ended), :one-for-all (all of them) or :rest-for-one (it and those
  after it); more than :max-restarts (3) in :max-ms (5000) and it gives up.
  A restart calls the function each child was given: a redefined function
  is used only when the child was given its var (#'store)."
  ^Process [^(? Map) opts ^(? Sequential) children]
  (spawn-process supervise opts children))

(defn which-children "Supervisor sup's children now: [[id process]…]." ^Vector [sup]
  (ask sup [:which-children]))

(defn start-child!
  "Start child spec (made with child) under supervisor sup, after its
  other children, supervised like them: its process. An error if sup has a
  child with that id, or the child can't start (its name is taken, say)."
  ^Process [^Process sup ^Map spec]
  (let [[p problem] (ask sup [:start-child spec])]
    (or p (error (str "start-child!: " problem)))))

(defn stop-child!
  "Stop supervisor sup's child id, as the supervisor stops its children
  (:shutdown, then killed after its :shutdown-ms), and forget it: it isn't
  restarted. Whether sup had a child id."
  ^Boolean [^Process sup id]
  (ask sup [:stop-child id] 60000))

(defn stop-supervisor!
  "Stop supervisor sup: its children are stopped, the last started first,
  then it ends (:normal)."
  [^Process sup]
  (ask sup [:stop] 60000)
  (await-exit sup)
  nil)

(defn run-in-process
  "(f), in a process of its own, waited for: its value (or its failure)."
  [f]
  (let [p (spawn-process f)]
    (await @(:fiber p))))
