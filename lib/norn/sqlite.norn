;;;; norn.sqlite — SQLite databases (M9 part 9.9), on norn.ffi and the
;;;; system's libsqlite3 (NORN_SQLITE names another).
;;;;
;;;;   (def db (open "app.db"))              ; or (open ":memory:")
;;;;   (execute! db "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
;;;;   (execute! db ["INSERT INTO t (name) VALUES (?)" "ada"])   ; → 1 (rows changed)
;;;;   (query db ["SELECT * FROM t WHERE id = ?" 1])            ; → [{:id 1 :name "ada"}]
;;;;   (with-transaction [db] (execute! db …) (execute! db …))
;;;;
;;;; SQL comes as a string, or a vector of it and its parameters: ? and ?N
;;;; take them in order; with a map instead (["… :name …" {:name "ada"}]),
;;;; :name, @name and $name take theirs by key. Values: nil, integers,
;;;; doubles, strings, Bytes, booleans (1 and 0) and keywords (their names).
;;;; Rows are maps, column names as keywords (or vectors: {:as :vectors});
;;;; INTEGER, REAL, TEXT, BLOB and NULL come back as integers, doubles,
;;;; strings, Bytes and nil.
;;;;
;;;; Statements are prepared once per connection and SQL, and reused. A
;;;; connection may be shared by fibers: one at a time uses it, and a
;;;; transaction keeps it for its fiber until it ends. Calls run on the
;;;; carrier (they're quick for most databases); {:blocking true} runs the
;;;; ones that do I/O on the blocking pool instead.
;;;;
;;;; Errors are DatabaseErrors (ConstraintError and BusyError among them),
;;;; with SQLite's :code and :extended-code, and the :sql.

(ns norn.sqlite
  (:refer-core :exclude [close!])
  (:require [norn.ffi :as ffi] [norn.sync :as sync] [norn.sys :as sys] [norn.string :as str])
  (:unsafe))

(defclass DatabaseError (Error) ((code :initform nil) (extended-code :initform nil) (sql :initform nil)))
(defclass ConstraintError (DatabaseError) ())
(defclass BusyError (DatabaseError) ())

(defclass Connection ()
  ((path :initarg :path) (handle :initarg :handle) (epoch :initarg :epoch) (blocking :initarg :blocking)
                         (statements :initarg :statements) (lock :initarg :lock) (owner :initarg :owner) (depth :initarg :depth)))

(defmethod print-object ((c Connection)) (str "#<sqlite " (pr-str (:path c)) (when-not @(:handle c) " closed") ">"))

;; ---- the C library ----

(defn- library-path []
  (or (sys/getenv "NORN_SQLITE")
      (if (= (sys/os) :macos) "/usr/lib/libsqlite3.dylib" "libsqlite3.so.0")))

(def ^:private lib
  (try (ffi/library (library-path))
       (catch Error e
         (error (str "Can't load SQLite (" (library-path) "): install it, or set NORN_SQLITE to its library. "
                     (condition-message e))))))

(ffi/defcfun c-open lib "sqlite3_open_v2" [path :string out :pointer flags :int vfs :pointer] :int)
(ffi/defcfun c-close lib "sqlite3_close_v2" [db :pointer] :int)
(ffi/defcfun c-extended-codes lib "sqlite3_extended_result_codes" [db :pointer on :int] :int)
(ffi/defcfun c-busy-timeout lib "sqlite3_busy_timeout" [db :pointer ms :int] :int)
(ffi/defcfun c-errmsg lib "sqlite3_errmsg" [db :pointer] :string)
(ffi/defcfun c-errstr lib "sqlite3_errstr" [code :int] :string)
(ffi/defcfun c-extended-errcode lib "sqlite3_extended_errcode" [db :pointer] :int)
(ffi/defcfun c-prepare lib "sqlite3_prepare_v2" [db :pointer sql :pointer n :int out :pointer tail :pointer] :int)
(ffi/defcfun c-step lib "sqlite3_step" [stmt :pointer] :int)
(ffi/defcfun c-step-blocking lib "sqlite3_step" [stmt :pointer] :int :blocking true)
(ffi/defcfun c-reset lib "sqlite3_reset" [stmt :pointer] :int)
(ffi/defcfun c-clear-bindings lib "sqlite3_clear_bindings" [stmt :pointer] :int)
(ffi/defcfun c-finalize lib "sqlite3_finalize" [stmt :pointer] :int)
(ffi/defcfun c-bind-null lib "sqlite3_bind_null" [stmt :pointer i :int] :int)
(ffi/defcfun c-bind-int64 lib "sqlite3_bind_int64" [stmt :pointer i :int v :i64] :int)
(ffi/defcfun c-bind-double lib "sqlite3_bind_double" [stmt :pointer i :int v :double] :int)
(ffi/defcfun c-bind-text lib "sqlite3_bind_text" [stmt :pointer i :int v :bytes n :int destructor :pointer] :int)
(ffi/defcfun c-bind-blob lib "sqlite3_bind_blob" [stmt :pointer i :int v :bytes n :int destructor :pointer] :int)
(ffi/defcfun c-param-count lib "sqlite3_bind_parameter_count" [stmt :pointer] :int)
(ffi/defcfun c-param-name lib "sqlite3_bind_parameter_name" [stmt :pointer i :int] :string)
(ffi/defcfun c-column-count lib "sqlite3_column_count" [stmt :pointer] :int)
(ffi/defcfun c-column-name lib "sqlite3_column_name" [stmt :pointer i :int] :string)
(ffi/defcfun c-column-type lib "sqlite3_column_type" [stmt :pointer i :int] :int)
(ffi/defcfun c-column-int64 lib "sqlite3_column_int64" [stmt :pointer i :int] :i64)
(ffi/defcfun c-column-double lib "sqlite3_column_double" [stmt :pointer i :int] :double)
(ffi/defcfun c-column-text lib "sqlite3_column_text" [stmt :pointer i :int] :pointer)
(ffi/defcfun c-column-blob lib "sqlite3_column_blob" [stmt :pointer i :int] :pointer)
(ffi/defcfun c-column-bytes lib "sqlite3_column_bytes" [stmt :pointer i :int] :int)
(ffi/defcfun c-changes lib "sqlite3_changes64" [db :pointer] :i64)
(ffi/defcfun c-last-insert-rowid lib "sqlite3_last_insert_rowid" [db :pointer] :i64)
(ffi/defcfun c-exec lib "sqlite3_exec" [db :pointer sql :string cb :pointer arg :pointer err :pointer] :int)
(ffi/defcfun c-exec-blocking lib "sqlite3_exec" [db :pointer sql :string cb :pointer arg :pointer err :pointer] :int :blocking true)
(ffi/defcfun c-libversion lib "sqlite3_libversion" [] :string)
(ffi/defcfun c-autocommit lib "sqlite3_get_autocommit" [db :pointer] :int)

(def ^:private OK 0)
(def ^:private ROW 100)
(def ^:private DONE 101)
;; (SQLITE_OPEN_READONLY 1, READWRITE 2, CREATE 4, URI 0x40, FULLMUTEX 0x10000)
(def ^:private TRANSIENT "SQLITE_TRANSIENT: SQLite copies the value." 18446744073709551615)

(defn version "The SQLite library's version." [] (c-libversion))

;; ---- errors ----

(defn- fail! [db-ptr code sql]
  (let [ext (if db-ptr (c-extended-errcode db-ptr) code)
        msg (if db-ptr (c-errmsg db-ptr) (c-errstr code))
        cls (case (bit-and code 255) 19 ConstraintError 5 BusyError 6 BusyError DatabaseError)]
    (error cls :message (str msg (when sql (str " (in: " sql ")"))) :code (bit-and code 255) :extended-code ext :sql sql)))

(defn- check! [db-ptr code sql]
  (when-not (= code OK) (fail! db-ptr code sql))
  code)

;; ---- connections ----

(defn- handle!
  "Connection c's database pointer: an error once it's closed, or after an
  image restore (the process it was open in is gone)."
  [c]
  (let [h @(:handle c)]
    (cond (nil? h) (error DatabaseError :message (str "The connection to " (:path c) " is closed"))
          (not (%handle-current? (:epoch c))) (error DatabaseError :message (str "The connection to " (:path c) " didn't survive the image restore: open it again"))
          :else h)))

(defn open
  "Open (creating) the database at path, or \":memory:\". Options:
  :readonly, :create (true), :busy-timeout ms to wait for another
  connection's lock (5000), :blocking (I/O on the blocking pool)."
  [path & {:keys [readonly create busy-timeout blocking] :or {create true busy-timeout 5000}}]
  (ffi/with-alloc [out :pointer]
    (let [flags (bit-or (if readonly 1 (bit-or 2 (if create 4 0))) 0x40 0x10000)
          rc (c-open (str path) out flags nil)
          db (ffi/mem-get out :pointer)]
      (when-not (= rc OK)
        (let [msg (if (and db (pos? db)) (c-errmsg db) (c-errstr rc))]
          (when (and db (pos? db)) (c-close db))
          (error DatabaseError :message (str "Can't open " path ": " msg) :code rc)))
      (c-extended-codes db 1)
      (c-busy-timeout db busy-timeout)
      (make Connection :path (str path) :handle (atom db) :epoch @(:cell lib) :blocking (if blocking true false)
            :statements (atom {}) :lock (sync/semaphore 1) :owner (atom nil) :depth (atom 0)))))

(defn- with-connection-lock
  "(f), holding connection c (again, if this fiber holds it already)."
  [c f]
  (if (identical? @(:owner c) (current-fiber))
    (f)
    (do (sync/acquire! (:lock c))
        (reset! (:owner c) (current-fiber))
        (try (f)
             (finally (reset! (:owner c) nil) (sync/release! (:lock c)))))))

(defn close!
  "Close connection c (its prepared statements too). Closing it again does
  nothing."
  [c]
  (with-connection-lock c
    (fn []
      (when-let [h @(:handle c)]
        (when (%handle-current? (:epoch c))
          (doseq [[_ s] @(:statements c)] (c-finalize s))
          (c-close h))
        (reset! (:statements c) {})
        (reset! (:handle c) nil))
      nil)))

(defmacro with-connection
  "(with-connection [name path & options] body…): name is a connection
  open while body runs, then closed."
  [[n path & opts] & body]
  `(let [~n (open ~path ~@opts)]
     (try ~@body (finally (close! ~n)))))

(defn open? "Is connection c open?" [c] (some? @(:handle c)))

;; ---- statements ----

(def ^:private max-cached 64)

(defn- prepare!
  "A prepared statement for sql on c: cached by its text."
  [c sql]
  (or (get @(:statements c) sql)
      (let [h (handle! c)
            b (bytes sql)
            text (ffi/alloc (inc (count b)))]
        (try
          (ffi/write-bytes! text b)
          (ffi/with-alloc [outs 16]
            (check! h (c-prepare h text (count b) outs (+ outs 8)) sql)
            (let [stmt (ffi/mem-get outs :pointer)
                  tail (ffi/mem-get outs :pointer 8)
                  rest (when (and tail (pos? tail)) (str/trim (ffi/string-at tail)))]
              (when (or (nil? stmt) (zero? stmt))
                (error DatabaseError :message (str "No statement in: " (pr-str sql)) :sql sql))
              (when (seq rest)
                (c-finalize stmt)
                (error DatabaseError :message (str "One statement at a time (exec! runs several): " (pr-str sql)) :sql sql))
              (when (>= (count @(:statements c)) max-cached)
                (let [[k s] (first @(:statements c))] (c-finalize s) (swap! (:statements c) dissoc k)))
              (swap! (:statements c) assoc sql stmt)
              stmt))
          (finally (ffi/free! text))))))

(defn- bind! [h stmt sql i v]
  (let [rc (cond (nil? v) (c-bind-null stmt i)
                 (integer? v) (c-bind-int64 stmt i v)
                 (float? v) (c-bind-double stmt i v)
                 (string? v) (let [b (bytes v)] (c-bind-text stmt i b (count b) TRANSIENT))
                 (bytes? v) (c-bind-blob stmt i v (count v) TRANSIENT)
                 (true? v) (c-bind-int64 stmt i 1)
                 (false? v) (c-bind-int64 stmt i 0)
                 (keyword? v) (let [b (bytes (name v))] (c-bind-text stmt i b (count b) TRANSIENT))
                 (number? v) (c-bind-double stmt i (double v))
                 :else (error DatabaseError :message (str "Can't store " (pr-str v) " in SQLite") :sql sql))]
    (check! h rc sql)))

(defn- bind-all! [h stmt sql params]
  (let [n (c-param-count stmt)]
    (if (map? params)
      (doseq [i (range 1 (inc n))]
        (let [pname (c-param-name stmt i)
              k (when pname (keyword (subs pname 1)))]
          (when-not (and k (contains? params k))
            (error DatabaseError :message (str "No value for parameter " (or pname (str "?" i))) :sql sql))
          (bind! h stmt sql i (get params k))))
      (do (when-not (= n (count params))
            (error DatabaseError :message (str "The statement takes " n " parameters, given " (count params)) :sql sql))
          (doseq [[i v] (map vector (range 1 (inc n)) params)] (bind! h stmt sql i v))))))

(defn- column [stmt i]
  (case (c-column-type stmt i)
    1 (c-column-int64 stmt i)
    2 (c-column-double stmt i)
    3 (let [n (c-column-bytes stmt i) p (c-column-text stmt i)]
        (if (zero? n) "" (bytes->string (ffi/bytes-at p n) true)))
    4 (let [n (c-column-bytes stmt i)] (if (zero? n) (bytes []) (ffi/bytes-at (c-column-blob stmt i) n)))
    nil))

(defn- split-sql [q]
  (cond (string? q) [q []]
        (vector? q) [(first q) (if (map? (second q)) (second q) (vec (rest q)))]
        :else (error (str "SQL is a string, or a vector of it and its parameters: " (pr-str q)))))

(defn- run-statement!
  "Run q on c: (on-row stmt names) for each row; the rows changed."
  [c q on-row]
  (with-connection-lock c
    (fn []
      (let [[sql params] (split-sql q)
            h (handle! c)
            stmt (prepare! c sql)
            step (if (:blocking c) c-step-blocking c-step)]
        (try
          (bind-all! h stmt sql params)
          (let [n (c-column-count stmt)
                names (mapv (fn [i] (keyword (c-column-name stmt i))) (range n))]
            (loop []
              (let [rc (step stmt)]
                (cond (= rc ROW) (do (on-row stmt names) (recur))
                      (= rc DONE) (c-changes h)
                      :else (fail! h rc sql)))))
          (finally (c-reset stmt) (c-clear-bindings stmt)))))))

;; ---- queries ----

(defn query
  "The rows q (SQL, or [SQL params…]) gives, as maps of column keywords
  to values (or, {:as :vectors}, as vectors in column order)."
  ([c q] (query c q nil))
  ([c q opts]
   (let [rows (volatile! (transient []))
         vectors? (= :vectors (:as opts))]
     (run-statement! c q (fn [stmt names]
                           (let [n (count names)
                                 row (if vectors?
                                       (loop [i 0 r (transient [])] (if (< i n) (recur (inc i) (conj! r (column stmt i))) (persistent! r)))
                                       (loop [i 0 r (transient {})] (if (< i n) (recur (inc i) (assoc! r (nth names i) (column stmt i))) (persistent! r))))]
                             (vswap! rows conj! row))))
     (persistent! @rows))))

(defn query-one "The first row q gives (a map), or nil." ([c q] (first (query c q))) ([c q opts] (first (query c q opts))))

(defn execute!
  "Run q, a statement giving no rows (INSERT, UPDATE, CREATE…): the number
  of rows it changed."
  [c q]
  (run-statement! c q (fn [_ _] nil)))

(defn exec!
  "Run a script: several statements, no parameters."
  [c sql]
  (with-connection-lock c
    (fn [] (let [h (handle! c)] (check! h ((if (:blocking c) c-exec-blocking c-exec) h sql nil nil nil) sql) nil))))

(defn last-insert-id "The rowid of the last row inserted on c." [c] (c-last-insert-rowid (handle! c)))

(defn in-transaction? "Is c in a transaction?" [c] (zero? (c-autocommit (handle! c))))

;; ---- transactions ----

(defn transact
  "(f) in a transaction on c: committed if it returns, rolled back if it
  fails. Inside another, a savepoint: rolled back alone. Options: :mode
  :deferred (the default), :immediate or :exclusive. f's value."
  ([c f] (transact c f nil))
  ([c f opts]
   (with-connection-lock c
     (fn []
       (let [depth (swap! (:depth c) inc)
             sp (str "norn_sp_" depth)]
         (try
           (if (= depth 1)
             (exec! c (str "BEGIN " (str/upper-case (name (or (:mode opts) :deferred)))))
             (exec! c (str "SAVEPOINT " sp)))
           (let [v (try (f)
                        (catch Error e
                          (if (= depth 1)
                            (when (in-transaction? c) (exec! c "ROLLBACK"))
                            (exec! c (str "ROLLBACK TO " sp "; RELEASE " sp)))
                          (throw e)))]
             (exec! c (if (= depth 1) "COMMIT" (str "RELEASE " sp)))
             v)
           (finally (swap! (:depth c) dec))))))))

(defmacro with-transaction
  "(with-transaction [c & options] body…): body in a transaction on c (see
  transact)."
  [[c & opts] & body]
  `(transact ~c (fn [] ~@body) ~(apply hash-map opts)))

(defn tables "The names of c's tables." [c]
  (mapv :name (query c "SELECT name FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name")))
