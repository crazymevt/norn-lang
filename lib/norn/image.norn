;;;; norn.image — looking at images: `norn image info` and `norn image diff`.

(ns norn.image
  (:require [norn.string :as str] [norn.io :as io]))

(defn summary
  "The running image's namespaces, each a map of var name → value hash."
  []
  (:namespaces (%image-summary)))

(defn info-text
  "A description of an image, its file(s), sizes and contents: the running
  one's, or, given one, an image's summary (as a process started from it
  gives: norn image info asks)."
  ([] (info-text (%image-summary)))
  ([summary]
   (let [s (into (sorted-map) (:namespaces summary))
         chain (:chain summary)]
     (str "image:      " (:image summary) "\n"
          (when (> (count chain) 1)
            (str "layers:     " (str/join " ← " chain) "\n"))
          "size:       " (str/join " + " (map (fn [p] (str (:size (io/info p)) " bytes")) chain)) "\n"
          "entry:      " (or (:entry summary) "none") "\n"
          "namespaces: " (count s) "\n"
          "vars:       " (reduce + 0 (map count (vals s))) "\n"
          (apply str (map (fn [[n vs]] (format "  %-28s %5d vars%n" n (count vs))) s))))))

(defn diff-text
  "What changed from summary a to summary b: namespaces and vars added,
  removed or changed. A module's instances at other phases (norn.io$1 and
  the like, which come and go with the macros a build expands) are left
  out."
  [a b]
  (let [lines (atom [])
        out (fn [& xs] (swap! lines conj (apply str xs)))]
    (doseq [n (sort (into (set (keys a)) (keys b)))
            :when (zero? (%ns-shift (symbol n)))]
      (let [va (get a n) vb (get b n)]
        (cond (nil? va) (out "+ namespace " n " (" (count vb) (if (= 1 (count vb)) " var)" " vars)"))
              (nil? vb) (out "- namespace " n " (" (count va) (if (= 1 (count va)) " var)" " vars)"))
              :else (doseq [k (sort (into (set (keys va)) (keys vb)))]
                      (cond (not (contains? va k)) (out "+ " n "/" k)
                            (not (contains? vb k)) (out "- " n "/" k)
                            (not= (get va k) (get vb k)) (out "~ " n "/" k))))))
    (if (empty? (deref lines)) "no differences\n" (str (str/join "\n" (deref lines)) "\n"))))
