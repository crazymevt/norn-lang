;;;; norn.edn — Norn data as text: the reader's syntax without evaluation.
;;;;
;;;; read-string reads one value and never runs code: it only builds data
;;;; (lists, vectors, maps, sets, strings, numbers, characters, keywords,
;;;; symbols, nil and booleans; #bytes and ##Inf too). write-string is pr-str:
;;;; what it writes, read-string reads back as an equal value.

(ns norn.edn
  (:refer-core :exclude [read-string]))

(defn read-string
  "The first value in s; nil (or :eof's value) when s holds none."
  [s & {:keys [eof]}]
  (let [r (%reader s "<edn>")
        v (%read r)]
    (if (%eof? v) eof v)))

(defn read-all "Every value in s, as a vector." [s]
  (let [r (%reader s "<edn>")]
    (loop [out []]
      (let [v (%read r)] (if (%eof? v) out (recur (conj out v)))))))

(defn write-string "Text that read-string reads back as an equal value." [x] (pr-str x))
