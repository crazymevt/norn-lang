;;;; norn.edn — Norn data as text: the reader's syntax without evaluation.
;;;;
;;;; read-string reads one value and never runs code: it only builds data
;;;; (lists, vectors, maps, sets, queues, strings, numbers, characters,
;;;; keywords, symbols, nil and booleans; #bytes, regexes and ##Inf too).
;;;; write-string writes those, and what it writes read-string reads back as
;;;; an equal value; anything else (an atom, a function, an instance such as
;;;; a Decimal or a time) signals TypeError. pr-str prints anything.

(ns norn.edn
  (:refer-core :exclude [read-string]))

(defn read-string
  "The first value in s; nil (or :eof's value) when s holds none."
  [^String s & {:keys [eof]}]
  (let [r (%reader s "<edn>")
        v (%read r)]
    (if (%eof? v) eof v)))

(defn read-all "Every value in s, as a vector." ^Vector [^String s]
  (let [r (%reader s "<edn>")]
    (loop [out []]
      (let [v (%read r)] (if (%eof? v) out (recur (conj out v)))))))

(defn- check-failed [x]
  (error TypeError :expected "a value with an EDN form" :value x
         :message (str "No EDN form for " (pr-str x) " (a " (class-name (class-of x)) ")")))

(defn- check
  "Signal TypeError, naming it, for the first value in x that has no EDN
  form."
  [x]
  (cond (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (char? x) (bytes? x) (regex? x)) nil
        (%instance? x) (check-failed x)
        (number? x) nil
        (map? x) (doseq [[k v] x] (check k) (check v))
        (or (vector? x) (set? x) (list? x) (seq? x) (stream? x) (queue? x)) (doseq [v x] (check v))
        :else (check-failed x)))

(defn write-string
  "Text that read-string reads back as an equal value: x, made of the
  values read-string makes. Anything else in it (an atom, a function, an
  instance) signals TypeError naming it; pr-str prints those."
  ^String [x]
  (check x)
  (pr-str x))
