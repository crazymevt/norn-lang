;;;; norn.run — `norn run ARGS…`: the project's :main, called with ARGS, as
;;;; a built image calls it: an integer result is the exit status.

(ns norn.run
  (:require [norn.deps :as deps]))

(defn main
  "Call the :main of the project here (this folder's or the nearest above
  with a norn.edn) with args: the exit status (2 when there's no project or
  :main)."
  [& args]
  (if-let [dir (deps/find-project ".")]
    (if-let [entry (deps/load-main! dir)]
      (let [r (apply (var-get (resolve (symbol entry))) args)]
        (if (integer? r) r 0))
      (do (println (str "norn run: " dir "/norn.edn has no :main (the entry function, as my.app/main)")) 2))
    (do (println "norn run: no norn.edn here or in a folder above") 2)))
