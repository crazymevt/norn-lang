;;;; norn.expand — the macro stepper (M8 part 8.9).
;;;;
;;;; (macro-steps form) expands form fully, recording each macro step as the
;;;; expander takes it, outermost first: the call, what it became, and the
;;;; names the macro introduced. A hygienic macro's names carry its
;;;; introduction scope, so they're exactly the ones that scope marks; a
;;;; defmacro's are the names in its result that its arguments didn't hold
;;;; (by name, as data: a name it introduces that the call also wrote, as
;;;; aif's `it`, isn't listed).
;;;; In the full expansion, locals that share a name are numbered (t#1, t#2):
;;;; the expander renamed them apart, and that's what keeps hygiene.
;;;;
;;;; At the REPL, (macro-steps '(…)) prints the steps; from the command line,
;;;; `norn expand [--steps] FILE | -e EXPR`; for an editor, the op
;;;; :expand-steps (expand-steps-for-editor).

(ns norn.expand
  (:require [norn.syntax :as syn] [norn.string :as str] [norn.pprint :as pp] [norn.io :as io]))

(defn- as-syntax [form] (if (syn/syntax? form) form (syn/datum->syntax nil form)))

(defn- identifiers
  "The identifiers in syntax s, in order."
  [s]
  (if-not (syn/syntax? s)
    []
    (let [e (syn/syntax-e s)]
      (cond (symbol? e) [s]
            (or (seq? e) (vector? e) (set? e)) (vec (mapcat identifiers e))
            (map? e) (vec (mapcat identifiers (mapcat identity e)))
            :else []))))

(defn- symbols-of [d]
  (cond (symbol? d) [d]
        (map? d) (mapcat symbols-of (mapcat identity d))
        (coll? d) (mapcat symbols-of d)
        :else []))

(defn- introduced
  "The names a step introduced: for a hygienic macro, the identifiers its
  scope marks; for a defmacro, those its arguments didn't hold."
  [out intro before after]
  (vec (distinct (if intro
                   (keep (fn [i] (when (contains? (syn/syntax-scopes i) intro) (syn/syntax-e i))) (identifiers out))
                   (let [given (set (symbols-of (rest before)))]
                     (remove given (symbols-of after)))))))

(defn- uninterned? [x] (and (symbol? x) (nil? (namespace x)) (not (identical? x (symbol (name x))))))

(defn- walk [f x]
  (cond (seq? x) (apply list (map f x))
        (vector? x) (mapv f x)
        (map? x) (into {} (map (fn [[k v]] [(f k) (f v)])) x)
        (set? x) (into #{} (map f) x)
        :else x))

(defn- renamed
  "Expanded form with locals that share a name numbered apart (t#1, t#2),
  and those renames."
  [form]
  (let [locals (atom [])
        _ ((fn collect [x]
             (cond (uninterned? x) (when-not (some (fn [l] (identical? l x)) @locals) (swap! locals conj x))
                   (coll? x) (walk collect x)
                   :else nil))
           form)
        groups (filter (fn [g] (> (count g) 1)) (vals (group-by name @locals)))
        names (vec (for [g groups [i l] (map-indexed vector g)] [l (symbol (str (name l) "#" (inc i)))]))
        rename (fn rename [x]
                 (cond (symbol? x) (or (some (fn [[l n]] (when (identical? l x) n)) names) x)
                       ;; (a hygienic template's syntax, as the quote-syntax it came from)
                       (and (seq? x) (= 'quote (first x)) (syn/syntax? (second x)))
                       (list 'quote-syntax (syn/syntax->datum (second x)))
                       (syn/syntax? x) (list 'quote-syntax (syn/syntax->datum x))
                       (coll? x) (walk rename x)
                       :else x))]
    [(rename form)
     (vec (for [g groups] {:local (symbol (name (first g))) :as (mapv (fn [l] (rename l)) g)}))]))

(defn macro-steps
  "Form (data or syntax) expanded fully, a macro step at a time, in the
  current namespace: {:steps [{:macro :hygienic :where :before :after
  :introduced :scope}…] :expanded :renames}. :scope is a hygienic step's
  introduction scope."
  [form]
  (let [steps (atom [])
        hook (fn [v s out intro]
               (let [before (syn/syntax->datum s)
                     after (syn/syntax->datum out)]
                 (swap! steps conj {:macro (symbol (%var-name v)) :hygienic (some? intro)
                                    :where (when (syn/syntax-loc s) (syn/syntax-where s))
                                    :before before :after after
                                    :introduced (introduced out intro before after)
                                    :scope intro})))
        expanded (binding [norn.expander/*on-step* hook] (norn.expander/expand-all (as-syntax form)))
        [expanded renames] (renamed expanded)]
    {:steps @steps :expanded expanded :renames renames}))

;; ---- as text ----

(defn- form-text [d indent]
  (str/join (str "\n" indent) (str/split-lines (pp/pprint-str d (- 100 (count indent))))))

(defn steps-text
  "macro-steps' result r as text."
  [r]
  (str/join "\n"
            (concat
             (map-indexed
              (fn [i st]
                (str (inc i) ". " (:macro st) (if (:hygienic st) " (hygienic)" " (defmacro)")
                     (when (:where st) (str " at " (:where st))) "\n"
                     "   " (form-text (:before st) "   ") "\n"
                     "=> " (form-text (:after st) "   ")
                     (when (seq (:introduced st))
                       (str "\n   introduced" (when (:scope st) (str " (scope " (:scope st) ")")) ": "
                            (str/join " " (map str (:introduced st)))))))
              (:steps r))
             [(str (if (empty? (:steps r)) "No macro steps.\n" "")
                   "Fully expanded:\n   " (form-text (:expanded r) "   ")
                   (apply str (map (fn [{:keys [local as]}]
                                     (str "\n   " (str/join ", " (map str as)) ": different locals, each written " local))
                                   (:renames r))))])))

;; ---- for an editor ----

(defn expand-steps-for-editor
  "The :expand-steps op: code's steps in namespace ns, with forms as text."
  [code ns]
  (in-ns (symbol (or ns "user")))
  (let [r (macro-steps (first (syn/read-all-syntax code "<editor>")))]
    {:steps (mapv (fn [st] (-> st
                               (update :macro str)
                               (update :before pr-str)
                               (update :after pr-str)
                               (update :introduced (fn [xs] (mapv str xs)))))
                  (:steps r))
     :expanded (pr-str (:expanded r))
     :renames (mapv (fn [{:keys [local as]}] {:local (str local) :as (mapv str as)}) (:renames r))
     :text (steps-text r)}))

;; ---- the command line ----

(defn- expand-forms
  "Each form of text (from src): its steps or full expansion printed, then
  (if run?) evaluated, so the forms after it see what it defines. A
  module's names are declared first, as loading it does."
  [text src steps? run?]
  (let [forms (syn/read-all-syntax text src)
        d0 (when (seq forms) (syn/syntax->datum (first forms)))
        module? (and (seq? d0) (= 'ns (first d0)) (symbol? (second d0)))
        ok (atom true)]
    (binding [norn.expander/*strict* module?]
      (doseq [[i s] (map-indexed vector forms)]
        (println (str ";; " (syn/syntax-where s)))
        (when (and (try (let [r (macro-steps s)]
                          (println (if steps? (steps-text r) (form-text (:expanded r) "")))
                          true)
                        (catch Error e
                          (reset! ok false)
                          (println (str ";; can't expand it: " (condition-message e)))
                          false))
                   run?)
          (try (norn.expander/eval s)
               (when (and module? (zero? i)) (norn.expander/%declare-module! text src d0))
               (catch Error e
                 (println (str ";; (running it failed: " (condition-message e) ")")))))
        (println)))
    @ok))

(defn main
  "`norn expand [--steps] FILE | -e EXPR`: each top-level form's full
  expansion, or with --steps every macro step on the way. A file's forms
  are each run after they're shown, as loading it would, so later forms see
  their definitions and macros; an expression is only expanded."
  [& args]
  (let [steps? (some (fn [a] (= a "--steps")) args)
        args (vec (remove (fn [a] (= a "--steps")) args))
        [text src] (cond (and (= "-e" (first args)) (second args)) [(second args) "<expr>"]
                         (= 1 (count args)) [(io/read-text (first args)) (first args)]
                         :else nil)]
    (if (nil? text)
      (do (println "usage: norn expand [--steps] FILE | -e EXPR") 2)
      (if (expand-forms text src steps? (not= src "<expr>")) 0 1))))
