;;;; CBOR data interchange, RFC 8949.

(ns norn.cbor
  (:require [norn.bytes :as b] [norn.decimal :as decimal] [norn.io :as io] [norn.math :as math]))

(defclass Tagged () ((tag :required true) (value :required true)))
(defclass Simple () ((code :required true)))

(def ^:private max-uint 18446744073709551615)
(def ^:private max-depth 256)

(defn tagged "A tagged CBOR item. Tags 2, 3 and 4 have native Norn representations." ^Tagged [^Integer tag value]
  (when-not (and (integer? tag) (<= 0 tag max-uint)) (error "Invalid CBOR tag" tag))
  (Tagged :tag tag :value value))

(defn simple "A CBOR simple value other than a boolean or null. Code 23 is undefined." ^Simple [^Integer code]
  (when-not (and (integer? code) (or (<= 0 code 19) (= code 23) (<= 32 code 255)))
    (error "Invalid CBOR simple code" code))
  (Simple :code code))

(defn- fail! [st why]
  (error ParseError :source "CBOR" :message (str "CBOR at byte " @(:pos st) ": " why)))

(defn- take-range! [{:keys [pos data] :as st} n]
  (let [start @pos end (+ start n)]
    (when (> end (count data)) (fail! st "truncated item"))
    (vreset! pos end)
    start))

(defn- byte! [st] (nth (:data st) (take-range! st 1)))

(defn- argument! [st info]
  (cond (< info 24) info
        (<= 24 info 27) (let [width (bit-shift-left 1 (- info 24))]
                          (b/read-uint (:data st) (take-range! st width) width :be))
        :else (fail! st "invalid additional information")))

(defn- length! [st info units]
  (let [n (argument! st info)]
    (when (> (* units n) (- (count (:data st)) @(:pos st))) (fail! st "truncated item"))
    n))

(defn- take-bytes! [st length]
  (let [start (take-range! st length)] (b/slice (:data st) start (+ start length))))

(defn- take-text! [st length]
  (try (bytes->string (take-bytes! st length))
       (catch ParseError e (error e))
       (catch Error _ (fail! st "invalid UTF-8 text"))))

(defn- break! [st]
  (when (= 255 (nth (:data st) @(:pos st) nil)) (byte! st) true))

(defn- read-string! [st major info]
  (let [read-chunk (if (= major 2) take-bytes! take-text!)]
    (if (= info 31)
      (loop [parts []]
        (if (break! st)
          (apply (if (= major 2) bytes-concat str) parts)
          (let [head (byte! st) info (mod head 32)]
            (when (or (= info 31) (not= major (quot head 32)))
              (fail! st "indefinite string requires definite chunks of its own type"))
            (recur (conj parts (read-chunk st (length! st info 1)))))))
      (read-chunk st (length! st info 1)))))

(defn- half-float [bits]
  (let [sign (if (>= bits 0x8000) -1.0 1.0)
        exponent (mod (quot bits 1024) 32) fraction (mod bits 1024)]
    (* sign (cond (= exponent 31) (if (zero? fraction) ##Inf ##NaN)
                  (zero? exponent) (* fraction (math/expt 2 -24))
                  :else (* (+ 1024 fraction) (math/expt 2 (- exponent 25)))))))

(defn- read-simple! [st info]
  (case info
    20 false 21 true 22 nil 23 (simple 23)
    24 (let [code (byte! st)]
         (when (< code 32) (fail! st "invalid two-byte simple value"))
         (simple code))
    25 (half-float (b/read-uint (:data st) (take-range! st 2) 2 :be))
    26 (b/read-float (:data st) (take-range! st 4) 4 :be)
    27 (b/read-float (:data st) (take-range! st 8) 8 :be)
    (if (< info 20) (simple info) (fail! st "unexpected break or reserved simple value"))))

(declare item!)

(defn- array! [st info depth]
  (let [n (when (not= info 31) (length! st info 1))]
    (loop [i 0 out (transient [])]
      (if (if n (= i n) (break! st)) (persistent! out)
          (recur (inc i) (conj! out (item! st depth)))))))

(defn- map! [st info depth]
  (let [n (when (not= info 31) (length! st info 2))]
    (loop [i 0 out {}]
      (if (if n (= i n) (break! st)) out
          (let [key (item! st depth)]
            (when (contains? out key) (fail! st "duplicate map key"))
            (recur (inc i) (assoc out key (item! st depth))))))))

(defn- tag! [st tag depth]
  (let [value (item! st depth)]
    (cond
      (contains? #{2 3} tag)
      (do (when-not (bytes? value) (fail! st "bignum tag requires bytes"))
          (let [n (b/read-uint value 0 (count value) :be)] (if (= tag 2) n (- -1 n))))
      (= tag 4)
      (do (when-not (and (vector? value) (= 2 (count value)) (every? integer? value))
            (fail! st "decimal tag requires an integer exponent and mantissa"))
          (decimal/decimal (second value) (- (first value))))
      :else (tagged tag value))))

(defn- item! [st depth]
  (when (> depth max-depth) (fail! st "item nests deeper than 256 levels"))
  (let [head (byte! st) info (mod head 32)]
    (case (quot head 32)
      0 (argument! st info)
      1 (- -1 (argument! st info))
      2 (read-string! st 2 info)
      3 (read-string! st 3 info)
      4 (array! st info (inc depth))
      5 (map! st info (inc depth))
      6 (tag! st (argument! st info) (inc depth))
      7 (read-simple! st info))))

(defn decode "Decode exactly one CBOR item from Bytes (ParseError if they aren't CBOR)." [data]
  (when-not (bytes? data) (error TypeError :expected "Bytes" :value data :message (str "CBOR decode expects Bytes, got " (pr-str data))))
  (let [st {:data data :pos (volatile! 0)} value (item! st 0)]
    (when (< @(:pos st) (count data)) (fail! st "trailing bytes"))
    value))

(defn- header [major n]
  (when-not (and (integer? n) (<= 0 n max-uint)) (error "CBOR argument outside uint64 range" n))
  (let [base (* 32 major)]
    (if (< n 24) (bytes [(+ base n)])
        (let [[info width] (cond (<= n 255) [24 1] (<= n 65535) [25 2]
                                 (<= n 4294967295) [26 4] :else [27 8])]
          (bytes-concat (bytes [(+ base info)]) (b/uint-bytes n width :be))))))

(defn- magnitude [n]
  (loop [left n out ()]
    (if (zero? left) (bytes out) (recur (quot left 256) (cons (mod left 256) out)))))

(declare emit!)

(defn- encode-integer! [out x]
  (let [negative? (neg? x) n (if negative? (- -1 x) x)]
    (if (<= n max-uint) (conj! out (header (if negative? 1 0) n))
        (let [data (magnitude n)]
          (conj! out (header 6 (if negative? 3 2)))
          (conj! out (header 2 (count data)))
          (conj! out data)))))

(defn- emit! [out x depth]
  (when (> depth max-depth) (error "CBOR item nests deeper than 256 levels"))
  (let [deeper (inc depth)]
    (cond
      (nil? x) (conj! out (bytes [246]))
      (true? x) (conj! out (bytes [245]))
      (false? x) (conj! out (bytes [244]))
      (integer? x) (encode-integer! out x)
      (float? x) (do (conj! out (bytes [251])) (conj! out (b/float-bytes x 8 :be)))
      (or (string? x) (bytes? x))
      (let [text? (string? x) data (if text? (bytes x) x)]
        (conj! out (header (if text? 3 2) (count data)))
        (conj! out data))
      (map? x) (do (conj! out (header 5 (count x)))
                   (doseq [[k value] x] (emit! out k deeper) (emit! out value deeper)))
      (sequential? x) (do (conj! out (header 4 (count x)))
                          (doseq [value x] (emit! out value deeper)))
      (decimal/decimal? x) (do (conj! out (header 6 4))
                               (emit! out [(- (:scale x)) (:coefficient x)] deeper))
      (instance? Tagged x) (do (conj! out (header 6 (:tag x))) (emit! out (:value x) deeper))
      (instance? Simple x) (let [code (:code (simple (:code x)))]
                             (conj! out (bytes (if (< code 24) [(+ 224 code)] [248 code]))))
      :else (error TypeError :expected "a value CBOR can encode" :value x
                   :message (str "CBOR can't encode " (pr-str x))))))

(defn encode
  "Encode one CBOR item as Bytes. Maps may have any encodable key. Floats
  use binary64. The output does not impose deterministic map ordering. A
  value CBOR has no form for signals TypeError."
  ^Bytes [x]
  (let [out (transient [])]
    (emit! out x 0)
    (apply bytes-concat (persistent! out))))

(defn read-file "Decode one CBOR item from a file." [^String path] (decode (io/read-bytes path)))
(defn write-file "Write one CBOR item to a file." [^String path x] (io/write-bytes path (encode x)))
