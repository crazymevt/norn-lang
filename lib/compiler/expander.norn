;;;; norn.expander — the hygienic macro expander (M8 part 8.2; design §8.2).
;;;;
;;;; It takes syntax (norn.syntax) and gives the compiler the kernel forms
;;;; (quote if do def var fn* let* letrec* loop* recur) with every name
;;;; resolved, using Racket's sets of scopes:
;;;;
;;;; - Each binding form adds a fresh scope to what it binds over, and
;;;;   records each name it binds, with its scopes, in the expansion's
;;;;   binding table. A name refers to the binding whose scopes are the
;;;;   largest subset of its own; of two with the same scopes, the later
;;;;   one (so (let* [x 1 x (inc x)] x) works as in Clojure).
;;;; - A local becomes an uninterned symbol with the user's name: the
;;;;   compiler matches locals by identity, so a macro's `t` and the user's
;;;;   `t` stay apart, and the debugger still shows `t`.
;;;; - A name with no local binding is a global, looked up in the namespace
;;;;   whose scope it carries: a hygienic macro's template means what it
;;;;   meant where the macro was defined. Code read in a namespace carries
;;;;   that namespace's scope.
;;;; - A macro defined with defmacro gets plain data, as it always has, and
;;;;   its result takes the call's scopes and place, so the 83 macros of the
;;;;   standard library mean what they meant. One defined with defsyntax
;;;;   gets syntax: a fresh scope is added to its input, and flipped on its
;;;;   output, so what the macro introduced is told from what it was given.
;;;;
;;;; The REPL's top level is permissive (design §8.2): a top-level do is
;;;; evaluated form by form, so a macro defined in it applies to the forms
;;;; after it.

(ns norn.expander
  (:refer-core :exclude [eval])
  (:require [norn.syntax :as syn]))

(defclass ExpandError (norn.compiler/CompileError) ())

(defn- fail [s & msg]
  (error ExpandError :message (str (when (and (syn/syntax? s) (syn/syntax-loc s)) (str (syn/syntax-where s) ": "))
                                   (apply %message msg))))

(def ^:private specials '#{quote if do def var fn* let* letrec* loop* recur quote-syntax for-syntax})

;; ---- namespaces' scopes ----

(def ^:dynamic *ns-sym* "The current namespace's name, while expanding a form." nil)

(defn- ns-sym [] (or *ns-sym* (symbol (str (current-ns)))))

;; (outside expansion — running a form, loading a module — it's the current
;; namespace: a module can load while another form is expanding, as when a
;; macro's first use loads its library)
(defn- current-ns-sym [] (symbol (str (current-ns))))

(def ^:private ns-scopes "Namespace name → its scope." (atom {}))
(def ^:private scope-nss "Scope → its namespace's name." (atom {}))

(defn ns-scope
  "The scope of the code read in namespace ns (a symbol)."
  [ns]
  (or (get @ns-scopes ns)
      (let [sc (syn/new-scope)]
        (swap! ns-scopes assoc ns sc)
        (swap! scope-nss assoc sc ns)
        sc)))

(def ^:private access-scopes "Namespace name → its access scope." (atom {}))
(def ^:private access-set "Every access scope (they don't take part in binding)." (atom #{}))

(defn access-scope
  "The scope that lets code reach namespace ns's private vars without
  changing where its names resolve: a defmacro macro's result carries its
  namespace's, so its expansion may call the namespace's private helpers."
  [ns]
  (or (get @access-scopes ns)
      (let [sc (syn/new-scope)]
        (swap! access-scopes assoc ns sc)
        (swap! access-set conj sc)
        sc)))

(defn- home-ns
  "The namespace whose scope identifier id carries (the current one when
  it carries none)."
  [id]
  (let [m @scope-nss]
    (or (some (fn [sc] (get m sc)) (syn/syntax-scopes id)) (ns-sym))))

;; ---- phases (8.5) ----

(def ^:dynamic *phase*
  "How many phases up the code being expanded is: 0 for run time, 1 inside
  (for-syntax …) (a macro's code), and so on."
  0)

(def ^:dynamic *strict*
  "True while loading a module: compile-time code must find its names at
  compile time. Elsewhere (the REPL, scripts) the top level is permissive:
  a name missing one phase up is taken from run time."
  false)

(defn- phase-home
  "The namespace identifier id's names resolve in at the current phase:
  its home namespace's instance that many phases up."
  [id]
  (let [h (home-ns id)]
    (if (zero? *phase*)
      h
      (let [up (%shifted (%base-ns h) (+ (%ns-shift h) *phase*))]
        (%ensure-ns up)
        up))))

(defn- shift-qualified
  "Qualified symbol sym as identifier id means it at the current phase: a
  namespace written out in full is that phase's instance (an alias already
  names one)."
  [id sym]
  (let [e (+ (%ns-shift (home-ns id)) *phase*)
        nsp (symbol (namespace sym))]
    (if (or (zero? e) (contains? (ns-aliases (phase-home id)) nsp))
      sym
      (symbol (str (%shifted nsp e)) (name sym)))))

(defn- lookup
  "The var identifier id (symbol sym) names at the current phase, or nil."
  [id sym]
  (or (%resolve-in (phase-home id) (if (namespace sym) (shift-qualified id sym) sym))
      (let [home (home-ns id)]
        (when (pos? (+ (%ns-shift home) *phase*))
          ;; a name from the language itself (norn.core, norn.syntax…: one
          ;; instance for every phase) means the same at every phase, however
          ;; the module required it; anything else only at the REPL,
          ;; permissively
          (when-let [v (%resolve-in (%base-ns home) sym)]
            (when (or (and (pos? *phase*) (not *strict*)) (contains? %shared-nss (namespace (symbol (%var-name v)))))
              v))))))

;; ---- bindings ----

(def ^:dynamic *bindings*
  "This expansion's binding table: name → [[scopes binding]…], latest last."
  nil)

(defn- bind!
  "Record that identifier id binds to b."
  [id b]
  ;; (without access scopes, which only grant access to private vars)
  (let [ss (let [a @access-set] (into #{} (remove (fn [sc] (contains? a sc))) (syn/syntax-scopes id)))]
    (swap! *bindings* update (syn/syntax-e id) (fn [bs] (conj (or bs []) [ss b])))))

(defn- subset? [a b] (every? (fn [x] (contains? b x)) a))

(defn resolve-local
  "The local binding identifier id refers to, or nil."
  [id]
  (let [sym (syn/syntax-e id)]
    (when (and *bindings* (nil? (namespace sym)))
      (let [ss (syn/syntax-scopes id)
            cands (filter (fn [c] (subset? (first c) ss)) (get @*bindings* sym))]
        (when (seq cands)
          (let [best (reduce (fn [a c] (if (>= (count (first c)) (count (first a))) c a)) cands)]
            (when (some (fn [c] (and (not (subset? (first c) (first best))))) cands)
              (fail id "Ambiguous name:" (pr-str sym) "(it could refer to more than one binding)"))
            (second best)))))))

(defn- resolve-global
  "The var identifier id names, looked up in its home namespace."
  [id]
  (lookup id (syn/syntax-e id)))

(defn- special-form
  "The kernel form identifier id names (unless a local binding takes the
  name), as a string, or nil."
  [id]
  (let [sym (syn/syntax-e id)]
    (when (and (contains? specials sym) (nil? (resolve-local id)))
      (name sym))))

(defn- var-ns-of [v] (symbol (namespace (symbol (%var-name v)))))

(defn- check-access
  "An error if global identifier id (sym, at home in namespace home) names
  another namespace's private var, unless it carries that namespace's
  access scope."
  ([id sym home] (when-let [v (lookup id sym)] (check-access id sym home v)))
  ([id sym home v]
   (when (private? v)
     (let [owner (var-ns-of v)]
       (when-not (or (= owner home) (contains? (syn/syntax-scopes id) (get @access-scopes owner)))
         (fail id (%var-name v) "is private to" (str owner)))))))

;; ---- contracts at module boundaries (M9 parts 9.3, 9.4) ----
;;
;; A function with a contract (its signature, or defcontract: a private
;; var name%contract beside it) is called from another namespace through a
;; wrapper that checks it: the expander names the wrapper, a private var
;; in the calling namespace (one per function and namespace), in the
;; function's place. Its def is run before the form that first needs it.

(def ^:dynamic *wrappers*
  "While a top-level form expands: an atom of the wrapper defs it needs,
  run before it (nil: none are made, as for expansion tools)."
  nil)

(defn- contracted?
  "Does var v have a contract to check? (a flag on the var: this is asked
  of every reference to another namespace's var)"
  [v]
  (%contracted? v))

(defn- wrapper-for
  "The name, in the current namespace, of the function that checks var
  v's contract when this namespace calls it (queuing its def), or nil."
  [v]
  (when (and *wrappers* (zero? *phase*) (not= norn.core/*check-contracts* :none) (contracted? v))
    (let [n (%var-name v)
          here (ns-sym)
          w (symbol (str (apply str (map (fn [c] (if (= c \/) "%" (str c))) n)) "%checked"))]
      (when-not (or (some? (%bound-value (symbol (str here) (str w))))
                    (some (fn [d] (= w (second (second d)))) @*wrappers*))
        (let [loc (or (%location) "")
              file (let [i (%str-index loc ":" nil false)] (if i (subs loc 0 i) loc))
              caller (str here (when (seq file) (str " (" file ")")))]
          (%intern here w)
          (swap! *wrappers* conj
                 (list 'do (list 'def w (list 'norn.core/%wrap-for (list 'var (symbol n)) caller))
                       (list 'norn.core/%set-private! (list 'var w))))))
      w)))

(defn- check-unsafe
  "An error if var v is part of the raw FFI and this module didn't say
  (:unsafe) in its ns (M9 part 9.8)."
  [id v]
  (when (and (%unsafe? v) (zero? *phase*) (not (contains? @norn.core/%unsafe-namespaces (ns-sym))))
    (fail id (%var-name v) "is unsafe (it can crash the process): only a module that says (:unsafe) in its ns may use it")))

(defn- global-ref
  "What the compiler should see for global identifier id: the symbol as
  written when its home is the current namespace, else the var's full
  name (or, for a function with a contract, its checking wrapper)."
  ([id] (global-ref id true))
  ([id check?]
   (let [sym (syn/syntax-e id)
         home (phase-home id)]
     (when (and check? (namespace sym)) (check-access id sym home))
     (cond (and (zero? *phase*) (= home (ns-sym))
                (or (zero? (%ns-shift home)) (%resolve-in home sym)))
           ;; (written here: as written, unless it names a function with a
           ;; contract from elsewhere, or anywhere when checking :all)
           (or (when *wrappers*
                 (when-let [v (%resolve-in home sym)]
                   (check-unsafe id v)
                   ;; (the flag first: most vars have no contract)
                   (when (and (%contracted? v)
                              (or (not= (str (var-ns-of v)) (str home)) (= norn.core/*check-contracts* :all)))
                     (wrapper-for v))))
               sym)
           :else (if-let [v (lookup id sym)]
                   (do (when check? (check-access id sym home v))
                       (check-unsafe id v)
                       (or (when (and (%contracted? v) (not= (str (var-ns-of v)) (str (ns-sym)))) (wrapper-for v))
                           (symbol (%var-name v))))
                   (if (and *strict* (pos? *phase*))
                     (fail id (str sym) "isn't available at compile time here: define it inside"
                           "begin-for-syntax, or require its module with :require-for-syntax")
                     sym))))))

(defn- free-id=? [a b]
  (let [la (resolve-local a) lb (resolve-local b)]
    (cond (or la lb) (identical? la lb)
          :else (let [ga (resolve-global a) gb (resolve-global b)]
                  (if (or ga gb)
                    (identical? ga gb)
                    (= (syn/syntax-e a) (syn/syntax-e b)))))))

(syn/%set-free-identifier=! free-id=?)

;; ---- expansion ----

(declare expand)

(defn- expand-body [ss] (doall (map expand ss)))

(defn- parts
  "The parts of list or vector syntax s (an error if it isn't one)."
  [s what]
  (let [x (syn/syntax-e s)]
    (if (or (seq? x) (vector? x)) (vec x) (fail s what))))

(defn- local-sym [id] (%uninterned-symbol (name (syn/syntax-e id))))

(defn- check-binder [id what]
  (let [x (syn/syntax-e id)]
    (when-not (and (symbol? x) (nil? (namespace x)))
      (fail id (str "Bad binding form in " what ":") (pr-str (syn/syntax->datum id))))))

(defn- expand-params
  "Bind parameter vector syntax ps (its scope added already); the
  parameters for the compiler."
  [ps]
  (mapv (fn [p]
          (if (= '& (syn/syntax-e p))
            '&
            (do (check-binder p "fn*")
                (let [u (local-sym p)] (bind! p {:local u}) u))))
        (parts ps "fn* requires a parameter vector")))

(def ^:dynamic *signatures*
  "While a top-level form expands: an atom of the types its defn calls
  wrote, by [namespace name] defined (defn hands fn data, which drops
  them)."
  nil)

(def ^:dynamic *fn-signature*
  "While a def's value expands: an atom, ::none until the first fn* in it
  records its arities' types there (M9 part 9.3)."
  nil)

(defn- tag-of [x] (let [p (syn/syntax-props x)] (when (map? p) (get p :tag))))

(defn- arity-signature
  "Parameter vector syntax ps's types: {:args [type…] :rest type :result
  type :variadic bool} (nil where none is written)."
  [ps]
  (let [elems (vec (syn/syntax-e ps))
        amp (first (keep-indexed (fn [i p] (when (= '& (syn/syntax-e p)) i)) elems))
        fixed (if amp (subvec elems 0 amp) elems)]
    {:args (mapv tag-of fixed) :rest (when amp (tag-of (nth elems (inc amp) nil))) :result (tag-of ps)
     :variadic (some? amp) :nfixed (count fixed)}))

(defn- record-signature! [ps-list]
  (when (and *fn-signature* (= ::none @*fn-signature*))
    (reset! *fn-signature* (mapv arity-signature ps-list))))

(defn- expand-fn
  "(fn* name? [params] body…) or (fn* name? ([params] body…)…)."
  [xs]
  (let [sc (syn/new-scope)
        xs (mapv (fn [x] (syn/add-scope x sc)) xs)
        named (syn/identifier? (nth xs 1 nil))
        self (when named (let [u (local-sym (nth xs 1))] (bind! (nth xs 1) {:local u}) u))
        rst (subvec xs (if named 2 1))
        arity (fn [ps body]
                (let [ac (syn/new-scope)
                      ps (syn/add-scope ps ac)
                      body (map (fn [b] (syn/add-scope b ac)) body)
                      params (expand-params ps)]
                  (apply list params (expand-body body))))]
    (when (empty? rst) (fail (first xs) "fn* requires a parameter vector"))
    (record-signature! (if (vector? (syn/syntax-e (first rst)))
                         [(first rst)]
                         (keep (fn [sig] (let [e (syn/syntax-e sig)] (when (and (seq? e) (seq e)) (first e)))) rst)))
    (let [arities (if (vector? (syn/syntax-e (first rst)))
                    [(arity (first rst) (rest rst))]
                    (mapv (fn [sig]
                            (let [s (parts sig "fn* arity must look like ([params] body...)")]
                              (when-not (and (seq? (syn/syntax-e sig)) (seq s) (vector? (syn/syntax-e (first s))))
                                (fail sig "fn* arity must look like ([params] body...)"))
                              (arity (first s) (rest s))))
                          rst))]
      (apply list 'fn* (concat (when named [self])
                               (if (vector? (syn/syntax-e (first rst)))
                                 (let [[ps & body] (first arities)] (cons ps body))
                                 arities))))))

(defn- binding-pairs [s what]
  (let [bv (parts s (str what " requires a vector for its bindings"))]
    (when-not (vector? (syn/syntax-e s)) (fail s what "requires a vector for its bindings"))
    (when (odd? (count bv)) (fail s what "requires an even number of forms in its binding vector"))
    (partition 2 bv)))

(defn- expand-let
  "let* and loop*: each binding sees the ones before it."
  [head xs]
  (let [what (name head)
        sc (syn/new-scope)
        [_ bv & body] (mapv (fn [x] (syn/add-scope x sc)) xs)
        out (reduce (fn [acc [id init]]
                      (check-binder id what)
                      (let [e (expand init)
                            u (local-sym id)]
                        (bind! id {:local u})
                        (conj acc u e)))
                    [] (binding-pairs bv what))]
    (apply list head out (expand-body body))))

(defn- expand-letrec [xs]
  (let [sc (syn/new-scope)
        [_ bv & body] (mapv (fn [x] (syn/add-scope x sc)) xs)
        pairs (binding-pairs bv "letrec*")
        us (mapv (fn [[id _]] (check-binder id "letrec*") (let [u (local-sym id)] (bind! id {:local u}) u)) pairs)
        inits (mapv (fn [[_ init]] (expand init)) pairs)]
    (apply list 'letrec* (vec (interleave us inits)) (expand-body body))))

(defn- expand-core [form s xs]
  (case form
    "quote" (do (when (not= 2 (count xs)) (fail s "quote takes exactly one argument"))
                (list 'quote (syn/syntax->datum (nth xs 1))))
    "quote-syntax" (do (when (not= 2 (count xs)) (fail s "quote-syntax takes exactly one argument"))
                       (list 'quote (nth xs 1)))
    "if" (apply list 'if (expand-body (rest xs)))
    "do" (apply list 'do (expand-body (rest xs)))
    "def" (let [id (nth xs 1 nil)]
            (when-not (and id (syn/identifier? id)) (fail s "First argument to def must be a symbol"))
            (let [sig (atom ::none)
                  value (fn [x] (binding [*fn-signature* (when (zero? *phase*) sig)] (expand x)))
                  init (case (count xs)
                         2 nil
                         3 [(value (nth xs 2))]
                         4 (if (string? (syn/syntax-e (nth xs 2)))
                             [(syn/syntax-e (nth xs 2)) (value (nth xs 3))]
                             (fail s "Too many arguments to def"))
                         (fail s "Too many arguments to def"))
                  nm (syn/syntax-e id)
                  d (apply list 'def nm init)
                  ;; (a function whose parameters or result say their types:
                  ;; its contract, beside it, checked from other modules)
                  ;; (what defn's call wrote, if it was a defn; else what fn's,
                  ;; or fn*'s, did)
                  sigs (or (when *signatures* (get @*signatures* [(ns-sym) nm])) (when (vector? @sig) @sig))
                  f (last init)
                  typed (and (vector? sigs) (seq? f) (= 'fn* (first f))
                             (some (fn [a] (or (some some? (:args a)) (:rest a) (:result a))) sigs))
                  was (when (zero? *phase*) (%resolve-in (ns-sym) nm))
                  extra (concat (when (syn/syntax-property id :private)
                                  [(list 'norn.core/%set-private! (list 'var nm))])
                                ;; (redefined without its types: no contract now)
                                (when (and (not typed) was (%contracted? was) (= (str (var-ns-of was)) (str (ns-sym))))
                                  [(list 'norn.core/%drop-contract! (list 'var nm))])
                                (when typed
                                  (let [c (symbol (str (name nm) "%contract"))]
                                    [(list 'def c (list 'norn.core/%signature-parts (list 'quote sigs) (list 'quote (ns-sym)) (str (ns-sym) "/" nm)))
                                     (list 'norn.core/%set-private! (list 'var c))])))]
              (if (seq extra) (apply list 'do d extra) d)))
    "var" (let [id (nth xs 1 nil)]
            (when-not (and id (syn/identifier? id)) (fail s "var takes a symbol"))
            ;; (#'other/private reaches a private var, as in Clojure: on purpose)
            (list 'var (global-ref id false)))
    "fn*" (expand-fn xs)
    "let*" (expand-let 'let* xs)
    "loop*" (expand-let 'loop* xs)
    "letrec*" (expand-letrec xs)
    "recur" (apply list 'recur (expand-body (rest xs)))
    "for-syntax" (do (when (not= 2 (count xs)) (fail s "for-syntax takes exactly one argument"))
                     (binding [*phase* (inc *phase*)] (expand (nth xs 1))))))

(defn- transformer? [x] (instance? syn/Transformer x))

(defn- compound? [x] (or (seq? x) (vector? x) (map? x) (set? x)))

(def ^:dynamic *datums*
  "This expansion's cache of syntax as data: identity hash of a syntax
  object's raw parts → [[parts datum]…]. A syntax object's data doesn't
  depend on its scopes, and adding scopes keeps the same raw parts, so a
  subtree converted for one macro is a lookup for the next."
  nil)

(defn- rebuild [e f]
  (cond (seq? e) (apply list (map f e))
        (vector? e) (mapv f e)
        (map? e) (into {} (map (fn [[k v]] [(f k) (f v)])) e)
        :else (into #{} (map f) e)))

(defn- raw-datum
  "Syntax x as data (cached for this expansion)."
  [x]
  (if (syn/syntax? x)
    (let [e (syn/%raw-e x)]
      (if (syn/%raw? x)
        e
        (if (compound? e)
          (let [h (%identity-hash e)]
            (or (some (fn [[k d]] (when (identical? k e) d)) (get @*datums* h))
                (let [d (rebuild e raw-datum)]
                  (swap! *datums* update h conj [e d])
                  d)))
          e)))
    x))

(declare precise-step)

(defn- datum-step
  "A defmacro macro m's expansion of call s. It gets the arguments as
  data. The parts of its result that are the very data it was given go back
  to being the syntax they came from, keeping their scopes and places (for
  the arguments and the two levels inside them, which is where macros take
  what they keep); the rest takes the call's."
  [m s access]
  (let [args (rest (syn/syntax-e s))
        scopes (syn/syntax-scopes s)]
    (syn/add-scope
     (if (every? (fn [a] (and (or (syn/%raw? a) (not (compound? (syn/%raw-e a))))
                              (= scopes (syn/syntax-scopes a))))
                 args)
       ;; the usual case: plain data with the call's scopes, in and out
       ;; (what the result keeps of the arguments keeps their places)
       (syn/%raw-syntax-from (apply m (map syn/%raw-e args)) scopes (syn/syntax-loc s)
                             (filterv syn/%raw? args))
       (precise-step m s args))
     access)))

(defn- precise-step
  "datum-step for arguments that aren't all plain data with the call's
  scopes: what the macro keeps goes back to being the syntax it was."
  [m s args]
  (binding [*datums* (or *datums* (atom {}))]
    (let [seen (atom {})
          ;; (a symbol is the same object wherever it's written, so it can't
          ;; be traced by identity: a name in the result goes back to the
          ;; identifier the arguments wrote it as, when they wrote it with
          ;; one set of scopes — a defsyntax template that hands a datum
          ;; macro the user's x and its own (let …) mustn't lose x's scopes)
          ids (atom {})
          record (fn record [x ops depth]
                   ;; x's data, noting which syntax (and which pending scope
                   ;; changes not yet made to it) it came from
                   (let [d (raw-datum x)]
                     (when (and (syn/syntax? x) (symbol? d) (not (syn/%raw? x)))
                       (swap! ids update d conj (if (seq ops) (syn/%change-scopes x ops) x)))
                     (when (and (syn/syntax? x) (compound? (syn/%raw-e x)))
                       (swap! seen update (%identity-hash d) conj [d x ops])
                       ;; (a raw object's parts have its scopes: nothing to note)
                       (when (and (< depth 2) (not (syn/%raw? x)))
                         (let [ops (into ops (or (syn/%pending x) []))
                               e (syn/%raw-e x)]
                           (doseq [c (if (map? e) (mapcat identity e) e)]
                             (record c ops (inc depth))))))
                     d))
          args (mapv (fn [a] (record a [] 0)) args)
          result (apply m args)
          known @seen
          names @ids
          back (fn back [x]
                 (cond (syn/syntax? x) x
                       (symbol? x)
                       (let [cands (get names x)]
                         (if (and (seq cands)
                                  (let [ss (syn/syntax-scopes (first cands))]
                                    (every? (fn [c] (= ss (syn/syntax-scopes c))) cands)))
                           (first cands)
                           (syn/datum->syntax s x)))
                       (compound? x)
                       (if-let [[_ stx ops] (some (fn [k] (when (identical? (first k) x) k)) (get known (%identity-hash x)))]
                         (if (seq ops) (syn/%change-scopes stx ops) stx)
                         (syn/datum->syntax s (rebuild x back)))
                       :else (syn/datum->syntax s x)))]
      (back result))))

;; ---- checking core forms' shapes (8.3) ----
;;
;; norn.validate checks calls of the core forms people most often get wrong
;; (let, fn, defn…) with syntax-parse before their macros run, so a malformed
;; one is an error saying what was expected, where. It's loaded the first
;; time a macro expands (so through the module cache), not at boot.

(def ^:private validators (atom nil))
(def ^:private loading-validators "The fiber loading them, or nil." (atom nil))

(def ^:dynamic *on-step*
  "While the macro stepper watches an expansion (M8 part 8.9): called with
  each macro step's var, call, result and introduction scope (nil for a
  defmacro's step), in the order they happen."
  nil)

(defn- validator-for [v]
  (when (and (nil? @validators) (%find-lib "norn.validate"))
    (cond (compare-and-set! loading-validators nil (current-fiber))
          (try (binding [*on-step* nil] (require 'norn.validate))
               (reset! validators (var-get (%resolve-in 'norn.validate 'validators)))
               (finally (reset! loading-validators nil)))
          ;; (norn.validate's own macros, as it loads: unchecked)
          (identical? @loading-validators (current-fiber)) nil
          ;; (another fiber is loading them: wait for it, rather than
          ;; expand unchecked meanwhile)
          :else (loop [] (when (and (nil? @validators) @loading-validators) (yield) (recur)))))
  (when-let [vs @validators] (get vs (%var-name v))))

(defn- apply-macro
  "Macro call s's expansion, and the introduction scope it used (or nil).
  While the macro runs, norn.core/*macro-place* is where the call is."
  [v s]
  (when-let [check (validator-for v)] (check s))
  (let [m (var-get v)]
    (binding [norn.core/*macro-place* (syn/syntax-loc s)]
      ;; (a macro's own error passes through as it is: its condition and
      ;; restarts are what a handler or the debugger should see)
      (if (transformer? m)
        (let [intro (syn/new-scope)
              out ((slot-value m :f) (syn/add-scope s intro))]
          (when-not (syn/syntax? out)
            (fail s "The macro" (pr-str v) "returned" (pr-str out) "where syntax was expected"))
          [(syn/flip-scope out intro) intro])
        [(datum-step m s (access-scope (var-ns-of v))) nil]))))

(def ^:private fn-macro "norn.core/fn: its calls' parameter vectors carry their types." (%resolve-in 'norn.core 'fn))
(def ^:private defn-macro "norn.core/defn, likewise." (%resolve-in 'norn.core 'defn))

(defn- fn-param-vectors
  "The parameter vectors of a (fn name? [params] body…) or (defn name
  doc? attrs? [params] body…) call s, or their ([params] body…) arities."
  [s]
  (let [xs (rest (vec (syn/syntax-e s)))
        xs (if (and (seq xs) (syn/identifier? (first xs))) (rest xs) xs)
        xs (if (and (seq xs) (string? (syn/syntax-e (first xs)))) (rest xs) xs)
        xs (if (and (seq xs) (map? (syn/syntax-e (first xs)))) (rest xs) xs)]
    (if (and (seq xs) (vector? (syn/syntax-e (first xs))))
      [(first xs)]
      (keep (fn [a] (let [e (syn/syntax-e a)] (when (and (seq? e) (seq e) (vector? (syn/syntax-e (first e)))) (first e)))) xs))))

(defn- macro-step
  "The expansion of macro call s, whose head names macro var v."
  [v s]
  ;; (fn rebuilds its parameter vectors, dropping what's written on them:
  ;; a def's signature is read from the call, M9 part 9.3)
  (when (and *fn-signature* (= ::none @*fn-signature*) (identical? v fn-macro))
    (record-signature! (fn-param-vectors s)))
  (when (and *signatures* (identical? v defn-macro))
    (let [nm (nth (vec (syn/syntax-e s)) 1 nil)]
      (when (and nm (syn/identifier? nm))
        ;; (keyed by namespace too: a module loaded while this form expands,
        ;; by a macro say, shares the table and may define the same name)
        (swap! *signatures* assoc [(ns-sym) (syn/syntax-e nm)] (mapv arity-signature (fn-param-vectors s))))))
  (if-let [hook *on-step*]
    ;; (what the macro's own code expands, as it runs, isn't a step of this
    ;; expansion)
    (let [[out intro] (binding [*on-step* nil] (apply-macro v s))]
      (hook v s out intro)
      out)
    (first (apply-macro v s))))

(def ^:private pending-macros
  "The vars of the macros the modules loading now define further down
  (declared, not yet defined)."
  (atom #{}))

(defn- check-not-later-macro
  "An error if call head h names var v, which its module declares as a
  macro defined further down (defmacro or defsyntax) and which isn't
  defined yet: compiled now, the call would be a function call, giving the
  macro's expansion as data at run time."
  [h v]
  (when (and (contains? @pending-macros v)
             (not (macro? v))
             (nil? (%bound-value (symbol (%var-name v)))))
    (fail h (%var-name v) "is a macro defined further down this module, and a macro must be defined"
          "before its first use: move its definition above this form")))

(defn- macro-of
  "The macro var a call's head names, or nil."
  [h]
  (when (and (syn/identifier? h) (nil? (resolve-local h)) (nil? (special-form h)))
    (let [v (resolve-global h)]
      (when (and v (macro? v)) v))))

(defn expand
  "Syntax s, fully expanded: kernel forms and calls, for the compiler."
  [s]
  (let [x (syn/syntax-e s)]
    (cond (symbol? x)
          (if-let [b (resolve-local s)]
            (:local b)
            (global-ref s))
          (seq? x)
          (if (empty? x)
            ()
            (let [xs (vec x)
                  h (first xs)
                  hs (when (syn/identifier? h)
                       ;; (syntax-quote qualifies kernel forms the reader doesn't
                       ;; know as such: for-syntax, a core macro too, and
                       ;; quote-syntax; ns/quote-syntax, naming no var, is the form)
                       (let [e (syn/syntax-e h)]
                         (cond (= e 'norn.core/for-syntax) 'for-syntax
                               (and (namespace e) (contains? specials (symbol (name e))) (nil? (resolve-global h)))
                               (symbol (name e))
                               :else e)))]
              (cond (nil? hs) (apply list (expand-body xs))
                    (resolve-local h) (apply list (expand-body xs))
                    (contains? specials hs) (expand-core (name hs) s xs)
                    :else (let [v (resolve-global h)]
                            (if (and v (macro? v))
                              (expand (macro-step v s))
                              (do (when v (check-not-later-macro h v))
                                  (apply list (expand-body xs))))))))
          (vector? x) (mapv expand x)
          (map? x) (into {} (map (fn [[k v]] [(expand k) (expand v)])) x)
          (set? x) (into #{} (map expand) x)
          :else x)))

;; ---- the top level ----

(defn expand-top
  "Expand top-level macros in syntax s until it's a kernel form or a call."
  [s]
  (loop [s s]
    (let [x (syn/syntax-e s)]
      (if-let [v (and (seq? x) (seq x) (macro-of (first x)))]
        (recur (macro-step v s))
        s))))

(defn- top-do? [s]
  (let [x (syn/syntax-e s)]
    (and (seq? x) (seq x) (= "do" (special-form (first x))))))

(defn expand-all
  "Syntax s fully expanded, with a fresh binding table (no top-level do
  splitting: for macroexpansion tools and tests)."
  [s]
  (binding [*bindings* (atom {}) *datums* (atom {}) *ns-sym* (symbol (str (current-ns)))] (expand s)))

(def ^:dynamic *recording*
  "While a module loads: an atom collecting the units (namespace, expanded
  form) compiled for the source form being evaluated, for the module cache."
  nil)

(defn- run
  "Compile and run expanded form f; a compile error offers retry and
  use-value, as norn.compiler/eval does."
  [f s]
  (when *recording* (swap! *recording* conj [(str (current-ns-sym)) f]))
  (let [r (loop []
            (let [r (restart-case [:ok (norn.compiler/compile-toplevel f)]
                      (use-value [v] :report "Use a value instead of evaluating the form" [:value v])
                      (retry [] :report "Compile the form again (e.g. after defining what it needs)" [:retry]))]
              (if (= (first r) :retry) (recur) r)))]
    ;; (what the code evaluates while it runs isn't this module's own)
    (binding [*recording* nil]
      (if (= (first r) :ok) ((second r)) (second r)))))

(defn eval-syntax
  "Evaluate syntax s: a top-level do form by form, anything else expanded
  and compiled (after the contract wrappers it needs: M9 part 9.4)."
  [s]
  (binding [*signatures* (or *signatures* (atom {}))]
    (let [s (binding [*datums* (atom {}) *ns-sym* (symbol (str (current-ns)))] (expand-top s))]
      (if (top-do? s)
        (loop [xs (rest (syn/syntax-e s)) last nil]
          (if (seq xs) (recur (rest xs) (eval-syntax (first xs))) last))
        (let [ws (atom [])
              e (binding [*wrappers* ws] (expand-all s))]
          (doseq [w @ws] (run w nil))
          (run e s))))))

(defn eval
  "Evaluate form (data or syntax) through the expander, in the current
  namespace."
  [form]
  (let [sc (ns-scope (symbol (str (current-ns))))]
    (eval-syntax (if (syn/syntax? form)
                   (syn/add-scope form sc)
                   (syn/%raw-syntax form #{sc} nil)))))

;; ---- modules (M8 part 8.4) ----
;;
;; A file whose first form is (ns …) is a module. Before its forms run, the
;; names its defining forms introduce are declared in its namespace, so a
;; function may call one defined further down (as in Racket; in Clojure it
;; would need declare). Its forms are then read and evaluated in order, as
;; syntax with their places, so macros and their helpers still take effect
;; in order (phases, 8.5, will separate them). Each module is recorded in
;; the registry, with where it came from and what it requires.

(def ^:private definers
  "Defining macros: their second element is the name they define."
  (atom #{"norn.core/defn" "norn.core/defn-" "norn.core/defmacro" "norn.core/defclass" "norn.core/defgeneric"
          "norn.syntax/defsyntax" "norn.test/deftest" "norn.ffi/defcfun"}))

(defn register-definer!
  "Tell the module loader that macro var v defines the name that follows it,
  so modules may use that name before its definition."
  [v]
  (swap! definers conj (%var-name v)))

(def modules "Module name → {:path :requires :defines :macros}." (atom {}))

(defn module-info "What the registry knows of module m (a symbol), or nil." [m] (get @modules m))

(defn- defined-names
  "The names top-level form d defines, if it's a defining form."
  [d]
  (when (and (seq? d) (symbol? (first d)))
    (let [h (first d)
          v (when-not (= h 'def) (resolve h))
          head (cond (= h 'def) "def" v (%var-name v))]
      (cond (= head "norn.core/declare") (filter (fn [x] (and (symbol? x) (nil? (namespace x)))) (rest d))
            (and (or (= head "def") (contains? @definers head)) (symbol? (second d)) (nil? (namespace (second d))))
            [(second d)]
            :else nil))))

(def ^:private macro-definers #{"norn.core/defmacro" "norn.syntax/defsyntax"})

(defn- defined-macros
  "The macro names top-level form d defines (defmacro, defsyntax)."
  [d]
  (when (and (seq? d) (symbol? (first d)) (symbol? (second d)) (nil? (namespace (second d))))
    (when-let [v (resolve (first d))]
      (when (contains? macro-definers (%var-name v)) [(second d)]))))

(defn- ns-switch? [d] (and (seq? d) (contains? #{'ns 'in-ns} (first d))))

(defn- requires-of
  "The modules an ns form requires."
  [d]
  (vec (for [clause (rest d) :when (and (seq? clause) (= :require (first clause)))
             spec (rest clause)]
         (let [spec (if (and (seq? spec) (= 'quote (first spec))) (second spec) spec)]
           (if (vector? spec) (first spec) spec)))))

(defn- declare-module!
  "Declare the names module text defines (read from just after its ns form,
  up to any later ns or in-ns), and record it."
  [text src ns-form]
  (let [r (%reader text src)
        _ (%read r)
        [names macros] (loop [acc [] macros #{}]
                         (let [d (try (%read r) (catch Error _ ::unreadable))]
                           (if (or (= d ::unreadable) (%eof? d) (ns-switch? d))
                             [acc macros]
                             (recur (into acc (defined-names d)) (into macros (defined-macros d))))))
        here (current-ns)]
    (doseq [n names]
      ;; (unbound until its definition runs; a name already defined here
      ;; keeps its value)
      (when-not (when-let [v (%resolve-in (symbol (str here)) n)] (= (var-ns-of v) (symbol (str here))))
        (%intern here n)))
    (swap! pending-macros into (keep (fn [n] (%resolve-in (symbol (str here)) n))) macros)
    (swap! modules assoc (symbol (str here)) {:path src :requires (requires-of ns-form) :defines (vec (distinct names))
                                              :macros macros})))

(defn %declare-module!
  "Declare the names a module's text defines, as loading it does (for tools
  that go through a module form by form, as the macro stepper does)."
  [text src ns-form]
  (declare-module! text src ns-form))

(defn- eval-located
  "Evaluate syntax s read from src, noting where (for errors and the
  definitions index). text, when given, is the whole source text: a
  definition typed in (src \"<string>\", \"<editor>\"…) keeps its own."
  ([s src] (eval-located s src nil))
  ([s src text]
   (let [line (or (syn/syntax-line s) 0)
         d (syn/syntax->datum s)
         pos (syn/syntax-position s)
         span (syn/syntax-span s)]
     (%set-location! (str src ":" line))
     (%note-definition! d src line (when (and text pos span) (subs text pos (+ pos span))))
     (eval s))))

;; ---- the compiled-module cache (8.6) ----
;;
;; A module's expanded code, unit by unit (each top-level form compiled and
;; run, with the namespace it was compiled in), is written to a file in the
;; cache folder, keyed by a hash of the build, the module's name, place and
;; source, and the keys of the modules its ns form requires. When the key
;; matches, loading reads the source only as data (for the definitions
;; index and error places) and compiles and runs the cached units: nothing
;; is expanded again.
;;
;; Expanded code holds two things that don't print as themselves: locals
;; (uninterned symbols: two `t`s must stay two) and syntax objects (from
;; hygienic templates), whose scopes are numbers that mean nothing in
;; another process. Locals are written as %%local/name#n; a scope as its
;; namespace's, its namespace's access scope, or a number that stands for
;; the same fresh scope throughout the module. Anything that doesn't read
;; back as it was written (a function as a constant…) leaves the module
;; uncached rather than cached wrong.

(def ^:dynamic *cache-dir*
  "Where compiled modules are cached (nil: not at all). NORN_CACHE sets it
  at start (off for none); the default is the system's cache folder. Bind
  it to cache somewhere else for a while."
  (%cache-dir))

(defn set-cache-dir! "Cache compiled modules in dir from now on (nil: not at all)." [dir]
  (%set-root! (var *cache-dir*) dir))

;; (an image may run on another machine: its cache folder is found there)
(swap! %restore-hooks conj (fn [] (set-cache-dir! (%cache-dir))))

(def ^:dynamic *cache-stats*
  "An atom counting modules loaded from the cache, compiled, written, or not
  cacheable. Bind a fresh one to count a stretch of loading on its own."
  (atom {:hits 0 :misses 0 :writes 0 :uncacheable 0}))

(defn- uninterned? [x] (and (symbol? x) (nil? (namespace x)) (not (identical? x (symbol (name x))))))

(defn- scope-spec [sc]
  (if-let [n (get @scope-nss sc)]
    [:ns n]
    (if-let [n (some (fn [[k v]] (when (= v sc) k)) @access-scopes)]
      [:access n]
      [:s sc])))

(defn- encode
  "Expanded code x as data that prints and reads back as itself."
  [x locals]
  (cond (uninterned? x)
        (symbol "%%local" (str (name x) "#" (or (get @locals x)
                                                (let [n (count @locals)] (swap! locals assoc x n) n))))
        (syn/syntax? x)
        (if (syn/%raw? x)
          (list '%%syntax/raw (syn/%raw-e x) (mapv scope-spec (syn/syntax-scopes x)) (syn/syntax-loc x) (syn/syntax-props x))
          (list '%%syntax/obj (encode (syn/syntax-e x) locals) (mapv scope-spec (syn/syntax-scopes x)) (syn/syntax-loc x)
                (syn/syntax-props x)))
        ;; (a var as a constant, as defmethod's expansion has: by its name)
        (var? x) (list '%%syntax/var (%var-name x))
        (seq? x) (apply list (map (fn [y] (encode y locals)) x))
        (vector? x) (mapv (fn [y] (encode y locals)) x)
        (map? x) (into {} (map (fn [[k v]] [(encode k locals) (encode v locals)])) x)
        (set? x) (into #{} (map (fn [y] (encode y locals))) x)
        :else x))

(defn- last-index-of [s ch]
  (loop [i (dec (count s))] (cond (< i 0) 0 (= (nth s i) (first ch)) i :else (recur (dec i)))))

(defn- decode
  "Code written by encode, back: locals as fresh uninterned symbols (one per
  name#n), scopes through module-scopes (an atom: written → fresh)."
  [x locals module-scopes]
  (let [scope (fn [[k v]]
                (case k
                  :ns (ns-scope v)
                  :access (access-scope v)
                  :s (or (get @module-scopes v) (let [sc (syn/new-scope)] (swap! module-scopes assoc v sc) sc))))
        dec (fn dec [y]
              (cond (and (symbol? y) (= "%%local" (namespace y)))
                    (or (get @locals y)
                        (let [n (name y)
                              u (%uninterned-symbol (subs n 0 (last-index-of n "#")))]
                          (swap! locals assoc y u)
                          u))
                    (and (seq? y) (= '%%syntax/var (first y)))
                    (let [sym (symbol (second y))] (%intern (symbol (namespace sym)) (symbol (name sym))))
                    (and (seq? y) (= '%%syntax/raw (first y)))
                    (let [[_ e scopes loc] y]
                      (syn/%raw-syntax e (into #{} (map scope) scopes) loc))
                    (and (seq? y) (= '%%syntax/obj (first y)))
                    (let [[_ e scopes loc props] y]
                      (syn/%make-syntax (dec e) (into #{} (map scope) scopes) loc props))
                    (seq? y) (apply list (map dec y))
                    (vector? y) (mapv dec y)
                    (map? y) (into {} (map (fn [[k v]] [(dec k) (dec v)])) y)
                    (set? y) (into #{} (map dec) y)
                    :else y))]
    (dec x)))

(defn- deps-of
  "The module instances an ns form requires, at the current shift."
  [d]
  (let [shift (%ns-shift (current-ns-sym))
        names (fn [k] (for [clause (rest d) :when (and (seq? clause) (= k (first clause)))
                            spec (rest clause)]
                        (let [spec (if (and (seq? spec) (= 'quote (first spec))) (second spec) spec)]
                          (if (vector? spec) (first spec) spec))))]
    (concat (map (fn [l] (%shifted l shift)) (names :require))
            (map (fn [l] (%shifted l (inc shift))) (names :require-for-syntax)))))

;; (the contract mode is part of the key: expansion decides which calls
;; check contracts, so code expanded under :none must not load under
;; :boundaries)
(defn- module-key [text src nsym d]
  (%hash-text (pr-str [(%build-id) (str nsym) src (%hash-text text) norn.core/*check-contracts*
                       (mapv (fn [dep] [(str dep) (get-in @modules [dep :key])]) (deps-of d))])))

(defn- cache-file [dir nsym src] (str dir "/" (%hash-text (str nsym "|" src)) ".nmod"))

(defn- read-cache [file key]
  (try (let [m (read-string (slurp file))]
         (when (and (map? m) (= key (:key m))) m))
       (catch Error _ nil)))

(defn- prune-cache!
  "Keep the cache folder to at most 1000 entries, dropping the oldest
  (modules that came and went, as tests' do, would otherwise pile up)."
  [dir]
  (let [names (filter (fn [n] (= ".nmod" (subs n (max 0 (- (count n) 5))))) (try (%fs-list dir) (catch Error _ [])))]
    (when (> (count names) 1000)
      (doseq [[_ p] (take (- (count names) 800)
                          (sort-by first (map (fn [n] (let [p (str dir "/" n)] [(or (:modified (%fs-info p)) 0) p])) names)))]
        (try (%fs-delete p false) (catch Error _ nil))))))

(defn- write-cache! [dir file key forms]
  (let [text (pr-str {:key key :forms (mapv (fn [units] (mapv (fn [[n f]] [n (encode f (atom {}))]) units)) forms)})]
    ;; written only if it reads back as written
    (if (try (= text (pr-str (read-string text))) (catch Error _ false))
      (try (%fs-mkdirs dir)
           (let [tmp (str file "." (nano-time) ".tmp")]
             (spit tmp text)
             (%fs-rename tmp file))
           (swap! *cache-stats* update :writes inc)
           (prune-cache! dir)
           (catch Error _ nil))
      (swap! *cache-stats* update :uncacheable inc))))

(defn- load-module-body
  "The rest of module r (its ns form evaluated): from the cache if it's
  there and current, else read, expanded, run and cached."
  [r src d]
  (let [nsym (current-ns-sym)
        text (%reader-text r)
        key (module-key text src nsym d)
        _ (swap! modules assoc-in [nsym :key] key)
        dir *cache-dir*
        file (when dir (cache-file dir nsym src))
        cached (when file (read-cache file key))]
    (if cached
      (do (swap! *cache-stats* update :hits inc)
          (let [module-scopes (atom {})]
            (loop [forms (seq (:forms cached)) last nil]
              (let [d (%read r)]
                (if (or (%eof? d) (empty? forms))
                  last
                  (let [line (%reader-line r)]
                    (%set-location! (str src ":" line))
                    (%note-definition! d src line)
                    (recur (next forms)
                           (reduce (fn [_ [n f]]
                                     (when-not (= n (str (current-ns))) (in-ns (symbol n)))
                                     (run (decode f (atom {}) module-scopes) nil))
                                   last (first forms)))))))))
      (do (swap! *cache-stats* update :misses inc)
          (loop [forms [] last nil]
            (let [s (syn/read-syntax r)]
              (if (= s :eof)
                (do (when file (write-cache! dir file key forms)) last)
                (let [units (atom [])
                      v (binding [*recording* units] (eval-located s src))]
                  (recur (conj forms @units) v)))))))))

(defn eval-reader
  "Evaluate every form reader r reads, as syntax with places. A source that
  starts with (ns …) is a module: its definitions are declared first."
  [r]
  (let [src (%reader-name r)
        saved (%location)]
    (try
      (let [s (syn/read-syntax r)]
        (if (= s :eof)
          nil
          (let [d (syn/syntax->datum s)
                module? (and (seq? d) (= 'ns (first d)) (symbol? (second d)))
                ;; (a module loaded one phase up is that phase's instance)
                s (if (and module? (pos? *load-shift*))
                    (syn/%raw-syntax (apply list 'ns (%shifted (second d) *load-shift*) (drop 2 d)) #{} (syn/syntax-loc s))
                    s)]
            (binding [*strict* (or module? *strict*)]
              (let [text (when (contains? #{"<string>" "<editor>" "<repl>"} src) (%reader-text r))
                    v (eval-located s src text)]
                (if module?
                  (let [nsym (current-ns-sym)]
                    (try (declare-module! (%reader-text r) src d)
                         (load-module-body r src d)
                         (finally (swap! pending-macros (fn [vs] (into #{} (remove (fn [v] (= nsym (var-ns-of v)))) vs))))))
                  (loop [last v]
                    (let [s (syn/read-syntax r)]
                      (if (= s :eof) last (recur (eval-located s src text)))))))))))
      (finally (%set-location! saved)))))

;; ---- macroexpand and macroexpand-1 ----
;;
;; The primitives call a macro's function on the call's data, which a
;; defsyntax macro hasn't got (its value is a transformer): these take a
;; hygienic macro's step here, as the expander would, and give its result
;; as data (a hygienic macro's renaming shows only in a full expansion:
;; norn expand, macro-steps).

(def ^:private prim-macroexpand-1 norn.core/macroexpand-1)

(defn- macro-head
  "The macro var form's head names in the current namespace, or nil."
  [form]
  (when (and (seq? form) (symbol? (first form)) (not (contains? specials (first form))))
    (let [v (resolve (first form))]
      (when (and (var? v) (macro? v)) v))))

(defn- macroexpand-1*
  [form]
  (if-let [v (macro-head form)]
    (if (transformer? (var-get v))
      (let [nsym (current-ns-sym)]
        (binding [*ns-sym* nsym *on-step* nil]
          (syn/syntax->datum (first (apply-macro v (syn/%raw-syntax form #{(ns-scope nsym)} nil))))))
      (prim-macroexpand-1 form))
    form))

(defn- macroexpand*
  [form]
  (loop [f form] (if (macro-head f) (recur (macroexpand-1* f)) f)))

(defn %install!
  "Make the expander the way eval (and so load-file, require, the REPL…)
  expands, and modules the way files load."
  []
  (%set-root! (var norn.core/eval) eval)
  (%set-root! (var norn.core/%eval-reader) eval-reader)
  (%set-root! (var norn.core/macroexpand-1) macroexpand-1*)
  (%set-root! (var norn.core/macroexpand) macroexpand*)
  :installed)

;; ---- checking the expander against the plain compiler (8.7) ----

(defn compare-expanded
  "Compile every top-level form of source text src (read in namespace ns)
  both through the expander and through the compiler alone, and compare
  the code (ns and in-ns forms are run, not compared). The forms whose code
  differs: for the bootstrap sources (core, the compiler, norn.syntax and
  the expander itself, compiled at boot before the expander is installed)
  none should, so the base image holds exactly what the expander makes."
  [src source-name ns]
  (let [r (%reader src source-name)
        saved (current-ns)]
    (in-ns ns)
    (try
      (loop [diffs []]
        (let [f (%read r)]
          (if (%eof? f)
            diffs
            (let [f2 (norn.compiler/macroexpand-all-top f)]
              (if (and (seq? f2) (symbol? (first f2)) (contains? #{"in-ns" "ns"} (name (first f2))))
                (do (norn.compiler/eval f2) (recur diffs))
                (let [line (%reader-line r)
                      a (try (norn.compiler/%signature (norn.compiler/compile-toplevel f2))
                             (catch Error e {:error (condition-message e)}))
                      b (try (norn.compiler/%signature
                              (norn.compiler/compile-toplevel
                               (expand-all (syn/%raw-syntax f #{(ns-scope (symbol (str (current-ns))))} nil))))
                             (catch Error e {:error (condition-message e)}))]
                  (recur (if (= a b) diffs (conj diffs {:form (take 2 f) :line line :plain (:error a) :expanded (:error b)})))))))))
      (finally (in-ns (symbol (str saved)))))))
