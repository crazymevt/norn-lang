;;;; skein.compiler — the Skein compiler, written in Skein (runtime.md §9).
;;;;
;;;; Forms → tier-0 bytecode. It is a faithful port of the Rust seed compiler
;;;; (crates/skein-vm/src/compiler.rs): same kernel forms, same register
;;;; allocation, same constant order, so its output can be checked
;;;; byte-for-byte against the seed's, and against itself (the self-hosting
;;;; fixpoint). Once loaded it becomes `eval`; macros then run as ordinary
;;;; Skein code in the compiling fiber (they can block, and the GC needs no
;;;; pause while compiling).
;;;;
;;;; Two passes: analyze (forms → the IR, below) and generate (the IR →
;;;; bytecode). Generating's state is mutable: see "compiler state".

(ns skein.compiler
  (:refer-core :exclude [eval]))

(defclass CompileError (RuntimeError) ())

(defn- cerr [& msg] (error CompileError :message (apply %message msg)))

;;; ---- instructions (crates/skein-vm/src/bytecode.rs) ---------------------------------

(def MOVE 0) (def LOADK 1) (def LOADI 2) (def LOADNIL 3) (def LOADTRUE 4) (def LOADFALSE 5)
(def GETVAR 6) (def DEFVAR 7) (def GETUP 8) (def SELF 9) (def CLOSURE 10) (def SETUP 11)
(def JMP 12) (def JMPF 13) (def LOOP 14) (def CALL 15) (def TAILCALL 16) (def RETURN 17)
(def GUARD 18)

(defn- abc [o a b c] (bit-or o (bit-shift-left a 8) (bit-shift-left b 16) (bit-shift-left c 24)))
(defn- abx [o a bx] (bit-or o (bit-shift-left a 8) (bit-shift-left bx 16)))
(defn- asbx [o a sbx] (abx o a (+ sbx 32768)))
(defn- op-of [i] (bit-and i 255))
(defn- a-of [i] (bit-and (bit-shift-right i 8) 255))

(def ^:private NT {:tail false :recur false})

(def ^:private specials #{"quote" "if" "do" "def" "var" "fn*" "let*" "letrec*" "loop*" "recur" "&"})

(defn- cons? [x] (and (list? x) (some? (seq x))))

(defn- special? [s] (and (nil? (namespace s)) (contains? specials (name s))))

;;; ---- compiler state ------------------------------------------------------------------------
;;;
;;; Mutable, for speed (compiling is most of loading a file): transient
;;; vectors, used as records with numbered fields and as buffers that grow
;;; in place. They belong to the compiling fiber and live only as long as
;;; one call of generate.
;;;
;;;   cs, the state:     [fns template inline-depth arity types]
;;;     fns: the stack of function contexts, innermost last; template: the
;;;     latest function's (for gen-def!); arity: the innermost's arity being
;;;     generated (kept here, as every emit! needs it); types: the locals'
;;;     known types, binding id → type (see "types")
;;;   a function context: [self-id upvals arity], upvals [[binding-id capture]…]
;;;   an arity:          [code consts cindex locals debug next max recur inl inlines]
;;;     cindex: the constants' indices by %identity-hash (lists of them),
;;;     consts being found by identity, as the seed compiler finds them;
;;;     locals [[binding-id reg]…]; debug: name, register, name, register…;
;;;     recur: a stack of [start regs]; inl: a stack of {:dbg [name reg…]
;;;     :holes [[from to]…]}, one per call being inlined; inlines: [start
;;;     end fname debug holes …] per inlined call, for backtraces.

(def ^:private FNS 0) (def ^:private TEMPLATE 1) (def ^:private DEPTH 2) (def ^:private CUR 3) (def ^:private TYPES 4)
(def ^:private SELF-ID 0) (def ^:private UPVALS 1) (def ^:private FAR 2)
(def ^:private CODE 0) (def ^:private CONSTS 1) (def ^:private CINDEX 2) (def ^:private LOCALS 3)
(def ^:private DEBUG 4) (def ^:private NEXT 5) (def ^:private MAX 6) (def ^:private RECUR 7)
(def ^:private INL 8) (def ^:private INLINES 9)

(defn- new-arity []
  (transient [(transient []) (transient []) {} (transient []) (transient []) 0 0 [] [] (transient [])]))

(defn- ar [cs] (nth cs CUR))

(defn- tpeek [t] (nth t (dec (count t))))

(defn- emit! [cs ins]
  (let [code (nth (nth cs CUR) CODE)
        n (count code)]
    (conj! code ins)
    n))

(defn- pc [cs] (count (nth (nth cs CUR) CODE)))

(defn- konst! [cs v]
  (let [a (nth cs CUR)
        ks (nth a CONSTS)
        h (%identity-hash v)
        hits (get (nth a CINDEX) h)]
    (or (loop [s hits]
          (cond (nil? s) nil
                (identical? (nth ks (first s)) v) (first s)
                :else (recur (next s))))
        (let [n (count ks)]
          (when (> n 65535) (cerr "Too many constants in one function"))
          (conj! ks v)
          (assoc! a CINDEX (assoc (nth a CINDEX) h (cons n hits)))
          n))))

(defn- alloc! [cs]
  (let [a (nth cs CUR)
        r (nth a NEXT)]
    (when (>= r 255) (cerr "Too many registers in one function (expression too complex)"))
    (assoc! a NEXT (inc r))
    (when (> (inc r) (nth a MAX)) (assoc! a MAX (inc r)))
    r))

(defn- free-to! [cs r] (assoc! (nth cs CUR) NEXT r))

(defn- jump-offset [from to]
  (let [off (- to (inc from))]
    (when (>= (abs off) 32768) (cerr "Function too large (jump out of range)"))
    off))

(defn- patch-jump! [cs at to]
  (let [off (jump-offset at to)
        code (nth (nth cs CUR) CODE)
        ins (nth code at)]
    (assoc! code at (asbx (op-of ins) (a-of ins) off))))

;; Push and pop the stacks kept in an arity's fields (persistent vectors).
(defn- push-field! [a k x] (assoc! a k (conj (nth a k) x)))
(defn- pop-field! [a k] (assoc! a k (pop (nth a k))))

(defn- finish! [cs dest pos]
  (when (:tail pos) (emit! cs (abc RETURN dest 0 0))))

;; The proto of arity a. Its buffers are made persistent: a is done with.
(defn- finish-arity [a fname nfixed variadic dest]
  (let [code (persistent! (conj! (nth a CODE) (abc RETURN dest 0 0)))
        ;; (after the name/register pairs, one per inlined call: its record
        ;; [start end fname debug], with register -1, which no frame has)
        d (nth a DEBUG)
        _ (doseq [r (persistent! (nth a INLINES))] (conj! d r) (conj! d -1))
        nregs (max (nth a MAX) (+ nfixed (if variadic 1 0)))]
    (%make-proto fname nfixed variadic nregs (persistent! (nth a CONSTS)) code (persistent! d))))

(defn- load-const! [cs dest v]
  (cond (nil? v) (emit! cs (abc LOADNIL dest 0 0))
        (true? v) (emit! cs (abc LOADTRUE dest 0 0))
        (false? v) (emit! cs (abc LOADFALSE dest 0 0))
        (and (integer? v) (>= v -32768) (< v 32768)) (emit! cs (asbx LOADI dest v))
        :else (emit! cs (abx LOADK dest (konst! cs v)))))

;;; ---- the IR --------------------------------------------------------------------------------
;;;
;;; Compiling is two passes (M10 part 1). analyze turns a form into the IR,
;;; a tree of maps, each with an :op: names resolved (a local to its
;;; binding {:id :sym}, a global to its var), macros expanded, a def's var
;;; interned, collection literals made calls, anonymous functions named.
;;; generate turns the IR into bytecode. It walks the tree as the one-pass
;;; compiler walked forms, allocating registers and constants in the same
;;; order, so the bytecode is the same, byte for byte (compiler_test checks
;;; it against the seed's). The optimiser's passes go between the two.
;;;
;;;   {:op :const :value v}
;;;   {:op :local :binding b}              b {:id n :sym s}
;;;   {:op :global :var v}
;;;   {:op :if :test :then :else}
;;;   {:op :do :body [node…]}
;;;   {:op :def :var v :init node-or-nil}
;;;   {:op :fn :self b-or-nil :fname :named :arities [{:params [b…] :nfixed :variadic :body}]}
;;;   {:op :let :loop bool :bindings [[b node]…] :body}
;;;   {:op :letrec :bindings [[b fn-node]…] :body}
;;;   {:op :recur :args [node…]}
;;;   {:op :call :f node :args [node…]}

(def ^:private next-binding (atom 0))

(defn- new-binding [sym] {:id (swap! next-binding inc) :sym sym})

;; The analysis environment: a frame per function, innermost last, each
;; {:self b-or-nil :locals [[sym b]…] :fname}, and the var a def being
;; analysed defines (:def-name), which anonymous functions in its value are
;; named after. Locals are matched by identity (the expander makes each an
;; uninterned symbol); the last binding of a symbol in a frame is the one in
;; scope, then the function's own name, then the frames outside.

(defn- find-local [env sym]
  (loop [i (dec (count (:frames env)))]
    (when (>= i 0)
      (let [f (nth (:frames env) i)
            ls (:locals f)
            hit (loop [j (dec (count ls))]
                  (when (>= j 0) (if (identical? (first (nth ls j)) sym) (second (nth ls j)) (recur (dec j)))))]
        (cond hit hit
              (and (:self f) (identical? (:sym (:self f)) sym)) (:self f)
              :else (recur (dec i)))))))

(defn- bind [env sym b]
  (update env :frames (fn [fs] (conj (pop fs) (update (peek fs) :locals conj [sym b])))))

(defn- lexical? [env sym] (some? (find-local env sym)))

(defn- macro-var [env form]
  (when (cons? form)
    (let [h (first form)]
      (when (and (symbol? h)
                 (not (special? h))
                 (not (and (nil? (namespace h)) (lexical? env h))))
        (let [v (resolve h)]
          (when (and v (macro? v)) v))))))

(defn- expand [v form] (apply (var-get v) (rest form)))

(defn- macroexpand-in [env form]
  (loop [f form]
    (let [v (macro-var env f)]
      (if v (recur (expand v f)) f))))

(defn- constant? [v]
  (cond (or (symbol? v) (cons? v)) false
        (vector? v) (every? constant? v)
        (map? v) (every? (fn [e] (and (constant? (first e)) (constant? (second e)))) v)
        (set? v) (every? constant? v)
        :else true))

(defn- binding-pairs [xs what]
  (let [bv (nth xs 1 nil)]
    (when-not (vector? bv) (cerr what "requires a vector for its bindings"))
    (when (odd? (count bv)) (cerr what "requires an even number of forms in its binding vector"))
    (let [pairs (partition 2 bv)]
      (doseq [p pairs]
        (let [s (first p)]
          (when (or (not (symbol? s)) (namespace s))
            (cerr (str "Bad binding form in " what ":") (pr-str s)))))
      pairs)))

(def ^:private no-init (atom nil))

(declare analyze analyze-fn)

(defn- analyze-body [env forms] {:op :do :body (mapv (fn [f] (analyze env f)) forms)})

(defn- analyze-symbol [env sym]
  (if-let [b (when (nil? (namespace sym)) (find-local env sym))]
    {:op :local :binding b}
    (let [v (resolve sym)]
      (when-not v (cerr (str "Unable to resolve symbol: " (pr-str sym) " in this context" (%interop-hint sym))))
      (when (macro? v) (cerr "Can't take the value of a macro:" (pr-str v)))
      {:op :global :var v})))

(defn- analyze-coll [env form]
  (let [ctor (cond (vector? form) "vector" (map? form) "hash-map" :else "hash-set")
        elems (cond (map? form) (vec (mapcat (fn [e] [(first e) (second e)]) form))
                    :else (vec form))
        v (resolve (symbol "skein.core" ctor))]
    (when-not v (cerr (str "skein.core/" ctor " is not defined")))
    {:op :call :f {:op :global :var v} :args (mapv (fn [x] (analyze env x)) elems)}))

(defn- analyze-def [env xs]
  (let [sym (nth xs 1 nil)]
    (when-not (symbol? sym) (cerr "First argument to def must be a symbol"))
    (when (and (namespace sym) (not= (namespace sym) (name (current-ns))))
      (cerr "Can't create a var in another namespace with def"))
    (let [v (%intern (current-ns) (symbol (name sym)))
          _ (when-let [defined skein.core/*defined*] (swap! defined conj [(str (current-ns)) (symbol (name sym))]))
          n (count xs)
          init (cond (= n 2) no-init
                     (= n 3) (nth xs 2)
                     (and (= n 4) (string? (nth xs 2))) (nth xs 3)
                     :else (cerr "Too many arguments to def"))]
      {:op :def :var v
       ;; (an anonymous function in the value is named after the var: its
       ;; backtrace and profile frames say whose it is)
       :init (when-not (identical? init no-init)
               (analyze (assoc env :def-name (symbol (name (current-ns)) (name sym))) init))})))

(defn- analyze-let [env xs loop?]
  (let [pairs (binding-pairs xs (if loop? "loop" "let"))
        [env bs] (reduce (fn [[env bs] p]
                           (let [init (analyze env (second p))
                                 b (new-binding (first p))]
                             [(bind env (first p) b) (conj bs [b init])]))
                         [env []] pairs)]
    {:op :let :loop loop? :bindings bs :body (analyze-body env (drop 2 xs))}))

(defn- analyze-letrec [env xs]
  (let [pairs (vec (binding-pairs xs "letrec*"))
        bs (mapv (fn [p] (new-binding (first p))) pairs)
        env (reduce (fn [env i] (bind env (first (nth pairs i)) (nth bs i))) env (range (count pairs)))
        inits (mapv (fn [p]
                      (let [init (macroexpand-in env (second p))]
                        (when-not (and (cons? init) (symbol? (first init)) (= (name (first init)) "fn*"))
                          (cerr "letrec* bindings must be functions"))
                        (analyze-fn env (vec init))))
                    pairs)]
    {:op :letrec :bindings (mapv vector bs inits) :body (analyze-body env (drop 2 xs))}))

(defn- analyze-arity [env sig state]
  (let [ps (first sig)
        parsed (loop [k 0 nfixed 0 variadic false params []]
                 (if (< k (count ps))
                   (let [p (nth ps k)]
                     (when (or (not (symbol? p)) (namespace p)) (cerr "Bad parameter:" (pr-str p)))
                     (if (= (name p) "&")
                       (do (when (not= (+ k 2) (count ps)) (cerr "& must be followed by exactly one parameter"))
                           (recur (inc k) nfixed true params))
                       (recur (inc k) (if variadic nfixed (inc nfixed)) variadic (conj params [p (new-binding p)]))))
                   [nfixed variadic params]))
        [nfixed variadic params] parsed]
    (when (or (and variadic (:variadic state)) (and (not variadic) (some (fn [x] (= x nfixed)) (:fixed state))))
      (cerr "Can't have two overloads with the same arity"))
    (let [env (reduce (fn [env [p b]] (bind env p b)) env params)]
      {:arities (conj (:arities state) {:params (mapv second params) :nfixed nfixed :variadic variadic
                                        :body (analyze-body env (second sig))})
       :fixed (if variadic (:fixed state) (conj (:fixed state) nfixed))
       :variadic (or variadic (:variadic state))})))

;; (fn* name? [params] body…) or (fn* name? ([params] body…)…).
(defn- analyze-fn [env xs]
  (let [named (symbol? (nth xs 1 nil))
        self-name (when named (nth xs 1))
        rst (vec (drop (if named 2 1) xs))
        sigs (cond (empty? rst) (cerr "fn* requires a parameter vector")
                   (vector? (first rst)) [[(first rst) (vec (rest rst))]]
                   :else (mapv (fn [sig]
                                 (let [s (vec sig)]
                                   (if (and (cons? sig) (vector? (first s)))
                                     [(first s) (vec (rest s))]
                                     (cerr "fn* arity must look like ([params] body...)"))))
                               rst))
        ;; (an anonymous one's code is named for where it is: outer/fn, outer
        ;; the function or def around it, for backtraces and profiles; the
        ;; function itself still prints as fn)
        outer (or (:fname (peek (:frames env))) (:def-name env))
        fname (cond named (symbol (name (current-ns)) (name self-name))
                    outer (symbol (str outer) "fn"))
        self (when named (new-binding self-name))
        env (update env :frames conj {:self self :locals [] :fname fname})
        st (reduce (fn [st sig] (analyze-arity env sig st)) {:arities [] :fixed [] :variadic false} sigs)]
    {:op :fn :self self :fname fname :named named :arities (:arities st)}))

(defn- analyze-list [env form]
  (let [h (first form)
        n (when (and (symbol? h) (nil? (namespace h))) (name h))
        xs (when (and n (not= n "&") (contains? specials n)) (vec form))]
    (cond
      (= n "quote") (do (when (not= (count xs) 2) (cerr "quote takes exactly one argument"))
                        {:op :const :value (nth xs 1)})
      (and xs (= n "if")) (do (when (or (< (count xs) 3) (> (count xs) 4))
                                (cerr "if takes a test, a then-branch and an optional else-branch"))
                              {:op :if :test (analyze env (nth xs 1)) :then (analyze env (nth xs 2))
                               :else (analyze env (nth xs 3 nil))})
      (and xs (= n "do")) (analyze-body env (rest xs))
      (and xs (= n "def")) (analyze-def env xs)
      (and xs (= n "var")) (let [sym (nth xs 1 nil)]
                             (when-not (symbol? sym) (cerr "var takes a symbol"))
                             (let [v (resolve sym)]
                               (when-not v (cerr "Unable to resolve var:" (pr-str sym)))
                               {:op :const :value v}))
      (and xs (= n "fn*")) (analyze-fn env xs)
      (and xs (= n "let*")) (analyze-let env xs false)
      (and xs (= n "loop*")) (analyze-let env xs true)
      (and xs (= n "letrec*")) (analyze-letrec env xs)
      (and xs (= n "recur")) {:op :recur :args (mapv (fn [x] (analyze env x)) (rest xs))}
      :else
      (let [v (macro-var env form)]
        (if v
          (analyze env (expand v form))
          (let [items (vec form)]
            {:op :call :f (analyze env (first items)) :args (mapv (fn [x] (analyze env x)) (rest items))}))))))

(defn analyze
  "Form, as the IR (see above), in environment env (nil: at top level)."
  [env form]
  (let [env (or env {:frames [{:self nil :locals [] :fname nil}]})]
    (cond (symbol? form) (analyze-symbol env form)
          (cons? form) (analyze-list env form)
          (and (or (vector? form) (map? form) (set? form)) (not (constant? form))) (analyze-coll env form)
          :else {:op :const :value form})))

;;; ---- generating bytecode from the IR ---------------------------------------------------------

;; Locals and upvalues are known by their bindings' ids; the debug info
;; names them with the plain symbol, for the debugger and eval-in-frame.
(defn- bind-local! [cs b r]
  (let [a (ar cs)
        s (symbol (name (:sym b)))
        inl (nth a INL)]
    (conj! (nth a LOCALS) [(:id b) r])
    ;; (a local of a call being inlined is that call's)
    (if (seq inl)
      (assoc! a INL (conj (pop inl) (update (peek inl) :dbg conj s r)))
      (let [d (nth a DEBUG)] (conj! d s) (conj! d r)))))

;; Code from pc from to pc to runs as a tail call of the function being
;; inlined (pos :itail): it would have replaced that function's frame, so
;; backtraces there don't show it.
(defn- inline-hole! [cs pos from to]
  (when (and (:itail pos) (not (:tail pos)))
    (let [a (ar cs)
          inl (nth a INL)]
      (when (seq inl)
        (assoc! a INL (conj (pop inl) (update (peek inl) :holes conj [from to])))))))

(defn- find-pair [pairs id]
  (loop [i (dec (count pairs))]
    (when (>= i 0)
      (if (= (first (nth pairs i)) id) i (recur (dec i))))))

(defn- first-pair [pairs id]
  (loop [i 0]
    (when (< i (count pairs))
      (if (= (first (nth pairs i)) id) i (recur (inc i))))))

;; Where binding id is from function level `level`, threading captures
;; through the closures in between. → [:reg r] [:up i] [:self] or nil.
(defn- lookup! [cs level id]
  (let [f (nth (nth cs FNS) level)
        locals (nth (nth f FAR) LOCALS)
        ups (nth f UPVALS)
        li (find-pair locals id)
        ui (first-pair ups id)]
    (cond li [:reg (second (nth locals li))]
          (= (nth f SELF-ID) id) [:self]
          ui [:up ui]
          (zero? level) nil
          :else
          (let [outer (lookup! cs (dec level) id)]
            (when outer
              (let [cap (cond (= (first outer) :reg) (* 4 (second outer))
                              (= (first outer) :up) (inc (* 4 (second outer)))
                              :else 2)
                    n (count ups)]
                (when (< n 255)
                  (conj! ups [id cap])
                  [:up n])))))))

(declare gen! gen-fn! gen-do! truncate-locals!)

;;; ---- inlining (M10 part 4) ------------------------------------------------------------------
;;;
;;; A small function defined with def keeps its IR (inlinable, by var, with
;;; the template it compiled to). A call of a var that holds a closure of
;;; that template, with as many arguments as it has parameters, compiles
;;; to the callee's body, its parameters in the argument registers, behind
;;; a guard: if the var holds another function by then (it was redefined),
;;; the call goes the ordinary way. The proto records where each inlined
;;; body is, so backtraces and the debugger show its function.

(def ^:dynamic *inline*
  "Whether calls of small functions are inlined, and tests the types
  prove decided when compiling (part 5.3). The checks against the seed
  compiler, which does neither, bind it false."
  true)

(def ^:private inlinable (atom {}))

;; (IR nodes a body may have, a contract's checking wrapper's more; how deep
;; inlined calls nest; how many registers a function may use before calls
;; stop being inlined into it)
(def ^:private inline-budget 24)
(def ^:private wrapper-budget 96)
(def ^:private inline-depth 3)
(def ^:private inline-max-regs 200)

;; Can node (in a function whose locals in scope are bound, ids) be inlined,
;; within budget n (an atom counting down)? No function, def or letrec in it,
;; no local from outside (a capture) or of the function itself (a call of
;; itself), and recur only inside its own loops.
(defn- inline-ok? [node bound loop? n]
  (swap! n dec)
  (and (>= @n 0)
       (let [op (:op node)]
         (cond (= op :const) true
               (= op :global) true
               (= op :local) (contains? bound (:id (:binding node)))
               (= op :if) (and (inline-ok? (:test node) bound loop? n) (inline-ok? (:then node) bound loop? n)
                               (inline-ok? (:else node) bound loop? n))
               (= op :do) (every? (fn [x] (inline-ok? x bound loop? n)) (:body node))
               (= op :call) (and (inline-ok? (:f node) bound loop? n)
                                 (every? (fn [x] (inline-ok? x bound loop? n)) (:args node)))
               (= op :recur) (and loop? (every? (fn [x] (inline-ok? x bound loop? n)) (:args node)))
               (= op :let) (let [r (reduce (fn [bound [b init]]
                                             (if (and bound (inline-ok? init bound loop? n)) (conj bound (:id b)) nil))
                                           bound (:bindings node))]
                             (and r (inline-ok? (:body node) r (or (:loop node) false) n)))
               :else false))))

;; The arities of fn node a call can inline, by parameter count (a call
;; with that many arguments runs that arity: a fixed one comes first), or
;; nil.
(defn- inline-shape [node budget]
  (let [ok (keep (fn [a]
                   (when (and (not (:variadic a))
                              (inline-ok? (:body a) (set (map :id (:params a))) false (atom budget)))
                     [(:nfixed a) a]))
                 (:arities node))]
    (when (seq ok) (into {} ok))))

;; What a call node of a var inlines, if anything: {:params :body :fname},
;; the arity for its argument count, and the closure the var holds (the
;; guard's).
(defn- inline-for [cs node]
  (let [f (:f node)]
    (when (and *inline* (= :global (:op f))
               (< (nth cs DEPTH) inline-depth)
               (< (nth (ar cs) NEXT) inline-max-regs))
      (when-let [e (get @inlinable (:var f))]
        (let [c (var-get (:var f))
              a (get (:arities e) (count (:args node)))]
          (when (and a (%closure? c) (identical? (%closure-template c) (:template e)))
            [(assoc a :fname (:fname e)) c]))))))

;;; ---- types (M10 part 5.3) -------------------------------------------------------------------
;;;
;;; What kinds of value a node can give, as generating goes: a set of
;;; simple kinds (:nil :true :false :integer :float :ratio :string :char
;;; :keyword :symbol), or nil, unknown (any value, of these kinds or
;;; others). A type is known from a literal, a local bound to something of
;;; known type (an inlined function's parameters are bound to its
;;; arguments'), skein.core's predicates and primitives with fixed result
;;; types, an inlined function's body, and the tests an if has passed. An
;;; if whose test is pure and surely true (or false) generates only that
;;; branch: that's how a contract's check at a call site goes when the
;;; types prove it (%wrapper-source's tests are these predicates).
;;;
;;; skein.core's predicates and primitives are taken as they are when
;;; compiling (decision 11): while each var still holds what it held when
;;; the compiler was loaded. Redefining one affects what's compiled after.

(def ^:private BOOL #{:true :false})

(defn- kind-of
  "The simple kind of constant v, or nil (another kind)."
  [v]
  (cond (nil? v) :nil
        (true? v) :true
        (false? v) :false
        (integer? v) :integer
        (float? v) :float
        (string? v) :string
        (char? v) :char
        (keyword? v) :keyword
        (symbol? v) :symbol
        :else nil))

;; (a var of skein.core, and what it held when the compiler was loaded)
(defn- core-entries [m]
  (into {} (keep (fn [[s x]] (when-let [v (resolve (symbol "skein.core" (name s)))] [v [x (var-get v)]])) m)))

;; Type predicates: the kinds they're true of.
(def ^:private predicates
  (core-entries {'nil? #{:nil} 'string? #{:string} 'integer? #{:integer} 'float? #{:float}
                 'number? #{:integer :float :ratio} 'boolean? BOOL 'true? #{:true} 'false? #{:false}
                 'char? #{:char} 'keyword? #{:keyword} 'symbol? #{:symbol}}))

;; Functions whose value is always of these kinds.
(def ^:private results
  (core-entries {'str #{:string} 'subs #{:string} 'name #{:string} 'pr-str #{:string}
                 '%str-trim #{:string} '%str-case #{:string} '%str-index #{:integer :nil}
                 'count #{:integer} 'keyword #{:keyword} 'symbol #{:symbol}
                 'some? BOOL '= BOOL 'not= BOOL '< BOOL '> BOOL '<= BOOL '>= BOOL '== BOOL
                 'identical? BOOL 'not BOOL 'zero? BOOL 'pos? BOOL 'neg? BOOL 'even? BOOL 'odd? BOOL
                 'empty? BOOL 'contains? BOOL 'nil? BOOL 'string? BOOL 'integer? BOOL 'float? BOOL
                 'number? BOOL 'boolean? BOOL 'true? BOOL 'false? BOOL 'char? BOOL 'keyword? BOOL
                 'symbol? BOOL}))

;; The entry of table m for the var of global node f, while it holds what
;; it did.
(defn- core-entry [m f]
  (when (= :global (:op f))
    (when-let [[x orig] (get m (:var f))]
      (when (identical? (var-get (:var f)) orig) x))))

(defn- t-union [a b] (when (and a b) (into a b)))
(defn- t-sub? [a b] (and a (every? (fn [k] (contains? b k)) a)))
(defn- t-apart? [a b] (and a (not-any? (fn [k] (contains? b k)) a)))

;; (truthy: never nil or false; falsy: only nil or false)
(defn- truthy? [t] (t-apart? t #{:nil :false}))
(defn- falsy? [t] (t-sub? t #{:nil :false}))

;; A predicate's value on an argument of type t.
(defn- pred-type [kinds t]
  (cond (t-sub? t kinds) #{:true}
        (t-apart? t kinds) #{:false}
        :else BOOL))

(def ^:private type-depth 4)

(declare ctype)

;; The type of node with locals' types env (binding id → type), d calls
;; deep into inlinable functions' bodies.
(defn- call-type [env node d]
  (let [f (:f node)
        args (:args node)]
    (if-let [kinds (when (= 1 (count args)) (core-entry predicates f))]
      (pred-type kinds (ctype env (first args) d))
      (or (core-entry results f)
          ;; (an inlinable function the var holds: its body's type, its
          ;; parameters its arguments')
          (when (and (< d type-depth) (= :global (:op f)))
            (when-let [e (get @inlinable (:var f))]
              (let [c (var-get (:var f))
                    a (get (:arities e) (count args))]
                (when (and a (%closure? c) (identical? (%closure-template c) (:template e)))
                  (ctype (reduce (fn [env i] (assoc env (:id (nth (:params a) i)) (ctype env (nth args i) d)))
                                 env (range (count args)))
                         (:body a) (inc d))))))))))

(defn- ctype [env node d]
  (let [op (:op node)]
    (cond (= op :const) (when-let [k (kind-of (:value node))] #{k})
          (= op :local) (get env (:id (:binding node)))
          (= op :call) (call-type env node d)
          (= op :if) (let [tt (ctype env (:test node) d)]
                       (cond (truthy? tt) (ctype env (:then node) d)
                             (falsy? tt) (ctype env (:else node) d)
                             :else (t-union (ctype env (:then node) d) (ctype env (:else node) d))))
          (= op :do) (if (empty? (:body node)) #{:nil} (ctype env (peek (:body node)) d))
          ;; (a loop's locals change from turn to turn: unknown)
          (= op :let) (ctype (reduce (fn [env [b init]] (assoc env (:id b) (when-not (:loop node) (ctype env init d))))
                                     env (:bindings node))
                             (:body node) d)
          :else nil)))

;; Is node free of effects, so that a test of it may be decided when
;; compiling and not run? (constants, locals, predicates of those)
(defn- pure? [node]
  (let [op (:op node)]
    (or (= op :const) (= op :local)
        (and (= op :call) (= 1 (count (:args node))) (some? (core-entry predicates (:f node)))
             (pure? (first (:args node))))
        (and (= op :if) (pure? (:test node)) (pure? (:then node)) (pure? (:else node))))))

;; The types of locals as generating goes (cs's TYPES).
(defn- types [cs] (nth cs TYPES))
(defn- set-types! [cs env] (assoc! cs TYPES env))

;; Call node, inlined: e what it inlines, c the closure the var holds.
(defn- gen-inline! [cs node e c dest pos]
  (let [args (:args node)
        tail (:tail pos)
        env0 (types cs)
        base (alloc! cs)]
    (gen! cs (:f node) base NT)
    (let [regs (mapv (fn [x] (let [r (alloc! cs)] (gen! cs x r NT) r)) args)]
      (emit! cs (abx GUARD base (konst! cs c)))
      (let [jslow (emit! cs (asbx JMP 0 0))
            start (pc cs)
            nlocals (count (nth (ar cs) LOCALS))]
        (push-field! (ar cs) INL {:dbg [] :holes []})
        (assoc! cs DEPTH (inc (nth cs DEPTH)))
        (doseq [i (range (count regs))] (bind-local! cs (nth (:params e) i) (nth regs i)))
        ;; (its parameters' types, its arguments')
        (set-types! cs (reduce (fn [env i] (assoc env (:id (nth (:params e) i)) (ctype env0 (nth args i) 0)))
                               env0 (range (count args))))
        ;; (in tail position its returns are the caller's; a recur in it
        ;; is its own loop's, never the caller's)
        (gen-do! cs (:body e) dest {:tail tail :recur false :itail true})
        (set-types! cs env0)
        (assoc! cs DEPTH (dec (nth cs DEPTH)))
        (truncate-locals! cs nlocals)
        (let [{:keys [dbg holes]} (peek (nth (ar cs) INL))
              _ (pop-field! (ar cs) INL)
              jdone (when-not tail (emit! cs (asbx JMP 0 0)))]
          ;; (the record: the inlined code's pcs, the function, its locals,
          ;; its holes; and the ordinary call after it (its pc, the callee's
          ;; register, the var, the argument count), which restarting the
          ;; inlined frame runs: debug-restart-frame)
          (conj! (nth (ar cs) INLINES) [start (pc cs) (:fname e) dbg holes
                                        (pc cs) base (:var (:f node)) (count args)])
          (patch-jump! cs jslow (pc cs))
          (if tail
            (do (emit! cs (abc TAILCALL base (count args) 0))
                (emit! cs (abc RETURN base 0 0)))
            (do (emit! cs (abc CALL base (count args) 0))
                (when (not= dest base) (emit! cs (abc MOVE dest base 0)))))
          (when jdone (patch-jump! cs jdone (pc cs)))
          ;; (this call, a tail call of a function it's inlined into)
          (inline-hole! cs pos start (pc cs))
          (free-to! cs base))))))

(defn- gen-call! [cs load-fn args dest pos]
  (when (> (count args) 250) (cerr "Too many arguments in one call (max 250)"))
  (let [base (alloc! cs)]
    (load-fn base)
    (doseq [x args]
      (let [r (alloc! cs)] (gen! cs x r NT)))
    (if (:tail pos)
      (do (emit! cs (abc TAILCALL base (count args) 0))
          (emit! cs (abc RETURN base 0 0)))
      (let [at (emit! cs (abc CALL base (count args) 0))]
        (inline-hole! cs pos at (inc at))
        (when (not= dest base) (emit! cs (abc MOVE dest base 0)))))
    (free-to! cs base)))

(defn- gen-local! [cs node dest pos]
  (let [b (:binding node)
        loc (lookup! cs (dec (count (nth cs FNS))) (:id b))]
    (cond (= (first loc) :reg) (when (not= (second loc) dest) (emit! cs (abc MOVE dest (second loc) 0)))
          (= (first loc) :up) (emit! cs (abc GETUP dest (second loc) 0))
          (= (first loc) :self) (emit! cs (abc SELF dest 0 0))
          :else (cerr "Internal error: no place for the local" (pr-str (:sym b))))
    (finish! cs dest pos)))

;; The locals' types in an if's branches, knowing its test held or not:
;; [then else]. (A predicate of a local, or a local itself.)
(defn- refine [env test]
  (let [arg (when (= :call (:op test)) (first (:args test)))
        kinds (when (and arg (= 1 (count (:args test))) (= :local (:op arg))) (core-entry predicates (:f test)))]
    (cond kinds (let [id (:id (:binding arg))
                      t (get env id)]
                  [(assoc env id (if t (set (filter (fn [k] (contains? kinds k)) t)) kinds))
                   (if t (assoc env id (set (remove (fn [k] (contains? kinds k)) t))) env)])
          (and (= :local (:op test)) (get env (:id (:binding test))))
          (let [id (:id (:binding test))
                t (get env id)]
            [(assoc env id (set (remove #{:nil :false} t))) (assoc env id (set (filter #{:nil :false} t)))])
          :else [env env])))

(defn- gen-if! [cs node dest pos]
  (let [test (:test node)
        tt (when *inline* (ctype (types cs) test 0))]
    ;; (a pure test the types decide: only its branch)
    (cond (and (truthy? tt) (pure? test)) (gen! cs (:then node) dest pos)
          (and (falsy? tt) (pure? test)) (gen! cs (:else node) dest pos)
          :else
          (let [t (alloc! cs)
                env (types cs)
                [then-env else-env] (if *inline* (refine env test) [env env])]
            (gen! cs test t NT)
            (free-to! cs t)
            (let [jf (emit! cs (asbx JMPF t 0))]
              (set-types! cs then-env)
              (gen! cs (:then node) dest pos)
              (let [jend (when-not (:tail pos) (emit! cs (asbx JMP 0 0)))]
                (patch-jump! cs jf (pc cs))
                (set-types! cs else-env)
                (gen! cs (:else node) dest pos)
                (set-types! cs env)
                (when jend (patch-jump! cs jend (pc cs)))))))))

(defn- gen-do! [cs node dest pos]
  (let [body (:body node)]
    (if (empty? body)
      (do (load-const! cs dest nil) (finish! cs dest pos))
      (do (doseq [f (butlast body)]
            (let [t (alloc! cs)] (gen! cs f t NT) (free-to! cs t)))
          (gen! cs (peek body) dest pos)))))

(defn- truncate-locals! [cs n]
  (let [l (nth (ar cs) LOCALS)]
    (loop [] (when (> (count l) n) (pop! l) (recur)))))

(defn- gen-let! [cs node dest pos]
  (let [loop? (:loop node)
        mark (nth (ar cs) NEXT)
        nlocals (count (nth (ar cs) LOCALS))
        env0 (types cs)
        regs (reduce (fn [regs [b init]]
                       (let [r (alloc! cs)]
                         (gen! cs init r NT)
                         (bind-local! cs b r)
                         ;; (its type, unless it's a loop's: those change)
                         (when (and *inline* (not loop?))
                           (when-let [t (ctype (types cs) init 0)]
                             (set-types! cs (assoc (types cs) (:id b) t))))
                         (conj regs r)))
                     [] (:bindings node))
        body-pos (if loop?
                   (let [start (pc cs)]
                     (push-field! (ar cs) RECUR [start regs])
                     {:tail (:tail pos) :recur true :itail (:itail pos)})
                   pos)]
    (gen-do! cs (:body node) dest body-pos)
    (set-types! cs env0)
    (when loop? (pop-field! (ar cs) RECUR))
    (truncate-locals! cs nlocals)
    (free-to! cs mark)))

(defn- gen-letrec! [cs node dest pos]
  (let [bs (:bindings node)
        mark (nth (ar cs) NEXT)
        nlocals (count (nth (ar cs) LOCALS))
        regs (mapv (fn [[b _]]
                     (let [r (alloc! cs)]
                       (emit! cs (abc LOADNIL r 0 0))
                       (bind-local! cs b r)
                       r))
                   bs)
        fixups (reduce
                (fn [fx i]
                  (let [caps (gen-fn! cs (second (nth bs i)) (nth regs i) NT)]
                    (reduce (fn [fx j]
                              (let [cap (nth caps j)
                                    r (bit-shift-right cap 2)]
                                (if (and (zero? (bit-and cap 3)) (some (fn [x] (= x r)) regs))
                                  (conj fx [(nth regs i) j r])
                                  fx)))
                            fx (range (count caps)))))
                [] (range (count bs)))]
    (doseq [f fixups] (emit! cs (abc SETUP (nth f 0) (nth f 1) (nth f 2))))
    (gen-do! cs (:body node) dest pos)
    (truncate-locals! cs nlocals)
    (free-to! cs mark)))

(defn- gen-recur! [cs node pos]
  (let [args (:args node)]
    (when-not (:recur pos) (cerr "Can only recur from tail position"))
    (let [t (peek (nth (ar cs) RECUR))]
      (when-not t (cerr "recur outside of loop or fn"))
      (let [start (nth t 0)
            regs (nth t 1)]
        (when (not= (count args) (count regs))
          (cerr (str "Mismatched argument count to recur, expected: " (count regs) " args, got: " (count args))))
        (let [base (nth (ar cs) NEXT)]
          (doseq [x args]
            (let [r (alloc! cs)] (gen! cs x r NT)))
          (doseq [i (range (count regs))]
            (let [src (+ base i) r (nth regs i)]
              (when (not= src r) (emit! cs (abc MOVE r src 0)))))
          (let [at (pc cs)]
            (emit! cs (asbx LOOP 0 (jump-offset at start))))
          (free-to! cs base))))))

(defn- gen-def! [cs node dest pos]
  (let [k (konst! cs (:var node))]
    (when-let [init (:init node)]
      (gen! cs init dest NT)
      ;; (a small function's IR, for calls of it to inline; or forget the
      ;; var's old one)
      (when *inline*
        (let [wrapper? (%str-index (str (:var node)) "%checked" nil false)
              ars (when (= :fn (:op init)) (inline-shape init (if wrapper? wrapper-budget inline-budget)))]
          (if ars
            (swap! inlinable assoc (:var node) {:arities ars :fname (:fname init) :template (nth cs TEMPLATE)})
            (when (contains? @inlinable (:var node)) (swap! inlinable dissoc (:var node))))))
      (emit! cs (abx DEFVAR dest k)))
    (emit! cs (abx LOADK dest k))
    (finish! cs dest pos)))

;; Arity of function context fc, as a proto.
(defn- gen-arity! [cs fc arity fname]
  (let [a (new-arity)]
    (assoc! fc FAR a)
    (assoc! cs CUR a)
    (let [regs (mapv (fn [b] (let [r (alloc! cs)] (bind-local! cs b r) r)) (:params arity))]
      (push-field! a RECUR [0 regs])
      (let [d (alloc! cs)]
        (gen-do! cs (:body arity) d {:tail true :recur true})
        (finish-arity a fname (:nfixed arity) (:variadic arity) d)))))

;; The closure of fn node into dest. Returns its encoded captures.
(defn- gen-fn! [cs node dest pos]
  (let [fns (nth cs FNS)
        fc (transient [(:id (:self node)) (transient []) nil])
        _ (conj! fns fc)
        protos (mapv (fn [a] (gen-arity! cs fc a (:fname node))) (:arities node))
        _ (pop! fns)
        _ (assoc! cs CUR (nth (tpeek fns) FAR))
        caps (mapv second (persistent! (nth fc UPVALS)))
        tmpl (%make-template (when (:named node) (:fname node)) protos caps)]
    (assoc! cs TEMPLATE tmpl) ; (the latest, for gen-def!)
    (emit! cs (abx CLOSURE dest (konst! cs tmpl)))
    (finish! cs dest pos)
    caps))

(defn- gen! [cs node dest pos]
  (let [op (:op node)]
    (cond (= op :const) (do (load-const! cs dest (:value node)) (finish! cs dest pos))
          (= op :local) (gen-local! cs node dest pos)
          (= op :global) (do (emit! cs (abx GETVAR dest (konst! cs (:var node)))) (finish! cs dest pos))
          (= op :call) (if-let [[e c] (inline-for cs node)]
                         (gen-inline! cs node e c dest pos)
                         (gen-call! cs (fn [r] (gen! cs (:f node) r NT)) (:args node) dest pos))
          (= op :if) (gen-if! cs node dest pos)
          (= op :do) (gen-do! cs node dest pos)
          (= op :let) (gen-let! cs node dest pos)
          (= op :fn) (do (gen-fn! cs node dest pos) nil)
          (= op :def) (gen-def! cs node dest pos)
          (= op :recur) (gen-recur! cs node pos)
          (= op :letrec) (gen-letrec! cs node dest pos)
          :else (cerr "Internal error: an IR node with no :op I know:" (pr-str op)))))

;;; ---- entry points -------------------------------------------------------------------------

(defn generate
  "The zero-argument closure that runs IR node (from analyze at top level)."
  [node]
  (let [a (new-arity)
        cs (transient [(transient [(transient [nil (transient []) a])]) nil 0 a {}])
        tl (symbol "<toplevel>")
        dest (alloc! cs)]
    (gen! cs node dest {:tail true :recur false})
    (%make-closure (%make-template tl [(finish-arity a tl 0 false dest)] []))))

(defn compile-toplevel
  "Compile form into a zero-argument closure."
  [form]
  (generate (analyze nil form)))

(defn- top-macro-var [form]
  (when (and (cons? form) (symbol? (first form)) (not (special? (first form))))
    (let [v (resolve (first form))]
      (when (and v (macro? v)) v))))

(defn macroexpand-all-top [form]
  (loop [f form]
    (let [v (top-macro-var f)]
      (if v (recur (expand v f)) f))))

(defn eval
  "Evaluate form: expand it, compile it, run it. A top-level do is evaluated
  form by form. A compile error offers `retry` (e.g. after defining what the
  form needs) and `use-value`."
  [form]
  (let [form (macroexpand-all-top form)]
    (if (and (cons? form) (= (first form) 'do))
      (%eval-all (rest form))
      (let [r (loop []
                (let [r (restart-case [:ok (compile-toplevel form)]
                          (use-value [v] :report "Use a value instead of evaluating the form" [:value v])
                          (retry [] :report "Compile the form again (e.g. after defining what it needs)" [:retry]))]
                  (if (= (first r) :retry) (recur) r)))]
        (if (= (first r) :ok) ((second r)) (second r))))))

(defn %install!
  "Make this compiler the one `eval` (and so load-file, the REPL…) uses."
  []
  (%set-root! (var skein.core/eval) eval)
  :installed)

;;; ---- checking compilers against each other --------------------------------------------------

(declare %signature)

;; Symbols created by gensym differ between two expansions of the same macro;
;; rename every symbol whose name ends in a digit by order of first appearance.
(defn- normalize [x names]
  (cond (and (symbol? x) (nil? (namespace x)) (let [n (name x)] (and (pos? (count n)) (some (fn [d] (= (last n) d)) "0123456789"))))
        (let [m @names]
          (or (get m x) (let [s (symbol (str "g" (count m)))] (swap! names assoc x s) s)))
        (%template? x) (%signature x names)
        (vector? x) (mapv (fn [y] (normalize y names)) x)
        (seq? x) (apply list (map (fn [y] (normalize y names)) x))
        (map? x) (into {} (map (fn [e] [(normalize (first e) names) (normalize (second e) names)]) x))
        (set? x) (set (map (fn [y] (normalize y names)) x))
        :else x))

(defn %signature
  "Compiled code as plain data, for comparing compilers."
  ([f] (%signature (if (%template? f) f (%closure-template f)) (atom {})))
  ([t names]
   (let [tp (%template-parts t)]
     {:name (:name tp)
      :captures (:captures tp)
      :arities (mapv (fn [p]
                       ;; (not :native: whether tier 1 has compiled it yet)
                       (let [pp (dissoc (%proto-parts p) :native)]
                         (assoc pp :consts (normalize (:consts pp) names) :locals (normalize (:locals pp) names))))
                     (:arities tp))})))

(defn compare-compilers
  "Compile every top-level form of source text with both the seed compiler and
  this one (compile only; ns forms are run). Returns the forms that differ."
  [src source-name]
  (let [r (%reader src source-name)
        saved (current-ns)]
    (loop [diffs []]
      (let [f (%read r)]
        (if (%eof? f)
          (do (in-ns saved) diffs)
          (let [f2 (macroexpand-all-top f)]
            (if (and (cons? f2) (symbol? (first f2)) (= (name (first f2)) "in-ns"))
              (do (eval f2) (recur diffs))
              (let [line (%reader-line r)
                    a (try (%signature (%seed-compile f2)) (catch Error e {:error (condition-message e)}))
                    b (try (binding [*inline* false] (%signature (compile-toplevel f2)))
                           (catch Error e {:error (condition-message e)}))]
                (recur (if (= a b) diffs (conj diffs {:form f :line line :seed (:error a) :skein (:error b)})))))))))))
