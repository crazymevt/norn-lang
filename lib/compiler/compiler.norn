;;;; norn.compiler — the Norn compiler, written in Norn (runtime.md §9).
;;;;
;;;; Forms → tier-0 bytecode. It is a faithful port of the Rust seed compiler
;;;; (crates/norn-vm/src/compiler.rs): same kernel forms, same register
;;;; allocation, same constant order, so its output can be checked
;;;; byte-for-byte against the seed's, and against itself (the self-hosting
;;;; fixpoint). Once loaded it becomes `eval`; macros then run as ordinary
;;;; Norn code in the compiling fiber (they can block, and the GC needs no
;;;; pause while compiling).
;;;;
;;;; Compiler state lives in one atom: a stack of function contexts
;;;; {:self-name :upvals [[sym capture]…] :ar arity}, where an arity is
;;;; {:code [] :consts [] :locals [[sym reg]…] :debug […] :next :max :recur […]}.

(ns norn.compiler
  (:refer-core :exclude [eval]))

(defclass CompileError (RuntimeError) ())

(defn- cerr [& msg] (error CompileError :message (apply %message msg)))

;;; ---- instructions (crates/norn-vm/src/bytecode.rs) ---------------------------------

(def MOVE 0) (def LOADK 1) (def LOADI 2) (def LOADNIL 3) (def LOADTRUE 4) (def LOADFALSE 5)
(def GETVAR 6) (def DEFVAR 7) (def GETUP 8) (def SELF 9) (def CLOSURE 10) (def SETUP 11)
(def JMP 12) (def JMPF 13) (def LOOP 14) (def CALL 15) (def TAILCALL 16) (def RETURN 17)

(defn- abc [o a b c] (bit-or o (bit-shift-left a 8) (bit-shift-left b 16) (bit-shift-left c 24)))
(defn- abx [o a bx] (bit-or o (bit-shift-left a 8) (bit-shift-left bx 16)))
(defn- asbx [o a sbx] (abx o a (+ sbx 32768)))
(defn- op-of [i] (bit-and i 255))
(defn- a-of [i] (bit-and (bit-shift-right i 8) 255))

(def ^:private NT {:tail false :recur false})

(def ^:private specials #{"quote" "if" "do" "def" "var" "fn*" "let*" "letrec*" "loop*" "recur" "&"})

(defn- cons? [x] (and (list? x) (some? (seq x))))

(defn- special? [s] (and (nil? (namespace s)) (contains? specials (name s))))

;;; ---- compiler state ------------------------------------------------------------------------

(defn- new-arity [] {:code [] :consts [] :locals [] :debug [] :next 0 :max 0 :recur []})

(defn- ar [cs] (:ar (peek (:fns @cs))))

(defn- upd-fn! [cs f] (swap! cs update :fns (fn [fs] (conj (pop fs) (f (peek fs))))))

(defn- upd-ar! [cs f] (upd-fn! cs (fn [fc] (update fc :ar f))))

(defn- emit! [cs ins]
  (let [n (count (:code (ar cs)))]
    (upd-ar! cs (fn [a] (update a :code conj ins)))
    n))

(defn- pc [cs] (count (:code (ar cs))))

(defn- konst! [cs v]
  (let [ks (:consts (ar cs))
        i (%index-of ks v)]
    (if i
      i
      (do (when (> (count ks) 65535) (cerr "Too many constants in one function"))
          (upd-ar! cs (fn [a] (update a :consts conj v)))
          (count ks)))))

(defn- alloc! [cs]
  (let [r (:next (ar cs))]
    (when (>= r 255) (cerr "Too many registers in one function (expression too complex)"))
    (upd-ar! cs (fn [a] (assoc a :next (inc r) :max (max (:max a) (inc r)))))
    r))

(defn- free-to! [cs r] (upd-ar! cs (fn [a] (assoc a :next r))))

;; Locals are matched by identity (the expander makes each one an uninterned
;; symbol); the debug info names them with the plain symbol, for the
;; debugger and eval-in-frame.
(defn- bind-local! [cs s r]
  (upd-ar! cs (fn [a] (-> a (update :locals conj [s r]) (update :debug conj [(symbol (name s)) r])))))

(defn- jump-offset [from to]
  (let [off (- to (inc from))]
    (when (>= (abs off) 32768) (cerr "Function too large (jump out of range)"))
    off))

(defn- patch-jump! [cs at to]
  (let [off (jump-offset at to)]
    (upd-ar! cs (fn [a]
                  (let [ins (nth (:code a) at)]
                    (assoc-in a [:code at] (asbx (op-of ins) (a-of ins) off)))))))

(defn- finish! [cs dest pos]
  (when (:tail pos) (emit! cs (abc RETURN dest 0 0))))

(defn- finish-arity [a fname nfixed variadic dest]
  (let [code (conj (:code a) (abc RETURN dest 0 0))
        dbg (vec (mapcat (fn [p] [(first p) (second p)]) (:debug a)))
        nregs (max (:max a) (+ nfixed (if variadic 1 0)))]
    (%make-proto fname nfixed variadic nregs (:consts a) code dbg)))

(defn- load-const! [cs dest v]
  (cond (nil? v) (emit! cs (abc LOADNIL dest 0 0))
        (true? v) (emit! cs (abc LOADTRUE dest 0 0))
        (false? v) (emit! cs (abc LOADFALSE dest 0 0))
        (and (integer? v) (>= v -32768) (< v 32768)) (emit! cs (asbx LOADI dest v))
        :else (emit! cs (abx LOADK dest (konst! cs v)))))

;;; ---- name resolution ------------------------------------------------------------------------

(defn- find-pair [pairs sym]
  (loop [i (dec (count pairs))]
    (when (>= i 0)
      (if (identical? (first (nth pairs i)) sym) i (recur (dec i))))))

(defn- first-pair [pairs sym]
  (loop [i 0]
    (when (< i (count pairs))
      (if (identical? (first (nth pairs i)) sym) i (recur (inc i))))))

;; Find sym lexically from function level `level`, threading captures through
;; the closures in between. → [:reg r] [:up i] [:self] or nil.
(defn- lookup! [cs level sym]
  (let [f (nth (:fns @cs) level)
        locals (:locals (:ar f))
        li (find-pair locals sym)
        ui (first-pair (:upvals f) sym)]
    (cond li [:reg (second (nth locals li))]
          (identical? (:self-name f) sym) [:self]
          ui [:up ui]
          (zero? level) nil
          :else
          (let [outer (lookup! cs (dec level) sym)]
            (when outer
              (let [cap (cond (= (first outer) :reg) (* 4 (second outer))
                              (= (first outer) :up) (inc (* 4 (second outer)))
                              :else 2)
                    n (count (:upvals (nth (:fns @cs) level)))]
                (when (< n 255)
                  (swap! cs update-in [:fns level :upvals] conj [sym cap])
                  [:up n])))))))

(defn- lexical? [cs sym]
  (some (fn [f]
          (or (identical? (:self-name f) sym)
              (some (fn [p] (identical? (first p) sym)) (:locals (:ar f)))
              (some (fn [p] (identical? (first p) sym)) (:upvals f))))
        (:fns @cs)))

(defn- macro-var [cs form]
  (when (cons? form)
    (let [h (first form)]
      (when (and (symbol? h)
                 (not (special? h))
                 (not (and (nil? (namespace h)) (lexical? cs h))))
        (let [v (resolve h)]
          (when (and v (macro? v)) v))))))

(defn- expand [v form] (apply (var-get v) (rest form)))

(defn- macroexpand-in [cs form]
  (loop [f form]
    (let [v (macro-var cs f)]
      (if v (recur (expand v f)) f))))

;;; ---- forms ------------------------------------------------------------------------------------

(declare compile! compile-fn!)

(defn- constant? [v]
  (cond (or (symbol? v) (cons? v)) false
        (vector? v) (every? constant? v)
        (map? v) (every? (fn [e] (and (constant? (first e)) (constant? (second e)))) v)
        (set? v) (every? constant? v)
        :else true))

(defn- compile-call! [cs load-fn args dest pos]
  (when (> (count args) 250) (cerr "Too many arguments in one call (max 250)"))
  (let [base (alloc! cs)]
    (load-fn base)
    (doseq [x args]
      (let [r (alloc! cs)] (compile! cs x r NT)))
    (if (:tail pos)
      (do (emit! cs (abc TAILCALL base (count args) 0))
          (emit! cs (abc RETURN base 0 0)))
      (do (emit! cs (abc CALL base (count args) 0))
          (when (not= dest base) (emit! cs (abc MOVE dest base 0)))))
    (free-to! cs base)))

(defn- compile-coll! [cs form dest pos]
  (let [ctor (cond (vector? form) "vector" (map? form) "hash-map" :else "hash-set")
        elems (cond (map? form) (vec (mapcat (fn [e] [(first e) (second e)]) form))
                    :else (vec form))
        v (resolve (symbol "norn.core" ctor))]
    (when-not v (cerr (str "norn.core/" ctor " is not defined")))
    (compile-call! cs (fn [r] (emit! cs (abx GETVAR r (konst! cs v)))) elems dest pos)))

(defn- compile-symbol! [cs sym dest pos]
  (let [loc (when (nil? (namespace sym)) (lookup! cs (dec (count (:fns @cs))) sym))]
    (cond (= (first loc) :reg) (when (not= (second loc) dest) (emit! cs (abc MOVE dest (second loc) 0)))
          (= (first loc) :up) (emit! cs (abc GETUP dest (second loc) 0))
          (= (first loc) :self) (emit! cs (abc SELF dest 0 0))
          :else
          (let [v (resolve sym)]
            (when-not v (cerr (str "Unable to resolve symbol: " (pr-str sym) " in this context" (%interop-hint sym))))
            (when (macro? v) (cerr "Can't take the value of a macro:" (pr-str v)))
            (emit! cs (abx GETVAR dest (konst! cs v)))))
    (finish! cs dest pos)))

(defn- compile-if! [cs xs dest pos]
  (when (or (< (count xs) 3) (> (count xs) 4))
    (cerr "if takes a test, a then-branch and an optional else-branch"))
  (let [t (alloc! cs)]
    (compile! cs (nth xs 1) t NT)
    (free-to! cs t)
    (let [jf (emit! cs (asbx JMPF t 0))]
      (compile! cs (nth xs 2) dest pos)
      (let [jend (when-not (:tail pos) (emit! cs (asbx JMP 0 0)))]
        (patch-jump! cs jf (pc cs))
        (compile! cs (nth xs 3 nil) dest pos)
        (when jend (patch-jump! cs jend (pc cs)))))))

(defn- compile-do! [cs body dest pos]
  (if (empty? body)
    (do (load-const! cs dest nil) (finish! cs dest pos))
    (do (doseq [f (butlast body)]
          (let [t (alloc! cs)] (compile! cs f t NT) (free-to! cs t)))
        (compile! cs (last body) dest pos))))

(defn- binding-pairs [xs what]
  (let [bv (nth xs 1 nil)]
    (when-not (vector? bv) (cerr what "requires a vector for its bindings"))
    (when (odd? (count bv)) (cerr what "requires an even number of forms in its binding vector"))
    (let [pairs (partition 2 bv)]
      (doseq [p pairs]
        (let [s (first p)]
          (when (or (not (symbol? s)) (namespace s))
            (cerr (str "Bad binding form in " what ":") (pr-str s)))))
      pairs)))

(defn- truncate-locals! [cs n] (upd-ar! cs (fn [a] (update a :locals (fn [l] (vec (take n l)))))))

(defn- compile-let! [cs xs dest pos loop?]
  (let [pairs (binding-pairs xs (if loop? "loop" "let"))
        mark (:next (ar cs))
        nlocals (count (:locals (ar cs)))
        regs (reduce (fn [regs p]
                       (let [r (alloc! cs)]
                         (compile! cs (second p) r NT)
                         (bind-local! cs (first p) r)
                         (conj regs r)))
                     [] pairs)
        body-pos (if loop?
                   (let [start (pc cs)]
                     (upd-ar! cs (fn [a] (update a :recur conj [start regs])))
                     {:tail (:tail pos) :recur true})
                   pos)]
    (compile-do! cs (drop 2 xs) dest body-pos)
    (when loop? (upd-ar! cs (fn [a] (update a :recur pop))))
    (truncate-locals! cs nlocals)
    (free-to! cs mark)))

(defn- compile-letrec! [cs xs dest pos]
  (let [pairs (vec (binding-pairs xs "letrec*"))
        mark (:next (ar cs))
        nlocals (count (:locals (ar cs)))
        regs (mapv (fn [p]
                     (let [r (alloc! cs)]
                       (emit! cs (abc LOADNIL r 0 0))
                       (bind-local! cs (first p) r)
                       r))
                   pairs)
        fixups (reduce
                (fn [fx i]
                  (let [init (macroexpand-in cs (second (nth pairs i)))]
                    (when-not (and (cons? init) (symbol? (first init)) (= (name (first init)) "fn*"))
                      (cerr "letrec* bindings must be functions"))
                    (let [caps (compile-fn! cs (vec init) (nth regs i) NT)]
                      (reduce (fn [fx j]
                                (let [cap (nth caps j)
                                      r (bit-shift-right cap 2)]
                                  (if (and (zero? (bit-and cap 3)) (some (fn [x] (= x r)) regs))
                                    (conj fx [(nth regs i) j r])
                                    fx)))
                              fx (range (count caps))))))
                [] (range (count pairs)))]
    (doseq [f fixups] (emit! cs (abc SETUP (nth f 0) (nth f 1) (nth f 2))))
    (compile-do! cs (drop 2 xs) dest pos)
    (truncate-locals! cs nlocals)
    (free-to! cs mark)))

(defn- compile-recur! [cs args pos]
  (when-not (:recur pos) (cerr "Can only recur from tail position"))
  (let [t (peek (:recur (ar cs)))]
    (when-not t (cerr "recur outside of loop or fn"))
    (let [start (nth t 0)
          regs (nth t 1)]
      (when (not= (count args) (count regs))
        (cerr (str "Mismatched argument count to recur, expected: " (count regs) " args, got: " (count args))))
      (let [base (:next (ar cs))]
        (doseq [x args]
          (let [r (alloc! cs)] (compile! cs x r NT)))
        (doseq [i (range (count regs))]
          (let [src (+ base i) r (nth regs i)]
            (when (not= src r) (emit! cs (abc MOVE r src 0)))))
        (let [at (pc cs)]
          (emit! cs (asbx LOOP 0 (jump-offset at start))))
        (free-to! cs base)))))

(def ^:private no-init (atom nil))

(defn- compile-def! [cs xs dest pos]
  (let [sym (nth xs 1 nil)]
    (when-not (symbol? sym) (cerr "First argument to def must be a symbol"))
    (when (and (namespace sym) (not= (namespace sym) (name (current-ns))))
      (cerr "Can't create a var in another namespace with def"))
    (let [v (%intern (current-ns) (symbol (name sym)))
          _ (when-let [defined norn.core/*defined*] (swap! defined conj [(str (current-ns)) (symbol (name sym))]))
          n (count xs)
          init (cond (= n 2) no-init
                     (= n 3) (nth xs 2)
                     (and (= n 4) (string? (nth xs 2))) (nth xs 3)
                     :else (cerr "Too many arguments to def"))
          k (konst! cs v)]
      (when-not (identical? init no-init)
        (compile! cs init dest NT)
        (emit! cs (abx DEFVAR dest k)))
      (emit! cs (abx LOADK dest k))
      (finish! cs dest pos))))

(defn- compile-var! [cs xs dest pos]
  (let [sym (nth xs 1 nil)]
    (when-not (symbol? sym) (cerr "var takes a symbol"))
    (let [v (resolve sym)]
      (when-not v (cerr "Unable to resolve var:" (pr-str sym)))
      (load-const! cs dest v)
      (finish! cs dest pos))))

(defn- compile-arity! [cs sig fname state]
  (upd-fn! cs (fn [fc] (assoc fc :ar (new-arity))))
  (let [ps (first sig)
        body (second sig)
        parsed (loop [k 0 nfixed 0 variadic false regs []]
                 (if (< k (count ps))
                   (let [p (nth ps k)]
                     (when (or (not (symbol? p)) (namespace p)) (cerr "Bad parameter:" (pr-str p)))
                     (if (= (name p) "&")
                       (do (when (not= (+ k 2) (count ps)) (cerr "& must be followed by exactly one parameter"))
                           (recur (inc k) nfixed true regs))
                       (let [r (alloc! cs)]
                         (bind-local! cs p r)
                         (recur (inc k) (if variadic nfixed (inc nfixed)) variadic (conj regs r)))))
                   [nfixed variadic regs]))
        nfixed (nth parsed 0)
        variadic (nth parsed 1)]
    (when (or (and variadic (:variadic state)) (and (not variadic) (some (fn [x] (= x nfixed)) (:fixed state))))
      (cerr "Can't have two overloads with the same arity"))
    (upd-ar! cs (fn [a] (update a :recur conj [0 (nth parsed 2)])))
    (let [d (alloc! cs)]
      (compile-do! cs body d {:tail true :recur true})
      {:protos (conj (:protos state) (finish-arity (ar cs) fname nfixed variadic d))
       :fixed (if variadic (:fixed state) (conj (:fixed state) nfixed))
       :variadic (or variadic (:variadic state))})))

;; (fn* name? [params] body…) or (fn* name? ([params] body…)…). Returns the
;; encoded captures of the new closure.
(defn- compile-fn! [cs xs dest pos]
  (let [named (symbol? (nth xs 1 nil))
        self-name (when named (nth xs 1))
        rst (vec (drop (if named 2 1) xs))
        sigs (cond (empty? rst) (cerr "fn* requires a parameter vector")
                   (vector? (first rst)) [[(first rst) (vec (rest rst))]]
                   :else (mapv (fn [sig]
                                 (let [s (vec sig)]
                                   (if (and (cons? sig) (vector? (first s)))
                                     [(first s) (vec (rest s))]
                                     (cerr "fn* arity must look like ([params] body...)"))))
                               rst))
        fname (when named (symbol (name (current-ns)) (name self-name)))]
    (swap! cs update :fns conj {:self-name self-name :upvals [] :ar (new-arity)})
    (let [st (reduce (fn [st sig] (compile-arity! cs sig fname st)) {:protos [] :fixed [] :variadic false} sigs)
          f (peek (:fns @cs))
          _ (swap! cs update :fns pop)
          caps (mapv second (:upvals f))
          tmpl (%make-template fname (:protos st) caps)]
      (emit! cs (abx CLOSURE dest (konst! cs tmpl)))
      (finish! cs dest pos)
      caps)))

(defn- compile-list! [cs form dest pos]
  (let [h (first form)
        n (when (and (symbol? h) (nil? (namespace h))) (name h))
        xs (when (and n (not= n "&") (contains? specials n)) (vec form))]
    (cond
      (= n "quote") (do (when (not= (count xs) 2) (cerr "quote takes exactly one argument"))
                        (load-const! cs dest (nth xs 1))
                        (finish! cs dest pos))
      (and xs (= n "if")) (compile-if! cs xs dest pos)
      (and xs (= n "do")) (compile-do! cs (vec (rest xs)) dest pos)
      (and xs (= n "def")) (compile-def! cs xs dest pos)
      (and xs (= n "var")) (compile-var! cs xs dest pos)
      (and xs (= n "fn*")) (do (compile-fn! cs xs dest pos) nil)
      (and xs (= n "let*")) (compile-let! cs xs dest pos false)
      (and xs (= n "loop*")) (compile-let! cs xs dest pos true)
      (and xs (= n "letrec*")) (compile-letrec! cs xs dest pos)
      (and xs (= n "recur")) (compile-recur! cs (vec (rest xs)) pos)
      :else
      (let [v (macro-var cs form)]
        (if v
          (compile! cs (expand v form) dest pos)
          (let [items (vec form)]
            (compile-call! cs (fn [r] (compile! cs (first items) r NT)) (vec (rest items)) dest pos)))))))

(defn- compile! [cs form dest pos]
  (cond (symbol? form) (compile-symbol! cs form dest pos)
        (cons? form) (compile-list! cs form dest pos)
        (and (or (vector? form) (map? form) (set? form)) (not (constant? form))) (compile-coll! cs form dest pos)
        :else (do (load-const! cs dest form) (finish! cs dest pos))))

;;; ---- entry points -------------------------------------------------------------------------

(defn compile-toplevel
  "Compile form into a zero-argument closure."
  [form]
  (let [cs (atom {:fns [{:self-name nil :upvals [] :ar (new-arity)}]})
        tl (symbol "<toplevel>")
        dest (alloc! cs)]
    (compile! cs form dest {:tail true :recur false})
    (%make-closure (%make-template tl [(finish-arity (ar cs) tl 0 false dest)] []))))

(defn- top-macro-var [form]
  (when (and (cons? form) (symbol? (first form)) (not (special? (first form))))
    (let [v (resolve (first form))]
      (when (and v (macro? v)) v))))

(defn macroexpand-all-top [form]
  (loop [f form]
    (let [v (top-macro-var f)]
      (if v (recur (expand v f)) f))))

(defn eval
  "Evaluate form: expand it, compile it, run it. A top-level do is evaluated
  form by form. A compile error offers `retry` (e.g. after defining what the
  form needs) and `use-value`."
  [form]
  (let [form (macroexpand-all-top form)]
    (if (and (cons? form) (= (first form) 'do))
      (%eval-all (rest form))
      (let [r (loop []
                (let [r (restart-case [:ok (compile-toplevel form)]
                          (use-value [v] :report "Use a value instead of evaluating the form" [:value v])
                          (retry [] :report "Compile the form again (e.g. after defining what it needs)" [:retry]))]
                  (if (= (first r) :retry) (recur) r)))]
        (if (= (first r) :ok) ((second r)) (second r))))))

(defn %install!
  "Make this compiler the one `eval` (and so load-file, the REPL…) uses."
  []
  (%set-root! (var norn.core/eval) eval)
  :installed)

;;; ---- checking compilers against each other --------------------------------------------------

(declare %signature)

;; Symbols created by gensym differ between two expansions of the same macro;
;; rename every symbol whose name ends in a digit by order of first appearance.
(defn- normalize [x names]
  (cond (and (symbol? x) (nil? (namespace x)) (let [n (name x)] (and (pos? (count n)) (some (fn [d] (= (last n) d)) "0123456789"))))
        (let [m @names]
          (or (get m x) (let [s (symbol (str "g" (count m)))] (swap! names assoc x s) s)))
        (%template? x) (%signature x names)
        (vector? x) (mapv (fn [y] (normalize y names)) x)
        (seq? x) (apply list (map (fn [y] (normalize y names)) x))
        (map? x) (into {} (map (fn [e] [(normalize (first e) names) (normalize (second e) names)]) x))
        (set? x) (set (map (fn [y] (normalize y names)) x))
        :else x))

(defn %signature
  "Compiled code as plain data, for comparing compilers."
  ([f] (%signature (if (%template? f) f (%closure-template f)) (atom {})))
  ([t names]
   (let [tp (%template-parts t)]
     {:name (:name tp)
      :captures (:captures tp)
      :arities (mapv (fn [p]
                       (let [pp (%proto-parts p)]
                         (assoc pp :consts (normalize (:consts pp) names) :locals (normalize (:locals pp) names))))
                     (:arities tp))})))

(defn compare-compilers
  "Compile every top-level form of source text with both the seed compiler and
  this one (compile only; ns forms are run). Returns the forms that differ."
  [src source-name]
  (let [r (%reader src source-name)
        saved (current-ns)]
    (loop [diffs []]
      (let [f (%read r)]
        (if (%eof? f)
          (do (in-ns saved) diffs)
          (let [f2 (macroexpand-all-top f)]
            (if (and (cons? f2) (symbol? (first f2)) (= (name (first f2)) "in-ns"))
              (do (eval f2) (recur diffs))
              (let [line (%reader-line r)
                    a (try (%signature (%seed-compile f2)) (catch Error e {:error (condition-message e)}))
                    b (try (%signature (compile-toplevel f2)) (catch Error e {:error (condition-message e)}))]
                (recur (if (= a b) diffs (conj diffs {:form f :line line :seed (:error a) :norn (:error b)})))))))))))
