;;;; norn.core — the language's core macros and functions.
;;;;
;;;; Loaded by the seed compiler at start-up, on top of the kernel forms
;;;; (quote if do def var fn* let* letrec* loop* recur) and the Rust
;;;; primitives. Collection functions are eager (design.md §3.3) until lazy
;;;; streams and transducers arrive.

;;; ---- evaluation --------------------------------------------------------------

;; `eval` of a top-level (do …) calls this, so each form is compiled only after
;; the previous one ran (a macro defined early can be used later).
(def %eval-all
  (fn* %eval-all [forms]
    (loop* [s (seq forms) last nil]
      (if s (recur (next s) (eval (first s))) last))))

;;; ---- defining things ------------------------------------------------------

(def defmacro
  (fn* defmacro [name & body]
    (let* [body (if (string? (first body)) (rest body) body)]
      `(do (def ~name (fn* ~name ~@body))
           (%set-macro! (var ~name))
           (var ~name)))))
(%set-macro! (var defmacro))

(defmacro defn
  "Define a named function. A docstring may follow the name."
  [name & body]
  (let* [body (if (string? (first body)) (rest body) body)]
    `(def ~name (fn* ~name ~@body))))

(defmacro defn-
  "defn, private to this namespace: other namespaces can't name it (a macro
  of this namespace still may, in its expansion)."
  [name & body]
  `(do (defn ~name ~@body) (%set-private! (var ~name))))
(defmacro fn [& sigs] `(fn* ~@sigs))
(defmacro let [bindings & body] `(let* ~bindings ~@body))
(defmacro loop [bindings & body] `(loop* ~bindings ~@body))
(defmacro declare [& names] `(do ~@(loop* [ns names acc ()]
                                     (if (seq ns)
                                       (recur (rest ns) (cons (list 'def (first ns)) acc))
                                       acc))))
(defmacro comment "(comment …): ignore the forms, giving nil: for notes and examples
  kept in source." [& _] nil)

;;; ---- basics -------------------------------------------------------------------

(defn not "true if x is false or nil, else false." [x] (if x false true))
(defn some? "Is x anything but nil? (True of false too.)" [x] (not (nil? x)))
(defn true? "Is x the value true (not just any truthy value)?" [x] (identical? x true))
(defn false? "Is x the value false? (nil isn't.)" [x] (identical? x false))
(defn identity "x itself." [x] x)
(defn second "The second item of coll, or nil if it has fewer." [coll] (first (next coll)))
(defn ffirst "The first item of coll's first item." [coll] (first (first coll)))
(defn nnext "coll as a seq after its first two items, or nil if nothing is left." [coll]
  (next (next coll)))
(defn empty? "Has coll no items? True of nil and \"\" too." [coll] (not (seq coll)))
(defn not-empty "coll, or nil if it has no items." [coll] (if (seq coll) coll nil))
(defn zero? "Is number n zero (0.0 too)?" [n] (== n 0))
(defn pos? "Is number n above zero?" [n] (> n 0))
(defn neg? "Is number n below zero?" [n] (< n 0))
(defn even? "Is integer n even? A TypeError for a float or a ratio." [n] (zero? (rem n 2)))
(defn odd? "Is integer n odd? A TypeError for a float or a ratio." [n] (not (even? n)))
(defn abs
  "The absolute value of number n, of the same kind: (abs -3) is 3. An
  integer never overflows (it grows into a big one). (abs -0.0) is 0.0."
  [n]
  ;; (-0.0 isn't neg?, but its absolute value is 0.0)
  (if (neg? n) (- n) (if (float? n) (if (zero? n) 0.0 n) n)))
(defn max
  "The greatest of the numbers. Of two that are equal, the later one:
  (max 1 1.0) is 1.0."
  ([x] x) ([x y] (if (> x y) x y)) ([x y & more] (apply max (max x y) more)))
(defn min
  "The least of the numbers. Of two that are equal, the later one:
  (min 1 1.0) is 1.0."
  ([x] x) ([x y] (if (< x y) x y)) ([x y & more] (apply min (min x y) more)))
(defn constantly "A function that takes any arguments and returns x." [x] (fn [& _] x))
(defn complement "A function that returns (not (apply f args)): the opposite of f." [f]
  (fn [& args] (not (apply f args))))

;;; ---- control flow ------------------------------------------------------------

(defmacro when
  "(when test body…): body's last value if test is truthy, else nil."
  [test & body]
  `(if ~test (do ~@body)))
(defmacro when-not
  "(when-not test body…): body's last value if test is falsy, else nil."
  [test & body]
  `(if ~test nil (do ~@body)))
(defmacro if-not
  "(if-not test then else…): then if test is falsy; otherwise the else
  forms' last value (nil without any)."
  [test then & else]
  `(if ~test (do ~@else) ~then))

(defmacro cond
  "(cond test expr …): the expr after the first truthy test, or nil if no
  test is. A last test of :else (any truthy value) gives a default. The
  tests after the one that holds aren't evaluated."
  [& clauses]
  (when (seq clauses)
    (when-not (next clauses)
      (error "cond requires an even number of forms"))
    `(if ~(first clauses)
       ~(second clauses)
       (cond ~@(nnext clauses)))))

(defmacro and
  "(and x…): the first falsy x, evaluating no further, or else the last
  x. (and) is true."
  [& xs]
  (if (seq xs)
    (if (next xs)
      `(let* [and# ~(first xs)] (if and# (and ~@(rest xs)) and#))
      (first xs))
    true))

(defmacro or
  "(or x…): the first truthy x, evaluating no further, or else the last
  x (nil or false). (or) is nil."
  [& xs]
  (if (seq xs)
    (if (next xs)
      `(let* [or# ~(first xs)] (if or# or# (or ~@(rest xs))))
      (first xs))
    nil))

(defmacro if-let [binding then & else]
  `(let* [temp# ~(second binding)]
     (if temp#
       (let* [~(first binding) temp#] ~then)
       (do ~@else))))

(defmacro when-let [binding & body]
  `(let* [temp# ~(second binding)]
     (when temp# (let* [~(first binding) temp#] ~@body))))

(defmacro ->
  "(-> x form…): thread x through the forms as their first argument:
  (-> x (f a) g) is (g (f x a)). A bare symbol f is called as (f x)."
  [x & forms]
  (loop* [x x forms forms]
    (if forms
      (let* [form (first forms)]
        (recur (if (seq? form) `(~(first form) ~x ~@(next form)) (list form x))
               (next forms)))
      x)))

(defmacro ->>
  "(->> x form…): thread x through the forms as their last argument:
  (->> x (f a) g) is (g (f a x)). A bare symbol f is called as (f x)."
  [x & forms]
  (loop* [x x forms forms]
    (if forms
      (let* [form (first forms)]
        (recur (if (seq? form) `(~@form ~x) (list form x))
               (next forms)))
      x)))

(defmacro doto
  "(doto x (f a)…): evaluate x once, call each form with it as the first
  argument ((f x a)), for effect, and return x."
  [x & forms]
  (let* [g (gensym "doto")]
    `(let* [~g ~x]
       ~@(loop* [fs forms acc []]
           (if fs
             (let* [f (first fs)]
               (recur (next fs) (conj acc (if (seq? f) `(~(first f) ~g ~@(next f)) `(~f ~g)))))
             acc))
       ~g)))

(defmacro letfn
  "(letfn [(name [params] body…)…] body…): local functions that can call
  themselves and each other, then body. Each spec is a fn* form (one arity
  or several) whose parameters don't destructure."
  [fnspecs & body]
  `(letrec* ~(loop* [specs fnspecs acc []]
               (if (seq specs)
                 (let* [spec (first specs)]
                   (recur (rest specs) (conj (conj acc (first spec)) `(fn* ~@spec))))
                 acc))
     ~@body))

(defmacro assert
  "(assert x message?): nil if x is truthy; otherwise signal an error
  \"Assert failed: …\" with message (evaluated only then) or x's source."
  [x & msg]
  `(when-not ~x
     (error "Assert failed:" ~(if (seq msg) (first msg) (pr-str x)))))

;;; ---- iteration ------------------------------------------------------------------

(defmacro dotimes
  "(dotimes [i n] body…): run body n times, with i bound to 0, 1, … n-1
  (n is evaluated once). nil."
  [bindings & body]
  (let* [i (first bindings) n (second bindings)]
    `(let* [n# ~n]
       (loop* [~i 0]
         (when (< ~i n#)
           ~@body
           (recur (inc ~i)))))))

(defmacro doseq [bindings & body]
  (let* [x (first bindings) coll (second bindings)]
    `(loop* [s# (seq ~coll)]
       (when s#
         (let* [~x (first s#)] ~@body)
         (recur (next s#))))))

(defmacro while
  "(while test body…): run body as long as test is truthy, testing first. nil."
  [test & body]
  `(loop* [] (when ~test ~@body (recur))))

(defmacro time
  "(time expr): evaluate expr, print \"Elapsed time: … msecs\", and return
  expr's value."
  [expr]
  `(let* [start# (nano-time)
          ret# ~expr]
     (println (str "Elapsed time: " (/ (float (- (nano-time) start#)) 1000000.0) " msecs"))
     ret#))

;;; ---- reduce and friends --------------------------------------------------------

(defn reduce
  ([f coll]
   (let [s (seq coll)]
     (if s (reduce f (first s) (rest s)) (f))))
  ([f init coll]
   (if (%indexed? coll)
     ;; Vectors, ranges: index directly, no per-element allocation.
     (let [n (count coll)]
       (loop [i 0 acc init]
         (if (< i n) (recur (inc i) (f acc (nth coll i))) acc)))
     (loop [s (seq coll) acc init]
       (if s (recur (next s) (f acc (first s))) acc)))))

(defn reduce-kv
  "Reduce map m with (f acc k v) for each entry, from init. (reduced x)
  from f stops early with x. m's items must be [k v] pairs: a vector's
  aren't (there's no index-and-value form, as in Clojure)."
  [f init m]
  (reduce (fn [acc e] (f acc (first e) (second e))) init m))

;; (norn.core's own: reverse may be redefined)
(defn- reverse* [coll] (reduce (fn [acc x] (cons x acc)) () coll))
(defn reverse
  "The items of coll in reverse order, as a list (() for nil or an empty
  coll). Eager: it reads all of coll."
  [coll]
  (reverse* coll))

(defn comp
  "Compose functions: ((comp f g) x…) is (f (g x…)). The last function
  takes the arguments, and each one before it the result of the one after
  it. (comp) is identity."
  ([] identity)
  ([f] f)
  ([f g] (fn [& args] (f (apply g args))))
  ([f g & fs]
   ;; Right to left: the last function first.
   (let [fs (reverse* (cons f (cons g fs)))
         innermost (first fs)
         others (next fs)]
     (fn [& args]
       (loop [gs others acc (apply innermost args)]
         (if gs (recur (next gs) ((first gs) acc)) acc))))))

(defn partial
  "f with the arguments bound given first: ((partial f a) b) is (f a b)."
  [f & bound]
  (fn [& args] (apply f (concat bound args))))

(defn into [to from]
  (if (and (vector? to) (empty? to))
    (vec from)
    (reduce conj to from)))

(defn map
  ([f coll] (reduce (fn [acc x] (conj acc (f x))) [] coll))
  ([f c1 c2]
   (loop [a (seq c1) b (seq c2) acc []]
     (if (and a b)
       (recur (next a) (next b) (conj acc (f (first a) (first b))))
       acc)))
  ([f c1 c2 c3]
   (loop [a (seq c1) b (seq c2) c (seq c3) acc []]
     (if (and a b c)
       (recur (next a) (next b) (next c) (conj acc (f (first a) (first b) (first c))))
       acc))))

(def mapv map)

(defn map-indexed [f coll]
  (loop [s (seq coll) i 0 acc []]
    (if s (recur (next s) (inc i) (conj acc (f i (first s)))) acc)))

(defn filter [pred coll]
  (reduce (fn [acc x] (if (pred x) (conj acc x) acc)) [] coll))
(def filterv filter)
(defn remove [pred coll] (filter (complement pred) coll))
(defn keep [f coll]
  (reduce (fn [acc x] (let [y (f x)] (if (nil? y) acc (conj acc y)))) [] coll))
(defn mapcat
  ([f coll] (reduce (fn [acc x] (into acc (f x))) [] coll))
  ([f c1 c2] (reduce (fn [acc x] (into acc x)) [] (map f c1 c2))))

(defn some
  "The first truthy (pred x) for an item x of coll, or nil if there's none.
  Stops at the first: (some #{2 3} xs) finds the first 2 or 3."
  [pred coll]
  (loop [s (seq coll)]
    (when s (or (pred (first s)) (recur (next s))))))

(defn every?
  "Is (pred x) truthy for every item x of coll? True for an empty coll.
  Stops at the first falsy one."
  [pred coll]
  (loop [s (seq coll)]
    (if s (if (pred (first s)) (recur (next s)) false) true)))

(defn not-any?
  "Is (pred x) falsy for every item x of coll? (not (some pred coll))."
  [pred coll]
  (not (some pred coll)))

(defn take [n coll]
  (loop [s (seq coll) i 0 acc []]
    (if (and s (< i n)) (recur (next s) (inc i) (conj acc (first s))) acc)))

(defn drop [n coll]
  (loop [s (seq coll) i 0]
    (if (and s (< i n)) (recur (next s) (inc i)) (vec s))))

(defn take-while [pred coll]
  (loop [s (seq coll) acc []]
    (if (and s (pred (first s))) (recur (next s) (conj acc (first s))) acc)))

(defn drop-while [pred coll]
  (loop [s (seq coll)]
    (if (and s (pred (first s))) (recur (next s)) (vec s))))

(defn last
  "The last item of coll, or nil if it's empty. A vector's directly;
  anything else is walked to its end."
  [coll]
  (if (vector? coll)
    (peek coll)
    (loop [s (seq coll)] (if (next s) (recur (next s)) (first s)))))

(defn butlast
  "All but coll's last item, as a vector: [] for one item, nil for none."
  [coll]
  (let [v (vec coll)] (if (seq v) (pop v) nil)))

(defn nthnext
  "coll as a seq without its first n items: (nthnext [1 2 3] 1) is (2 3).
  nil when nothing is left."
  [coll n]
  (loop [s (seq coll) n n] (if (and s (pos? n)) (recur (next s) (dec n)) s)))

(defn repeat [n x] (loop [i 0 acc []] (if (< i n) (recur (inc i) (conj acc x)) acc)))

(defn interpose [sep coll]
  (loop [s (seq coll) acc []]
    (if s
      (recur (next s) (if (empty? acc) (conj acc (first s)) (conj (conj acc sep) (first s))))
      acc)))

(defn distinct [coll]
  (loop [s (seq coll) seen #{} acc []]
    (if s
      (let [x (first s)]
        (if (contains? seen x) (recur (next s) seen acc) (recur (next s) (conj seen x) (conj acc x))))
      acc)))

(defn partition [n coll]
  (loop [s (seq coll) acc []]
    (let [chunk (take n s)]
      (if (== (count chunk) n) (recur (nthnext s n) (conj acc chunk)) acc))))

(defn frequencies
  "A map from each distinct item of coll to the number of times it occurs."
  [coll]
  (reduce (fn [m x] (assoc m x (inc (get m x 0)))) {} coll))

(defn group-by
  "A map from each (f x) to the vector of coll's items x that give it, in
  their order in coll."
  [f coll]
  (reduce (fn [m x] (let [k (f x)] (assoc m k (conj (get m k []) x)))) {} coll))

(defn zipmap
  "A map of keys ks to values vs, paired in order, stopping at the shorter.
  A repeated key takes its last value."
  [ks vs]
  (loop [k (seq ks) v (seq vs) m {}]
    (if (and k v) (recur (next k) (next v) (assoc m (first k) (first v))) m)))

;;; ---- maps -----------------------------------------------------------------------

(defn merge
  "The maps merged left to right: a key's value from a later map wins.
  nil maps are skipped; with no maps, or only nil ones, nil."
  [& maps]
  (reduce (fn [acc m] (if m (conj (or acc {}) m) acc)) nil maps))

(defn get-in
  "The value at path ks in nested maps m, or not-found (default nil) if
  any key along it is missing."
  ([m ks] (reduce get m ks))
  ([m ks not-found]
   (loop [m m ks (seq ks)]
     (if ks
       (if (contains? m (first ks)) (recur (get m (first ks)) (next ks)) not-found)
       m))))

(defn assoc-in
  "m with v at path ks in nested maps, making maps for the levels that are
  missing: (assoc-in {} [:a :b] 1) is {:a {:b 1}}. A vector along the
  path takes an index."
  [m ks v]
  (let [k (first ks) more (next ks)]
    (if more (assoc m k (assoc-in (get m k) more v)) (assoc m k v))))

(defn update
  "m with key k's value replaced by (f old args…), old nil when k is
  missing. A vector takes an index for k."
  [m k f & args]
  (assoc m k (apply f (get m k) args)))

(defn update-in
  "m with the value at path ks in nested maps replaced by (f old args…),
  making maps for missing levels (old is then nil)."
  [m ks f & args]
  (assoc-in m ks (apply f (get-in m ks) args)))

(defn select-keys
  "A map of the keys in ks that m has, with their values (nil ones too)."
  [m ks]
  (reduce (fn [acc k] (if (contains? m k) (assoc acc k (get m k)) acc)) {} ks))

;;; ---- sorting --------------------------------------------------------------------

(defn- merge-sort
  "v (a vector) sorted by cmp, stably: a merge sort over index ranges. cmp
  returns a number (as compare does) or is a predicate such as <."
  [cmp v]
  (let [after? (fn [a b] (let [r (cmp a b)] (if (number? r) (pos? r) (if (cmp b a) true false))))
        step (fn step [lo hi]
               (if (< (- hi lo) 2)
                 (if (< lo hi) [(nth v lo)] [])
                 (let [mid (quot (+ lo hi) 2)
                       a (step lo mid)
                       b (step mid hi)
                       na (count a)
                       nb (count b)]
                   (loop [i 0 j 0 acc []]
                     (cond (= i na) (into acc (drop j b))
                           (= j nb) (into acc (drop i a))
                           (after? (nth a i) (nth b j)) (recur i (inc j) (conj acc (nth b j)))
                           :else (recur (inc i) j (conj acc (nth a i))))))))]
    (step 0 (count v))))

(defn sort
  "Stable sort; returns a vector. With the default compare it sorts natively."
  ([coll] (let [v (vec coll)] (%sort-keyed v v)))
  ([cmp coll]
   (let [v (vec coll)]
     (if (identical? cmp compare) (%sort-keyed v v) (merge-sort cmp v)))))

(defn sort-by
  "Stable sort by (keyfn x); returns a vector. keyfn is called once per
  element, and with the default compare the sort is native."
  ([keyfn coll] (sort-by keyfn compare coll))
  ([keyfn cmp coll]
   (let [v (vec coll)]
     (if (identical? cmp compare)
       (%sort-keyed (vec (map keyfn v)) v)
       (merge-sort (fn [a b] (cmp (keyfn a) (keyfn b))) v)))))

;;; ---- loading code ------------------------------------------------------------------

(defn %eval-reader [r]
  (loop [last nil]
    (let [f (%read r)]
      (if (%eof? f) last (recur (eval f))))))

(defn load-string
  "Evaluate every form in s. Like load-file, it restores the current namespace."
  [s]
  (let [ns (current-ns)
        v (%eval-reader (%reader s "<string>"))]
    (in-ns ns)
    v))

(defn load-file
  "Evaluate every form in the file at path, in order, and return the last
  one's value. The current namespace is restored afterwards. A
  FileNotFound if there's no such file."
  [path]
  (let [ns (current-ns)
        v (%eval-reader (%reader (slurp path) path))]
    (in-ns ns)
    v))

;; Root fibers started by the host (REPL, `norn -e`, tests).
;; Unlike load-string, keeps a namespace switch (the host reports it back).
(defn %eval-root [s] (%eval-reader (%reader s "<string>")))
(defn %repl-eval [s]
  (let [r (%reader s "<repl>")]
    (loop []
      (let [f (%read r)]
        (when-not (%eof? f)
          (prn (eval f))
          (recur))))))

;;; ---- concurrency (design.md §6) ---------------------------------------------------

(defmacro spawn
  "Run body in a new fiber inside scope s; returns the fiber."
  [s & body]
  `(%scope-spawn ~s (fn* [] ~@body)))

(defmacro spawn-detached
  "Run body in a new fiber that belongs to no scope."
  [& body]
  `(%spawn (fn* [] ~@body)))

(defn %scope-run [s thunk]
  (let [body (%scope-spawn-body s thunk)]
    (%scope-join s)
    (%scope-result s body)))

(defmacro with-scope
  "(with-scope [s] body…): structured concurrency. body runs in a fiber of a
  new scope bound to s, and the form returns body's value only when every
  fiber spawned in s has finished. If one of them fails with an error
  nobody handled, the others are cancelled and the error is raised here.
  A fiber stopped with cancel! ends quietly, and an error that an await or
  settle has received isn't raised again: the code that awaited it has it.
  (An error is held back while body is running, so body can still await
  or settle that fiber; the scope fails as soon as body waits for anything
  else, or ends.)"
  [binding & body]
  (if (and (vector? binding) (= 1 (count binding)) (symbol? (first binding)))
    `(let* [~(first binding) (%scope)] (%scope-run ~(first binding) (fn* [] ~@body)))
    (error (str "with-scope: expected a binding vector [name], got " (pr-str binding)))))

(defn settle
  "Wait for fiber f without raising: {:value v} or {:error message}. A
  fiber of a scope whose error settle receives doesn't fail the scope."
  [f]
  (%join f)
  (let [e (fiber-error f)]
    (if e {:error e} {:value (await f)})))

;; Atom watches: atom → {key f}. Changes through swap!, reset! and their
;; -vals forms call (f key atom old new); compare-and-set! itself doesn't.
(def %watches (atom {}))
(def %watched (atom 0))

(defn %fire-watches [a old new]
  (loop [ws (seq (get (deref %watches) a))]
    (when ws
      (let [e (first ws)] ((second e) (first e) a old new))
      (recur (next ws)))))

(defn swap!
  "Set atom a to (f old args…) atomically, and return the new value. If
  another change lands first, f is called again with the newer value, so
  it shouldn't have side effects. Calls a's watches."
  [a f & args]
  (loop []
    (let [old (deref a)
          new (apply f old args)]
      (if (compare-and-set! a old new)
        (do (when (pos? (deref %watched)) (%fire-watches a old new)) new)
        (recur)))))

(def >!
  "(>! ch x): put!, under the name core.async gives it. Send x on channel
  ch, parking until there's room or a taker: true, or false if ch is closed."
  put!)
(def <!
  "(<! ch): take!, under the name core.async gives it. The next value from
  channel ch, parking until there is one; nil once ch is closed and empty."
  take!)

(defn- %chunk-size [n]
  (let [parts (* 4 (carrier-count))]
    (max 1 (quot (+ n (dec parts)) parts))))

(defn pmap
  "Parallel map: splits coll into chunks, one fiber per chunk. Order-preserving."
  [f coll]
  (let [v (vec coll) n (count v) size (%chunk-size n)]
    (with-scope [s]
      (let [parts (loop [lo 0 acc []]
                    (if (< lo n)
                      (let [hi (min n (+ lo size))]
                        (recur hi (conj acc (spawn s (loop [j lo out []]
                                                       (if (< j hi) (recur (inc j) (conj out (f (nth v j)))) out))))))
                      acc))]
        (reduce (fn [acc t] (into acc (await t))) [] parts)))))

(defn preduce
  "Parallel reduce: f must be associative and init its identity."
  [f init coll]
  (let [v (vec coll) n (count v) size (%chunk-size n)]
    (with-scope [s]
      (let [parts (loop [lo 0 acc []]
                    (if (< lo n)
                      (let [hi (min n (+ lo size))]
                        (recur hi (conj acc (spawn s (loop [j lo r init]
                                                       (if (< j hi) (recur (inc j) (f r (nth v j))) r))))))
                      acc))]
        (reduce (fn [acc t] (f acc (await t))) init parts)))))

;;; ---- phases (M8 part 8.5) ------------------------------------------------------------
;;;
;;; (for-syntax e): e is code for compile time, one phase up. The expander
;;; resolves its names in compile-time instances of modules; without the
;;; expander (boot, NORN_EXPANDER=off) it's just e.

(def for-syntax
  "(for-syntax e): e as compile-time code, one phase up: the expander
  resolves its names in the compile-time instances of modules (as
  begin-for-syntax and require-for-syntax set them up). defmacro wraps a
  macro's function in it. Without the expander, it's just e."
  (fn* for-syntax [e] e))
(%set-macro! (var for-syntax))

;;; ---- vars -------------------------------------------------------------------------

(defn alter-var-root
  "Set var v's root value to (f old args…), and return the new value. Not
  atomic, unlike swap!: a change made meanwhile by another fiber is lost."
  [v f & args]
  (%set-root! v (apply f (var-get v) args)))

(defmacro ns
  "M0: switch to (creating) a namespace. :require arrives with modules (M6)."
  [name & _]
  `(in-ns '~name))

;;; ---- classes (design.md §4) --------------------------------------------------------
;;;
;;; The runtime provides the shapes and the dispatch hot path (norn-rt clos.rs);
;;; the policy lives here: C3 linearisation, slot inheritance, applicable
;;; methods, specificity and method combination.

(defn- %index-of [v x]
  (loop [i 0 s (seq v)]
    (cond (nil? s) nil
          (identical? (first s) x) i
          :else (recur (inc i) (next s)))))

(defn- %c3-merge [seqs]
  (loop [seqs (filter seq seqs) out []]
    (if (empty? seqs)
      out
      (let [head-ok (fn [h] (not-any? (fn [s] (%index-of (vec (rest s)) h)) seqs))
            cand (some (fn [s] (let [h (first s)] (when (head-ok h) h))) seqs)]
        (when (nil? cand)
          (error "Inconsistent class precedence (no C3 linearisation)"))
        (recur (filter seq (map (fn [s] (if (identical? (first s) cand) (vec (rest s)) s)) seqs))
               (conj out cand))))))

(defn- %compute-cpl [c supers]
  (into [c] (%c3-merge (conj (mapv (fn [s] (%class-get s :cpl)) supers) (vec supers)))))

(defn- %slot-index [slots k]
  (loop [i 0]
    (cond (>= i (count slots)) nil
          (= (:name (nth slots i)) k) i
          :else (recur (inc i)))))

;; Least specific class first, so inherited slots lead the layout; a more
;; specific class's definition of the same slot is merged over the inherited one.
(defn- %effective-slots [cpl]
  (reduce (fn [acc c]
            (reduce (fn [acc sd]
                      (let [i (%slot-index acc (:name sd))]
                        (if i (assoc acc i (merge (nth acc i) sd)) (conj acc sd))))
                    acc
                    (get (%class-get c :meta) :direct-slots [])))
          []
          (reverse cpl)))

(defn- %finalize-class [c]
  (let [cpl (%compute-cpl c (%class-get c :supers))
        slots (%effective-slots cpl)
        keys (mapv :name slots)]
    (%class-set! c :cpl cpl)
    (%class-set! c :slots slots)
    (when (not= keys (%class-get c :layout))
      ;; Instances made before this definition get these values for the
      ;; slots they lack. A slot the old layout had keeps its value; a new
      ;; slot's initform is evaluated now, once, only when instances of the
      ;; class have been made (when it's first defined, none can have been).
      (let [old (zipmap (%class-get c :layout) (%class-defaults c))
            made (%class-flag? c 16)]
        (%class-set-layout! c keys (mapv (fn [sd]
                                           (let [k (:name sd)]
                                             (cond (contains? old k) (get old k)
                                                   (and made (:initform sd)) ((:initform sd))
                                                   :else nil)))
                                         slots))))
    ;; Slots with a :type: making an instance, and setting a slot, check
    ;; them (as contracts, their names resolved when first needed, so a
    ;; slot can name its own class). Without any, flag 8 is clear, and
    ;; nothing is checked or costs anything.
    (let [typed (filter :type slots)]
      (if (seq typed)
        (do (%class-set! c :meta (assoc (%class-get c :meta)
                                        ::slot-types [(reduce (fn [m sd] (assoc m (:name sd) (:type sd))) {} typed) (atom nil)]))
            (%class-hook! c 8))
        (%class-unhook! c 8)))
    ;; The policy the runtime reads (design §3.4, §4.2): identity equality,
    ;; mutability (inherited from any class in the precedence list), slots
    ;; left out of = and hash, and settable slots.
    (let [opts (map (fn [k] (dissoc (%class-get k :meta) :direct-slots)) cpl)
          mutable (some (fn [o] (:mutable o)) opts)
          identity (or mutable (some (fn [o] (= :identity (:equality o))) opts))
          flags (+ (if identity 1 0) (if mutable 2 0))
          excluded (mapv :name (filter (fn [sd] (= false (:compare sd))) slots))
          settable (mapv :name (filter :mutable slots))]
      (when (and (seq settable) (not mutable))
        (error (pr-str (%class-get c :name)) "has :mutable slots, so it needs the (:mutable) class option"))
      (%class-set! c :policy (if (and (zero? flags) (empty? excluded)) nil [flags excluded settable])))
    (doseq [sub (%class-get c :subclasses)] (%finalize-class sub))
    c))

(defn %ensure-class
  "Create class `cname`, or redefine `existing` in place (its identity, and so
  every reference to it, stays valid)."
  [existing cname supers direct-slots opts]
  (let [c (if (class? existing) existing (%class-new cname))
        supers (vec supers)]
    (doseq [s (%class-get c :supers)]
      (%class-set! s :subclasses (vec (remove (fn [x] (identical? x c)) (%class-get s :subclasses)))))
    (doseq [s supers]
      (when-not (class? s) (error "Not a class:" (pr-str s)))
      (%class-set! s :subclasses (conj (vec (remove (fn [x] (identical? x c)) (%class-get s :subclasses))) c)))
    (%class-set! c :supers supers)
    (%class-set! c :meta (assoc opts :direct-slots direct-slots))
    ;; (a metaclass: making the class's instances and reading their slots
    ;; go through the MOP's generic functions, which may specialise on it)
    (%class-set! c :metaclass (:metaclass opts))
    (when (:metaclass opts) (%class-hook! c 6))
    (%finalize-class c)
    (%bump-class-epoch)
    c))

(defn- %defbuiltin [sym supers builtin]
  (let [c (%ensure-class nil (symbol "norn.core" (name sym)) supers [] {})]
    (when builtin (%register-builtin! builtin c))
    c))

(def Object
  "The root class: every value is an Object, nil included. Values with no
  class of their own (a transient, say) have Object as their class."
  (%defbuiltin 'Object [] "object"))
(%register-builtin! "other" Object)
(def Null
  "The class of nil."
  (%defbuiltin 'Null [Object] "null"))
(def Boolean
  "The class of true and false."
  (%defbuiltin 'Boolean [Object] "boolean"))
(def Character
  "The class of characters: \\a, \\newline."
  (%defbuiltin 'Character [Object] "character"))
(def Number
  "The class of numbers, with subclasses Integer, Float and Ratio. No
  value's class is Number itself."
  (%defbuiltin 'Number [Object] nil))
(def Integer
  "The class of integers, small (fixnums) and big alike."
  (%defbuiltin 'Integer [Number] "integer"))
(def Float
  "The class of floating-point numbers (64-bit): 1.5, ##Inf, ##NaN."
  (%defbuiltin 'Float [Number] "float"))
(def Ratio
  "The class of ratios such as 1/3. A ratio that comes out whole, such as
  4/2, is an Integer."
  (%defbuiltin 'Ratio [Number] "ratio"))
(def String
  "The class of strings. A string isn't a Collection, though seq, count
  and nth work on one."
  (%defbuiltin 'String [Object] "string"))
(def Bytes
  "The class of byte strings, as bytes and binary reads make."
  (%defbuiltin 'Bytes [Object] "bytes"))
(def Handle
  "The class of OS handles: the files, sockets and pipes the runtime holds
  open (handle? tests for one)."
  (%defbuiltin 'Handle [Object] "handle"))
(def Regex
  "The class of regular expressions: #\"a+\", re-pattern."
  (%defbuiltin 'Regex [Object] "regex"))
(def Symbol
  "The class of symbols: 'a, 'ns/a."
  (%defbuiltin 'Symbol [Object] "symbol"))
(def Keyword
  "The class of keywords: :a, :ns/a."
  (%defbuiltin 'Keyword [Object] "keyword"))
(def Collection
  "The class of collections, abstract: Sequential ones, maps and sets.
  Strings and nil aren't Collections."
  (%defbuiltin 'Collection [Object] nil))
(def Sequential
  "The class of ordered collections, abstract: lists, vectors, seqs and
  queues."
  (%defbuiltin 'Sequential [Collection] nil))
(def List
  "The class of lists: '(1 2), (), and what cons gives, and seq of a list
  or a map."
  (%defbuiltin 'List [Sequential] "list"))
(def Vector
  "The class of vectors: [1 2]. A map's entries are vectors too."
  (%defbuiltin 'Vector [Sequential] "vector"))
(def Seq
  "The class of seqs over other things: ranges, lazy streams, and seq of a
  vector."
  (%defbuiltin 'Seq [Sequential] "seq"))
(def Queue
  "The class of persistent queues (queue)."
  (%defbuiltin 'Queue [Sequential] "queue"))
(def Map
  "The class of maps, hash and sorted alike: a sorted map is a Map."
  (%defbuiltin 'Map [Collection] "map"))
(def Set
  "The class of sets, hash and sorted alike: a sorted set is a Set."
  (%defbuiltin 'Set [Collection] "set"))
(def Function
  "The class of functions, closures and primitives; GenericFunction is a
  subclass. Keywords, maps and sets can be called but aren't Functions."
  (%defbuiltin 'Function [Object] "function"))
(def GenericFunction
  "The class of generic functions (defgeneric), unless a generic
  function has a class of its own."
  (%defbuiltin 'GenericFunction [Function] "generic-function"))
(def Var
  "The class of vars: (var x), #'x."
  (%defbuiltin 'Var [Object] "var"))
(def Fiber
  "The class of fibers, as spawn and spawn-detached make."
  (%defbuiltin 'Fiber [Object] "fiber"))
(def Channel
  "The class of channels, as chan and timeout make."
  (%defbuiltin 'Channel [Object] "channel"))
(def Atom
  "The class of atoms (atom)."
  (%defbuiltin 'Atom [Object] "atom"))
(def Scope
  "The class of structured-concurrency scopes, as with-scope makes."
  (%defbuiltin 'Scope [Object] "scope"))
(def Class
  "The class of classes, unless a class has a metaclass of its own."
  (%defbuiltin 'Class [Object] "class"))
(def StandardObject
  "The class of objects made with make: the superclass of every
  defclass class that names none. Built-in values aren't
  StandardObjects."
  (%defbuiltin 'StandardObject [Object] nil))

(defn class-name
  "Class c's name, a qualified symbol: norn.core/Integer."
  [c]
  (%class-get c :name))
(defn class-precedence-list
  "Class c and all its superclasses, most specific first (the C3
  linearisation): the order in which methods are chosen for c."
  [c]
  (%class-get c :cpl))
(defn class-direct-superclasses "The superclasses class c names itself, as a vector." [c]
  (%class-get c :supers))
(defn class-direct-subclasses
  "The classes that name class c as a superclass, as a vector."
  [c]
  (%class-get c :subclasses))
(defn class-slots
  "Class c's slots, inherited ones first: a vector of maps with :name and
  :initarg, and :initform (a function), :reader, :type, :doc and so on as
  the defclass forms gave them."
  [c]
  (%class-get c :slots))

(defn- %slot-spec [s]
  (let [s (if (symbol? s) (list s) s)
        sname (first s)
        o (apply hash-map (rest s))
        k (keyword (name sname))
        sd {:name k :initarg (get o :initarg k)}
        sd (if (contains? o :initform) (assoc sd :initform (list 'fn* [] (:initform o))) sd)
        sd (if (:reader o) (assoc sd :reader (list 'quote (:reader o))) sd)
        sd (if (:required o) (assoc sd :required true) sd)
        sd (if (:type o) (assoc sd :type (list 'quote (:type o))) sd)
        sd (if (:doc o) (assoc sd :doc (:doc o)) sd)
        sd (if (:mutable o) (assoc sd :mutable true) sd)
        sd (if (contains? o :compare) (assoc sd :compare (:compare o)) sd)]
    sd))

(defmacro defclass
  "(defclass name (supers…) (slot | (slot :initform x :reader r :initarg :k
  :required true :type t :doc \"…\" :compare false :mutable true)…)
  (:doc \"…\") (:equality :identity) (:mutable)…)

  Instances are immutable values: build them with (name :k v…) or
  (make name :k v…), read with readers, (:k obj) or slot-value, and update
  with (with obj :k v…). Re-evaluating defclass redefines the class in place;
  existing instances see the new definition. An :initform runs when an
  instance needs it (and once when a redefinition adds its slot to
  instances made before). A slot's :type (written as a signature's ^T) is
  checked whenever an instance is made or changed, a ContractError if it
  doesn't hold.

  Equality is structural unless (:equality :identity); a slot with
  :compare false is left out of = and hash. A (:mutable) class's instances
  are owned by the fiber that made them, compare by identity, and have
  their :mutable true slots changed with set-slot! and update-slot!
  (design §4.2)."
  [cname supers slots & options]
  (let [qname (symbol (name (current-ns)) (name cname))
        specs (mapv %slot-spec slots)
        opts (reduce (fn [m o] (if (seq? o) (assoc m (first o) (if (next o) (second o) true)) m)) {} options)
        supers (if (seq supers) (vec supers) ['norn.core/StandardObject])
        ;; (readers are generic functions, so a subclass can specialise one,
        ;; and two classes can each have a reader of the same name)
        readers (keep (fn [s]
                        (let [s (if (symbol? s) (list s) s)
                              r (get (apply hash-map (rest s)) :reader)]
                          (when r `(defmethod ~r ((o# ~cname)) (slot-value o# ~(keyword (name (first s))))))))
                      slots)]
    `(do (def ~cname (%ensure-class (%bound-value '~qname) '~qname ~supers ~specs ~opts))
         ~@readers
         (var ~cname))))

(declare make-instance %check-slot-types)

(defn %make-from
  "An instance of class c from initargs (a seq of :initarg value pairs),
  as the standard make-instance makes it."
  [c initargs]
  (when-not (and (class? c) (subclass? c StandardObject))
    (error "Can't make an instance of" (pr-str (if (class? c) (class-name c) c))))
  (when (odd? (count initargs))
    (error "make expects :initarg value pairs, got" (pr-str initargs)))
  (let [slots (%class-get c :slots)
        args (apply hash-map initargs)]
    (doseq [k (keys args)]
      (when-not (some (fn [sd] (= k (:initarg sd))) slots)
        (error (pr-str (class-name c)) "has no initarg" (pr-str k))))
    (%instance c (mapv (fn [sd]
                         (let [k (:initarg sd)]
                           (cond (contains? args k) (get args k)
                                 (:initform sd) ((:initform sd))
                                 (:required sd) (error "Missing required slot" (pr-str (:name sd))
                                                       "for" (pr-str (class-name c)))
                                 :else nil)))
                       slots))))

(defn make
  "Make an instance of class c from :initarg value pairs. (c :k v…) does the
  same. Through make-instance (M9 part 9.5) when the class's metaclass or
  its initialize-instance methods ask for it."
  [c & initargs]
  ;; (2: the MOP's make-instance; 8: slots with a :type, checked)
  (if (%class-hooked? c 10)
    (if (%class-hooked? c 2)
      (apply make-instance c initargs)
      (%check-slot-types (%make-from c initargs)))
    (%make-from c initargs)))

(defn instance->map "Object o's slots as a map, from slot keyword to value." [o]
  (zipmap (keys o) (vals o)))

;;; ---- generic functions ---------------------------------------------------------------

(defn %eql
  "An eql specializer: the method applies when the argument equals v."
  [v]
  [:eql v])

(defn- %eql-spec? [s] (and (vector? s) (= 2 (count s)) (= :eql (first s))))

(defn- %lambda-shape [params]
  (loop [ps (seq params) n 0]
    (cond (nil? ps) [n false]
          (= (first ps) '&) [n true]
          :else (recur (next ps) (inc n)))))

(defn %ensure-generic-1 [existing gname nreq rest? combination dispatch]
  (if (and (generic? existing)
           (or (and (= nreq (%gf-get existing :nreq)) (= rest? (%gf-get existing :rest)))
               (seq (%gf-get existing :methods))))
    (do (when-not (and (= nreq (%gf-get existing :nreq)) (= rest? (%gf-get existing :rest)))
          (error "Lambda list doesn't match the existing generic function" (pr-str gname)))
        (when-not (= combination (%gf-get existing :combination))
          (%gf-set! existing :combination combination))
        (when-not (= dispatch (%gf-get existing :dispatch))
          (%gf-set! existing :dispatch dispatch))
        existing)
    (%gf-new gname nreq rest? combination dispatch)))

(defn %ensure-generic [existing gname nreq rest? combination dispatch & more]
  (let [gf-class (first more)
        g (%ensure-generic-1 existing gname nreq rest? combination dispatch)]
    (when-not (identical? gf-class (%gf-get g :class)) (%gf-set! g :class gf-class))
    g))

(defmacro defgeneric
  "(defgeneric name (params…) \"doc\"? (:method-combination +)? (:dispatch f)?
  (:generic-function-class C)?)

  Without :dispatch, methods dispatch on the classes of all required
  arguments (and eql specializers). With (:dispatch f), on the value of
  (apply f args), Clojure-multimethod style. With
  (:generic-function-class C), a subclass of StandardGenericFunction, the
  MOP's compute-applicable-methods and compute-effective-method may be
  specialised on C (M9 part 9.5)."
  [gname params & options]
  (let [options (if (string? (first options)) (rest options) options)
        opt (fn [k] (some (fn [o] (when (and (seq? o) (= (first o) k)) (second o))) options))
        shape (%lambda-shape params)
        comb (or (opt :method-combination) :standard)
        comb (if (symbol? comb) (keyword (name comb)) comb)]
    `(def ~gname (%ensure-generic (%bound-value '~(symbol (name (current-ns)) (name gname))) '~(symbol (name (current-ns)) (name gname))
                                  ~(first shape) ~(second shape) ~comb ~(opt :dispatch) ~(opt :generic-function-class)))))

(defn %generic-for-method
  "The generic function a defmethod adds to: the existing one (options kept),
  or a new standard one."
  [existing gname nreq rest?]
  (if (generic? existing)
    (if (and (= nreq (%gf-get existing :nreq)) (= rest? (%gf-get existing :rest)))
      existing
      (error "Method lambda list doesn't match the generic function" (pr-str gname)))
    (%gf-new gname nreq rest? :standard nil)))

(defn- %spec-mask [methods]
  (reduce (fn [mask m]
            (loop [i 0 mask mask s (seq (:specs m))]
              (if s
                (recur (inc i) (if (identical? (first s) Object) mask (bit-or mask (bit-shift-left 1 i))) (next s))
                mask)))
          0 methods))

(defn- %eql-sets [methods nreq]
  (let [sets (reduce (fn [acc m]
                       (loop [i 0 acc acc s (seq (:specs m))]
                         (if s
                           (recur (inc i)
                                  (if (%eql-spec? (first s)) (assoc acc i (conj (or (nth acc i) #{}) (second (first s)))) acc)
                                  (next s))
                           acc)))
                     (vec (repeat nreq nil)) methods)]
    (when (some some? sets) sets)))

(def ^:private %hook-generics
  "Generic function name → the class hook bit a method on it sets (M9 part 9.5)."
  {'norn.core/print-object 1 'norn.core/initialize-instance 2 'norn.core/make-instance 2})

(defn %add-method
  "Add method f to gf (replacing one with the same specializers and
  qualifier). direct: f takes the arguments alone, not a next-method
  function first (its body never calls the next method)."
  [gf specs qualifier f & more]
  ;; (a method for a class of one's own: the hook's way for its instances;
  ;; the standard methods, on Object, StandardObject and StandardClass,
  ;; leave the fast paths alone)
  (when-let [bit (get %hook-generics (%gf-get gf :name))]
    (let [s (first specs)]
      (when (and (class? s) (not (contains? #{"norn.core/Object" "norn.core/StandardObject" "norn.core/Class"} (str (class-name s)))))
        (%class-hook! s bit))))
  (let [m {:specs specs :qualifier qualifier :fn f :direct (if (first more) true false)}]
    (loop []
      (let [old (%gf-get gf :methods)
            new (conj (vec (remove (fn [x] (and (= (:specs x) specs) (= (:qualifier x) qualifier))) old)) m)]
        (if (%gf-cas-methods! gf old new (%spec-mask new) (%eql-sets new (%gf-get gf :nreq)))
          gf
          (recur))))))

(defn %remove-method [gf specs qualifier]
  (loop []
    (let [old (%gf-get gf :methods)
          new (vec (remove (fn [x] (and (= (:specs x) specs) (= (:qualifier x) qualifier))) old))]
      (if (%gf-cas-methods! gf old new (%spec-mask new) (%eql-sets new (%gf-get gf :nreq)))
        gf
        (recur)))))

(defn generic-methods
  "Generic function gf's methods: a vector of maps with :specs (a
  specializer per required parameter), :qualifier (nil, :before, :after,
  :around…) and :fn."
  [gf]
  (%gf-get gf :methods))

(defn %dv-spec
  "Specializer for a custom-dispatch method's dispatch value."
  [dv]
  (cond (= dv :default) Object
        (class? dv) dv
        :else (%eql dv)))

(defn- %uses? [form sym]
  (cond (= form sym) true
        (coll? form) (some (fn [x] (%uses? x sym)) form)
        :else false))

(defn %no-next-method [gname]
  (error "No next method for" (pr-str gname)))

(defmacro defmethod
  "CLOS style:  (defmethod name qualifier? ((x Class) (y (eql v)) z) body…)
  Custom dispatch (gf defined with :dispatch):
                (defmethod name qualifier? dispatch-value [params…] body…)
  Qualifiers: :before :after :around, or the combination's name (+, and, …).
  In the body, (call-next-method) and (next-method?) are available."
  [gname & more]
  (let [i (loop [i 0 s more]
            (cond (nil? s) (error "defmethod" gname "has no parameter list")
                  (or (list? (first s)) (vector? (first s))) i
                  :else (recur (inc i) (next s))))
        clos? (list? (nth more i))
        ;; Custom style: dispatch-value then [params]; the dispatch value may itself be a vector.
        two-vecs? (and (not clos?) (vector? (nth more (inc i) nil)))
        pi (if two-vecs? (inc i) i)
        dv-i (cond clos? nil two-vecs? i :else (dec i))
        _ (when (and (not clos?) (neg? dv-i)) (error "defmethod" gname "needs a dispatch value before [params]"))
        quals (take (if clos? i dv-i) more)
        qualifier (when (seq quals) (let [q (first quals)] (if (symbol? q) (keyword (name q)) q)))
        params (nth more pi)
        body (drop (inc pi) more)
        req (take-while (fn [p] (not= p '&)) params)
        rest-part (drop-while (fn [p] (not= p '&)) params)
        pnames (mapv (fn [p] (if (seq? p) (first p) p)) req)
        specs (if clos?
                (mapv (fn [p]
                        (if (seq? p)
                          (let [s (second p)]
                            (if (and (seq? s) (= (first s) 'eql)) `(%eql ~(second s)) s))
                          'norn.core/Object))
                      req)
                [`(%dv-spec ~(nth more dv-i))])
        lam (into pnames rest-part)
        rest-sym (second rest-part)
        nxt (gensym "next")
        call-next (if rest-sym `(apply ~nxt ~@pnames ~rest-sym) `(~nxt ~@pnames))
        bindings (concat
                  (when (%uses? body 'call-next-method)
                    [(symbol "call-next-method")
                     `(fn* ([] (if ~nxt ~call-next (%no-next-method '~gname)))
                        ([& args#] (if ~nxt (apply ~nxt args#) (%no-next-method '~gname))))])
                  (when (%uses? body 'next-method?)
                    [(symbol "next-method?") `(fn* [] (some? ~nxt))]))
        shape (%lambda-shape params)
        mname (symbol (str (name gname) "-method"))
        ;; A generic function of another namespace (say norn.core's
        ;; on-image-restore) gets the method in place; otherwise def one here.
        own? (and (nil? (namespace gname)) (contains? (or (ns-publics (symbol (name (current-ns)))) {}) gname))
        foreign (when-not own?
                  (let [v (resolve gname)] (when (and v (generic? (var-get v))) v)))
        ;; (a body that never calls the next method gets none: called
        ;; directly, and alone it is the effective method)
        direct? (empty? bindings)
        method (if direct?
                 `(fn* ~mname [~@lam] ~@body)
                 `(fn* ~mname [~nxt ~@lam] (let* [~@bindings] ~@body)))]
    (if foreign
      `(do (%add-method (%generic-for-method (var-get '~foreign) '~gname ~(first shape) ~(second shape))
                        ~specs ~qualifier ~method ~direct?)
           '~foreign)
      `(def ~gname
         (%add-method (%generic-for-method (%bound-value '~(symbol (name (current-ns)) (name gname))) '~(symbol (name (current-ns)) (name gname))
                                           ~(first shape) ~(second shape))
                      ~specs ~qualifier ~method ~direct?)))))

;;; ---- dispatch: the miss path ------------------------------------------------------------
;;;
;;; The interpreter probes a generic function's cache itself (runtime.md §6).
;;; On a miss it calls %gf-miss, which finds the applicable methods, sorts
;;; them by specificity, compiles an effective method for this combination of
;;; argument classes, and caches it.

(defn- %spec-matches? [spec arg]
  (if (%eql-spec? spec) (= arg (second spec)) (instance? spec arg)))

;; Custom dispatch: methods specialise on the dispatch value.
(defn- %dv-matches? [spec dv]
  (cond (%eql-spec? spec) (= dv (second spec))
        (identical? spec Object) true
        (class? dv) (subclass? dv spec)
        :else (instance? spec dv)))

(defn- %spec-cmp [s1 s2 cpl]
  (cond (= s1 s2) 0
        (%eql-spec? s1) -1
        (%eql-spec? s2) 1
        :else (- (or (%index-of cpl s1) 1000000) (or (%index-of cpl s2) 1000000))))

(defn- %method-cmp [cpls]
  (fn [m1 m2]
    (loop [c (seq cpls) x (seq (:specs m1)) y (seq (:specs m2))]
      (if (and c x y)
        (let [r (%spec-cmp (first x) (first y) (first c))]
          (if (zero? r) (recur (next c) (next x) (next y)) r))
        0))))

(defn- %chain
  "A next-method function: calls methods[0] (method maps) with the chain of
  the rest, ending in final."
  [methods final]
  (if (seq methods)
    (let [m (first methods)]
      (if (:direct m)
        (:fn m)
        (let [n (%chain (rest methods) final) f (:fn m)]
          (fn* [& args] (apply f n args)))))
    final))

(def ^:private %combination-ops
  "Method combination name → the operator its primary methods' results are
  combined with (define-method-combination adds to them)."
  (atom {:+ 'norn.core/+ :and 'norn.core/and :or 'norn.core/or :list 'norn.core/list
         :progn 'do :max 'norn.core/max :min 'norn.core/min :vector 'norn.core/vector}))

(defn- %no-applicable [gf]
  (let [gname (%gf-get gf :name)]
    (fn* [& args] (error "No applicable method for" (pr-str gname) "with arguments" (pr-str args)))))

(defn %build-em
  "Compile the effective method for `methods` (applicable, unsorted). cpls:
  the class precedence lists to sort specificity by, one per dispatched position."
  [gf methods cpls]
  (let [gname (%gf-get gf :name)
        comb (%gf-get gf :combination)
        sorted (sort (%method-cmp cpls) methods)
        q (fn [k] (vec (filter (fn [m] (= (:qualifier m) k)) sorted)))
        arounds (q :around)
        prims (if (= comb :standard) (q nil) (into (q nil) (q comb)))
        nreq (%gf-get gf :nreq)
        rest? (%gf-get gf :rest)
        ps (mapv (fn [_] (gensym "a")) (range nreq))
        r (gensym "rest")
        lam (if rest? (conj ps '& r) ps)
        call (fn [m nxt]
               (let [f (:fn m)]
                 (cond (and (:direct m) rest?) `(apply ~f ~@ps ~r)
                       (:direct m) `(~f ~@ps)
                       rest? `(apply ~f ~nxt ~@ps ~r)
                       :else `(~f ~nxt ~@ps))))
        main (cond
               (empty? prims) nil
               (= comb :standard)
               (let [pcall (call (first prims) (%chain (rest prims) nil))
                     befores (q :before)
                     afters (reverse (q :after))]
                 (if (or (seq befores) (seq afters))
                   `(do ~@(map (fn [f] (call f nil)) befores)
                        (let* [result# ~pcall] ~@(map (fn [f] (call f nil)) afters) result#))
                   pcall))
               :else
               (let [op (or (get @%combination-ops comb) (error "Unknown method combination" comb))]
                 `(~op ~@(map (fn [f] (call f nil)) prims))))
        ename (symbol (str (name gname) "-effective"))]
    (cond
      (nil? main) (%no-applicable gf)
      ;; (one primary method and nothing around it: the method itself)
      (and (= comb :standard) (empty? arounds) (= 1 (count prims)) (:direct (first prims))
           (empty? (q :before)) (empty? (q :after)))
      (:fn (first prims))
      (seq arounds)
      (let [inner (eval `(fn* [~@lam] ~main))]
        (eval `(fn* ~ename [~@lam] ~(call (first arounds) (%chain (rest arounds) inner)))))
      :else (eval `(fn* ~ename [~@lam] ~main)))))

(declare compute-applicable-methods compute-effective-method)

(defn %applicable-methods [gf args]
  (filter (fn [m] (every? identity (map %spec-matches? (:specs m) args))) (%gf-get gf :methods)))

(defn %gf-miss [gf & args]
  (let [token (%gf-token gf)
        key (%gf-key gf args)
        cpls (mapv (fn [a] (%class-get (class-of a) :cpl)) args)
        ;; (a generic function of a class of its own: the MOP decides, M9
        ;; part 9.5; else straight here)
        custom (%gf-get gf :class)
        methods (if custom (compute-applicable-methods gf args) (%applicable-methods gf args))
        em (if custom (compute-effective-method gf methods cpls) (%build-em gf methods cpls))]
    (%gf-cache-put! gf token key em)
    (apply em args)))

(defn %gf-dispatch-custom [gf & args]
  (let [dv (apply (%gf-get gf :dispatch) args)
        key [dv]
        em (%gf-cache-get gf key)]
    (if em
      (apply em args)
      (let [token (%gf-token gf)
            methods (filter (fn [m] (%dv-matches? (first (:specs m)) dv)) (%gf-get gf :methods))
            em (%build-em gf methods [(%class-get (if (class? dv) dv (class-of dv)) :cpl)])]
        (%gf-cache-put! gf token key em)
        (apply em args)))))

;;; ---- dynamic bindings and non-local exits (runtime.md §5.4) ------------------------
;;;
;;; The runtime recognises the frames of these functions by identity (see
;;; %register-frame-kinds! below): unwinding to a %catch* runs the cleanups of
;;; every %unwind-protect* frame it passes and restores the dynamic
;;; environment saved by the frames it lands on.

(def %catch* (fn* %catch* [tag thunk dyn] (let* [r (thunk)] r)))
(def %unwind-protect* (fn* %unwind-protect* [body cleanup dyn] (let* [r (body)] (cleanup) r)))
(def %with-bindings*
  (fn* %with-bindings* [new thunk old]
    (%set-dyn! new)
    (let* [r (thunk)] (%set-dyn! old) r)))
(def %finish-unwind
  (fn* %finish-unwind [cleanups dyn mode x args]
    (doseq [c cleanups] (%set-dyn! (nth c 1)) ((nth c 0)))
    (%set-dyn! dyn)
    (cond (= mode :return) x
          (= mode :call) (apply x args)
          :else (%die x args))))

(defn %bind-map [pairs]
  (loop [m (or (%dyn) {}) s (seq pairs)]
    (if s
      (do (%mark-dynamic! (first s)) (recur (assoc m (first s) (second s)) (nnext s)))
      m)))

(defmacro binding
  "Bind vars for the dynamic extent of body, in this fiber and in every fiber
  it spawns (conveyance)."
  [bindings & body]
  (let [pairs (loop [s (seq bindings) acc []]
                (if s (recur (nnext s) (conj (conj acc (list 'var (first s))) (second s))) acc))]
    `(%with-bindings* (%bind-map [~@pairs]) (fn* [] ~@body) (%dyn))))

(defmacro catch-tag
  "(catch-tag tag body…): body's value; but if (throw-tag tag v) is
  called while body runs (in this fiber), unwind to here and give v.
  Tags match by identity; the innermost catch-tag for a tag takes it."
  [tag & body]
  `(%catch* ~tag (fn* [] ~@body) (%dyn)))
(defn throw-tag
  "Unwind to the innermost catch-tag for tag in this fiber (running
  cleanups on the way), which gives value. A RuntimeError if there's none."
  [tag value]
  (%throw tag value))

(defmacro unwind-protect
  "Evaluate form; always run cleanup afterwards, including when the stack is
  unwound past it (errors, restarts, cancellation)."
  [form & cleanup]
  `(%unwind-protect* (fn* [] ~form) (fn* [] ~@cleanup) (%dyn)))

;;; ---- conditions (design.md §5.2) -------------------------------------------------------

(defclass Condition () ((message :initform nil) (trace :initform nil) (location :initform nil))
  (:doc "The root of the condition classes, what signal, error and warn deal in.
  Slots: :message (text, or nil), :trace (the stack, for one the runtime
  raised) and :location (\"file:line\" where it was signalled, when known)."))
(defclass Warning (Condition) ()
  (:doc "A condition warn signals: printed as WARNING: … unless a handler
  muffles it (muffle-warning)."))
(defclass SeriousCondition (Condition) ()
  (:doc "A condition that shouldn't go unhandled: Error's superclass, as in
  Common Lisp."))
(defclass Error (SeriousCondition) ()
  (:doc "The class of errors: what error and the runtime signal, and what
  (catch Error e …) catches. One no handler takes goes to the debugger
  (invoke-debugger)."))
(defclass SimpleError (Error) ()
  (:doc "The error (error \"message\" args…) makes, with just a :message."))

;; What the runtime raises (M9 part 9.13). A handler chooses by class, and
;; reads what went wrong from slots rather than from the message.
;;
;; RuntimeError: an operation the program asked for can't be done as asked
;; (a mistake in the program, usually), with use-value and retry restarts.
(defclass RuntimeError (Error) ()
  (:doc "An operation the program asked for can't be done as asked (usually a
  mistake in the program). Raised from Rust code, with restarts use-value
  (a value for the operation instead) and retry (try it again, after
  fixing something). Its subclasses say more; a runtime error with no
  class of its own is a plain RuntimeError."))
(defclass TypeError (RuntimeError) ((expected :initform nil) (value :initform nil))
  (:doc "A value of the wrong type for an operation: (+ 1 :a). :expected says
  what was wanted (as text) and :value what was given, when known."))
(defclass ArityError (RuntimeError) ((function :initform nil) (given :initform nil))
  (:doc "A function called with the wrong number of arguments: :function is the
  function and :given the number it got."))
(defclass UnboundVarError (RuntimeError) ((var :initform nil))
  (:doc "A var used that has no value (declared, or def'd without one): :var is
  the var. Its retry restart tries again once it's defined."))
(defclass IndexError (RuntimeError) ((index :initform nil))
  (:doc "An index out of range: nth or assoc on a vector, subs, a byte offset.
  :index is the index."))
(defclass ArithmeticError (RuntimeError) ()
  (:doc "Arithmetic with no answer: integer division by zero (/, quot, rem, mod).
  Float division by zero gives ##Inf or ##NaN instead."))

;; IOError: the world outside didn't cooperate. :reason is a keyword
;; (:not-found, :refused, :reset, :timed-out…); :path or :address says
;; where, when it's known.
(defclass IOError (Error) ((path :initform nil) (address :initform nil) (reason :initform nil))
  (:doc "A file, socket or process operation failed. :reason is a keyword
  (:unexpected-end, :invalid-data, :other, or a subclass's), and :path or
  :address says where, when known. Subclasses: FileNotFound,
  PermissionDenied, FileExists, ConnectionError."))
(defclass FileNotFound (IOError) ()
  (:doc "No such file or directory: :reason :not-found, and :path when known."))
(defclass PermissionDenied (IOError) ()
  (:doc "The OS refused access to a file or resource: :reason
  :permission-denied, and :path when known."))
(defclass FileExists (IOError) ()
  (:doc "A file that had to be new already exists: :reason :exists, and :path
  when known."))
(defclass ConnectionError (IOError) ()
  (:doc "A network operation failed: :reason :refused, :reset, :aborted,
  :not-connected, :broken-pipe, :unreachable, :address-in-use,
  :address-not-available or :host-not-found, and :address when known."))
(defclass TlsError (ConnectionError) ()
  (:doc "A TLS handshake or session failed: :reason :tls."))

;; TimeoutError: something didn't happen in time (:after ms, when known). A
;; class of its own, since what timed out needn't be I/O (a future, a
;; channel); an I/O timeout is one too.
(defclass TimeoutError (Error) ((after :initform nil) (reason :initform nil) (address :initform nil))
  (:doc "Something didn't happen in time: :after is the limit in milliseconds,
  when known. An I/O timeout is one too (:reason :timed-out, :address).
  Not an IOError, since what timed out needn't be I/O."))

;; ParseError: text that isn't what it should be (:source, :line, :column
;; where known): Norn source, EDN, JSON, a URI, an HTTP message.
(defclass ParseError (Error) ((source :initform nil) (line :initform nil) (column :initform nil))
  (:doc "Text or data that isn't what it should be: Norn source, JSON, YAML,
  norn.bin, a file read as text that isn't UTF-8. :source, :line and
  :column say where, when known."))

(defn condition-message "Condition c's :message, or nil if it has none." [c] (:message c))
(defn condition-text
  "Condition c as a line of text: its message (or, without one, its class's
  name), after its location and \": \" when that's known."
  [c]
  (let [loc (:location c)
        msg (or (:message c) (str (class-name (class-of c))))]
    (if loc (str loc ": " msg) msg)))

;; Each handler is [class fn owner]. Handlers that unwind (handler-case) can
;; only reach their catch point in the fiber that established them, so other
;; fibers skip them; handler-bind handlers (owner nil) are conveyed.
(def *handlers*
  "The active condition handlers, innermost first, as handler-bind and
  handler-case establish them (each [class handler owner]). Internal, but
  a test runner binds it to nil to run code with no handlers outside it."
  nil)
(def *restarts* nil)
(%set-private! (var *restarts*))
(def *debugger*
  "What happens to a condition no handler takes (see invoke-debugger):
  :park keeps the fiber waiting in the debugger (REPL and editor
  evaluations bind it so); a function is called with the condition, and
  then the fiber ends; nil, the default, just ends the fiber."
  nil)

(defn- %visible? [owner] (or (nil? owner) (identical? owner (current-fiber))))

(defn signal
  "Offer condition c to the active handlers, innermost first. A handler
  declines by returning; while it runs, only the handlers outside it are active."
  [c]
  (loop [hs *handlers*]
    (when hs
      (let [h (first hs) more (next hs)]
        (when (and (%visible? (nth h 2)) (instance? (nth h 0) c))
          (binding [*handlers* more] ((nth h 1) c)))
        (recur more))))
  nil)

(defn- %make-condition [x args]
  (let [c (cond (instance? Condition x) x
                (and (class? x) (subclass? x Condition)) (apply make x args)
                :else (make SimpleError :message (apply %message x args)))]
    (if (:location c) c (with c :location (%location)))))

(defn %abort
  "Unwind this fiber completely (running cleanups) and end it with c."
  [c]
  (%abort-fiber (condition-text c) (or (:trace c) []) c))

(declare %debug-park)

(defn invoke-debugger
  "Hand c to the debugger: *debugger* :park keeps the fiber waiting, a
  function is called with c (a test runner records it), and otherwise the
  fiber ends."
  [c]
  (cond (= *debugger* :park) (%debug-park c)
        (fn? *debugger*) (do (*debugger* c) (%abort c))
        :else (%abort c)))

(defn error
  "Signal an error: (error \"message\" args…), (error SomeErrorClass :k v…) or
  (error condition). If no handler takes it, the debugger does: in a REPL or
  editor the fiber waits with its stack intact; elsewhere the fiber ends."
  [x & args]
  (let [c (%make-condition x args)]
    (signal c)
    (invoke-debugger c)))

(defn throw
  "(throw c): signal condition c, as (error c) does: (throw (ex-info \"Bad\"
  {:id 7})). A message or an error class works too, as error's argument."
  [c]
  (error c))

(declare %restart-case)

(defn warn
  "Signal a warning: (warn \"message\" args…) makes a Warning, (warn
  condition) signals that one. If no handler takes it, print it as
  WARNING: …. A handler can stop the printing with (muffle-warning), which
  invokes the muffle-warning restart warn establishes. nil."
  [x & args]
  (let [c (if (instance? Condition x) x (make Warning :message (apply %message x args)))]
    (%restart-case (fn* []
                     (signal c)
                     (println "WARNING:" (condition-text c)))
                   [{:name 'muffle-warning :report "Don't print this warning" :fn (fn* [] nil)}])
    nil))

(defn %with-handlers [entries thunk]
  ;; (a list, consed onto the handlers outside: signal walks it, and a lazy
  ;; concat per handler-bind made that slow)
  (binding [*handlers* (reduce (fn [acc e] (cons e acc)) *handlers* (reverse* entries))] (thunk)))

(defmacro handler-bind
  "(handler-bind [Class handler …] body…): call handler on matching conditions
  signalled in body, without unwinding. Handlers are conveyed to spawned fibers."
  [bindings & body]
  `(%with-handlers [~@(map (fn [p] `[~(first p) ~(second p) nil]) (partition 2 bindings))] (fn* [] ~@body)))

(defn %handler-case [thunk classes]
  (let [tag (atom nil) ; (any new object: a catch tag is matched by identity)
        me (current-fiber)
        n (count classes)]
    (%catch* tag
             (fn* [] [:ok (%with-handlers (loop [i 0 out []]
                                            (if (< i n)
                                              (recur (inc i) (conj out [(nth classes i) (fn [c] (throw-tag tag [i c])) me]))
                                              out))
                                          thunk)])
             (%dyn))))

(defmacro handler-case
  "(handler-case form (Class [e] body…)…): if a matching condition is
  signalled in form, unwind to here and run that clause."
  [form & clauses]
  (let [r (gensym "r")
        clauses (vec clauses)]
    `(let* [~r (%handler-case (fn* [] ~form) [~@(map first clauses)])]
       (cond (= (first ~r) :ok) (second ~r)
             ~@(apply concat
                      (map (fn [i c]
                             [`(= (first ~r) ~i)
                              `(let* [~@(let [ps (second c)] (if (seq ps) [(first ps) `(second ~r)] []))] ~@(drop 2 c))])
                           (range (count clauses)) clauses))))))

(defmacro try
  "Clojure-style: (try body… (catch Class e handler…)… (finally cleanup…))."
  [& forms]
  ;; Clauses match by name in any namespace: a macro's syntax-quote turns
  ;; catch and finally into ns/catch and ns/finally.
  (let [clause? (fn [f k] (and (seq? f) (symbol? (first f)) (= (name (first f)) (name k))))
        body (remove (fn [f] (or (clause? f 'catch) (clause? f 'finally))) forms)
        catches (filter (fn [f] (clause? f 'catch)) forms)
        fin (some (fn [f] (when (clause? f 'finally) f)) forms)
        hc (if (seq catches)
             `(handler-case (do ~@body) ~@(map (fn [c] `(~(nth c 1) [~(nth c 2)] ~@(drop 3 c))) catches))
             `(do ~@body))]
    (if fin `(unwind-protect ~hc ~@(rest fin)) hc)))

(defmacro ignore-errors
  "(ignore-errors body…): body's value, or nil if an Error is signalled in
  it (unwinding out of body). Warnings pass through."
  [& body]
  `(handler-case (do ~@body) (Error [] nil)))

;;; ---- restarts --------------------------------------------------------------------------------

(defn %with-restarts [rs thunk]
  (binding [*restarts* (concat rs *restarts*)] (thunk)))

(defn %restart-case [thunk specs]
  (let [tag (gensym "restart")
        me (current-fiber)
        rs (map-indexed (fn [i s] (assoc s :tag tag :index i :owner me)) specs)
        r (%catch* tag (fn* [] [:ok (%with-restarts rs thunk)]) (%dyn))]
    (if (= (first r) :ok)
      (second r)
      (apply (:fn (nth specs (first r))) (second r)))))

(defmacro restart-case
  "(restart-case form (name [params] :report \"…\"? body…)…): run form with
  these restarts available; invoking one unwinds to here and runs its body."
  [form & clauses]
  `(%restart-case (fn* [] ~form)
                  [~@(map (fn [c]
                            (let [rname (first c)
                                  params (second c)
                                  body (drop 2 c)
                                  report (when (= (first body) :report) (second body))
                                  body (if report (drop 2 body) body)]
                              `{:name '~rname :report ~report :fn (fn* ~params ~@body)}))
                          clauses)]))

(defn compute-restarts
  "The restarts active in this fiber, innermost first: a vector of maps
  with :name and :report (and more, for invoke-restart)."
  []
  (vec (filter (fn [r] (%visible? (:owner r))) *restarts*)))

(defn find-restart "The innermost active restart named rname (a symbol), or nil." [rname]
  (some (fn [r] (when (= (:name r) rname) r)) (compute-restarts)))

(defn invoke-restart
  "Invoke restart r (one of compute-restarts', or its name) with args:
  unwind to the restart-case that made it and run its body. An error if
  no active restart has that name."
  [r & args]
  (let [r (if (map? r) r (or (find-restart r) (error "No active restart named" (pr-str r))))]
    (throw-tag (:tag r) [(:index r) args])))

(defn muffle-warning
  "Invoke the muffle-warning restart: called from a handler for a warning
  signalled by warn, it stops warn from printing it. (c, the warning, may
  be passed, as in Common Lisp; it isn't needed.) An error when no warning
  is being signalled."
  ([] (invoke-restart 'muffle-warning))
  ([c] (invoke-restart 'muffle-warning)))

(defmacro with-simple-restart
  "(with-simple-restart name report body…): body's value, with a restart
  called name (described by report) that makes the form return nil."
  [rname report & body]
  `(restart-case (do ~@body) (~rname [] :report ~report nil)))

;; A runtime error raised by Rust code is turned into a call to this, in place
;; of the failed operation: its value becomes the operation's value.
(declare OwnershipError)

(defn %runtime-error
  "Signal an error from Rust as a condition: of class cls (a symbol naming
  a norn.core class; none, RuntimeError) with slots from data, or cond
  itself when there's one (a failed fiber's, signalled again)."
  ([msg trace] (%runtime-error msg trace nil nil nil))
  ([msg trace cls data cond]
   (let* [c (if cond
              cond
              (let* [v (when cls (%resolve-in 'norn.core cls))
                     k (if v (var-get v) RuntimeError)]
                (apply make k :message msg :trace trace (mapcat identity data))))
          r (restart-case (error c)
              (use-value [v] :report "Return a value from the failed operation instead" v)
              (retry [] :report "Try the failed operation again (e.g. after defining or fixing something)"
                     (%retry-marker)))]
     r)))

(%register-frame-kinds! %catch* %unwind-protect* %with-bindings* %finish-unwind %runtime-error)

;;; ---- the debugger (design.md §5.3) --------------------------------------------------------
;;;
;;; With *debugger* bound to :park (REPL and editor evaluations, and every
;;; fiber they spawn), an unhandled error parks the fiber here, stack intact.
;;; The REPL or an editor inspects it (backtrace, eval-in-frame), fixes code,
;;; then picks a restart or restarts a frame; the choice arrives on a channel.

(def %debugging (atom {}))

(defn- %describe-restart [r] {:name (str (:name r)) :report (or (:report r) "")})

(defn- %leave-debugger!
  "Fiber id has left the debugger: forget it, and say so to the editors."
  [id]
  (swap! %debugging dissoc id)
  (%post-event (pr-str {:event :resumed :fiber id})))

(defn- %prune-debugging!
  "Forget the fibers that ended while they waited in the debugger
  (cancelled, by Ctrl-C at the REPL or with their scope: they never took
  a command)."
  []
  (doseq [kv @%debugging]
    (when (done? (:fiber (second kv))) (%leave-debugger! (first kv)))))

(defn %in-debugger?
  "Is fiber id (a number) waiting in the debugger?"
  [id]
  (%prune-debugging!)
  (contains? @%debugging id))

(defn- %debug-entry [id]
  (%prune-debugging!)
  (or (get @%debugging id) (error "Fiber" id "is not in the debugger")))

(defn %debug-park [c]
  (let [f (current-fiber)
        id (fiber-id f)
        ;; (room for the one command, so debug-restart and debug-abort
        ;; never wait, even on a fiber that ends meanwhile)
        ch (chan 1)
        rs (compute-restarts)]
    (swap! %debugging assoc id {:fiber f :condition c :restarts rs :chan ch})
    (%post-event (pr-str {:event :debug :fiber id :condition (condition-text c)
                          :class (str (class-name (class-of c)))
                          :restarts (mapv %describe-restart rs)}))
    ;; (one cancelled while it waits here is forgotten by
    ;; %prune-debugging!: a cleanup here would add frames to its backtrace)
    (let [cmd (take! ch)]
      (%leave-debugger! id)
      (cond (= (first cmd) :restart) (apply invoke-restart (nth rs (nth cmd 1)) (nth cmd 2))
            (= (first cmd) :frame) (%restart-frame (nth cmd 1) (nth cmd 2))
            :else (%abort c)))))

(defn debugging
  "Fibers waiting in the debugger."
  []
  (%prune-debugging!)
  (mapv (fn [kv]
          (let [e (second kv)]
            {:fiber (first kv) :condition (condition-text (:condition e))
             :restarts (mapv %describe-restart (:restarts e))}))
        @%debugging))

(defn backtrace
  "Frames of fiber id (waiting in the debugger), top first:
  {:fn name :locals {sym value} :internal? bool}."
  [id]
  (mapv (fn [fr]
          (let [n (:fn fr)]
            {:fn n :locals (:locals fr)
             :internal? (and (symbol? n) (= (namespace n) "norn.core"))}))
        (%frames (:fiber (%debug-entry id)))))

(defn debug-restart
  "Resume fiber id by invoking its restart number i with args."
  [id i & args]
  (put! (:chan (%debug-entry id)) [:restart i args])
  :ok)

(defn debug-restart-frame
  "Resume fiber id by calling frame i's function again — its newest
  definition — with the same arguments."
  [id i]
  (let [e (%debug-entry id)
        fid (:id (nth (%frames (:fiber e)) i))]
    (put! (:chan e) [:frame (nth fid 0) (nth fid 1)])
    :ok))

(defn debug-abort
  "End fiber id (its cleanups run)."
  [id]
  (put! (:chan (%debug-entry id)) [:abort])
  :ok)

(declare *inspecting*)

(defn eval-in-frame
  "Evaluate form with frame i's locals of fiber id bound."
  [id i form]
  (let [fr (nth (%frames (:fiber (%debug-entry id))) i)
        bs (reduce-kv (fn [acc k v] (conj (conj acc k) (list 'quote v))) [] (:locals fr))]
    (binding [*inspecting* true]
      (eval (list 'let* bs form)))))

;;; ---- loading, the REPL, and the editor protocol -------------------------------------------

(def %definitions
  "Every top-level definition read so far, for doc and source: \"ns/name\"
  → {:name :ns :kind :doc :arglists :file :line …attributes}."
  (atom {}))

(defn %note-definition!
  "Record top-level form f, read from file at line, if it defines something
  (its head starts with def and a name follows). text, when given, is the
  form as it was typed (kept for source when file is typed input, not a
  file that can be read again)."
  ([f file line] (%note-definition! f file line nil))
  ([f file line text]
   (when (and (seq? f) (symbol? (first f)) (symbol? (second f)))
     (let [head (name (first f))]
       ;; (a defmethod names its generic function, which it doesn't define)
       (when (and (>= (count head) 3) (= "def" (subs head 0 3)) (not= head "defmethod"))
         (let [nm (second f)
               more (nnext f)
               doc (cond (and (string? (first more)) (next more)) (first more)
                         ;; (defgeneric name (params) "doc" …)
                         (= head "defgeneric") (when (string? (second more)) (second more))
                         ;; (defclass Name (supers) (slots) (:doc "…") …)
                         (= head "defclass")
                         (some (fn [o] (when (and (seq? o) (= :doc (first o)) (string? (second o))) (second o)))
                               (drop 2 more)))
               more (if (and doc (= doc (first more))) (rest more) more)
               attrs (when (map? (first more)) (first more))
               more (if attrs (rest more) more)
               params (first more)
               arglists (cond (contains? #{"defn" "defn-" "defmacro"} head)
                              (cond (vector? params) (list params)
                                    (and (seq? params) (vector? (first params))) (map first more))
                              (= head "defgeneric") (when (or (seq? params) (vector? params)) (list (vec params))))
               typed? (contains? #{"<repl>" "<string>" "<editor>"} file)]
           (swap! %definitions assoc (str (current-ns) "/" nm)
                  (merge attrs {:name nm :ns (str (current-ns)) :kind (first f) :doc doc :arglists arglists
                                :file file :line line :form (when typed? f) :text (when typed? text)}))
           ;; (a protocol's functions, each (name [params] "doc"?))
           (when (= head "defprotocol")
             (doseq [m more :when (and (seq? m) (symbol? (first m)) (vector? (second m)))]
               (swap! %definitions assoc (str (current-ns) "/" (first m))
                      {:name (first m) :ns (str (current-ns)) :kind 'defprotocol
                       :doc (when (string? (nth m 2 nil)) (nth m 2)) :arglists (list (second m))
                       :file file :line line})))))))))

(defn %eval-reader [r]
  (let [src (%reader-name r)
        saved (%location)]
    (loop [last nil]
      (let [f (%read r)]
        (if (%eof? f)
          (do (%set-location! saved) last)
          (do (%set-location! (str src ":" (%reader-line r)))
              (%note-definition! f src (%reader-line r))
              (recur (eval f))))))))

(declare %run-after-eval-hooks)

(defn- %repl-read
  "The next form typed at the terminal REPL (from reader r), noted if it's
  a definition (file \"<repl>\"), with its text as typed, for doc and
  source."
  [r]
  (let [text (%next-form-text r)
        f (%read r)]
    (when-not (%eof? f) (%note-definition! f "<repl>" (%reader-line r) text))
    f))

(defn %repl-eval
  "Evaluate each form of s, typed at the terminal REPL, printing its value."
  [s]
  (binding [*debugger* :park]
    (let [r (%reader s "<repl>")]
      (loop []
        (let [f (%repl-read r)]
          (when-not (%eof? f)
            (prn (eval f))
            (%run-after-eval-hooks)
            (recur)))))))

(declare definition %ensure-core-indexed! *out* %tool-call)

(def %requests "Editor requests running now: id → their fiber (for :interrupt)." (atom {}))

(defn- %serve-run
  "Run thunk for editor request req: it can be interrupted, and what it
  prints streams to the editor as {:event :out :id … :text …}."
  [req thunk]
  (let [id (:id req)]
    (swap! %requests assoc id (current-fiber))
    (try
      (binding [*out* {:out-event id}] (thunk))
      (finally (swap! %requests dissoc id)))))

(defn- %serve-eval
  "Evaluate :code in :ns. With :file and :line, the code is read as if at
  that line of that file, so errors and definitions point at the source."
  [req]
  (in-ns (symbol (or (:ns req) "user")))
  (binding [*debugger* :park]
    (restart-case
      (let [line (max 1 (or (:line req) 1))
            code (str (apply str (repeat (dec line) "\n")) (:code req))
            v (%serve-run req (fn [] (%eval-reader (%reader code (or (:file req) "<editor>")))))]
        (%run-after-eval-hooks)
        {:value (pr-str v) :ns (str (current-ns))})
      (abort [] :report "Abort this evaluation" {:error "Aborted" :ns (str (current-ns))}))))

(defn- %serve-load-file [req]
  (binding [*debugger* :park]
    (restart-case
      (let [v (%serve-run req (fn [] (load-file (:path req))))]
        (%run-after-eval-hooks)
        {:value (pr-str v)})
      (abort [] :report "Abort loading the file" {:error "Aborted"}))))

;; The inspector: values being looked at, by id, so the editor can open the
;; parts of a value (and the parts of those) without printing all of it.
(def %inspected (atom {:next 0 :values {}}))

(defn- %inspect-id [x]
  (let [st (swap! %inspected (fn [st] (let [n (inc (:next st))] (-> st (assoc :next n) (assoc-in [:values n] x)))))]
    (:next st)))

(defn- %inspect-view
  "x for the inspector: {:id :type :value :count :items}, :items being
  [key-text value-text id-or-nil] from offset (up to limit); an id when the
  value can be opened in turn."
  [x offset limit]
  (let [short (fn [v] (let [t (pr-str v)] (if (> (count t) 200) (str (subs t 0 197) "...") t)))
        openable? (fn [v] (or (coll? v) (%instance? v) (and (string? v) (> (count v) 200))))
        item (fn [k v] [(if (string? k) k (short k)) (short v) (when (openable? v) (%inspect-id v))])
        page (fn [xs] (take limit (drop offset xs)))
        items (cond (%instance? x) (mapv (fn [k] (item (str k) (slot-value x k))) (page (%class-get (class-of x) :layout)))
                    (map? x) (mapv (fn [kv] (item (first kv) (second kv))) (page (seq x)))
                    (string? x) (vec (map-indexed (fn [i c] (item (str (+ offset i)) c)) (page (seq x))))
                    (coll? x) (vec (map-indexed (fn [i v] (item (str (+ offset i)) v)) (page (seq x))))
                    :else nil)
        base {:id (%inspect-id x) :type (str (class-name (class-of x))) :value (short x) :offset offset}
        base (if (or (coll? x) (string? x)) (assoc base :count (count x)) base)]
    (if items (assoc base :items items) base)))

(defn- %serve-inspect [req]
  (let [offset (or (:offset req) 0) limit (or (:limit req) 100)]
    (if (:code req)
      (do (in-ns (symbol (or (:ns req) "user")))
          {:inspect (%inspect-view (eval (read-string (:code req))) offset limit)})
      (let [values (:values (deref %inspected))]
        (if (contains? values (:target req))
          {:inspect (%inspect-view (get values (:target req)) offset limit)}
          {:error "Nothing to inspect with that id (cleared?)"})))))

(defn- %printable-definition
  "What is known about a definition, as plain data the editor can read."
  [d]
  (when d
    (into {:name (str (:name d)) :ns (str (:ns d))}
          (filter second
                  [[:kind (when (:kind d) (str (:kind d)))]
                   [:doc (:doc d)]
                   [:arglists (when (:arglists d) (mapv pr-str (:arglists d)))]
                   [:file (:file d)]
                   [:line (:line d)]
                   [:deprecated (when (:deprecated d) (str (:deprecated d)))]]))))

(defn- %serve-definition [req]
  (in-ns (symbol (or (:ns req) "user")))
  (%printable-definition (definition (symbol (:sym req)))))

(defn- %serve-ns-vars
  "Namespace :ns's definitions: those read from source (with file and line)
  and the other public vars."
  [req]
  (%ensure-core-indexed!)
  (let [nsname (:ns req)
        prefix (str nsname "/")
        known (keep (fn [kd] (let [k (first kd)]
                               (when (= prefix (subs k 0 (min (count k) (count prefix)))) (%printable-definition (second kd)))))
                    (deref %definitions))
        named (set (map :name known))
        others (keep (fn [k] (when-not (contains? named (name k)) {:name (name k) :ns nsname}))
                     (keys (or (ns-publics (symbol nsname)) {})))]
    {:vars (vec (sort-by :name (concat known others)))}))

(defn- %serve-test
  "Run test files (:paths) with norn.test: the results as plain data."
  [req]
  (let [r (%serve-run req (fn [] (%tool-call 'norn.test 'run-files (:paths req) :serial (:serial req))))
        clean (fn [e] (reduce (fn [e k] (if (contains? e k) (update e k pr-str) e))
                              (update e :test str)
                              [:form :expected :actual]))]
    {:results (update r :files (fn [fs] (mapv (fn [f] (update f :tests (fn [ts] (mapv (fn [t] (-> t (update :events (fn [es] (mapv clean es))) (update :name str) (update :ns str))) ts)))) fs)))}))

(defn- %complete [prefix nsname]
  (let [names (fn [ns] (map (fn [k] (name k)) (keys (or (ns-publics ns) {}))))
        all (distinct (concat (names (symbol nsname)) (names 'norn.core)))]
    (vec (sort (filter (fn [n] (and (>= (count n) (count prefix)) (= prefix (subs n 0 (count prefix))))) all)))))

(defn- %tool-call
  "Call library function lib/f (loading lib first): the editor's tool ops."
  [lib f & args]
  ((var-get (resolve 'norn.core/require)) lib)
  (apply (var-get (resolve (symbol (name lib) (name f)))) args))

(defn macro-steps
  "Print form's expansion a macro step at a time: each call, what it
  became and the names it introduced, then the full expansion with its
  renamed locals (M8 part 8.9). norn.expand/macro-steps gives the steps as
  data."
  [form]
  (println (%tool-call 'norn.expand 'steps-text (%tool-call 'norn.expand 'macro-steps form))))

(defn %serve-request
  "One editor-protocol request (a map, as a line of Norn data) → the response line."
  [line]
  (let [req (read-string line)
        op (:op req)
        resp (cond
               (= op :eval) (%serve-eval req)
               (= op :load-file) (%serve-load-file req)
               :else
               (handler-case
                 (cond
                   (= op :interrupt) (if-let [f (get (deref %requests) (:target req))]
                                       (do (%interrupt! f) {:value "true"})
                                       {:value "false"})
                   (= op :doc) {:doc (%serve-definition req)}
                   (= op :definition) (or (%serve-definition req) {:error (str "No definition of " (:sym req))})
                   (= op :macroexpand) (do (in-ns (symbol (or (:ns req) "user")))
                                           (let [f (read-string (:code req))]
                                             {:value (pr-str (if (:all req) (macroexpand f) (macroexpand-1 f)))}))
                   (= op :expand-steps) (%tool-call 'norn.expand 'expand-steps-for-editor (:code req) (:ns req))
                   (= op :inspect) (%serve-inspect req)
                   (= op :inspect-clear) (do (reset! %inspected {:next 0 :values {}}) {:value "true"})
                   (= op :ns-vars) (%serve-ns-vars req)
                   (= op :test) (%serve-test req)
                   (= op :debugging) {:value (debugging)}
                   (= op :backtrace) {:frames (mapv (fn [fr] {:fn (str (:fn fr)) :locals (pr-str (:locals fr))
                                                              :internal (:internal? fr)})
                                                    (backtrace (:fiber req)))}
                   (= op :restart) {:value (pr-str (apply debug-restart (:fiber req) (:restart req)
                                                          (load-string (str "[" (or (:args req) "") "]"))))}
                   (= op :restart-frame) {:value (pr-str (debug-restart-frame (:fiber req) (:frame req)))}
                   (= op :abort) {:value (pr-str (debug-abort (:fiber req)))}
                   (= op :eval-in-frame) {:value (pr-str (eval-in-frame (:fiber req) (:frame req) (read-string (:code req))))}
                   (= op :complete) {:completions (%complete (or (:prefix req) "") (or (:ns req) "user"))}
                   (= op :format) {:value (%tool-call 'norn.fmt 'format-string (:code req))}
                   (= op :lint) {:warnings (%tool-call 'norn.lint 'lint-string (:code req) (or (:file req) "<editor>"))}
                   :else {:error (str "Unknown op: " (pr-str op))})
                 (Error [e] {:error (condition-text e)})))]
    (pr-str (assoc resp :id (:id req)))))

(defn %debugger-banner
  "Human-readable summary of fiber id waiting in the debugger (terminal REPL)."
  [id]
  (let [e (%debug-entry id)]
    (str "Fiber " id " is waiting in the debugger: " (condition-text (:condition e)) "\n"
         "  Restarts:\n"
         (apply str (map-indexed (fn [i r] (str "    " i ": [" (:name r) "] " (or (:report r) "") "\n"))
                                 (:restarts e)))
         "  Frames:\n"
         (apply str (map-indexed (fn [i fr]
                                   (when-not (:internal? fr)
                                     (str "    " i ": " (:fn fr) " " (pr-str (:locals fr)) "\n")))
                                 (backtrace id))))))

;;; ---- destructuring ------------------------------------------------------------------------
;;;
;;; Clojure's: vectors ([a b & more :as all]), maps ({:keys [a b] :strs […]
;;; :syms […] :or {a 1} :as m}, {x :k}), nested. A rest map (& {:keys […]})
;;; accepts keyword arguments. `let`, `loop`, `fn`, `defn`, `defmacro` and
;;; `doseq` are redefined below to destructure; with plain symbols they expand
;;; exactly as before.

(declare %destructure-1)

(defn- %destructure-vec [acc pat init]
  (let [g (gensym "vec")]
    (loop [acc (conj (conj acc g) init) i 0 ps (seq pat)]
      (if ps
        (let [p (first ps)]
          (cond (= p '&) (recur (%destructure-1 acc (second ps) (list 'norn.core/nthnext g i)) i (nnext ps))
                (= p :as) (recur (conj (conj acc (second ps)) g) i (nnext ps))
                :else (recur (%destructure-1 acc p (list 'norn.core/nth g i nil)) (inc i) (next ps))))
        acc))))

(defn- %destructure-map [acc pat init]
  (let [g (gensym "map")
        defaults (get pat :or {})
        acc (conj (conj acc g) (list 'norn.core/%as-map init))
        acc (if (contains? pat :as) (conj (conj acc (:as pat)) g) acc)
        entries (concat (map (fn [s] [s (keyword (name s))]) (:keys pat))
                        (map (fn [s] [s (name s)]) (:strs pat))
                        (map (fn [s] [s (list 'quote s)]) (:syms pat))
                        (remove (fn [e] (keyword? (first e))) pat))]
    (reduce (fn [acc e]
              (let [bp (first e)
                    k (second e)
                    getter (if (and (symbol? bp) (contains? defaults bp))
                             (list 'norn.core/get g k (get defaults bp))
                             (list 'norn.core/get g k))]
                (%destructure-1 acc bp getter)))
            acc entries)))

(defn %as-map
  "A rest-argument seq of keyword arguments becomes a map."
  [x]
  (if (seq? x) (apply hash-map x) x))

(defn- %destructure-1 [acc pat init]
  (cond (symbol? pat) (conj (conj acc pat) init)
        (vector? pat) (%destructure-vec acc pat init)
        (map? pat) (%destructure-map acc pat init)
        :else (error "Unsupported binding form:" (pr-str pat))))

(defn destructure
  "Expand a binding vector with patterns into one of plain symbols."
  [bindings]
  (reduce (fn [acc p] (%destructure-1 acc (first p) (second p))) [] (partition 2 bindings)))

(defn- %simple-bindings? [bindings]
  (loop [s (seq bindings)] (if s (if (symbol? (first s)) (recur (nnext s)) false) true)))

(defmacro let
  "(let [binding value …] body…): bind each value in turn (a binding may
  destructure, and sees the ones before it), then body; its last value."
  [bindings & body]
  (if (%simple-bindings? bindings)
    `(let* ~bindings ~@body)
    `(let* ~(destructure bindings) ~@body)))

(defmacro if-let
  "If the test is truthy, bind it (the binding may destructure) and do
  then; else do else."
  [binding then & else]
  `(let* [temp# ~(second binding)]
     (if temp#
       (let [~(first binding) temp#] ~then)
       (do ~@else))))

(defmacro when-let
  "When the test is truthy, bind it (the binding may destructure) and do
  the body."
  [binding & body]
  `(let* [temp# ~(second binding)]
     (when temp# (let [~(first binding) temp#] ~@body))))

(defmacro loop
  "(loop [binding init …] body…): like let, but recur in tail position in
  body jumps back to the top with new values for the bindings. Bindings
  may destructure."
  [bindings & body]
  (if (%simple-bindings? bindings)
    `(loop* ~bindings ~@body)
    (let [pairs (partition 2 bindings)
          gs (mapv (fn [p] (if (symbol? (first p)) (first p) (gensym "loop"))) pairs)]
      `(let* [~@(mapcat (fn [g p] [g (second p)]) gs pairs)]
         (loop* [~@(mapcat (fn [g] [g g]) gs)]
           (let [~@(mapcat (fn [g p] [(first p) g]) gs pairs)] ~@body))))))

;; One arity: [params] body… → params of plain symbols, patterns let-bound.
(defn- %fn-arity [sig]
  (let [ps (first sig)
        body (rest sig)]
    (if (every? symbol? ps)
      sig
      (let [new (mapv (fn [p] (if (symbol? p) p (gensym "p"))) ps)
            binds (vec (mapcat (fn [p g] (when-not (symbol? p) [p g])) ps new))]
        (list new `(let ~binds ~@body))))))

(defmacro fn
  "(fn name? [params] body…) or (fn name? ([params] body…)…): a function,
  of one arity or several. Parameters may destructure; with name, the
  body can call the function itself by it."
  [& sigs]
  (let [nm (when (symbol? (first sigs)) (first sigs))
        sigs (if nm (rest sigs) sigs)]
    (if (vector? (first sigs))
      (let [a (%fn-arity sigs)] `(fn* ~@(when nm [nm]) ~@a))
      `(fn* ~@(when nm [nm]) ~@(map %fn-arity sigs)))))

(defmacro defn
  "Define a named function. A docstring may follow the name. Parameters
  destructure."
  [fname & body]
  (let [body (if (string? (first body)) (rest body) body)
        body (if (map? (first body)) (rest body) body)]
    `(def ~fname (fn ~fname ~@body))))

(def %indent-hints
  "Macro name → its {:indent n} hint, for norn fmt: n arguments, then a body
  indented by two."
  (atom {}))

(defn %set-indent! [sym n] (swap! %indent-hints assoc (name sym) n))

(defmacro defmacro
  "Define a macro. A docstring may follow the name, then an attribute map:
  {:indent n} tells norn fmt to indent the body after n arguments by two."
  [mname & body]
  (let [body (if (string? (first body)) (rest body) body)
        attrs (when (map? (first body)) (first body))
        body (if attrs (rest body) body)]
    `(do (def ~mname (for-syntax (fn ~mname ~@body)))
         (%set-macro! (var ~mname))
         ~@(when (:indent attrs) [`(%set-indent! '~mname ~(:indent attrs))])
         (var ~mname))))

(def %for-stop "What a for or doseq step gives when its :while test fails." (%uninterned-symbol "stop"))

(defn %comprehension-check
  "An error unless bindings, a for or doseq binding vector, is pairs of a
  binding and a collection, or :let, :when or :while and its form (a
  :while after a binding: it stops that binding)."
  [what bindings]
  (when (odd? (count bindings))
    (error what "requires an even number of forms in its binding vector"))
  (loop [ps (partition 2 bindings) seen-binding false]
    (when-let [[a _] (first ps)]
      (cond (= a :while)
            (if seen-binding
              (recur (rest ps) true)
              (error what ":while must come after a binding: it stops the binding before it"))
            (contains? #{:let :when} a) (recur (rest ps) seen-binding)
            (keyword? a) (error what "doesn't know" (str a) "(it takes :let, :when and :while)")
            :else (recur (rest ps) true)))))

(defn- %while-follows?
  "Is there a :while among the modifiers that start bindings (before the
  next binding)?"
  [bindings]
  (loop [bs (seq bindings)]
    (cond (empty? bs) false
          (= (first bs) :while) true
          (contains? #{:let :when} (first bs)) (recur (nnext bs))
          :else false)))

(defn %doseq-emit [bindings body]
  (if (empty? bindings)
    `(do ~@body)
    (let [[a b & more] bindings]
      (cond (= a :let) `(let ~b ~(%doseq-emit more body))
            (= a :when) `(when ~b ~(%doseq-emit more body))
            ;; (stops the loop of the binding before it; nil otherwise)
            (= a :while) `(if ~b ~(%doseq-emit more body) %for-stop)
            (%while-follows? more)
            (let [s (gensym "s") r (gensym "r")]
              `(loop* [~s (seq ~b)]
                 (when ~s
                   (let* [~r (let [~a (first ~s)] ~(%doseq-emit more body))]
                     (when-not (identical? ~r %for-stop)
                       (recur (next ~s)))))))
            :else (let [s (gensym "s")]
                    `(loop* [~s (seq ~b)]
                       (when ~s
                         (let [~a (first ~s)] ~(%doseq-emit more body))
                         (recur (next ~s)))))))))

(defmacro doseq
  "Run body for each binding of the names, for its effects; nil. As for:
  (doseq [x xs y ys :when (odd? x) :let [z (* x y)] :while (< z 10)] …)
  nests, left to right, and bindings destructure."
  [bindings & body]
  (%comprehension-check "doseq" (vec bindings))
  (%doseq-emit (vec bindings) body))

;;; ---- images (design §7) ------------------------------------------------------------------
;;;
;;; (save-image "app.nimg" :entry #'app/main) writes the running heap to a
;;; file; `norn --image app.nimg` starts from it. Parked fibers are saved with
;;; their stacks and carry on after the restore; the fiber that saves does not.
;;;
;;; External resources (sockets, files, FFI handles) can't survive a restore.
;;; Code that owns one registers it; after a restore it is dead until
;;; reconnected, either eagerly by an on-image-restore method or lazily: a
;;; fiber that calls (ensure-live r) on a dead resource gets a ResourceLost
;;; error with `reconnect` and `abort` restarts.

(def %image-entry nil)
(def %image-generation 0)
;; [weak-ref generation-atom] per registered resource: registering a resource
;; doesn't keep it alive.
(def %resources (atom []))

(defclass ResourceLost (Error) ((resource :initform nil))
  (:doc "ensure-live found :resource dead after an image restore (no
  on-image-restore method reconnected it). Restarts: reconnect, abort."))

(defgeneric on-image-restore (resource)
  "Called on every registered resource after the image it lives in has been
  restored, before the entry function or REPL starts. A method that
  reconnects the resource returns true; the default does nothing.")
(defmethod on-image-restore (r) nil)

(defgeneric reconnect (resource)
  "Re-open a resource lost in an image restore (the `reconnect` restart).
  Returns the live resource: the same one, or a replacement (an OS handle
  can't be reopened in place).")

(defn register-resource!
  "Track external resource r for image restores (weakly). Returns r."
  [r]
  (let [e [(weak-ref r) (atom %image-generation)]]
    (swap! %resources (fn [es] (conj (filterv (fn [e] (some? (weak-get (first e)))) es) e))))
  r)

(defn- %resource-entry [r]
  (some (fn [e] (when (identical? (weak-get (first e)) r) e)) @%resources))

(defn resource-live?
  "False for a resource lost in an image restore and not yet reconnected: a
  registered one, or an OS handle (file, socket, pipe) opened before the
  restore."
  [r]
  (if (handle? r)
    (%handle-current? r)
    (let [e (%resource-entry r)]
      (or (nil? e) (= @(second e) %image-generation)))))

(defn- %mark-live! [r]
  (when-let [e (%resource-entry r)] (reset! (second e) %image-generation)))

(defn ensure-live
  "A live version of r: r itself if it is live. Otherwise signal ResourceLost,
  with restarts `reconnect` (returns what (reconnect r) returns, e.g. a new
  handle, or r itself when that returns nil) and `abort` (ends this fiber).
  Use the value it returns."
  [r]
  (if (resource-live? r)
    r
    (restart-case
      (error ResourceLost :resource r :message (str "Resource lost in an image restore: " (pr-str r)))
      (reconnect [] :report "Reconnect the resource and carry on"
                 (let [r2 (reconnect r)] (%mark-live! r) (if (some? r2) r2 r)))
      (abort [] :report "End this fiber" (%abort-fiber "Resource lost in an image restore" [])))))

(defn save-image
  "Save the running image to path. Options:
    :entry   a var or function the image runs when started (with the
             command-line arguments); without one it starts a REPL
    :fibers  :parked (default) saves every unfinished fiber, resumable;
             :none saves them dead (they end with an error when restored)
    :layered true writes only what changed since the image this process
             started from (a delta that names it as its base)
  Returns {:objects :patches :reused :bytes}."
  [path & {:keys [entry fibers layered]}]
  (when-not (or (nil? fibers) (= fibers :parked) (= fibers :none))
    (error "save-image: :fibers must be :parked or :none, not" (pr-str fibers)))
  (%save-image path entry (not= fibers :none) (if layered true false))
  (%save-image-outcome))

(def %restore-hooks
  "Functions run after an image is loaded, before its resources are
  restored (settings that depend on the machine, as the module cache's
  folder does)."
  (atom []))

(defn %image-restored
  "Run once after an image is loaded: the restore hooks run, resources
  become dead, then each gets on-image-restore."
  []
  (alter-var-root (var %image-generation) inc)
  (doseq [f @%restore-hooks] (f))
  (doseq [e @%resources]
    (when-let [r (weak-get (first e))]
      (handler-case (when (on-image-restore r) (%mark-live! r))
        (Error [c] (println "on-image-restore failed for" (pr-str r) "-" (condition-text c))))))
  nil)

(defn %run-entry
  "Call the image's entry function with the command-line arguments."
  [& args]
  (let [e %image-entry]
    (apply (if (var? e) (var-get e) e) args)))

;;; ---- libraries: require ----------------------------------------------------------------
;;;
;;; Phases (M8 part 8.5): code that runs while compiling (a macro's, and its
;;; helpers') is one phase up, in its own instance of each module: namespace
;;; name$1 for module name, name$2 one more up. Requiring from a namespace
;;; at shift n loads the library's instance at shift n. norn.core,
;;; norn.syntax, norn.compiler and norn.expander are the language itself:
;;; one instance, shared by every phase.

(def %shared-nss #{"norn.core" "norn.syntax" "norn.compiler" "norn.expander"})

(defn %ns-shift
  "The phase shift of namespace ns (a symbol): n for name$n, else 0."
  [ns]
  (let [n (str ns)
        i (loop [i (dec (count n))]
            (cond (< i 0) nil
                  (= (nth n i) \$) i
                  :else (recur (dec i))))]
    (if i (or (%parse-number (subs n (inc i)) true) 0) 0)))

(defn %base-ns
  "Namespace ns's module name, without its phase shift."
  [ns]
  (let [n (str ns) s (%ns-shift ns)]
    (if (zero? s) (symbol n) (symbol (subs n 0 (- (count n) (inc (count (str s)))))))))

(defn %shifted
  "The instance of module lib at phase shift s (a shared one has one)."
  [lib s]
  (if (or (zero? s) (contains? %shared-nss (str lib))) lib (symbol (str lib "$" s))))

(def *load-shift* "The phase shift of the library being loaded." 0)

(def *macro-place*
  "While a macro runs, where the call it is expanding came from, when known:
  [source line column position span] (the expander binds it)."
  nil)

(defn %macro-location
  "Where the macro call being expanded is, as \"source:line\" (for a macro
  that wants to report where it was used, as norn.test's is does), or,
  when that isn't known, the top-level form being evaluated (%location)."
  []
  (let [loc *macro-place*]
    (if (and loc (nth loc 0 nil) (nth loc 1 nil))
      (str (nth loc 0) ":" (nth loc 1))
      (%location))))
;;;
;;; (require 'norn.io) loads a library once: embedded in the binary
;;; (lib/norn/*.norn) or found as a/b.norn under NORN_PATH or the current
;;; directory, or a namespace that exists already with definitions (a
;;; native extension's). (require '[norn.string :as str :refer [join]]) also aliases
;;; and refers. Several fibers may require the same library at once: one
;;; loads it, the others wait for it.

(def *loading* #{}) ; (the libraries this fiber is loading)
(%set-private! (var *loading*))
(def %libs (atom {}))

;; (compile-def! adds to *defined*, so the library's own names its new
;; source no longer defines can be unmapped after)
(def *defined*
  "While a library reloads, an atom of [namespace-name symbol] for each def
  compiled meanwhile; otherwise nil. Internal: for require and the
  compiler."
  nil)

(defn- %unmap-stale!
  "Unmap namespace ns's own vars that weren't defined again while it reloaded."
  [ns defined]
  (doseq [[sym _] (ns-interns ns)]
    (when-not (contains? defined [(str ns) sym])
      (%ns-unmap ns sym))))

(defn- %check-lib-ns
  "An error if library lib's source (text, from path) starts with an ns
  form naming another namespace: it would load, define that one, and
  leave lib undefined."
  [lib text path]
  (let [d (try (%read (%reader text path)) (catch Error _ nil))
        n (when (and (seq? d) (= 'ns (first d))) (second d))]
    (when (and (symbol? n) (not= (str n) (str lib)))
      (error "Library" (str lib) "is found at" (str path ",") "but that file defines" (str n)
             "(its ns form says so): rename the file or change its ns form"))))

(defn- %load-lib-source [lib]
  (let [found (%find-lib (str lib))]
    (cond found
          (let [ns (current-ns)]
            (%check-lib-ns lib (nth found 0) (nth found 1))
            (try (%eval-reader (%reader (nth found 0) (nth found 1)))
                 (finally (in-ns ns))))
          ;; A namespace with no source that already has definitions: a
          ;; native extension's (norn.ui.native), or one made at the REPL.
          (and (some (fn [n] (= (str n) (str lib))) (all-ns)) (seq (ns-publics lib))) nil
          :else (error "Can't find library" (str lib) "(not embedded, and not on NORN_PATH)"))))

(declare %load-lib-at)

(defn %load-lib
  "Load library lib's instance at phase shift s (once); its namespace. A
  library with no source (a native extension's) has one instance."
  ([lib] (%load-lib lib 0))
  ([lib s]
   (let [key (if (and (pos? s) (nil? (%find-lib (str lib)))) lib (%shifted lib s))]
     (%load-lib-at lib key (if (= key lib) 0 s))
     key)))

;; A library being loaded is {:done channel :owner fiber} in %libs; the
;; channel closes when the load ends. %lib-waits maps each fiber waiting
;; for another's load to the library it waits for. Two fibers loading
;; opposite ends of a cycle would each wait for the other forever, so a
;; fiber about to wait follows the chain first: the library's loader, the
;; library that fiber waits for, its loader, and so on. Reaching itself is
;; a circular require. (It records its own wait before looking, so of two
;; fibers closing a cycle at once, at least one sees it.)
(def %lib-waits (atom {}))

(defn- %waits-for-me?
  "Does the load of key wait, through other fibers' loads, for fiber me?"
  [key me]
  (loop [k key seen #{}]
    (let [e (get @%libs k)
          owner (when (map? e) (:owner e))]
      (cond (nil? owner) false
            (identical? owner me) true
            (contains? seen owner) false
            :else (let [next-key (get @%lib-waits owner)]
                    (if (nil? next-key) false (recur next-key (conj seen owner))))))))

(defn- %load-lib-at [lib key s]
  (when (contains? *loading* key)
    (error "Circular require:" (str key) "is already being loaded"))
  (loop []
    (let [m @%libs
          e (get m key)]
      (cond (= e :loaded) nil
            (some? e)
            (let [me (current-fiber)]
              (when me (swap! %lib-waits assoc me key))
              (try
                (when (and me (%waits-for-me? key me))
                  (error "Circular require:" (str key)
                         "is being loaded by another fiber that is waiting for a library this one is loading"))
                (take! (:done e))
                (finally (when me (swap! %lib-waits dissoc me))))
              (recur))
            :else (let [done (chan)]
                    (if (compare-and-set! %libs m (assoc m key {:done done :owner (current-fiber)}))
                      (try (binding [*loading* (conj *loading* key) *load-shift* s] (%load-lib-source lib))
                           (swap! %libs assoc key :loaded)
                           (catch Error c (swap! %libs dissoc key) (throw c))
                           (finally (close! done)))
                      (recur)))))))

(defn require
  "Load libraries: (require 'norn.io '[norn.string :as str :refer [join]]).
  :refer :all refers every public var. :reload as a spec's option, or
  after the specs, loads the library again even if it's loaded: its
  definitions are replaced in place, and names its source no longer
  defines are removed from its namespace (code already compiled against
  one keeps calling it, but new code can't refer to it)."
  [& specs]
  (let [reload-all (some (fn [s] (= s :reload)) specs)]
    (doseq [spec (remove (fn [s] (= s :reload)) specs)]
      (let [[lib & opts] (if (vector? spec) spec [spec])
            opts (apply hash-map (remove (fn [o] (= o :reload)) opts))
            reload (or reload-all (some (fn [o] (= o :reload)) (if (vector? spec) spec [])))
            {:keys [as refer]} opts]
        (let [shift (%ns-shift (symbol (str (current-ns))))
              ;; (every phase's instance: each loads again when next
              ;; required, so none is left stale)
              _ (when reload (swap! %libs (fn [m] (into {} (remove (fn [e] (= lib (%base-ns (first e)))) m)))))
              ;; (only a library with source: a native extension's names
              ;; aren't defined by loading it)
              defined (when (and reload (%find-lib (str lib))) (atom #{}))
              target (binding [*defined* (or defined *defined*)] (%load-lib lib shift))
              _ (when defined (%unmap-stale! target @defined))]
          (when as (%alias as target))
          (when refer
            (let [publics (ns-publics target)]
              (doseq [s (if (= refer :all) (keys publics) refer)]
                (%refer s (or (get publics s) (error "No such public var:" (str lib "/" s))))))))))
    nil))

(defn %up-ns
  "The namespace one phase up from the current one (made if need be)."
  []
  (let [here (symbol (str (current-ns)))
        up (%shifted (%base-ns here) (inc (%ns-shift here)))]
    (when (= up here) (error "A shared namespace has no compile-time instance:" (str here)))
    up))

(defn require-for-syntax
  "Require libraries (as require) for compile time: into the current
  module's instance one phase up, where its macros' code resolves names."
  [& specs]
  (let [here (symbol (str (current-ns)))]
    (in-ns (%up-ns))
    (try (apply require specs) (finally (in-ns here)))))

(defn %eval-for-syntax
  "Evaluate forms in the current module's instance one phase up."
  [forms]
  (let [here (symbol (str (current-ns)))]
    (in-ns (%up-ns))
    (try (loop [fs (seq forms) last nil] (if fs (recur (next fs) (eval (first fs))) last))
         (finally (in-ns here)))))

(defmacro begin-for-syntax
  "Definitions and code for compile time: evaluated in this module's
  instance one phase up, where its macros' code finds them."
  [& forms]
  `(%eval-for-syntax '~(vec forms)))

(defn %refer-core!
  "ns's (:refer-core :exclude [names…] :rename {name new-name}) in the
  current namespace. An excluded name is the namespace's own, defined
  here or not, rather than norn.core's; a renamed one is norn.core's under
  its new name (and excluded under its old one)."
  [opts]
  (let [{:keys [exclude rename]} opts
        here (symbol (str (current-ns)))]
    (doseq [k (keys opts)]
      (when-not (contains? #{:exclude :rename} k)
        (error (str "(:refer-core …) takes :exclude [names…] and :rename {name new-name}, not " k))))
    (doseq [s (concat exclude (keys rename))]
      (when-not (%resolve-in 'norn.core s) (error (str "norn.core has no " s " to exclude or rename")))
      (%intern here s))
    (doseq [[from to] rename]
      (%refer to (%resolve-in 'norn.core from)))
    nil))

(def %unsafe-namespaces
  "The namespaces that may use the raw FFI (M9 part 9.8): those whose ns
  says (:unsafe), and user, the REPL's."
  (atom #{'user}))

(defn %declare-unsafe! [] (swap! %unsafe-namespaces conj (symbol (str (current-ns)))) nil)

(%set-unsafe! (var %ffi-open)) (%set-unsafe! (var %ffi-fn)) (%set-unsafe! (var %ffi-call))
(%set-unsafe! (var %ffi-callback)) (%set-unsafe! (var %ffi-callback-reply!)) (%set-unsafe! (var %ffi-callback-free!))
(%set-unsafe! (var %mem-alloc)) (%set-unsafe! (var %mem-free)) (%set-unsafe! (var %mem-get)) (%set-unsafe! (var %mem-set!))
(%set-unsafe! (var %mem-string)) (%set-unsafe! (var %mem-bytes)) (%set-unsafe! (var %mem-write-bytes!))

(defmacro ns
  "(ns name (:refer-core …)? (:require spec…) (:require-for-syntax spec…)…
  (:unsafe)?): switch to (creating) a namespace, then require libraries as
  in `require`, and for compile time as in `require-for-syntax`.
  (:refer-core :exclude [get] :rename {map map-core}) says which of
  norn.core's names this namespace takes for its own: see %refer-core!.
  (:unsafe) lets the module use the raw FFI (norn.ffi), which can crash
  the process."
  [name & clauses]
  (let [of (fn [k] (mapcat (fn [c] (when (and (seq? c) (= (first c) k)) (rest c))) clauses))
        core-opts (of :refer-core)
        unsafe? (some (fn [c] (and (seq? c) (= (first c) :unsafe))) clauses)]
    `(do (in-ns '~name)
         ~@(when unsafe? [`(%declare-unsafe!)])
         ~@(when (seq core-opts) [`(%refer-core! '~(apply hash-map core-opts))])
         ~@(map (fn [r] `(require '~r)) (of :require))
         ~@(map (fn [r] `(require-for-syntax '~r)) (of :require-for-syntax))
         nil)))

;;; ---- owned mutable objects (design §4.2) ---------------------------------------------------
;;;
;;; A (:mutable) class's instance belongs to the fiber that made it: another
;;; fiber touching it gets an OwnershipError. Hand it over with release! (or
;;; by sending it on a channel: the receiver claims it on first touch), or
;;; share it: then any fiber may read it, and changes happen inside
;;; (locking obj …), which parks rather than spins.

(defclass OwnershipError (RuntimeError) ()
  (:doc "A fiber touched a mutable object (a (:mutable) class's instance, or a
  transient) that another fiber owns. See owner, release! and share."))

(def *inspecting*
  "Bound true while the debugger or the inspector reads objects that other
  fibers own: reading them is then allowed (changing them still isn't)."
  false)

(defn owner
  "The fiber that owns mutable object o, :shared, or nil when it is free."
  [o]
  (let [w (%owner o)]
    (if (vector? w) :shared w)))

(defn- %lock-of [o] (let [w (%owner o)] (when (vector? w) w)))

(defn %with-lock
  "Run (thunk) holding shared object o's lock (reentrant)."
  [o thunk]
  (let [[ch holder] (or (%lock-of o) (error "locking needs a shared object (see share):" (pr-str o)))
        me (current-fiber)]
    (if (identical? @holder me)
      (thunk)
      (do (take! ch)
          (reset! holder me)
          (try (thunk)
               (finally (reset! holder nil) (put! ch :token)))))))

(defmacro locking
  "(locking obj body…): body runs holding shared object obj's lock, so its
  changes are atomic to every other fiber."
  [o & body]
  `(%with-lock ~o (fn [] ~@body)))

(defn share
  "Make mutable object o shared: any fiber may read it, and changes take its
  lock (set-slot! and update-slot! do so themselves). Returns o."
  [o]
  (let [ch (chan 1)]
    (put! ch :token)
    (%share! o [ch (atom nil)])))

(defn release!
  "Give up ownership of mutable object o: the next fiber to touch it claims
  it. Returns o."
  [o]
  (%release! o))

(defn set-slot!
  "Set :mutable slot k of mutable object o to v. Returns v."
  [o k v]
  (if (%lock-of o)
    (locking o (%set-slot! o k v))
    (%set-slot! o k v)))

(defn update-slot!
  "Set :mutable slot k of o to (f old args…), atomically for shared objects.
  Returns the new value."
  [o k f & args]
  (let [step (fn [] (%set-slot! o k (apply f (slot-value o k) args)))]
    (if (%lock-of o) (locking o (step)) (step))))

;;; ---- sequences (design §3.3) --------------------------------------------------------------
;;;
;;; Sequence functions are eager and type-preserving: they run when called
;;; and return the kind of collection they were given (vector → vector,
;;; list → list, set → set; filter/remove/take/drop on a map → map; map
;;; over a map, or over anything else, → vector).
;;;
;;; Laziness is explicit: a stream is made on purpose, with (lazy coll),
;;; lazy-seq, or a generator (iterate, repeat x, cycle, (range)). Sequence
;;; functions on a stream return a stream; vec, into, reduce and the like
;;; realize it. A stream is realized by the interpreter: when an operation
;;; meets an unrealized one, %force-stream runs its thunk and the operation
;;; runs again (runtime.md §5.4).
;;;
;;; With one argument fewer, map, filter, take… return transducers:
;;; (into [] (comp (filter odd?) (map inc)) coll), (transduce xf + coll).

(defmacro lazy-seq
  "A stream whose seq is the value of body, computed when first needed."
  [& body]
  `(%stream (fn* [] ~@body)))

(defn %force-stream
  "Called by the interpreter: realize stream s (all of the chain after it
  too, if all?), then let the operation that needed it run again."
  [s all?]
  (loop [s s]
    (when s
      (let [thunk (%stream-thunk s)]
        (when thunk (%stream-set! s (seq (thunk)))))
      (when all? (recur (%first-unrealized s)))))
  (%retry-marker))

(defn lazy "A stream over coll, read as it is needed." [coll] (lazy-seq (seq coll)))

(defn iterate "The infinite stream x, (f x), (f (f x))…" [f x] (lazy-seq (cons x (iterate f (f x)))))

(def %repeat-n repeat)
(defn repeat
  "(repeat x): the infinite stream x x x…; (repeat n x): a vector of n x's."
  ([x] (lazy-seq (cons x (repeat x))))
  ([n x] (%repeat-n n x)))

(defn- %cycle-from [v i] (lazy-seq (cons (nth v i) (%cycle-from v (mod (inc i) (count v))))))
(defn cycle "The infinite stream of coll's items, over and over." [coll]
  (let [v (vec coll)] (if (empty? v) () (%cycle-from v 0))))

(def %range range)
(defn range
  "(range) is the infinite stream 0 1 2…; (range end), (range start end) and
  (range start end step) are finite ranges."
  ([] (iterate inc 0))
  ([end] (%range end))
  ([start end] (%range start end))
  ([start end step] (%range start end step)))

(defn ensure-reduced
  "x as reduced, so a reduction stops with it, unless it is already."
  [x]
  (if (reduced? x) x (reduced x)))

(defn reduce
  "Reduce coll with f. (reduced x) from f stops early with x."
  ([f coll]
   (let [s (seq coll)]
     (if s (reduce f (first s) (rest s)) (f))))
  ([f init coll]
   (if (%indexed? coll)
     (let [n (count coll)]
       (loop [i 0 acc init]
         (cond (reduced? acc) (unreduced acc)
               (< i n) (recur (inc i) (f acc (nth coll i)))
               :else acc)))
     (loop [s (seq coll) acc init]
       (cond (reduced? acc) (unreduced acc)
             s (recur (next s) (f acc (first s)))
             :else acc)))))

(defn completing
  "A reducing function with a completion step (identity unless given)."
  ([f] (completing f identity))
  ([f cf] (fn ([] (f)) ([x] (cf x)) ([x y] (f x y)))))

(defn transduce
  "Reduce coll with (xf f), then complete: (transduce (map inc) + 0 [1 2])."
  ([xf f coll] (transduce xf f (f) coll))
  ([xf f init coll]
   (let [rf (xf f)]
     (rf (reduce rf init coll)))))

(defn into
  "conj everything in from onto to; with a transducer, through it."
  ([] [])
  ([to] to)
  ([to from] (if (and (vector? to) (empty? to) (not (stream? from))) (vec from) (reduce conj to from)))
  ([to xf from] (transduce xf conj to from)))

(defn sequence "The items of coll through transducer xf, as a vector." [xf coll] (into [] xf coll))

(defn- %like
  "Items v (a vector), selected from coll, as the kind of collection coll is:
  a map keeps its entries; anything not a vector, list, set or map gives a
  vector."
  [coll v]
  (cond (vector? coll) v
        (list? coll) (apply list v)
        (set? coll) (into (empty coll) v)
        (map? coll) (into (empty coll) v)
        :else v))

(defn- %like-made
  "Items v (a vector), computed from coll's items, as the kind of collection
  coll is: vectors, lists and sets keep their kind; anything else (a map
  included: the results needn't be entries) gives a vector."
  [coll v]
  (cond (vector? coll) v
        (list? coll) (apply list v)
        (set? coll) (into (empty coll) v)
        :else v))

(defn- %eager [xf coll] (transduce xf conj [] coll))

(defn- %stream-of [xf-step coll]
  ;; A lazy stream applying a stateless one-in/at-most-one-out step.
  (lazy-seq
    (loop [s (seq coll)]
      (when s
        (let [r (xf-step (first s))]
          (if (= r ::skip) (recur (next s)) (cons r (%stream-of xf-step (rest s)))))))))

(defn map
  "Apply f to each item (or, with several collections, to items side by
  side). Type-preserving for vectors, lists and sets; a map gives a vector
  of results; a stream gives a stream. (map f) is a transducer."
  ([f] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (rf acc (f x))))))
  ([f coll]
   (if (stream? coll)
     (%stream-of f coll)
     (%like-made coll (%eager (map f) coll))))
  ([f c1 c2]
   (if (or (stream? c1) (stream? c2))
     (lazy-seq (let [a (seq c1) b (seq c2)]
                 (when (and a b) (cons (f (first a) (first b)) (map f (rest a) (rest b))))))
     (loop [a (seq c1) b (seq c2) acc []]
       (if (and a b) (recur (next a) (next b) (conj acc (f (first a) (first b)))) (%like-made c1 acc)))))
  ([f c1 c2 c3]
   (loop [a (seq c1) b (seq c2) c (seq c3) acc []]
     (if (and a b c)
       (recur (next a) (next b) (next c) (conj acc (f (first a) (first b) (first c))))
       (%like-made c1 acc)))))

(defn mapv "map, always giving a vector." ([f coll] (%eager (map f) coll)) ([f c1 c2] (vec (map f c1 c2))))

(defn filter
  "The items for which (pred x) is true, as the same kind of collection
  (a map keeps its entries). (filter pred) is a transducer."
  ([pred] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (if (pred x) (rf acc x) acc)))))
  ([pred coll]
   (if (stream? coll)
     (%stream-of (fn [x] (if (pred x) x ::skip)) coll)
     (%like coll (%eager (filter pred) coll)))))

(defn filterv "filter, always giving a vector." [pred coll] (%eager (filter pred) coll))

(defn remove
  "The items for which (pred x) is false. (remove pred) is a transducer."
  ([pred] (filter (complement pred)))
  ([pred coll] (filter (complement pred) coll)))

(defn keep
  "The non-nil results of (f x). (keep f) is a transducer."
  ([f] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (let [y (f x)] (if (nil? y) acc (rf acc y)))))))
  ([f coll]
   (if (stream? coll)
     (%stream-of (fn [x] (let [y (f x)] (if (nil? y) ::skip y))) coll)
     (%like-made coll (%eager (keep f) coll)))))

(defn map-indexed
  "(f index item) for each item. (map-indexed f) is a transducer."
  ([f] (fn [rf] (let [i (atom -1)] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (rf acc (f (swap! i inc) x)))))))
  ([f coll]
   (if (stream? coll)
     (map f (iterate inc 0) coll)
     (%like-made coll (%eager (map-indexed f) coll)))))

(defn take
  "The first n items. (take n) is a transducer."
  ([n] (fn [rf]
         (let [left (atom n)]
           (fn ([] (rf)) ([acc] (rf acc))
             ([acc x] (let [k @left]
                        (reset! left (dec k))
                        (cond (> k 1) (rf acc x)
                              (= k 1) (ensure-reduced (rf acc x))
                              :else (reduced acc))))))))
  ([n coll]
   (if (stream? coll)
     (lazy-seq (when (pos? n) (when-let [s (seq coll)] (cons (first s) (take (dec n) (rest s))))))
     (%like coll (%eager (take n) coll)))))

(defn drop
  "All but the first n items. (drop n) is a transducer."
  ([n] (fn [rf]
         (let [left (atom n)]
           (fn ([] (rf)) ([acc] (rf acc))
             ([acc x] (if (pos? @left) (do (swap! left dec) acc) (rf acc x)))))))
  ([n coll]
   (if (stream? coll)
     (lazy-seq (loop [n n s (seq coll)] (if (and s (pos? n)) (recur (dec n) (next s)) s)))
     (%like coll (%eager (drop n) coll)))))

(defn take-while
  "Items up to the first for which (pred x) is false. A transducer with one argument."
  ([pred] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (if (pred x) (rf acc x) (reduced acc))))))
  ([pred coll]
   (if (stream? coll)
     (lazy-seq (when-let [s (seq coll)] (when (pred (first s)) (cons (first s) (take-while pred (rest s))))))
     (%like coll (%eager (take-while pred) coll)))))

(defn drop-while
  "Items from the first for which (pred x) is false. A transducer with one argument."
  ([pred] (fn [rf]
            (let [dropping (atom true)]
              (fn ([] (rf)) ([acc] (rf acc))
                ([acc x] (if (and @dropping (pred x)) acc (do (reset! dropping false) (rf acc x))))))))
  ([pred coll]
   (if (stream? coll)
     (lazy-seq (loop [s (seq coll)] (if (and s (pred (first s))) (recur (next s)) s)))
     (%like coll (%eager (drop-while pred) coll)))))

(defn cat
  "A transducer that concatenates the collections it is given."
  [rf]
  ;; (an early end inside one collection is reduced twice: reduce unwraps
  ;; one, and the outer reduction sees the other and stops too)
  (let [preserving (fn [acc x] (let [r (rf acc x)] (if (reduced? r) (reduced r) r)))]
    (fn ([] (rf)) ([acc] (rf acc)) ([acc coll] (reduce preserving acc coll)))))

(def %concat concat)
(defn concat
  "All the items of the collections, in order: a list (() for none), or a
  lazy stream if any of them is a stream."
  [& colls]
  (if (some stream? colls)
    (lazy-seq (when-let [cs (seq colls)]
                (if-let [s (seq (first cs))]
                  (cons (first s) (apply concat (rest s) (rest cs)))
                  (apply concat (rest cs)))))
    (apply %concat colls)))

(defn mapcat
  "map, then concatenate the results. (mapcat f) is a transducer."
  ([f] (comp (map f) cat))
  ([f coll]
   (if (stream? coll)
     (lazy-seq (when-let [s (seq coll)] (seq (concat (f (first s)) (mapcat f (rest s))))))
     (%like-made coll (%eager (mapcat f) coll))))
  ([f c1 c2] (%eager cat (map f c1 c2))))

(defn distinct
  "Items without repeats, first occurrences kept. A transducer with no collection."
  ([] (fn [rf]
        (let [seen (atom #{})]
          (fn ([] (rf)) ([acc] (rf acc))
            ([acc x] (if (contains? @seen x) acc (do (swap! seen conj x) (rf acc x))))))))
  ([coll]
   (if (stream? coll)
     (let [step (fn step [s seen]
                  (lazy-seq (loop [s (seq s)]
                              (when s
                                (let [x (first s)]
                                  (if (contains? seen x) (recur (next s)) (cons x (step (rest s) (conj seen x)))))))))]
       (step coll #{}))
     (%like coll (%eager (distinct) coll)))))

(defn dedupe
  "Items without consecutive repeats. A transducer with no collection."
  ([] (fn [rf]
        (let [prev (atom ::none)]
          (fn ([] (rf)) ([acc] (rf acc))
            ([acc x] (let [p @prev] (reset! prev x) (if (= p x) acc (rf acc x))))))))
  ([coll]
   (if (stream? coll)
     (let [step (fn step [s prev]
                  (lazy-seq (loop [s (seq s)]
                              (when s
                                (let [x (first s)]
                                  (if (= x prev) (recur (next s)) (cons x (step (rest s) x))))))))]
       (step coll ::none))
     (%like coll (%eager (dedupe) coll)))))

(defn interpose
  "Items with sep between them. A transducer with one argument."
  ([sep] (fn [rf]
           (let [started (atom false)]
             (fn ([] (rf)) ([acc] (rf acc))
               ([acc x] (if @started
                          (let [r (rf acc sep)] (if (reduced? r) r (rf r x)))
                          (do (reset! started true) (rf acc x))))))))
  ([sep coll]
   (if (stream? coll)
     (lazy-seq (when-let [s (seq coll)]
                 (cons (first s) (mapcat (fn [x] [sep x]) (rest s)))))
     (%like-made coll (%eager (interpose sep) coll)))))

(defn partition-all
  "Items in groups of n (the last may be shorter), as vectors. A transducer with one argument."
  ([n] (fn [rf]
         (let [buf (atom [])]
           (fn ([] (rf))
             ([acc] (let [b @buf] (reset! buf []) (rf (if (empty? b) acc (unreduced (rf acc b))))))
             ([acc x] (let [b (conj @buf x)]
                        (if (= (count b) n) (do (reset! buf []) (rf acc b)) (do (reset! buf b) acc))))))))
  ([n coll]
   (if (stream? coll)
     ;; (reading no further than the group it gives)
     (lazy-seq (loop [s coll g []]
                 (if (and (pos? n) (= (count g) n))
                   (cons g (partition-all n s))
                   (if-let [s (seq s)]
                     (recur (rest s) (conj g (first s)))
                     (when (seq g) (list g))))))
     (%eager (partition-all n) coll))))

(defn partition
  "Items in groups of exactly n, as vectors (a short last group is
  dropped). On a stream, a stream."
  [n coll]
  (if (stream? coll)
    (filter (fn [g] (= (count g) n)) (partition-all n coll))
    (filterv (fn [g] (= (count g) n)) (partition-all n coll))))

(defn interleave
  "The first item of each collection, then the second of each…, until one
  runs out: a vector, or a stream if any of them is one."
  [& colls]
  (if (some stream? colls)
    (let [step (fn step [ss]
                 (lazy-seq (let [ss (map seq ss)]
                             (when (and (seq ss) (every? some? ss))
                               (concat (map first ss) (step (map rest ss)))))))]
      (step (vec colls)))
    (loop [ss (mapv seq colls) acc []]
      (if (and (seq ss) (every? some? ss))
        (recur (mapv next ss) (into acc (map first ss)))
        acc))))

(defn doall "Realize stream s completely, and return it." [s] (when (stream? s) (count s)) s)
(defn realize "A stream's items as a vector (anything else is returned as it is)." [x] (if (stream? x) (vec x) x))

;; A root evaluation (norn -e, editor requests) prints its result from Rust,
;; which can't run a stream's thunks: realize a stream result first, as a
;; REPL prints a lazy seq in full.
(defn %eval-root [s]
  (let [v (%eval-reader (%reader s "<string>"))]
    (if (stream? v) (doall v) v)))

;;; ---- more collections (runtime.md §2.4) ----------------------------------------------------

(defn queue
  "A persistent FIFO queue of xs: conj adds at the back, peek and pop work
  at the front."
  [& xs]
  (into (%empty-queue) xs))

;;; ---- text (norn.string and friends have the rest) ------------------------------------------

(defn re-find
  "The first match of regex re in s: the matched text, or [text group1 …]
  when re has groups; nil when there is none."
  [re s]
  (when-let [m (%re-search re s 0 false)]
    (let [groups (nth m 2)] (if (= 1 (count groups)) (first groups) groups))))

(defn re-matches "As re-find, but re must match the whole of s." [re s]
  (when-let [m (%re-search re s 0 true)]
    (let [groups (nth m 2)] (if (= 1 (count groups)) (first groups) groups))))

(defn re-seq "Every non-overlapping match of re in s, as re-find gives each." [re s]
  (mapv (fn [m] (let [groups (nth m 2)] (if (= 1 (count groups)) (first groups) groups))) (%re-all re s)))

(defn format
  "Text from printf-style directives: %s (as str), %S (as pr-str), %d, %f,
  %e, %g, %x, %X, %o, %b, %c, %% and %n; flags - 0 + space and , (group
  thousands); a width and .precision."
  [fmt & args]
  (%format fmt (vec args)))

(defn printf "Print (format fmt args…)." [fmt & args] (print (%format fmt (vec args))))

(defn parse-long "The integer written in s (base 10, any size), or nil." [s] (%parse-number s true))
(defn parse-double "The floating-point number written in s, or nil." [s] (%parse-number s false))
(defn parse-boolean "true for \"true\", false for \"false\", else nil." [s]
  (cond (= s "true") true (= s "false") false :else nil))

;;; ---- small utilities (M7 part 6) ------------------------------------------------------------

(defn swap-vals!
  "As swap!, but returns [old new]."
  [a f & args]
  (loop []
    (let [old (deref a) new (apply f old args)]
      (if (compare-and-set! a old new)
        (do (when (pos? (deref %watched)) (%fire-watches a old new)) [old new])
        (recur)))))

(defn reset-vals! "As reset!, but returns [old new]." [a v]
  (loop []
    (let [old (deref a)]
      (if (compare-and-set! a old v)
        (do (when (pos? (deref %watched)) (%fire-watches a old v)) [old v])
        (recur)))))

(defn memoize
  "f remembering every result by its arguments (see norn.cache for
  bounded versions)."
  [f]
  (let [memo (atom {})]
    (fn [& args]
      (let [hit (get (deref memo) args memo)]
        (if (identical? hit memo)
          (let [v (apply f args)] (swap! memo assoc args v) v)
          hit)))))

(defn juxt
  "A function returning a vector of each f applied to its arguments."
  [& fs]
  (fn [& args] (mapv (fn [f] (apply f args)) fs)))

(defn fnil
  "f with nil first arguments replaced by the defaults."
  ([f a] (fn [x & more] (apply f (if (nil? x) a x) more)))
  ([f a b] (fn [x y & more] (apply f (if (nil? x) a x) (if (nil? y) b y) more))))

(defn repeatedly
  "n results of calling f (a vector), or with no n an endless stream."
  ([f] (lazy-seq (cons (f) (repeatedly f))))
  ([n f] (loop [i 0 out []] (if (< i n) (recur (inc i) (conj out (f))) out))))

(defn rand "A random float in [0, 1), or in [0, n)." ([] (%rand 1)) ([n] (* n (%rand 1))))
(defn rand-int "A random integer in [0, n)." [n] (%rand-below n))
(defn rand-nth "A random item of coll." [coll] (let [v (vec coll)] (nth v (%rand-below (count v)))))
(defn shuffle "coll's items in a random order, as a vector." [coll]
  (loop [i (dec (count coll)) v (vec coll)]
    (if (pos? i)
      (let [j (%rand-below (inc i)) a (nth v i)] (recur (dec i) (assoc v i (nth v j) j a)))
      v)))

;;; ---- documentation (M7.9) ---------------------------------------------------------------------
;;;
;;; Every top-level definition read is noted (%note-definition!), so doc and
;;; source work for code from files, libraries, the REPL and the editor.
;;; Docstrings are Markdown. After the docstring a definition may carry an
;;; attribute map: :since "0.7", :deprecated "use y instead", :see-also
;;; [other names], :examples [[(expr) expected] …] (`norn check` runs them).

(def ^:private %core-indexed (atom false))

(defn %index-source!
  "Note every definition in source text src (named file) as if read in
  namespace ns-name, without evaluating anything."
  [src file ns-name]
  (let [here (current-ns)
        r (%reader src file)]
    (in-ns ns-name)
    (loop []
      (let [f (%read r)]
        (when-not (%eof? f)
          (%note-definition! f file (%reader-line r))
          (recur))))
    (in-ns (symbol (str here)))
    nil))

(defn- %ensure-core-indexed! []
  (when (compare-and-set! %core-indexed false true)
    (%index-source! (%core-source) "<norn.core>" 'norn.core)
    (%index-source! (%compiler-source) "<norn.compiler>" 'norn.compiler)))

(defn %source-of
  "The source text a definition was read from, when it can be found again."
  [file]
  (cond (nil? file) nil
        (= file "<norn.core>") (%core-source)
        (= file "<norn.compiler>") (%compiler-source)
        (= "<" (subs file 0 1)) (first (%find-lib (subs file 1 (dec (count file)))))
        :else (try (slurp file) (catch Error _ nil))))

(defn %var-name "\"ns/name\" of var v." [v] (subs (pr-str v) 2))

(defn- %primitive-definition
  "What norn.core-docs says about norn.core's primitive nm (written in
  Rust: no Norn definition), or nil."
  [ns-name nm]
  (when (= ns-name "norn.core")
    (require 'norn.core-docs)
    (when-let [d (get @(%bound-value 'norn.core-docs/docs) nm)]
      (assoc d :name nm :ns "norn.core" :kind 'primitive))))

(defn definition
  "What is known about sym's definition (a symbol resolved in the current
  namespace, or a var): :name :ns :doc :arglists :kind :file :line and any
  attributes. nil when sym isn't defined."
  [sym]
  (%ensure-core-indexed!)
  (let [v (if (var? sym) sym (resolve sym))]
    (when v
      (let [n (%var-name v) i (%str-index n "/" nil false)] ; (the first /: norn.core// is /)
        (or (get (deref %definitions) n)
            (%primitive-definition (subs n 0 i) (symbol (subs n (inc i))))
            {:name (symbol (subs n (inc i))) :ns (subs n 0 i)})))))

(declare %contract-of)

(defn- %signature-text
  "The checked signature of function var v, a line per arity, as doc
  shows it: \"  Checked: (String, Integer) -> String\"; nil without one."
  [v]
  (when-let [c (and v (%contract-of v))]
    (let [name-of (fn [x] (if x (:name x) "Any"))]
      (apply str (map (fn [p]
                        (str "  Checked: ("
                             (apply str (interpose ", " (concat (map name-of (:args p))
                                                                (when (:variadic p) [(str "& " (name-of (:rest p)))]))))
                             ") -> " (name-of (:result p)) "\n"))
                      (if (map? c) [c] c))))))

(defn %doc-text
  "sym's documentation as text, as doc prints it."
  [sym]
  (let [d (definition sym)]
    (if (nil? d)
      (str "No definition of " sym "\n")
      (str "-------------------------\n"
           (:ns d) "/" (:name d)
           (when (= 'defmacro (:kind d)) "  (macro)")
           "\n"
           (when (:arglists d) (str (pr-str (apply list (:arglists d))) "\n"))
           (%signature-text (resolve (symbol (:ns d) (str (:name d)))))
           (when (:deprecated d) (str "  DEPRECATED: " (:deprecated d) "\n"))
           (when (:since d) (str "  Since " (:since d) "\n"))
           (if (:doc d)
             (str "  " (:doc d) "\n")
             "  (no docstring)\n")
           (when (seq (:see-also d)) (str "  See also: " (apply str (interpose ", " (map str (:see-also d)))) "\n"))
           (when (seq (:examples d))
             (str "  Examples:\n"
                  (apply str (map (fn [[e r]] (str "    " (pr-str e) " ;=> " (pr-str r) "\n")) (:examples d)))))))))

(defmacro doc "Print the documentation of sym." [sym] `(print (%doc-text '~sym)))

(defn source-text
  "The source of sym's definition, as text; nil when it can't be found."
  [sym]
  (let [d (definition sym)]
    (cond (nil? d) nil
          (:text d) (:text d)
          (:form d) (pr-str (:form d))
          :else (when-let [src (%source-of (:file d))] (%form-at src (:line d))))))

(defmacro source "Print the source of sym's definition." [sym]
  `(println (or (source-text '~sym) (str "No source for " '~sym))))

(defn bound?
  "Does each of vs, vars, have a value? (def x) makes a var without one;
  binding gives a dynamic var one only inside the binding."
  [& vs]
  (every? %var-bound? vs))

(defmacro defonce
  "(defonce name expr), or (defonce name \"doc\" expr): def name as expr,
  unless it has a value already. Reloading a module evaluates its defs
  again; a defonce keeps what it holds, so state (an atom, a connection)
  survives a reload. The var, as def gives."
  [nm & more]
  (let [[doc expr] (if (and (string? (first more)) (next more)) [(first more) (second more)] [nil (first more)])]
    `(let [v# (def ~nm)]
       (when-not (bound? v#) ~(if doc `(def ~nm ~doc ~expr) `(def ~nm ~expr)))
       v#)))

(defn meta
  "x's metadata. For a var, what's recorded about its definition: :name,
  :ns (its namespace's name), :doc, :arglists, :file and :line when known,
  any attributes it was given (:since, :deprecated, :see-also…), and
  :macro, :private and :dynamic when they apply. Other values carry none
  yet: nil."
  [x]
  (when (var? x)
    (let [d (definition x)
          m (into {} (remove (fn [[k v]] (or (nil? v) (contains? #{:form :text :kind} k)))) d)
          m (if (macro? x) (assoc m :macro true) m)
          m (if (private? x) (assoc m :private true) m)]
      (if (%var-dynamic? x) (assoc m :dynamic true) m))))

(defn apropos
  "The public names, in every loaded namespace, whose name contains s (a
  string) or matches it (a regex): a sorted vector of qualified symbols.
  Names starting with % (the runtime's own) and the compile-time copies
  of modules (namespaces such as norn.io$1) are left out."
  [s]
  (let [match? (if (regex? s) (fn [n] (some? (re-find s n))) (fn [n] (some? (%str-index n s nil false))))]
    (vec (sort-by str
                  (mapcat (fn [ns]
                            (when-not (%str-index (str ns) "$" nil false)
                              (keep (fn [k] (when (and (match? (name k)) (not= "%" (subs (name k) 0 1)))
                                              (symbol (str ns) (name k))))
                                    (keys (or (ns-publics ns) {})))))
                          (all-ns))))))

(defn find-doc
  "The definitions whose docstring or name contains s (case-insensitive):
  a sorted vector of qualified symbols."
  [s]
  (%ensure-core-indexed!)
  (let [needle (%str-case (str s) 1)]
    (vec (sort-by str
                  (keep (fn [[k d]]
                          (when (or (some? (%str-index (%str-case (or (:doc d) "") 1) needle nil false))
                                    (some? (%str-index (%str-case k 1) needle nil false)))
                            (symbol k)))
                        (deref %definitions))))))

;;; ---- REPL tools: inspect, trace -------------------------------------------------------------

(defn inspect
  "A description of x for looking inside it: {:type :value :count :items},
  where :items lists up to limit (default 100) entries as [key value-text]
  (indexes for sequences, keys for maps, slots for instances)."
  ([x] (inspect x 100))
  ([x limit]
   (let [short (fn [v] (let [t (pr-str v)] (if (> (count t) 200) (str (subs t 0 197) "...") t)))
         items (cond (%instance? x)
                     (mapv (fn [k] [k (short (slot-value x k))]) (%class-get (class-of x) :layout))
                     (map? x) (mapv (fn [[k v]] [(short k) (short v)]) (take limit x))
                     (or (coll? x) (string? x)) (vec (map-indexed (fn [i v] [i (short v)]) (take limit (seq x))))
                     :else nil)
         base {:type (str (class-name (class-of x))) :value (short x)}
         base (if (or (coll? x) (string? x)) (assoc base :count (count x)) base)]
     (if items (assoc base :items items) base))))

(def *out*
  "nil: printing goes to stdout. Bound to an atom holding a vector, printed
  text is added to the vector instead (see with-out-str)."
  nil)

(defn %with-out-str [f]
  (let [buf (atom [])]
    (binding [*out* buf] (f))
    (apply str (deref buf))))

(defmacro with-out-str "What body prints, as a string." [& body] `(%with-out-str (fn [] ~@body)))

(def ^:dynamic *trace-depth* 0) ; (how deep trace-var!'s calls are)
(%set-private! (var *trace-depth*))
(def ^:private %traced (atom {}))

(defn trace-var!
  "Print every call to var v and what it returns, indented by depth, until
  untrace-var!."
  [v]
  (when-not (contains? (deref %traced) v)
    (let [f (var-get v) label (%var-name v)]
      (swap! %traced assoc v f)
      (%set-root! v (fn [& args]
                      (let [pad (apply str (repeat (* 2 *trace-depth*) " "))]
                        (println (str pad "→ (" label (apply str (map (fn [a] (str " " (pr-str a))) args)) ")"))
                        (let [r (binding [*trace-depth* (inc *trace-depth*)] (apply f args))]
                          (println (str pad "← " label " " (pr-str r)))
                          r))))))
  v)

(defn untrace-var! "Stop tracing var v." [v]
  (when-let [f (get (deref %traced) v)]
    (%set-root! v f)
    (swap! %traced dissoc v))
  v)

(defmacro trace "Trace calls to the named functions." [& syms] `(do ~@(map (fn [s] `(trace-var! (var ~s))) syms)))
(defn untrace-all! "Stop tracing everything." [] (doseq [v (keys (deref %traced))] (untrace-var! v)))

(defmacro untrace "Stop tracing the named functions (all of them with no names)." [& syms]
  (if (seq syms)
    `(do ~@(map (fn [s] `(untrace-var! (var ~s))) syms))
    `(untrace-all!)))

;;; ---- watches and evaluation hooks (M7.5) ----------------------------------------------------

(def %reset-prim reset!)

(defn reset!
  "Set atom a to v (calling its watches). Returns v."
  [a v]
  (if (pos? (deref %watched))
    (let [old (deref a)] (%reset-prim a v) (%fire-watches a old v) v)
    (%reset-prim a v)))

(defn add-watch
  "Call (f key a old new) after each change to atom a through swap!, reset!,
  swap-vals! or reset-vals! (not raw compare-and-set!). A second watch with
  the same key replaces the first. Returns a."
  [a key f]
  (swap! %watches update a (fn [ws] (assoc (or ws {}) key f)))
  (reset! %watched (count (deref %watches)))
  a)

(defn remove-watch "Remove atom a's watch named key. Returns a." [a key]
  (swap! %watches (fn [m] (let [ws (dissoc (get m a {}) key)] (if (empty? ws) (dissoc m a) (assoc m a ws)))))
  (reset! %watched (count (deref %watches)))
  a)

(def %after-eval-hooks (atom {}))

(defn add-after-eval-hook!
  "Call (f) after each evaluation from the REPL or the editor (norn.ui
  re-renders its windows this way, so redefining a view updates them).
  Returns key."
  [key f]
  (swap! %after-eval-hooks assoc key f)
  key)

(defn remove-after-eval-hook! "Remove the after-eval hook added under key. nil." [key]
  (swap! %after-eval-hooks dissoc key)
  nil)

(defn %run-after-eval-hooks []
  (doseq [[_ f] (deref %after-eval-hooks)]
    (handler-case (f) (Error [c] (println "after-eval hook failed:" (condition-text c))))))

;;; ---- for ---------------------------------------------------------------------------------------

(defn %for-cat
  "Concatenate (f x) for each x of coll, into a vector."
  [f coll]
  (reduce (fn [acc x] (into acc (f x))) [] coll))

(defn %for-cat-while
  "%for-cat, stopping at the first x whose (f x) is %for-stop."
  [f coll]
  (reduce (fn [acc x] (let [r (f x)] (if (identical? r %for-stop) (reduced acc) (into acc r)))) [] coll))

(defn- %for-emit [bindings body]
  (if (empty? bindings)
    `[(do ~@body)]
    (let [[a b & more] bindings]
      (cond (= a :let) `(let ~b ~(%for-emit more body))
            (= a :when) `(if ~b ~(%for-emit more body) [])
            (= a :while) `(if ~b ~(%for-emit more body) %for-stop)
            :else `(~(if (%while-follows? more) `%for-cat-while `%for-cat)
                    (fn [~a] ~(%for-emit more body)) ~b)))))

(defmacro for
  "List comprehension, eager: a vector of body's value for each binding of
  the names, left to right, nested. Bindings destructure; :let [...] binds
  more names, :when test skips, and :while test stops the binding before
  it at the first item for which test is false (as in Clojure).
  (for [x [1 2 3] :when (odd? x) y [:a :b]] [x y]) => [[1 :a] [1 :b] [3 :a] [3 :b]]
  (for [x (range) :while (< x 3)] x) => [0 1 2]"
  [bindings & body]
  (%comprehension-check "for" (vec bindings))
  (%for-emit (vec bindings) body))

;;; ---- more of Clojure's core (found missing while building the editor, M7.6) ---------------

(defn tree-seq
  "The nodes of a tree, depth first and lazily: root, then, when
  (branch? node), the nodes under each of (children node)."
  [branch? children root]
  (let [walk (fn walk [node]
               (lazy-seq (cons node (when (branch? node) (mapcat walk (children node))))))]
    (walk root)))

(defmacro case
  "Choose by constant: (case e k1 r1 (k2 k3) r2 default). A list of
  constants matches any of them; with no default and no match, an error."
  [e & clauses]
  (let [v (gensym "case")
        default? (odd? (count clauses))
        test (fn [k] (if (seq? k) `(contains? '~(set k) ~v) `(= ~v '~k)))]
    `(let [~v ~e]
       (cond ~@(mapcat (fn [[k body]] [(test k) body]) (partition 2 clauses))
             :else ~(if default? (last clauses) `(error "No case clause matches" ~v))))))

(defmacro condp
  "(condp pred e test1 r1 … default): the first ri whose (pred testi e)
  holds."
  [pred e & clauses]
  (let [p (gensym "pred") v (gensym "v")]
    `(let [~p ~pred ~v ~e]
       (cond ~@(mapcat (fn [[t r]] [`(~p ~t ~v) r]) (partition 2 clauses))
             :else ~(if (odd? (count clauses)) (last clauses) `(error "No condp clause matches" ~v))))))

(defmacro cond->
  "Thread e through each step (as ->) whose test is true."
  [e & clauses]
  (let [g (gensym "c")]
    `(let [~g ~e ~@(mapcat (fn [[t step]] [g `(if ~t (-> ~g ~step) ~g)]) (partition 2 clauses))] ~g)))

(defmacro cond->>
  "Thread e through each step (as ->>) whose test is true."
  [e & clauses]
  (let [g (gensym "c")]
    `(let [~g ~e ~@(mapcat (fn [[t step]] [g `(if ~t (->> ~g ~step) ~g)]) (partition 2 clauses))] ~g)))

(defmacro some->
  "Thread e through the forms (as ->) until one gives nil."
  [e & forms]
  (let [g (gensym "s")]
    `(let [~g ~e ~@(mapcat (fn [f] [g `(if (nil? ~g) nil (-> ~g ~f))]) forms)] ~g)))

(defmacro some->>
  "Thread e through the forms (as ->>) until one gives nil."
  [e & forms]
  (let [g (gensym "s")]
    `(let [~g ~e ~@(mapcat (fn [f] [g `(if (nil? ~g) nil (->> ~g ~f))]) forms)] ~g)))

(defmacro as->
  "Bind name to e, then to each form in turn (which use name)."
  [e name & forms]
  `(let [~name ~e ~@(mapcat (fn [f] [name f]) forms)] ~name))

(defmacro when-some
  "When the test isn't nil (false counts), bind it and do the body."
  [binding & body]
  `(let [t# ~(second binding)] (when (some? t#) (let [~(first binding) t#] ~@body))))

(defmacro if-some
  "If the test isn't nil (false counts), bind it and do then, else else."
  [binding then & else]
  `(let [t# ~(second binding)] (if (some? t#) (let [~(first binding) t#] ~then) (do ~@else))))

(defmacro when-first
  "Bind the first item of a non-empty collection and do the body."
  [binding & body]
  `(when-let [s# (seq ~(second binding))] (let [~(first binding) (first s#)] ~@body)))

(defn take-last "The last n items of coll, as a seq (nil if none)." [n coll]
  (let [v (vec coll)] (seq (drop (max 0 (- (count v) n)) v))))

(defn drop-last "coll without its last n items (default 1)."
  ([coll] (drop-last 1 coll))
  ([n coll] (let [v (vec coll)] (take (max 0 (- (count v) n)) v))))

(defn split-at "[(take n coll) (drop n coll)]." [n coll] [(take n coll) (drop n coll)])

(defn split-with "[(take-while pred coll) (drop-while pred coll)]." [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

(defn partition-by
  "coll split into runs on which (f x) stays the same: a seq of vectors
  (a stream of them, on a stream)."
  [f coll]
  (if (stream? coll)
    (lazy-seq (when-let [s (seq coll)]
                (let [x (first s) k (f x)]
                  (loop [r (rest s) run [x]]
                    (let [s2 (seq r)]
                      (if (and s2 (= k (f (first s2))))
                        (recur (rest s2) (conj run (first s2)))
                        (cons run (partition-by f r))))))))
    (seq (reduce (fn [out x]
                   (let [k (f x) last-run (peek out)]
                     (if (and last-run (= k (f (first last-run))))
                       (conj (pop out) (conj last-run x))
                       (conj out [x]))))
                 [] coll))))

(defn flatten
  "The items of nested sequential collections, as one seq (a stream, when
  x is one)."
  [x]
  (if (stream? x)
    (mapcat (fn [y] (if (sequential? y) (flatten y) [y])) x)
    (seq (reduce (fn [out y] (if (sequential? y) (into out (flatten y)) (conj out y))) [] (if (sequential? x) x [x])))))

(defn keep-indexed "The non-nil results of (f index x)." [f coll]
  (remove nil? (map-indexed f coll)))

(defn not-every? "Is (pred x) false for some x in coll?" [pred coll] (not (every? pred coll)))

(defn merge-with
  "Merge maps; where a key is in more than one, combine with (f old new)."
  [f & maps]
  (reduce (fn [acc m] (reduce-kv (fn [a k v] (if (contains? a k) (assoc a k (f (get a k) v)) (assoc a k v))) (or acc {}) m))
          nil (remove nil? maps)))

(defn rseq "A vector's (or sorted collection's) items in reverse, or nil." [v] (seq (reverse v)))

(defn subvec "Items start (inclusive) to end (exclusive) of vector v, as a vector."
  ([v start] (subvec v start (count v)))
  ([v start end]
   (when (or (neg? start) (> end (count v)) (> start end))
     (error "subvec indexes out of range:" start end))
   (if (vector? v) (%subvec v start end) (vec (take (- end start) (drop start v))))))

(defn max-key "The x for which (k x) is greatest." [k x & xs]
  (reduce (fn [a b] (if (> (k b) (k a)) b a)) x xs))

(defn min-key "The x for which (k x) is least." [k x & xs]
  (reduce (fn [a b] (if (< (k b) (k a)) b a)) x xs))

(defn some-fn "A predicate: is any of preds true of any argument?" [& preds]
  (fn [& xs] (some (fn [p] (some p xs)) preds)))

(defn every-pred "A predicate: are all preds true of every argument?" [& preds]
  (fn [& xs] (every? (fn [p] (every? p xs)) preds)))

(defn dorun "Walk coll (realizing a lazy one) for its effects; nil." [coll] (doseq [_ coll]) nil)
(defn run! "Call (f x) for each x in coll, for effects; nil." [f coll] (doseq [x coll] (f x)) nil)
(defn nthrest "coll without its first n items." [coll n] (drop n coll))
(defn fnext "(first (next x))." [x] (first (next x)))
(defn nfirst "(next (first x))." [x] (next (first x)))

(defn trampoline
  "Call f with args, then keep calling what it returns while that is a
  function (mutual recursion without growing the stack)."
  [f & args]
  (loop [r (apply f args)] (if (fn? r) (recur (r)) r)))

(defn ident? "Is x a keyword or a symbol?" [x] (or (keyword? x) (symbol? x)))
(defn int? "Is x an integer?" [x] (integer? x))
(defn pos-int? "Is x an integer above 0?" [x] (and (integer? x) (pos? x)))
(defn nat-int? "Is x an integer of 0 or more?" [x] (and (integer? x) (not (neg? x))))
(defn neg-int? "Is x an integer below 0?" [x] (and (integer? x) (neg? x)))
(defn double? "Is x a float?" [x] (float? x))
(defn any? "True of anything." [_] true)
(defn NaN? "Is x the float NaN?" [x] (and (float? x) (not (< x 1)) (not (>= x 1))))
(defn infinite? "Is x a float infinity?" [x] (and (float? x) (or (= x ##Inf) (= x ##-Inf))))

(defn update-keys "m with (f k) for each key k." [m f] (into {} (map (fn [[k v]] [(f k) v])) m))
(defn update-vals "m with (f v) for each value v." [m f] (into {} (map (fn [[k v]] [k (f v)])) m))

(defn reductions
  "The successive values of (reduce f init coll), init first, as a seq (a
  stream, on a stream)."
  ([f coll] (if (seq coll) (reductions f (first coll) (rest coll)) (list (f))))
  ([f init coll]
   (if (stream? coll)
     (let [step (fn step [acc s]
                  (cons acc (lazy-seq (when-let [s (seq s)] (step (f acc (first s)) (rest s))))))]
       (lazy-seq (step init coll)))
     (seq (reduce (fn [out x] (conj out (f (peek out) x))) [init] coll)))))

(defn eduction
  "The items of coll through transducer xform, as a vector (as sequence
  gives them). Eager: not for an infinite stream."
  [xform coll]
  (sequence xform coll))

(defn prn-str "What prn prints, as a string." [& xs] (with-out-str (apply prn xs)))
(defn print-str "What print prints, as a string." [& xs] (with-out-str (apply print xs)))

(defn volatile! "A mutable box (an atom here)." [x] (atom x))
(defn vswap! "Swap a volatile's value with f." [v f & args] (apply swap! v f args))
(defn vreset! "Set a volatile's value." [v x] (reset! v x))

(defn find "The entry [k v] of map m, or nil when m hasn't key k." [m k] (when (contains? m k) [k (get m k)]))
(defn key "A map entry's key." [e] (first e))
(defn val "A map entry's value." [e] (second e))

(defn list* "args, the last a collection, as a list: (list* 1 2 [3 4]) is (1 2 3 4)." [& args]
  (let [front (butlast args) more (last args)]
    (reduce (fn [acc x] (cons x acc)) (seq more) (reverse front))))

(defn boolean "x as true or false (nil and false are false)." [x] (if x true false))
(defn num "x, which must be a number." [x] (if (number? x) x (error "Not a number:" x)))
(defn long "x as an integer (truncating)." [x] (int x))
(defn double "x as a float." [x] (float x))
(defn ifn? "Can x be called: a function, keyword, map, set or vector?" [x]
  (or (fn? x) (keyword? x) (map? x) (set? x) (vector? x)))
(defn distinct? "Are all the arguments different?" [& xs] (= (count xs) (count (set xs))))

;;; ---- values that arrive later, and errors with data (M9 part 9.14) -----------------------
;;;
;;; deref (and @) waits for a value: an atom's or var's now, a fiber's when
;;; it ends, a delay's when it's first forced, a promise's when it's
;;; delivered, a future's when its fiber ends. A future is a fiber, so
;;; cancelling it, and the debugger when it fails, work as for any fiber;
;;; its failure is its deref's (the very condition, signalled again), not
;;; reported when it happens.

(defgeneric deref-object (x ms timeout-value)
  "deref for an object: its value, waiting for it (at most ms, then
  timeout-value, when ms isn't nil). Define a method to make a class of
  one's own something deref and @ work on.")

(defgeneric realized?-object (x)
  "realized? for an object: has its value arrived?")

(defmethod deref-object ((x StandardObject) ms timeout-value)
  (error TypeError :message (str "deref expects an atom, var, fiber, delay, promise or future, got " (pr-str x))
         :expected "something deref works on" :value x))

;; (deref itself is a primitive: atoms, vars and fibers there, and objects
;; handed to deref-object in its place, in the calling fiber)

(def ^:private %realized-stream? realized?) ; (the primitive: lazy streams)

(defn realized?
  "Has x's value arrived: a lazy stream's first cell computed, a delay
  forced, a promise delivered, a future's or fiber's work done?"
  [x]
  (cond (fiber? x) (done? x)
        (instance? StandardObject x) (realized?-object x)
        :else (%realized-stream? x)))

;; ---- promises ----

(defclass Promise () ((state :initarg :state) (done :initarg :done))
  (:doc "The class of promises, as promise makes: deliver, deref and realized?
  work on one. Its slots are internal."))

(defn promise
  "A promise: a value delivered once, later (deliver), which deref waits
  for. Any number of fibers may wait on it."
  []
  ;; (pending, the keyword: compare-and-set! compares by identity, and a
  ;; keyword is always the same object)
  (make Promise :state (atom ::pending) :done (chan)))

(defn deliver
  "Deliver x to promise p, waking every fiber waiting on it: p, or nil if
  something was delivered to it already."
  [p x]
  (when (compare-and-set! (:state p) ::pending [::delivered x])
    (close! (:done p))
    p))

(defn- %await-done
  "Wait for channel done to close (at most ms, when ms isn't nil): true if
  it did."
  [done ms]
  (if ms
    (let [[_ port] (alts! [done (timeout ms)])] (identical? port done))
    (do (take! done) true)))

(defmethod deref-object ((p Promise) ms timeout-value)
  (let [s @(:state p)]
    (if (vector? s)
      (second s)
      (if (%await-done (:done p) ms) (second @(:state p)) timeout-value))))

(defmethod realized?-object ((p Promise)) (vector? @(:state p)))

;; ---- delays ----

(defclass Delay () ((thunk :initarg :thunk) (claimed :initarg :claimed) (result :initarg :result))
  (:doc "The class of delays, as delay makes: deref, force and realized? work on
  one. Its slots are internal."))

(defn %delay [thunk] (make Delay :thunk thunk :claimed (atom nil) :result (promise)))

(defmacro delay
  "(delay body…): body, computed the first time deref (or force) asks for
  it, and that value from then on. Fibers asking while it's computed wait
  for it. If body fails, every deref signals that same condition."
  [& body]
  `(%delay (fn* [] ~@body)))

(defn delay? "Is x a delay?" [x] (instance? Delay x))

(defmethod deref-object ((d Delay) _ms _timeout-value)
  (let [me (current-fiber)]
    (when (compare-and-set! (:claimed d) nil me)
      ;; (this fiber computes it: the value, or the condition it failed with)
      (deliver (:result d)
               (handler-case [::value ((:thunk d))]
                 (Error [c] [::failed c]))))
    (when (and (identical? @(:claimed d) me) (not (realized? (:result d))))
      (error "This delay needs its own value to compute it"))
    (let [[how x] @(:result d)]
      (if (= how ::failed) (error x) x))))

(defmethod realized?-object ((d Delay)) (realized? (:result d)))

(defn force "x's value if it's a delay (computing it the first time), else x." [x]
  (if (delay? x) @x x))

;; ---- futures ----

(defclass Future () ((fiber :initarg :fiber) (done :initarg :done))
  (:doc "The class of futures, as future makes: deref, future-cancel and
  future-done? work on one. Its slots are internal."))

(defn %future [thunk]
  (let [done (chan)]
    ;; (in a scope of its own, which nobody joins: its failure is for its
    ;; deref, not reported when it happens)
    (make Future :done done
          :fiber (%scope-spawn (%scope) (fn* [] (try (thunk) (finally (close! done))))))))

(defmacro future
  "(future body…): body, run in a fiber of its own; deref (or @) waits
  for its value, and signals the condition it failed with, if it did.
  future-cancel cancels it."
  [& body]
  `(%future (fn* [] ~@body)))

(defn future? "Is x a future?" [x] (instance? Future x))
(defn future-done? "Has future f finished (or failed, or been cancelled)?" [f] (done? (:fiber f)))
(defn future-cancel
  "Cancel future f's fiber (one cancelled before it started never runs its
  body, so this says it's done too)."
  [f]
  (cancel! (:fiber f))
  (close! (:done f))
  nil)
(defn future-cancelled? "Was future f cancelled?" [f]
  (and (done? (:fiber f)) (= "Cancelled" (fiber-error (:fiber f)))))

(defmethod deref-object ((f Future) ms timeout-value)
  ;; (with no timeout, the fiber's own join, which every way of ending
  ;; reaches; with one, the done channel its body closes)
  (if (or (nil? ms) (done? (:fiber f)) (%await-done (:done f) ms))
    (await (:fiber f))
    timeout-value))

(defmethod realized?-object ((f Future)) (done? (:fiber f)))

;; ---- errors with data ----

(defclass ExInfo (Error) ((data :initform nil) (cause :initform nil))
  (:doc "The error ex-info makes: :data (a map) and :cause (the condition that
  caused it, or nil), which ex-data and ex-cause read."))

(defn ex-info
  "A condition carrying data (a map), and perhaps the condition that caused
  it: (throw (ex-info \"Bad order\" {:id 7})), or (error …). A handler reads
  them with ex-data and ex-cause."
  ([msg data] (ex-info msg data nil))
  ([msg data cause]
   (when-not (map? data) (error TypeError :message "ex-info's data must be a map" :expected "a map" :value data))
   (make ExInfo :message msg :data data :cause cause :location (%location))))

(defn ex-data
  "Condition c's data: an ex-info's map, or the slots a runtime error says
  what went wrong with ({:path … :reason :not-found} for a FileNotFound);
  nil when there are none."
  [c]
  (cond (instance? ExInfo c) (:data c)
        (instance? Condition c)
        (let [m (into {} (keep (fn [s] (let [k (keyword (name (:name s))) v (get c k)]
                                         (when (and (some? v) (not (contains? #{:message :trace :location} k))) [k v]))))
                      (class-slots (class-of c)))]
          (when (seq m) m))
        :else nil))

(defn ex-message "Condition c's message." [c] (when (instance? Condition c) (condition-message c)))
(defn ex-cause "The condition that caused c (an ex-info's cause), or nil." [c] (when (instance? ExInfo c) (:cause c)))

;;; ---- pattern matching on data (M9 part 9.2) ----------------------------------------------
;;;
;;; (match x
;;;   [:get from]           (send from n)
;;;   [:put k v] :when (keyword? k) (assoc m k v)
;;;   {:op :add :args [a b]} (+ a b)
;;;   _                     :unknown)
;;;
;;; A clause is a pattern, perhaps :when and a guard (with the pattern's
;;; names bound), then the body. The first clause that matches gives the
;;; value; its body is in tail position, so recur works there. When none
;;; matches, a MatchError says what the value was. Patterns:
;;;
;;;   _                 anything
;;;   name              anything, bound to name (twice in one pattern: equal values)
;;;   nil, true, 1, "s", \c, :k   that value
;;;   'sym, '(a b)      that data
;;;   [p … & rest]      a sequential value (vector, list or seq) of those
;;;                     parts, rest bound to what's left (nil if nothing)
;;;   {:k p …}          a map with those keys, their values matching
;;;   (:or p …)         any of them (each binding the same names)
;;;   (:as p name)      p, with the whole value bound to name too
;;;   (:? pred p)       a value pred is true of, matching p (or anything)
;;;   :else             anything (for a last clause)

(defclass MatchError (Error) ((value :initform nil))
  (:doc "No clause of a match matched: :value is the value matched."))

(defn %pattern-vars
  "The names pattern p binds, in order."
  [p]
  (cond (= p '_) []
        (and (symbol? p) (nil? (namespace p)) (not= p '&)) [p]
        (and (seq? p) (= 'quote (first p))) []
        (and (seq? p) (contains? #{:or} (first p))) (%pattern-vars (second p))
        (and (seq? p) (= :as (first p))) (conj (%pattern-vars (second p)) (nth p 2))
        (and (seq? p) (= :? (first p))) (if (> (count p) 2) (%pattern-vars (nth p 2)) [])
        (vector? p) (vec (mapcat %pattern-vars (remove (fn [x] (= x '&)) p)))
        (map? p) (vec (mapcat %pattern-vars (vals p)))
        :else []))

(defn- %emit-match
  "Code testing pattern p against the value in symbol v: the code (kf)
  gives (with p's names bound) if it matches, else nil. kf is called only
  once p's own names are known, so a name repeated to its right is a
  comparison and not a second binding. seen: an atom of the names bound
  so far in this pattern."
  [p v kf seen]
  (cond
    (= p '_) (kf)
    (and (symbol? p) (nil? (namespace p)) (not= p '&))
    (if (contains? @seen p)
      `(when (= ~v ~p) ~(kf))
      (do (swap! seen conj p) `(let* [~p ~v] ~(kf))))
    (nil? p) `(when (nil? ~v) ~(kf))
    (or (boolean? p) (number? p) (string? p) (char? p) (keyword? p)) `(when (= ~v ~p) ~(kf))
    (and (seq? p) (= 'quote (first p))) `(when (= ~v ~p) ~(kf))
    (and (seq? p) (= :or (first p)))
    (let [alts (rest p)
          vars (%pattern-vars (first alts))
          r (gensym "alt")]
      (doseq [a (rest alts)]
        (when-not (= (set vars) (set (%pattern-vars a)))
          (error "Each pattern in (:or …) must bind the same names:" (pr-str p))))
      (let [before @seen
            tries (mapv (fn [a] (reset! seen before) (%emit-match a v (fn [] (vec vars)) seen)) alts)]
        (reset! seen (into before vars))
        `(let* [~r (or ~@tries)]
           (when ~r (let* [~@(mapcat (fn [x i] [x `(nth ~r ~i)]) vars (range (count vars)))] ~(kf))))))
    (and (seq? p) (= :as (first p)))
    (let [[_ q nm] p]
      (swap! seen conj nm)
      `(let* [~nm ~v] ~(%emit-match q v kf seen)))
    (and (seq? p) (= :? (first p)))
    (let [[_ pred q] p]
      `(when (~pred ~v) ~(if (> (count p) 2) (%emit-match q v kf seen) (kf))))
    (vector? p)
    (let [amp (%index-of p '&)
          fixed (if amp (subvec p 0 amp) p)
          rest-p (when amp (get p (inc amp)))
          n (count fixed)
          parts (mapv (fn [_] (gensym "part")) fixed)
          rest-s (gensym "rest")
          pairs (map vector (if rest-p (conj fixed rest-p) fixed) (if rest-p (conj parts rest-s) parts))
          ;; (left to right: each part's names are known before the parts
          ;; to its right are emitted)
          chain (fn chain [ps] (if (empty? ps) (kf) (let [[q s] (first ps)] (%emit-match q s (fn [] (chain (rest ps))) seen))))]
      `(when (and (sequential? ~v) ~(if rest-p `(>= (count ~v) ~n) `(= (count ~v) ~n)))
         (let* [~@(mapcat (fn [s i] [s `(nth ~v ~i)]) parts (range (count parts)))
                ~@(when rest-p [rest-s `(seq (drop ~n ~v))])]
           ~(chain pairs))))
    (map? p)
    (let [entries (vec p)
          ss (mapv (fn [_] (gensym "val")) entries)
          chain (fn chain [ps] (if (empty? ps) (kf) (let [[[_ q] s] (first ps)] (%emit-match q s (fn [] (chain (rest ps))) seen))))]
      `(when (and (map? ~v) ~@(map (fn [[key _]] `(contains? ~v ~key)) entries))
         (let* [~@(mapcat (fn [[key _] s] [s `(get ~v ~key)]) entries ss)]
           ~(chain (map vector entries ss)))))
    :else (error "Not a pattern:" (pr-str p))))

(defmacro match
  "(match x pattern [:when guard] body …): the body of the first clause
  whose pattern x matches (and whose guard is true, its names bound);
  a MatchError if none does. See the patterns above."
  {:indent 1}
  [x & clauses]
  (let [v (gensym "v")
        clauses (loop [cs (seq clauses) out []]
                  (if (nil? cs)
                    out
                    (let [[p & more] cs
                          [guard more] (if (= :when (first more)) [(second more) (nnext more)] [true more])]
                      (when (empty? more) (error "match: a clause needs a body after its pattern:" (pr-str p)))
                      (recur (next more) (conj out [(if (= p :else) '_ p) guard (first more)])))))
        fail `(error MatchError :message (str "No clause of match matched " (pr-str ~v)) :value ~v)]
    `(let* [~v ~x]
       ~(reduce (fn [nxt [p guard body]]
                  (let [vars (%pattern-vars p)
                        b (gensym "bound")
                        ok (gensym "ok")
                        bind (vec (mapcat (fn [s i] [s `(nth ~b ~i)]) vars (range (count vars))))
                        ;; (the guard sees only the names it mentions: binding
                        ;; the rest there too would leave them unused)
                        mentioned (set (filter symbol? (tree-seq coll? seq guard)))
                        guard-bind (vec (mapcat (fn [s i] (when (contains? mentioned s) [s `(nth ~b ~i)])) vars (range (count vars))))]
                    `(let* [~b ~(%emit-match p v (fn [] (vec vars)) (atom #{}))
                            ~ok ~(if (true? guard) `(if ~b true false) `(if ~b (let* ~guard-bind ~guard) false))]
                       (if ~ok (let* ~bind ~body) ~nxt))))
                fail
                (reverse clauses)))))

;;; ---- contracts, with blame (M9 part 9.4) ---------------------------------------------------
;;;
;;; A contract says what a value must be: a predicate (int?), a class
;;; (String), or a combination (fn-of, any-of, all-of, vec-of, map-of,
;;; nilable). A function's contract is checked on calls from other modules
;;; (and the REPL), through a wrapper the expander puts in the caller's
;;; place; the module's own calls go direct. A violation is a
;;; ContractError blaming the side at fault: the calling module for a bad
;;; argument, the function's own module for a bad result. A signature
;;; (9.3: ^Integer x) is a contract too; defcontract gives one directly.

(defclass ContractError (Error)
  ((function :initform nil) (position :initform nil) (expected :initform nil)
                            (value :initform nil) (blame :initform nil))
  (:doc "A contract or signature didn't hold. :function names the function,
  :position says what was wrong (\"its 2nd argument\", its result),
  :expected is the contract's name, :value what came, and :blame the side
  at fault (a module, or \"the function's caller\")."))

;; check: (fn [v fail] …) gives v (or v wrapped, for a function contract),
;; or calls (fail). parts: a function contract's {:args :rest :result}.
(defclass Contract ()
  ((name :initarg :name) (check :initarg :check) (parts :initform nil)
                         ;; for a contract that only tests (a class, a predicate): the test, which
                         ;; a checked call uses directly
                         (test :initform nil)
                         ;; for one that wraps a function (fn-of, or a combination holding one):
                         ;; check as (fn [v fail giver user] …), giver blamed for the wrapped
                         ;; function's bad results, user for its bad arguments
                         (blamed :initform nil))
  (:doc "The class of contracts, as ->contract, fn-of, any-of, vec-of,
  defcontract and the rest make; contract? tests for one. :name is what
  messages call it, and (:check c) checks a value against it."))

(def ^:dynamic *check-contracts*
  "Which calls check contracts, when code is expanded: :boundaries
  (calls from other modules: the default), :all (the module's own too),
  or :none."
  :boundaries)

(defn contract? "Is x a contract (made by fn-of and the rest)?" [x] (instance? Contract x))

(defn- %after [s sep] (let [i (%str-index s sep nil false)] (if i (subs s (+ i (count sep))) s)))

(defn- %fn-label
  "Function f's name, as pr-str shows it (norn.core/int?), or fn."
  [f]
  (let [s (pr-str f)
        s (cond (= 0 (%str-index s "#<primitive " nil false)) (subs s 12)
                (= 0 (%str-index s "#<fn " nil false)) (subs s 5)
                :else (str s ">"))]
    (subs s 0 (dec (count s)))))

(defn ->contract
  "x as a contract: a contract itself; a class (an instance of it); a
  predicate; nil or :any (anything)."
  [x]
  (cond (contract? x) x
        (or (nil? x) (= x :any)) (make Contract :name "anything" :check (fn [v _] v))
        (class? x) (let [t (fn [v] (instance? x v))]
                     (make Contract :name (name (class-name x)) :check (fn [v fail] (if (t v) v (fail))) :test t))
        (fn? x) (make Contract :name (%after (%fn-label x) "/") :check (fn [v fail] (if (x v) v (fail))) :test x)
        :else (error TypeError :message (str "Not a contract: " (pr-str x)) :expected "a contract, class or predicate" :value x)))

(defn contract-name "What contract c says, as text." [c] (:name (->contract c)))

(defn %contract-check
  "v checked against contract c: v (or v wrapped, for a function
  contract), else a ContractError. ctx: {:function :position :blame}."
  [c v ctx]
  (let [c (->contract c)]
    ((:check c) v (fn [] (error ContractError
                                :message (str (:function ctx) ": " (:position ctx) " should be " (:name c) ", got " (pr-str v)
                                              ", blaming " (:blame ctx))
                                :function (:function ctx) :position (:position ctx) :expected (:name c)
                                :value v :blame (:blame ctx))))))

(defn- %check-blaming
  "v checked against contract c, a function it wraps blaming giver for a
  bad result and user for a bad argument."
  [c v fail giver user]
  (if-let [b (:blamed c)] (b v fail giver user) ((:check c) v fail)))

(defn nilable "A contract: nil, or what c says." [c]
  (let [c (->contract c)
        t (:test c)
        b (:blamed c)]
    (make Contract :name (str "nil or " (:name c)) :check (fn [v fail] (if (nil? v) v ((:check c) v fail)))
          ;; (a plain test when c has one, as for a class: cheaper to check)
          :test (when t (fn [v] (or (nil? v) (t v))))
          :blamed (when b (fn [v fail giver user] (if (nil? v) v (b v fail giver user)))))))

(defn any-of "A contract: what any of cs says (the first that holds)." [& cs]
  (let [cs (mapv ->contract cs)
        ;; (when each of cs has a plain test, as classes and predicates do,
        ;; so does this: no catch for each one tried)
        test (when (every? :test cs)
               (let [ts (mapv :test cs)]
                 (fn [v] (loop [ts (seq ts)] (cond (nil? ts) false ((first ts) v) true :else (recur (next ts)))))))]
    (let [one-of (fn [v fail giver user]
                   (loop [cs (seq cs)]
                     (if (nil? cs)
                       (fail)
                       (let [r (catch-tag ::failed (%check-blaming (first cs) v (fn [] (throw-tag ::failed ::failed)) giver user))]
                         (if (= r ::failed) (recur (next cs)) r)))))]
      (make Contract :name (apply str (interpose " or " (map :name cs)))
            :check (if test
                     (fn [v fail] (if (test v) v (fail)))
                     (fn [v fail] (one-of v fail nil nil)))
            :test test
            :blamed (when (some :blamed cs) one-of)))))

(defn all-of "A contract: what every one of cs says." [& cs]
  (let [cs (mapv ->contract cs)
        test (when (every? :test cs)
               (let [ts (mapv :test cs)] (fn [v] (every? (fn [t] (t v)) ts))))]
    (make Contract :name (apply str (interpose " and " (map :name cs)))
          :check (if test
                   (fn [v fail] (if (test v) v (fail)))
                   (fn [v fail] (reduce (fn [x c] ((:check c) x fail)) v cs)))
          :test test
          :blamed (when (some :blamed cs)
                    (fn [v fail giver user] (reduce (fn [x c] (%check-blaming c x fail giver user)) v cs))))))

(defn- %vec-checked
  "Vector v with f applied to each item: v itself when f gives every item
  back (only a function contract wraps one)."
  [v f]
  (let [n (count v)]
    (loop [i 0 out nil]
      (if (< i n)
        (let [x (nth v i) y (f x)]
          (recur (inc i) (cond out (conj! out y)
                               (identical? x y) nil
                               :else (conj! (reduce conj! (transient []) (subvec v 0 i)) y))))
        (if out (persistent! out) v)))))

(defn- %map-checked
  "Map m with fk applied to each key and fv to each value: m itself when
  they give every one back."
  [m fk fv]
  (let [r (reduce-kv (fn [acc k x]
                       (let [k2 (fk k) x2 (fv x)]
                         [(and (nth acc 0) (identical? k k2) (identical? x x2)) (assoc (nth acc 1) k2 x2)]))
                     [true {}] m)]
    (if (nth r 0) m (nth r 1))))

(defn vec-of
  "A contract: a vector whose every item is what c says. A vector that
  holds is passed on as it is (checked in place, not copied)."
  [c]
  (let [c (->contract c)
        t (:test c)
        b (:blamed c)
        test (when t (fn [v] (and (vector? v) (every? t v))))]
    (make Contract :name (str "a vector of " (:name c))
          :check (if test
                   (fn [v fail] (if (test v) v (fail)))
                   (fn [v fail] (if (vector? v) (%vec-checked v (fn [x] ((:check c) x fail))) (fail))))
          :test test
          :blamed (when b (fn [v fail giver user]
                            (if (vector? v) (%vec-checked v (fn [x] (b x fail giver user))) (fail)))))))

(defn map-of
  "A contract: a map whose keys are what kc says, and values vc. A map that
  holds is passed on as it is (checked in place, not copied)."
  [kc vc]
  (let [kc (->contract kc) vc (->contract vc)
        kt (:test kc) vt (:test vc)
        test (when (and kt vt)
               (fn [v] (and (map? v) (reduce-kv (fn [_ k x] (if (and (kt k) (vt x)) true (reduced false))) true v))))]
    (make Contract :name (str "a map of " (:name kc) " to " (:name vc))
          :check (if test
                   (fn [v fail] (if (test v) v (fail)))
                   (fn [v fail]
                     (if (map? v) (%map-checked v (fn [k] ((:check kc) k fail)) (fn [x] ((:check vc) x fail))) (fail))))
          :test test
          :blamed (when (or (:blamed kc) (:blamed vc))
                    (fn [v fail giver user]
                      (if (map? v)
                        (%map-checked v (fn [k] (%check-blaming kc k fail giver user)) (fn [x] (%check-blaming vc x fail giver user)))
                        (fail)))))))

(defn- %ordinal [n]
  (str n (cond (and (>= (rem n 100) 11) (<= (rem n 100) 13)) "th"
               (= 1 (rem n 10)) "st" (= 2 (rem n 10)) "nd" (= 3 (rem n 10)) "rd" :else "th")))

(defn- %contract-fail
  "A ContractError: v isn't what contract c says, at position (made into
  text only now, when it failed) of function who, blaming blame."
  [c v who position blame]
  (let [position (if (integer? position) (str "its " (%ordinal (inc position)) " argument") position)]
    (error ContractError
           :message (str who ": " position " should be " (:name c) ", got " (pr-str v) ", blaming " blame)
           :function who :position position :expected (:name c) :value v :blame blame)))

(defn %check-call
  "Call f with args, checking them against parts' :args (and the rest
  against :rest) and its result against :result (all contracts already).
  who: the function's name; caller and provider: who's blamed for a bad
  argument, and a bad result. (Messages are made only on a failure: a
  check that holds costs its test.)"
  [f args parts who caller provider]
  (let [arg-cs (:args parts)
        rest-c (:rest parts)
        result-c (:result parts)
        n (count arg-cs)
        ;; (a function passed in: its giver is the caller, its user the
        ;; provider; a function given back the other way round)
        checked (loop [as (seq args) i 0 out (transient [])]
                  (if as
                    (let [a (first as)
                          c (if (< i n) (nth arg-cs i) rest-c)]
                      (recur (next as) (inc i)
                             (conj! out (if c (%check-blaming c a (fn [] (%contract-fail c a who i caller)) caller provider) a))))
                    (persistent! out)))
        r (case (count checked)
            0 (f)
            1 (f (nth checked 0))
            2 (f (nth checked 0) (nth checked 1))
            3 (f (nth checked 0) (nth checked 1) (nth checked 2))
            (apply f checked))]
    (if result-c (%check-blaming result-c r (fn [] (%contract-fail result-c r who "its result" provider)) provider caller) r)))

(defn fn-of
  "A contract: a function whose arguments are what arg-cs say (a vector)
  and whose result is what result-c says (:rest c: the arguments after
  them). Calling the function it wraps blames the caller for a bad
  argument and the function's giver for a bad result. In a signature
  those are modules: for a function passed in, the module that passed it
  is its giver and the function's own module its caller; for one given
  back, the other way round. (Checked directly, with (:check c), they are
  \"the function's caller\" and \"the function\".)"
  [arg-cs result-c & {:keys [rest]}]
  (let [parts {:args (mapv ->contract arg-cs) :result (->contract result-c) :rest (when rest (->contract rest))}
        wrap (fn [v fail giver user]
               (if (fn? v)
                 (fn [& args] (%check-call v args parts (%fn-label v) user giver))
                 (fail)))]
    (with (make Contract :name (str "(fn-of [" (apply str (interpose " " (map :name (:args parts)))) "] " (:name (:result parts)) ")")
                :check (fn [v fail] (wrap v fail "the function" "the function's caller")))
          :parts parts :blamed wrap)))

;; ---- a function's contract, at module boundaries ----

(defn %contract-of
  "Var v's contract: parts {:args :rest :result} (or a vector of them, one
  per arity, each with :nfixed and :variadic), or nil."
  [v]
  (when (%contracted? v) (%bound-value (symbol (str (%var-name v) "%contract")))))

(defn- %arity-parts [parts n]
  (if (map? parts)
    parts
    (or (some (fn [p] (when (and (not (:variadic p)) (= n (:nfixed p))) p)) parts)
        (some (fn [p] (when (and (:variadic p) (>= n (:nfixed p))) p)) parts))))

(defn %wrap-for
  "The function another module (caller) calls in var v's place: v's
  function with its contract checked, read on each call so a
  redefinition takes effect."
  [v caller]
  (let [n (%var-name v)
        module (subs n 0 (%str-index n "/" nil false))
        ;; (the contract's var, named once here, not on every call)
        contract-sym (symbol (str n "%contract"))
        ;; (its var, when it has one already: cheaper to read than the name)
        contract-var (resolve contract-sym)
        parts-for (fn [k]
                    (when (%contracted? v)
                      (%arity-parts (if contract-var (var-get contract-var) (%bound-value contract-sym)) k)))
        ;; argument i checked against parts' contract for it
        arg (fn [p a i]
              (let [cs (:args p)
                    c (if (< i (count cs)) (nth cs i) (:rest p))]
                (cond (nil? c) a
                      (:test c) (if ((:test c) a) a (%contract-fail c a n i caller))
                      :else (%check-blaming c a (fn [] (%contract-fail c a n i caller)) caller module))))
        result (fn [p r]
                 (let [c (:result p)]
                   (cond (nil? c) r
                         (:test c) (if ((:test c) r) r (%contract-fail c r n "its result" module))
                         :else (%check-blaming c r (fn [] (%contract-fail c r n "its result" module)) module caller))))]
    ;; (the usual arities check their arguments in place: no argument list,
    ;; vector or apply)
    (fn
      ([] (if-let [p (parts-for 0)] (result p ((var-get v))) ((var-get v))))
      ([a] (if-let [p (parts-for 1)] (result p ((var-get v) (arg p a 0))) ((var-get v) a)))
      ([a b] (if-let [p (parts-for 2)] (result p ((var-get v) (arg p a 0) (arg p b 1))) ((var-get v) a b)))
      ([a b c] (if-let [p (parts-for 3)] (result p ((var-get v) (arg p a 0) (arg p b 1) (arg p c 2))) ((var-get v) a b c)))
      ([a b c & more]
       (let [args (list* a b c more)]
         (if-let [p (parts-for (count args))]
           (%check-call (var-get v) args p n caller module)
           (apply (var-get v) args)))))))

(defn %drop-contract! "Function var v has no contract now." [v] (%set-contracted! v false) nil)

(defn %type->contract
  "Type t (written as ^t: a class, Any, or (? T) (U A B…) (Vec T) (Map K V)
  (-> A… R)) as a contract, its names read in namespace home."
  [t home where]
  (let [bad (fn [] (error TypeError :message (str where ": ^" (pr-str t) " isn't a type: a type is a class, Any, "
                                                  "(? T), (U A B…), (Vec T), (Map K V) or (-> A… R); "
                                                  "for a predicate, say defcontract")
                          :expected "a type" :value t))
        sub (fn [x] (%type->contract x home where))]
    (cond (nil? t) nil
          (= t 'Any) (->contract :any)
          (symbol? t) (let [v (%resolve-in home t)
                            c (when v (%bound-value (symbol (%var-name v))))]
                        (if (class? c) (->contract c) (bad)))
          (and (seq? t) (seq t))
          (case (first t)
            ? (if (= 2 (count t)) (nilable (sub (second t))) (bad))
            U (apply any-of (map sub (rest t)))
            Vec (if (= 2 (count t)) (vec-of (sub (second t))) (bad))
            Map (if (= 3 (count t)) (map-of (sub (second t)) (sub (nth t 2))) (bad))
            -> (if (>= (count t) 2) (fn-of (mapv sub (butlast (rest t))) (sub (last t))) (bad))
            (bad))
          :else (bad))))

;; ---- slot types (defclass's :type) ----

(defn- %slot-contracts
  "Class c's slot contracts, {slot contract}, made from the slots' :type
  when first needed (so a slot can name a class defined after it)."
  [c]
  (let [[types cell] (::slot-types (%class-get c :meta))]
    (or @cell
        (let [cname (class-name c)
              home (symbol (namespace cname))]
          (reset! cell (reduce (fn [m [k t]] (assoc m k (%type->contract t home (str cname " slot " k)))) {} types))))))

(defn- %check-slot
  "A ContractError unless v is what slot k of class c says it is."
  [c k v]
  (when-let [ct (get (%slot-contracts c) k)]
    ;; (a function type checks only that v is a function: the slot keeps v)
    ((:check ct) v (fn [] (error ContractError
                                 :message (str (class-name c) ": its slot " k " should be " (:name ct) ", got " (pr-str v))
                                 :function (str (class-name c)) :position (str "its slot " k) :expected (:name ct) :value v)))))

(defn %check-slot-types
  "Instance o, its slots checked against their :type (when its class has
  any)."
  [o]
  (let [c (class-of o)]
    (when (%class-flag? c 8)
      (doseq [[k _] (%slot-contracts c)] (%check-slot c k (%slot-value-basic o k)))))
  o)

(defn %with-typed
  "(with o :k v…) (and assoc) for an instance whose class has slot types:
  the new values checked first."
  [o & kvs]
  (let [c (class-of o)]
    (loop [s (seq kvs)]
      (when (next s) (%check-slot c (first s) (second s)) (recur (next (next s)))))
    (apply %with o kvs)))

(defn %set-slot-typed
  "set-slot! for an instance whose class has slot types: v checked first."
  [o k v]
  (%check-slot (class-of o) k v)
  (%set-slot-unchecked! o k v))

(defn %signature-parts
  "The contract a function's signature says (sigs: its arities' types, as
  the expander reads them), its names read in namespace home; marks the
  function as having one. who: its full name."
  [sigs home who]
  (let [parts (mapv (fn [a]
                      (assoc a
                             :args (mapv (fn [t] (%type->contract t home who)) (:args a))
                             :rest (%type->contract (:rest a) home who)
                             :result (%type->contract (:result a) home who)))
                    sigs)]
    (%set-contracted! (%resolve-in home (symbol (%after who "/"))) true)
    (if (= 1 (count parts)) (first parts) parts)))

(defmacro defcontract
  "(defcontract f (fn-of [arg-contract…] result-contract)): function f's
  contract, checked on calls from other modules (and the REPL), blaming
  the caller for a bad argument and f's module for a bad result."
  [fname c]
  (let [cname (symbol (str (name fname) "%contract"))]
    `(do (def ~cname
           (let [c# ~c]
             (or (:parts c#) (error TypeError :message "defcontract takes (fn-of …)" :expected "(fn-of …)" :value c#))))
         (%set-private! (var ~cname))
         (%set-contracted! (var ~fname) true)
         (var ~fname))))

;; ---- declarations for the optimiser (M9 part 9.3) ----

(def %declarations
  "[place declarations] for each (declare (optimize …) (type …)…) read,
  for M10's optimiser."
  (atom []))

(defmacro declare
  "(declare name…): declare names defined later. (declare (optimize (speed
  3)) (type Integer x)…): declarations for the optimiser (M10), recorded
  with where they're written and otherwise doing nothing yet."
  [& xs]
  (if (and (seq xs) (every? seq? xs))
    (do (swap! %declarations conj [(%location) (vec xs)]) nil)
    `(do ~@(map (fn [n] (list 'def n)) xs))))

;;; ---- the meta-object protocol (M9 part 9.5, design §4.3) ----------------------------------
;;;
;;; Classes are instances of StandardClass (or of a metaclass, a subclass
;;; of it, named with (:metaclass M) in defclass), and generic functions of
;;; StandardGenericFunction (or of a subclass, named with
;;; (:generic-function-class C) in defgeneric). The protocol is generic
;;; functions with methods for the standard ones; specialise them to change
;;; how instances are made, initialised, read and printed, or how methods
;;; are chosen and combined. Whatever specialises none of them keeps the
;;; fast paths: a class without a metaclass or an initialize-instance
;;; method is made directly, its slots read directly, a standard generic
;;; function dispatched as before.

(def StandardClass "The class of classes (Class), and of metaclasses' instances' superclass." Class)
(def StandardGenericFunction "The class of generic functions." GenericFunction)

(defgeneric make-instance (c & initargs)
  "Make an instance of class c: make does this for a class whose metaclass,
  or initialize-instance methods, say so. The standard method makes it from
  the initargs, then hands it to initialize-instance.")

(defgeneric initialize-instance (obj initargs)
  "Instance obj, just made from initargs (a map), as it should start: the
  standard method gives it back. Instances are values, so a method returns
  the instance, changed with (with …) as it likes, after (call-next-method).")

(defgeneric slot-value-using-class (c obj slot)
  "Slot slot of obj, an instance of class c: slot-value does this for a
  class with a metaclass, which may specialise it.")

(defgeneric print-object (obj)
  "The text obj prints as. A method for a class makes its instances print
  so, everywhere print, prn, str, pr-str, format and spit print them.")

(defgeneric compute-applicable-methods (gf args)
  "The methods of generic function gf that apply to args.")

(defgeneric compute-effective-method (gf methods cpls)
  "The function gf calls for these applicable methods (cpls: the arguments'
  class precedence lists, for ordering them).")

(defn %print-plain
  "How x prints with no print-object method of its class's: as a record,
  #ns/Class{:k v…}."
  [x]
  (%pr-plain x))

(defmethod make-instance ((c StandardClass) & initargs)
  (initialize-instance (%check-slot-types (%make-from c initargs)) (apply hash-map initargs)))

(defmethod initialize-instance ((o StandardObject) _initargs) o)

(defmethod slot-value-using-class ((_c StandardClass) obj slot) (%slot-value-basic obj slot))

(defmethod print-object ((o Object)) (%print-plain o))

;; Collections a library defines: seq, count and nth call these for
;; instances (built-in collections never reach them, so they keep their
;; fast paths). A class needs only collection-seq; reduce, into, map,
;; first, vec and the rest work through it.

(defgeneric collection-seq (coll)
  "The items of instance coll as a seq (or anything seq accepts, or nil
  when it's empty). A method for a class makes seq, and every sequence
  function, take its instances.")

(defgeneric collection-count (coll)
  "How many items instance coll has. The default counts collection-seq's;
  a method for a class that knows its count makes count constant time.")

(defgeneric collection-nth (coll index)
  "Item index of instance coll, or an IndexError when it has none there.
  The default walks collection-seq; a method for an indexed class makes
  nth constant time.")

(defmethod collection-seq ((o Object))
  (error TypeError :message (str "Don't know how to create a seq from " (name (class-name (class-of o))))))

(defmethod collection-count ((o Object)) (count (collection-seq o)))

(defmethod collection-nth ((o Object) index) (nth (collection-seq o) index))

(defn- %collection-items [coll]
  (let [items (collection-seq coll)]
    (when (%instance? items)
      (error TypeError :message "collection-seq must give a seq or a built-in collection, not another instance"))
    items))

(defn %collection-op
  "What seq, first, rest, next, count, nth, vec and set do for instance
  coll: the primitives hand the call here, so its methods run as ordinary
  calls in the fiber (they can signal, be caught, and park)."
  [op coll & args]
  (case op
    :seq (seq (%collection-items coll))
    :first (first (%collection-items coll))
    :rest (rest (%collection-items coll))
    :next (next (%collection-items coll))
    :vec (vec (%collection-items coll))
    :set (set (%collection-items coll))
    :count (collection-count coll)
    :nth (let [index (first args)]
           (if (next args)
             ;; (with a default, checked against the count: a method signals
             ;; IndexError only when there's no default)
             (if (and (integer? index) (<= 0 index) (< index (collection-count coll)))
               (collection-nth coll index)
               (second args))
             (collection-nth coll index)))))

(defmethod compute-applicable-methods ((gf StandardGenericFunction) args) (%applicable-methods gf args))

(defmethod compute-effective-method ((gf StandardGenericFunction) methods cpls) (%build-em gf methods cpls))

;; ---- method combinations of one's own ----

(defmacro define-method-combination
  "(define-method-combination name :operator op): a method combination,
  for (defgeneric … (:method-combination name)), whose primary methods'
  results are combined with op (a function or macro name), as + and list
  are. Methods qualified with name are primary too."
  [cname & {:keys [operator]}]
  (when-not (symbol? operator) (error "define-method-combination needs :operator, a function or macro name"))
  (let [v (resolve operator)
        op (if v (symbol (%var-name v)) operator)] ; (a special form, as do, stays as it is)
    `(do (swap! %combination-ops assoc ~(keyword (name cname)) '~op)
         ~(keyword (name cname)))))

;; ---- protocols: sugar for generic functions ----

(defmacro defprotocol
  "(defprotocol Name \"doc\"? (method [params…] \"doc\"?)…): each method a
  generic function, dispatching on its first argument; extend-type and
  extend-protocol give them methods, and satisfies? asks. A method has one
  parameter vector (a generic function has one parameter list): for
  optional arguments, give it & more, or define a second method."
  [pname & specs]
  (let [specs (if (string? (first specs)) (rest specs) specs)
        methods (mapv (fn [spec]
                        (when-not (and (seq? spec) (symbol? (first spec)))
                          (error "defprotocol" (str pname ":") "expected (method [params…] \"doc\"?), got" (pr-str spec)))
                        (let [[m params & more] spec]
                          (when-not (vector? params) (error "defprotocol" (str pname ":") (str m) "needs a parameter vector"))
                          (when (some vector? more)
                            (error "defprotocol" (str pname ":") (str m) "has more than one parameter vector,"
                                   "but a protocol method has one arity (it's a generic function): use & for"
                                   "optional arguments, or define another method"))
                          (when (or (next more) (and (seq more) (not (string? (first more)))))
                            (error "defprotocol" (str pname ":") (str m) "takes a parameter vector and an optional docstring, not"
                                   (pr-str more)))
                          [m params (first more)]))
                      specs)]
    `(do ~@(map (fn [[m params doc]] `(defgeneric ~m ~(apply list params) ~@(when doc [doc]))) methods)
         (def ~pname {:protocol '~(symbol (name (current-ns)) (name pname))
                      :methods ~(mapv (fn [[m]] `(var ~m)) methods)})
         (var ~pname))))

(defmacro extend-type
  "(extend-type Class Protocol (method [this args…] body…)…): methods for
  instances of Class (a protocol's methods, or any generic function's)."
  [cls & forms]
  `(do ~@(keep (fn [f] (when (seq? f)
                         (let [[m [this & more] & body] f]
                           `(defmethod ~m ((~this ~cls) ~@more) ~@body))))
               forms)
       nil))

(defmacro extend-protocol
  "(extend-protocol Protocol Class (method [this args…] body…)… Class2 …):
  extend-type for several classes at once."
  [_protocol & forms]
  (let [groups (loop [fs (seq forms) out [] cur nil]
                 (cond (nil? fs) (if cur (conj out cur) out)
                       (seq? (first fs)) (recur (next fs) out (conj cur (first fs)))
                       :else (recur (next fs) (if cur (conj out cur) out) [(first fs)])))]
    `(do ~@(map (fn [[cls & ms]] `(extend-type ~cls nil ~@ms)) groups) nil)))

(defn- %applicable-methods-for [gf x]
  (filter (fn [m] (let [s (first (:specs m))] (and (not (identical? s Object)) (%spec-matches? s x)))) (%gf-get gf :methods)))

(defn satisfies?
  "Does x have a method for every one of protocol p's methods?"
  [p x]
  (every? (fn [v] (boolean (seq (%applicable-methods-for (var-get v) x)))) (:methods p)))
