(ns quire.build
  "Building a site: from folder dir (site.edn, posts/, static/) into an
  output folder, the pages rendered in parallel, only changed files
  written, files no longer made removed."
  (:require [norn.async :as async]
            [norn.cache :as cache]
            [norn.crypto :as crypto]
            [norn.edn :as edn]
            [norn.fs :as fs]
            [norn.io :as io]
            [norn.log :as log]
            [norn.string :as str]
            [norn.zip :as zip]
            [quire.content :as content]
            [quire.render :as render]))

(defn site-config
  "Folder dir's site.edn: {:title :author :url :description :lang}."
  [dir]
  (let [f (io/path dir "site.edn")]
    (if (io/file? f) (edn/read-string (io/read-text f)) {:title (io/file-name (io/absolute dir))})))

;; (a post's page, by what it's made from: unchanged posts aren't
;; rendered again while quire serve runs)
(def ^:private rendered (cache/lru 1000))

(defn- render-post [site p image-size]
  (cache/through rendered [site (dissoc p :source)]
                 (fn [_] (render/post-file site p image-size))))

(defn- digest [x] (crypto/hex (crypto/sha256 x)))

(defn- write-if-changed!
  "Write data (text or bytes) to path unless it holds that already:
  whether it was written."
  [path data]
  (if (and (io/file? path) (= (digest data) (digest (io/read-bytes path))))
    false
    (do (io/mkdirs! (io/parent path))
        (io/write-atomic! path data)
        true)))

(defn- static-files [dir]
  (let [root (io/path dir "static")]
    (into {} (for [f (fs/glob (str root "/**/*")) :when (io/file? f)]
               [(subs f (inc (count root))) (io/read-bytes f)]))))

(defn build!
  "Build the site in folder dir into folder out. Options: :drafts (include
  drafts), :zip (also write out/site.zip of it all), :on-bad-post (:skip,
  :placeholder (default), or :stop: what a post that can't be read does),
  :parallel (pages rendered at once, default 8). {:posts :written
  :unchanged :removed :broken}."
  [dir out & {:keys [drafts zip on-bad-post parallel] :or {on-bad-post :placeholder parallel 8}}]
  (let [site (site-config dir)
        broken (atom [])
        posts (handler-bind [content/BadPost
                             (fn [c]
                               (swap! broken conj (condition-message c))
                               (log/warn "a post can't be read" :error (condition-message c))
                               (case on-bad-post
                                 :skip (invoke-restart 'skip-post)
                                 :placeholder (invoke-restart 'use-placeholder (condition-message c))
                                 nil))]
                (content/load-posts (io/path dir "posts") :drafts drafts))
        image-size (render/image-sizes dir)
        pages (let [to (chan 16)
                    p (async/pipeline parallel to (fn [post] (render-post site post image-size)) (async/to-chan! posts))
                    got (async/into {} to)]
                (await p)
                got)
        files (merge (render/site-files site posts)
                     pages
                     (static-files dir))
        files (assoc files "sitemap.xml" (render/sitemap site (filter (fn [k] (str/ends-with? k ".html")) (keys files))))
        files (if zip (assoc files "site.zip" (zip/zip (into (sorted-map) files))) files)
        written (vec (for [[path data] (sort-by key files) :when (write-if-changed! (io/path out path) data)] path))
        stale (for [f (if (io/directory? out) (fs/glob (str out "/**/*")) [])
                    :when (io/file? f)
                    :let [rel (subs f (inc (count out)))]
                    :when (not (contains? files rel))]
                (do (io/delete! f) rel))
        removed (vec stale)]
    {:posts (count posts) :written (count written) :unchanged (- (count files) (count written))
     :removed (count removed) :broken @broken}))
