(ns pulse.store
  "Targets to watch and the results of checking them, in SQLite."
  (:require [norn.math :as math]
            [norn.sqlite :as sql]
            [norn.time :as t]))

(def schema
  "The tables, made if they're missing."
  "CREATE TABLE IF NOT EXISTS targets (
     name TEXT PRIMARY KEY,
     url TEXT NOT NULL,
     every_s INTEGER NOT NULL DEFAULT 60,
     added_ms INTEGER NOT NULL);
   CREATE TABLE IF NOT EXISTS checks (
     target TEXT NOT NULL REFERENCES targets(name) ON DELETE CASCADE,
     at_ms INTEGER NOT NULL,
     status INTEGER,
     ms INTEGER,
     ok INTEGER NOT NULL,
     error TEXT);
   CREATE INDEX IF NOT EXISTS checks_by_target ON checks (target, at_ms);
   PRAGMA foreign_keys = ON;")

(defn open
  "The database at path (\":memory:\" for one that lasts as long as the
  connection), its tables made if they're missing."
  [path]
  (let [db (sql/open path)]
    (sql/exec! db schema)
    db))

(defn- now-ms [] (t/epoch-ms (t/now)))

(defn add-target!
  "Watch url as name, checking it every every-s seconds. A ConstraintError
  if name is taken."
  [db name url every-s]
  (sql/execute! db ["INSERT INTO targets (name, url, every_s, added_ms) VALUES (?, ?, ?, ?)"
                    name url every-s (now-ms)])
  {:name name :url url :every-s every-s})

(defn remove-target!
  "Stop watching name, forgetting its checks: whether there was one."
  [db name]
  (pos? (sql/execute! db ["DELETE FROM targets WHERE name = ?" name])))

(defn- target-row [r] {:name (:name r) :url (:url r) :every-s (:every_s r)})

(defn targets
  "Every target, by name."
  [db]
  (mapv target-row (sql/query db "SELECT name, url, every_s FROM targets ORDER BY name")))

(defn target
  "The target called name, or nil."
  [db name]
  (some-> (sql/query-one db ["SELECT name, url, every_s FROM targets WHERE name = ?" name]) target-row))

(defn record-check!
  "Record a check of target name: {:status :ms :ok :error}."
  [db name {:keys [status ms ok error]}]
  (sql/execute! db ["INSERT INTO checks (target, at_ms, status, ms, ok, error) VALUES (?, ?, ?, ?, ?, ?)"
                    name (now-ms) status ms (if ok 1 0) error]))

(defn- check-row [r]
  {:at-ms (:at_ms r) :status (:status r) :ms (:ms r) :ok (= 1 (:ok r)) :error (:error r)})

(defn checks
  "Target name's checks since since-ms, newest first, at most limit."
  [db name since-ms limit]
  (mapv check-row (sql/query db ["SELECT at_ms, status, ms, ok, error FROM checks
                                  WHERE target = ? AND at_ms >= ? ORDER BY at_ms DESC LIMIT ?"
                                 name since-ms limit])))

(defn summary
  "Each target with its last check and its uptime (a fraction of checks
  that were ok) since since-ms."
  [db since-ms]
  (vec (for [tg (targets db)]
         (let [stats (sql/query-one db ["SELECT count(*) AS n, sum(ok) AS up, avg(ms) AS avg_ms FROM checks
                                         WHERE target = ? AND at_ms >= ?" (:name tg) since-ms])
               last-check (first (checks db (:name tg) 0 1))]
           (assoc tg
                  :last last-check
                  :checks (:n stats)
                  :uptime (when (pos? (:n stats)) (/ (double (:up stats)) (:n stats)))
                  :avg-ms (some-> (:avg_ms stats) math/round))))))

(defn prune!
  "Forget checks older than before-ms: how many."
  [db before-ms]
  (sql/execute! db ["DELETE FROM checks WHERE at_ms < ?" before-ms]))
