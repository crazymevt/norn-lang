(ns chat.server
  "The chat server: a line protocol over TCP (or TLS). Each connection has
  a fiber reading its lines and one writing its outbox, a bounded channel:
  a client too slow to take what it's sent is let go, rather than holding
  up everyone talking to it.

    /nick NAME   take a name          /join #ROOM   go into a room
    /part        leave the room       /rooms        the rooms, and how full
    /who         who's in the room    /msg NAME …   say something to one person
    /quit        leave                anything else is said to the room

  The server says #room <name> text for what's said in a room, *name* text
  for a private message, * … for news and ! … when something's wrong."
  (:require [chat.state :as state]
            [norn.io :as io]
            [norn.log :as log]
            [norn.net :as net]
            [norn.string :as str]
            [norn.sync :as sync]))

(def outbox-size "Lines a connection may have waiting before it's too slow, unless :outbox says." 256)

(defn- send!
  "Put line in user's outbox: false if it's full (they're too slow) or closed."
  [outbox line]
  (offer! outbox line))

(defn- broadcast!
  "Say line to everyone in room: those whose outboxes were full."
  [st room line]
  (state/remember! st room line)
  (vec (for [n (state/members st room)
             :let [u (state/user st n)]
             :when (and u (not (send! (:outbox u) line)))]
         u)))

(defn- drop-slow!
  "Let go of users too slow to take what they're sent: their connections
  close, so their readers end and they leave (and the others hear)."
  [slow]
  ;; (once: a closed outbox refuses everything after too)
  (doseq [u slow :when (not (closed? (:outbox u)))]
    (log/info "letting go of a client too slow to keep up" :name (:name u))
    ((:kick u))))

(defn- command
  "Handle one line from conn, {:name :outbox}: the conn as it is after."
  [st conn line limiter]
  (let [{:keys [name outbox kick]} conn
        reply (fn [l] (send! outbox l) conn)
        [cmd arg] (str/split (str/trim line) #"\s+" 2)]
    (cond
      (str/blank? line) conn

      (= cmd "/nick")
      (cond (not (and arg (state/valid-name? arg))) (reply "! a name is 1–20 letters, digits, - or _")
            (state/claim-name! st name arg outbox kick)
            (do (when-let [room (and name (:room (state/user st arg)))]
                  (drop-slow! (broadcast! st room (str "* " name " is now " arg))))
                (send! outbox (str "* you are " arg))
                (assoc conn :name arg))
            :else (reply (str "! " arg " is taken")))

      (nil? name) (reply "! take a name first: /nick NAME")

      (= cmd "/join")
      (if-not (and arg (state/valid-room? arg))
        (reply "! a room is # and 1–20 letters, digits, - or _")
        (let [[left recent] (state/join! st name arg)]
          (when (and left (not= left arg)) (drop-slow! (broadcast! st left (str "* " name " left " left))))
          (doseq [l recent] (send! outbox l))
          (drop-slow! (broadcast! st arg (str "* " name " joined " arg)))
          conn))

      (= cmd "/part")
      (if-let [left (state/part! st name)]
        (do (drop-slow! (broadcast! st left (str "* " name " left " left))) (reply (str "* you left " left)))
        (reply "! you're not in a room"))

      (= cmd "/rooms") (reply (str "* rooms: " (str/join ", " (for [[r n] (state/rooms st)] (str r " (" n ")")))))

      (= cmd "/who")
      (if-let [room (:room (state/user st name))]
        (reply (str "* in " room ": " (str/join ", " (state/members st room))))
        (reply "! you're not in a room"))

      (= cmd "/msg")
      (let [[to text] (when arg (str/split arg #"\s+" 2))
            u (when to (state/user st to))]
        (cond (or (nil? u) (str/blank? text)) (reply "! /msg NAME text, to someone who's here")
              (not (sync/try-take! limiter)) (reply "! slow down")
              :else (do (when-not (send! (:outbox u) (str "*" name "* " text)) (drop-slow! [u])) conn)))

      (= cmd "/quit") (assoc conn :quit true)

      (str/starts-with? cmd "/") (reply (str "! no command " cmd))

      :else
      (if-let [room (:room (state/user st name))]
        (if (sync/try-take! limiter)
          (do (drop-slow! (broadcast! st room (str room " <" name "> " (str/trim line)))) conn)
          (reply "! slow down"))
        (reply "! join a room first: /join #ROOM")))))

(defn- serve-connection!
  "Talk to the client on socket sock until it quits or goes."
  [st sock {:keys [rate burst outbox]}]
  (let [outbox (chan outbox)
        writer (spawn-detached
                 (loop []
                   (when-let [l (take! outbox)]
                     (when (try (io/write sock (str l "\n")) true (catch Error _ nil))
                       (recur))))
                 (try (io/close sock) (catch Error _ nil)))
        r (io/line-reader sock)
        limiter (sync/rate-limiter rate burst)
        kick (fn [] (close! outbox) (try (io/close sock) (catch Error _ nil)))]
    (send! outbox "* welcome: /nick NAME to start")
    (loop [conn {:name nil :outbox outbox :kick kick}]
      (let [line (try (io/read-line r) (catch Error _ nil))]
        (if (and line (not (:quit conn)))
          (recur (command st conn line limiter))
          (let [name (:name conn)]
            (when name
              (when-let [room (state/leave! st name)]
                (drop-slow! (broadcast! st room (str "* " name " left " room)))))
            (close! outbox)
            (await writer)))))))

(defn start!
  "Serve chat on host:port (0: any free port): {:port :stop :state}.
  Options: :max-clients (1000; others are told it's full), :rate and
  :burst (messages a second each client may send: 5 and 20), :outbox
  (lines a client may have waiting before it's let go as too slow:
  outbox-size), :tls with :cert-file and :key-file."
  [host port & {:keys [max-clients rate burst outbox tls cert-file key-file]
                :or {max-clients 1000 rate 5 burst 20 outbox outbox-size}}]
  (let [st (state/new-state)
        listener (net/listen host port)
        slots (sync/semaphore max-clients)
        running (atom true)
        accepting
        (spawn-detached
          (loop []
            (when @running
              (when-let [sock (try (if tls (net/accept listener :tls true :cert-file cert-file :key-file key-file) (net/accept listener))
                                   (catch Error e (when @running (log/warn "accept failed" :error (condition-message e))) nil))]
                (if (sync/try-acquire! slots)
                  (spawn-detached
                    (try (serve-connection! st sock {:rate rate :burst burst :outbox outbox})
                         (catch Error e (log/warn "a connection failed" :error (condition-message e)))
                         (finally (sync/release! slots))))
                  (do (try (io/write sock "! the server is full\n") (io/close sock) (catch Error _ nil))))
                (recur)))))]
    {:port (net/port (net/local-address listener))
     :state st
     :stop (fn []
             (reset! running false)
             (try (io/close listener) (catch Error _ nil))
             (doseq [[_ u] @(:users st)] (send! (:outbox u) "* the server is going away") (close! (:outbox u)))
             (cancel! accepting))}))
