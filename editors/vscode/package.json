{
  "name": "skein",
  "displayName": "Skein",
  "description": "Skein for VS Code: highlighting; skein lsp's diagnostics, hover, completion, definitions, references, outline and formatting; a REPL, values beside the forms evaluated, and Skein's debugger in VS Code's.",
  "version": "0.0.1",
  "publisher": "skein",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "skein",
        "aliases": [
          "Skein",
          "skein"
        ],
        "extensions": [
          ".skn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skein",
        "scopeName": "source.skn",
        "path": "./syntaxes/skein.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Skein",
      "properties": {
        "skein.path": {
          "type": "string",
          "default": "skein",
          "description": "The skein command: a name on the PATH, or the binary's full path."
        },
        "skein.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and skein lsp in the Skein output."
        }
      }
    },
    "commands": [
      {
        "command": "skein.evalTopLevel",
        "title": "Evaluate Top-Level Form or Selection",
        "category": "Skein"
      },
      {
        "command": "skein.startRepl",
        "title": "Start REPL",
        "category": "Skein"
      },
      {
        "command": "skein.restartServer",
        "title": "Restart Language Server",
        "category": "Skein"
      },
      {
        "command": "skein.showOutput",
        "title": "Show Output",
        "category": "Skein"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "skein.evalTopLevel",
          "when": "editorLangId == skein"
        }
      ]
    },
    "keybindings": [
      {
        "command": "skein.evalTopLevel",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == skein"
      }
    ],
    "debuggers": [
      {
        "type": "skein",
        "label": "Skein",
        "languages": [
          "skein"
        ]
      }
    ]
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --out skein.vsix",
    "test": "node test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
