{
  "information_for_contributors": [
    "Derived from VS Code's Clojure grammar, itself converted from https://github.com/atom/language-clojure (MIT licence, commit 45bdb881).",
    "Norn's changes: scopes end in .norn, and Norn's condition and resource forms are control keywords."
  ],
  "name": "Norn",
  "scopeName": "source.norn",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#shebang-comment"
    },
    {
      "include": "#quoted-sexp"
    },
    {
      "include": "#sexp"
    },
    {
      "include": "#keyfn"
    },
    {
      "include": "#string"
    },
    {
      "include": "#vector"
    },
    {
      "include": "#set"
    },
    {
      "include": "#map"
    },
    {
      "include": "#regexp"
    },
    {
      "include": "#var"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#dynamic-variables"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#namespace-symbol"
    },
    {
      "include": "#symbol"
    }
  ],
  "repository": {
    "comment": {
      "begin": "(?<!\\\\);",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.norn"
        }
      },
      "end": "$",
      "name": "comment.line.semicolon.norn"
    },
    "constants": {
      "patterns": [
        {
          "match": "(nil)(?=(\\s|\\)|\\]|\\}))",
          "name": "constant.language.nil.norn"
        },
        {
          "match": "(true|false)",
          "name": "constant.language.boolean.norn"
        },
        {
          "match": "(##(?:Inf|-Inf|NaN))",
          "name": "constant.numeric.symbol.norn"
        },
        {
          "match": "([-+]?\\d+/\\d+)",
          "name": "constant.numeric.ratio.norn"
        },
        {
          "match": "([-+]?(?:(?:3[0-6])|(?:[12]\\d)|[2-9])[rR][0-9A-Za-z]+N?)",
          "name": "constant.numeric.arbitrary-radix.norn"
        },
        {
          "match": "([-+]?0[xX][0-9a-fA-F]+N?)",
          "name": "constant.numeric.hexadecimal.norn"
        },
        {
          "match": "([-+]?0[0-7]+N?)",
          "name": "constant.numeric.octal.norn"
        },
        {
          "match": "([-+]?[0-9]+(?:(\\.|(?=[eEM]))[0-9]*([eE][-+]?[0-9]+)?)M?)",
          "name": "constant.numeric.double.norn"
        },
        {
          "match": "([-+]?\\d+N?)",
          "name": "constant.numeric.long.norn"
        },
        {
          "include": "#keyword"
        }
      ]
    },
    "keyword": {
      "match": "(?<=(\\s|\\(|\\[|\\{)):[\\w\\#\\.\\-\\_\\:\\+\\=\\>\\<\\/\\!\\?\\*]+(?=(\\s|\\)|\\]|\\}|\\,))",
      "name": "constant.keyword.norn"
    },
    "keyfn": {
      "patterns": [
        {
          "match": "(?<=(\\s|\\(|\\[|\\{))(if(-[-\\p{Ll}\\?]*)?|when(-[-\\p{Ll}]*)?|for(-[-\\p{Ll}]*)?|cond|do|let(-[-\\p{Ll}\\?]*)?|binding|loop|recur|fn|throw[\\p{Ll}\\-]*|try|catch|finally|handler-case|handler-bind|restart-case|unwind-protect|with-[-\\p{Ll}]+|([\\p{Ll}]*case))(?=(\\s|\\)|\\]|\\}))",
          "name": "storage.control.norn"
        },
        {
          "match": "(?<=(\\s|\\(|\\[|\\{))(declare-?|(in-)?ns|import|use|require|load|compile|(def[\\p{Ll}\\-]*))(?=(\\s|\\)|\\]|\\}))",
          "name": "keyword.control.norn"
        }
      ]
    },
    "dynamic-variables": {
      "match": "\\*[\\w\\.\\-\\_\\:\\+\\=\\>\\<\\!\\?\\d]+\\*",
      "name": "meta.symbol.dynamic.norn"
    },
    "map": {
      "begin": "(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.map.begin.norn"
        }
      },
      "end": "(\\}(?=[\\}\\]\\)\\s]*(?:;|$)))|(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.map.end.trailing.norn"
        },
        "2": {
          "name": "punctuation.section.map.end.norn"
        }
      },
      "name": "meta.map.norn",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "begin": "(\\^\\{)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.metadata.map.begin.norn"
            }
          },
          "end": "(\\}(?=[\\}\\]\\)\\s]*(?:;|$)))|(\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.metadata.map.end.trailing.norn"
            },
            "2": {
              "name": "punctuation.section.metadata.map.end.norn"
            }
          },
          "name": "meta.metadata.map.norn",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "(\\^)",
          "end": "(\\s)",
          "name": "meta.metadata.simple.norn",
          "patterns": [
            {
              "include": "#keyword"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "quoted-sexp": {
      "begin": "(['``]\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.expression.begin.norn"
        }
      },
      "end": "(\\))$|(\\)(?=[\\}\\]\\)\\s]*(?:;|$)))|(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.expression.end.trailing.norn"
        },
        "2": {
          "name": "punctuation.section.expression.end.trailing.norn"
        },
        "3": {
          "name": "punctuation.section.expression.end.norn"
        }
      },
      "name": "meta.quoted-expression.norn",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "regexp": {
      "begin": "#\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.begin.norn"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.end.norn"
        }
      },
      "name": "string.regexp.norn",
      "patterns": [
        {
          "include": "#regexp_escaped_char"
        }
      ]
    },
    "regexp_escaped_char": {
      "match": "\\\\.",
      "name": "constant.character.escape.norn"
    },
    "set": {
      "begin": "(\\#\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.set.begin.norn"
        }
      },
      "end": "(\\}(?=[\\}\\]\\)\\s]*(?:;|$)))|(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.set.end.trailing.norn"
        },
        "2": {
          "name": "punctuation.section.set.end.norn"
        }
      },
      "name": "meta.set.norn",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "sexp": {
      "begin": "(\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.expression.begin.norn"
        }
      },
      "end": "(\\))$|(\\)(?=[\\}\\]\\)\\s]*(?:;|$)))|(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.expression.end.trailing.norn"
        },
        "2": {
          "name": "punctuation.section.expression.end.trailing.norn"
        },
        "3": {
          "name": "punctuation.section.expression.end.norn"
        }
      },
      "name": "meta.expression.norn",
      "patterns": [
        {
          "begin": "(?<=\\()(ns|declare|def[\\w\\d._:+=><!?*-]*|[\\w._:+=><!?*-][\\w\\d._:+=><!?*-]*/def[\\w\\d._:+=><!?*-]*)\\s+",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.norn"
            }
          },
          "end": "(?=\\))",
          "name": "meta.definition.global.norn",
          "patterns": [
            {
              "include": "#metadata"
            },
            {
              "include": "#dynamic-variables"
            },
            {
              "match": "([\\p{L}\\.\\-\\_\\+\\=\\>\\<\\!\\?\\*][\\w\\.\\-\\_\\:\\+\\=\\>\\<\\!\\?\\*\\d]*)",
              "name": "entity.global.norn"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "include": "#keyfn"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#vector"
        },
        {
          "include": "#map"
        },
        {
          "include": "#set"
        },
        {
          "include": "#sexp"
        },
        {
          "match": "(?<=\\()(.+?)(?=\\s|\\))",
          "captures": {
            "1": {
              "name": "entity.name.function.norn"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "include": "$self"
        }
      ]
    },
    "shebang-comment": {
      "begin": "^(#!)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment.shebang.norn"
        }
      },
      "end": "$",
      "name": "comment.line.shebang.norn"
    },
    "string": {
      "begin": "(?<!\\\\)(\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.norn"
        }
      },
      "end": "(\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.norn"
        }
      },
      "name": "string.quoted.double.norn",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.norn"
        }
      ]
    },
    "namespace-symbol": {
      "patterns": [
        {
          "match": "([\\p{L}\\.\\-\\_\\+\\=\\>\\<\\!\\?\\*][\\w\\.\\-\\_\\:\\+\\=\\>\\<\\!\\?\\*\\d]*)/",
          "captures": {
            "1": {
              "name": "meta.symbol.namespace.norn"
            }
          }
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "match": "([\\p{L}\\.\\-\\_\\+\\=\\>\\<\\!\\?\\*][\\w\\.\\-\\_\\:\\+\\=\\>\\<\\!\\?\\*\\d]*)",
          "name": "meta.symbol.norn"
        }
      ]
    },
    "var": {
      "match": "(?<=(\\s|\\(|\\[|\\{)\\#)'[\\w\\.\\-\\_\\:\\+\\=\\>\\<\\/\\!\\?\\*]+(?=(\\s|\\)|\\]|\\}))",
      "name": "meta.var.norn"
    },
    "vector": {
      "begin": "(\\[)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.vector.begin.norn"
        }
      },
      "end": "(\\](?=[\\}\\]\\)\\s]*(?:;|$)))|(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.vector.end.trailing.norn"
        },
        "2": {
          "name": "punctuation.section.vector.end.norn"
        }
      },
      "name": "meta.vector.norn",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    }
  }
}