{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[^\\s\\(\\)\\[\\]\\{\\}\"',;`@~^#\\\\]+",
  "indentationRules": {
    "increaseIndentPattern": "[\\(\\[\\{][^\\)\\]\\}]*$",
    "decreaseIndentPattern": "^\\s*[\\)\\]\\}]"
  },
  "folding": {
    "offSide": true
  }
}
