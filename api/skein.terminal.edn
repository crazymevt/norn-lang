;; skein.terminal's public interface, recorded by skein api-diff --record.
{
 "*color*" {:kind :var, :dynamic true}
 "alternate-screen" {:kind :var}
 "call-with-raw-mode" {:arglists ["[f & {:keys [alternate-screen hide-cursor mouse paste keyboard]}]"], :kind :function}
 "clear" {:arglists ["[]" "[what]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Keyword"]}]}
 "color-support" {:arglists ["[]" "[stream]"], :kind :function, :signature [{:result "Keyword", :args []} {:result "Keyword", :args ["Keyword"]}]}
 "cursor-back" {:arglists ["[]" "[n]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Integer"]}]}
 "cursor-down" {:arglists ["[]" "[n]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Integer"]}]}
 "cursor-forward" {:arglists ["[]" "[n]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Integer"]}]}
 "cursor-to" {:arglists ["[row col]"], :kind :function, :signature [{:result "String", :args ["Integer" "Integer"]}]}
 "cursor-up" {:arglists ["[]" "[n]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Integer"]}]}
 "decode-keys" {:arglists ["[bs & {:keys [final]}]"], :kind :function, :signature [{:result "Map", :args ["Bytes or Sequential"], :rest "Any"}]}
 "hide-cursor" {:kind :var}
 "key-name" {:arglists ["[k]"], :kind :function, :signature [{:result "String", :args ["Map"]}]}
 "keyboard-off" {:kind :var}
 "keyboard-on" {:arglists ["[]" "[flags]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Integer"]}]}
 "keyboard-query" {:kind :var}
 "main-screen" {:kind :var}
 "mouse-off" {:kind :var}
 "mouse-on" {:kind :var}
 "paste-off" {:kind :var}
 "paste-on" {:kind :var}
 "read-key" {:arglists ["[& {:or {escape-delay 50}, :keys [timeout escape-delay]}]"], :kind :function, :signature [{:result "nil or Map or Keyword", :args [], :rest "Any"}]}
 "show-cursor" {:kind :var}
 "size" {:arglists ["[]" "[stream]"], :kind :function, :signature [{:result "nil or Map", :args []} {:result "nil or Map", :args ["Keyword"]}]}
 "strip" {:arglists ["[s]"], :kind :function, :signature [{:result "String", :args ["Any"]}]}
 "style" {:arglists ["[text & specs]"], :kind :function, :signature [{:result "String", :args ["Any"], :rest "Any"}]}
 "suspend!" {:arglists ["[]"], :kind :function}
 "title" {:arglists ["[s]"], :kind :function, :signature [{:result "String", :args ["Any"]}]}
 "tty?" {:arglists ["[]" "[stream]"], :kind :function, :signature [{:result "Boolean", :args []} {:result "Boolean", :args ["Keyword"]}]}
 "width" {:arglists ["[s]"], :kind :function, :signature [{:result "Integer", :args ["Any"]}]}
 "with-raw-mode" {:arglists ["[& body]"], :kind :macro}
}
