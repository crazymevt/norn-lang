;; skein.rope's public interface, recorded by skein api-diff --record.
{
 "char-at" {:arglists ["[r i]"], :kind :function, :signature [{:result "Character", :args ["String or Vector" "Integer"]}]}
 "delete" {:arglists ["[r start end]"], :kind :function, :signature [{:result "String or Vector", :args ["String or Vector" "Integer" "Integer"]}]}
 "insert" {:arglists ["[r i s]"], :kind :function, :signature [{:result "String or Vector", :args ["String or Vector" "Integer" "nil or String"]}]}
 "join" {:arglists ["[a b]"], :kind :function, :signature [{:result "String or Vector", :args ["String or Vector" "String or Vector"]}]}
 "length" {:arglists ["[r]"], :kind :function, :signature [{:result "Integer", :args ["String or Vector"]}]}
 "line" {:arglists ["[r n]"], :kind :function, :signature [{:result "nil or String", :args ["String or Vector" "Integer"]}]}
 "line-count" {:arglists ["[r]"], :kind :function, :signature [{:result "Integer", :args ["String or Vector"]}]}
 "line-end" {:arglists ["[r n]"], :kind :function, :signature [{:result "Integer", :args ["String or Vector" "Integer"]}]}
 "line-of" {:arglists ["[r i]"], :kind :function, :signature [{:result "Integer", :args ["String or Vector" "Integer"]}]}
 "line-start" {:arglists ["[r n]"], :kind :function, :signature [{:result "nil or Integer", :args ["String or Vector" "Integer"]}]}
 "newlines" {:arglists ["[r]"], :kind :function, :signature [{:result "Integer", :args ["String or Vector"]}]}
 "replace" {:arglists ["[r start end s]"], :kind :function, :signature [{:result "String or Vector", :args ["String or Vector" "Integer" "Integer" "nil or String"]}]}
 "rope" {:arglists ["[]" "[s]"], :kind :function, :signature [{:result "String or Vector", :args []} {:result "String or Vector", :args ["nil or String"]}]}
 "rope?" {:arglists ["[x]"], :kind :function, :signature [{:result "Boolean", :args ["Any"]}]}
 "slice" {:arglists ["[r start end]"], :kind :function, :signature [{:result "String", :args ["String or Vector" "Integer" "Integer"]}]}
 "text" {:arglists ["[r]"], :kind :function, :signature [{:result "String", :args ["String or Vector"]}]}
}
