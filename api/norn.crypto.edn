;; norn.crypto's public interface, recorded by norn api-diff --record.
{
 "constant-time=" {:arglists ["[a b]"], :kind :function, :signature [{:result "Boolean", :args ["String or Bytes" "String or Bytes"]}]}
 "digest" {:arglists ["[alg data]"], :kind :function, :signature [{:result "Bytes", :args ["Keyword" "String or Bytes"]}]}
 "hex" {:arglists ["[b]"], :kind :function, :signature [{:result "String", :args ["Bytes"]}]}
 "hmac" {:arglists ["[alg key data]"], :kind :function, :signature [{:result "Bytes", :args ["Keyword" "String or Bytes" "String or Bytes"]}]}
 "hmac-valid?" {:arglists ["[alg key data tag]"], :kind :function, :signature [{:result "Boolean", :args ["Keyword" "String or Bytes" "String or Bytes" "String or Bytes"]}]}
 "pbkdf2" {:arglists ["[password salt & {:or {iterations 600000, alg :sha256, length 32}, :keys [alg iterations length]}]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes" "String or Bytes"], :rest "Any"}]}
 "random-bytes" {:arglists ["[n]"], :kind :function, :signature [{:result "Bytes", :args ["Integer"]}]}
 "random-token" {:arglists ["[]" "[n]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["Integer"]}]}
 "sha256" {:arglists ["[data]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes"]}]}
 "sha512" {:arglists ["[data]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes"]}]}
}
