 "nil-uuid" {:kind :var}
 "parse" {:arglists ["[s]"], :kind :function, :signature [{:result "String", :args ["String"]}]}
 "timestamp-ms" {:arglists ["[u]"], :kind :function, :signature [{:result "Integer", :args ["String"]}]}
 "v4" {:arglists ["[]"], :kind :function, :signature [{:result "String", :args []}]}
