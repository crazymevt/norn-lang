;; skein.actor's public interface, recorded by skein api-diff --record.
{
 "*self*" {:kind :var, :dynamic true}
 "Process" {:kind :class, :slots ["done" "fiber" "id" "links" "mailbox" "monitors" "name" "reason" "signal" "trapping"], :supers ["skein.core/StandardObject"]}
 "alive?" {:arglists ["[p]"], :kind :function, :signature [{:result "Boolean", :args ["Any"]}]}
 "ask" {:arglists ["[p msg]" "[p msg ms]"], :kind :function, :signature [{:result "Any", :args ["Any" "Vector"]} {:result "Any", :args ["Any" "Vector" "Integer"]}]}
 "await-exit" {:arglists ["[p]" "[p ms]"], :kind :function, :signature [{:result "Any", :args ["Process"]} {:result "Any", :args ["Process" "Integer"]}]}
 "child" {:arglists ["[id & more]"], :kind :function, :signature [{:result "Map", :args ["Any"], :rest "Any"}]}
 "defprocess" {:arglists ["[pname params & body]"], :kind :macro}
 "exit!" {:arglists ["[p]" "[p reason]"], :kind :function}
 "exit-reason" {:arglists ["[p]"], :kind :function, :signature [{:result "Any", :args ["Process"]}]}
 "link!" {:arglists ["[p]"], :kind :function, :signature [{:result "Process", :args ["Any"]}]}
 "monitor" {:arglists ["[p]"], :kind :function, :signature [{:result "Symbol", :args ["Any"]}]}
 "process?" {:arglists ["[x]"], :kind :function, :signature [{:result "Boolean", :args ["Any"]}]}
 "receive" {:arglists ["[& clauses]"], :kind :macro}
 "register!" {:arglists ["[name]" "[name p]"], :kind :function, :signature [{:result "Process", :args ["Any"]} {:result "Process", :args ["Any" "Process"]}]}
 "run-in-process" {:arglists ["[f]"], :kind :function}
 "self" {:arglists ["[]"], :kind :function, :signature [{:result "Process", :args []}]}
 "send" {:arglists ["[p msg]"], :kind :function}
 "spawn-link" {:arglists ["[f & args]"], :kind :function, :signature [{:result "Process", :args ["Any"], :rest "Any"}]}
 "spawn-process" {:arglists ["[f & args]"], :kind :function, :signature [{:result "Process", :args ["Any"], :rest "Any"}]}
 "start-child!" {:arglists ["[sup spec]"], :kind :function, :signature [{:result "Process", :args ["Process" "Map"]}]}
 "stop-child!" {:arglists ["[sup id]"], :kind :function, :signature [{:result "Boolean", :args ["Process" "Any"]}]}
 "stop-supervisor!" {:arglists ["[sup]"], :kind :function, :signature [{:result "Any", :args ["Process"]}]}
 "supervise" {:arglists ["[opts specs]"], :kind :function, :signature [{:result "Any", :args ["nil or Map" "nil or Sequential"]}]}
 "supervisor" {:arglists ["[opts children]"], :kind :function, :signature [{:result "Process", :args ["nil or Map" "nil or Sequential"]}]}
 "trap-exits!" {:arglists ["[]" "[on?]"], :kind :function}
 "whereis" {:arglists ["[name]"], :kind :function, :signature [{:result "nil or Process", :args ["Any"]}]}
 "which-children" {:arglists ["[sup]"], :kind :function, :signature [{:result "Vector", :args ["Any"]}]}
}
