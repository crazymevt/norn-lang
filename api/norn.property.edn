;; norn.property's public interface, recorded by norn api-diff --record.
{
 "Generator" {:kind :class, :slots ["run"], :supers ["norn.core/StandardObject"]}
 "Property" {:kind :class, :slots ["generate" "holds" "names"], :supers ["norn.core/StandardObject"]}
 "bind" {:arglists ["[g f]"], :kind :function, :signature [{:result "Generator", :args ["Generator" "Any"]}]}
 "booleans" {:arglists ["[]"], :kind :function, :signature [{:result "Generator", :args []}]}
 "byte-strings" {:arglists ["[& {:keys [min max]}]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Any"}]}
 "chars" {:arglists ["[& {:keys [unicode]}]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Any"}]}
 "check" {:arglists ["[p & {:or {runs 100, max-shrinks 5000, max-size 50}, :keys [runs seed max-size max-shrinks]}]"], :kind :function, :signature [{:result "Map", :args ["Property"], :rest "Any"}]}
 "constant" {:arglists ["[x]"], :kind :function, :signature [{:result "Generator", :args ["Any"]}]}
 "defproperty" {:arglists ["[name & more]"], :kind :macro}
 "elements" {:arglists ["[coll]"], :kind :function, :signature [{:result "Generator", :args ["Any"]}]}
 "floats" {:arglists ["[]"], :kind :function, :signature [{:result "Generator", :args []}]}
 "fmap" {:arglists ["[f g]"], :kind :function, :signature [{:result "Generator", :args ["Any" "Generator"]}]}
 "for-all" {:arglists ["[bindings & body]"], :kind :macro}
 "frequency" {:arglists ["[& pairs]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Sequential"}]}
 "generate" {:arglists ["[gen]" "[gen size]" "[gen size seed]"], :kind :function, :signature [{:result "Any", :args ["Generator"]} {:result "Any", :args ["Generator" "Integer"]} {:result "Any", :args ["Generator" "Integer" "Integer"]}]}
 "generator?" {:arglists ["[x]"], :kind :function, :signature [{:result "Boolean", :args ["Any"]}]}
 "integers" {:arglists ["[& {:keys [min max]}]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Any"}]}
 "keyword" {:arglists ["[]"], :kind :function, :signature [{:result "Generator", :args []}]}
 "lists" {:arglists ["[g & {:as opts}]"], :kind :function, :signature [{:result "Generator", :args ["Generator"], :rest "Any"}]}
 "maps" {:arglists ["[key-gen value-gen & {:as opts}]"], :kind :function, :signature [{:result "Generator", :args ["Generator" "Generator"], :rest "Any"}]}
 "naturals" {:arglists ["[]"], :kind :function, :signature [{:result "Generator", :args []}]}
 "one-of" {:arglists ["[& gens]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Generator"}]}
 "recursive" {:arglists ["[branch leaf-gen]"], :kind :function, :signature [{:result "Generator", :args ["Any" "Generator"]}]}
 "sets" {:arglists ["[g & {:as opts}]"], :kind :function, :signature [{:result "Generator", :args ["Generator"], :rest "Any"}]}
 "strings" {:arglists ["[& {:keys [unicode min max]}]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Any"}]}
 "such-that" {:arglists ["[pred g & {:or {tries 100}, :keys [tries]}]"], :kind :function, :signature [{:result "Generator", :args ["Any" "Generator"], :rest "Any"}]}
 "symbol" {:arglists ["[]"], :kind :function, :signature [{:result "Generator", :args []}]}
 "tuple" {:arglists ["[& gens]"], :kind :function, :signature [{:result "Generator", :args [], :rest "Generator"}]}
 "vectors" {:arglists ["[g & {:keys [min max]}]"], :kind :function, :signature [{:result "Generator", :args ["Generator"], :rest "Any"}]}
}
