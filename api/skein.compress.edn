;; skein.compress's public interface, recorded by skein api-diff --record.
{
 "DecompressStream" {:kind :class, :slots ["close-source" "closed" "ended" "id" "pending" "source"], :supers ["skein.core/StandardObject"]}
 "compress" {:arglists ["[data & {:or {level 6, format :gzip}, :keys [format level]}]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes"], :rest "Any"}]}
 "crc32" {:arglists ["[data]"], :kind :function, :signature [{:result "Integer", :args ["String or Bytes"]}]}
 "decompress" {:arglists ["[data & {:or {format :gzip, max-size default-max-size}, :keys [format max-size]}]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes"], :rest "Any"}]}
 "decompress-stream" {:arglists ["[h & {:or {format :gzip, close-source true}, :keys [format max-size close-source]}]"], :kind :function, :signature [{:result "DecompressStream", :args ["Any"], :rest "Any"}]}
 "default-max-size" {:kind :var}
 "gunzip" {:arglists ["[data & opts]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes"], :rest "Any"}]}
 "gzip" {:arglists ["[data]"], :kind :function, :signature [{:result "Bytes", :args ["String or Bytes"]}]}
}
