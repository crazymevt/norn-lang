;; skein.log's public interface, recorded by skein api-diff --record.
{
 "*level*" {:kind :var, :dynamic true}
 "debug" {:arglists ["[msg & kvs]"], :kind :macro}
 "emit" {:arglists ["[level ns msg kvs]"], :kind :function, :signature [{:result "Any", :args ["Keyword" "String or Symbol" "Any" "Sequential"]}]}
 "enabled?" {:arglists ["[level ns]"], :kind :function, :signature [{:result "Boolean", :args ["Keyword" "String or Symbol"]}]}
 "error" {:arglists ["[msg & kvs]"], :kind :macro}
 "info" {:arglists ["[msg & kvs]"], :kind :macro}
 "log" {:arglists ["[level msg & kvs]"], :kind :macro}
 "set-level!" {:arglists ["[level]" "[level ns]"], :kind :function, :signature [{:result "Any", :args ["Keyword"]} {:result "Any", :args ["Keyword" "Symbol or String"]}]}
 "set-sink!" {:arglists ["[f]"], :kind :function}
 "spy" {:arglists ["[form]"], :kind :macro}
 "trace" {:arglists ["[msg & kvs]"], :kind :macro}
 "warn" {:arglists ["[msg & kvs]"], :kind :macro}
}
