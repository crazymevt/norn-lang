;; skein.fmt's public interface, recorded by skein api-diff --record.
{
 "*file-hints*" {:kind :var, :dynamic true}
 "format-file!" {:arglists ["[path]"], :kind :function}
 "format-string" {:arglists ["[s]"], :kind :function}
 "formatted?" {:arglists ["[s]"], :kind :function}
 "indent-hints" {:arglists ["[s]"], :kind :function}
 "main" {:arglists ["[& args]"], :kind :function}
 "node-text" {:arglists ["[n]"], :kind :function}
 "parse" {:arglists ["[s]"], :kind :function}
 "same-code?" {:arglists ["[a b]"], :kind :function}
}
