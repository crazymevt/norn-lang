;; skein.random's public interface, recorded by skein api-diff --record.
{
 "Generator" {:kind :class, :slots ["counter" "seed"], :supers ["skein.core/StandardObject"]}
 "boolean" {:arglists ["[]" "[g]"], :kind :function, :signature [{:result "Boolean", :args []} {:result "Boolean", :args ["nil or Generator"]}]}
 "bytes" {:arglists ["[n]" "[g n]"], :kind :function, :signature [{:result "Bytes", :args ["Integer"]} {:result "Bytes", :args ["nil or Generator" "Integer"]}]}
 "choice" {:arglists ["[coll]" "[g coll]"], :kind :function, :signature [{:result "Any", :args ["Any"]} {:result "Any", :args ["nil or Generator" "Any"]}]}
 "float" {:arglists ["[]" "[g]" "[g lo hi]"], :kind :function, :signature [{:result "Float", :args []} {:result "Float", :args ["Generator or Number"]} {:result "Float", :args ["nil or Generator" "Number" "Number"]}]}
 "gaussian" {:arglists ["[]" "[g]" "[g mean sd]"], :kind :function, :signature [{:result "Float", :args []} {:result "Float", :args ["nil or Generator"]} {:result "Float", :args ["nil or Generator" "Number" "Number"]}]}
 "generator" {:arglists ["[]" "[seed]"], :kind :function, :signature [{:result "Generator", :args []} {:result "Generator", :args ["Integer"]}]}
 "generator?" {:arglists ["[x]"], :kind :function, :signature [{:result "Boolean", :args ["Any"]}]}
 "int" {:arglists ["[n]" "[g n]" "[g lo hi]"], :kind :function, :signature [{:result "Integer", :args ["Integer"]} {:result "Integer", :args ["nil or Generator" "Integer"]} {:result "Integer", :args ["nil or Generator" "Integer" "Integer"]}]}
 "sample" {:arglists ["[coll k]" "[g coll k]"], :kind :function, :signature [{:result "Vector", :args ["Any" "Integer"]} {:result "Vector", :args ["nil or Generator" "Any" "Integer"]}]}
 "shuffle" {:arglists ["[coll]" "[g coll]"], :kind :function, :signature [{:result "Vector", :args ["Any"]} {:result "Vector", :args ["nil or Generator" "Any"]}]}
 "split" {:arglists ["[g]" "[g n]"], :kind :function, :signature [{:result "Vector", :args ["Generator"]} {:result "Vector", :args ["Generator" "Integer"]}]}
 "uuid" {:arglists ["[]" "[g]"], :kind :function, :signature [{:result "String", :args []} {:result "String", :args ["nil or Generator"]}]}
 "weighted" {:arglists ["[weights]" "[g weights]"], :kind :function, :signature [{:result "Any", :args ["Map"]} {:result "Any", :args ["nil or Generator" "Map"]}]}
}
