;; norn.test's public interface, recorded by norn api-diff --record.
{
 "*contexts*" {:kind :var, :dynamic true}
 "*report*" {:kind :var, :dynamic true}
 "*serial*" {:kind :var, :dynamic true}
 "*test*" {:kind :var, :dynamic true}
 "are" {:arglists ["[argv expr & values]"], :kind :macro}
 "deftest" {:arglists ["[name & body]"], :kind :macro}
 "is" {:arglists ["[form]" "[form msg]"], :kind :macro}
 "main" {:arglists ["[& args]"], :kind :function}
 "parallel-tests!" {:arglists ["[]"], :kind :function}
 "run-alone!" {:arglists ["[]"], :kind :function}
 "run-file" {:arglists ["[path & {:keys [only]}]"], :kind :function}
 "run-files" {:arglists ["[paths & {:keys [only serial]}]"], :kind :function}
 "run-ns" {:arglists ["[ns-name]" "[ns-name only]"], :kind :function}
 "run-tests" {:arglists ["[& namespaces]"], :kind :function}
 "testing" {:arglists ["[s & body]"], :kind :macro}
 "tests" {:arglists ["[ns-name]"], :kind :function}
 "use-fixtures" {:arglists ["[kind & fs]"], :kind :function}
}
