 "tap" {:arglists ["[m ch]" "[m ch close?]"], :kind :function, :signature [{:result "Channel", :args ["Mult" "Channel"]} {:result "Channel", :args ["Mult" "Channel" "Any"]}]}
 "to-chan!" {:arglists ["[coll]"], :kind :function, :signature [{:result "Channel", :args ["Any"]}]}
